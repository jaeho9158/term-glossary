[{"slug":"path-dependence","title_ko":"경로의존성","title_en":"path dependence","meaning":"과거에 우연히 선택된 방식이 이후에 더 나은 대안이 나타나도 쉽게 바뀌지 않고 계속 유지되는 현상입니다.","subcategory":"사회학·사회구조","level":1,"related":["social-network-analysis","transaction-cost"],"prerequisites":[],"aliases":["경로 의존성","Path Dependency"]},{"slug":"trained-incapacity","title_ko":"훈련된 무능","title_en":"Trained Incapacity","meaning":"특정 분야에서 오랜 훈련과 전문화를 거친 결과, 그 숙련이 오히려 새로운 상황에 대한 유연한 대응 능력을 떨어뜨리는 관료제의…","subcategory":"조직이론·인사행정","level":2,"related":["overconformity"],"prerequisites":["overconformity"],"aliases":["훈련된무능"]},{"slug":"overconformity","title_ko":"동조과잉","title_en":"Overconformity","meaning":"관료가 조직의 규칙과 절차를 지나치게 엄격히 준수한 나머지, 상황에 맞는 재량적 판단을 하지 못하고 규칙에 맹목적으로…","subcategory":"조직이론·인사행정","level":1,"related":["red-tape-formalism"],"prerequisites":[],"pop":1},{"slug":"red-tape-formalism","title_ko":"행정 형식주의","title_en":"Red Tape / Formalism","meaning":"실질적 내용보다 문서, 절차, 형식적 요건 준수 자체를 지나치게 중시하여 행정의 효율성과 실효성을 저해하는 관료제의…","subcategory":"조직이론·인사행정","level":1,"related":["overconformity"],"prerequisites":[]},{"slug":"sectionalism","title_ko":"할거주의","title_en":"Sectionalism","meaning":"조직 구성원이 조직 전체의 목표보다 자신이 속한 부서나 국·과 단위의 이익과 입장을 우선시하여 다른 부서와의 협조를 소홀히…","subcategory":"조직이론·인사행정","level":2,"related":["organizational-culture"],"prerequisites":[],"pop":9,"aliases":["부처할거주의"]},{"slug":"rank-classification-system","title_ko":"계급제","title_en":"Rank Classification System","meaning":"공직을 담당하는 사람의 자격, 능력, 신분을 기준으로 계급을 부여하고 그 계급에 따라 보수와 대우를 정하는 인사행정 제도로…","subcategory":"조직이론·인사행정","level":1,"related":["promotion-civil-service"],"prerequisites":[],"pop":10},{"slug":"motivation-theory","title_ko":"동기부여이론","title_en":"Motivation Theory","meaning":"개인이 특정 행동을 하도록 이끄는 심리적 욕구와 과정을 설명하는 이론으로, 크게 무엇이 동기를 유발하는지를 다루는 내용이론과…","subcategory":"조직이론·인사행정","level":1,"related":["herzberg-two-factor-theory","vroom-expectancy-theory","adams-equity-theory"],"prerequisites":[],"aliases":["동기이론"]},{"slug":"vroom-expectancy-theory","title_ko":"브룸