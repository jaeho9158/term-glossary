[{"slug":"pcr","title_ko":"중합효소연쇄반응","title_en":"PCR","meaning":"DNA의 특정 부위를 온도를 반복적으로 바꿔가며 짧은 시간 안에 수백만 배로 복제하는 실험 기법입니다.","subcategory":"세포·분자생물학","level":3,"related":["crispr","mass-spectrometry","calibration-curve","electrophoresis"],"prerequisites":["crispr"],"pop":1,"aliases":["폴리머라아제 연쇄반응","Polymerase Chain Reaction"]},{"slug":"measurement-uncertainty","title_ko":"측정불확도","title_en":"Measurement Uncertainty","meaning":"어떤 측정값이 참값으로부터 얼마나 벗어나 있을 수 있는지를 숫자로 표현한, 측정 결과에 딸린 \"의심의 폭\"입니다.","subcategory":"실험기기·측정장비","level":1,"related":["calibration-curve","standard-deviation"],"prerequisites":[],"pop":9,"aliases":["측정 불확실도"]},{"slug":"rigor-mortis-meat","title_ko":"사후강직","title_en":"Rigor Mortis","meaning":"도축 후 ATP 고갈로 근육의 액틴과 미오신이 비가역적으로 결합해 근육이 뻣뻣해지는 사후 생화학적 변화.","subcategory":"축산물이용·낙농학","level":2,"related":["pale-soft-exudative-meat","dark-firm-dry-meat"],"prerequisites":[],"pop":2,"aliases":["시강"]},{"slug":"locard-exchange-principle","title_ko":"로카르 교환법칙","title_en":"Locard's Exchange Principle","meaning":"로카르 교환법칙은 두 물체나 사람이 접촉하면 반드시 물질의 상호 이동이 일어난다는 법과학의 기본 원리입니다.","subcategory":"기초이론","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["로카르교환법칙"]},{"slug":"bloodstain-pattern-analysis","title_ko":"혈흔형태분석","title_en":"Bloodstain Pattern Analysis","meaning":"혈흔형태분석이란 현장에 남은 혈흔의 모양, 크기, 분포를 물리학적으로 분석하여 사건 발생 과정을 재구성하는 법과학 기법입니다.","subcategory":"혈흔분석","level":2,"related":[],"prerequisites":[]},{"slug":"psychological-autopsy","title_ko":"심리부검","title_en":"Psychological Autopsy","meaning":"사망 경위가 불분명한 사건에서 고인의 생전 심리 상태와 생활을 주변인 면담과 기록 검토를 통해 재구성하여 사망 방식을…","subcategory":"법정신의학","level":2,"related":[],"prerequisites":[],"pop":7},{"slug":"capillary-electrophoresis-dna","title_ko":"모세관 전기영동","title_en":"Capillary Electrophoresis","meaning":"가느다란 모세관 안에서 전기장을 이용해 DNA 조각을 크기별로 분리하고 검출하는, 법유전학 STR 분석의 핵심 장비…","subcategory":"법유전학","level":2,"related":["agarose-gel-electrophoresis","bioanalyzer-tapestation"],"prerequisites":[],"pop":5,"aliases":["CE","모세관전기영동법"]},{"slug":"biogeographic-ancestry-inference","title_ko":"생물지리학적 조상추정","title_en":"Biogeographic Ancestry Inference","meaning":"DNA에 나타나는 유전적 특징을 이용해 개인의 조상이 지리적으로 어느 인구집단과 가까운지를 통계적으로 추정하는 법유전학…","subcategory":"법유전학","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["생물지리학적조상추정"]},{"slug":"expirated-blood-pattern","title_ko":"호기성 혈흔 패턴","title_en":"Expirated Blood Pattern","meaning":"코나 입, 기도 등에 출혈이 있는 사람이 숨을 내쉬거나 기침, 재채기를 할 때 공기와 함께 뿜어져 나온 혈액이 만드는 미세한…","subcategory":"혈흔분석","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["호기성혈흔패턴"]},{"slug":"petechial-hemorrhage","title_ko":"점상출혈","title_en":"Petechial Hemorrhage","meaning":"모세혈관이 파열되어 피부나 점막에 생기는 아주 작은 붉은 반점 형태의 출혈을 말합니다.","subcategory":"법의병리학","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["일혈점","점출혈","타르디외 반점"]},{"slug":"chain-of-custody-forensic-evidence","title_ko":"법과학 증거보관연속성","title_en":"Chain of Custody in Forensic Evidence","meaning":"증거물이 수집된 순간부터 법정에 제출되기까지 누가, 언제, 어떻게 다루었는지를 문서로 빠짐없이 기록하고 관리하는 절차입니다.","subcategory":"증거관리","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["CCFE","법과학증거보관연속성"]}]