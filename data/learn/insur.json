[{"slug":"reinsurance","title_ko":"재보험","title_en":"Reinsurance","meaning":"원보험자가 인수한 위험의 전부 또는 일부를 다른 보험자에게 다시 인수시켜 자신의 위험 부담을 분산하는 보험자 간의 위험 전가…","subcategory":"보험이론·상품","level":1,"related":[],"prerequisites":[],"aliases":["리인슈어런스","재보험거래"]},{"slug":"insurance-policy-terms","title_ko":"보험약관","title_en":"Insurance Policy Terms","meaning":"보험자가 다수의 보험계약에 동일하게 적용하기 위해 미리 작성한 계약조항으로, 보장범위, 면책사유, 보험금 지급절차 등 계약…","subcategory":"보험이론·상품","level":1,"related":[],"prerequisites":[],"aliases":["보험약관조항","약관"]},{"slug":"principle-of-indemnity","title_ko":"이득금지의 원칙","title_en":"Principle of Indemnity","meaning":"손해보험에서 보험금 지급이 실제 발생한 손해액을 초과할 수 없다는 원칙으로, 보험을 통한 부당한 이득 취득을 방지하기 위한…","subcategory":"보험이론·상품","level":1,"related":[],"prerequisites":[],"pop":5,"aliases":["이득금지의원칙"]},{"slug":"proximate-cause-doctrine","title_ko":"근인주의","title_en":"Proximate Cause Doctrine","meaning":"보험사고와 손해 사이의 인과관계를 판단할 때 시간적으로 가장 가까운 원인이 아니라 손해를 초래한 지배적이고 효과적인 원인을…","subcategory":"보험이론·상품","level":2,"related":[],"prerequisites":[],"aliases":["근인원칙","상당인과관계"]},{"slug":"risk-pooling","title_ko":"위험의 분산","title_en":"Risk Pooling","meaning":"다수의 동질적 경제주체가 각자의 위험을 하나의 집단으로 결합함으로써 개별 주체가 부담해야 할 불확실성을 집단 전체로…","subcategory":"보험이론·상품","level":2,"related":["mutuality-principle-insurance"],"prerequisites":["mutuality-principle-insurance"],"pop":14,"aliases":["위험의분산"]},{"slug":"pure-risk-speculative-risk","title_ko":"순수위험과 투기적위험","title_en":"Pure Risk vs Speculative Risk","meaning":"손실만 발생하거나 손실이 없는 상태만 존재하는 순수위험과, 손실과 이익 발생 가능성이 함께 존재하는 투기적위험을 구분하는…","subcategory":"보험이론·상품","level":3,"related":["insurable-risk-requirements","hazard-peril-distinction"],"prerequisites":[],"pop":11,"aliases":["PRVSR","순수위험과투기적위험"]},{"slug":"insurable-risk-requirements","title_ko":"보험가능위험의 요건","title_en":"Requirements of Insurable Risk","meaning":"다수의 동질적 위험 존재, 우연성, 손해의 확정성과 측정가능성, 비재난성 등 위험이 보험상품으로 성립하기 위해 갖추어야 하는…","subcategory":"보험이론·상품","level":3,"related":["pure-risk-speculative-risk"],"prerequisites":[],"aliases":["보험가능위험의요건"]},{"slug":"mutuality-principle-insurance","title_ko":"상호부조의 원칙","title_en":"Mutuality Principle","meaning":"다수의 계약자가 각출한 보험료를 공동의 재원으로 모아 그 중 실제로 손해를 입은 소수의 계약자에게 보험금을 지급하는 보험…","subcategory":"보험이론·상품","level":1,"related":["risk-pooling"],"prerequisites":[],"pop":2,"aliases":["상호부조의원칙"]},{"slug":"equivalence-principle-insurance","title_ko":"수지상등의 원칙","title_en":"Equivalence Principle","meaning":"보험계약 체결 시점에서 장래 보험료 수입의 현재가치와 장래 보험금 지급의 현재가치가 서로 같아지도록 보험료를 산정해야 한다는…","subcategory":"보험이론·상품","level":1,"related":[],"prerequisites":[],"pop":10,"aliases":["수지상등의원칙","수지상등원칙","Actuarial Equivalence Principle"]},{"slug":"endowment-insurance","title_ko":"양로보험","title_en":"Endowment Insurance","meaning":"보험기간 중 사망하면 사망보험금을, 만기까지 생존하면 만기보험금을 지급하는 생사혼합보험으로 보장과 저축의 기능을 함께…","subcategory":"보험이론·상품","level":3,"related":[],"prerequisites":[],"pop":12,"aliases":["생사혼합보험","양로보험상품"]},{"slug":"business-interruption-insurance","title_ko":"기업휴지보험","title_en":"Business Interruption Insurance","meaning":"화재 등 담보위험으로 인해 사업장이 손상되어 영업이 중단됨으로써 발생하는 이익 상실과 고정비 손실을 보상하는 손해보험…","subcategory":"보험이론·상품","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["BII"]},{"slug":"grace-period-insurance","title_ko":"납입유예기간","title_en":"Grace Period","meaning":"보험료 납입기일이 지났음에도 일정 기간 동안 계약의 효력을 유지시켜 그 기간 내에 보험료를 납입하면 계약이 실효되지 않도록…","subcategory":"보험이론·상품","level":2,"related":["insurance-policy-terms"],"prerequisites":["insurance-policy-terms"],"pop":7,"aliases":["보험료납입유예","유예기간"]},{"slug":"hazard-peril-distinction","title_ko":"위태와 손인","title_en":"Hazard vs Peril","meaning":"손해의 직접적 원인이 되는 사건인 손인과, 손인의 발생 가능성이나 손해의 정도를 증가시키는 조건인 위태를 구분하는 보험이론의…","subcategory":"보험이론·상품","level":3,"related":["moral-hazard","proximate-cause-doctrine","pure-risk-speculative-risk"],"prerequisites":["moral-hazard","proximate-cause-doctrine"],"pop":4,"aliases":["위태와손인"]},{"slug":"deductible","title_ko":"자기부담금","title_en":"Deductible","meaning":"보험사고로 인한 손해액 중 계약자가 스스로 부담하기로 약정한 일정 금액으로, 이를 초과하는 부분에 대해서만 보험자가…","subcategory":"보험이론·상품","level":1,"related":["moral-hazard"],"prerequisites":[],"aliases":["공제금액","디덕터블"]},{"slug":"operational-risk","title_ko":"운영리스크","title_en":"Operational Risk","meaning":"부적절하거나 잘못된 내부 절차, 인력, 시스템 또는 외부 사건으로 인해 보험회사가 입을 수 있는 손실 위험을 말한다.","subcategory":"보험계리·리스크관리","level":3,"related":[],"prerequisites":[],"aliases":["오퍼레이셔널리스크","운영위험"]},{"slug":"fair-value-insurance-liability","title_ko":"보험부채시가평가","title_en":"Fair Value Measurement of Insurance Liability","meaning":"보험부채를 계약 체결 시점의 가정이 아닌 현재 시점의 시장금리와 최신 가정으로 재평가하는 회계·감독상의 측정 방식을 말한다.","subcategory":"보험계리·리스크관리","level":1,"related":[],"prerequisites":[],"aliases":["FVMIL"]},{"slug":"bornhuetter-ferguson-method","title_ko":"본휴터퍼거슨법","title_en":"Bornhuetter-Ferguson Method","meaning":"사전에 예상한 손해율과 실제 발전된 손해액 정보를 가중평균하여 미보고손해액을 추정하는 손해준비금 산출 기법을 말한다.","subcategory":"보험계리·리스크관리","level":2,"related":["incurred-but-not-reported-reserve"],"prerequisites":[],"pop":9,"aliases":["BF법","본휴터-퍼거슨"]},{"slug":"preferred-risk","title_ko":"우량체","title_en":"Preferred Risk","meaning":"언더라이팅 심사 결과 평균보다 낮은 위험 수준으로 평가되어 할인된 보험료율이 적용되는 피보험자 등급을 말한다.","subcategory":"보험계리·리스크관리","level":2,"related":[],"prerequisites":[],"pop":13,"aliases":["우량위험체","우량체할인"]},{"slug":"separate-account","title_ko":"특별계정","title_en":"Separate Account","meaning":"변액보험 등의 자산을 회사의 일반 자산과 분리하여 별도로 운용·관리하는 회계상의 계정을 말한다.","subcategory":"보험계리·리스크관리","level":1,"related":["general-account"],"prerequisites":[],"pop":16},{"slug":"general-account","title_ko":"일반계정","title_en":"General Account","meaning":"특별계정으로 분리되지 않은 보험회사의 일반적인 자산과 부채를 운용·관리하는 회계상의 계정을 말한다.","subcategory":"보험계리·리스크관리","level":3,"related":["separate-account"],"prerequisites":["separate-account"],"pop":15},{"slug":"premium-allocation-approach","title_ko":"보험료배분법","title_en":"Premium Allocation Approach","meaning":"IFRS17에서 보험기간이 1년 이내로 짧은 계약군에 대해 일반모형 대신 적용할 수 있는 간편화된 부채 측정 방법을 말한다.","subcategory":"보험계리·리스크관리","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["PAA"]},{"slug":"net-single-premium","title_ko":"순보험료(일시납)","title_en":"Net Single Premium","meaning":"사업비 등 부가보험료를 제외하고 순수하게 위험보장에 대한 대가로 계약 시점에 한 번에 납입하는 보험료입니다.","subcategory":"생명보험수리","level":2,"related":[],"prerequisites":[],"aliases":["일시납"]},{"slug":"single-decrement-table","title_ko":"단일탈퇴표","title_en":"Single Decrement Table","meaning":"사망, 해약, 장해 등 여러 탈퇴 원인 중 오직 하나의 원인만 존재한다고 가정하고 작성한 생명표입니다.","subcategory":"다중탈퇴이론","level":2,"related":["associated-single-decrement-table"],"prerequisites":[]},{"slug":"associated-single-decrement-table","title_ko":"연관단일탈퇴표","title_en":"Associated Single Decrement Table","meaning":"여러 탈퇴 원인이 동시에 작용하는 다중탈퇴표로부터, 각 원인별로 다른 원인이 없다고 가정했을 때의 탈퇴율을 산출하여 만든…","subcategory":"다중탈퇴이론","level":2,"related":["single-decrement-table"],"prerequisites":[],"aliases":["ASDT"]},{"slug":"retention-limit","title_ko":"보유한도(보유액)","title_en":"Retention Limit","meaning":"원수보험사가 재보험으로 전가하지 않고 자체적으로 부담하기로 정한 위험의 최대 금액입니다.","subcategory":"재보험","level":2,"related":[],"prerequisites":[],"aliases":["보유액","자기보유액"]},{"slug":"incurred-but-not-reported-reserve","title_ko":"미보고발생손해액준비금(IBNR)","title_en":"Incurred But Not Reported Reserve","meaning":"이미 발생했지만 결산 시점까지 보험회사에 아직 접수 또는 보고되지 않은 사고에 대비해 적립하는 준비금입니다.","subcategory":"손해보험수리","level":2,"related":[],"prerequisites":[],"aliases":["IBNR준비금","미보고발생손해액","미보고발생손해준비금"]},{"slug":"base-rate-ratemaking","title_ko":"기본요율","title_en":"Base Rate","meaning":"기본요율은 기준이 되는 위험군에 대해 산출된 보험료의 출발점으로, 여기에 여러 요율상대도를 곱하여 개별 계약자의 최종…","subcategory":"요율산정","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["기준요율"]},{"slug":"loss-development-factor","title_ko":"손해진전계수","title_en":"Loss Development Factor","meaning":"특정 진전연도의 누적손해액을 다음 진전연도의 누적손해액으로 전환하기 위해 곱하는 비율로, 손해가 시간이 지나면서 얼마나…","subcategory":"손해보험수리","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["LDF","손해진전율"]}]