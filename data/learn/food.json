[{"slug":"cohort-study","title_ko":"코호트연구","title_en":"Cohort Study","meaning":"특정 공통점을 가진 사람들의 집단(코호트)을 오랜 기간 추적 관찰하며 특정 요인과 결과 사이의 관계를 살펴보는 연구…","subcategory":"연구설계","level":1,"related":["randomized-controlled-trial","control-group","case-control-study","confounding-variable"],"prerequisites":[],"pop":3,"aliases":["코호트","전향적코호트","코호트 조사"]},{"slug":"case-control-study","title_ko":"환자-대조군 연구","title_en":"Case-Control Study","meaning":"이미 특정 질병이 발생한 환자군과 발생하지 않은 대조군을 비교하여, 과거의 노출 요인에 어떤 차이가 있었는지 거슬러 조사하는…","subcategory":"역학·공중보건","level":1,"related":["cohort-study","odds-ratio","control-group","confounding-variable"],"prerequisites":[],"aliases":["환자대조군연구","환자 대조군연구","케이스컨트롤","환자대조연구"]},{"slug":"confounding-variable","title_ko":"교란변수","title_en":"Confounding Variable","meaning":"원인과 결과 둘 다에 영향을 미쳐서, 둘 사이에 진짜 관계가 없어도 있는 것처럼 보이게 만드는 숨은 제3의 변수입니다.","subcategory":"역학·공중보건","level":1,"related":["propensity-score-matching","surrogate-endpoint","cohort-study","case-control-study"],"prerequisites":[],"pop":12,"aliases":["교란요인"]},{"slug":"social-cognitive-theory","title_ko":"사회인지이론","title_en":"Social Cognitive Theory","meaning":"개인의 인지(생각), 행동, 주변 환경이 서로 영향을 주고받으며 성격과 행동을 형성한다고 보는 반두라(Bandura)의…","subcategory":"사회심리","level":3,"related":["self-efficacy","attribution-theory","health-belief-model"],"prerequisites":["attribution-theory"]},{"slug":"uht-processing","title_ko":"초고온순간살균","title_en":"UHT processing","meaning":"135~150℃의 초고온에서 2~5초의 극히 짧은 시간 동안 식품을 가열한 뒤 무균 포장하여 상온 장기 보존을 가능하게 하는…","subcategory":"식품과학·식품가공","level":3,"related":["shelf-life"],"prerequisites":[],"pop":11,"aliases":["UHT","초고온살균"]},{"slug":"extrusion-cooking","title_ko":"압출성형","title_en":"extrusion cooking","meaning":"곡물 등의 원료를 고온·고압·전단력이 가해지는 압출기 내에서 가열, 혼합, 성형을 동시에 진행하여 팽화 스낵이나 조직화…","subcategory":"식품과학·식품가공","level":3,"related":["starch-gelatinization"],"prerequisites":["starch-gelatinization"]},{"slug":"osmotic-dehydration","title_ko":"삼투건조","title_en":"osmotic dehydration","meaning":"고농도의 당액이나 염액에 식품을 침지시켜 삼투압 차이를 이용해 수분을 제거하는 전처리 또는 부분 건조 기술.","subcategory":"식품과학·식품가공","level":3,"related":["water-activity","shelf-life"],"prerequisites":["water-activity"]},{"slug":"smoking-food","title_ko":"훈연","title_en":"smoking","meaning":"목재를 불완전연소시켜 발생한 연기 성분을 식품에 흡착시켜 항균·항산화 효과와 독특한 풍미를 부여하는 저장 및 가공 기술.","subcategory":"식품과학·식품가공","level":3,"related":[],"prerequisites":[]},{"slug":"sugaring","title_ko":"당장","title_en":"sugaring","meaning":"고농도의 당을 식품에 첨가하여 삼투압을 높이고 수분활성도를 낮춤으로써 미생물 증식을 억제하는 저장 방법.","subcategory":"식품과학·식품가공","level":3,"related":["water-activity","shelf-life"],"prerequisites":["water-activity"]},{"slug":"water-activity","title_ko":"수분활성도","title_en":"water activity","meaning":"식품 중 자유수의 증기압과 동일 온도에서의 순수한 물의 증기압 비율(Aw)로, 미생물이 실제로 이용할 수 있는 수분의 양을…","subcategory":"식품과학·식품가공","level":1,"related":["shelf-life","sugaring"],"prerequisites":[],"pop":2,"aliases":["Aw"]},{"slug":"edible-film","title_ko":"가식성필름","title_en":"edible film","meaning":"단백질, 다당류, 지질 등 식용 가능한 소재로 만들어 식품 표면을 코팅하거나 개별 포장에 사용하며 그대로 섭취할 수 있는…","subcategory":"식품과학·식품가공","level":1,"related":[],"prerequisites":[],"aliases":["식용필름"]},{"slug":"iso-22000","title_ko":"ISO 22000 식품안전경영시스템","title_en":"ISO 22000","meaning":"HACCP 원칙과 경영시스템 요구사항을 결합하여 조직 전체 차원에서 식품안전을 관리하도록 국제표준화기구(ISO)가 제정한…","subcategory":"식품과학·식품가공","level":3,"related":[],"prerequisites":[],"aliases":["ISO22000식품안전경영시스템"]},{"slug":"flavor-enhancer","title_ko":"향미증진제","title_en":"flavor enhancer","meaning":"식품 자체의 맛과 향을 더욱 강화하거나 조화롭게 부각시키기 위해 사용하는 식품첨가물로 대표적으로 글루탐산나트륨이 있다.","subcategory":"식품과학·식품가공","level":2,"related":["hedonic-scale"],"prerequisites":["hedonic-scale"]},{"slug":"gelling-agent","title_ko":"겔화제","title_en":"gelling agent","meaning":"액상 또는 콜로이드 상태의 식품을 삼차원 망상 구조로 응고시켜 일정한 형태를 유지하는 겔을 형성하도록 돕는 식품첨가물.","subcategory":"식품과학·식품가공","level":2,"related":["gelation","gel-strength","syneresis"],"prerequisites":["gel-strength","syneresis"],"pop":13,"aliases":["젤화제"]},{"slug":"syneresis","title_ko":"이수현상","title_en":"syneresis","meaning":"겔 구조를 형성한 식품에서 시간이 지나면서 망상 구조가 수축하며 내부에 갇혀 있던 물이 표면으로 분리되어 나오는 현상.","subcategory":"식품과학·식품가공","level":1,"related":["gelation","gel-strength"],"prerequisites":[],"pop":17,"aliases":["시너레시스","이장현상"]},{"slug":"gel-strength","title_ko":"겔강도","title_en":"gel strength","meaning":"형성된 겔이 파괴되기까지 견딜 수 있는 힘의 크기로, 겔의 단단함과 구조적 안정성을 나타내는 물성 지표.","subcategory":"식품과학·식품가공","level":1,"related":["gelation","gelling-agent","syneresis"],"prerequisites":[]},{"slug":"spoilage-microorganism","title_ko":"부패미생물","title_en":"spoilage microorganism","meaning":"식품 성분을 분해하여 이취, 변색, 점질물 생성 등 관능적 품질 저하를 일으키는 미생물로, 반드시 병원성을 갖는 것은 아니다.","subcategory":"식품과학·식품가공","level":3,"related":["shelf-life"],"prerequisites":[],"pop":14},{"slug":"peroxide-value","title_ko":"과산화물가","title_en":"peroxide value","meaning":"지질 산화의 초기 생성물인 과산화물의 함량을 요오드 적정법 등으로 측정하여 산화 초기 진행 정도를 나타내는 지표.","subcategory":"식품과학·식품가공","level":1,"related":[],"prerequisites":[]},{"slug":"non-enzymatic-browning","title_ko":"비효소적갈변","title_en":"non-enzymatic browning","meaning":"효소의 관여 없이 마이야르반응이나 캐러멜화 등 화학반응을 통해 식품이 갈색으로 변하는 현상.","subcategory":"식품과학·식품가공","level":3,"related":["shelf-life"],"prerequisites":[],"pop":9,"aliases":["NEB"]},{"slug":"food-emulsion","title_ko":"식품에멀전","title_en":"food emulsion","meaning":"본래 서로 섞이지 않는 물과 기름이 유화제의 도움으로 한쪽이 미세한 방울 형태로 다른 쪽에 분산되어 형성된 콜로이드 상태의…","subcategory":"식품과학·식품가공","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["식품유화액"]},{"slug":"starch-gelatinization","title_ko":"전분호화","title_en":"starch gelatinization","meaning":"전분 입자가 물과 함께 가열되면서 결정 구조가 붕괴되고 물을 흡수하여 팽윤, 점도 상승을 일으키는 현상.","subcategory":"식품과학·식품가공","level":1,"related":["starch-retrogradation","extrusion-cooking"],"prerequisites":[],"pop":18,"aliases":["호화"]},{"slug":"starch-retrogradation","title_ko":"전분노화","title_en":"starch retrogradation","meaning":"호화된 전분이 저장 중 냉각되면서 분자들이 재결합하여 원래의 결정 구조에 가까운 형태로 되돌아가며 굳고 수분이 분리되는 현상.","subcategory":"식품과학·식품가공","level":3,"related":["starch-gelatinization","syneresis"],"prerequisites":["