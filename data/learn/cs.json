[{"slug":"overfitting","title_ko":"과적합","title_en":"Overfitting","meaning":"모델이 학습 데이터에만 지나치게 맞춰져 새로운 데이터에서 성능이 떨어지는 현상입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["cross-validation"],"prerequisites":[],"pop":15,"aliases":["오버피팅"]},{"slug":"neural-network","title_ko":"인공신경망","title_en":"Neural Network","meaning":"뇌 신경세포 연결 구조를 본떠 만든 다층 예측 모델 구조입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["attention-mechanism","gradient-descent"],"prerequisites":[],"pop":13,"aliases":["신경망"]},{"slug":"cross-validation","title_ko":"교차검증","title_en":"Cross-validation","meaning":"데이터를 여러 부분으로 나눠 번갈아 학습·검증하며 모델 성능을 평가하는 방법입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["overfitting","panel-data"],"prerequisites":[],"aliases":["교차검정"]},{"slug":"attention-mechanism","title_ko":"어텐션 메커니즘","title_en":"Attention Mechanism","meaning":"입력의 여러 부분 중 지금 작업에 더 중요한 부분에 더 큰 가중치를 주어 집중하게 만드는 신경망 기법입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["transformer","neural-network","recurrent-neural-network","ablation-study"],"prerequisites":[],"aliases":["어텐션","self-attention","어텐션메커니즘"]},{"slug":"gradient-descent","title_ko":"경사하강법","title_en":"Gradient Descent","meaning":"모델의 오차(손실)를 줄이기 위해 기울기가 감소하는 방향으로 파라미터를 조금씩 업데이트해 나가는 최적화 알고리즘입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["neural-network","transformer"],"prerequisites":[],"pop":3,"aliases":["경사하강"]},{"slug":"transformer","title_ko":"트랜스포머","title_en":"Transformer","meaning":"문장 안의 모든 단어가 서로 얼마나 관련 있는지를 한꺼번에 계산해 문맥을 파악하는 신경망 구조입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["attention-mechanism","gradient-descent","recurrent-neural-network"],"prerequisites":[],"pop":2},{"slug":"convolutional-neural-network","title_ko":"합성곱 신경망","title_en":"convolutional neural network","meaning":"작은 필터를 이미지 위에서 이동시키며 선, 모서리, 무늬 같은 지역적 특징을 단계적으로 뽑아내는 신경망 구조입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["recurrent-neural-network"],"prerequisites":[],"pop":14,"aliases":["CNN","합성곱신경망"]},{"slug":"recurrent-neural-network","title_ko":"순환 신경망","title_en":"Recurrent Neural Network","meaning":"이전 시점의 정보를 은닉 상태로 기억하며 순서가 있는 데이터를 순차적으로 처리하는 신경망입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["attention-mechanism","transformer","convolutional-neural-network"],"prerequisites":[],"pop":19,"aliases":["RNN","순환신경망"]},{"slug":"loss-function","title_ko":"손실함수","title_en":"Loss Function","meaning":"모델의 예측값이 실제 정답과 얼마나 다른지를 하나의 숫자로 나타내는 함수입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["ablation-study"],"prerequisites":[],"aliases":["비용함수","cost function"]},{"slug":"ablation-study","title_ko":"제거 연구","title_en":"Ablation Study","meaning":"모델이나 시스템의 특정 구성 요소를 하나씩 빼거나 바꿔보면서, 그 요소가 전체 성능에 얼마나 기여하는지 확인하는 실험입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["attention-mechanism","loss-function"],"prerequisites":[],"pop":7,"aliases":["애블레이션 연구","제거연구"]},{"slug":"backpropagation","title_ko":"역전파","title_en":"Backpropagation","meaning":"신경망의 예측이 틀린 정도(오차)를 출력층에서 입력층 방향으로 거꾸로 전달하면서, 각 가중치가 오차에 얼마나 책임이…","subcategory":"인공지능·머신러닝","level":1,"related":["gradient-descent","neural-network","loss-function","batch-normalization"],"prerequisites":[],"pop":20,"aliases":["오차역전파","backprop"]},{"slug":"batch-normalization","title_ko":"배치 정규화","title_en":"Batch Normalization","meaning":"학습 중 미니배치 단위로 각 층에 들어오는 값의 평균과 분산을 일정하게 맞춰주어(평균 0, 분산 1), 신경망 학습을 더…","subcategory":"인공지능·머신러닝","level":1,"related":["neural-network","gradient-descent"],"prerequisites":[],"aliases":["배치정규화","BN"]},{"slug":"prompt-engineering","title_ko":"프롬프트 엔지니어링","title_en":"prompt engineering","meaning":"모델의 가중치는 바꾸지 않고, 입력 지시문(프롬프트)의 구성과 표현을 설계해 언어 모델이 원하는 답을 내놓도록 유도하는…","subcategory":"인공지능·머신러닝","level":1,"related":[],"prerequisites":[],"aliases":["프롬프트 설계","프롬프팅","프롬프트엔지니어링"]},{"slug":"api-basics","title_ko":"API (응용 프로그래밍 인터페이스)","title_en":"API","meaning":"서로 다른 소프트웨어가 정해진 규칙에 따라 데이터나 기능을 주고받을 수 있게 해주는 약속된 통로입니다.","subcategory":"소프트웨어공학","level":1,"related":["large-language-model"],"prerequisites":[],"aliases":["API","응용 프로그래밍 인터페이스","Application Programming Interface","API(응용프로그래밍인터페이스)"]},{"slug":"large-language-model","title_ko":"대규모 언어 모델","title_en":"Large Language Model (LLM)","meaning":"수많은 텍스트 데이터를 학습해 다음에 올 단어를 예측하는 방식으로 문장을 생성하고 이해하는 초대형 인공신경망 모델입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["transformer","prompt-engineering"],"prerequisites":[],"pop":16,"aliases":["LLM","언어 모델","대형 언어 모델","대규모언어모델"]},{"slug":"deadlock","title_ko":"교착 상태","title_en":"Deadlock","meaning":"둘 이상의 프로세스나 스레드가 서로 상대방이 점유한 자원을 기다리며 무한정 멈춰 있는 상태입니다.","subcategory":"데이터베이스·시스템","level":1,"related":[],"prerequisites":[],"aliases":["교착상태","데드락"]},{"slug":"sharding","title_ko":"샤딩","title_en":"Sharding","meaning":"하나의 큰 데이터베이스를 여러 개의 작은 조각(샤드)으로 나누어 여러 서버에 분산 저장하는 기법입니다.","subcategory":"데이터베이스·시스템","level":1,"related":[],"prerequisites":[],"aliases":["데이터베이스 샤딩","샤드"]},{"slug":"reward-prediction-error","title_ko":"보상예측오차","title_en":"reward prediction error","meaning":"실제로 받은 보상과 미리 예측했던 보상 사이의 차이로, 중뇌 도파민 신경세포의 발화 패턴이 이 값을 부호화해 학습 신호로…","subcategory":"인지신경과학","level":1,"related":["substantia-nigra"],"prerequisites":[],"aliases":["보상 예측 오차","RPE"]},{"slug":"k-means-clustering","title_ko":"k-평균 군집화","title_en":"k-means clustering","meaning":"미리 정해둔 개수(k개)만큼 데이터를 서로 비슷한 것끼리 자동으로 묶어주는 대표적인 군집화 알고리즘이다.","subcategory":"다변량·고급기법","level":1,"related":["principal-component-analysis","factor-analysis"],"prerequisites":[],"pop":10,"aliases":["k평균 군집화","k-means","k평균 알고리즘","k 평균 군집화","k-평균군집화"]},{"slug":"chain-rule","title_ko":"연쇄법칙","title_en":"Chain Rule","meaning":"함수 여러 개가 겹쳐 있을 때, 전체를 한 번에 미분하지 않고 각 단계를 따로 미분한 뒤 곱해서 합치는 규칙입니다.","subcategory":"해석학·미적분","level":1,"related":["backpropagation","gradient-descent"],"prerequisites":[],"aliases":["chain rule","합성함수 미분법"]},{"slug":"ridge-regression","title_ko":"릿지 회귀","title_en":"Ridge Regression","meaning":"회귀계수의 크기에 페널티(L2 규제)를 부여해 다중공선성과 과적합의 영향을 줄이는 회귀 기법입니다.","subcategory":"회귀·상관분석","level":1,"related":["multicollinearity","overfitting","regression"],"prerequisites":[],"aliases":["릿지회귀","Ridge Regression","L2 정규화"]},{"slug":"activation-function","title_ko":"활성화 함수","title_en":"Activation Function","meaning":"인공신경망의 각 뉴런에 들어온 입력값의 합을 특정 규칙에 따라 비선형적으로 변환하여 다음 층으로 전달하는 함수입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["neural-network","backpropagation","gradient-descent"],"prerequisites":[],"pop":9,"aliases":["Activation Function","활성화함수"]},{"slug":"rasterization","title_ko":"래스터화","title_en":"Rasterization","meaning":"3차원 공간에 정의된 점과 면(폴리곤) 정보를 화면에 표시할 2차원 격자 픽셀로 빠르게 변환하는 렌더링 방식입니다.","subcategory":"알고리즘·자료구조","level":2,"related":[],"prerequisites":[],"aliases":["래스터라이제이션","픽셀화"]},{"slug":"divide-and-conquer","title_ko":"분할정복","title_en":"Divide and Conquer","meaning":"큰 문제를 풀기 쉬운 작은 문제들로 쪼갠 뒤, 각각을 따로 해결하고 그 결과를 합쳐서 원래 문제의 답을 구하는 방법입니다.","subcategory":"알고리즘·자료구조","level":1,"related":[],"prerequisites":[]},{"slug":"memoization","title_ko":"메모이제이션","title_en":"Memoization","meaning":"이미 계산한 함수의 결과를 저장해두었다가, 같은 입력이 다시 들어오면 재계산하지 않고 저장된 값을 즉시 꺼내 쓰는 최적화…","subcategory":"알고리즘·자료구조","level":3,"related":["divide-and-conquer"],"prerequisites":["divide-and-conquer"]},{"slug":"sliding-window-technique","title_ko":"슬라이딩 윈도우 기법","title_en":"Sliding Window Technique","meaning":"배열이나 문자열 위에서 일정한 크기(또는 조건에 따라 늘었다 줄었다 하는) 구간을 창(윈도우)처럼 옮겨가며, 매번 처음부터…","subcategory":"알고리즘·자료구조","level":2,"related":[],"prerequisites":[],"aliases":["슬라이딩윈도우기법"]},{"slug":"avl-tree","title_ko":"AVL 트리","title_en":"AVL Tree","meaning":"왼쪽과 오른쪽 하위 트리의 높이 차이를 항상 1 이하로 유지하도록 스스로 균형을 맞추는 이진 탐색 트리입니다.","subcategory":"알고리즘·자료구조","level":2,"related":[],"prerequisites":[],"aliases":["AVL트리"]},{"slug":"network-protocol-basics","title_ko":"네트워크와 프로토콜 기초","title_en":"Network Protocol Basics","meaning":"네트워크는 여러 컴퓨터가 서로 연결된 통신망이고, 프로토콜은 그 컴퓨터들이 데이터를 주고받을 때 지켜야 하는 약속된…","subcategory":"네트워크·보안","level":1,"related":["api-basics"],"prerequisites":[],"aliases":["네트워크와프로토콜기초"]},{"slug":"differential-privacy","title_ko":"차분 프라이버시","title_en":"Differential Privacy","meaning":"어떤 한 사람의 데이터가 포함되든 빠지든 분석 결과가 거의 달라지지 않도록 수학적으로 잡음을 더해 개인정보를 보호하는…","subcategory":"네트워크·보안","level":2,"related":[],"prerequisites":[],"aliases":["차분프라이버시"]},{"slug":"halting-problem","title_ko":"정지 문제","title_en":"Halting Problem","meaning":"임의의 프로그램이 언젠가 멈출지 영원히 계속될지를 모든 경우에 대해 판별해주는 알고리즘은 존재할 수 없다는 이론적 결론입니다.","subcategory":"이론전산학","level":1,"related":[],"prerequisites":[],"aliases":["정지문제"]},{"slug":"linked-list","title_ko":"연결 리스트","title_en":"Linked List","meaning":"각 데이터가 다음 데이터의 위치를 가리키는 방식으로 줄줄이 연결된 자료구조입니다.","subcategory":"알고리즘·자료구조","level":1,"related":[],"prerequisites":[],"aliases":["연결리스트"]},{"slug":"data-pipeline","title_ko":"데이터 파이프라인","title_en":"Data Pipeline","meaning":"원시 데이터를 수집해서 정리하고 가공한 뒤 저장하거나 분석에 쓸 수 있게 만드는, 일련의 자동화된 처리 흐름입니다.","subcategory":"데이터베이스·시스템","level":2,"related":["api-basics"],"prerequisites":[],"pop":17,"aliases":["데이터파이프라인"]},{"slug":"kmp-algorithm","title_ko":"KMP 알고리즘","title_en":"Knuth-Morris-Pratt Algorithm","meaning":"긴 문자열 속에서 짧은 패턴을 찾을 때, 이미 비교했던 정보를 재활용해 불필요한 되돌아가기를 없앤 고속 문자열 검색…","subcategory":"알고리즘·자료구조","level":3,"related":["divide-and-conquer"],"prerequisites":["divide-and-conquer"],"aliases":["KMPA","KMP알고리즘"]},{"slug":"lexical-and-syntax-analysis","title_ko":"어휘 분석과 구문 분석","title_en":"Lexical and Syntax Analysis","meaning":"컴파일러가 소스 코드를 이해하는 첫 두 단계로, 문자열을 의미 있는 단어 단위(토큰)로 쪼개는 어휘 분석과 그 토큰들이…","subcategory":"이론전산학","level":3,"related":[],"prerequisites":[],"aliases":["어휘분석과구문분석"]},{"slug":"pipelining","title_ko":"파이프라이닝","title_en":"Pipelining","meaning":"CPU가 명령어 하나를 끝까지 처리한 뒤 다음 명령어를 시작하지 않고, 여러 명령어의 처리 단계를 겹쳐서 동시에 진행하는…","subcategory":"데이터베이스·시스템","level":2,"related":[],"prerequisites":[]},{"slug":"relu","title_ko":"렐루 함수","title_en":"ReLU","meaning":"입력값이 0보다 크면 그대로 통과시키고, 0 이하이면 무조건 0으로 만드는 매우 단순한 활성화 함수입니다.","subcategory":"인공지능·머신러닝","level":2,"related":["activation-function","gradient-descent","convolutional-neural-network"],"prerequisites":["activation-function","gradient-descent"],"pop":5,"aliases":["렐루함수"]},{"slug":"curse-of-dimensionality","title_ko":"차원의 저주","title_en":"Curse of Dimensionality","meaning":"데이터를 표현하는 변수(차원)의 수가 늘어날수록 데이터가 공간에 희박하게 퍼져, 거리 계산이나 학습이 급격히 어려워지는…","subcategory":"인공지능·머신러닝","level":3,"related":["principal-component-analysis","k-means-clustering","overfitting"],"prerequisites":["overfitting"],"pop":12,"aliases":["차원의저주"]},{"slug":"rest-api","title_ko":"REST API (자원 중심 API 설계)","title_en":"REST API","meaning":"웹의 자원(데이터)을 URL로 표현하고, GET·POST·PUT·DELETE 같은 정해진 방식(HTTP 메서드)으로…","subcategory":"소프트웨어공학","level":2,"related":["api-basics","websocket"],"prerequisites":["api-basics"],"aliases":["RESTAPI","RESTAPI(자원중심API설계)","자원 중심 API 설계"]},{"slug":"websocket","title_ko":"웹소켓 (WebSocket)","title_en":"WebSocket","meaning":"클라이언트와 서버가 한 번 연결을 맺으면 그 연결을 계속 열어둔 채, 필요할 때마다 양쪽 모두가 실시간으로 데이터를 주고받을…","subcategory":"네트워크·보안","level":3,"related":["rest-api"],"prerequisites":[],"aliases":["웹소켓","웹소켓(WebSocket)"]},{"slug":"api-gateway","title_ko":"API 게이트웨이 (API Gateway)","title_en":"Api Gateway","meaning":"여러 개의 서버(서비스)로 가는 모든 요청을 한곳에서 먼저 받아 인증하고 적절한 곳으로 나눠 보내주는 중간 관문 역할을 하는…","subcategory":"소프트웨어공학","level":1,"related":["rest-api"],"prerequisites":[],"pop":4,"aliases":["API 게이트웨이","API게이트웨이","API게이트웨이(APIGateway)"]},{"slug":"floating-point-representation","title_ko":"부동소수점 표현 (Floating-Point Representation)","title_en":"Floating Point Representation","meaning":"컴퓨터가 0과 1만으로 소수(小數)를 근사해서 저장하는 방식으로, 부호·지수·가수 세 부분으로 나누어 표현합니다.","subcategory":"이론전산학","level":3,"related":[],"prerequisites":[],"aliases":["Floating-Point Representation","부동소수점 표현","부동소수점 표현 (Floating Point Representation)","부동소수점 표현 (FloatingPoint Representation)","부동소수점표현","부동소수점표현(Floating-PointRepresentation)"]},{"slug":"integration-testing","title_ko":"통합 테스트 (Integration Testing)","title_en":"Integration Testing","meaning":"각각 따로 만든 프로그램 부품(모듈)들을 서로 연결했을 때 제대로 함께 동작하는지 확인하는 테스트입니다.","subcategory":"소프트웨어공학","level":3,"related":[],"prerequisites":[],"aliases":["통합 테스트","통합테스트","통합테스트(IntegrationTesting)"]},{"slug":"perceptron","title_ko":"퍼셉트론 (Perceptron)","title_en":"Perceptron","meaning":"여러 입력값에 가중치를 곱해 더한 뒤, 그 결과가 기준을 넘으면 신호를 내보내는 인공신경망의 가장 작은 단위입니다.","subcategory":"인공지능·머신러닝","level":3,"related":["activation-function","backpropagation","gradient-descent","sigmoid-function"],"prerequisites":["activation-function","backpropagation","gradient-descent"],"pop":8,"aliases":["퍼셉트론","퍼셉트론(Perceptron)"]},{"slug":"sigmoid-function","title_ko":"시그모이드 함수 (Sigmoid Function)","title_en":"Sigmoid Function","meaning":"어떤 입력값이든 0과 1 사이의 값으로 부드럽게 눌러 담아주는 S자 모양의 함수입니다.","subcategory":"인공지능·머신러닝","level":3,"related":["activation-function","relu","backpropagation"],"prerequisites":["activation-function","relu"],"aliases":["시그모이드 함수","시그모이드함수","시그모이드함수(SigmoidFunction)"]},{"slug":"raft-algorithm","title_ko":"Raft 합의 알고리즘","title_en":"Raft Consensus Algorithm","meaning":"여러 대의 서버가 하나의 리더를 뽑고, 그 리더를 통해 데이터를 순서대로 복제해서 모두가 같은 상태를 유지하도록 만드는 분산…","subcategory":"데이터베이스·시스템","level":3,"related":[],"prerequisites":[],"aliases":["Raft합의알고리즘"]},{"slug":"mapreduce","title_ko":"맵리듀스","title_en":"MapReduce","meaning":"거대한 데이터를 여러 대의 컴퓨터에 나누어 동시에 처리(Map)한 뒤, 그 결과를 모아서 하나로 정리(Reduce)하는…","subcategory":"데이터베이스·시스템","level":1,"related":["data-pipeline","sharding"],"prerequisites":[]},{"slug":"rate-limiting","title_ko":"레이트 리미팅","title_en":"Rate Limiting","meaning":"한 사용자나 프로그램이 정해진 시간 동안 서버에 보낼 수 있는 요청 횟수를 제한해서, 서버가 과도한 트래픽에 무너지지 않도록…","subcategory":"네트워크·보안","level":3,"related":["api-gateway","distributed-denial-of-service-attack"],"prerequisites":["distributed-denial-of-service-attack"],"aliases":["레이트리미팅"]},{"slug":"webhook","title_ko":"웹훅","title_en":"Webhook","meaning":"특정 사건이 일어났을 때 한 시스템이 미리 등록된 다른 시스템의 주소로 자동으로 알림(HTTP 요청)을 보내주는 방식입니다.","subcategory":"소프트웨어공학","level":3,"related":["rest-api","api-gateway"],"prerequisites":["rest-api"]},{"slug":"dependency-injection","title_ko":"의존성 주입","title_en":"Dependency Injection","meaning":"객체(모듈)가 필요로 하는 다른 객체를 스스로 만들지 않고 외부에서 전달받도록 설계하여, 코드 사이의 결합도를 낮추는…","subcategory":"소프트웨어공학","level":3,"related":[],"prerequisites":[],"aliases":["의존성주입"]},{"slug":"reservoir-computing","title_ko":"저수지 컴퓨팅","title_en":"reservoir computing","meaning":"유닛들을 무작위로 고정 연결한 저수지에 입력을 흘려보내고, 저수지의 활동을 읽어내는 출력층만 학습시키는 순환 신경망 학습…","subcategory":"인공지능·머신러닝","level":1,"related":["neural-network"],"prerequisites":[],"pop":11,"aliases":["저수지컴퓨팅"]},{"slug":"neuron-doctrine","title_ko":"뉴런 독트린","title_en":"neuron doctrine","meaning":"뇌의 계산 단위는 뉴런이며, 뉴런이 정보를 통합해 스파이크를 내보내는 발화율에 정보가 실린다는 계산신경과학의 전통적…","subcategory":"신경세포·전달물질","level":3,"related":["astrocyte","reservoir-computing"],"prerequisites":["astrocyte"],"pop":1,"aliases":["뉴런독트린"]},{"slug":"precision-recall-curve","title_ko":"정밀도-재현율 곡선","title_en":"Precision-Recall Curve","meaning":"분류 임계값을 바꿔가며 정밀도와 재현율이 어떻게 변하는지를 그래프로 나타낸 평가 도구.","subcategory":"인공지능·머신러닝","level":3,"related":["f1-score"],"prerequisites":[],"pop":6,"aliases":["정밀도 재현율 곡선","정밀도-재현율곡선","정밀도재현율 곡선"]},{"slug":"t-sne","title_ko":"t-SNE","title_en":"t-SNE","meaning":"고차원 데이터에서 가까운 점들끼리는 저차원에서도 가깝게, 먼 점들은 멀게 배치하도록 확률적으로 학습하는 비선형 차원 축소 및…","subcategory":"인공지능·머신러닝","level":3,"related":["principal-component-analysis","k-means-clustering"],"prerequisites":[],"aliases":["t SNE","tSNE"]},{"slug":"multi-head-attention","title_ko":"멀티헤드 어텐션","title_en":"Multi-Head Attention","meaning":"어텐션 연산을 여러 개의 독립적인 헤드로 나누어 병렬로 수행한 뒤 그 결과를 합쳐서 다양한 관점의 관계를 동시에 포착하는…","subcategory":"인공지능·머신러닝","level":3,"related":["attention-mechanism"],"prerequisites":["attention-mechanism"],"aliases":["멀티헤드어텐션"]},{"slug":"cache-memory","title_ko":"캐시 메모리","title_en":"Cache Memory","meaning":"프로세서와 주 메모리 사이에 위치해 자주 쓰이는 데이터를 임시로 저장함으로써 접근 속도를 높이는 소용량 고속 메모리.","subcategory":"데이터베이스·시스템","level":2,"related":[],"prerequisites":[],"aliases":["캐시메모리"]},{"slug":"photonic-computing","title_ko":"광컴퓨팅","title_en":"Photonic Computing","meaning":"전자 대신 빛(광자)을 이용해 데이터를 전달하고 연산을 수행하는 컴퓨팅 방식.","subcategory":"데이터베이스·시스템","level":3,"related":[],"prerequisites":[],"aliases":["광컴퓨터","포토닉컴퓨팅"]},{"slug":"distributed-training","title_ko":"분산 학습","title_en":"Distributed Training","meaning":"하나의 딥러닝 모델을 여러 대의 컴퓨터나 여러 개의 가속기에 나누어 동시에 학습시키는 방법.","subcategory":"인공지능·머신러닝","level":2,"related":["data-parallelism"],"prerequisites":[],"aliases":["분산학습"]},{"slug":"data-parallelism","title_ko":"데이터 병렬화","title_en":"Data Parallelism","meaning":"동일한 모델의 복사본을 여러 장치에 두고, 학습 데이터를 나누어 각 장치가 서로 다른 데이터 배치를 동시에 처리하도록 하는…","subcategory":"인공지능·머신러닝","level":2,"related":["distributed-training"],"prerequisites":[],"aliases":["데이터병렬화"]},{"slug":"docker-container","title_ko":"도커 컨테이너","title_en":"Docker Container","meaning":"애플리케이션 코드와 그 실행에 필요한 모든 라이브러리, 설정을 하나로 묶어 어떤 환경에서도 동일하게 실행되도록 하는 경량…","subcategory":"소프트웨어공학","level":1,"related":[],"prerequisites":[],"aliases":["도커컨테이너"]},{"slug":"edge-computing","title_ko":"엣지 컴퓨팅","title_en":"Edge Computing","meaning":"데이터를 중앙 서버나 클라우드로 보내지 않고, 데이터가 생성되는 위치에 가까운 기기 자체에서 계산을 처리하는 컴퓨팅 방식.","subcategory":"데이터베이스·시스템","level":2,"related":[],"prerequisites":[]},{"slug":"finite-automaton","title_ko":"유한 오토마타","title_en":"finite automaton","meaning":"유한한 개수의 상태와 상태 간 전이 규칙만으로 입력 문자열을 받아들이거나 거부하는 가장 단순한 계산 모델.","subcategory":"이론전산학","level":1,"related":["pushdown-automaton"],"prerequisites":[],"aliases":["유한오토마타"]},{"slug":"pushdown-automaton","title_ko":"푸시다운 오토마타","title_en":"pushdown automaton (PDA)","meaning":"유한 오토마타에 스택 하나를 추가하여 임의 깊이의 중첩 구조를 인식할 수 있도록 확장한 계산 모델로, 문맥 자유 언어를…","subcategory":"이론전산학","level":2,"related":["finite-automaton"],"prerequisites":["finite-automaton"],"aliases":["푸시다운오토마타"]},{"slug":"linear-readout","title_ko":"선형 판독층","title_en":"Linear Readout","meaning":"저수지 컴퓨팅에서 저수지의 고차원 활동을 선형회귀나 단순 완전연결층으로 사상해 최종 출력을 만드는, 유일하게 학습되는…","subcategory":"인공지능·머신러닝","level":3,"related":["reservoir-computing"],"prerequisites":["reservoir-computing"],"pop":18,"aliases":["선형판독층"]}]