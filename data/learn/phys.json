[{"slug":"entropy","title_ko":"엔트로피","title_en":"Entropy","meaning":"계의 무질서한 정도를 나타내는 열역학적 척도입니다.","subcategory":"열역학","level":1,"related":["enthalpy","gibbs-free-energy"],"prerequisites":[],"pop":10},{"slug":"gibbs-free-energy","title_ko":"깁스자유에너지","title_en":"Gibbs free energy","meaning":"일정한 온도와 압력에서 어떤 반응이 저절로(자발적으로) 일어날 수 있는지를 판단하는 열역학적 에너지 척도입니다.","subcategory":"열역학","level":1,"related":["entropy","le-chatelier-principle","enthalpy"],"prerequisites":[],"pop":7,"aliases":["깁스 에너지","GFE"]},{"slug":"surface-tension","title_ko":"표면장력","title_en":"Surface Tension","meaning":"액체 표면의 분자들이 서로 끌어당겨 표면적을 최소화하려는 힘입니다.","subcategory":"역학·에너지","level":1,"related":["adsorption"],"prerequisites":[],"pop":5},{"slug":"quantum-tunneling","title_ko":"양자터널링","title_en":"Quantum Tunneling","meaning":"입자가 고전역학적으로는 넘을 수 없는 에너지 장벽을 확률적으로 통과하는 양자역학적 현상입니다.","subcategory":"양자·현대물리","level":1,"related":[],"prerequisites":[],"aliases":["터널효과","양자터널효과"]},{"slug":"diffusion","title_ko":"확산","title_en":"Diffusion","meaning":"물질의 입자가 농도가 높은 곳에서 낮은 곳으로 저절로 퍼져나가는 현상입니다.","subcategory":"열역학","level":3,"related":["buffer-solution","osmotic-pressure"],"prerequisites":[],"aliases":["확산현상"]},{"slug":"enthalpy","title_ko":"엔탈피","title_en":"Enthalpy","meaning":"일정한 압력에서 어떤 계가 가지고 있는 열에너지의 총량을 나타내는 열역학적 상태함수입니다.","subcategory":"열역학","level":1,"related":["gibbs-free-energy","entropy","free-radical"],"prerequisites":[],"pop":12},{"slug":"electromagnetic-induction","title_ko":"전자기유도","title_en":"Electromagnetic Induction","meaning":"자석과 도선(코일) 사이에서 자기장이 변할 때, 그 도선에 저절로 전류가 흐르게 되는 현상입니다.","subcategory":"전자기·파동","level":1,"related":[],"prerequisites":[]},{"slug":"conservation-of-momentum","title_ko":"운동량 보존","title_en":"Conservation of Momentum","meaning":"외부에서 힘이 작용하지 않는 한, 물체들이 서로 충돌하거나 상호작용해도 전체 운동량의 합은 변하지 않고 그대로 보존된다는…","subcategory":"역학·에너지","level":1,"related":[],"prerequisites":[],"aliases":["운동량보존법칙","운동량보존"]},{"slug":"density","title_ko":"밀도","title_en":"Density","meaning":"어떤 물질이 단위 부피(예: 1cm³)당 얼마나 무거운지를 나타내는 값으로, 질량을 부피로 나누어 구합니다.","subcategory":"역학·에너지","level":1,"related":["buoyancy","surface-tension"],"prerequisites":[]},{"slug":"buoyancy","title_ko":"부력","title_en":"Buoyancy","meaning":"물이나 공기 같은 유체 속에 잠긴 물체를 유체가 위쪽으로 밀어 올리는 힘입니다.","subcategory":"역학·에너지","level":1,"related":["density","surface-tension"],"prerequisites":[]},{"slug":"wave-interference-diffraction","title_ko":"파동의 간섭과 회절","title_en":"Wave Interference and Diffraction","meaning":"두 개 이상의 파동이 만나 서로 겹치며 세기가 커지거나 작아지는 현상을 간섭, 파동이 좁은 틈이나 장애물의 가장자리를 지나며…","subcategory":"전자기·파동","level":1,"related":[],"prerequisites":[],"aliases":["파동간섭 회절","파동의간섭과회절"]},{"slug":"transverse-longitudinal-wave","title_ko":"횡파와 종파","title_en":"Transverse and Longitudinal Wave","meaning":"매질의 진동 방향이 파동의 진행 방향과 수직인 횡파(빛, 물결)와 나란한 종파(소리)로 파동을 구분한 것입니다.","subcategory":"전자기·파동","level":2,"related":[],"prerequisites":[],"aliases":["횡파 종파","TLW","횡파와종파"]},{"slug":"capacitor","title_ko":"축전기(콘덴서)","title_en":"Capacitor","meaning":"두 개의 도체판 사이에 전하를 저장했다가 필요할 때 방출하는 전자소자입니다.","subcategory":"전자기·파동","level":1,"related":[],"prerequisites":[],"pop":18,"aliases":["콘덴서","축전기(콘덴서)"]},{"slug":"specific-heat","title_ko":"비열","title_en":"Specific Heat","meaning":"어떤 물질 1g의 온도를 1℃ 높이는 데 필요한 열량으로, 물질마다 고유하게 다른 값을 가집니다.","subcategory":"열역학","level":1,"related":["thermal-conductivity"],"prerequisites":[],"aliases":["비열용량","Specific Heat Capacity"]},{"slug":"simple-machines","title_ko":"지레와 도르래","title_en":"Simple Machines","meaning":"지레와 도르래는 작은 힘을 들여서 무거운 물체를 더 쉽게 들어 올리거나 움직일 수 있게 해주는 간단한 도구입니다.","subcategory":"역학·에너지","level":3,"related":[],"prerequisites":[],"aliases":["지레 도르래","축바퀴","지레와도르래"]},{"slug":"heat-conduction-convection-radiation","title_ko":"열의 이동, 전도·대류·복사","title_en":"Conduction, Convection and Radiation","meaning":"열은 물체와 물체가 직접 맞닿아 전해지는 전도, 액체나 기체가 이동하며 열을 옮기는 대류, 물질을 거치지 않고 빛처럼 직접…","subcategory":"열역학","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["전도 대류 복사","열의 이동, 전도 대류 복사","열의 이동, 전도대류복사","열의이동,전도·대류·복사"]},{"slug":"electromagnetic-wave","title_ko":"전자기파","title_en":"Electromagnetic Wave","meaning":"전기장과 자기장이 서로를 만들어내며 공간(진공 속에서도) 퍼져나가는 파동으로, 우리 눈에 보이는 빛도 그 한 종류입니다.","subcategory":"전자기·파동","level":2,"related":[],"prerequisites":[]},{"slug":"kinetic-and-potential-energy","title_ko":"위치에너지와 운동에너지","title_en":"Kinetic and Potential Energy","meaning":"물체가 높이나 위치 때문에 갖는 에너지를 위치에너지, 움직이고 있어서 갖는 에너지를 운동에너지라고 합니다.","subcategory":"역학·에너지","level":1,"related":[],"prerequisites":[],"pop":9,"aliases":["운동에너지 위치에너지","위치에너지와운동에너지"]},{"slug":"hookes-law","title_ko":"탄성력과 훅의 법칙","title_en":"Hooke's Law","meaning":"용수철처럼 변형된 물체가 원래 모양으로 되돌아가려는 힘을 탄성력이라 하며, 훅의 법칙은 이 힘의 크기가 변형된 길이에…","subcategory":"역학·에너지","level":1,"related":["friction"],"prerequisites":[],"aliases":["훅의 법칙","탄성력","탄성력과훅의법칙"]},{"slug":"evaporation-vs-boiling","title_ko":"증발과 끓음의 차이","title_en":"Evaporation vs Boiling","meaning":"증발은 액체 표면에서 낮은 온도에서도 서서히 기체로 변하는 현상이고, 끓음은 액체 전체에서 끓는점에 도달했을 때 한꺼번에…","subcategory":"열역학","level":1,"related":[],"prerequisites":[],"aliases":["증발","끓음","기화","EVB","증발과끓음의차이"]},{"slug":"vapor-pressure","title_ko":"증기압","title_en":"Vapor Pressure","meaning":"밀폐된 공간에서 액체가 증발해 생긴 기체가 다시 액체로 돌아가는 양과 같아지는 평형 상태에서, 그 기체가 나타내는 압력입니다.","subcategory":"열역학","level":1,"related":["evaporation-vs-boiling"],"prerequisites":[],"aliases":["포화증기압"]},{"slug":"free-fall-motion","title_ko":"자유낙하 운동","title_en":"Free-fall Motion","meaning":"공기 저항을 무시할 때, 정지해 있던 물체가 오직 중력만 받아 아래로 떨어지면서 매초 속력이 일정하게(중력가속도만큼)…","subcategory":"역학·에너지","level":2,"related":[],"prerequisites":[],"aliases":["자유낙하","자유 낙하 운동","자유낙하운동"]},{"slug":"force-equilibrium","title_ko":"힘의 평형","title_en":"force equilibrium","meaning":"물체에 작용하는 여러 힘의 합이 0이 되어, 물체가 정지해 있거나 일정한 속도로 계속 운동하는 상태를 말합니다.","subcategory":"역학·에너지","level":2,"related":["friction","hookes-law","truss"],"prerequisites":["friction","hookes-law"],"aliases":["Equilibrium of Forces"]},{"slug":"specific-gravity","title_ko":"비중","title_en":"Specific Gravity","meaning":"비중은 어떤 물질의 밀도를 기준 물질(보통 4°C의 물)의 밀도로 나눈 값으로, 단위 없이 그 물질이 물보다 무거운지…","subcategory":"역학·에너지","level":3,"related":["density","buoyancy"],"prerequisites":["density","buoyancy"],"pop":14,"aliases":["비중값","Relative Density","SG"]},{"slug":"center-of-gravity","title_ko":"무게중심","title_en":"Center of Gravity","meaning":"무게중심은 물체의 각 부분에 작용하는 중력을 마치 한 점에서 작용하는 것처럼 대신할 수 있는 가상의 점입니다.","subcategory":"역학·에너지","level":3,"related":["force-equilibrium"],"prerequisites":["force-equilibrium"],"pop":15,"aliases":["무게중심점","center of mass","질량중심"]},{"slug":"schon-scandal","title_ko":"얀 헨드릭 쇤 사건","title_en":"Jan Hendrik Schön Scandal","meaning":"벨 연구소의 물리학자 얀 헨드릭 쇤이 2000년대 초 반도체 관련 데이터를 대량으로 조작해 발표 논문이 전원 철회된 사건.","subcategory":"연구윤리 원칙","level":3,"related":["data-fabrication","retraction"],"prerequisites":["data-fabrication"],"pop":2,"aliases":["쇤 사건","벨 연구소 조작 사건","JHSS","얀헨드릭쇤사건"]},{"slug":"interferometer","title_ko":"간섭계","title_en":"Interferometer","meaning":"하나의 빛을 두 갈래로 나누었다가 다시 합칠 때 생기는 간섭무늬를 이용해 아주 미세한 거리나 두께 변화를 측정하는 장비입니다.","subcategory":"실험기기·측정장비","level":1,"related":["spectroscopy","spectrophotometer"],"prerequisites":[]},{"slug":"capillary-action","title_ko":"모세관 현상","title_en":"Capillary Action","meaning":"아주 가는 관이나 좁은 틈에서 외부 힘 없이도 액체가 스스로 올라가거나 내려가는 현상입니다.","subcategory":"역학·에너지","level":3,"related":["surface-tension","vapor-pressure","osmotic-pressure"],"prerequisites":["surface-tension"],"aliases":["모세관현상"]},{"slug":"newtons-law-of-cooling","title_ko":"뉴턴의 냉각법칙","title_en":"Newton's Law of Cooling","meaning":"뜨거운 물체가 식는 속도는 그 물체와 주변 온도의 차이가 클수록 더 빠르다는 법칙입니다.","subcategory":"열역학","level":3,"related":["enthalpy"],"prerequisites":[],"pop":1,"aliases":["뉴턴의냉각법칙"]},{"slug":"hesss-law","title_ko":"헤스의 법칙","title_en":"Hess's Law","meaning":"화학 반응이 한 번에 일어나든 여러 단계를 거쳐 일어나든, 처음 물질과 마지막 물질이 같다면 전체 반응열의 합은 항상 같다는…","subcategory":"열역학","level":2,"related":["enthalpy","entropy"],"prerequisites":["enthalpy","entropy"],"aliases":["헤스의법칙"]},{"slug":"friction","title_ko":"마찰력","title_en":"Friction","meaning":"서로 맞닿은 두 면 사이에서 상대적인 움직임을 방해하는 방향으로 작용하는 힘입니다.","subcategory":"기계·재료","level":2,"related":[],"prerequisites":[],"aliases":["마찰","Friction Force"]},{"slug":"van-der-waals-equation","title_ko":"반데르발스 상태방정식","title_en":"Van der Waals Equation","meaning":"분자 자체의 부피와 분자 사이의 인력을 반영해 이상기체 법칙을 보정한, 실제 기체의 압력·부피·온도 관계식입니다.","subcategory":"열역학","level":3,"related":[],"prerequisites":[],"aliases":["VDWE","반데르발스상태방정식"]},{"slug":"lorentz-force","title_ko":"로렌츠 힘","title_en":"Lorentz Force","meaning":"자기장 속에서 움직이는 전하가 자기장과 운동 방향 모두에 수직인 방향으로 받는 힘입니다.","subcategory":"전자기·파동","level":2,"related":["electromagnetic-induction"],"prerequisites":["electromagnetic-induction"],"pop":11,"aliases":["로렌츠힘"]},{"slug":"heat-capacity","title_ko":"열용량","title_en":"Heat Capacity","meaning":"어떤 물체 전체의 온도를 1도 올리는 데 필요한 열량을 나타내는 양입니다.","subcategory":"열역학","level":3,"related":["specific-heat"],"prerequisites":["specific-heat"]},{"slug":"critical-point","title_ko":"임계점","title_en":"Critical Point","meaning":"온도와 압력을 계속 높였을 때 액체와 기체의 구분이 사라져 하나의 상태로 합쳐지는 지점입니다.","subcategory":"열역학","level":1,"related":["vapor-pressure","chromatography","entropy"],"prerequisites":[],"pop":19},{"slug":"blackbody-radiation","title_ko":"흑체복사","title_en":"Blackbody Radiation","meaning":"모든 파장의 빛을 완전히 흡수하고 방출하는 이상적인 물체(흑체)가 온도에 따라 고유한 분포로 전자기파를 방출하는 현상입니다.","subcategory":"양자·현대물리","level":3,"related":[],"prerequisites":[]},{"slug":"schrodinger-equation","title_ko":"슈뢰딩거 방정식","title_en":"Schrödinger Equation","meaning":"양자역학에서 입자의 파동함수가 시간에 따라 어떻게 변하는지를 기술하는 기본 방정식으로, 이를 풀면 입자가 특정 위치에서…","subcategory":"양자·현대물리","level":1,"related":[],"prerequisites":[],"aliases":["슈뢰딩거방정식"]},{"slug":"pn-junction","title_ko":"p-n 접합","title_en":"p-n Junction","meaning":"p형 반도체와 n형 반도체를 맞붙여서, 그 경계면에 전류를 한쪽 방향으로만 흐르게 하는 얇은 장벽(공핍층)이 만들어지는…","subcategory":"전기전자","level":2,"related":[],"prerequisites":[]},{"slug":"magnetic-flux","title_ko":"자기선속","title_en":"Magnetic Flux","meaning":"자기장이 어떤 면을 얼마나 많이 통과하고 있는지를 나타내는 물리량입니다.","subcategory":"전자기·파동","level":2,"related":["electromagnetic-induction","electric-generator","transformer"],"prerequisites":["electromagnetic-induction"],"pop":13,"aliases":["자속"]},{"slug":"electric-generator","title_ko":"발전기의 원리","title_en":"Electric Generator","meaning":"자기장 속에서 코일을 회전시켜 전자기유도로 전류를 만들어내는 장치의 작동 원리입니다.","subcategory":"전자기·파동","level":2,"related":["electromagnetic-induction","magnetic-flux","transformer"],"prerequisites":["electromagnetic-induction"],"aliases":["발전기의원리"]},{"slug":"grain-boundary","title_ko":"결정립계","title_en":"Grain Boundary","meaning":"금속이나 세라믹 내부에서 원자 배열 방향이 서로 다른 결정립(grain)들이 맞닿아 만나는 경계면입니다.","subcategory":"기계·재료","level":1,"related":["yield-strength"],"prerequisites":[],"aliases":["입계"]},{"slug":"de-broglie-wavelength","title_ko":"드브로이 파장","title_en":"de Broglie Wavelength","meaning":"전자나 원자 같은 모든 물질 입자가 운동량에 반비례하는 고유한 파장을 가지고 파동처럼 행동한다는 개념입니다.","subcategory":"양자·현대물리","level":2,"related":["schrodinger-equation"],"prerequisites":["schrodinger-equation"],"aliases":["DBW","드브로이파장"]},{"slug":"boson-fermion","title_ko":"보손과 페르미온","title_en":"Boson & Fermion","meaning":"모든 입자는 스핀 값에 따라 여러 개가 같은 자리에 모일 수 있는 보손과, 절대 같은 자리에 모일 수 없는 페르미온 두…","subcategory":"양자·현대물리","level":3,"related":["schrodinger-equation"],"prerequisites":["schrodinger-equation"],"aliases":["보손과페르미온"]},{"slug":"centrifugal-force","title_ko":"원심력","title_en":"Centrifugal Force","meaning":"회전하는 물체와 함께 도는 관찰자 입장에서, 물체를 회전 중심 바깥쪽으로 밀어내는 것처럼 느껴지는 가상의 힘입니다.","subcategory":"역학·에너지","level":2,"related":[],"prerequisites":[]},{"slug":"terminal-velocity","title_ko":"종단속도","title_en":"Terminal Velocity","meaning":"낙하하는 물체에 작용하는 중력과 공기(또는 유체) 저항력이 같아져, 더 이상 빨라지지 않고 일정한 속도로 떨어지게 되는…","subcategory":"역학·에너지","level":3,"related":["free-fall-motion","friction"],"prerequisites":["free-fall-motion","friction"],"pop":20,"aliases":["최종속도"]},{"slug":"daltons-law-of-partial-pressures","title_ko":"돌턴의 분압 법칙","title_en":"Dalton's Law of Partial Pressures","meaning":"여러 기체가 섞여 있을 때, 전체 압력은 각 기체가 혼자 그 부피를 차지했을 때 나타내는 압력(분압)들을 모두 더한 값과…","subcategory":"열역학","level":3,"related":["molar-concentration"],"prerequisites":[],"pop":16,"aliases":["DLPP","돌턴의분압법칙"]},{"slug":"escape-velocity","title_ko":"탈출속도","title_en":"Escape Velocity","meaning":"어떤 천체의 중력을 완전히 벗어나 무한히 멀리 날아가는 데 필요한 최소한의 속도입니다.","subcategory":"역학·에너지","level":3,"related":["kinetic-and-potential-energy"],"prerequisites":[]},{"slug":"clausius-clapeyron-equation","title_ko":"클라우지우스-클라페롱 방정식","title_en":"Clausius-Clapeyron Equation","meaning":"온도가 오르면 증기압이 얼마나 가파르게 오르는지를, 그 물질이 상변화할 때 필요한 열량으로 계산해 주는 식입니다.","subcategory":"열역학","level":3,"related":["vapor-pressure","critical-point"],"prerequisites":["vapor-pressure"],"aliases":["클라우지우스 클라페롱 방정식","클라우지우스-클라페롱방정식","클라우지우스클라페롱 방정식"]},{"slug":"vacuum-distillation","title_ko":"진공 증류(감압 증류)","title_en":"Vacuum Distillation","meaning":"증류 장치 내부 압력을 대기압보다 낮춰 액체의 끓는점을 낮춤으로써 열에 약한 물질을 낮은 온도에서 증류·정제하는 방법.","subcategory":"열역학","level":2,"related":[],"prerequisites":[],"aliases":["감압 증류","진공 증류","진공증류","진공증류(감압증류)"]},{"slug":"residual-gas-analyzer","title_ko":"잔류가스분석기","title_en":"Residual Gas Analyzer (RGA)","meaning":"진공 챔버 내부에 남아 있는 미량의 기체 성분을 질량 대 전하비에 따라 실시간으로 분석하는 소형 질량분석기.","subcategory":"양자·현대물리","level":3,"related":[],"prerequisites":[],"aliases":["RGA"]},{"slug":"nd-yag-laser","title_ko":"Nd:YAG 레이저","title_en":"Nd:YAG Laser","meaning":"이트륨-알루미늄-가넷(YAG) 결정에 네오디뮴 이온을 도핑한 이득 매질을 사용하는 고체 레이저로, 기본 파장…","subcategory":"전자기·파동","level":1,"related":["femtosecond-laser"],"prerequisites":[],"pop":17,"aliases":["Nd:YAG레이저"]},{"slug":"femtosecond-laser","title_ko":"펨토초 레이저","title_en":"Femtosecond Laser","meaning":"펄스 지속시간이 펨토초(10의 마이너스 15승 초) 수준으로 극히 짧은 광 펄스를 만들어내는 초고속 레이저로, 매우 빠른…","subcategory":"전자기·파동","level":1,"related":["nd-yag-laser"],"prerequisites":[],"aliases":["펨토초레이저"]},{"slug":"monochromator","title_ko":"단색화장치","title_en":"Monochromator","meaning":"프리즘이나 회절격자를 이용해 광대역 광원 중에서 원하는 매우 좁은 파장 대역만 선택적으로 걸러내는 광학 장비.","subcategory":"전자기·파동","level":2,"related":[],"prerequisites":[],"aliases":["모노크로메이터"]},{"slug":"four-point-probe","title_ko":"4탐침법","title_en":"Four-Point Probe","meaning":"네 개의 탐침을 시료 표면에 일렬로 접촉시켜, 바깥쪽 두 탐침으로 전류를 흘리고 안쪽 두 탐침으로 전압을 측정함으로써 탐침…","subcategory":"전자기·파동","level":2,"related":["quartz-crystal-microbalance"],"prerequisites":[],"aliases":["4점탐침","사탐침법"]},{"slug":"quartz-crystal-microbalance","title_ko":"수정진동자 미소저울","title_en":"Quartz Crystal Microbalance (QCM)","meaning":"수정 결정에 교류 전압을 걸어 일정한 주파수로 진동시키다가 표면에 물질이 아주 얇게 쌓이면 그 질량만큼 공진 주파수가…","subcategory":"역학·에너지","level":3,"related":["chemical-vapor-deposition","four-point-probe"],"prerequisites":[],"aliases":["수정진동자미소저울"]},{"slug":"piezoelectric-actuator","title_ko":"압전 액추에이터","title_en":"Piezoelectric Actuator","meaning":"압전 물질에 전압을 가하면 결정 구조가 미세하게 변형되며 늘어나거나 줄어드는 압전 효과를 이용해 나노미터에서 마이크로미터…","subcategory":"역학·에너지","level":2,"related":[],"prerequisites":[],"aliases":["압전액추에이터"]},{"slug":"bragg-law","title_ko":"브래그 법칙","title_en":"Bragg's Law","meaning":"결정 내 평행한 원자면들에서 산란된 X선이 서로 보강간섭을 일으키는 조건을 nλ = 2d sinθ로 나타낸 결정학의 기본…","subcategory":"전자기·파동","level":3,"related":["x-ray-diffraction","miller-indices"],"prerequisites":[],"pop":8,"aliases":["브래그법칙"]},{"slug":"direct-indirect-bandgap","title_ko":"직접·간접 띠간격","title_en":"Direct vs Indirect Bandgap","meaning":"전자가 가전자대에서 전도대로 전이할 때 운동량 변화 없이 일어나는지(직접) 또는 운동량 변화를 동반하는지(간접)에 따라…","subcategory":"양자·현대물리","level":1,"related":[],"prerequisites":[],"aliases":["DVIB","직접 간접 띠간격","직접·간접띠간격","직접간접 띠간격"]},{"slug":"specific-heat-solid","title_ko":"고체의 비열","title_en":"Specific Heat of Solids","meaning":"고체 물질의 온도를 1도 올리는 데 필요한 단위 질량당 열량으로, 원자의 격자 진동(포논)에 의한 에너지 저장 능력을…","subcategory":"열역학","level":2,"related":[],"prerequisites":[],"aliases":["고체의비열"]},{"slug":"elastic-modulus","title_ko":"탄성계수","title_en":"Elastic Modulus","meaning":"재료가 탄성 변형 영역에서 가해진 응력과 그로 인한 변형(변형률) 사이의 비례 관계를 나타내는 값으로, 재료의…","subcategory":"역학·에너지","level":3,"related":["yield-strength","brittleness"],"prerequisites":["brittleness"],"aliases":["탄성률"]},{"slug":"brittleness","title_ko":"취성","title_en":"Brittleness","meaning":"재료가 뚜렷한 소성 변형 없이 갑작스럽게 파괴되는 성질이다.","subcategory":"역학·에너지","level":2,"related":[],"prerequisites":[],"aliases":["메짐성"]},{"slug":"viscoelasticity","title_ko":"점탄성","title_en":"Viscoelasticity","meaning":"물질이 순수한 탄성체(에너지를 저장하고 완전히 회복)와 순수한 점성 유체(에너지를 소산)의 성질을 동시에 나타내는 역학적…","subcategory":"역학·에너지","level":3,"related":["gelation"],"prerequisites":[],"pop":6,"aliases":["점탄성거동"]},{"slug":"second-law-thermodynamics","title_ko":"열역학 제2법칙","title_en":"Second Law of Thermodynamics","meaning":"고립계에서 엔트로피는 감소하지 않으며, 열은 자발적으로 고온에서 저온으로만 흐른다는 에너지 변환의 방향성을 규정하는 법칙.","subcategory":"화학·에너지공학","level":1,"related":[],"prerequisites":[]},{"slug":"bell-inequality","title_ko":"벨 부등식","title_en":"Bell's Inequality","meaning":"국소적 숨은변수 이론이 성립한다면 만족해야 하는 통계적 부등식으로, 양자역학의 예측과 실험 결과는 이를 위반한다.","subcategory":"양자·현대물리","level":2,"related":[],"prerequisites":[],"aliases":["벨부등식"]},{"slug":"quantum-zeno-effect","title_ko":"양자 제논 효과","title_en":"Quantum Zeno Effect","meaning":"양자계를 매우 자주 측정하면 상태 변화가 억제되어 시스템이 초기 상태에 계속 머무르게 되는 현상.","subcategory":"양자·현대물리","level":2,"related":[],"prerequisites":[],"aliases":["QZE","양자제논효과"]},{"slug":"phonon","title_ko":"포논","title_en":"Phonon","meaning":"결정 격자 속 원자들의 집단적인 진동을 양자화하여 하나의 입자처럼 다루는 준입자.","subcategory":"양자·현대물리","level":1,"related":[],"prerequisites":[]},{"slug":"bose-einstein-condensate","title_ko":"보스-아인슈타인 응축","title_en":"Bose-Einstein Condensate","meaning":"극저온에서 보손 입자들이 거시적인 규모로 동일한 최저 에너지 양자 상태에 모여드는 물질의 새로운 상태.","subcategory":"양자·현대물리","level":2,"related":[],"prerequisites":[],"aliases":["보스 아인슈타인 응축","보스-아인슈타인응축","보스아인슈타인 응축"]},{"slug":"calorimeter-lab","title_ko":"열량계","title_en":"Calorimeter","meaning":"화학반응이나 물리적 현상이 일어날 때 주변으로 흡수되거나 방출되는 열량을 외부와 단열된 용기 안에서 측정하는 실험기구입니다.","subcategory":"실험기기·측정장비","level":1,"related":["hot-plate-stirrer-lab","water-bath"],"prerequisites":[],"aliases":["칼로리미터"]},{"slug":"polarizing-filter-lab","title_ko":"편광판(편광필름)","title_en":"Polarizing Filter","meaning":"특정 방향으로 진동하는 빛만 통과시키고 나머지는 차단하는 필름으로, 빛의 편광 현상을 관찰하고 응용하는 광학 실험기구입니다.","subcategory":"실험기기·측정장비","level":1,"related":[],"prerequisites":[],"aliases":["편광필름"]},{"slug":"solenoid-lab","title_ko":"솔레노이드","title_en":"Solenoid","meaning":"도선을 원통형으로 촘촘히 감아 전류를 흘림으로써 내부에 비교적 균일한 자기장을 만드는 전자기 실험기구입니다.","subcategory":"실험기기·측정장비","level":1,"related":[],"prerequisites":[]},{"slug":"galvanometer-lab","title_ko":"검류계","title_en":"Galvanometer","meaning":"회로에 흐르는 아주 미세한 전류의 유무와 방향을 바늘의 움직임으로 감지하는 전기계측기구입니다.","subcategory":"실험기기·측정장비","level":1,"related":["capacitor","dc-power-supply"],"prerequisites":[],"pop":3,"aliases":["갈바노미터"]},{"slug":"ticker-timer-lab","title_ko":"시간기록계","title_en":"Ticker Timer","meaning":"종이테이프에 일정한 시간 간격마다 타점을 찍어 물체의 위치와 속도 변화를 기록하는 역학 실험기구입니다.","subcategory":"실험기기·측정장비","level":1,"related":[],"prerequisites":[]}]