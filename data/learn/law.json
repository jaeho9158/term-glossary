[{"slug":"property-rights","title_ko":"재산권","title_en":"Property Rights","meaning":"어떤 자원이나 자산을 소유한 사람이 그것을 마음대로 쓰고, 그로부터 이익을 얻고, 남에게 팔거나 넘길 수 있도록 법으로…","subcategory":"미시경제","level":2,"related":["tragedy-of-the-commons","market-economy","transaction-cost","rent-seeking"],"prerequisites":["tragedy-of-the-commons"],"aliases":["Property Right"]},{"slug":"social-fundamental-rights","title_ko":"사회적 기본권","title_en":"Social Fundamental Rights","meaning":"국민이 인간다운 생활을 영위하기 위해 국가에 적극적인 급부나 배려를 요구할 수 있는 기본권으로, 교육권·근로권·사회보장수급권…","subcategory":"헌법·행정법·형법 개념","level":3,"related":[],"prerequisites":[],"aliases":["사회적기본권"]},{"slug":"dissolution-of-political-parties","title_ko":"정당해산심판","title_en":"Adjudication on Dissolution of Political Parties","meaning":"정당의 목적이나 활동이 민주적 기본질서에 위배될 때 정부의 제소에 따라 헌법재판소가 그 정당의 해산 여부를 결정하는 심판이다.","subcategory":"헌법·행정법·형법 개념","level":3,"related":[],"prerequisites":[],"aliases":["ADPP"]},{"slug":"prohibition-of-comprehensive-delegation","title_ko":"포괄위임금지원칙","title_en":"Prohibition of Comprehensive Delegation","meaning":"법률이 대통령령 등 하위법령에 입법사항을 위임할 때에는 위임의 목적·내용·범위를 구체적으로 정해야 하며, 포괄적·백지적으로…","subcategory":"헌법·행정법·형법 개념","level":1,"related":[],"prerequisites":[],"pop":5,"aliases":["포괄위임금지"]},{"slug":"double-jeopardy-prohibition","title_ko":"이중처벌금지원칙","title_en":"Prohibition of Double Jeopardy","meaning":"동일한 범죄행위에 대하여 국가가 형사절차상 거듭 처벌할 수 없다는 헌법상 원칙이다.","subcategory":"헌법·행정법·형법 개념","level":1,"related":[],"prerequisites":[],"pop":4,"aliases":["PDJ"]},{"slug":"reflective-interest","title_ko":"반사적 이익","title_en":"Reflective Interest","meaning":"법이 공익을 보호하기 위해 행정청에게 일정한 의무를 부과한 결과 개인이 사실상 누리게 되는 이익으로, 법률상 보호되는 이익이…","subcategory":"헌법·행정법·형법 개념","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["반사적이익"]},{"slug":"juridical-act","title_ko":"법률행위","title_en":"Juridical Act","meaning":"당사자가 원하는 법률효과를 발생시키려는 의사표시를 요소로 하여 이루어지는 사법상의 행위로, 계약·단독행위·합동행위를 포괄하는…","subcategory":"민법·상법·국제법 개념","level":1,"related":["declaration-of-intention","private-autonomy"],"prerequisites":[],"pop":2},{"slug":"declaration-of-intention","title_ko":"의사표시","title_en":"Declaration of Intention","meaning":"일정한 법률효과의 발생을 원하는 내심의 의사를 외부에 표시하는 행위로, 법률행위를 구성하는 가장 핵심적인 요소입니다.","subcategory":"민법·상법·국제법 개념","level":1,"related":["juridical-act","private-autonomy"],"prerequisites":[],"pop":15},{"slug":"private-autonomy","title_ko":"사적자치의 원칙","title_en":"Principle of Private Autonomy","meaning":"개인이 자신의 법률관계를 자기의 자유로운 의사에 따라 스스로 형성할 수 있다는 근대 사법의 기본원리로, 계약자유·소유권 자유…","subcategory":"민법·상법·국제법 개념","level":1,"related":["juridical-act"],"prerequisites":[],"pop":3,"aliases":["사적자치의원칙"]},{"slug":"pledge","title_ko":"질권","title_en":"Pledge","meaning":"채권자가 채권의 담보로 채무자 또는 제3자로부터 인도받은 동산이나 재산권을 유치하고, 채무 불이행 시 그 목적물로부터…","subcategory":"민법·상법·국제법 개념","level":1,"related":[],"prerequisites":[],"pop":7},{"slug":"creditors-revocation-right","title_ko":"채권자취소권","title_en":"Creditor's Right of Revocation (Actio Pauliana)","meaning":"채무자가 채권자를 해함을 알면서 재산을 감소시키는 법률행위(사해행위)를 한 경우, 채권자가 그 행위를 취소하고 재산을…","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"aliases":["Actio Pauliana"]},{"slug":"management-of-affairs-without-mandate","title_ko":"사무관리","title_en":"Management of Affairs without Mandate (Negotiorum Gestio)","meaning":"법률상 또는 계약상 의무 없이 타인을 위하여 그의 사무를 관리함으로써 발생하는 법정채권관계입니다.","subcategory":"민법·상법·국제법 개념","level":3,"related":["juridical-act"],"prerequisites":[],"aliases":["MAWM","Negotiorum Gestio"]},{"slug":"juridical-personality","title_ko":"법인격","title_en":"Juridical Personality","meaning":"자연인이 아닌 단체나 재산의 집합에 대하여 법률이 권리와 의무의 주체가 될 수 있는 지위를 부여하는 것을 말합니다.","subcategory":"민법·상법·국제법 개념","level":1,"related":["juridical-act"],"prerequisites":[]},{"slug":"sovereign-immunity","title_ko":"주권면제","title_en":"Sovereign Immunity","meaning":"국가의 주권적 지위에서 비롯되어 외국 법원의 재판권과 강제집행으로부터 국가 및 그 재산이 면제되는 원칙으로, 재판권 면제와…","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"pop":6,"aliases":["국가면제","State Immunity"]},{"slug":"geneva-conventions","title_ko":"제네바협약","title_en":"Geneva Conventions","meaning":"전쟁 희생자 보호를 목적으로 하는 4개의 국제협약으로, 부상병, 포로, 민간인 보호에 관한 국제인도법의 핵심 규범을 이룹니다.","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"aliases":["제네바조약"]},{"slug":"countermeasures","title_ko":"대응조치","title_en":"Countermeasures","meaning":"국제위법행위의 피해국이 가해국으로 하여금 위법행위를 중단하고 배상하도록 압박하기 위하여, 본래 위법하지만 대응조치로서…","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"pop":8}]