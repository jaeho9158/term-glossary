[{"slug":"brain-drain","title_ko":"두뇌 유출","title_en":"Brain Drain","meaning":"고학력·고숙련 인재가 더 나은 임금이나 연구 환경을 찾아 자국을 떠나 다른 나라로 이주함으로써 본국의 인적자본이 유출되는…","subcategory":"거시경제","level":2,"related":["human-capital","urbanization"],"prerequisites":[],"aliases":["두뇌유출","브레인 드레인","브레인드레인"]},{"slug":"broken-windows-theory","title_ko":"깨진 유리창 이론","title_en":"Broken Windows Theory","meaning":"사소한 무질서나 훼손을 방치하면 더 큰 범죄로 이어질 수 있다고 설명하는 범죄학 이론이다.","subcategory":"사회학·사회구조","level":1,"related":["anomie","relative-deprivation-household","urbanization"],"prerequisites":[],"aliases":["깨진유리창이론","Broken Window Theory","깨진유리창이론 (Broken Windows Theory","Policing)","깨진유리창이론(BrokenWindowsTheory","Broken Windows Theory (Policing)"]},{"slug":"differential-association-theory","title_ko":"차별접촉이론","title_en":"Differential Association Theory","meaning":"범죄와 일탈 행동은 타고나는 것이 아니라 그것을 긍정적으로 여기는 사람들과의 친밀한 상호작용을 통해 학습된다는 이론이다.","subcategory":"사회학·사회구조","level":1,"related":["labeling-theory","anomie","socialization","conflict-theory"],"prerequisites":[]},{"slug":"cohort-effect","title_ko":"코호트효과","title_en":"Cohort Effect","meaning":"동일한 시기(주로 같은 해)에 출생하거나 특정 사건을 공유한 집단(코호트)이, 그들이 공유한 시대적 경험으로 인해 다른…","subcategory":"인구구조·인구변동 이론","level":1,"related":[],"prerequisites":[]},{"slug":"out-migration","title_ko":"이출","title_en":"Out-migration (Emigration)","meaning":"특정 지역이나 국가에서 다른 지역·국가로 거주지를 옮겨 나가는 인구이동으로, 국내 이동에서는 '이출', 국제 이동에서는…","subcategory":"인구구조·인구변동 이론","level":2,"related":[],"prerequisites":[],"aliases":["전출"]},{"slug":"crude-marriage-rate","title_ko":"조혼인율","title_en":"Crude Marriage Rate","meaning":"특정 기간(보통 1년) 동안의 총 혼인 건수를 해당 기간의 연앙인구로 나누고 1,000을 곱하여 산출하는, 인구…","subcategory":"인구구조·인구변동 이론","level":1,"related":["crude-divorce-rate"],"prerequisites":[],"pop":7},{"slug":"crude-divorce-rate","title_ko":"조이혼율","title_en":"Crude Divorce Rate","meaning":"특정 기간 동안의 총 이혼 건수를 해당 기간의 연앙인구로 나누고 1,000을 곱하여 산출하는, 인구 1,000명당 이혼…","subcategory":"인구구조·인구변동 이론","level":2,"related":["crude-marriage-rate"],"prerequisite