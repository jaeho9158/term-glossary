[{"slug":"lactate-threshold","title_ko":"젖산역치","title_en":"Lactate Threshold","meaning":"운동강도가 증가함에 따라 혈중 젖산농도가 안정 수준에서 급격히 상승하기 시작하는 지점을 말한다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":["anaerobic-threshold"],"prerequisites":[],"pop":8,"aliases":["LT","젖산임계치"]},{"slug":"anaerobic-threshold","title_ko":"무산소성역치","title_en":"Anaerobic Threshold","meaning":"에너지 대사가 유산소성에서 무산소성 대사로 급격히 전환되는 운동강도 지점으로, 혈중 젖산 축적과 환기량 급증이 동반된다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":["lactate-threshold"],"prerequisites":[],"aliases":["AT","무산소역치"]},{"slug":"heart-rate-reserve","title_ko":"심박수예비량","title_en":"Heart Rate Reserve","meaning":"최대심박수에서 안정시심박수를 뺀 값으로, 운동강도 처방 시 목표심박수 산출에 활용되는 지표이다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":[],"prerequisites":[],"pop":18,"aliases":["여유심박수"]},{"slug":"progressive-overload","title_ko":"점진적과부하","title_en":"Progressive Overload","meaning":"신체 적응이 일어남에 따라 훈련 부하(강도, 양, 빈도 등)를 점진적으로 증가시켜 지속적인 체력 향상을 유도하는 훈련…","subcategory":"운동생리학·트레이닝이론","level":3,"related":["overload-principle","one-repetition-maximum"],"prerequisites":["overload-principle"],"aliases":["점진적과부하원리"]},{"slug":"overload-principle","title_ko":"과부하원리","title_en":"Overload Principle","meaning":"신체 기능을 향상시키려면 평소 일상 수준보다 높은 자극(부하)을 지속적으로 가해야 한다는 트레이닝의 기본 원리이다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":["progressive-overload","specificity-principle","reversibility-principle"],"prerequisites":[],"pop":10},{"slug":"specificity-principle","title_ko":"특이성원리","title_en":"Principle of Specificity","meaning":"훈련 효과는 실시한 운동의 형태, 강도, 에너지시스템, 사용 근육군과 밀접하게 관련되어 나타난다는 원리(SAID 원리)이다.","subcategory":"운동생리학·트레이닝이론","level":3,"related":["overload-principle"],"prerequisites":["overload-principle"],"aliases":["SAID원리","특수성원리"]},{"slug":"rate-of-perceived-exertion","title_ko":"운동자각도(RPE)","title_en":"Rating of Perceived Exertion (RPE)","meaning":"운동 중 신체가 느끼는 힘든 정도를 주관적으로 평가하는 척도로, 보그(Borg) 척도(6~20 또는 0~10)가 대표적으로…","subcategory":"운동생리학·트레이닝이론","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["운동자각도"]},{"slug":"motor-unit","title_ko":"운동단위","title_en":"Motor Unit","meaning":"하나의 운동신경원과 이 신경원이 지배하는 모든 근섬유를 합쳐 부르는 근수축의 기능적 최소 단위이다.","subcategory":"운동생리학·트레이닝이론","level":2,"related":[],"prerequisites":[]},{"slug":"anaerobic-metabolism","title_ko":"무산소대사","title_en":"Anaerobic Metabolism","meaning":"산소를 사용하지 않고 ATP를 생성하는 에너지 대사 과정으로, ATP-PC시스템과 해당과정(무산소성)이 이에 해당하며 짧고…","subcategory":"운동생리학·트레이닝이론","level":1,"related":["atp-pc-system"],"prerequisites":[],"pop":12,"aliases":["무산소성대사"]},{"slug":"atp-pc-system","title_ko":"ATP-PC시스템","title_en":"ATP-PC (Phosphagen) System","meaning":"저장된 ATP와 크레아틴인산(PC)을 이용해 매우 빠르게 에너지를 공급하는 무산소성 에너지 시스템으로, 10초 이내의…","subcategory":"운동생리학·트레이닝이론","level":1,"related":["phosphocreatine","anaerobic-metabolism"],"prerequisites":[],"pop":1,"aliases":["ATP PC시스템","ATPPC시스템","Phosphagen"]},{"slug":"steady-state","title_ko":"항정상태","title_en":"Steady State","meaning":"일정한 운동강도에서 산소섭취량, 심박수 등 생리적 변수가 더 이상 크게 변하지 않고 안정적으로 유지되는 상태를 말한다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":["anaerobic-threshold"],"prerequisites":[],"pop":15,"aliases":["스테디스테이트","정상상태"]},{"slug":"muscle-hypertrophy","title_ko":"근비대","title_en":"Muscle Hypertrophy","meaning":"저항운동 등의 자극에 의해 근섬유의 단면적이 증가하여 근육의 크기가 커지는 현상을 말한다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":[],"prerequisites":[],"aliases":["근육비대"]},{"slug":"one-repetition-maximum","title_ko":"1RM(최대반복중량)","title_en":"One-Repetition Maximum","meaning":"정확한 자세로 단 한 번만 들어 올릴 수 있는 최대 중량으로, 근력 평가 및 훈련강도 설정의 기준으로 사용된다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":[],"prerequisites":[],"aliases":["1RM","최대반복중량"]},{"slug":"fartlek-training","title_ko":"파틀렉훈련","title_en":"Fartlek Training","meaning":"정해진 구조 없이 지형이나 임의의 판단에 따라 속도와 강도를 자유롭게 변화시키며 달리는 훈련 방법으로, 스웨덴어로 '스피드…","subcategory":"운동생리학·트레이닝이론","level":3,"related":["rate-of-perceived-exertion"],"prerequisites":[],"pop":6,"aliases":["파틀렉"]},{"slug":"plyometric-training","title_ko":"플라이오메트릭훈련","title_en":"Plyometric Training","meaning":"근육의 신장성 수축 직후 즉각적인 단축성 수축을 이용하는 신장단축주기를 활용해 폭발적인 근파워를 향상시키는 훈련 방법이다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":["stretch-shortening-cycle"],"prerequisites":[],"pop":20,"aliases":["플라이오메트릭"]},{"slug":"reversibility-principle","title_ko":"가역성원리","title_en":"Reversibility Principle","meaning":"훈련을 통해 얻은 체력 향상 효과는 훈련을 중단하면 시간이 지남에 따라 점차 소실된다는 원리이다.","subcategory":"운동생리학·트레이닝이론","level":2,"related":["overload-principle"],"prerequisites":["overload-principle"],"pop":9},{"slug":"dynamic-stretching","title_ko":"동적스트레칭","title_en":"Dynamic Stretching","meaning":"관절가동범위 내에서 신체 부위를 반복적으로 움직이며 실시하는 스트레칭 방법으로, 운동 전 준비운동으로 흔히 활용된다.","subcategory":"운동생리학·트레이닝이론","level":2,"related":[],"prerequisites":[]},{"slug":"minute-ventilation","title_ko":"분당환기량","title_en":"Minute Ventilation","meaning":"1분 동안 폐를 통해 들고 나는 공기의 총량으로, 호흡수와 1회 호흡량의 곱으로 산출된다.","subcategory":"운동생리학·트레이닝이론","level":2,"related":[],"prerequisites":[],"pop":13},{"slug":"concentric-contraction","title_ko":"동심성수축","title_en":"Concentric Contraction","meaning":"근육이 짧아지면서 장력을 발생시키는 수축 형태로, 관절을 움직여 저항을 극복하는 국면(예: 스쿼트 시 일어서는 동작)에…","subcategory":"운동생리학·트레이닝이론","level":3,"related":["eccentric-contraction","stretch-shortening-cycle"],"prerequisites":["eccentric-contraction","stretch-shortening-cycle"],"aliases":["구심성수축","단축성수축"]},{"slug":"eccentric-contraction","title_ko":"편심성수축","title_en":"Eccentric Contraction","meaning":"근육이 저항에 의해 길어지면서도 장력을 발생시키는 수축 형태로, 동작을 제어하며 감속하는 국면(예: 스쿼트 시 앉는 동작)에…","subcategory":"운동생리학·트레이닝이론","level":1,"related":["concentric-contraction","stretch-shortening-cycle"],"prerequisites":[],"aliases":["신장성수축","원심성수축"]},{"slug":"stretch-shortening-cycle","title_ko":"신장단축주기","title_en":"Stretch-Shortening Cycle","meaning":"근육이 편심성으로 신장된 직후 곧바로 동심성으로 단축되는 연속 동작 패턴으로, 탄성에너지 이용과 신장반사를 통해 더 큰 힘을…","subcategory":"운동생리학·트레이닝이론","level":1,"related":["plyometric-training","muscle-spindle","eccentric-contraction"],"prerequisites":[],"pop":17},{"slug":"rate-of-force-development","title_ko":"근력발현속도","title_en":"Rate of Force Development","meaning":"근육이 힘을 얼마나 빠르게 발휘할 수 있는지를 나타내는 지표로, 시간에 따른 힘 발휘 곡선의 기울기로 산출된다.","subcategory":"운동생리학·트레이닝이론","level":1,"related":[],"prerequisites":[],"aliases":["RFD"]},{"slug":"lean-body-mass","title_ko":"제지방량","title_en":"Lean Body Mass","meaning":"전체 체중에서 체지방을 제외한 근육, 뼈, 장기, 수분 등의 질량을 의미한다.","subcategory":"운동생리학·트레이닝이론","level":2,"related":["muscle-hypertrophy","basal-metabolic-rate"],"prerequisites":["muscle-hypertrophy"],"pop":2,"aliases":["LBM","제지방체중"]},{"slug":"phosphocreatine","title_ko":"크레아틴인산","title_en":"Phosphocreatine","meaning":"근육 내에 저장되어 있는 고에너지 인산화합물로, ADP에 인산기를 즉각 제공하여 ATP를 신속히 재합성하는 데 사용된다.","subcategory":"운동생리학·트레이닝이론","level":3,"related":["atp-pc-system","anaerobic-metabolism"],"prerequisites":["atp-pc-system","anaerobic-metabolism"],"aliases":["인산크레아틴","포스포크레아틴"]},{"slug":"fitt-principle","title_ko":"FITT원리","title_en":"FITT Principle","meaning":"운동처방의 기본 구성요소인 빈도(Frequency), 강도(Intensity), 시간(Time), 형태(Type)를 조합하여…","subcategory":"운동생리학·트레이닝이론","level":3,"related":[],"prerequisites":[],"pop":4,"aliases":["FITT","FITT-VP"]},{"slug":"blood-doping","title_ko":"혈액도핑","title_en":"Blood Doping","meaning":"자가 또는 타인의 적혈구를 수혈하거나 에리스로포이에틴 등을 투여해 혈중 산소운반능력을 인위적으로 높이는 금지된 경기력 향상…","subcategory":"운동생리학·트레이닝이론","level":3,"related":["vo2max"],"prerequisites":["vo2max"]},{"slug":"coordination","title_ko":"협응력","title_en":"Coordination","meaning":"여러 신체 부위나 근육군을 시간적·공간적으로 조화롭게 움직여 원활하고 효율적인 동작을 만들어내는 능력이다.","subcategory":"운동생리학·트레이닝이론","level":2,"related":[],"prerequisites":[],"aliases":["조정력","협응성"]},{"slug":"cross-education","title_ko":"교차교육효과","title_en":"Cross-Education Effect","meaning":"한쪽 사지에 대한 저항운동 훈련이 훈련하지 않은 반대쪽 사지의 근력 증가로도 일부 전이되어 나타나는 신경생리학적 현상이다.","subcategory":"운동생리학·트레이닝이론","level":3,"related":[],"prerequisites":[],"aliases":["교차전이"]},{"slug":"imagery-training","title_ko":"심상훈련","title_en":"Mental Imagery Training","meaning":"실제 신체 동작 없이 마음속으로 운동 수행 장면을 반복적으로 그려봄으로써 기술 습득, 자신감 향상, 불안 조절 등을 도모하는…","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":["observational-learning"],"prerequisites":[],"pop":14,"aliases":["이미지트레이닝","정신연습"]},{"slug":"intrinsic-motivation","title_ko":"내재적 동기","title_en":"Intrinsic Motivation","meaning":"외적 보상이나 압력 없이 활동 자체에 대한 흥미와 즐거움에서 비롯되는 동기로, 자기결정성이론의 핵심 구성개념이다.","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":["self-determination-theory","competence-need"],"prerequisites":[],"aliases":["내재적동기"]},{"slug":"state-anxiety","title_ko":"상태불안","title_en":"State Anxiety","meaning":"특정 상황에서 일시적으로 경험하는 불안으로, 자율신경계 각성을 동반하며 시간과 상황에 따라 변동하는 정서 상태이다.","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":[],"prerequisites":[]},{"slug":"knowledge-of-performance","title_ko":"수행지식","title_en":"Knowledge of Performance (KP)","meaning":"운동 수행의 결과가 아니라 동작의 형태, 패턴, 협응 방식에 대해 제공되는 정보이다.","subcategory":"스포츠심리학·바이오메카닉스","level":1,"related":[],"prerequisites":[]},{"slug":"open-loop-theory","title_ko":"개방회로이론","title_en":"Open-loop Theory","meaning":"운동 프로그램이 실행 전에 미리 계획되어 피드백 없이도 일련의 동작이 순차적으로 실행된다고 설명하는 운동제어 이론이다.","subcategory":"스포츠심리학·바이오메카닉스","level":3,"related":["schema-theory"],"prerequisites":[]},{"slug":"competence-need","title_ko":"유능감","title_en":"Need for Competence","meaning":"자기결정성이론의 기본 심리 욕구 중 하나로, 자신의 능력을 효과적으로 발휘하고 환경에 숙달되어 있다는 느낌에 대한 욕구이다.","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":["self-determination-theory","intrinsic-motivation"],"prerequisites":[]},{"slug":"range-of-motion","title_ko":"관절가동범위","title_en":"Range of Motion (ROM)","meaning":"관절이 해부학적 구조상 움직일 수 있는 최대 각도 범위로, 능동적 가동범위와 수동적 가동범위로 구분된다.","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":["joint-moment","sport-injury-mechanism","proprioception"],"prerequisites":["joint-moment","sport-injury-mechanism"],"pop":3,"aliases":["ROM","가동범위"]},{"slug":"sport-injury-mechanism","title_ko":"스포츠상해기전","title_en":"Sport Injury Mechanism","meaning":"스포츠 활동 중 조직 손상이 발생하는 물리적·생체역학적 과정으로, 접촉성과 비접촉성 기전, 급성과 만성(과사용) 손상으로…","subcategory":"스포츠심리학·바이오메카닉스","level":1,"related":[],"prerequisites":[]},{"slug":"gait-analysis","title_ko":"보행분석","title_en":"Gait Analysis","meaning":"걷기나 달리기 동작의 시공간적, 운동학적, 운동역학적 특성을 체계적으로 측정하고 평가하는 기법이다.","subcategory":"스포츠심리학·바이오메카닉스","level":1,"related":["swing-phase"],"prerequisites":[]},{"slug":"swing-phase","title_ko":"유각기","title_en":"Swing Phase","meaning":"보행주기 중 발이 지면에서 떨어져 앞으로 나아가는 구간으로, 전체 보행주기의 약 40%를 차지한다(걷기 기준).","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":[],"prerequisites":[],"pop":16,"aliases":["흔듦기"]},{"slug":"joint-moment","title_ko":"관절모멘트","title_en":"Joint Moment","meaning":"관절을 가로지르는 근육, 인대 등의 조직이 발휘하는 합성 회전력으로, 역동역학 계산을 통해 산출되는 순 토크이다.","subcategory":"스포츠심리학·바이오메카닉스","level":1,"related":[],"prerequisites":[]},{"slug":"agonist-muscle","title_ko":"주동근","title_en":"Agonist Muscle","meaning":"특정 관절 동작을 수행하기 위해 주된 힘을 발휘하는 근육이다.","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":["antagonist-muscle","synergist-muscle"],"prerequisites":[],"pop":19,"aliases":["작용근"]},{"slug":"antagonist-muscle","title_ko":"길항근","title_en":"Antagonist Muscle","meaning":"주동근과 반대 방향의 작용을 하며 관절 동작을 제어하고 안정화하는 역할을 하는 근육이다.","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":["agonist-muscle","synergist-muscle","joint-moment","neuromuscular-control"],"prerequisites":["joint-moment","neuromuscular-control"],"aliases":["대항근"]},{"slug":"synergist-muscle","title_ko":"협력근","title_en":"Synergist Muscle","meaning":"주동근의 작용을 보조하거나 원치 않는 부수적 움직임을 상쇄하여 의도한 동작이 정확히 이루어지도록 돕는 근육이다.","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":["agonist-muscle","antagonist-muscle","neuromuscular-control"],"prerequisites":["neuromuscular-control"],"aliases":["협동근"]},{"slug":"magnus-effect","title_ko":"마그누스효과","title_en":"Magnus Effect","meaning":"회전하는 물체가 유체 속을 이동할 때 회전으로 인한 압력 차이로 인해 궤적이 휘어지는 현상이다.","subcategory":"스포츠심리학·바이오메카닉스","level":2,"related":[],"prerequisites":[],"pop":5},{"slug":"neuromuscular-control","title_ko":"신경근조절","title_en":"Neuromuscular Control","meaning":"중추신경계가 근육의 활성화 타이밍과 크기를 조절하여 관절의 안정성과 원하는 움직임을 만들어내는 과정이다.","subcategory":"스포츠심리학·바이오메카닉스","level":1,"related":["proprioception","sport-injury-mechanism"],"prerequisites":[],"pop":11,"aliases":["신경근제어"]},{"slug":"energy-availability","title_ko":"에너지가용성","title_en":"energy availability","meaning":"총 에너지 섭취량에서 운동으로 소모한 에너지를 뺀 뒤 제지방량으로 나눈 값으로, 신체 기능에 실제로 쓰일 수 있는 에너지의…","subcategory":"스포츠생리학 응용·스포츠영양학","level":1,"related":[],"prerequisites":[],"aliases":["EA"]},{"slug":"ergogenic-aid","title_ko":"에르고제닉보조제","title_en":"Ergogenic Aid","meaning":"훈련이나 영양 상태와 별개로 운동수행능력을 직접적으로 향상시키기 위해 사용되는 물질, 도구, 방법을 통틀어 이르는 말입니다.","subcategory":"스포츠생리학 응용·스포츠영양학","level":1,"related":[],"prerequisites":[],"aliases":["경기력향상보조제","에르고제닉에이드"]},{"slug":"muscle-buffering-capacity","title_ko":"근육완충능력","title_en":"muscle buffering capacity","meaning":"고강도 운동으로 근육 내에 축적되는 수소이온의 산성화 작용을 중화시켜 pH 변화를 완만하게 유지하는 근육의 능력입니다.","subcategory":"스포츠생리학 응용·스포츠영양학","level":1,"related":[],"prerequisites":[]},{"slug":"atp-pc-system-recovery","title_ko":"ATP-PC시스템회복","title_en":"ATP-PC system recovery","meaning":"고강도 운동 후 소모된 근육 내 크레아틴인산과 ATP 저장량이 휴식을 통해 다시 채워지는 회복 과정입니다.","subcategory":"스포츠생리학 응용·스포츠영양학","level":3,"related":["muscle-buffering-capacity"],"prerequisites":["muscle-buffering-capacity"],"aliases":["APSR","ATP PC시스템회복","ATPPC시스템회복"]},{"slug":"sodium-bicarbonate-loading","title_ko":"중탄산나트륨로딩","title_en":"sodium bicarbonate loading","meaning":"혈액의 완충 능력을 높이기 위해 경기 전 중탄산나트륨을 섭취하여 고강도 운동 중 근육 산성화를 지연시키려는 보충 전략입니다.","subcategory":"스포츠생리학 응용·스포츠영양학","level":3,"related":["muscle-buffering-capacity","ergogenic-aid"],"prerequisites":["muscle-buffering-capacity"],"aliases":["베이킹소다로딩","중탄산염로딩"]},{"slug":"vo2max","title_ko":"최대산소섭취량","title_en":"VO2max","meaning":"운동 강도를 최대로 높였을 때 몸이 단위 시간당 사용할 수 있는 최대 산소량으로, 심폐지구력의 대표적인 지표입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["lactate-threshold"],"prerequisites":[],"aliases":["MOU","Maximal Oxygen Uptake (VO2max)"]},{"slug":"train-low-compete-high","title_ko":"저탄수화물 훈련-고탄수화물 경기전략","title_en":"Train Low, Compete High Strategy","meaning":"평소 훈련은 탄수화물이 부족한 상태에서 수행하여 대사 적응을 유도하고, 실제 경기에서는 탄수화물을 충분히 섭취해 수행능력을…","subcategory":"스포츠영양","level":2,"related":["energy-availability"],"prerequisites":[],"aliases":["저탄수화물 훈련 고탄수화물 경기전략","저탄수화물 훈련고탄수화물 경기전략","저탄수화물훈련-고탄수화물경기전략","트레인로우"]}]