[{"slug":"peer-review","title_ko":"동료심사","title_en":"Peer Review","meaning":"같은 분야 전문가들이 논문의 질과 타당성을 검토하는 출판 전 절차.","subcategory":"출판·저작권","level":1,"related":["literature-review","confirmation-bias"],"prerequisites":[],"aliases":["동료평가","Peer Review in Archaeology"]},{"slug":"habitus","title_ko":"아비투스","title_en":"Habitus","meaning":"어린 시절부터 자라온 계급적·문화적 환경을 통해 몸에 배어, 무의식적으로 드러나는 취향·말투·행동 방식의 체계이다.","subcategory":"인류학·문화","level":2,"related":["social-capital","hegemony"],"prerequisites":[],"pop":1,"aliases":["아비투스 개념"]},{"slug":"hindsight-bias","title_ko":"사후확신편향","title_en":"Hindsight Bias","meaning":"어떤 일이 일어난 후에 처음부터 그럴 줄 알았다고 실제보다 더 확신하게 되는 경향이다.","subcategory":"인지심리","level":1,"related":["confirmation-bias","cognitive-bias","availability-heuristic","illusory-correlation","contingency"],"prerequisites":[]},{"slug":"iconography","title_ko":"도상학","title_en":"Iconography","meaning":"미술 작품에 등장하는 인물, 상징, 소재의 전통적 의미와 유래를 식별하고 분류하는 미술사 연구 방법으로, 파노프스키의 삼단계…","subcategory":"미술사조·도상학","level":1,"related":["panofsky-method","iconographic-analysis"],"prerequisites":[],"pop":5,"aliases":["이코노그래피","아이코노그래피"]},{"slug":"sahyo-haeseok","title_ko":"사료해석","title_en":"Source Interpretation","meaning":"비판을 거친 사료의 의미를 맥락 속에서 읽어내어 역사적 사실과 의미를 도출하는 작업.","subcategory":"역사학 방법론·사학사","level":1,"related":[],"prerequisites":[]},{"slug":"gubi-sahyo","title_ko":"구비사료","title_en":"Oral Source","meaning":"문자 기록이 아닌 구전으로 전승되어 온 설화, 노래, 증언 등의 사료.","subcategory":"역사학 방법론·사학사","level":2,"related":[],"prerequisites":[],"aliases":["구술사료"]},{"slug":"marx-yeoksahak","title_ko":"마르크스주의 역사학","title_en":"Marxist Historiography","meaning":"생산양식과 계급투쟁을 역사 변동의 근본 동력으로 보고 이를 중심으로 역사를 분석하는 학문 전통.","subcategory":"역사학 방법론·사학사","level":2,"related":[],"prerequisites":[],"aliases":["마르크스주의역사학"]},{"slug":"banhwasilhwa-yeoksa","title_ko":"반사실적 역사","title_en":"Counterfactual History","meaning":"만약 특정 사건이 다르게 일어났다면 어떻게 되었을지를 가정하여 역사적 인과관계를 검토하는 방법.","subcategory":"역사학 방법론·사학사","level":1,"related":["contingency"],"prerequisites":[],"pop":7,"aliases":["반사실적역사"]},{"slug":"jinbo-sagwan","title_ko":"진보사관","title_en":"Progressive View of History","meaning":"역사가 시간이 흐름에 따라 점차 더 나은 방향으로 발전해 간다고 보는 역사관.","subcategory":"역사학 방법론·사학사","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["PVH"]},{"slug":"text-mining","title_ko":"텍스트마이닝","title_en":"Text Mining","meaning":"대량의 문헌 자료에서 컴퓨터 알고리즘을 이용해 어휘 패턴과 의미 구조를 추출하는 분석 기법.","subcategory":"역사학 방법론·사학사","level":3,"related":["sentiment-analysis"],"prerequisites":[],"pop":9},{"slug":"industrial-revolution","title_ko":"산업혁명","title_en":"Industrial Revolution","meaning":"18세기 후반 영국에서 시작되어 기계화된 생산방식과 공장제가 확산되며 경제·사회구조 전반을 변화시킨 역사적 과정.","subcategory":"세계사·한국사 핵심 개념","level":1,"related":[],"prerequisites":[],"pop":8},{"slug":"russian-revolution","title_ko":"러시아혁명","title_en":"Russian Revolution","meaning":"1917년 러시아에서 차르 전제정을 무너뜨리고 세계 최초의 사회주의 정권(소비에트 정부)이 수립된 혁명.","subcategory":"세계사·한국사 핵심 개념","level":1,"related":[],"prerequisites":[]},{"slug":"mercantilism","title_ko":"중상주의","title_en":"Mercantilism","meaning":"16~18세기 유럽 국가들이 금은 보유량 증대와 무역흑자를 통해 국부를 증진하려 한 경제정책과 이론.","subcategory":"세계사·한국사 핵심 개념","level":2,"related":[],"prerequisites":[],"pop":10},{"slug":"liberalism","title_ko":"자유주의","title_en":"Liberalism","meaning":"개인의 자유와 권리, 사유재산과 법치를 중시하며 국가 권력의 제한을 지향하는 정치사상.","subcategory":"세계사·한국사 핵심 개념","level":2,"related":[],"prerequisites":[],"aliases":["리버럴리즘"]},{"slug":"united-nations","title_ko":"국제연합","title_en":"United Nations","meaning":"제2차 세계대전 이후 1945년 국제평화와 안전 유지를 목표로 창설된 국제기구.","subcategory":"세계사·한국사 핵심 개념","level":2,"related":[],"prerequisites":[],"aliases":["UN","유엔"]},{"slug":"treaty-of-versailles","title_ko":"베르사유 조약","title_en":"Treaty of Versailles","meaning":"1919년 제1차 세계대전 전후 처리를 위해 승전국과 독일 사이에 체결된 강화조약.","subcategory":"세계사·한국사 핵심 개념","level":2,"related":[],"prerequisites":[],"aliases":["베르사유조약"]},{"slug":"detente","title_ko":"데탕트","title_en":"Détente","meaning":"1960~70년대 미국과 소련을 비롯한 냉전 진영 간 긴장이 완화된 국면.","subcategory":"세계사