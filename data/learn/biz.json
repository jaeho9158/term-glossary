[{"slug":"moral-hazard","title_ko":"도덕적 해이","title_en":"Moral Hazard","meaning":"위험이나 결과를 다른 사람(보험자, 계약 상대방 등)이 대신 부담하게 되면서, 그 사람이 원래보다 부주의하거나 위험한 행동을…","subcategory":"미시경제","level":1,"related":["human-capital","adverse-selection","game-theory","transaction-cost","information-asymmetry"],"prerequisites":[],"aliases":["도덕적 해이(보험)","도덕적해이(보험)"]},{"slug":"adverse-selection","title_ko":"역선택","title_en":"Adverse Selection","meaning":"거래 전에 한쪽만 중요한 정보를 알고 있어서, 결과적으로 상대에게 불리한 유형의 거래 상대만 시장에 남게 되는 현상이다.","subcategory":"미시경제","level":1,"related":["moral-hazard","externality","game-theory","transaction-cost","information-asymmetry","signaling-theory"],"prerequisites":[]},{"slug":"availability-heuristic","title_ko":"가용성 휴리스틱","title_en":"Availability Heuristic","meaning":"어떤 사건의 실제 발생 빈도보다, 그 사건이 머릿속에 얼마나 쉽게 떠오르는지를 기준으로 확률을 판단하는 사고방식이다.","subcategory":"인지심리","level":1,"related":["anchoring-effect","working-memory","bystander-effect","emotional-intelligence","representativeness-heuristic"],"prerequisites":[],"aliases":["이용가능성 휴리스틱"]},{"slug":"information-asymmetry","title_ko":"정보 비대칭","title_en":"Information Asymmetry","meaning":"거래에 참여하는 당사자들이 서로 다른 양의 정보를 가지고 있어서, 한쪽이 다른 쪽보다 더 많이 아는 상황을 말한다.","subcategory":"미시경제","level":1,"related":["rent-seeking","bounded-rationality","adverse-selection","moral-hazard","signaling-theory"],"prerequisites":[],"aliases":["Asymmetric Information (Real Estate)"]},{"slug":"signaling-theory","title_ko":"신호 이론","title_en":"Signaling Theory","meaning":"정보를 가진 쪽이 자신의 숨겨진 능력이나 품질을 상대방에게 믿을 만하게 전달하기 위해, 비용이 드는 행동(신호)을 이용하는…","subcategory":"미시경제","level":1,"related":["information-asymmetry","adverse-selection","moral-hazard"],"prerequisites":[],"aliases":["신호이론","시그널링 이론","Signaling Theory in Education"]},{"slug":"cost-leadership-strategy","title_ko":"원가우위전략","title_en":"Cost Leadership Strategy","meaning":"산업 내에서 가장 낮은 생산원가를 달성하여 경쟁자보다 저렴한 가격으로 제품을 공급하거나 동일 가격에서 더 높은 마진을…","subcategory":"경영전략·마케팅이론","level":1,"related":["differentiation-strategy"],"prerequisites":[],"pop":19},{"slug":"differentiation-strategy","title_ko":"차별화전략","title_en":"Differentiation Strategy","meaning":"제품이나 서비스에 고객이 가치 있다고 인식하는 독특한 속성을 부여하여 경쟁자와 차별화함으로써 가격 프리미엄을 확보하는 본원적…","subcategory":"경영전략·마케팅이론","level":1,"related":["cost-leadership-strategy"],"prerequisites":[]},{"slug":"ge-mckinsey-matrix","title_ko":"GE맥킨지매트릭스","title_en":"GE-McKinsey Matrix","meaning":"제너럴일렉트릭과 맥킨지가 공동 개발한 사업포트폴리오 분석 도구로, 산업매력도와 사업경쟁력이라는 두 축을 각각 다차원 지표로…","subcategory":"경영전략·마케팅이론","level":1,"related":[],"prerequisites":[],"pop":4},{"slug":"eliminate-reduce-raise-create-grid","title_ko":"ERRC그리드","title_en":"Eliminate-Reduce-Raise-Create Grid","meaning":"블루오션전략에서 가치혁신을 실행하기 위한 분석 도구로, 업계의 기존 관행 중 제거할 요소, 감소시킬 요소, 증가시킬 요소…","subcategory":"경영전략·마케팅이론","level":2,"related":["strategy-canvas"],"prerequisites":["strategy-canvas"],"pop":12,"aliases":["ERRCG"]},{"slug":"strategy-canvas","title_ko":"전략캔버스","title_en":"Strategy Canvas","meaning":"블루오션전략에서 산업 내 경쟁요소들을 가로축에 놓고 각 요소에 대한 기업들의 제공수준을 세로축으로 시각화하여 현재의 경쟁…","subcategory":"경영전략·마케팅이론","level":1,"related":["eliminate-reduce-raise-create-grid"],"prerequisites":[]},{"slug":"vrin-framework","title_ko":"VRIN프레임워크","title_en":"VRIN Framework","meaning":"자원기반관점에서 지속가능한 경쟁우위를 제공하는 자원의 조건으로 가치성(Valuable), 희소성(Rare)…","subcategory":"경영전략·마케팅이론","level":2,"related":["core-competence","dynamic-capabilities"],"prerequisites":["core-competence","dynamic-capabilities"],"aliases":["VRIO"]},{"slug":"core-competence","title_ko":"기업 핵심역량","title_en":"Core Competence","meaning":"프라할라드와 하멜이 제시한 개념으로, 기업이 보유한 여러 기술과 지식이 결합되어 만들어진, 경쟁자가 쉽게 모방할 수 없고…","subcategory":"경영전략·마케팅이론","level":1,"related":["vrin-framework","dynamic-capabilities"],"prerequisites":[],"pop":16},{"slug":"dynamic-capabilities","title_ko":"동적역량","title_en":"Dynamic Capabilities","meaning":"티스가 제시한 개념으로, 급변하는 환경에 대응하여 기업이 내외부 자원과 역량을 지속적으로 통합, 구축, 재구성할 수 있는…","subcategory":"경영전략·마케팅이론","level":1,"related":["core-competence"],"prerequisites":[]},{"slug":"pest-analysis","title_ko":"PEST분석","title_en":"PEST Analysis","meaning":"기업을 둘러싼 거시환경을 정치적(Political), 경제적(Economic), 사회문화적(Social)…","subcategory":"경영전략·마케팅이론","level":2,"related":["tows-matrix"],"prerequisites":[],"aliases":["PESTEL분석"]},{"slug":"tows-matrix","title_ko":"TOWS매트릭스","title_en":"TOWS Matrix","meaning":"SWOT분석에서 도출한 강점, 약점, 기회, 위협 요인을 서로 교차시켜 SO전략, ST전략, WO전략, WT전략이라는…","subcategory":"경영전략·마케팅이론","level":2,"related":["pest-analysis"],"prerequisites":[],"pop":8},{"slug":"targeting-strategy","title_ko":"표적시장선정","title_en":"Targeting Strategy","meaning":"시장세분화를 통해 나눈 여러 세분시장 중 기업의 자원과 역량에 가장 적합하고 매력적인 세분시장을 선택하는 STP전략의 두…","subcategory":"경영전략·마케팅이론","level":2,"related":[],"prerequisites":[]},{"slug":"product-life-cycle","title_ko":"제품수명주기","title_en":"Product Life Cycle","meaning":"제품이 시장에 출시되어 소멸하기까지 도입기, 성장기, 성숙기, 쇠퇴기의 네 단계를 거친다는 마케팅 이론으로, 각 단계별로…","subcategory":"경영전략·마케팅이론","level":1,"related":[],"prerequisites":[]},{"slug":"outsourcing","title_ko":"아웃소싱","title_en":"Outsourcing","meaning":"기업이 내부에서 직접 수행하던 업무나 기능을 외부 전문업체에 위탁하여 처리함으로써 핵심역량에 자원을 집중하고 비용을…","subcategory":"경영전략·마케팅이론","level":2,"related":["core-competence","internalization-advantage","technology-transfer"],"prerequisites":["core-competence"],"aliases":["아웃소싱전략","Outsourcing Strategy"]},{"slug":"servqual-model","title_ko":"서브퀄모형","title_en":"SERVQUAL Model","meaning":"파라수라만 등이 개발한 서비스품질 측정 모형으로, 신뢰성, 확신성, 유형성, 공감성, 응대성의 다섯 가지 차원을 통해 고객의…","subcategory":"경영전략·마케팅이론","level":2,"related":["service-quality-gap-model"],"prerequisites":[],"pop":11},{"slug":"service-quality-gap-model","title_ko":"서비스품질갭모형","title_en":"Service Quality Gap Model","meaning":"고객이 기대하는 서비스 수준과 실제로 인식하는 서비스 수준 사이에 발생하는 다섯 가지 유형의 격차를 규명하여 서비스 품질을…","subcategory":"경영전략·마케팅이론","level":3,"related":["servqual-model"],"prerequisites":["servqual-model"],"pop":18,"aliases":["SQGM"]},{"slug":"aida-model","title_ko":"AIDA모형","title_en":"AIDA Model","meaning":"소비자가 광고나 마케팅 메시지에 노출된 후 구매에 이르기까지 주의(Attention), 흥미(Interest)…","subcategory":"경영전략·마케팅이론","level":1,"related":[],"prerequisites":[],"aliases":["AIDA"]},{"slug":"servant-leadership","title_ko":"서번트리더십","title_en":"Servant Leadership","meaning":"로버트 그린리프가 제시한 개념으로, 리더가 구성원을 통제하기보다 그들의 성장과 필요를 우선적으로 섬기고 지원함으로써 조직…","subcategory":"경영전략·마케팅이론","level":3,"related":["organizational-culture"],"prerequisites":[],"pop":7},{"slug":"mckinsey-7s-framework","title_ko":"맥킨지7S모형","title_en":"McKinsey 7S Framework","meaning":"맥킨지가 제시한 조직진단 모형으로, 전략, 구조, 시스템, 공유가치, 스타일, 인력, 스킬이라는 일곱 가지 요소가 상호…","subcategory":"경영전략·마케팅이론","level":3,"related":["organizational-culture"],"prerequisites":[],"pop":6,"aliases":["7S모형"]},{"slug":"job-embeddedness","title_ko":"직무배태성","title_en":"Job Embeddedness","meaning":"구성원이 현재의 직무와 조직, 지역사회에 연결되어 있는 정도로, 이직 의도를 낮추는 심리적, 사회적, 물리적 요인들의…","subcategory":"조직행동·인사관리","level":3,"related":["turnover-intention","organizational-commitment","career-development"],"prerequisites":["career-development"],"pop":1},{"slug":"herzberg-two-factor-theory","title_ko":"허츠버그 2요인이론","title_en":"Herzberg's Two-Factor Theory","meaning":"직무만족과 불만족은 서로 독립된 차원으로, 위생요인은 불만족을 방지하고 동기요인은 만족을 유발한다고 보는 이론이다.","subcategory":"조직행동·인사관리","level":3,"related":["job-satisfaction","job-enrichment"],"prerequisites":["job-enrichment"],"pop":9,"aliases":["허츠버그2요인이론","허즈버그2요인이론","2요인이론","동기위생이론"]},{"slug":"job-enrichment","title_ko":"직무충실화","title_en":"Job Enrichment","meaning":"직무에 더 많은 책임, 자율성, 의사결정 권한을 부여해 수직적으로 직무의 깊이를 확장하는 직무설계 방식이다.","subcategory":"조직행동·인사관리","level":1,"related":["herzberg-two-factor-theory"],"prerequisites":[]},{"slug":"career-anchors","title_ko":"경력닻","title_en":"Career Anchors","meaning":"개인이 경력 선택에서 쉽게 포기하지 않는 자기 인식된 재능, 동기, 가치관의 핵심 패턴을 말한다.","subcategory":"조직행동·인사관리","level":3,"related":["career-development"],"prerequisites":["career-development"],"pop":5},{"slug":"career-development","title_ko":"경력개발","title_en":"Career Development","meaning":"개인의 경력 목표를 조직의 인력 수요와 연계하여 체계적으로 역량과 경력을 성장시키는 과정을 말한다.","subcategory":"조직행동·인사관리","level":1,"related":["career-anchors"],"prerequisites":[],"pop":13,"aliases":["CDP"]},{"slug":"french-and-raven-power-bases","title_ko":"프렌치-레이븐 권력원천","title_en":"French and Raven's Bases of Power","meaning":"보상적, 강제적, 합법적, 준거적, 전문적 권력의 다섯 가지 원천으로 사회적 영향력의 근거를 분류한 이론이다.","subcategory":"조직행동·인사관리","level":3,"related":[],"prerequisites":[],"pop":15,"aliases":["FRBP","프렌치 레이븐 권력원천","프렌치-레이븐권력원천","프렌치레이븐 권력원천"]},{"slug":"stewardship-theory","title_ko":"청지기이론","title_en":"Stewardship Theory","meaning":"경영자가 개인의 이익보다 조직 전체의 이익을 위해 신뢰할 수 있는 청지기로서 행동한다고 보는 지배구조 이론이다.","subcategory":"조직행동·인사관리","level":3,"related":["organizational-commitment","servant-leadership"],"prerequisites":[]},{"slug":"thomas-kilmann-model","title_ko":"토마스-킬만 갈등관리모형","title_en":"Thomas-Kilmann Conflict Mode Instrument","meaning":"협력성과 주장성이라는 두 차원을 기준으로 경쟁, 협력, 타협, 회피, 수용의 다섯 가지 갈등 대응 방식을 제시한 모형이다.","subcategory":"조직행동·인사관리","level":3,"related":[],"prerequisites":[],"pop":2,"aliases":["TKCMI","토마스 킬만 갈등관리모형","토마스-킬만갈등관리모형","토마스킬만 갈등관리모형"]},{"slug":"realistic-job-preview","title_ko":"현실적 직무 소개","title_en":"Realistic Job Preview (RJP)","meaning":"채용 과정에서 지원자에게 직무의 긍정적 측면뿐 아니라 부정적 측면까지 사실대로 제공하여 정확한 기대를 형성하게 하는 기법이다.","subcategory":"조직행동·인사관리","level":3,"related":["psychological-contract","turnover-intention"],"prerequisites":[],"pop":10,"aliases":["RJP","현실적직무소개"]},{"slug":"demand-forecasting","title_ko":"수요예측","title_en":"Demand Forecasting","meaning":"과거 판매 데이터, 시장 동향, 정성적 정보를 활용해 미래 제품·서비스 수요를 추정하는 활동으로…","subcategory":"생산운영관리·경영정보시스템","level":1,"related":[],"prerequisites":[],"aliases":["물류 수요예측"]},{"slug":"capacity-requirements-planning","title_ko":"능력소요계획","title_en":"Capacity Requirements Planning (CRP)","meaning":"MRP가 산출한 자재 발주계획을 실행하는 데 필요한 작업장별 세부 생산능력(기계시간, 인력시간)을 산정하고 가용능력과…","subcategory":"생산운영관리·경영정보시스템","level":1,"related":["rough-cut-capacity-planning"],"prerequisites":[]},{"slug":"rough-cut-capacity-planning","title_ko":"개략능력계획","title_en":"Rough-Cut Capacity Planning (RCCP)","meaning":"기준생산계획(MPS) 확정 이전 단계에서 핵심 자원