[{"slug":"scaling","title_ko":"스케일링","title_en":"Scaling","meaning":"초음파 또는 수기구를 이용하여 치아 표면에 침착된 치태와 치석을 제거하는 치주 예방 및 치료 시술이다.","subcategory":"구강병리·보존치료","level":2,"related":[],"prerequisites":[],"aliases":["치석제거술"]},{"slug":"furcation-involvement","title_ko":"치근이개부병변","title_en":"Furcation Involvement","meaning":"다근치에서 치근이 갈라지는 부위까지 치주조직 파괴가 진행되어 치조골 소실이 나타나는 상태로, 소실 정도에 따라 등급이…","subcategory":"구강병리·보존치료","level":2,"related":["root-canal-treatment"],"prerequisites":[],"pop":17},{"slug":"occlusal-trauma","title_ko":"교합성 외상","title_en":"Occlusal Trauma","meaning":"치아에 가해지는 교합력이 치주조직의 적응 능력을 초과하여 치주인대와 치조골에 손상을 유발하는 상태로, 1차성과 2차성으로…","subcategory":"구강병리·보존치료","level":1,"related":[],"prerequisites":[],"aliases":["교합성외상","교합외상","1차성 교합성 외상","2차성 교합성 외상","trauma from occlusion","TFO"]},{"slug":"reversible-pulpitis","title_ko":"가역성치수염","title_en":"Reversible Pulpitis","meaning":"경미한 자극에 의해 치수에 일시적 염증이 발생한 상태로, 자극이 제거되면 치수가 정상 상태로 회복될 수 있는 초기 단계의…","subcategory":"구강병리·보존치료","level":1,"related":["pulp-vitality-test"],"prerequisites":[]},{"slug":"pulp-vitality-test","title_ko":"치수생활력검사","title_en":"Pulp Vitality Test","meaning":"냉·온 자극이나 전기자극을 가하여 치수의 신경학적 반응을 평가함으로써 치수의 생존 여부와 상태를 판단하는 임상 진단검사이다.","subcategory":"구강병리·보존치료","level":2,"related":["reversible-pulpitis","root-canal-treatment"],"prerequisites":["reversible-pulpitis"]},{"slug":"root-canal-treatment","title_ko":"근관치료","title_en":"Root Canal Treatment","meaning":"감염되거나 괴사한 치수를 제거하고 근관계를 세정·성형한 후 충전물로 밀폐하여 치아를 보존하는 치과 치료 술식이다.","subcategory":"구강병리·보존치료","level":1,"related":[],"prerequisites":[],"aliases":["신경치료"]},{"slug":"odontogenic-infection","title_ko":"치성감염","title_en":"Odontogenic Infection","meaning":"치아우식증, 치주질환, 치수 감염 등 치아 및 그 주위조직에서 기원하여 주변 연조직이나 골조직으로 확산될 수 있는 감염을…","subcategory":"구강병리·보존치료","level":1,"related":["root-canal-treatment"],"prerequisites":[]},{"slug":"abfraction","title_ko":"굴곡파절","title_en":"Abfraction","meaning":"교합력에 의한 치아의 미세한 굴곡 응력이 치경부에 집중되어 법랑질이 미세하게 박리·파절되면서 쐐기 모양 결손이 발생하는…","subcategory":"구강병리·보존치료","level":2,"related":["occlusal-trauma"],"prerequisites":["occlusal-trauma"],"pop":6},{"slug":"apexification","title_ko":"치근단형성유도술","title_en":"Apexification","meaning":"치근 발육이 완료되지 않은 상태에서 치수가 괴사한 미성숙 영구치에 대해 치근단 부위에 경조직 장벽 형성을 유도하는 치료…","subcategory":"구강병리·보존치료","level":2,"related":["root-canal-treatment"],"prerequisites":["root-canal-treatment"],"pop":5},{"slug":"tooth-avulsion","title_ko":"완전탈구","title_en":"Tooth Avulsion","meaning":"외상에 의해 치아가 치조와에서 완전히 빠져나온 상태로, 치주인대세포의 생존을 위해 빠른 재식이 예후에 결정적인 영향을 미친다.","subcategory":"구강병리·보존치료","level":2,"related":["tooth-luxation"],"prerequisites":[]},{"slug":"tooth-luxation","title_ko":"치아탈구","title_en":"Tooth Luxation","meaning":"외상에 의해 치아가 치조와 내에서 완전히 빠지지는 않았으나 정상 위치에서 이탈된 상태로, 진탕, 아탈구, 측방탈구…","subcategory":"구강병리·보존치료","level":2,"related":["tooth-avulsion"],"prerequisites":[],"pop":20},{"slug":"pyogenic-granuloma","title_ko":"화농성육아종","title_en":"Pyogenic Granuloma","meaning":"국소 자극이나 만성 염증에 반응하여 혈관이 풍부한 육아조직이 과증식하는 반응성 병변으로, 출혈 경향이 있는 적색 종괴로…","subcategory":"구강병리·보존치료","level":2,"related":["biopsy"],"prerequisites":[],"pop":10},{"slug":"clasp","title_ko":"클라스프","title_en":"Clasp","meaning":"가철성 국소의치에서 지대치의 언더컷 부위에 걸려 의치의 유지와 안정을 담당하는 금속 구성 요소이다.","subcategory":"보철·교정·구강외과","level":2,"related":[],"prerequisites":[],"aliases":["의치고리"]},{"slug":"dental-crown","title_ko":"크라운","title_en":"Dental Crown","meaning":"치아의 치관부를 전체적으로 덮어 형태와 기능, 심미성을 회복시키는 고정성 보철물이다.","subcategory":"보철·교정·구강외과","level":1,"related":["zirconia-crown"],"prerequisites":[],"aliases":["금관"]},{"slug":"centric-relation","title_ko":"중심위","title_en":"Centric Relation","meaning":"하악과두가 관절와 내에서 근육의 부담 없이 재현 가능한 가장 상방-전방 위치에 있을 때의 하악과 상악의 골격적 관계이다.","subcategory":"보철·교정·구강외과","level":1,"related":["facebow-transfer"],"prerequisites":[]},{"slug":"balanced-occlusion","title_ko":"균형교합","title_en":"Balanced Occlusion","meaning":"하악의 편심 운동 시 작업측과 비작업측 모두에서 치아 접촉이 동시에 이루어지도록 설계된 교합 개념으로 주로 완전틀니에…","subcategory":"보철·교정·구강외과","level":1,"related":["group-function-occlusion","canine-guided-occlusion"],"prerequisites":[]},{"slug":"group-function-occlusion","title_ko":"군기능교합","title_en":"Group Function Occlusion","meaning":"측방운동 시 작업측의 여러 치아가 동시에 접촉하며 교합력을 분산시키는 교합 형태이다.","subcategory":"보철·교정·구강외과","level":2,"related":["canine-guided-occlusion","balanced-occlusion"],"prerequisites":["balanced-occlusion"],"pop":2,"aliases":["GFO"]},{"slug":"canine-guided-occlusion","title_ko":"견치유도교합","title_en":"Canine-Guided Occlusion","meaning":"측방운동 시 견치만 접촉하여 다른 구치를 이개시킴으로써 측방력을 견치에 집중시키는 교합 형태이다.","subcategory":"보철·교정·구강외과","level":2,"related":["group-function-occlusion","balanced-occlusion"],"prerequisites":["balanced-occlusion"],"pop":4,"aliases":["CGO"]},{"slug":"cantilever-bridge","title_ko":"캔틸레버브릿지","title_en":"Cantilever Bridge","meaning":"결손 부위 한쪽에만 지대치를 두고 반대쪽은 지지 없이 연장된 형태로 인공치를 부착하는 고정성 보철물이다.","subcategory":"보철·교정·구강외과","level":2,"related":[],"prerequisites":[],"pop":18},{"slug":"zirconia-crown","title_ko":"지르코니아크라운","title_en":"Zirconia Crown","meaning":"지르코니아 세라믹을 코어 또는 전체 구조로 사용하여 높은 강도와 파절 저항성을 지닌 전부도재관의 한 종류이다.","subcategory":"보철·교정·구강외과","level":2,"related":["dental-crown"],"prerequisites":["dental-crown"],"pop":16},{"slug":"dental-inlay","title_ko":"인레이","title_en":"Dental Inlay","meaning":"치아의 교합면 와동 내부에 국한되어 제작, 접착되는 간접 수복물로 치아 교두를 덮지 않는다.","subcategory":"보철·교정·구강외과","level":3,"related":["dental-crown"],"prerequisites":["dental-crown"]},{"slug":"immediate-implant-placement","title_ko":"즉시임플란트식립","title_en":"Immediate Implant Placement","meaning":"발치 직후 동일 시술 내에 발치와에 임플란트를 식립하는 술식으로 치료 기간 단축이 가능하다.","subcategory":"보철·교정·구강외과","level":2,"related":[],"prerequisites":[]},{"slug":"osteoconduction","title_ko":"골전도","title_en":"Osteoconduction","meaning":"이식재가 골 형성 세포와 혈관이 이동할 수 있는 지지 구조(스캐폴드) 역할을 하여 신생골 형성을 유도하는 수동적 과정이다.","subcategory":"보철·교정·구강외과","level":1,"related":[],"prerequisites":[]},{"slug":"alveolar-bone","title_ko":"치조골","title_en":"Alveolar Bone","meaning":"치아를 지지하기 위해 상악골과 하악골에서 치근을 둘러싸며 발달한 골 조직이다.","subc