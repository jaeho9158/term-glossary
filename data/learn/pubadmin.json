":[],"pop":3,"aliases":["NBMM","니스카넨의예산극대화모형","니스카넨모형","예산극대화모형"]},{"slug":"privatization","title_ko":"민영화","title_en":"Privatization","meaning":"정부나 공공기관이 소유·운영하던 사업이나 자산의 소유권 또는 경영권을 민간 부문으로 이전하는 것으로, 시장 경쟁을 통해…","subcategory":"조직이론·인사행정","level":2,"related":["new-public-management"],"prerequisites":[],"pop":17},{"slug":"allison-model","title_ko":"앨리슨모형","title_en":"Allison Model","meaning":"그레이엄 앨리슨이 쿠바 미사일 위기를 분석하며 제시한 모형으로, 합리적행위자모델·조직과정모델·정부정치모델의 세 가지 시각으로…","subcategory":"정책분석·재무행정","level":2,"related":["organizational-process-model","governmental-politics-model"],"prerequisites":[],"pop":6},{"slug":"organizational-process-model","title_ko":"조직과정모형","title_en":"Organizational Process Model","meaning":"앨리슨모형의 두 번째 시각으로, 정책결정이 표준운영절차(SOP)에 따른 조직 하위단위들의 산출물로 나타난다고 보는 모형.","subcategory":"정책분석·재무행정","level":2,"related":["allison-model","governmental-politics-model"],"prerequisites":[],"pop":20,"aliases":["OPM"]},{"slug":"governmental-politics-model","title_ko":"정부정치모형","title_en":"Governmental Politics Model","meaning":"앨리슨모형의 세 번째 시각으로, 정책결정을 다수 행위자 간 협상·타협·권력다툼의 정치적 산물로 보는 모형.","subcategory":"정책분석·재무행정","level":2,"related":["allison-model","organizational-process-model"],"prerequisites":[]},{"slug":"implementation-gap","title_ko":"집행격차","title_en":"Implementation Gap","meaning":"정책결정 단계에서 의도한 목표와 실제 집행 결과 사이에 발생하는 괴리.","subcategory":"정책분석·재무행정","level":2,"related":[],"prerequisites":[]},{"slug":"new-performance-budgeting","title_ko":"신성과주의예산제도","title_en":"New Performance Budgeting","meaning":"예산 편성의 자율성을 부여하되 사업성과 목표와 지표를 설정하고 그 결과에 대해 책임을 지도록 하는 결과지향적 예산제도.","subcategory":"정책분석·재무행정","level":3,"related":["top-down-budgeting"],"prerequisites":["top-down-budgeting"],"aliases":["신성과주의예산"]},{"slug":"top-down-budgeting","title_ko":"총액배분자율편성예산제도","title_en":"Top-Down Budgeting","meaning":"중앙예산기관이 부처별 지출한도를 먼저 정해주고 각 부처가 그 범위 내에서 자율적으로 세부사업 예산을 편성하도록 하는 제도.","subcategory":"정책분석·재무행정","level":1,"related":[],"prerequisites":[],"aliases":["TDB"]},{"slug":"leviathan-hypothesis","title_ko":"리바이어던가설","title_en":"Leviathan Hypothesis","meaning":"정부(특히 중앙정부)를 세입을 극대화하려는 독점적 리바이어던으로 가정하고, 재정분권이 이러한 정부팽창을 억제하는 장치가…","subcategory":"정책분석·재무행정","level":3,"related":[],"prerequisites":[],"pop":11},{"slug":"baumols-cost-disease","title_ko":"보몰의비용질병","title_en":"Baumol's Cost Disease","meaning":"노동집약적인 서비스업(교육, 의료, 행정서비스 등)은 제조업에 비해 생산성 향상이 더뎌 상대적으로 비용이 계속 상승하는 현상.","subcategory":"정책분석·재무행정","level":2,"related":["new-public-management"],"prerequisites":[],"pop":5,"aliases":["보몰병","비용질병"]},{"slug":"redistributive-policy","title_ko":"재분배정책","title_en":"Redistributive Policy","meaning":"사회의 특정 계층(주로 부유층)으로부터 다른 계층(주로 저소득층)으로 자원이나 가치를 이전시키는 정책.","subcategory":"정책분석·재무행정","level":2,"related":["lowi-policy-typology"],"prerequisites":["lowi-policy-typology"],"pop":19},{"slug":"regulatory-policy","title_ko":"규제정책","title_en":"Regulatory Policy","meaning":"특정 개인이나 집단의 행위를 제한하거나 통제하여 다른 사람들을 보호하려는 정책.","subcategory":"정책분석·재무행정","level":2,"related":["lowi-policy-typology","regulatory-capture"],"prerequisites":["lowi-policy-typology"],"pop":14},{"slug":"constituent-policy","title_ko":"구성정책","title_en":"Constituent Policy","meaning":"정부기구의 신설·변경이나 선거구 조정 등 정부의 조직과 운영규칙 자체를 대상으로 하는 정책.","subcategory":"정책분석·재무행정","level":3,"related":["lowi-policy-typology"],"prerequisites":["lowi-policy-typology"],"pop":15},{"slug":"lowi-policy-typology","title_ko":"로위의정책유형론","title_en":"Lowi's Policy Typology","meaning":"시어도어 로위가 제시한 유형론으로, 정책을 분배정책, 재분배정책, 규제정책, 구성정책의 네 가지로 구분하고 각 유형이 상이한…","subcategory":"정책분석·재무행정","level":1,"related":["redistributive-policy","regulatory-policy","constituent-policy"],"prerequisites":[],"pop":7},{"slug":"single-entry-bookkeeping","title_ko":"단식부기","title_en":"Single-Entry Bookkeeping","meaning":"거래를 현금의 수입과 지출이라는 단일 항목으로만 기록하는 전통적이고 단순한 회계기록방식.","subcategory":"정책분석·재무행정","level":3,"related":[],"prerequisites":[],"pop":16},{"slug":"local-council","title_ko":"지방의회","title_en":"Local Council","meaning":"주민의 대표로 구성되어 조례 제정, 예산 심의·의결, 행정사무 감사 등을