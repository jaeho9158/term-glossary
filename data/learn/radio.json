[{"slug":"pet-imaging","title_ko":"양전자방출단층촬영","title_en":"PET","meaning":"몸에 주입한 방사성 추적자가 내는 신호를 감지해 특정 부위의 대사 활동이나 특정 분자의 분포를 영상으로 보여주는 뇌·신체…","subcategory":"신경영상·측정기법","level":2,"related":["fmri"],"prerequisites":["fmri"],"aliases":["양전자방출단층촬영술","펫 스캔","positron emission tomography"]},{"slug":"hounsfield-unit","title_ko":"하운스필드단위","title_en":"Hounsfield unit","meaning":"CT 영상에서 물을 0, 공기를 -1000으로 기준 삼아 조직의 X선 감쇠 정도를 수치화한 단위입니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":[],"prerequisites":[],"pop":8,"aliases":["HU"]},{"slug":"t1-weighted-image","title_ko":"T1강조영상","title_en":"T1-weighted image","meaning":"조직의 T1 이완시간 차이를 강조하여 해부학적 구조를 뚜렷하게 보여주는 MRI 영상 기법입니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":["magnetic-resonance-imaging","contrast-enhanced-mri"],"prerequisites":[],"aliases":["T1WI"]},{"slug":"as-low-as-reasonably-achievable","title_ko":"ALARA원칙","title_en":"as low as reasonably achievable","meaning":"진단에 필요한 영상 정보를 얻으면서도 환자와 의료진의 방사선 피폭을 합리적으로 가능한 최소 수준으로 유지해야 한다는 방사선…","subcategory":"방사선촬영·영상의학기법","level":1,"related":["effective-dose"],"prerequisites":[],"pop":2,"aliases":["ALARA"]},{"slug":"effective-dose","title_ko":"유효선량","title_en":"effective dose","meaning":"방사선이 여러 장기에 미치는 위험도를 가중치로 반영하여 전신에 대한 확률적 영향을 하나의 값으로 나타낸 방사선량 지표입니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":["as-low-as-reasonably-achievable"],"prerequisites":[],"pop":13},{"slug":"kilovoltage-peak","title_ko":"관전압","title_en":"kilovoltage peak","meaning":"X선관에 걸리는 최고 전압으로, X선의 에너지와 투과력을 결정하는 촬영 조건 인자입니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":["radiographic-contrast"],"prerequisites":[],"aliases":["kVp"]},{"slug":"radiographic-contrast","title_ko":"사진대조도","title_en":"radiographic contrast","meaning":"X선 영상에서 인접한 두 조직 간 밝기 차이의 정도를 나타내며, 병변과 정상조직을 구별하는 데 핵심적인 영상 품질 요소입니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":["kilovoltage-peak","image-noise"],"prerequisites":[]},{"slug":"volume-rendering","title_ko":"용적렌더링","title_en":"volume rendering","meaning":"3차원 영상 데이터의 모든 복셀 정보를 투명도와 색상으로 처리하여 입체적인 표면과 내부 구조를 함께 표현하는 후처리…","subcategory":"방사선촬영·영상의학기법","level":2,"related":[],"prerequisites":[]},{"slug":"digital-subtraction-angiography","title_ko":"디지털감산혈관조영술","title_en":"digital subtraction angiography","meaning":"조영제 주입 전후 영상을 컴퓨터로 감산하여 뼈나 연부조직 신호를 제거하고 혈관만 선명하게 남기는 혈관조영 기법입니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":["fluoroscopy","interventional-radiology"],"prerequisites":[],"pop":15,"aliases":["DSA"]},{"slug":"interventional-radiology","title_ko":"중재적방사선시술","title_en":"interventional radiology","meaning":"영상 유도 하에 카테터나 바늘 등을 이용해 최소 침습적으로 진단 및 치료를 시행하는 방사선의학 분야입니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":["fluoroscopy","digital-subtraction-angiography"],"prerequisites":[],"pop":11,"aliases":["인터벤션","중재영상의학"]},{"slug":"image-noise","title_ko":"영상잡음","title_en":"image noise","meaning":"촬영 조건이나 장비 특성으로 인해 영상에 무작위로 나타나는 원치 않는 신호 변동을 말합니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":["radiographic-contrast"],"prerequisites":[]},{"slug":"personal-dosimeter","title_ko":"개인선량계","title_en":"personal dosimeter","meaning":"방사선 관련 업무 종사자가 신체에 착용하여 누적된 방사선 피폭량을 측정하고 기록하는 장치입니다.","subcategory":"방사선촬영·영상의학기법","level":2,"related":["effective-dose","as-low-as-reasonably-achievable"],"prerequisites":["effective-dose","as-low-as-reasonably-achievable"],"pop":14},{"slug":"z-score-bone-density","title_ko":"Z-값","title_en":"Z-score","meaning":"골밀도검사 결과를 같은 연령, 성별, 인종의 평균 골밀도와 비교하여 표준편차 단위로 나타낸 지표입니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":[],"prerequisites":[],"pop":6,"aliases":["Z 값"]},{"slug":"signal-intensity","title_ko":"신호강도","title_en":"signal intensity","meaning":"MRI 영상에서 각 조직이 나타내는 밝기의 정도를 뜻하며, 조직의 성분과 촬영 기법에 따라 달라집니다.","subcategory":"방사선촬영·영상의학기법","level":1,"related":["t1-weighted-image","magnetic-resonance-imaging","contrast-enhanced-mri"],"prerequisites":[],"pop":9},{"slug":"contrast-enhanced-mri","title_ko":"조영증강MRI","title_en":"contrast-enhanced MRI","meaning":"가돌리늄조영제를 투여한 후 촬영하여 병변의 혈류 공급이나 혈관장벽 파괴 여부를 평가하는 MRI 검사입니다.","subcategory":"방사선촬영·영상의학기법","level":2,"related":["magnetic-resonance-imaging","t1-weighted-image","signal-intensity"],"prerequisites":["t1-weighted-image","signal-intensity"],"pop":1},{"slug":"contrast-extravasation","title_ko":"조영제혈관외유출","title_en":"contrast extravasation","meaning":"정맥 주사한 조영제가 혈관 밖 주변 조직으로 새어 나가는 시술 관련 합병증입니다.","subcategory":"방사선촬영·영상의학기법","level":3,"related":[],"prerequisites":[],"pop":5},{"slug":"echogenicity","title_ko":"에코발생성","title_en":"echogenicity","meaning":"조직이 초음파를 반사하는 정도를 나타내는 개념으로, 초음파 영상에서 밝기로 표현됩니다.","subcategory":"방사선촬영·영상의학기법","level":2,"related":["acoustic-impedance","doppler-ultrasound"],"prerequisites":[],"pop":3},{"slug":"acoustic-impedance","title_ko":"음향임피던스","title_en":"acoustic impedance","meaning":"조직이 초음파의 전파에 대해 갖는 저항성을 나타내는 물리량으로, 조직 경계에서 초음파 반사의 정도를 결정합니다.","subcategory":"방사선촬영·영상의학기법","level":2,"related":["echogenicity","doppler-ultrasound"],"prerequisites":[],"pop":19},{"slug":"decubitus-position","title_ko":"측와위촬영","title_en":"decubitus position","meaning":"환자를 옆으로 눕힌 자세에서 수평으로 X선을 투과시켜 흉수나 복강 내 공기 등 체액과 공기의 이동을 관찰하는 촬영 자세입니다.","subcategory":"방사선촬영·영상의학기법","level":2,"related":[],"prerequisites":[],"pop":12},{"slug":"thyroid-uptake-scan","title_ko":"갑상선섭취스캔","title_en":"thyroid uptake scan","meaning":"방사성요오드를 이용해 갑상선이 요오드를 흡수하는 정도를 측정하고 영상화하여 갑상선 기능과 결절의 활성을 평가하는 핵의학…","subcategory":"방사선촬영·영상의학기법","level":3,"related":[],"prerequisites":[],"pop":7,"aliases":["갑상선섭취율검사","Thyroid Uptake Test","TUT"]},{"slug":"renal-scan","title_ko":"신장스캔","title_en":"renal scan","meaning":"방사성의약품이 신장을 통과하는 과정을 영상화하여 각 신장의 기능과 소변 배출 상태를 평가하는 핵의학 검사입니다.","subcategory":"방사선촬영·영상의학기법","level":3,"related":[],"prerequisites":[],"pop":18},{"slug":"imrt","title_ko":"세기조절방사선치료","title_en":"Intensity-Modulated Radiation Therapy (IMRT)","meaning":"다엽콜리메이터로 빔 단면 내 선량 세기를 여러 구간으로 조절하여 종양 모양에 맞춘 선량분포를 구현하는 방사선치료 기법.","subcategory":"방사선치료·핵의학","level":1,"related":[],"prerequisites":[],"pop":17,"aliases":["IMRT","Intensity-Modulated Radiotherapy"]},{"slug":"srs","title_ko":"정위방사선수술","title_en":"Stereotactic Radiosurgery (SRS)","meaning":"정위적 좌표계를 이용해 작은 두개내 병변에 매우 높은 정밀도로 단일 고선량을 조사하여 수술적 절제와 유사한 효과를 얻는…","subcategory":"방사선치료·핵의학","level":1,"related":["cyberknife","whole-brain-radiotherapy"],"prerequisites":[]},{"slug":"radioisotope","title_ko":"방사성동위원소","title_en":"Radioisotope","meaning":"동일한 원소이지만 원자핵이 불안정하여 자발적으로 붕괴하며 방사선을 방출하는 동위원소로, 진단 및 치료용 방사성의약품 제조에…","subcategory":"방사선치료·핵의학","level":1,"related":["technetium-99m","iodine-131"],"prerequisites":[]},{"slug":"cyberknife","title_ko":"사이버나이프","title_en":"CyberKnife","meaning":"로봇팔에 장착된 소형 선형가속기가 실시간 영상유도로 표적을 추적하며 다양한 각도에서 방사선을 조사하는…","subcategory":"방사선치료·핵의학","level":2,"related":["srs"],"prerequisites":["srs"],"pop":4},{"slug":"cesium-137","title_ko":"세슘-137","title_en":"Cesium-137","meaning":"반감기 약 30년으로 감마선을 방출하는 인공 방사성동위원소로, 과거 근접치료 및 혈액 조사기의 선원으로 사용되었으나 현재는…","subcategory":"방사선치료·핵의학","level":3,"related":["radioisotope"],"prerequisites":["radioisotope"],"aliases":["세슘 137","세슘137"]},{"slug":"iodine-131","title_ko":"요오드-131","title_en":"Iodine-131 (I-131)","meaning":"베타선과 감마선을 함께 방출하는 방사성동위원소로, 갑상선 조직에 선택적으로 섭취되는 특성을 이용해 갑상선암 및…","subcategory":"방사선치료·핵의학","level":1,"related":["radioisotope","thyroid-uptake-scan"],"prerequisites":[],"aliases":["I-131","요오드 131","요오드131"]},{"slug":"technetium-99m","title_ko":"테크네튬-99m","title_en":"Technetium-99m (Tc-99m)","meaning":"반감기 약 6시간의 준안정 상태 감마선 방출 방사성동위원소로, 다양한 표지 화합물과 결합하여 골스캔, 심근관류영상 등 핵의학…","subcategory":"방사선치료·핵의학","level":2,"related":["radioisotope"],"prerequisites":["radioisotope"],"aliases":["Tc-99m","테크네튬 99m","테크네튬99m"]},{"slug":"whole-brain-radiotherapy","title_ko":"전뇌방사선치료","title_en":"Whole Brain Radiotherapy (WBRT)","meaning":"뇌 전체를 조사 범위에 포함하여 다발성 뇌전이 병변이나 육안적으로 확인되지 않는 미세 전이를 함께 치료하는 방사선치료 기법.","subcategory":"방사선치료·핵의학","level":2,"related":["srs","craniospinal-irradiation"],"prerequisites":["srs"],"pop":10,"aliases":["WBR","WBRT"]},{"slug":"craniospinal-irradiation","title_ko":"전뇌척수방사선조사","title_en":"Craniospinal Irradiation (CSI)","meaning":"뇌척수액을 통해 전이될 수 있는 수모세포종 등의 종양에서 뇌와 척수 전체를 하나의 치료범위로 포함하여 조사하는 광범위…","subcategory":"방사선치료·핵의학","level":2,"related":[],"prerequisites":[],"pop":20},{"slug":"oxygen-enhancement-ratio","title_ko":"산소증강비","title_en":"Oxygen Enhancement Ratio (OER)","meaning":"동일한 생물학적 효과를 얻기 위해 저산소 조건에서 필요한 선량과 정상 산소 조건에서 필요한 선량의 비율로, 산소가 방사선…","subcategory":"방사선치료·핵의학","level":2,"related":[],"prerequisites":[],"pop":16}]