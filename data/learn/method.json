[{"slug":"p-value","title_ko":"유의확률","title_en":"p-value","meaning":"지금 관찰된 결과가 \"우연히\" 나왔을 가능성이 얼마나 되는지를 나타내는 숫자입니다.","subcategory":"추론통계·가설검정","level":1,"related":["significance-level","confidence-interval","effect-size","correlation","sample-size","cox-proportional-hazards-model"],"prerequisites":[],"pop":16,"aliases":["p값","P값"]},{"slug":"meta-analysis","title_ko":"메타분석","title_en":"Meta-analysis","meaning":"같은 주제를 다룬 여러 개별 연구의 결과를 통계적으로 종합해서 하나의 결론을 도출하는 연구 방법입니다.","subcategory":"문헌연구·메타분석","level":1,"related":["effect-size","randomized-controlled-trial","confidence-interval","statistical-power","bootstrap-resampling","evidence-based-nursing"],"prerequisites":[]},{"slug":"sample-size","title_ko":"표본크기","title_en":"Sample Size","meaning":"연구에 실제로 참여한 사람(또는 관찰 대상)의 수를 말합니다. 흔히 알파벳 n으로 표기합니다.","subcategory":"실험설계·표본추출","level":1,"related":["p-value","confidence-interval","randomized-controlled-trial","qualitative-research"],"prerequisites":[],"aliases":["표본 크기"]},{"slug":"control-group","title_ko":"통제집단","title_en":"Control Group","meaning":"실험 대상이 되는 처치(약물, 프로그램 등)를 받지 않고 비교 기준 역할을 하는 그룹입니다.","subcategory":"연구설계","level":1,"related":["randomized-controlled-trial","cohort-study","case-control-study","data-saturation"],"prerequisites":[],"aliases":["대조군"]},{"slug":"cohort-study","title_ko":"코호트연구","title_en":"Cohort Study","meaning":"특정 공통점을 가진 사람들의 집단(코호트)을 오랜 기간 추적 관찰하며 특정 요인과 결과 사이의 관계를 살펴보는 연구…","subcategory":"연구설계","level":1,"related":["randomized-controlled-trial","control-group","case-control-study","confounding-variable"],"prerequisites":[],"pop":14,"aliases":["코호트","전향적코호트","코호트 조사"]},{"slug":"qualitative-research","title_ko":"질적연구","title_en":"Qualitative Research","meaning":"숫자로 측정하기 어려운 경험, 감정, 맥락을 인터뷰나 관찰 등을 통해 깊이 있게 탐구하는 연구 방법입니다.","subcategory":"질적연구","level":1,"related":["sample-size","thematic-analysis","content-analysis","grounded-theory"],"prerequisites":[]},{"slug":"null-hypothesis","title_ko":"귀무가설","title_en":"Null Hypothesis","meaning":"\"차이가