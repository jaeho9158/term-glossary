[{"slug":"cost-leadership-strategy","title_ko":"원가우위전략","title_en":"Cost Leadership Strategy","meaning":"산업 내에서 가장 낮은 생산원가를 달성하여 경쟁자보다 저렴한 가격으로 제품을 공급하거나 동일 가격에서 더 높은 마진을…","subcategory":"경영전략·마케팅이론","level":1,"related":["differentiation-strategy"],"prerequisites":[],"pop":19},{"slug":"differentiation-strategy","title_ko":"차별화전략","title_en":"Differentiation Strategy","meaning":"제품이나 서비스에 고객이 가치 있다고 인식하는 독특한 속성을 부여하여 경쟁자와 차별화함으로써 가격 프리미엄을 확보하는 본원적…","subcategory":"경영전략·마케팅이론","level":1,"related":["cost-leadership-strategy"],"prerequisites":[]},{"slug":"ge-mckinsey-matrix","title_ko":"GE맥킨지매트릭스","title_en":"GE-McKinsey Matrix","meaning":"제너럴일렉트릭과 맥킨지가 공동 개발한 사업포트폴리오 분석 도구로, 산업매력도와 사업경쟁력이라는 두 축을 각각 다차원 지표로…","subcategory":"경영전략·마케팅이론","level":1,"related":[],"prerequisites":[],"pop":4},{"slug":"eliminate-reduce-raise-create-grid","title_ko":"ERRC그리드","title_en":"Eliminate-Reduce-Raise-Create Grid","meaning":"블루오션전략에서 가치혁신을 실행하기 위한 분석 도구로, 업계의 기존 관행 중 제거할 요소, 감소시킬 요소, 증가시킬 요소…","subcategory":"경영전략·마케팅이론","level":2,"related":["strategy-canvas"],"prerequisites":["strategy-canvas"],"pop":12,"aliases":["ERRCG"]},{"slug":"strategy-canvas","title_ko":"전략캔버스","title_en":"Strategy Canvas","meaning":"블루오션전략에서 산업 내 경쟁요소들을 가로축에 놓고 각 요소에 대한 기업들의 제공수준을 세로축으로 시각화하여 현재의 경쟁…","subcategory":"경영전략·마케팅이론","level":1,"related":["eliminate-reduce-raise-create-grid"],"prerequisites":[]},{"slug":"vrin-framework","title_ko":"VRIN프레임워크","title_en":"VRIN Framework","meaning":"자원기반관점에서 지속가능한 경쟁우위를 제공하는 자원의 조건으로 가치성(Valuable), 희소성(Rare)…","subcategory":"경영전략·마케팅이론","level":2,"related":["core-competence","dynamic-capabilities"],"prerequisites":["core-competence","dynamic-capabilities"],"aliases":["VRIO"]},{"slug":"core-competence","title_ko":"기업 핵심역량","title_en":"Core Competence","meaning":"프라할라드와 하멜이 제시한 개념으로, 기업이 보유한 여러 기술과 지식이 결합되어 만들어진, 경쟁자가 쉽게 모방할 수 없고…","subcategory":"경영전략·마케팅이론","level":1,"related":["vrin-framework","dynamic-capabilities"],"prerequisites":[],"pop":16},{"slug":"dynamic-capabilities","title_ko":"동적역량","title_en":"Dynamic Capabilities","meaning":"티스가 제시한 개념으로, 급변하는 환경에 대응하여 기업이 내외부 자원과 역량을 지속적으로 통합, 구축, 재구성할 수 있는…","subcategory":"경영전략·마케팅이론","level":1,"related":["core-competence"],"prerequisites":[]},{"slug":"pest-analysis","title_ko":"PEST분석","title_en":"PEST Analysis","meaning":"기업을 둘러싼 거시환경을 정치적(Political), 경제적(Economic), 사회문화적(Social)…","subcategory":"경영전략·마케팅이론","level":2,"related":["tows-matrix"],"prerequisites":[],"aliases":["PESTEL분석"]},{"slug":"tows-matrix","title_ko":"TOWS매트릭스","title_en":"TOWS Matrix","meaning":"SWOT분석에서 도출한 강점, 약점, 기회, 위협 요인을 서로 교차시켜 SO전략, ST전략, WO전략, WT전략이라는…","subcategory":"경영전략·마케팅이론","level":2,"related":["pest-analysis"],"prerequisites":[],"pop":8},{"slug":"targeting-strategy","title_ko":"표적시장선정","title_en":"Targeting Strategy","meaning":"시장세분화를 통해 나눈 여러 세분시장 중 기업의 자원과 역량에 가장 적합하고 매력적인 세분시장을 선택하는 STP전략의 두…","subcategory":"경영전략·마케팅이론","level":2,"related":[],"prerequisites":[]},{"slug":"product-life-cycle","title_ko":"제품수명주기","title_en":"Product Life Cycle","meaning":"제품이 시장에 출시되어 소멸하기까지 도입기, 성장기, 성숙기, 쇠퇴기의 네 단계를 거친다는 마케팅 이론으로, 각 단계별로…","subcategory":"경영전략·마케팅이론","level":1,"related":[],"prerequisites":[]},{"slug":"outsourcing","title_ko":"아웃소싱","title_en":"Outsourcing","meaning":"기업이 내부에서 직접 수행하던 업무나 기능을 외부 전문업체에 위탁하여 처리함으로써 핵심역량에 자원을 집중하고 비용을…","subcategory":"경영전략·마케팅이론","level":2,"related":["core-competence","internalization-advantage","technology-transfer"],"prerequisites":["core-competence"],"aliases":["아웃소싱전략","Outsourcing Strategy"]},{"slug":"servqual-model","title_ko":"서브퀄모형","title_en":"SERVQUAL Model","meaning":"파라수라만 등이 개발한 서비스품질 측정 모형으로, 신뢰성, 확신성, 유형성, 공감성, 응대성의 다섯 가지 차원을 통해 고객의…","subcategory":"경영전략·마케팅이론","level":2,"related":["service-quality-gap-model"],"prerequisites":[],"pop":11},{"slug":"service-quality-gap-model","title_ko":"서비스품질갭모형","title_en":"Service Quality Gap Model","meaning":"고객이 기대하는 서비스 수준과 실제로 인식하는 서비스 수준 사이에 발생하는 다섯 가지 유형의 격차를 규명하여 서비스 품질을…","subcategory":"경영전략·마케팅이론","level":3,"r