],"prerequisites":[],"aliases":["신뢰성","Educational Evaluation","Reliability (Educational Evaluation)"]},{"slug":"clinical-trial","title_ko":"임상시험","title_en":"Clinical Trial","meaning":"새로운 치료법이나 약물의 효과와 안전성을 사람 대상으로 검증하는 연구입니다.","subcategory":"치료·약리","level":1,"related":["double-blind","biomarker","sensitivity-specificity"],"prerequisites":[]},{"slug":"double-blind","title_ko":"이중맹검","title_en":"Double-blind","meaning":"연구자와 참가자 모두 누가 실제 치료를 받는지 모르게 하는 임상시험 설계입니다.","subcategory":"치료·약리","level":1,"related":["clinical-trial"],"prerequisites":[],"aliases":["이중눈가림"]},{"slug":"social-desirability-bias","title_ko":"사회적바람직성편향","title_en":"Social Desirability Bias","meaning":"응답자가 실제 생각보다 사회적으로 바람직해 보이는 답을 하는 경향입니다.","subcategory":"심리측정","level":1,"related":["cognitive-bias","confirmation-bias","intervention"],"prerequisites":[],"aliases":["사회적 바람직성 편향"]},{"slug":"intervention","title_ko":"개입","title_en":"Intervention","meaning":"특정 결과를 바꾸기 위해 의도적으로 실시하는 처치나 프로그램입니다.","subcategory":"성격·임상심리","level":1,"related":["self-efficacy","social-desirability-bias","operant-conditioning","bystander-effect"],"prerequisites":[]},{"slug":"content-analysis","title_ko":"내용분석","title_en":"Content Analysis","meaning":"텍스트나 매체 내용을 체계적으로 범주화해 분석하는 연구 기법입니다.","subcategory":"사회학·사회구조","level":1,"related":["grounded-theory","qualitative-research","reliability","social-network-analysis"],"prerequisites":[]},{"slug":"grounded-theory","title_ko":"근거이론","title_en":"Grounded Theory","meaning":"데이터로부터 반복적으로 개념을 도출해 이론을 구축하는 질적연구 방법입니다.","subcategory":"사회학·사회구조","level":1,"related":["qualitative-research","content-analysis","thematic-analysis","game-theory","bootstrap-resampling"],"prerequisites":[],"aliases":["근거이론법"]},{"slug":"delphi-method","title_ko":"델파이기법","title_en":"Delphi Method","meaning":"익명의 전문가 집단에게 설문을 여러 차례 반복해 의견을 수렴하고 합의된 결론을 도출하는 조사 방법입니다.","subcategory":"데이터수집·표본","level":1,"related":["factor-analysis","triangulation","cross-sectional-study","internal-validity","data-saturation"],"prerequisites":[],"aliases":["델파이 기법"]},{"slug":"case-control-study","title_ko":"환자-대조군 연구","title_en":"Case-Control Study","meaning":"이미 특정 질병이 발생한 환자군과 발생하지 않은 대조군을 비교하여, 과거의 노출 요인에 어떤 차이가 있었는지 거슬러 조사하는…","subcategory":"역학·공중보건","level":1,"related":["cohort-study","odds-ratio","control-group","confounding-variable"],"prerequisites":[],"aliases":["환자대조군연구","환자 대조군연구","케이스컨트롤","환자대조연구"]},{"slug":"cronbachs-alpha","title_ko":"크론바흐 알파","title_en":"Cronbach's Alpha","meaning":"설문지나 척도를 이루는 여러 문항들이 같은 개념을 얼마나 일관되게 측정하는지를 0~1 사이의 숫자로 나타낸 지표입니다.","subcategory":"통계·분석도구","level":1,"related":["content-validity","reverse-coded-item","factor-loading","likert-scale","construct-validity"],"prerequisites":[],"pop":3,"aliases":["Cronbach's α","신뢰도계수 알파","신뢰도계수","크론바하알파"]},{"slug":"bootstrap-resampling","title_ko":"부트스트랩","title_en":"Bootstrap Resampling","meaning":"가지고 있는 표본 데이터에서 복원추출을 반복해 새로운 표본들을 만들어냄으로써, 통계량의 분포나 신뢰구간을 추정하는 방법입니다.","subcategory":"다변량·고급기법","level":1,"related":["grounded-theory","meta-analysis"],"prerequisites":[],"aliases":["부트스트래핑"]},{"slug":"quasi-experimental-design","title_ko":"준실험설계","title_en":"Quasi-Experimental Design","meaning":"참가자를 무작위로 배정하지 않은 상태에서 실험군과 비교집단을 비교하여 처치의 효과를 추정하는 연구 설계입니다.","subcategory":"연구설계","level":1,"related":["internal-validity"],"prerequisites":[],"aliases":["준실험연구","QED"]},{"slug":"thematic-analysis","title_ko":"주제분석","title_en":"Thematic Analysis","meaning":"인터뷰나 텍스트 같은 질적 자료를 반복해서 읽으며 그 안에서 되풀이되는 의미 있는 패턴(주제)을 찾아내고 정리하는 질적 분석…","subcategory":"질적연구","level":1,"related":["qualitative-research","grounded-theory","triangulation"],"prerequisites":[]},{"slug":"internal-validity","title_ko":"내적타당도","title_en":"internal validity","meaning":"연구에서 관찰된 결과 변화가 다른 요인이 아니라 정말로 연구자가 조작한 원인 때문에 생긴 것이라고 확신할 수 있는 정도입니다.","subcategory":"측정·타당도신뢰도","level":2,"related":["quasi-experimental-design","delphi-method","literature-review"],"prerequisites":[]},{"slug":"triangulation","title_ko":"삼각검증","title_en":"triangulation","meaning":"하나의 결론을 여러 자료원, 방법, 연구자로 교차 확인해서 결과의 신뢰도를 높이는 연구 전략입니다.","subcategory":"질적연구","level":1,"related":["mixed-methods","thematic-analysis","data-saturation","delphi-method"],"prerequisites":[],"aliases":["삼각측량법","방법론적 삼각검증","methodological triangulation","방법론적삼각검증","혼합방법 삼각검증","Mixed-methods Triangulation","혼합방법삼각검증"]},{"slug":"parallel-forms-reliability","title_ko":"동형검사 신뢰도","title_en":"Parallel-Forms Reliability","meaning":"같은 개념을 재도록 만든, 문항은 다르지만 난이도와 구조가 동등한 두 검사를 같은 사람에게 실시해 두 점수가 얼마나…","subcategory":"설문·척도","level":3,"related":["split-half-reliability","cronbachs-alpha","reliability"],"prerequisites":["split-half-reliability","reliability"],"aliases":["동형검사신뢰도"]},{"slug":"statistical-mediation-moderation","title_ko":"매개효과와 조절효과","title_en":"Mediation & Moderation Effect","meaning":"매개효과는 원인이 결과에 영향을 주는 경로 중간에 끼어 그 영향을 전달하는 제3의 변수의 역할이고, 조절효과는 원인과 결과…","subcategory":"다변량·고급기법","level":1,"related":["structural-equation-modeling","regression","confounding-variable","effect-size"],"prerequisites":[],"aliases":["매개변수","조절변수","매개-조절 분석","매개효과와조절효과"]},{"slug":"structural-equation-modeling","title_ko":"구조방정식모형","title_en":"Structural Equation Modeling","meaning":"눈에 보이지 않는 추상적 개념들을 여러 문항으로 측정하는 과정과, 그 개념들 간의 인과관계를 검증하는 과정을 하나의 모형…","subcategory":"다변량·고급기법","level":1,"related":["factor-analysis","statistical-mediation-moderation","construct-validity","r-squared"],"prerequisites":[],"aliases":["SEM","경로분석 확장모형"]},{"slug":"item-response-theory","title_ko":"문항반응이론","title_en":"Item Response Theory","meaning":"시험이나 설문의 각 문항이 응답자의 능력 수준에 따라 정답을 맞힐 확률이 어떻게 달라지는지를 수학적으로 모형화해, 문항…","subcategory":"다변량·고급기법","level":2,"related":["cronbachs-alpha","construct-validity","likert-scale","factor-analysis"],"prerequisites":[],"aliases":["IRT","문항특성곡선"]},{"slug":"homoscedasticity-heteroscedasticity","title_ko":"등분산성과 이분산성","title_en":"homoscedasticity & heteroscedasticity","meaning":"등분산성은 예측값 전체 구간에서 오차의 흩어진 정도(분산)가 일정한 것을, 이분산성은 그 흩어진 정도가 구간마다 달라지는…","subcategory":"회귀·상관분석","level":1,"related":["regression","multicollinearity","r-squared"],"prerequisites":[],"aliases":["등분산성과이분산성"]},{"slug":"ancova","title_ko":"공분산분석","title_en":"ANCOVA","meaning":"집단 간 평균 차이를 비교할 때, 결과에 영향을 줄 수 있는 다른 변수(공변량)의 효과를 통계적으로 먼저 제거한 뒤 비교하는…","subcategory":"추론통계·가설검정","level":2,"related":["anova","regression","control-group","statistical-mediation-moderation"],"prerequisites":["anova"]},{"slug":"data-logger","title_ko":"데이터 로거","title_en":"Data Logger","meaning":"사람이 옆에 없어도 센서로부터 들어오는 값을 정해진 시간 간격마다 자동으로 저장하는 장비입니다.","subcategory":"실험기기·측정장비","level":1,"related":["calibration-curve","measurement-uncertainty","instrument-calibration","standard-operating-procedure"],"prerequisites":[],"aliases":["DLI","Data Logging Instrument"]},{"slug":"focus-group-interview","title_ko":"표적집단면접(FGI)","title_en":"Focus Group Interview","meaning":"특정 주제에 대해 소수의 참가자들이 한자리에 모여 자유롭게 의견을 나누게 하고, 그 대화 속에서 나오는 반응을 분석하는 질적…","subcategory":"질적연구","level":2,"related":["qualitative-research","thematic-analysis","groupthink-ir","triangulation"],"prerequisites":["qualitative-research","thematic-analysis","triangulation"],"aliases":["FGI","포커스그룹 연구법","포커스그룹연구법","Focus Group Method"]},{"slug":"snowball-sampling","title_ko":"눈덩이표집","title_en":"Snowball Sampling","meaning":"이미 조사에 참여한 사람이 비슷한 특성을 가진 다른 사람을 소개해주는 방식으로 표본을 점점 불려나가는 표집 방법입니다.","subcategory":"데이터수집·표본","level":1,"related":["convenience-sampling","qualitative-research"],"prerequisites":[],"aliases":["눈덩이표본추출","누적표집"]},{"slug":"convenience-sampling","title_ko":"편의표집","title_en":"Convenience Sampling","meaning":"연구자가 접근하기 쉬운 대상을 표본으로 선택하는, 무작위성이 없는 표집 방법입니다.","subcategory":"데이터수집·표본","level":1,"related":["snowball-sampling"],"prerequisites":[],"aliases":["임의표집"]},{"slug":"participant-observation","title_ko":"참여관찰법","title_en":"Participant Observation","meaning":"연구자가 연구 대상 집단의 활동에 직접 참여하면서 현장에서 자료를 수집하는 질적 연구 방법입니다.","subcategory":"질적연구","level":1,"related":["qualitative-research","thematic-analysis","grounded-theory","focus-group-interview"],"prerequisites":[],"pop":20,"aliases":["참여관찰"]},{"slug":"mixed-effects-model","title_ko":"혼합효과모형","title_en":"Mixed-Effects Model","meaning":"모든 개체에 공통으로 적용되는 고정효과와, 개체나 집단마다 다르게 나타나는 무선효과(임의효과)를 함께 포함하는 통계모형입니다.","subcategory":"다변량·고급기법","level":1,"related":["panel-data","structural-equation-modeling","ancova"],"prerequisites":[],"aliases":["혼합모형","다층모형","hierarchical linear model"]},{"slug":"regression-to-the-mean","title_ko":"평균으로의 회귀","title_en":"Regression to the Mean","meaning":"극단적으로 높거나 낮은 측정값은 다시 측정하면 순전히 우연에 의해 평균에 더 가까운 값으로 돌아오는 경향을 말합니다.","subcategory":"연구설계","level":2,"related":["internal-validity","quasi-experimental-design"],"prerequisites":["quasi-experimental-design"],"aliases":["평균회귀","평균으로 회귀","regression toward the mean","평균으로의회귀"]},{"slug":"multitrait-multimethod-matrix","title_ko":"다중특성-다중방법 행렬","title_en":"Multitrait-Multimethod Matrix","meaning":"여러 개념을 여러 방법으로 동시에 측정한 뒤, 그 상관관계들을 한 표로 정리해 수렴·판별타당도를 함께 검증하는 방법입니다.","subcategory":"통계·분석도구","level":3,"related":["convergent-validity","discriminant-validity","construct-validity","composite-reliability"],"prerequisites":["composite-reliability"],"aliases":["MTMM","다중특성-다중방법행렬","다중특성 다중방법 행렬","다중특성다중방법 행렬"]},{"slug":"response-rate","title_ko":"응답률","title_en":"Response Rate","meaning":"설문이나 조사에 참여하도록 요청받은 사람 중 실제로 응답을 완료한 사람의 비율입니다.","subcategory":"통계·분석도구","level":2,"related":["sample-size","pilot-study"],"prerequisites":["pilot-study"],"aliases":["회수율","응답 비율"]},{"slug":"ethnography","title_ko":"민족지학","title_en":"ethnography","meaning":"연구자가 특정 집단의 생활 현장에 장기간 몸담으며 그들의 문화와 행동 방식을 있는 그대로 기록하고 해석하는 질적 연구…","subcategory":"질적연구","level":1,"related":["participant-observation","grounded-theory","triangulation"],"prerequisites":[],"aliases":["에스노그라피","문화기술지"]},{"slug":"action-research","title_ko":"실행연구","title_en":"action research","meaning":"연구자와 현장 당사자가 함께 문제를 진단하고, 개선책을 실행한 뒤, 그 결과를 다시 관찰하여 계획을 수정하는 과정을 반복하는…","subcategory":"질적연구","level":2,"related":["grounded-theory","participant-observation","mixed-methods"],"prerequisites":["participant-observation"],"aliases":["액션 리서치","현장연구"]},{"slug":"purposive-sampling","title_ko":"목적표집","title_en":"purposive sampling","meaning":"무작위로 뽑는 대신, 연구 목적에 가장 풍부한 정보를 줄 수 있다고 판단되는 대상을 연구자가 의도적으로 선정하는 표집…","subcategory":"데이터수집·표본","level":1,"related":["convenience-sampling","snowball-sampling"],"prerequisites":[],"pop":7,"aliases":["의도적 표집","판단표집"]},{"slug":"ecological-fallacy","title_ko":"생태학적 오류","title_en":"Ecological Fallacy","meaning":"집단 단위로 관찰된 통계적 관계를, 그 집단에 속한 개별 구성원에게도 똑같이 적용될 것이라 잘못 추론하는 오류입니다.","subcategory":"연구설계","level":1,"related":["internal-validity","cross-sectional-study","area-deprivation-index"],"prerequisites":[],"pop":2,"aliases":["생태학적 오류의 오류"]},{"slug":"attrition-bias","title_ko":"탈락편향","title_en":"attrition bias","meaning":"연구가 진행되는 동안 특정 성향의 참여자들이 유독 더 많이 중도 탈락하여, 마지막까지 남은 표본이 처음 모집단과 달라져…","subcategory":"연구설계","level":2,"related":["longitudinal-study","internal-validity","randomized-controlled-trial"],"prerequisites":["longitudinal-study","randomized-controlled-trial"],"aliases":["중도탈락편향","소모편향"]},{"slug":"phenomenology","title_ko":"현상학적 연구","title_en":"Phenomenology","meaning":"어떤 현상을 실제로 겪은 사람들의 생생한 체험을 깊이 들여다봐서, 그 경험의 본질적인 의미가 무엇인지 밝히려는 질적 연구…","subcategory":"질적연구","level":1,"related":["grounded-theory","ethnography","positionality-of-researcher","autoethnography"],"prerequisites":[],"aliases":["현상학","현상학적연구","phenomenological research"]},{"slug":"autoethnography","title_ko":"자문화기술지","title_en":"Autoethnography","meaning":"연구자 자신의 개인적 경험을 자료로 삼아, 그 경험을 통해 더 넓은 문화적·사회적 현상을 이해하려는 질적 연구 방법입니다.","subcategory":"질적연구","level":1,"related":["ethnography","positionality-of-researcher","phenomenology","participant-observation"],"prerequisites":[],"pop":6,"aliases":["자기문화기술지"]},{"slug":"non-response-bias","title_ko":"무응답편향","title_en":"Non-response Bias","meaning":"설문이나 조사에 응답하지 않은 사람들이 응답한 사람들과 체계적으로 다른 특성을 가지고 있어서, 조사 결과가 실제 모집단과…","subcategory":"데이터수집·표본","level":1,"related":["response-rate","attrition-bias","sample-size"],"prerequisites":[],"aliases":["비응답편향","NRB"]},{"slug":"external-validity","title_ko":"외적타당도","title_en":"External Validity","meaning":"한 연구에서 얻은 결과를 그 연구에 참여하지 않은 다른 사람, 다른 장소, 다른 시점에도 적용할 수 있는 정도를 뜻합니다.","subcategory":"측정·타당도신뢰도","level":2,"related":["internal-validity","sample-size","quasi-experimental-design"],"prerequisites":[],"aliases":["일반화가능성"]},{"slug":"q-methodology","title_ko":"Q방법론","title_en":"Q Methodology","meaning":"참여자가 여러 진술문을 자신의 관점에 따라 순위대로 배열하게 한 뒤 요인분석으로 공유된 관점 유형을 찾아내는 연구방법이다.","subcategory":"질적연구","level":3,"related":["mixed-methods","purposive-sampling","triangulation","external-validity"],"prerequisites":["triangulation"],"pop":8,"aliases":["Q분류","Q-sort"]},{"slug":"think-aloud-protocol","title_ko":"사고구술법","title_en":"Think-Aloud Protocol","meaning":"참여자가 과제를 수행하는 동안 머릿속 생각을 실시간으로 소리 내어 말하게 하여 사고 과정을 자료로 수집하는 방법이다.","subcategory":"데이터수집·표본","level":1,"related":["participant-observation","focus-group-interview"],"prerequisites":[],"aliases":["발화구술법","프로토콜 분석"]},{"slug":"counterbalancing","title_ko":"역균형화","title_en":"Counterbalancing","meaning":"같은 참여자가 여러 조건을 모두 경험하는 실험에서 조건을 겪는 순서를 참여자마다 다르게 배치해 순서 효과를 상쇄시키는…","subcategory":"연구설계","level":1,"related":["internal-validity"],"prerequisites":[],"aliases":["순서균형화","라틴방격"]},{"slug":"recall-bias","title_ko":"회상편향","title_en":"Recall Bias","meaning":"참여자가 과거 경험을 회상해 응답할 때 현재 상태에 따라 기억의 정확도나 상세함이 체계적으로 달라져 생기는 편향이다.","subcategory":"데이터수집·표본","level":1,"related":["non-response-bias","attrition-bias","internal-validity"],"prerequisites":[],"aliases":["기억편향"]},{"slug":"peer-debriefing","title_ko":"동료검토","title_en":"Peer Debriefing","meaning":"질적 연구자가 자신의 해석과 분석 과정을 연구에 참여하지 않은 동료 연구자에게 점검받아 편향을 줄이고 연구의 신뢰성을 높이는…","subcategory":"질적연구","level":2,"related":["positionality-of-researcher","data-saturation"],"prerequisites":["positionality-of-researcher"],"aliases":["피어 디브리핑"]},{"slug":"convergent-parallel-design","title_ko":"수렴적 병렬설계","title_en":"Convergent Parallel Design","meaning":"양적 자료와 질적 자료를 동시에 독립적으로 수집·분석한 뒤 두 결과를 비교·통합하여 하나의 현상을 종합적으로 이해하는…","subcategory":"연구설계","level":1,"related":["mixed-methods","explanatory-sequential-design","triangulation"],"prerequisites":[],"aliases":["동시병렬설계","수렴적병렬설계"]},{"slug":"explanatory-sequential-design","title_ko":"설명적 순차설계","title_en":"Explanatory Sequential Design","meaning":"먼저 양적 자료를 수집·분석한 뒤, 그 결과를 더 깊이 설명하기 위해 질적 자료를 추가로 수집하는 2단계 혼합연구 설계입니다.","subcategory":"연구설계","level":1,"related":["mixed-methods","convergent-parallel-design","quasi-experimental-design"],"prerequisites":[],"aliases":["설명적 순차 설계","설명적순차설계"]},{"slug":"prisma-statement","title_ko":"프리즈마 성명","title_en":"PRISMA Statement","meaning":"체계적 문헌고찰과 메타분석 논문을 투명하고 재현 가능하게 보고하도록 만든 국제 표준 체크리스트 및 흐름도입니다.","subcategory":"출판·저작권","level":1,"related":["strobe-statement","consort-statement"],"prerequisites":[],"aliases":["PRISMA","PRISMA 2020","프리즈마성명"]},{"slug":"strobe-statement","title_ko":"스트로브 성명","title_en":"STROBE Statement","meaning":"코호트, 환자대조군, 단면연구 같은 관찰연구를 무엇을 어떻게 보고해야 하는지 정한 국제 보고 기준입니다.","subcategory":"출판·저작권","level":1,"related":["prisma-statement","consort-statement"],"prerequisites":[],"aliases":["STROBE","관찰연구 보고기준","스트로브성명"]},{"slug":"scoping-review","title_ko":"스코핑 리뷰","title_en":"Scoping Review","meaning":"특정 주제에 대해 어떤 연구가 얼마나, 어떤 방식으로 이루어졌는지 그 범위와 유형, 빈 구멍(연구 공백)을 넓게 지도처럼…","subcategory":"문헌연구·메타분석","level":1,"related":["literature-review","umbrella-review","prisma-statement"],"prerequisites":[],"pop":10,"aliases":["범위 문헌고찰","스코핑리뷰"]},{"slug":"umbrella-review","title_ko":"엄브렐라 리뷰","title_en":"Umbrella Review","meaning":"개별 연구가 아니라 이미 발표된 여러 체계적 문헌고찰과 메타분석들을 다시 한번 모아서 종합하는, 리뷰들의 리뷰입니다.","subcategory":"문헌연구·메타분석","level":1,"related":["meta-analysis","scoping-review","prisma-statement"],"prerequisites":[],"aliases":["메타개관연구","엄브렐라리뷰"]},{"slug":"discourse-analysis","title_ko":"담화분석","title_en":"Discourse Analysis","meaning":"사람들이 말이나 글을 통해 세상과 관계, 권력을 어떻게 구성하고 표현하는지, 어떻게 왜 그렇게 말했는가를 분석하는 질적 연구…","subcategory":"질적연구","level":2,"related":["content-analysis","thematic-analysis","qualitative-research","positionality-of-researcher"],"prerequisites":["thematic-analysis","qualitative-research","positionality-of-researcher"],"aliases":["비판적 담화분석"]},{"slug":"nominal-group-technique","title_ko":"명목집단기법","title_en":"Nominal Group Technique","meaning":"여러 전문가나 참여자가 한자리에 모이되, 먼저 각자 조용히 의견을 적고 그다음 순서대로 발표한 뒤 투표로 우선순위를 정하는…","subcategory":"데이터수집·표본","level":2,"related":["delphi-method","focus-group-interview","q-methodology"],"prerequisites":["delphi-method"],"pop":11,"aliases":["NGT"]},{"slug":"vignette-method","title_ko":"비네트기법","title_en":"Vignette Method","meaning":"참여자에게 짧은 가상의 상황이나 인물 이야기를 제시한 뒤, 그 상황에서 어떻게 판단하거나 행동할지를 묻는 자료수집 방법입니다.","subcategory":"데이터수집·표본","level":2,"related":["social-desirability-bias","q-methodology"],"prerequisites":[],"pop":18,"aliases":["비네트연구"]},{"slug":"bracketing","title_ko":"브래키팅","title_en":"Bracketing","meaning":"연구자가 자신의 기존 지식, 가정, 선입견을 의도적으로 괄호 안에 넣어 잠시 접어두고, 참여자의 경험 그 자체를 있는 그대로…","subcategory":"질적연구","level":1,"related":["phenomenology","positionality-of-researcher","qualitative-research"],"prerequisites":[],"aliases":["판단중지"]},{"slug":"photovoice","title_ko":"포토보이스","title_en":"Photovoice","meaning":"참여자가 직접 카메라를 들고 자신의 삶이나 지역사회를 찍은 사진을 통해 자기 경험을 이야기하게 하는 참여적 질적 연구…","subcategory":"질적연구","level":3,"related":["action-research","participant-observation","qualitative-research"],"prerequisites":["action-research","participant-observation","qualitative-research"],"aliases":["사진목소리기법"]},{"slug":"coreq","title_ko":"COREQ 체크리스트","title_en":"COREQ","meaning":"인터뷰나 포커스그룹 등 질적 연구 결과를 투명하게 보고하도록 만든 32개 항목의 국제 보고 지침입니다.","subcategory":"출판·저작권","level":2,"related":["qualitative-research","focus-group-interview"],"prerequisites":[],"aliases":["COREQ","Consolidated criteria for Reporting Qualitative research","COREQ체크리스트"]},{"slug":"netnography","title_ko":"네트노그라피(넷노그라피)","title_en":"Netnography","meaning":"온라인 커뮤니티, SNS, 게시판 등 인터넷 공간에서 사람들의 대화와 행동을 관찰하여 문화와 소비 행태를 연구하는 질적 연구…","subcategory":"질적연구","level":3,"related":["qualitative-research","content-analysis","grounded-theory"],"prerequisites":["qualitative-research"],"aliases":["넷노그라피"]},{"slug":"document-analysis","title_ko":"문헌분석","title_en":"Document Analysis","meaning":"보고서·공문서·회의록·언론기사 등 이미 존재하는 문서를 체계적으로 검토하여 그 안에 담긴 맥락과 의미를 해석하는 연구…","subcategory":"질적연구","level":2,"related":["content-analysis","qualitative-research","triangulation"],"prerequisites":["qualitative-research","triangulation"],"aliases":["문서분석"]},{"slug":"semi-structured-interview","title_ko":"반구조화 면접","title_en":"Semi-Structured Interview","meaning":"미리 정한 핵심 질문 목록(면접 가이드)을 바탕으로 하되, 응답에 따라 질문의 순서와 표현을 유연하게 바꿔가며 진행하는 면접…","subcategory":"데이터수집·표본","level":1,"related":["focus-group-interview","qualitative-research","data-saturation"],"prerequisites":[],"aliases":["면접 가이드","반구조화면접"]},{"slug":"experimental-design","title_ko":"실험설계","title_en":"Experimental Design","meaning":"연구자가 독립변수를 의도적으로 조작하고 나머지 조건은 최대한 통제하여, 그 조작이 결과에 미치는 영향을 인과적으로 밝히기…","subcategory":"연구설계","level":1,"related":["randomized-controlled-trial","quasi-experimental-design","control-group"],"prerequisites":[]},{"slug":"structured-observation","title_ko":"구조화된 관찰법","title_en":"Structured Observation","meaning":"관찰할 행동의 종류와 기록 방식을 미리 정해 놓고, 그 기준에 따라 체계적으로 행동을 관찰하고 기록하는 연구 방법입니다.","subcategory":"데이터수집·표본","level":2,"related":["content-analysis"],"prerequisites":[],"aliases":["구조화된관찰법"]},{"slug":"quota-sampling","title_ko":"할당표집","title_en":"Quota Sampling","meaning":"성별, 연령 등 특성별로 채워야 할 인원수(할당량)를 미리 정해두고, 그 안에서는 무작위 없이 편한 대상을 채워 넣는 표집…","subcategory":"데이터수집·표본","level":3,"related":["convenience-sampling"],"prerequisites":["convenience-sampling"],"aliases":["할당표본추출"]},{"slug":"pico-framework","title_ko":"PICO 프레임워크","title_en":"PICO Framework","meaning":"임상 연구 질문을 환자(Population), 중재(Intervention), 비교(Comparison)…","subcategory":"문헌연구·메타분석","level":2,"related":["literature-review","randomized-controlled-trial"],"prerequisites":["literature-review"],"pop":9,"aliases":["PICO프레임워크"]},{"slug":"systematic-sampling","title_ko":"계통표집","title_en":"Systematic Sampling","meaning":"전체 명단에서 첫 번째 대상만 무작위로 뽑고, 그 뒤부터는 일정한 간격을 두고 순서대로 표본을 뽑는 표집 방법입니다.","subcategory":"데이터수집·표본","level":3,"related":[],"prerequisites":[],"aliases":["계통표본추출"]},{"slug":"n-of-1-trial","title_ko":"N-of-1 시험","title_en":"N-of-1 Trial","meaning":"한 명의 환자를 대상으로 치료법 A와 B(또는 위약)를 여러 차례 번갈아 적용해 그 개인에게 어떤 치료가 더 효과적인지…","subcategory":"연구설계","level":3,"related":["randomized-controlled-trial","double-blind","clinical-trial"],"prerequisites":["randomized-controlled-trial"],"aliases":["N of 1 시험","N-of-1시험","Nof1 시험"]},{"slug":"in-depth-interview","title_ko":"심층면접","title_en":"In-depth Interview","meaning":"한 사람과 충분한 시간을 두고 대화하며 그 사람의 경험과 생각을 깊이 있게 탐색하는 질적 자료 수집 방법입니다.","subcategory":"데이터수집·표본","level":1,"related":["semi-structured-interview","focus-group-interview","qualitative-research","thematic-analysis"],"prerequisites":[],"aliases":["심층인터뷰"]},{"slug":"open-coding","title_ko":"개방코딩","title_en":"Open Coding","meaning":"면접이나 관찰로 얻은 질적 자료를 문장이나 단락 단위로 잘게 쪼개어 각 부분에 이름(코드)을 붙이는, 근거이론 분석의 첫…","subcategory":"질적연구","level":1,"related":["grounded-theory","data-saturation","content-analysis"],"prerequisites":[]},{"slug":"hypothesis","title_ko":"가설","title_en":"Hypothesis","meaning":"아직 옳은지 틀린지 확인되지 않았지만, 근거를 바탕으로 미리 세워보는 \"이럴 것이다\"라는 잠정적인 예상입니다.","subcategory":"연구설계","level":1,"related":["null-hypothesis","independent-variable","dependent-variable","experimental-design"],"prerequisites":[]},{"slug":"independent-variable","title_ko":"독립변인","title_en":"Independent Variable","meaning":"연구자가 결과에 어떤 영향을 주는지 확인하기 위해 일부러 바꾸거나 다르게 설정하는 원인 쪽 변수입니다.","subcategory":"연구설계","level":1,"related":["dependent-variable","controlled-variable","hypothesis","experimental-design"],"prerequisites":[],"aliases":["독립변수"]},{"slug":"dependent-variable","title_ko":"종속변인","title_en":"Dependent Variable","meaning":"독립변인의 변화에 따라 실제로 달라지는지를 관찰하고 측정하는, 결과 쪽 변수입니다.","subcategory":"연구설계","level":1,"related":["independent-variable","controlled-variable","hypothesis"],"prerequisites":[],"aliases":["종속변수"]},{"slug":"controlled-variable","title_ko":"통제변인","title_en":"Controlled Variable","meaning":"결과에 영향을 줄 수 있지만, 실험이 공정하게 이뤄지도록 일부러 모든 조건에서 똑같이 맞춰 놓는 변수입니다.","subcategory":"연구설계","level":2,"related":["independent-variable","dependent-variable","experimental-design"],"prerequisites":["independent-variable","dependent-variable"],"aliases":["통제변수"]},{"slug":"axial-coding","title_ko":"축코딩","title_en":"Axial Coding","meaning":"개방코딩으로 흩어놓은 개념들을 원인, 맥락, 결과 등의 관계로 다시 이어 붙여 하나의 축을 중심으로 재구성하는 근거이론…","subcategory":"질적연구","level":1,"related":["open-coding","grounded-theory","data-saturation"],"prerequisites":[]},{"slug":"power-analysis","title_ko":"검정력분석","title_en":"Power Analysis","meaning":"연구를 시작하기 전에 원하는 검정력을 확보하려면 표본크기가 얼마나 필요한지, 효과크기와 유의수준을 바탕으로 미리 계산하는…","subcategory":"데이터수집·표본","level":3,"related":["statistical-power","effect-size","sample-size","significance-level"],"prerequisites":[]},{"slug":"trustworthiness","title_ko":"질적연구 신뢰성 확보 기준","title_en":"Trustworthiness","meaning":"질적연구의 결과를 믿을 만하다고 판단하기 위해 제시된 신빙성, 전이가능성, 의존가능성, 확인가능성이라는 네 가지 기준입니다.","subcategory":"질적연구","level":1,"related":["triangulation","peer-debriefing"],"prerequisites":[],"aliases":["질적연구신뢰성확보기준","질적연구의 신뢰성 기준","질적연구의신뢰성기준","TQR","trustworthiness in qualitative research"]},{"slug":"within-subjects-design","title_ko":"피험자내설계","title_en":"Within-Subjects Design","meaning":"같은 참가자가 모든 실험 조건을 순서대로 모두 경험하도록 하여 비교하는 실험설계입니다.","subcategory":"연구설계","level":2,"related":[],"prerequisites":[]},{"slug":"unit-of-analysis","title_ko":"분석단위","title_en":"Unit of Analysis","meaning":"연구에서 실제로 측정하고 분석하는 대상이 개인인지, 집단인지, 사건인지를 정하는 기준입니다.","subcategory":"연구설계","level":2,"related":[],"prerequisites":[]},{"slug":"emic-etic-perspective","title_ko":"에믹-에틱 관점","title_en":"Emic-Etic Perspective","meaning":"연구 대상 집단의 구성원이 자신의 언어와 개념으로 세상을 이해하는 방식(에믹)과, 연구자가 외부의 학문적 틀과 비교 기준으로…","subcategory":"질적연구","level":2,"related":["ethnography","grounded-theory","thematic-analysis"],"prerequisites":["ethnography","thematic-analysis"],"pop":19,"aliases":["에믹 에틱 관점","에믹-에틱관점","에믹에틱 관점"]},{"slug":"hierarchical-regression","title_ko":"위계적 회귀분석","title_en":"Hierarchical Regression","meaning":"독립변수들을 연구자가 정한 이론적 순서에 따라 여러 단계로 나누어 투입하면서, 각 단계에서 설명력(R²)이 얼마나…","subcategory":"회귀·상관분석","level":2,"related":["regression","r-squared","statistical-mediation-moderation","multicollinearity"],"prerequisites":["regression","r-squared","multicollinearity"],"pop":1,"aliases":["위계적회귀분석"]},{"slug":"stratified-randomization","title_ko":"층화무작위배정","title_en":"Stratified Randomization","meaning":"결과에 큰 영향을 줄 만한 특성(성별, 나이대 등)별로 참가자를 먼저 나눈 뒤, 그 안에서 각각 무작위로 배정하는 방법입니다.","subcategory":"연구설계","level":3,"related":["confounding-variable"],"prerequisites":[]},{"slug":"conversation-analysis","title_ko":"대화분석","title_en":"Conversation Analysis","meaning":"실제 대화를 아주 세밀하게 녹음·전사하여 말차례 주고받기, 침묵, 겹침 발화 같은 상호작용의 규칙성을 분석하는 질적 연구…","subcategory":"질적연구","level":3,"related":["discourse-analysis","ethnography"],"prerequisites":["discourse-analysis","ethnography"]},{"slug":"time-sampling","title_ko":"시간표집법","title_en":"Time Sampling","meaning":"관찰 대상 행동을 미리 정해둔 시간 간격마다 순간적으로 확인하여, 그 시점에 행동이 나타나는지 여부를 기록하는 관찰…","subcategory":"설문·척도","level":2,"related":["structured-observation"],"prerequisites":[]},{"slug":"equivalence-testing","title_ko":"동등성 검정","title_en":"Equivalence Testing","meaning":"두 처치나 조건의 효과 차이가 실제로 무시할 수 있을 만큼 작다는 것을 통계적으로 확인하기 위해 사용하는 가설검정 방법입니다.","subcategory":"추론통계·가설검정","level":3,"related":["p-value","power-analysis","sample-size","effect-size"],"prerequisites":["p-value","effect-size"],"aliases":["동등성검정"]},{"slug":"proxy-variable","title_ko":"대리변수","title_en":"Proxy Variable","meaning":"직접 측정하기 어렵거나 불가능한 변수를, 그것과 밀접하게 관련되어 있어 대신 측정할 수 있는 다른 변수로 바꿔 사용하는 것을…","subcategory":"측정·타당도신뢰도","level":3,"related":["construct-validity","instrumental-variable","confounding-variable"],"prerequisites":[],"aliases":["프록시변수"]},{"slug":"mixed-design","title_ko":"혼합설계","title_en":"Mixed Design","meaning":"서로 다른 참가자에게 각각 다른 조건을 배정하는 요인과, 같은 참가자가 모든 조건을 다 겪게 하는 요인을 한 연구 안에 함께…","subcategory":"연구설계","level":3,"related":["within-subjects-design"],"prerequisites":["within-subjects-design"],"aliases":["혼합요인설계"]},{"slug":"cohort-sequential-design","title_ko":"코호트순차설계","title_en":"Cohort-Sequential Design","meaning":"서로 다른 연령의 여러 코호트를 동시에 뽑아 일정 기간 함께 추적함으로써, 실제 추적 기간보다 훨씬 긴 발달 구간을 짧은…","subcategory":"연구설계","level":2,"related":[],"prerequisites":[]},{"slug":"internal-consistency-reliability","title_ko":"내적일관성 신뢰도","title_en":"Internal Consistency Reliability","meaning":"하나의 척도를 이루는 여러 문항들이 실제로 같은 개념을 일관되게 측정하고 있는지를 나타내는 신뢰도입니다.","subcategory":"측정·타당도신뢰도","level":3,"related":["cronbachs-alpha","split-half-reliability"],"prerequisites":[],"pop":13,"aliases":["내적일관성신뢰도"]},{"slug":"post-hoc-test","title_ko":"사후검정","title_en":"Post-hoc Test","meaning":"세 집단 이상을 비교하는 검정에서 \"어딘가에 차이가 있다\"는 결과가 나온 뒤, 구체적으로 어느 집단과 어느 집단 사이에…","subcategory":"연구설계","level":3,"related":["anova","multiple-comparisons-correction"],"prerequisites":[],"aliases":["사후분석"]},{"slug":"nonequivalent-control-group-design","title_ko":"비동등 통제집단 설계","title_en":"Nonequivalent Control Group Design","meaning":"무작위 배정 없이 이미 존재하는 두 집단을 각각 실험집단과 통제집단으로 삼아 개입 전후를 비교하는 준실험설계입니다.","subcategory":"연구설계","level":3,"related":["internal-validity","difference-in-differences"],"prerequisites":[],"aliases":["NCGD"]},{"slug":"picot-framework","title_ko":"피코트 프레임워크 (PICOT Framework)","title_en":"PICOT Framework","meaning":"연구질문을 대상(P), 중재(I), 비교(C), 결과(O), 기간(T)의 다섯 요소로 쪼개어 명확하고 검증 가능하게 다듬는…","subcategory":"문헌연구·메타분석","level":3,"related":["pico-framework","spider-framework","hypothesis"],"prerequisites":["pico-framework"],"aliases":["피코트 프레임워크","피코트프레임워크","피코트프레임워크(PICOTFramework)"]},{"slug":"spider-framework","title_ko":"스파이더 프레임워크 (SPIDER Framework)","title_en":"Spider Framework","meaning":"질적연구나 혼합연구의 연구질문과 문헌검색 전략을 표본(S), 관심현상(PI), 설계(D), 평가(E), 연구유형(R)의 다섯…","subcategory":"문헌연구·메타분석","level":3,"related":["picot-framework","qualitative-research","thematic-analysis"],"prerequisites":[],"aliases":["스파이더 프레임워크","스파이더프레임워크","스파이더프레임워크(SPIDERFramework)"]},{"slug":"hermeneutic-phenomenology","title_ko":"해석학적 현상학","title_en":"Hermeneutic Phenomenology","meaning":"참여자의 경험을 있는 그대로 기술하는 데 그치지 않고, 연구자의 해석을 통해 그 경험의 의미를 적극적으로 이해하려는 현상학적…","subcategory":"질적연구","level":2,"related":["phenomenology","bracketing"],"prerequisites":["phenomenology","bracketing"],"aliases":["해석학적현상학"]},{"slug":"criterion-sampling","title_ko":"준거표집","title_en":"Criterion Sampling","meaning":"연구자가 미리 정해 둔 특정 기준(준거)을 만족하는 사례만 골라서 표본으로 삼는 목적표본추출 방법입니다.","subcategory":"데이터수집·표본","level":1,"related":["purposive-sampling"],"prerequisites":[],"aliases":["준거표본추출"]},{"slug":"credibility","title_ko":"신빙성","title_en":"Credibility","meaning":"질적연구에서 도출된 해석과 결론이 참여자가 실제로 경험한 현실을 얼마나 진실하게 담아냈는지를 판단하는 신뢰성 확보 기준입니다.","subcategory":"질적연구","level":2,"related":["trustworthiness","triangulation"],"prerequisites":["trustworthiness","triangulation"]},{"slug":"survivorship-bias","title_ko":"생존자편향","title_en":"Survivorship Bias","meaning":"성공하거나 살아남은 대상만 관찰하고 실패해서 사라진 대상은 빠뜨려서, 현실을 실제보다 낙관적으로 왜곡해 해석하는 오류입니다.","subcategory":"데이터수집·표본","level":3,"related":["attrition-bias","recall-bias"],"prerequisites":["recall-bias"],"pop":4,"aliases":["생존편향"]},{"slug":"abductive-reasoning","title_ko":"가추법","title_en":"Abductive Reasoning","meaning":"뜻밖의 관찰 결과를 마주쳤을 때, \"만약 이것이 사실이라면 이 관찰을 가장 잘 설명할 수 있는 가설은 무엇일까\"를 추론해…","subcategory":"질적연구","level":1,"related":["grounded-theory"],"prerequisites":[],"aliases":["가설추론"]},{"slug":"data-saturation","title_ko":"자료포화","title_en":"Data Saturation","meaning":"질적 연구에서 자료를 더 수집해도 더 이상 새로운 주제나 정보가 나오지 않는 시점을 말합니다.","subcategory":"질적연구","level":3,"related":["purposive-sampling","grounded-theory"],"prerequisites":[],"aliases":["포화(자료포화)","saturation (data saturation)","포화","이론적포화","theoretical saturation","이론포화"]},{"slug":"homogeneous-sampling","title_ko":"동질적 표집","title_en":"Homogeneous Sampling","meaning":"특정 특성을 공유하는 매우 유사한 대상들만 선택해서 그 하위집단을 깊이 있게 탐구하는 목적표집 전략입니다.","subcategory":"데이터수집·표본","level":3,"related":["purposive-sampling","criterion-sampling"],"prerequisites":["purposive-sampling","criterion-sampling"],"aliases":["동질적표집"]},{"slug":"sample-size-calculation","title_ko":"표본크기산출","title_en":"Sample Size Calculation","meaning":"연구에서 통계적으로 의미 있는 결과를 검출하는 데 필요한 최소한의 참여자 수를 연구 설계 단계에서 미리 계산하는 절차.","subcategory":"역학·공중보건","level":2,"related":["non-inferiority-trial"],"prerequisites":[],"aliases":["표본수산정","표본크기계산"]},{"slug":"instrument-calibration","title_ko":"계측기 교정","title_en":"Instrument Calibration","meaning":"측정기기의 출력값을 공인된 표준과 비교하여 오차를 확인하고 보정하는 절차.","subcategory":"측정·타당도신뢰도","level":1,"related":["measurement-uncertainty"],"prerequisites":[],"aliases":["계측기교정"]},{"slug":"replication-study","title_ko":"반복연구","title_en":"Replication Study","meaning":"기존 연구와 동일하거나 유사한 방법을 사용해 같은 결과가 재현되는지 독립적으로 다시 검증하는 연구.","subcategory":"재현성·오픈사이언스","level":1,"related":["meta-analysis"],"prerequisites":[],"aliases":["복제연구","재현연구"]},{"slug":"retrospective-prospective-design","title_ko":"후향적·전향적 설계","title_en":"Retrospective vs Prospective Design","meaning":"후향적 설계는 이미 발생한 과거 자료를 거슬러 분석하는 방식이고, 전향적 설계는 시작 시점부터 미래를 향해 자료를 수집해…","subcategory":"연구설계","level":2,"related":["internal-validity"],"prerequisites":[],"pop":15,"aliases":["RVPD","후향적 전향적 설계","후향적·전향적설계","후향적전향적 설계"]},{"slug":"standard-operating-procedure","title_ko":"표준작업절차서","title_en":"Standard Operating Procedure (SOP)","meaning":"특정 실험이나 업무를 누가 수행하더라도 동일한 방식으로 진행할 수 있도록 절차를 단계별로 문서화한 지침.","subcategory":"재현성·오픈사이언스","level":2,"related":["instrument-calibration"],"prerequisites":[]},{"slug":"cohen-kappa","title_ko":"코헨의 카파","title_en":"Cohen's Kappa","meaning":"두 평가자의 범주형 판단이 우연히 일치할 가능성을 감안하고도 실제로 얼마나 일치하는지를 나타내는 통계치.","subcategory":"측정·타당도신뢰도","level":3,"related":["content-validity","intraclass-correlation-coefficient"],"prerequisites":[],"pop":12,"aliases":["카파계수","코헨카파"]},{"slug":"double-blind-procedure","title_ko":"이중맹검법","title_en":"Double-blind Procedure","meaning":"연구 참가자와 처치를 제공하거나 평가하는 연구자 양쪽 모두 어떤 참가자가 어떤 조건에 배정되었는지 모르게 하는 실험 절차.","subcategory":"연구설계","level":1,"related":["randomized-controlled-trial"],"prerequisites":[],"aliases":["더블블라인드"]},{"slug":"randomized-controlled-trial","title_ko":"무작위대조시험","title_en":"Randomized Controlled Trial (RCT)","meaning":"참가자를 무작위로 처치군과 대조군에 배정하여 처치의 효과를 비교하는, 인과관계 검증에 가장 강력한 실험연구 설계.","subcategory":"연구설계","level":1,"related":["double-blind-procedure","internal-validity"],"prerequisites":[]},{"slug":"gage-r-and-r","title_ko":"게이지 반복성·재현성 연구","title_en":"Gage R&R (Repeatability and Reproducibility)","meaning":"측정 시스템에서 발생하는 변동 중 같은 사람이 같은 대상을 반복 측정할 때 생기는 변동(반복성)과 서로 다른 사람이 측정할…","subcategory":"측정·타당도신뢰도","level":2,"related":["measurement-uncertainty","instrument-calibration"],"prerequisites":["instrument-calibration"],"pop":17,"aliases":["게이지 반복성 재현성 연구","게이지 반복성재현성 연구","게이지반복성·재현성연구"]},{"slug":"nomological-network","title_ko":"법칙적 관계망","title_en":"nomological network","meaning":"하나의 구성개념이 이론적으로 관련된 다른 개념들과 어떤 관계를 맺는지를 체계적으로 나타낸 망 구조로, 구성타당도 검증의…","subcategory":"측정·타당도신뢰도","level":1,"related":["convergent-validity","discriminant-validity"],"prerequisites":[],"aliases":["법칙적관계망"]},{"slug":"positionality-of-researcher","title_ko":"연구자의 위치성","title_en":"positionality of the researcher","meaning":"연구자가 지닌 사회적 위치(성별, 인종, 계급, 문화적 배경 등)가 연구 대상 및 참여자와의 관계, 자료 해석에 미치는…","subcategory":"질적연구","level":3,"related":["trustworthiness"],"prerequisites":["trustworthiness"],"aliases":["연구자 성찰성","Reflexivity","연구자성찰성","자기성찰성","연구자 위치성","Researcher Positionality","연구자위치성","성찰성(질적연구)"]},{"slug":"bayesian-frequentist-inference-debate","title_ko":"베이지안-빈도주의 추론 논쟁","title_en":"Bayesian vs frequentist inference debate","meaning":"확률을 사건의 장기적 빈도로 해석하고 가설검정과 신뢰구간을 사용하는 빈도주의 통계와, 확률을 믿음의 정도로 해석하고…","subcategory":"연구설계","level":3,"related":["equivalence-testing"],"prerequisites":[],"aliases":["BVFID","베이지안 빈도주의 추론 논쟁","베이지안-빈도주의추론논쟁","베이지안빈도주의 추론 논쟁"]},{"slug":"construct-underrepresentation","title_ko":"구성개념 과소대표","title_en":"construct underrepresentation","meaning":"측정도구가 원래 의도한 구성개념의 중요한 측면이나 차원을 충분히 포괄하지 못하고 일부만 좁게 담아내는 문제를 말한다.","subcategory":"측정·타당도신뢰도","level":2,"related":["construct-irrelevant-variance","nomological-network"],"prerequisites":["nomological-network"],"aliases":["구성개념과소대표"]},{"slug":"construct-irrelevant-variance","title_ko":"구성개념 무관분산","title_en":"construct-irrelevant variance","meaning":"측정 점수의 변화가 측정하고자 하는 구성개념과 무관한 다른 요인(예: 읽기능력, 검사불안, 응답 형식 등)에 의해 발생하는…","subcategory":"측정·타당도신뢰도","level":2,"related":["construct-underrepresentation","social-desirability-bias"],"prerequisites":[],"aliases":["구성개념무관분산"]}]