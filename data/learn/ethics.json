[{"slug":"peer-review","title_ko":"동료심사","title_en":"Peer Review","meaning":"같은 분야 전문가들이 논문의 질과 타당성을 검토하는 출판 전 절차.","subcategory":"출판·저작권","level":1,"related":["literature-review","confirmation-bias"],"prerequisites":[],"pop":11,"aliases":["동료평가","Peer Review in Archaeology"]},{"slug":"conflict-of-interest","title_ko":"이해상충","title_en":"Conflict of Interest","meaning":"연구자의 개인적 이익이나 관계가 연구의 객관성이나 판단에 영향을 줄 수 있는 상황을 말합니다.","subcategory":"이해상충·데이터관리","level":1,"related":["retraction"],"prerequisites":[],"aliases":["COI"]},{"slug":"retraction","title_ko":"논문철회","title_en":"Retraction","meaning":"출판된 논문에 심각한 오류나 부정행위가 발견되어 학술지가 그 논문을 공식적으로 무효라고 선언하는 것입니다.","subcategory":"출판·저작권","level":1,"related":["conflict-of-interest","data-fabrication"],"prerequisites":[],"aliases":["논문 철회"]},{"slug":"data-fabrication","title_ko":"연구자료 위조·변조","title_en":"data fabrication/falsification","meaning":"실제로 존재하지 않는 데이터를 지어내거나(위조), 실제 데이터를 원하는 결과에 맞게 임의로 바꾸는(변조) 행위입니다.","subcategory":"연구윤리 원칙","level":1,"related":["retraction"],"prerequisites":[],"pop":5,"aliases":["데이터 위조","데이터 조작","연구자료 위조 변조","연구자료 위조변조","연구자료위조·변조"]},{"slug":"questionable-research-practices","title_ko":"의심스러운 연구관행","title_en":"Questionable Research Practices","meaning":"데이터를 조작하거나 표절하는 명백한 부정행위는 아니지만, 연구 결과를 유리하게 보이도록 만드는 여러 편법적인 연구 관행을…","subcategory":"연구윤리 원칙","level":1,"related":["dual-use-research"],"prerequisites":[],"aliases":["QRP","의심스러운연구관행"]},{"slug":"corresponding-author","title_ko":"교신저자","title_en":"corresponding author","meaning":"논문 투고와 심사 과정의 연락을 책임지고, 출판 후에도 논문 내용에 대한 문의에 답할 책임을 지는 저자입니다.","subcategory":"출판·저작권","level":1,"related":[],"prerequisites":[],"pop":1,"aliases":["책임저자"]},{"slug":"paper-mill","title_ko":"페이퍼밀","title_en":"Paper Mill","meaning":"돈을 받고 가짜 데이터나 표절한 내용을 조합해 학술논문을 대량으로 만들어 판매하는 조직입니다.","subcategory":"출판·저작권","level":1,"related":[],"prerequisites":[],"pop":18,"aliases":["논문공장"]},{"slug":"dual-use-research","title_ko":"이중용도 연구","title_en":"Dual-Use Research","meaning":"원래는 공익을 위한 연구지만 그 결과가 악용될 경우 심각한 피해를 초래할 수 있는 지식이나 기술을 만들어내는 연구입니다.","subcategory":"연구윤리 원칙","level":1,"related":["questionable-research-practices"],"prerequisites":[],"aliases":["DURC","DUR","이중용도연구","이중용도 기술"]},{"slug":"utilitarianism-vs-deontology","title_ko":"공리주의와 의무론","title_en":"Utilitarianism vs. Deontology","meaning":"공리주의는 행위의 \"결과\"(전체 행복의 총량)로 옳고 그름을 판단하고, 의무론은 결과와 상관없이 지켜야 할 \"원칙과 의무\"로…","subcategory":"연구윤리 원칙","level":1,"related":[],"prerequisites":[],"pop":13,"aliases":["공리주의 의무론","UVD","공리주의와의무론"]},{"slug":"three-rs-principle","title_ko":"동물실험 3R 원칙","title_en":"Three Rs Principle","meaning":"동물실험을 설계할 때 동물 사용을 대체하고, 줄이고, 고통을 개선하도록 해야 한다는 세 가지 원칙입니다.","subcategory":"임상·인간대상연구윤리","level":1,"related":[],"prerequisites":[],"pop":2,"aliases":["3R 원칙","대체 감소 개선","Replacement Reduction Refinement","동물실험3R원칙","3Rs Framework","3R원칙"]},{"slug":"impact-factor-h-index","title_ko":"임팩트팩터와 h-지수","title_en":"Journal Impact Factor & h-index","meaning":"임팩트팩터는 학술지가, h-지수는 연구자 개인이 얼마나 많이 인용되는지를 숫자 하나로 요약한 지표입니다.","subcategory":"출판·저작권","level":1,"related":["corresponding-author"],"prerequisites":[],"pop":16,"aliases":["IF","임팩트팩터와 h 지수","임팩트팩터와 h지수","임팩트팩터와h-지수"]},{"slug":"credit-taxonomy","title_ko":"CRediT 저자 기여도 분류체계","title_en":"CRediT Taxonomy","meaning":"논문의 각 저자가 연구 과정에서 구체적으로 어떤 역할을 맡았는지 표준화된 항목으로 명시하는 국제 분류 체계입니다.","subcategory":"출판·저작권","level":1,"related":["corresponding-author"],"prerequisites":[],"aliases":["CRediT","CRediT저자기여도분류체계"]},{"slug":"open-peer-review","title_ko":"오픈 피어리뷰","title_en":"Open Peer Review","meaning":"심사자와 저자의 신원을 서로 공개하거나 심사 의견 자체를 논문과 함께 출판해, 동료심사 과정을 투명하게 공개하는 방식입니다.","subcategory":"출판·저작권","level":1,"related":["peer-review"],"prerequisites":[],"pop":6,"aliases":["개방형 동료심사","공개 심사","OPR","오픈피어리뷰"]},{"slug":"erratum-corrigendum","title_ko":"정정논문","title_en":"Erratum & Corrigendum","meaning":"이미 출판된 논문에서 발견된 사소한 오류나 누락 사항을, 핵심 결론은 그대로 둔 채 저자나 학술지가 공식적으로 바로잡아…","subcategory":"출판·저작권","level":2,"related":["retraction","data-fabrication"],"prerequisites":["retraction"],"pop":17,"aliases":["정오표","정정문","코리젠덤"]},{"slug":"harking","title_ko":"사후가설수립","title_en":"HARKing","meaning":"데이터를 분석해 결과를 이미 알고 난 뒤에, 마치 처음부터 그 결과를 예측한 것처럼 가설을 새로 써서 논문에 싣는 관행입니다.","subcategory":"연구윤리 원칙","level":1,"related":["questionable-research-practices"],"prerequisites":[],"pop":12,"aliases":["Hypothesizing After the Results are Known","사후 가설 수립","결과 후 가설 설정"]},{"slug":"consort-statement","title_ko":"콘소트 성명","title_en":"CONSORT Statement","meaning":"무작위대조시험 논문이 연구 과정을 빠짐없이 투명하게 보고하도록 만든 표준 체크리스트입니다.","subcategory":"출판·저작권","level":1,"related":["randomized-controlled-trial"],"prerequisites":[],"aliases":["CONSORT","Consolidated Standards of Reporting Trials","콘소트 지침","콘소트성명"]},{"slug":"data-safety-monitoring-board","title_ko":"자료안전성 모니터링 위원회","title_en":"Data Safety Monitoring Board","meaning":"임상시험이 진행되는 동안 참가자의 안전과 중간 결과를 연구팀과 독립적으로 검토해, 시험을 계속할지 중단할지를 권고하는 전문가…","subcategory":"임상·인간대상연구윤리","level":1,"related":["consort-statement"],"prerequisites":[],"pop":14,"aliases":["DSMB","데이터모니터링위원회","Data Monitoring Committee","자료안전성모니터링위원회"]},{"slug":"belmont-report","title_ko":"벨몬트 보고서","title_en":"Belmont Report","meaning":"인간 대상 연구가 지켜야 할 세 가지 핵심 윤리원칙(인격 존중, 선행, 정의)을 정리한 1979년 미국의 기초 문서입니다.","subcategory":"임상·인간대상연구윤리","level":1,"related":["tuskegee-syphilis-study"],"prerequisites":[],"aliases":["벨몬트 리포트","벨몬트보고서"]},{"slug":"nuremberg-code","title_ko":"뉘른베르크 강령","title_en":"Nuremberg Code","meaning":"인체실험은 반드시 참여자의 자발적 동의가 있어야 한다고 못 박은, 1947년에 만들어진 최초의 인간 대상 연구윤리 원칙입니다.","subcategory":"임상·인간대상연구윤리","level":2,"related":["belmont-report","tuskegee-syphilis-study"],"prerequisites":["belmont-report","tuskegee-syphilis-study"],"pop":9,"aliases":["뉘른베르크 코드","뉘른베르크강령"]},{"slug":"tuskegee-syphilis-study","title_ko":"터스키기 매독 연구","title_en":"Tuskegee Syphilis Study","meaning":"1932~1972년 미국 공중보건국이 흑인 매독 환자들에게 치료제가 있음을 알고도 40년간 알리지 않고 병의 자연경과만…","subcategory":"임상·인간대상연구윤리","level":1,"related":["belmont-report"],"prerequisites":[],"aliases":["터스키기 실험","터스키기매독연구"]},{"slug":"ingelfinger-rule","title_ko":"잉겔핑거 원칙","title_en":"Ingelfinger Rule","meaning":"이미 언론 보도나 다른 경로로 대중에게 공개된 연구 결과는 학술지가 정식 논문으로 다시 게재하지 않는다는 전통적인 편집…","subcategory":"출판·저작권","level":3,"related":["peer-review"],"prerequisites":["peer-review"],"aliases":["잉겔핑거 규칙","잉겔핑거원칙"]},{"slug":"he-jiankui-affair","title_ko":"허젠쿠이 사건","title_en":"He Jiankui Affair","meaning":"2018년 중국의 허젠쿠이 박사가 유전자가위(CRISPR) 기술로 배아의 유전자를 편집해 세계 최초의 '유전자 편집 아기'를…","subcategory":"임상·인간대상연구윤리","level":2,"related":["nuremberg-code","dual-use-research"],"prerequisites":[],"pop":19,"aliases":["CRISPR 아기 사건","유전자 편집 아기 사건","He Jiankui scandal","HJA","허젠쿠이사건"]},{"slug":"havasupai-diabetes-project","title_ko":"하바수파이 당뇨병 프로젝트 사건","title_en":"Havasupai Diabetes Project","meaning":"1990년대 애리조나주립대 연구진이 하바수파이 부족으로부터 제2형 당뇨병 연구 목적으로 채취한 혈액 시료를 원래 동의받지…","subcategory":"임상·인간대상연구윤리","level":3,"related":[],"prerequisites":[],"aliases":["하바수파이 사건","Havasupai Tribe case","하바수파이당뇨병프로젝트사건"]},{"slug":"diederik-stapel-scandal","title_ko":"디데릭 스타펠 사건","title_en":"Diederik Stapel Scandal","meaning":"네덜란드의 사회심리학자 디데릭 스타펠이 2011년 실제로 실험을 수행하지 않고 처음부터 데이터를 지어내 수십 편의 논문을…","subcategory":"연구윤리 원칙","level":1,"related":["harking"],"prerequisites":[],"aliases":["스타펠 사건","Stapel scandal","디데릭스타펠사건"]},{"slug":"wakefield-mmr-scandal","title_ko":"웨이크필드 MMR 백신 사건","title_en":"Wakefield MMR Vaccine Scandal","meaning":"1998년 앤드루 웨이크필드가 MMR 백신과 자폐증의 연관성을 조작된 데이터로 주장해 논문이 철회되고 의사 면허가 박탈된…","subcategory":"연구윤리 원칙","level":3,"related":["data-fabrication","retraction","conflict-of-interest"],"prerequisites":["data-fabrication"],"aliases":["웨이크필드 사건","MMR 백신 스캔들","WMVS","웨이크필드MMR백신사건"]},{"slug":"schon-scandal","title_ko":"얀 헨드릭 쇤 사건","title_en":"Jan Hendrik Schön Scandal","meaning":"벨 연구소의 물리학자 얀 헨드릭 쇤이 2000년대 초 반도체 관련 데이터를 대량으로 조작해 발표 논문이 전원 철회된 사건.","subcategory":"연구윤리 원칙","level":3,"related":["data-fabrication","retraction"],"prerequisites":["data-fabrication"],"pop":3,"aliases":["쇤 사건","벨 연구소 조작 사건","JHSS","얀헨드릭쇤사건"]},{"slug":"authorship-order-convention","title_ko":"저자 순서 관행","title_en":"Authorship Order Convention","meaning":"논문 저자 목록 순서를 정하는 방식으로, 분야마다 기여도순·알파벳순·교신저자 배치 등 서로 다른 관행을 따른다.","subcategory":"출판·저작권","level":2,"related":["corresponding-author","credit-taxonomy"],"prerequisites":["corresponding-author","credit-taxonomy"],"aliases":["저자 배열 관행","저자순서관행"]},{"slug":"grim-test","title_ko":"GRIM 테스트","title_en":"GRIM Test","meaning":"보고된 평균값이 표본 크기와 정수 데이터로 계산 가능한지를 역산해 통계적으로 불가능한 값을 찾아내는 데이터 위조 탐지 기법.","subcategory":"연구윤리 원칙","level":1,"related":["data-fabrication"],"prerequisites":[],"aliases":["Granularity-Related Inconsistency of Means","GRIM테스트"]},{"slug":"macchiarini-scandal","title_ko":"마키아리니 사건","title_en":"Macchiarini Scandal","meaning":"스웨덴 카롤린스카 연구소의 외과의사 파올로 마키아리니가 인공 기관 이식 수술의 성공률을 부풀리고 다수의 환자를 사망에 이르게…","subcategory":"임상·인간대상연구윤리","level":3,"related":[],"prerequisites":[],"aliases":["마키아리니사건"]},{"slug":"willowbrook-hepatitis-study","title_ko":"윌로우브룩 간염 연구","title_en":"Willowbrook Hepatitis Study","meaning":"1950~60년대 미국 윌로우브룩 주립학교의 지적장애 아동들에게 살아있는 간염 바이러스를 의도적으로 감염시켜 진행한 연구로…","subcategory":"임상·인간대상연구윤리","level":3,"related":["tuskegee-syphilis-study","belmont-report"],"prerequisites":["tuskegee-syphilis-study"],"pop":4,"aliases":["WHS","윌로우브룩간염연구"]},{"slug":"prisma-statement","title_ko":"프리즈마 성명","title_en":"PRISMA Statement","meaning":"체계적 문헌고찰과 메타분석 논문을 투명하고 재현 가능하게 보고하도록 만든 국제 표준 체크리스트 및 흐름도입니다.","subcategory":"출판·저작권","level":1,"related":["strobe-statement","consort-statement"],"prerequisites":[],"pop":7,"aliases":["PRISMA","PRISMA 2020","프리즈마성명"]},{"slug":"strobe-statement","title_ko":"스트로브 성명","title_en":"STROBE Statement","meaning":"코호트, 환자대조군, 단면연구 같은 관찰연구를 무엇을 어떻게 보고해야 하는지 정한 국제 보고 기준입니다.","subcategory":"출판·저작권","level":1,"related":["prisma-statement","consort-statement"],"prerequisites":[],"pop":8,"aliases":["STROBE","관찰연구 보고기준","스트로브성명"]},{"slug":"tripod-statement","title_ko":"트리포드 성명","title_en":"TRIPOD Statement","meaning":"질병 위험도나 예후를 예측하는 통계·머신러닝 모델을 개발하거나 검증한 연구를 투명하게 보고하도록 안내하는 지침입니다.","subcategory":"출판·저작권","level":2,"related":["strobe-statement"],"prerequisites":["strobe-statement"],"aliases":["TRIPOD","Transparent Reporting of a multivariable prediction model","예측모델 보고 지침","트리포드성명"]},{"slug":"expression-of-concern","title_ko":"우려표명","title_en":"Expression of Concern","meaning":"논문에 문제가 있다는 의혹은 제기되었지만 아직 철회할 만큼 조사가 끝나지 않았을 때, 저널이 독자에게 주의를 알리기 위해…","subcategory":"출판·저작권","level":1,"related":["retraction","erratum-corrigendum"],"prerequisites":[],"aliases":["EoC","우려 표명","잠정 경고"]},{"slug":"cyril-burt-scandal","title_ko":"시릴 버트 사건","title_en":"Cyril Burt Scandal","meaning":"영국 심리학자 시릴 버트가 따로 자란 일란성 쌍둥이의 지능(IQ)이 유전에 의해 결정된다는 연구에서 데이터와 공동연구자를…","subcategory":"연구윤리 원칙","level":3,"related":["data-fabrication","diederik-stapel-scandal"],"prerequisites":["data-fabrication","diederik-stapel-scandal"],"pop":10,"aliases":["시릴 버트 스캔들","Burt affair","쌍둥이 IQ 조작 의혹","시릴버트사건"]},{"slug":"coreq","title_ko":"COREQ 체크리스트","title_en":"COREQ","meaning":"인터뷰나 포커스그룹 등 질적 연구 결과를 투명하게 보고하도록 만든 32개 항목의 국제 보고 지침입니다.","subcategory":"출판·저작권","level":2,"related":["qualitative-research","focus-group-interview"],"prerequisites":[],"pop":15,"aliases":["COREQ","Consolidated criteria for Reporting Qualitative research","COREQ체크리스트"]},{"slug":"single-irb","title_ko":"단일 IRB 심의제도","title_en":"single IRB","meaning":"여러 기관이 함께 참여하는 다기관 연구에서 각 기관이 따로 심의받는 대신 하나의 대표 IRB가 전체를 심의하도록 하는…","subcategory":"임상·인간대상연구윤리","level":2,"related":["clinical-trial"],"prerequisites":[],"aliases":["single IRB","sIRB","단일 IRB","단일IRB심의제도"]},{"slug":"data-trust","title_ko":"데이터 신탁","title_en":"Data Trust","meaning":"개인이나 기관이 자신의 데이터를 소유권은 유지한 채 독립적인 수탁기관에 맡기고, 그 수탁기관이 미리 합의된 규칙에 따라…","subcategory":"이해상충·데이터관리","level":1,"related":[],"prerequisites":[],"aliases":["데이터신탁"]},{"slug":"virtue-ethics","title_ko":"덕 윤리","title_en":"Virtue Ethics","meaning":"행위 자체의 옳고 그름보다 \"어떤 사람이 되어야 하는가\"에 초점을 맞춰, 정직·성실·신중함 같은 인격적 덕목의 실천을 윤리의…","subcategory":"연구윤리 원칙","level":1,"related":["utilitarianism-vs-deontology","autonomy-principle"],"prerequisites":[],"aliases":["덕윤리"]},{"slug":"autonomy-principle","title_ko":"자율성 존중의 원칙","title_en":"Principle of Respect for Autonomy","meaning":"연구참여자가 스스로 정보를 이해하고 판단하여 참여 여부를 자유롭게 결정할 권리를 존중해야 한다는 생명윤리의 핵심 원칙입니다.","subcategory":"임상·인간대상연구윤리","level":1,"related":["belmont-report"],"prerequisites":[],"aliases":["자율성존중의원칙"]},{"slug":"technology-transfer-conflict-of-interest","title_ko":"기술이전 이해상충","title_en":"Conflict of Interest in Technology Transfer","meaning":"연구자가 자신의 연구 성과를 특허나 창업으로 상업화하는 과정에서 얻는 개인적 금전적 이익이 연구의 객관성이나 동료·학생…","subcategory":"이해상충·데이터관리","level":2,"related":["conflict-of-interest"],"prerequisites":["conflict-of-interest"],"aliases":["기술이전이해상충"]},{"slug":"indirect-cost","title_ko":"간접비","title_en":"Indirect Cost","meaning":"특정 연구 과제에 직접 쓰이지는 않지만 그 연구를 수행할 수 있도록 기관을 운영하는 데 드는 비용을 충당하기 위해 연구비의…","subcategory":"이해상충·데이터관리","level":3,"related":["technology-transfer-conflict-of-interest"],"prerequisites":[],"pop":20},{"slug":"irb-reliance-agreement","title_ko":"IRB 상호인정협약","title_en":"IRB Reliance Agreement","meaning":"여러 기관이 함께 수행하는 다기관 연구에서, 각 기관이 따로 심의하지 않고 하나의 대표(중앙) IRB의 심의 결과를 서로…","subcategory":"임상·인간대상연구윤리","level":3,"related":[],"prerequisites":[],"aliases":["IRB상호인정협약"]},{"slug":"professional-engineering-code-of-ethics","title_ko":"전문직 엔지니어 윤리강령","title_en":"Professional Engineering Code of Ethics","meaning":"공학자가 공공의 안전·건강·복지를 최우선으로 여기고 정직하게 전문적 판단을 내리도록 규정한 직업윤리 규범입니다.","subcategory":"연구윤리 원칙","level":3,"related":["dual-use-research","conflict-of-interest"],"prerequisites":["dual-use-research"],"aliases":["PECE","전문직엔지니어윤리강령"]},{"slug":"invasive-vs-noninvasive-procedure","title_ko":"침습적·비침습적 처치 구분","title_en":"Invasive vs Non-Invasive Procedure","meaning":"동물의 신체 조직을 뚫거나 절개하는지 여부에 따라 실험 절차를 침습적 또는 비침습적으로 구분하는 분류.","subcategory":"임상·인간대상연구윤리","level":2,"related":[],"prerequisites":[],"aliases":["IVNIP","침습적 비침습적 처치 구분","침습적·비침습적처치구분","침습적비침습적 처치 구분"]},{"slug":"tunnel-handling-mice"