[{"slug":"dominant-chord","title_ko":"딸림화음","title_en":"Dominant Chord","meaning":"딸림화음은 조성의 다섯째 음(딸림음)을 근음으로 하는 화음으로, 으뜸화음으로의 해결을 강하게 지향하는 긴장의 화음이다.","subcategory":"화성학·음악형식론","level":1,"related":[],"prerequisites":[],"pop":17,"aliases":["도미넌트"]},{"slug":"perfect-authentic-cadence","title_ko":"완전정격종지","title_en":"Perfect Authentic Cadence","meaning":"완전정격종지는 V-I(또는 V7-I) 진행에서 두 화음이 모두 근음 위치이고 최상성부가 으뜸음으로 끝나는 가장 완결적인…","subcategory":"화성학·음악형식론","level":3,"related":["imperfect-authentic-cadence","dominant-chord"],"prerequisites":["dominant-chord"]},{"slug":"imperfect-authentic-cadence","title_ko":"불완전정격종지","title_en":"Imperfect Authentic Cadence","meaning":"불완전정격종지는 V-I 진행이지만 화음이 자리바꿈되었거나 최상성부가 으뜸음이 아닌 경우 성립하는, 완결감이 약한 정격종지이다.","subcategory":"화성학·음악형식론","level":3,"related":["perfect-authentic-cadence"],"prerequisites":[]},{"slug":"root-position-chord","title_ko":"근음위치화음","title_en":"Root Position Chord","meaning":"근음위치화음은 화음의 근음이 베이스에 놓인 가장 기본적인 배치로, 가장 안정적으로 들리는 형태이다.","subcategory":"화성학·음악형식론","level":2,"related":[],"prerequisites":[]},{"slug":"suspension","title_ko":"계류음","title_en":"Suspension","meaning":"계류음은 화음이 바뀔 때 이전 화음의 음이 그대로 남아 일시적으로 불협화를 이루었다가 순차 하행으로 해결되는 화성외음이다.","subcategory":"화성학·음악형식론","level":1,"related":[],"prerequisites":[],"pop":14},{"slug":"pedal-point","title_ko":"페달포인트","title_en":"Pedal Point","meaning":"페달포인트는 한 음(대개 베이스)이 지속되는 동안 그 위에서 다른 성부의 화성이 자유롭게 변화하는 기법이다.","subcategory":"화성학·음악형식론","level":2,"related":[],"prerequisites":[],"aliases":["보속음","지속음"]},{"slug":"secondary-dominant","title_ko":"부속화음","title_en":"Secondary Dominant","meaning":"부속화음은 원조의 딸림화음이 아니라 조성 내 다른 음도를 임시적 으뜸음으로 삼아 그것의 딸림화음처럼 기능하는 화음이다.","subcategory":"화성학·음악형식론","level":1,"related":[],"prerequisites":[],"pop":12,"aliases":["세컨더리도미넌트","이차딸림화음"]},{"slug":"neapolitan-sixth-chord","title_ko":"나폴리6화음","title_en":"Neapolitan Sixth Chord","meaning":"나폴리6화음은 낮춘 둘째 음도 위에 세운 장3화음의 첫째자리바꿈으로, 버금딸림기능을 하는 반음계적 화음이다.","subcategory":"화성학·음악형식론","level":3,"related":["dominant-chord"],"prerequisites":[],"aliases":["나폴리탄6화음"]},{"slug":"altered-dominant","title_ko":"얼터드도미넌트","title_en":"Altered Dominant","meaning":"얼터드도미넌트는 딸림화음의 5음이나 9음 등이 반음계적으로 변화되어 색채가 강화된 딸림화음이다.","subcategory":"화성학·음악형식론","level":3,"related":[],"prerequisites":[]},{"slug":"picardy-third","title_ko":"피카르디3도","title_en":"Picardy Third","meaning":"피카르디3도는 단조 곡의 마지막 으뜸화음에서 단3음 대신 장3음을 사용해 장3화음으로 종결하는 관습이다.","subcategory":"화성학·음악형식론","level":2,"related":[],"prerequisites":[],"pop":7},{"slug":"relative-key","title_ko":"나란한조","title_en":"Relative Key","meaning":"나란한조는 같은 조표를 공유하는 장조와 단조 한 쌍을 가리키며, 서로 단3도 관계의 으뜸음을 가진다.","subcategory":"화성학·음악형식론","level":1,"related":[],"prerequisites":[],"pop":8,"aliases":["관계조","평행조"]},{"slug":"diatonic-modulation","title_ko":"온음계적전조","title_en":"Diatonic Modulation","meaning":"온음계적전조는 두 조성에 공통으로 존재하는 온음계적 화음을 매개로 자연스럽게 이루어지는 전조 방식이다.","subcategory":"화성학·음악형식론","level":2,"related":[],"prerequisites":[]},{"slug":"hidden-fifths","title_ko":"은복5도","title_en":"Hidden Fifths","meaning":"은복5도는 두 성부가 같은 방향으로 도약하여 완전5도(또는 8도)에 도달하는 진행으로, 직접 병행하지는 않지만 유사한 문제로…","subcategory":"화성학·음악형식론","level":2,"related":[],"prerequisites":[],"aliases":["숨은5도"]},{"slug":"four-part-chorale-style","title_ko":"4성부합창양식","title_en":"Four-Part Chorale Style","meaning":"4성부합창양식은 소프라노·알토·테너·베이스 네 성부로 화성을 구성하는 표준적 작법으로, 화성학 학습의 기본 모델이다.","subcategory":"화성학·음악형식론","level":2,"related":[],"prerequisites":[]},{"slug":"diatonic-seventh-chords","title_ko":"다이아토닉7화음","title_en":"Diatonic Seventh Chords","meaning":"다이아토닉7화음은 온음계의 각 음도 위에 3도씩 쌓아 만든 일곱 종류의 4음 화음을 말한다.","subcategory":"화성학·음악형식론","level":1,"related":[],"prerequisites":[],"aliases":["온음계적7화음"]},{"slug":"diminished-triad","title_ko":"감3화음","title_en":"Diminished Triad","meaning":"감3화음은 근음, 단3도, 감5도로 구성되어 두 개의 단3도가 쌓인 불협화적 3화음이다.","subcategory":"화성학·음악형식론","level":2,"related":["diatonic-seventh-chords"],"prerequisites":["diatonic-seventh-chords"],"pop":1},{"slug":"octatonic-scale","title_ko":"옥타토닉음계","title_en":"Octatonic Scale","meaning":"옥타토닉음계는 온음과 반음이 교대로 반복되어 구성되는 8음 음계로, 감7화음과 밀접하게 연관된다.","subcategory":"화성학·음악형식론","level":3,"related":[],"prerequisites":[],"aliases":["8음음계"]},{"slug":"counterpoint","title_ko":"대위법","title_en":"Counterpoint","meaning":"대위법은 둘 이상의 독립적인 선율선이 동시에 결합하면서도 각각의 독자성과 조화를 함께 유지하도록 작곡하는 원리와 기법이다.","subcategory":"화성학·음악형식론","level":1,"related":["free-counterpoint","fugue"],"prerequisites":[],"aliases":["카운터포인트"]},{"slug":"free-counterpoint","title_ko":"자유대위법","title_en":"Free Counterpoint","meaning":"자유대위법은 엄격대위법의 규칙적 제약에서 벗어나 실제 작품에 가까운 리듬과 화성적 자유를 허용하는 대위법 작법이다.","subcategory":"화성학·음악형식론","level":2,"related":["counterpoint","fugue"],"prerequisites":["counterpoint","fugue"]},{"slug":"countermelody","title_ko":"대선율","title_en":"Countermelody","meaning":"대선율은 주선율과 동시에 진행되며 그것을 보완하고 대비를 이루는 독립적인 부차적 선율을 말한다.","subcategory":"화성학·음악형식론","level":3,"related":["counterpoint","free-counterpoint","countersubject"],"prerequisites":["counterpoint","free-counterpoint","countersubject"],"pop":5},{"slug":"fugue","title_ko":"푸가형식","title_en":"Fugue","meaning":"푸가는 하나의 주제가 여러 성부에서 모방적으로 제시되고 발전되는, 대위법적 원리에 기반한 정교한 다성 음악 형식이다.","subcategory":"화성학·음악형식론","level":1,"related":["fugue-answer","countersubject"],"prerequisites":[],"aliases":["푸가"]},{"slug":"fugue-answer","title_ko":"응답","title_en":"Answer (Fugue)","meaning":"응답은 푸가의 제시부에서 주제가 다른 성부에 의해 딸림조로 재현되는 부분을 말하며, 실음응답과 조성응답으로 구분된다.","subcategory":"화성학·음악형식론","level":3,"related":["fugue","countersubject"],"prerequisites":["fugue","countersubject"],"pop":13},{"slug":"countersubject","title_ko":"대주제","title_en":"Countersubject","meaning":"대주제는 푸가에서 응답이 제시되는 동안 주제를 먼저 부른 성부가 이어서 연주하는 대위적인 부차 선율이다.","subcategory":"화성학·음악형식론","level":2,"related":["fugue-answer","fugue","countermelody"],"prerequisites":["fugue"]},{"slug":"chaconne","title_ko":"샤콘느","title_en":"Chaconne","meaning":"샤콘느는 반복되는 화성 진행 패턴을 바탕으로 지속적인 변주가 전개되는 바로크 시대의 변주곡 형식으로, 파사칼리아와 밀접하게…","subcategory":"화성학·음악형식론","level":2,"related":["ostinato"],"prerequisites":[],"aliases":["샤콘"]},{"slug":"ostinato","title_ko":"오스티나토","title_en":"Ostinato","meaning":"오스티나토는 특정 리듬이나 선율 패턴이 곡의 한 구간 또는 전체에 걸쳐 집요하게 반복되는 작곡 기법이다.","subcategory":"화성학·음악형식론","level":2,"related":["chaconne","pedal-point"],"prerequisites":[],"pop":6},{"slug":"sonata-form","title_ko":"소나타형식","title_en":"Sonata Form","meaning":"소나타형식은 제시부, 발전부, 재현부의 세 부분으로 구성되며 조성적 대립과 그 해소를 구조적 원리로 삼는 고전주의의 대표적…","subcategory":"화성학·음악형식론","level":1,"related":["coda","sonata-rondo-form"],"prerequisites":[],"aliases":["소나타알레그로형식"]},{"slug":"coda","title_ko":"코다","title_en":"Coda","meaning":"코다는 곡이나 악장의 형식적 구조가 끝난 뒤 추가되는 종결부로, 조성적 안정을 확인하고 곡을 최종적으로 마무리하는 역할을…","subcategory":"화성학·음악형식론","level":1,"related":["sonata-form"],"prerequisites":[]},{"slug":"sonata-rondo-form","title_ko":"소나타론도형식","title_en":"Sonata Rondo Form","meaning":"소나타론도형식은 론도형식의 반복적 후렴 구조와 소나타형식의 조성적 대립·발전 원리가 결합된 혼합 형식이다.","subcategory":"화성학·음악형식론","level":3,"related":["sonata-form","coda"],"prerequisites":["sonata-form"],"pop":15},{"slug":"minuet-and-trio-form","title_ko":"미뉴에트트리오형식","title_en":"Minuet and Trio Form","meaning":"미뉴에트트리오형식은 미뉴에트-트리오-미뉴에트의 순서로 구성되는 겹세도막형식으로, 고전주의 교향곡과 실내악의 표준 악장…","subcategory":"화성학·음악형식론","level":2,"related":["scherzo","sonata-form"],"prerequisites":["sonata-form"],"pop":20,"aliases":["미뉴에트와 트리오","Minuet and Trio","미뉴에트와트리오"]},{"slug":"scherzo","title_ko":"스케르초","title_en":"Scherzo","meaning":"스케르초는 미뉴에트트리오형식의 구조를 계승하면서도 더 빠른 템포와 극적인 성격을 지니는 3박자 계열의 악장 형식이다.","subcategory":"화성학·음악형식론","level":3,"related":["minuet-and-trio-form","sonata-form","coda"],"prerequisites":["minuet-and-trio-form"],"pop":2},{"slug":"cadenza","title_ko":"카덴차","title_en":"Cadenza","meaning":"카덴차는 협주곡의 재현부 끝 부분 등에서 오케스트라가 멈추고 독주자가 화려한 기교로 자유롭게(또는 즉흥적으로) 연주하는…","subcategory":"화성학·음악형식론","level":3,"related":["coda"],"prerequisites":[],"pop":16},{"slug":"ritornello-form","title_ko":"리토르넬로형식","title_en":"Ritornello Form","meaning":"리토르넬로형식은 바로크 협주곡에서 관현악의 반복되는 주제(리토르넬로)와 독주자의 자유로운 삽입구(에피소드)가 교대로 나타나는…","subcategory":"화성학·음악형식론","level":3,"related":[],"prerequisites":[],"pop":18},{"slug":"da-capo-aria","title_ko":"다카포아리아","title_en":"Da Capo Aria","meaning":"다카포아리아는 A-B-A 구조를 취하되 마지막 A부분을 악보에 다시 적지 않고 '처음부터(다카포)'라는 지시어로 대체하는…","subcategory":"화성학·음악형식론","level":3,"related":["ritornello-form","coda"],"prerequisites":[],"pop":9},{"slug":"neo-riemannian-theory","title_ko":"네오리만이론","title_en":"Neo-Riemannian Theory","meaning":"네오리만이론은 리만의 화성 이론에서 착안하여 3화음 사이의 변환 관계를 기하학적, 대수적으로 분석하는 20세기 후반의 화성…","subcategory":"화성학·음악형식론","level":3,"related":[],"prerequisites":[],"pop":10,"aliases":["신리만이론"]},{"slug":"strophic-form","title_ko":"스트로픽형식","title_en":"Strophic Form","meaning":"스트로픽형식은 하나의 동일한 선율이 가사만 바뀐 채 여러 절에 걸쳐 반복되는 성악곡의 형식이다.","subcategory":"화성학·음악형식론","level":3,"related":[],"prerequisites":[],"aliases":["유절형식"]},{"slug":"organum","title_ko":"오르가눔","title_en":"Organum","meaning":"그레고리오 성가 선율에 다른 성부를 더해 만든 중세 초기 다성음악 양식이다.","subcategory":"음악사·민족음악학","level":1,"related":["polyphony"],"prerequisites":[]},{"slug":"ars-nova","title_ko":"아르스 노바","title_en":"Ars Nova","meaning":"14세기 프랑스를 중심으로 발달한 새로운 리듬 및 기보 체계로, 리듬의 유연성과 세속음악의 비중이 커진 시기를 가리킨다.","subcategory":"음악사·민족음악학","level":1,"related":["cantus-firmus"],"prerequisites":[],"aliases":["아르스노바"]},{"slug":"musica-ficta","title_ko":"무지카 픽타","title_en":"Musica Ficta","meaning":"중세·르네상스 음악에서 악보에 명시되지 않았지만 관습적으로 반음을 올리거나 내려 연주하던 변화음 관행을 가리킨다.","subcategory":"음악사·민족음악학","level":3,"related":["counterpoint"],"prerequisites":[],"pop":19,"aliases":["무지카픽타"]},{"slug":"cantus-firmus","title_ko":"칸투스 피르무스","title_en":"Cantus Firmus","meaning":"다성음악 작곡에서 기존 선율(주로 성가)을 고정된 성부로 삼아 그 위에 다른 성부를 덧붙이는 작곡 기법 또는 그 정선율…","subcategory":"음악사·민족음악학","level":1,"related":["organum","polyphony"],"prerequisites":[],"aliases":["칸투스피르무스"]},{"slug":"basso-continuo","title_ko":"통주저음","title_en":"Basso Continuo","meaning":"바로크 음악에서 건반악기와 저음 악기가 곡 전체에 걸쳐 화성 반주를 지속적으로 제공하는 연주 관행이다.","subcategory":"음악사·민족음악학","level":2,"related":["concerto-grosso"],"prerequisites":[],"pop":4,"aliases":["계속저음","바소콘티누오"]},{"slug":"concerto-grosso","title_ko":"합주협주곡","title_en":"Concerto Grosso","meaning":"소규모 독주자군(콘체르티노)과 전체 합주단(리피에노)이 대비를 이루며 진행되는 바로크 시대의 협주곡 형식이다.","subcategory":"음악사·민족음악학","level":2,"related":["ritornello-form","basso-continuo"],"prerequisites":[],"aliases":["콘체르토그로소"]},{"slug":"romanticism-music","title_ko":"낭만주의 음악","title_en":"Romanticism in Music","meaning":"19세기 유럽 음악의 주류 양식으로, 개인의 감정 표현, 확장된 화성, 표제성, 민족적 소재를 강조한다.","subcategory":"음악사·민족음악학","level":1,"related":[],"prerequisites":[],"aliases":["낭만주의음악"]},{"slug":"leitmotif","title_ko":"라이트모티프","title_en":"Leitmotif","meaning":"특정 인물, 사물, 감정, 개념을 상징하는 짧은 음악적 동기로, 작품 전반에 걸쳐 변형되며 재등장한다.","subcategory":"음악사·민족음악학","level":2,"related":["gesamtkunstwerk"],"prerequisites":[],"pop":11,"aliases":["라이트모티브","유도동기"]},{"slug":"art-song-lied","title_ko":"예술가곡","title_en":"Art Song (Lied)","meaning":"시적 텍스트와 피아노 반주가 대등하게 결합된 독창곡 장르로, 특히 독일어권의 리트 전통을 중심으로 발전했다.","subcategory":"음악사·민족음악학","level":2,"related":["romanticism-music"],"prerequisites":["romanticism-music"],"aliases":["Lied"]},{"slug":"raga","title_ko":"라가","title_en":"Raga","meaning":"인도 고전음악에서 선율 진행의 규칙, 특정 음의 위계, 정서적 색채를 규정하는 선법적 틀을 가리킨다.","subcategory":"음악사·민족음악학","level":2,"related":[],"prerequisites":[]},{"slug":"call-and-response","title_ko":"콜 앤 리스폰스","title_en":"Call and Response","meaning":"한 사람(또는 그룹)이 선창하면 다른 사람(또는 그룹)이 이에 응답하는 방식으로 진행되는 음악적 대화 구조이다.","subcategory":"음악사·민족음악학","level":1,"related":[],"prerequisites":[],"pop":3,"aliases":["콜앤리스폰스","콜 앤 리스폰스(무용)"]},{"slug":"heterophony","title_ko":"헤테로포니","title_en":"Heterophony","meaning":"동일한 선율을 여러 연주자가 동시에 연주하되 각자 미세하게 다른 장식과 변주를 가하는 음악 조직 방식이다.","subcategory":"음악사·민족음악학","level":2,"related":["polyphony"],"prerequisites":[]},{"slug":"ragtime","title_ko":"래그타임","title_en":"Ragtime","meaning":"19세기 말~20세기 초 미국에서 유행한, 당김음(싱코페이션)을 특징으로 하는 피아노 중심의 대중음악 양식이다.","subcategory":"음악사·민족음악학","level":2,"related":[],"prerequisites":[],"aliases":["랙타임"]}]