[{"slug":"topology-optimization","title_ko":"위상최적화","title_en":"Topology Optimization","meaning":"정해진 공간과 하중 조건 안에서 재료를 어디에 남기고 어디를 비울지 컴퓨터가 스스로 찾아내는 설계 기법입니다.","subcategory":"기계·재료","level":1,"related":[],"prerequisites":[]},{"slug":"corrosion","title_ko":"부식","title_en":"Corrosion","meaning":"금속 등의 재료가 주변 환경과의 화학적·전기화학적 반응으로 서서히 손상되는 현상입니다.","subcategory":"기계·재료","level":1,"related":["redox-reaction"],"prerequisites":[]},{"slug":"actuator","title_ko":"액추에이터","title_en":"Actuator","meaning":"전기·유압·공압 등의 에너지를 받아 기계적인 움직임이나 힘으로 바꿔주는 장치입니다.","subcategory":"소프트웨어·제어","level":1,"related":["vibration-damping"],"prerequisites":[],"aliases":["구동기"]},{"slug":"vibration-damping","title_ko":"진동감쇠","title_en":"Vibration Damping","meaning":"진동하는 시스템에서 에너지를 흡수하거나 소산시켜 진폭을 점점 줄여나가는 현상, 또는 그렇게 만드는 설계 기법입니다.","subcategory":"기계·재료","level":1,"related":["actuator","piezoelectric-effect"],"prerequisites":[],"aliases":["진동댐핑"]},{"slug":"piezoelectric-effect","title_ko":"압전효과","title_en":"Piezoelectric Effect","meaning":"특정 결정체나 세라믹에 힘을 가하면 전기가 발생하고, 반대로 전기를 가하면 모양이 변하는 성질입니다.","subcategory":"전기전자","level":2,"related":["vibration-damping"],"prerequisites":[]},{"slug":"thermal-conductivity","title_ko":"열전도율","title_en":"Thermal Conductivity","meaning":"어떤 물질이 열을 얼마나 잘 전달하는지를 나타내는 값입니다.","subcategory":"기계·재료","level":1,"related":[],"prerequisites":[],"aliases":["열전도도"]},{"slug":"specific-heat","title_ko":"비열","title_en":"Specific Heat","meaning":"어떤 물질 1g의 온도를 1℃ 높이는 데 필요한 열량으로, 물질마다 고유하게 다른 값을 가집니다.","subcategory":"열역학","level":1,"related":["thermal-conductivity"],"prerequisites":[],"aliases":["비열용량","Specific Heat Capacity"]},{"slug":"fmea","title_ko":"고장모드영향분석","title_en":"FMEA","meaning":"제품이나 공정에서 일어날 수 있는 모든 고장 방식을 미리 나열하고, 그 심각도·발생빈도·검출난이도를 점수화해 가장 시급히…","subcategory":"산업·시스템","level":1,"related":["root-cause-analysis"],"prerequisites":[],"pop":16,"aliases":["고장모드 및 영향분석","DFMEA","Disaster Failure Mode and Effects Analysis"]},{"slug":"root-cause-analysis","title_ko":"근본원인분석","title_en":"Root Cause Analysis","meaning":"문제나 사고가 일어났을 때 겉으로 드러난 증상이 아니라, 그 문제를 실제로 일으킨 근본 원인을 끝까지 추적해 찾아내는 분석…","subcategory":"산업·시스템","level":1,"related":["fmea"],"prerequisites":[],"aliases":["원인분석","5Why 분석","DRCA","Disaster Root Cause Analysis"]},{"slug":"buckling","title_ko":"좌굴","title_en":"Buckling","meaning":"가늘고 긴 기둥이나 판이 압축하중을 받을 때, 재료가 부서지기 전에 옆으로 휘어지며 갑자기 무너지는 현상입니다.","subcategory":"기계·재료","level":1,"related":["power-factor"],"prerequisites":[],"aliases":["좌굴현상","buckling"]},{"slug":"power-factor","title_ko":"역률","title_en":"Power Factor","meaning":"교류 전기회로에서 공급된 전력 중 실제로 유용하게 쓰이는 전력의 비율을 나타내는 값입니다.","subcategory":"전기전자","level":1,"related":["buckling"],"prerequisites":[],"aliases":["power factor","PF"]},{"slug":"force-equilibrium","title_ko":"힘의 평형","title_en":"force equilibrium","meaning":"물체에 작용하는 여러 힘의 합이 0이 되어, 물체가 정지해 있거나 일정한 속도로 계속 운동하는 상태를 말합니다.","subcategory":"역학·에너지","level":2,"related":["friction","hookes-law","truss"],"prerequisites":["friction","hookes-law"],"aliases":["Equilibrium of Forces"]},{"slug":"supply-chain-management","title_ko":"공급망 관리(SCM)","title_en":"Supply Chain Management","meaning":"공급망 관리는 원자재 조달부터 생산, 물류, 판매를 거쳐 소비자에게 도달하기까지 전 과정을 하나의 흐름으로 보고 비용과…","subcategory":"산업·시스템","level":2,"related":["transaction-cost","elasticity"],"prerequisites":[],"aliases":["Supply Chain Management","SCM","공급사슬관리","공급망관리","Supply Chain Management (SCM)"]},{"slug":"yield-strength","title_ko":"항복강도","title_en":"Yield Strength","meaning":"재료가 힘을 받았을 때 원래 모양으로 되돌아오지 못하고 영구적으로 변형되기 시작하는 경계 응력값입니다.","subcategory":"기계·재료","level":1,"related":[],"prerequisites":[],"pop":13,"aliases":["항복점","yield point"]},{"slug":"truss","title_ko":"트러스","title_en":"Truss","meaning":"직선 막대들을 삼각형 모양으로 연결해서 만든 구조물로, 각 막대가 오직 인장 또는 압축만 받도록 힘을 분산시키는 뼈대…","subcategory":"토목·건축","level":1,"related":["buckling"],"prerequisites":[],"aliases":["트러스 구조","트러스 구조물","트러스구조","truss structure"]},{"slug":"modal-analysis","title_ko":"모달해석","title_en":"Modal Analysis","meaning":"구조물이 진동할 때 각 고유진동수마다 어떤 모양(모드)으로 흔들리는지를 찾아내는 해석 기법입니다.","subcategory":"기계·재료","level":1,"related":["vibration-damping"],"prerequisites":[],"aliases":["모드해석","진동모드해석"]},{"slug":"fourier-transform","title_ko":"푸리에 변환","title_en":"Fourier transform","meaning":"복잡하게 뒤섞인 신호를 여러 개의 단순한 사인파(주기적으로 반복되는 파동)의 합으로 분해해 주는 수학적 방법입니다.","subcategory":"응용수학·수치해석","level":1,"related":["taylor-series","differential-equation"],"prerequisites":[],"aliases":["FT","푸리에변환","Fourier analysis"]},{"slug":"shear-stress","title_ko":"전단응력","title_en":"Shear Stress","meaning":"전단응력은 물체의 한 단면에 평행하게 작용하여 재료를 미끄러뜨리듯 변형시키려는 힘을 단면적으로 나눈 값입니다.","subcategory":"기계·재료","level":1,"related":[],"prerequisites":[],"pop":2,"aliases":["전단 응력","shearing stress"]},{"slug":"cavitation","title_ko":"캐비테이션(공동현상)","title_en":"Cavitation","meaning":"캐비테이션은 유체의 압력이 그 온도에서의 증기압보다 낮아져 액체 속에 순간적으로 기포가 생겼다가, 압력이 다시 높아지는…","subcategory":"기계·재료","level":1,"related":["bernoulli-theorem"],"prerequisites":[],"pop":12,"aliases":["공동현상","cavitation erosion","캐비테이션"]},{"slug":"fuel-cell","title_ko":"연료전지","title_en":"Fuel Cell","meaning":"연료전지는 수소와 산소를 연소시키지 않고 전기화학 반응을 통해 직접 반응시켜, 물과 열을 부산물로 내보내면서 전기 에너지를…","subcategory":"화학·에너지공학","level":3,"related":[],"prerequisites":[],"pop":18,"aliases":["수소연료전지","PEMFC"]},{"slug":"lean-manufacturing","title_ko":"린 생산방식","title_en":"Lean Manufacturing","meaning":"린 생산방식은 고객에게 가치를 더하지 않는 모든 낭비를 지속적으로 제거하여 최소한의 자원으로 최대의 가치를 만들어내는 생산…","subcategory":"산업·시스템","level":2,"related":["root-cause-analysis","fmea","supply-chain-management"],"prerequisites":["root-cause-analysis","fmea"],"pop":6,"aliases":["린 생산","도요타 생산방식","toyota production system","린생산방식","린생산","Lean Production"]},{"slug":"seismic-design","title_ko":"내진설계","title_en":"Seismic Design","meaning":"건물이나 구조물이 지진으로 인한 흔들림과 충격을 견디거나 에너지를 흡수하도록 설계하는 공학 기법입니다.","subcategory":"토목·건축","level":1,"related":["buckling","truss"],"prerequisites":[]},{"slug":"orbital-mechanics","title_ko":"궤도역학","title_en":"Orbital Mechanics","meaning":"중력과 속도의 균형을 이용해 인공위성이나 우주선이 정해진 궤도를 유지하며 움직이는 원리를 다루는 학문입니다.","subcategory":"기계·재료","level":2,"related":[],"prerequisites":[],"aliases":["우주비행역학"]},{"slug":"drug-delivery-system","title_ko":"약물전달시스템","title_en":"Drug Delivery System","meaning":"약물이 필요한 시점에, 필요한 부위에, 필요한 양만큼 전달되도록 설계하는 공학적 기술입니다.","subcategory":"화학·에너지공학","level":2,"related":[],"prerequisites":[],"aliases":["DDS"]},{"slug":"injection-molding","title_ko":"사출성형","title_en":"Injection Molding","meaning":"녹인 플라스틱을 금형 안에 강한 압력으로 밀어 넣어 원하는 모양의 부품을 대량으로 찍어내는 제조 공정입니다.","subcategory":"기계·재료","level":2,"related":["lean-manufacturing"],"prerequisites":[],"aliases":["사출성형법"]},{"slug":"poka-yoke","title_ko":"포카요케","title_en":"Poka-Yoke","meaning":"사람이 실수를 하더라도 그 실수가 불량이나 사고로 이어지지 않도록 제품이나 공정 자체를 설계하는 오류방지 기법입니다.","subcategory":"산업·시스템","level":3,"related":["fmea","root-cause-analysis"],"prerequisites":["fmea"],"pop":15,"aliases":["오류방지설계","PY"]},{"slug":"reverse-osmosis","title_ko":"역삼투","title_en":"Reverse Osmosis","meaning":"반투과성 막에 물 분자만 통과할 수 있을 만큼 강한 압력을 가해, 소금물 같은 용액에서 순수한 물을 걸러내는 정수·담수화…","subcategory":"화학·에너지공학","level":1,"related":[],"prerequisites":[],"aliases":["RO","역삼투압","해수담수화"]},{"slug":"retaining-wall","title_ko":"옹벽","title_en":"Retaining Wall","meaning":"흙이나 암반이 무너져 내리지 않도록 옆에서 지지하여 높이 차이가 있는 지형을 유지시키는 구조물입니다.","subcategory":"토목·건축","level":2,"related":[],"prerequisites":[],"aliases":["축대"]},{"slug":"runge-kutta-method","title_ko":"룽게-쿠타법","title_en":"Runge-Kutta Method","meaning":"손으로 풀기 어려운 미분방정식의 해를, 여러 지점의 기울기를 조합해 한 걸음씩 근사적으로 계산해 나가는 수치해석 방법입니다.","subcategory":"응용수학·수치해석","level":3,"related":["differential-equation","newton-raphson-method"],"prerequisites":["newton-raphson-method"],"aliases":["RKM","룽게 쿠타법","룽게쿠타법"]},{"slug":"beam-deflection","title_ko":"보의 처짐","title_en":"Beam Deflection","meaning":"다리나 기둥 같은 구조물의 보(빔)가 하중을 받았을 때 원래 위치에서 얼마나 휘어져 내려가는지를 나타내는 값입니다.","subcategory":"기계·재료","level":1,"related":["buckling","truss","shear-stress"],"prerequisites":[],"aliases":["보의처짐"]},{"slug":"root-locus-method","title_ko":"근궤적법","title_en":"Root Locus Method","meaning":"제어 시스템의 이득(gain) 값을 0부터 무한대까지 바꿔가면서, 시스템의 안정성을 결정하는 극점(pole)이 그리는 궤적을…","subcategory":"소프트웨어·제어","level":1,"related":["nyquist-stability-criterion"],"prerequisites":[]},{"slug":"nyquist-stability-criterion","title_ko":"나이퀴스트 안정성 판별법","title_en":"Nyquist Stability Criterion","meaning":"개루프 시스템의 주파수 응답 그래프가 특정 점(-1)을 몇 번, 어느 방향으로 감싸는지를 세어서 폐루프 제어 시스템이…","subcategory":"소프트웨어·제어","level":2,"related":["root-locus-method"],"prerequisites":["root-locus-method"],"aliases":["나이퀴스트안정성판별법"]},{"slug":"friction","title_ko":"마찰력","title_en":"Friction","meaning":"서로 맞닿은 두 면 사이에서 상대적인 움직임을 방해하는 방향으로 작용하는 힘입니다.","subcategory":"기계·재료","level":2,"related":[],"prerequisites":[],"aliases":["마찰","Friction Force"]},{"slug":"suspension-system","title_ko":"현가장치","title_en":"Suspension System","meaning":"스프링과 댐퍼(감쇠기)를 이용해 노면에서 오는 충격과 진동을 흡수하고 차체를 안정적으로 지지하는 기계 장치입니다.","subcategory":"기계·재료","level":2,"related":["vibration-damping"],"prerequisites":["vibration-damping"],"aliases":["서스펜션"]},{"slug":"capacitance","title_ko":"커패시턴스","title_en":"Capacitance","meaning":"전기 부품이 일정한 전압에서 얼마나 많은 전하를 저장할 수 있는지를 나타내는 양입니다.","subcategory":"전기전자","level":2,"related":[],"prerequisites":[],"aliases":["정전용량"]},{"slug":"mach-number","title_ko":"마하수","title_en":"Mach Number","meaning":"물체나 유체의 속도를 그 위치에서의 음속으로 나눈 값으로, 소리보다 얼마나 빠르거나 느린지를 나타내는 무차원 수입니다.","subcategory":"기계·재료","level":1,"related":[],"prerequisites":[]},{"slug":"kirchhoffs-circuit-laws","title_ko":"키르히호프의 법칙","title_en":"Kirchhoff's Circuit Laws","meaning":"회로의 어느 지점에서든 들어오고 나가는 전류의 합이 같고(전류법칙), 어느 폐회로를 한 바퀴 돌아도 전압의 합이 0이…","subcategory":"전기전자","level":2,"related":["power-factor","capacitance"],"prerequisites":["power-factor"],"aliases":["KCL","키르히호프의법칙"]},{"slug":"z-transform","title_ko":"Z변환","title_en":"Z-Transform","meaning":"시간 순서로 나열된 이산(디지털) 신호를 복소수 변수 z로 이루어진 함수로 바꾸어, 디지털 신호와 제어 시스템을 대수적으로…","subcategory":"소프트웨어·제어","level":3,"related":["fourier-transform"],"prerequisites":[]},{"slug":"biochemical-oxygen-demand","title_ko":"생화학적산소요구량(BOD)","title_en":"Biochemical Oxygen Demand","meaning":"물속 미생물이 유기물을 분해하는 동안 소비하는 산소의 양으로, 물이 유기물에 의해 얼마나 오염되었는지를 나타내는 지표입니다.","subcategory":"화학·에너지공학","level":3,"related":["reverse-osmosis"],"prerequisites":["reverse-osmosis"],"aliases":["생물학적산소요구량","BOD"]},{"slug":"galvanic-corrosion","title_ko":"갈바닉 부식","title_en":"Galvanic Corrosion","meaning":"서로 다른 두 금속이 전해질(습기나 물기)을 사이에 두고 맞닿았을 때, 둘 중 더 잘 부식되는 성질을 가진 금속이 유난히…","subcategory":"기계·재료","level":3,"related":["corrosion"],"prerequisites":["corrosion"],"pop":8,"aliases":["갈바닉부식"]},{"slug":"venturi-effect","title_ko":"벤츄리 효과","title_en":"Venturi Effect","meaning":"관의 폭이 좁아지는 구간에서 유체의 속도가 빨라지면서 압력이 낮아지는 현상입니다.","subcategory":"기계·재료","level":2,"related":["bernoulli-theorem","cavitation"],"prerequisites":["bernoulli-theorem","cavitation"],"pop":3,"aliases":["벤츄리효과"]},{"slug":"brayton-cycle","title_ko":"브레이턴 사이클","title_en":"Brayton Cycle","meaning":"공기를 압축하고, 연료를 태워 가열한 뒤, 팽창시켜 동력을 얻는 가스터빈 엔진의 기본 열역학 사이클입니다.","subcategory":"화학·에너지공학","level":3,"related":[],"prerequisites":[],"pop":11,"aliases":["브레이턴사이클"]},{"slug":"residual-stress","title_ko":"잔류응력","title_en":"Residual Stress","meaning":"외부에서 가하던 힘을 다 없앤 뒤에도 재료 내부에 그대로 남아있는 응력입니다.","subcategory":"기계·재료","level":3,"related":[],"prerequisites":[]},{"slug":"free-body-diagram","title_ko":"자유물체도","title_en":"Free Body Diagram","meaning":"분석하려는 물체 하나만 따로 떼어내, 그 물체에 작용하는 모든 힘과 모멘트를 화살표로 그려 넣은 그림입니다.","subcategory":"기계·재료","level":3,"related":["beam-deflection"],"prerequisites":[],"aliases":["FBD","자유물체선도"]},{"slug":"structural-load-types","title_ko":"구조물의 하중 종류","title_en":"Types of Structural Loads","meaning":"건물이나 교량 같은 구조물이 견뎌야 하는 힘을, 어디서 오는지에 따라 고정하중·활하중·풍하중·지진하중 등으로 나눈 분류입니다.","subcategory":"토목·건축","level":2,"related":["buckling"],"prerequisites":[],"aliases":["구조물의하중종류"]},{"slug":"predictive-maintenance","title_ko":"예지보전","title_en":"Predictive Maintenance","meaning":"설비에서 실시간으로 수집한 진동·온도 등의 센서 데이터를 분석해, 고장이 실제로 일어나기 전에 정비 시점을 미리 예측하는…","subcategory":"산업·시스템","level":3,"related":["vibration-damping"],"prerequisites":[],"aliases":["예측정비"]},{"slug":"analog-to-digital-converter","title_ko":"아날로그-디지털 변환기 (ADC/DAC)","title_en":"Analog-to-Digital / Digital-to-Analog Converter","meaning":"연속적으로 변하는 아날로그 신호를 컴퓨터가 계산할 수 있는 디지털 숫자로 바꾸거나(ADC), 반대로 디지털 값을 다시…","subcategory":"전기전자","level":3,"related":[],"prerequisites":[],"aliases":["ADC/DAC","아날로그 디지털 변환기","아날로그 디지털 변환기 (ADC DAC)","아날로그-디지털 변환기","아날로그-디지털변환기","아날로그-디지털변환기(ADC/DAC)","아날로그디지털 변환기","아날로그디지털 변환기 (ADCDAC)"]},{"slug":"magnetic-particle-testing","title_ko":"자분탐상검사","title_en":"Magnetic Particle Testing","meaning":"강자성체 표면에 자기장을 걸고 미세한 자성 분말을 뿌려, 균열 부위에서 새어나오는 자속에 분말이 달라붙어 만드는 무늬로 표면…","subcategory":"기계·재료","level":2,"related":[],"prerequisites":[],"pop":14},{"slug":"wire-drawing","title_ko":"인발","title_en":"Wire Drawing","meaning":"금속 재료를 다이(형틀)의 좁은 구멍으로 잡아당겨 통과시켜서 단면을 줄이고 길게 늘이는 가공 방법입니다.","subcategory":"기계·재료","level":2,"related":[],"prerequisites":[],"pop":1},{"slug":"pn-junction","title_ko":"p-n 접합","title_en":"p-n Junction","meaning":"p형 반도체와 n형 반도체를 맞붙여서, 그 경계면에 전류를 한쪽 방향으로만 흐르게 하는 얇은 장벽(공핍층)이 만들어지는…","subcategory":"전기전자","level":2,"related":[],"prerequisites":[]},{"slug":"oscillator-circuit","title_ko":"발진회로","title_en":"Oscillator Circuit","meaning":"외부에서 반복적인 입력을 주지 않아도 스스로 일정한 주기의 파형(전압 신호)을 계속 만들어내는 전자회로입니다.","subcategory":"전기전자","level":1,"related":[],"prerequisites":[],"aliases":["발진기"]},{"slug":"electric-generator","title_ko":"발전기의 원리","title_en":"Electric Generator","meaning":"자기장 속에서 코일을 회전시켜 전자기유도로 전류를 만들어내는 장치의 작동 원리입니다.","subcategory":"전자기·파동","level":2,"related":["electromagnetic-induction","magnetic-flux","transformer"],"prerequisites":["electromagnetic-induction"],"aliases":["발전기의원리"]},{"slug":"grain-boundary","title_ko":"결정립계","title_en":"Grain Boundary","meaning":"금속이나 세라믹 내부에서 원자 배열 방향이 서로 다른 결정립(grain)들이 맞닿아 만나는 경계면입니다.","subcategory":"기계·재료","level":1,"related":["yield-strength"],"prerequisites":[],"aliases":["입계"]},{"slug":"stall","title_ko":"실속","title_en":"Stall","meaning":"날개의 받음각이 임계값을 넘어서면서 공기 흐름이 날개 표면에서 떨어져 나가 양력이 갑자기 크게 줄어드는 현상입니다.","subcategory":"기계·재료","level":3,"related":[],"prerequisites":[]},{"slug":"thrust","title_ko":"추력","title_en":"Thrust","meaning":"로켓이나 제트엔진 같은 추진기관이 작동유체를 한쪽 방향으로 빠르게 밀어낸 반작용으로 얻는, 물체를 앞으로 나아가게 하는…","subcategory":"기계·재료","level":3,"related":["brayton-cycle","mach-number"],"prerequisites":["mach-number"]},{"slug":"concrete-compressive-strength","title_ko":"콘크리트 압축강도","title_en":"Compressive Strength","meaning":"콘크리트가 눌리는 힘(압축력)을 견딜 수 있는 최대 강도를 나타내는 값입니다.","subcategory":"토목·건축","level":2,"related":[],"prerequisites":[],"aliases":["콘크리트압축강도"]},{"slug":"slam","title_ko":"SLAM (동시적 위치추정 및 지도작성)","title_en":"SLAM (Simultaneous Localization and Mapping)","meaning":"로봇이 처음 가보는 공간에서 스스로 지도를 그려가면서 동시에 그 지도 안에서 자기 위치도 파악하는 기술입니다.","subcategory":"소프트웨어·제어","level":3,"related":[],"prerequisites":[],"aliases":["SLAM","SLAM(동시적위치추정및지도작성)"]},{"slug":"state-observer","title_ko":"상태 관측기 (State Observer)","title_en":"State Observer","meaning":"센서로 직접 잴 수 없는 시스템 내부 상태를, 잴 수 있는 값들을 이용해 계산으로 추정해내는 알고리즘입니다.","subcategory":"소프트웨어·제어","level":3,"related":[],"prerequisites":[],"aliases":["상태 관측기","상태관측기","상태관측기(StateObserver)"]},{"slug":"thevenins-theorem","title_ko":"테브난 정리","title_en":"Thevenin's Theorem","meaning":"아무리 복잡한 선형 회로라도, 특정 두 단자에서 바라보면 하나의 전압원과 하나의 저항이 직렬로 연결된 것과 똑같이 동작한다는…","subcategory":"전기전자","level":3,"related":["kirchhoffs-circuit-laws"],"prerequisites":["kirchhoffs-circuit-laws"],"aliases":["테브난정리"]},{"slug":"queueing-theory","title_ko":"대기행렬이론","title_en":"Queueing Theory","meaning":"손님(작업)이 도착해서 줄을 서고 서비스를 받는 과정을 확률·통계 모델로 분석해, 대기시간과 줄의 길이를 예측하는 이론입니다.","subcategory":"산업·시스템","level":3,"related":["lean-manufacturing","supply-chain-management"],"prerequisites":["lean-manufacturing","supply-chain-management"],"aliases":["대기이론"]},{"slug":"plug-flow-reactor","title_ko":"플러그흐름반응기","title_en":"Plug Flow Reactor","meaning":"관 모양의 반응기 내부를 유체가 마치 층층이 쌓인 조각(플러그)처럼 섞이지 않고 순서대로 흘러가며 반응이 일어나는 화학…","subcategory":"화학·에너지공학","level":2,"related":["continuous-stirred-tank-reactor","catalyst"],"prerequisites":["continuous-stirred-tank-reactor"],"aliases":["PFR"]},{"slug":"electrostatic-precipitator","title_ko":"전기집진장치","title_en":"Electrostatic Precipitator","meaning":"배출가스 속 미세먼지 입자에 전기를 띠게 한 뒤, 반대 전하를 가진 판에 달라붙게 해서 걸러내는 대기오염 저감 장치입니다.","subcategory":"화학·에너지공학","level":2,"related":[],"prerequisites":[],"aliases":["전기집진기"]},{"slug":"photolithography","title_ko":"포토리소그래피","title_en":"Photolithography","meaning":"빛에 반응하는 감광액을 웨이퍼에 바르고 원하는 회로 모양의 빛만 쬐어, 그 모양대로 미세한 패턴을 새기는 반도체 공정입니다.","subcategory":"전기전자","level":2,"related":[],"prerequisites":[],"aliases":["광식각","리소그래피"]},{"slug":"electroplating","title_ko":"전기도금 (Electroplating)","title_en":"Electroplating","meaning":"금속 이온이 녹아 있는 용액에 전류를 흘려보내 원하는 금속 얇은 막을 다른 물체 표면에 입히는 표면처리 기술입니다.","subcategory":"기계·재료","level":3,"related":["corrosion","galvanic-corrosion","cathodic-protection-marine"],"prerequisites":["corrosion"],"aliases":["전기도금","전기도금(Electroplating)"]},{"slug":"ergonomics","title_ko":"인체공학 (Ergonomics)","title_en":"Ergonomics","meaning":"사람의 신체 크기, 힘, 동작 범위, 인지 능력에 맞춰 도구와 장비, 작업환경을 설계함으로써 편안함과 안전, 효율을 높이는…","subcategory":"산업·시스템","level":3,"related":["cognitive-load"],"prerequisites":[],"aliases":["인체공학","인체공학(Ergonomics)"]},{"slug":"regenerative-braking","title_ko":"회생제동 (Regenerative Braking)","title_en":"Regenerative Braking","meaning":"차량이 속도를 줄일 때 마찰로 버려지던 운동에너지를, 전동기를 발전기처럼 거꾸로 작동시켜 전기에너지로 되돌려 배터리에…","subcategory":"전기전자","level":3,"related":[],"prerequisites":[],"aliases":["회생제동","회생제동(RegenerativeBraking)"]},{"slug":"hysteresis","title_ko":"히스테리시스","title_en":"Hysteresis","meaning":"어떤 값을 올릴 때와 내릴 때 반응이 서로 다르게 나타나서, 같은 입력값이라도 이전에 어떤 경로를 거쳐왔는지에 따라 결과가…","subcategory":"전기전자","level":3,"related":["piezoelectric-effect"],"prerequisites":["piezoelectric-effect"],"aliases":["이력현상"]},{"slug":"clutch","title_ko":"클러치 (Clutch)","title_en":"Clutch","meaning":"엔진처럼 회전하는 두 축 사이의 동력 전달을 필요할 때만 연결하거나 끊어주는 기계 장치입니다.","subcategory":"기계·재료","level":3,"related":[],"prerequisites":[],"aliases":["클러치","클러치(Clutch)"]},{"slug":"professional-engineering-code-of-ethics","title_ko":"전문직 엔지니어 윤리강령","title_en":"Professional Engineering Code of Ethics","meaning":"공학자가 공공의 안전·건강·복지를 최우선으로 여기고 정직하게 전문적 판단을 내리도록 규정한 직업윤리 규범입니다.","subcategory":"연구윤리 원칙","level":3,"related":["dual-use-research","conflict-of-interest"],"prerequisites":["dual-use-research"],"aliases":["PECE","전문직엔지니어윤리강령"]},{"slug":"worm-gear","title_ko":"웜기어","title_en":"Worm Gear","meaning":"나사처럼 생긴 웜과 그에 맞물리는 웜휠로 회전축의 방향을 90도로 바꾸면서, 웜휠 쪽에서는 아무리 힘을 줘도 거꾸로 웜을…","subcategory":"기계·재료","level":3,"related":[],"prerequisites":[]},{"slug":"hvac-system","title_ko":"냉난방공조 시스템","title_en":"HVAC System","meaning":"건물이나 공간의 온도, 습도, 공기질을 원하는 조건으로 유지해 주는 난방·환기·냉방 통합 설비 시스템입니다.","subcategory":"기계·재료","level":3,"related":["thermal-conductivity"],"prerequisites":["thermal-conductivity"],"pop":17,"aliases":["냉난방공조시스템"]},{"slug":"critical-path-method","title_ko":"주공정법","title_en":"Critical Path Method","meaning":"프로젝트를 구성하는 여러 작업들 중, 지연되면 전체 완료 시점이 그대로 늦어지는 \"가장 긴 작업 경로\"를 찾아 일정을…","subcategory":"산업·시스템","level":3,"related":["lean-manufacturing"],"prerequisites":["lean-manufacturing"],"pop":9,"aliases":["CPM","임계경로법"]},{"slug":"consolidation-settlement","title_ko":"압밀침하","title_en":"Consolidation Settlement","meaning":"흙 속의 물이 하중에 의해 서서히 빠져나가면서 지반이 시간에 걸쳐 천천히 가라앉는 현상입니다.","subcategory":"토목·건축","level":3,"related":[],"prerequisites":[]},{"slug":"eddy-current-testing","title_ko":"와전류탐상검사(와전류검사)","title_en":"Eddy Current Testing","meaning":"도체 표면에 교류 자기장을 걸어 유도되는 소용돌이 전류(와전류)의 변화를 측정해, 재료를 자르지 않고도 표면·근접 표면의…","subcategory":"기계·재료","level":3,"related":[],"prerequisites":[],"pop":5,"aliases":["ECT","와전류검사"]},{"slug":"cnc-lathe","title_ko":"CNC 선반","title_en":"CNC Lathe","meaning":"소재를 회전시키면서 고정된 절삭 공구로 깎아 원통형 부품을 가공하는 컴퓨터 수치제어 공작기계.","subcategory":"기계·재료","level":3,"related":["wire-edm"],"prerequisites":["wire-edm"],"aliases":["CNC선반"]},{"slug":"wire-edm","title_ko":"와이어 방전가공","title_en":"Wire Electrical Discharge Machining","meaning":"가늘고 전기가 통하는 와이어 전극과 소재 사이에서 발생하는 방전(스파크)으로 재료를 미세하게 녹여 원하는 형상을 정밀…","subcategory":"기계·재료","level":1,"related":[],"prerequisites":[],"aliases":["WEDM","와이어방전가공"]},{"slug":"dye-penetrant-testing","title_ko":"침투탐상검사","title_en":"Dye Penetrant Testing","meaning":"표면에 색이 있거나 형광을 내는 침투액을 발라 미세한 균열이나 결함 속으로 스며들게 한 뒤 닦아내고 현상액을 뿌려 결함을…","subcategory":"기계·재료","level":2,"related":[],"prerequisites":[],"aliases":["PT검사","액체침투탐상"]},{"slug":"charpy-impact-test","title_ko":"샤르피 충격시험","title_en":"Charpy Impact Test","meaning":"노치(홈)가 가공된 시편을 진자형 해머로 순간적으로 타격해 파단시키고, 이때 소모된 에너지로부터 재료의 충격 인성을 평가하는…","subcategory":"기계·재료","level":1,"related":[],"prerequisites":[],"aliases":["샤르피충격시험"]},{"slug":"extensometer","title_ko":"신율계(익스텐소미터)","title_en":"Extensometer","meaning":"인장 또는 압축 시험 중 시편의 표점 구간에 직접 부착하거나 비접촉으로 조준해 국소적인 변형(신율)을 정밀하게 측정하는 계측…","subcategory":"기계·재료","level":3,"related":[],"prerequisites":[],"aliases":["신율계","익스텐소미터"]},{"slug":"laser-doppler-vibrometer","title_ko":"레이저 도플러 진동계","title_en":"Laser Doppler Vibrometer","meaning":"진동하는 표면에 레이저를 조사하고 반사광의 도플러 주파수 편이를 측정해 접촉 없이 표면의 진동 속도와 변위를 정밀하게…","subcategory":"전기전자","level":3,"related":[],"prerequisites":[],"aliases":["레이저도플러진동계"]},{"slug":"surface-profilometer","title_ko":"표면 조도계","title_en":"Surface Profilometer","meaning":"촉침을 표면 위로 미세하게 이동시키거나 광학적 방법으로 표면 높낮이를 스캔해 표면 거칠기와 형상 프로파일을 정량적으로…","subcategory":"기계·재료","level":2,"related":[],"prerequisites":[],"aliases":["표면조도계"]},{"slug":"dc-power-supply","title_ko":"직류 전원공급장치","title_en":"DC Power Supply","meaning":"교류 전원을 변환하거나 조정해 원하는 전압과 전류의 안정적인 직류 전력을 회로나 장비에 공급하는 전자계측 장비.","subcategory":"전기전자","level":2,"related":["servo-motor-controller"],"prerequisites":[],"aliases":["직류전원공급장치","직류전원장치"]},{"slug":"imu","title_ko":"관성측정장치(IMU)","title_en":"Inertial Measurement Unit","meaning":"가속도계와 자이로스코프(각속도계)를 결합해 물체의 선형 가속도와 각속도를 동시에 측정함으로써 자세와 움직임을 추