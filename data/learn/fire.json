[{"slug":"fmea","title_ko":"고장모드영향분석","title_en":"FMEA","meaning":"제품이나 공정에서 일어날 수 있는 모든 고장 방식을 미리 나열하고, 그 심각도·발생빈도·검출난이도를 점수화해 가장 시급히…","subcategory":"산업·시스템","level":1,"related":["root-cause-analysis"],"prerequisites":[],"aliases":["고장모드 및 영향분석","DFMEA","Disaster Failure Mode and Effects Analysis"]},{"slug":"root-cause-analysis","title_ko":"근본원인분석","title_en":"Root Cause Analysis","meaning":"문제나 사고가 일어났을 때 겉으로 드러난 증상이 아니라, 그 문제를 실제로 일으킨 근본 원인을 끝까지 추적해 찾아내는 분석…","subcategory":"산업·시스템","level":1,"related":["fmea"],"prerequisites":[],"aliases":["원인분석","5Why 분석","DRCA","Disaster Root Cause Analysis"]},{"slug":"mitigation","title_ko":"완화","title_en":"Mitigation","meaning":"재난 발생 가능성을 낮추거나 발생했을 때의 피해 규모를 줄이기 위해 사전에 취하는 장기적 조치를 말한다.","subcategory":"재난 예방·완화","level":2,"related":[],"prerequisites":[]},{"slug":"special-disaster-zone","title_ko":"특별재난지역","title_en":"Special Disaster Zone","meaning":"특별재난지역은 피해가 극심하여 지방자치단체의 자체 능력만으로 수습이 어렵다고 판단될 때 국가가 행정적·재정적 지원을 집중하기…","subcategory":"재난 거버넌스·법제·국제협력","level":2,"related":[],"prerequisites":[],"aliases":["SDZ"]},{"slug":"digital-twin-disaster-management","title_ko":"디지털트윈 기반 재난관리","title_en":"Digital Twin for Disaster Management","meaning":"실제 도시나 시설물을 컴퓨터 안에 가상으로 똑같이 구현한 디지털트윈을 활용해 재난 상황을 시뮬레이션하고 대응 전략을 미리…","subcategory":"재난정보시스템·공간정보","level":2,"related":[],"prerequisites":[],"aliases":["DTDM","디지털트윈기반재난관리"]},{"slug":"ignition-point","title_ko":"발화점","title_en":"Ignition Point","meaning":"외부에서 점화원을 가하지 않아도 가연물이 스스로 불이 붙어 연소를 지속할 수 있는 최저 온도를 말한다.","subcategory":"연소공학","level":2,"related":["spontaneous-combustion","minimum-ignition-energy"],"prerequisites":[],"aliases":["발화온도","착화점"]},{"slug":"spontaneous-combustion","title_ko":"자연발화","title_en":"Spontaneous Combustion","meaning":"외부의 불꽃이나 스파크 같은 점화원 없이 물질 내부에서 스스로 열이 축적되어 발화에 이르는 현상을 말한다.","subcategory":"연소공학","level":2,"related":["ignition-point","smoldering-combustion"],"prerequisites":[],"aliases":["자기발열발화","자연발화현상"]},{"slug":"incomplete-combustion","title_ko":"불완전연소","title_en":"Incomplete Combustion","meaning":"산소가 부족하거나 연소 조건이 불충분하여 가연물이 완전히 산화되지 못하고 일산화탄소, 그을음 등이 함께 생성되는 연소를…","subcategory":"연소공학","level":2,"related":["smoldering-combustion"],"prerequisites":[],"pop":17},{"slug":"minimum-ignition-energy","title_ko":"최소착화에너지","title_en":"Minimum Ignition Energy","meaning":"가연성 혼합기를 점화시키는 데 필요한 최소한의 에너지를 말한다.","subcategory":"연소공학","level":2,"related":["ignition-point","explosion-limit-lel-uel"],"prerequisites":[],"aliases":["MIE","최소점화에너지"]},{"slug":"flashover","title_ko":"플래시오버","title_en":"Flashover","meaning":"실내 화재가 성장하는 과정에서 공간 내 모든 가연물이 거의 동시에 발화하며 화재가 실 전체로 급격히 확산되는 현상을 말한다.","subcategory":"화재역학","level":2,"related":[],"prerequisites":[],"aliases":["플래쉬오버","플래시오버 현상","Flashover Phenomenon","플래시오버현상"]},{"slug":"smoldering-combustion","title_ko":"훈소","title_en":"Smoldering Combustion","meaning":"불꽃 없이 물질 표면이나 내부에서 서서히 산화 반응이 일어나며 연기와 열을 내는 저온·저속의 연소 형태를 말한다.","subcategory":"연소공학","level":2,"related":["spontaneous-combustion","incomplete-combustion"],"prerequisites":[],"pop":2,"aliases":["무염연소","훈소연소"]},{"slug":"fuel-controlled-fire","title_ko":"연료지배형화재","title_en":"Fuel-Controlled Fire","meaning":"공기(산소)는 충분히 공급되고 연소 속도가 가연물의 양과 노출 표면적에 의해 결정되는 화재 상태를 말한다.","subcategory":"화재역학","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["연료지배화재"]},{"slug":"smoke-control-system","title_ko":"제연설비","title_en":"Smoke Control System","meaning":"화재 시 발생하는 연기를 제어, 배출, 차단하여 피난 통로와 실내 공간의 안전을 확보하는 소방설비이다.","subcategory":"소방시설·설비","level":2,"related":[],"prerequisites":[],"aliases":["배연설비","제연시스템"]},{"slug":"available-safe-egress-time","title_ko":"허용피난시간","title_en":"Available Safe Egress Time","meaning":"화재 발생 시점부터 실내 환경이 인명에 위험한 상태(연기, 열, 유독가스 등)에 이르기까지 재실자가 안전하게 대피할 수 있는…","subcategory":"피난·인명안전","level":2,"related":[],"prerequisites":[],"aliases":["ASET"]},{"slug":"flame-retardant-treatment","title_ko":"방염처리","title_en":"Flame Retardant Treatment","meaning":"커튼, 카펫, 벽지 등 가연성 물품이나 재료에 불이 쉽게 붙지 않고, 붙더라도 잘 번지지 않도록 처리하는 것을 말한다.","subcategory":"방화·내화공학","level":2,"related":[],"prerequisites":[],"pop":16,"aliases":["난연처리","방염"]},{"slug":"oxidizing-substance","title_ko":"산화성물질","title_en":"Oxidizing Substance","meaning":"자신은 잘 타지 않지만 다른 가연물의 연소를 강하게 촉진하거나 폭발을 일으킬 수 있는 산소 공급원 역할을 하는 물질을 말한다.","subcategory":"위험물안전관리","level":2,"related":[],"prerequisites":[],"pop":18},{"slug":"inhibition-extinguishment","title_ko":"억제소화(부촉매소화)","title_en":"Inhibition Extinguishment","meaning":"연소의 연쇄 화학반응에 개입해 반응 경로를 방해함으로써 불꽃 연소를 억제하는 소화 방법이다.","subcategory":"소화이론·소화약제","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["부촉매소화","억제소화","부촉매(화학적 억제) 소화작용","Chemical Inhibition","부촉매 소화작용","부촉매(화학적억제)소화작용","부촉매소화작용","화학적 억제"]},{"slug":"scenario-based-risk-analysis","title_ko":"시나리오기반 위험분석","title_en":"Scenario Based Risk Analysis","meaning":"발생 가능한 여러 재난 상황을 구체적인 시나리오로 설정하고, 각 시나리오별 진행 과정과 결과를 분석하여 위험을 평가하는…","subcategory":"위험성 평가·분석","level":2,"related":[],"prerequisites":[],"aliases":["SBRA","시나리오기반위험분석"]},{"slug":"cyberterrorism","title_ko":"사이버테러","title_en":"Cyberterrorism","meaning":"정치적·사회적 목적을 달성하기 위해 컴퓨터 시스템과 네트워크를 공격하여 공포심을 유발하거나 국가 기반시설의 기능을 마비시키는…","subcategory":"인위·사회재난","level":2,"related":[],"prerequisites":[]},{"slug":"lightning-strike-disaster","title_ko":"낙뢰피해","title_en":"Lightning Strike Disaster","meaning":"뇌운에서 발생한 전기 방전이 지표면이나 구조물, 사람에게 떨어지면서 인명·재산 피해를 일으키는 기상재해를 말한다.","subcategory":"자연재해","level":2,"related":[],"prerequisites":[]},{"slug":"international-disaster-response-law","title_ko":"국제재난대응법","title_en":"International Disaster Response Law","meaning":"대규모 재난 발생 시 국경을 넘는 인도적 지원과 구호 활동의 절차, 권리, 책임을 규율하는 국제법 및 관련 규범 체계를…","subcategory":"재난 거버넌스·법제·국제협력","level":2,"related":["subsidiarity-principle-disaster"],"prerequisites":[],"aliases":["IDRL"]},{"slug":"subsidiarity-principle-disaster","title_ko":"재난 보충성의 원칙","title_en":"Disaster Subsidiarity Principle","meaning":"재난 대응은 가장 가까운 하위 단위(기초지자체·지역사회)가 우선적으로 담당하고, 그 역량을 넘어서는 경우에만 상위…","subcategory":"재난 거버넌스·법제·국제협력","level":2,"related":