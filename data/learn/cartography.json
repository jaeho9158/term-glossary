[{"slug":"visual-hierarchy","title_ko":"시각적 위계","title_en":"Visual Hierarchy","meaning":"크기, 색상, 배치 등을 통해 화면이나 지면 내 요소들의 중요도 순서를 시각적으로 구분하여 정보 인지 순서를 유도하는 디자인…","subcategory":"제품디자인·산업디자인","level":1,"related":["gestalt-principles","figure-ground-organization"],"prerequisites":[],"pop":1,"aliases":["비주얼하이어라키","시각위계"]},{"slug":"albers-equal-area-conic-projection","title_ko":"알베르스 정적원추도법","title_en":"Albers Equal-Area Conic Projection","meaning":"지구본에 원뿔을 씌워 투영하되 면적을 정확히 보존하도록 설계한 원추 도법으로, 동서로 넓은 중위도 지역의 통계 지도 제작에…","subcategory":"지도 투영","level":2,"related":[],"prerequisites":[],"aliases":["AEACP","알베르스정적원추도법"]},{"slug":"azimuthal-equidistant-projection","title_ko":"정거방위도법","title_en":"Azimuthal Equidistant Projection","meaning":"지도의 중심점에서 다른 모든 지점까지의 거리와 방위를 정확하게 표현하는 방위 도법입니다.","subcategory":"지도 투영","level":2,"related":[],"prerequisites":[]},{"slug":"cartographic-aggregation","title_ko":"도형 집단화","title_en":"Cartographic Aggregation","meaning":"서로 가까이 위치한 여러 개별 도형 요소를 축척이 작아질 때 하나의 대표 형태로 묶어 표현하는 지도 일반화 기법입니다.","subcategory":"지도 일반화","level":2,"related":[],"prerequisites":[],"aliases":["도형집단화"]},{"slug":"figure-ground-organization","title_ko":"도형-배경 조직화","title_en":"Figure-Ground Organization","meaning":"보는 사람이 시각적 장면을 주된 형태(도형)와 그 뒤의 배경으로 자연스럽게 구분하여 지각하는 인지 원리입니다.","subcategory":"지도 인지","level":2,"related":["visual-hierarchy"],"prerequisites":[],"pop":2,"aliases":["FGO","도형 배경 조직화","도형-배경조직화","도형배경 조직화"]},{"slug":"stereographic-projection","title_ko":"평사도법","title_en":"Stereographic Projection","meaning":"지구본 표면의 한 점(주로 극점 반대편)을 시점으로 삼아 반대쪽 접평면에 빛을 투영하는 방식으로, 지점 주변 형태와 각도를…","subcategory":"지도 투영","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["평사투영법"]},{"slug":"equirectangular-projection","title_ko":"등장방형도법","title_en":"Equirectangular Projection","meaning":"위도와 경도를 각각 일정한 간격의 직선 좌표로 그대로 옮겨 정사각형 격자를 만드는 가장 단순한 지도 투영법입니다.","subcategory":"지도 투영","level":2,"related":[],"prerequisites":[],"pop":3},{"slug":"dilution-of-precision","title_ko":"정밀도저하율(DOP)","title_en":"Dilution of Precision","meaning":"관측에 이용된 위성들의 기하학적 배치가 측위 정확도에 미치는 영향을 나타내는 지표입니다.","subcategory":"측량·원격탐사","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["정밀도저하율"]},{"slug":"passive-remote-sensing","title_ko":"수동형 원격탐사","title_en":"Passive Remote Sensing","meaning":"태양광 등 외부 광원에서 반사되거나 지표면 스스로 방출하는 에너지를 센서가 받아들여 관측하는 원격탐사 방식입니다.","subcategory":"측량·원격탐사","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["수동형원격탐사"]},{"slug":"vector-to-raster-conversion","title_ko":"벡터-래스터 변환","title_en":"Vector-to-Raster Conversion","meaning":"점·선·면으로 표현된 벡터 공간자료를 격자(셀) 형태의 래스터 자료로 바꾸는 변환 과정입니다.","subcategory":"공간자료 처리","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["VRC","벡터 래스터 변환","벡터-래스터변환","벡터래스터 변환"]}]