ent-self-determination"],"prerequisites":["client-self-determination"],"aliases":["비심판적태도"]},{"slug":"client-self-determination","title_ko":"클라이언트 자기결정권","title_en":"Client Self-Determination","meaning":"클라이언트가 자신의 문제와 삶에 대해 스스로 선택하고 결정할 권리를 존중하는 사회복지실천의 원칙","subcategory":"사회복지실천·사례관리","level":1,"related":[],"prerequisites":[],"aliases":["클라이언트자기결정권"]},{"slug":"strengths-perspective","title_ko":"강점관점","title_en":"Strengths Perspective","meaning":"클라이언트의 병리나 결함이 아니라 강점, 자원, 역량에 초점을 맞추는 사회복지실천의 관점","subcategory":"사회복지실천·사례관리","level":1,"related":[],"prerequisites":[],"aliases":["강점기반실천","Strengths-Based Practice"]},{"slug":"outreach","title_ko":"아웃리치","title_en":"Outreach","meaning":"기관을 방문하지 않는 잠재적 클라이언트를 찾아 직접 지역사회로 나가 서비스를 제공하는 활동","subcategory":"사회복지실천·사례관리","level":3,"related":[],"prerequisites":[],"aliases":["찾아가는서비스","사례발견","Case Finding","찾아가는 복지서비스","Outreach Welfare Service","OWS","찾아가는복지서비스"]},{"slug":"clarification-skill","title_ko":"명료화","title_en":"Clarification","meaning":"클라이언트의 모호한 표현이나 감정을 구체적으로 확인하고 명확히 하는 면접 기술","subcategory":"사회복지실천·사례관리","level":1,"related":[],"prerequisites":[],"aliases":["명확화"]},{"slug":"reassurance-skill","title_ko":"재보증","title_en":"Reassurance","meaning":"클라이언트의 불안이나 죄책감을 줄여주고 자신감을 회복하도록 돕는 면접 기술","subcategory":"사회복지실천·사례관리","level":3,"related":["ambivalence-in-practice"],"prerequisites":["ambivalence-in-practice"]},{"slug":"change-agent-system","title_ko":"변화매개체계","title_en":"Change Agent System","meaning":"변화를 위한 개입을 계획하고 실행하는 사회복지사와 소속기관을 지칭하는 체계이론 용어","subcategory":"사회복지실천·사례관리","level":2,"related":[],"prerequisites":[],"aliases":["변화매개인역할","Change Agent Role"]},{"slug":"ambivalence-in-practice","title_ko":"양가감정","title_en":"Ambivalence","meaning":"변화를 원하는 마음과 원하지 않는 마음이 동시에 존재하는 클라이언트의 심리 상태","subcategory":"사회복지실천·사례관리","level":2,"related":["motivational-interviewing","reassurance-skill"],"prerequisites":[],"aliases":["양가성"]},{"slug":"countertransference-in-practice","title_ko":"역전이","title_en":"Countertransference","me