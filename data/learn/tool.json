[{"slug":"outlier","title_ko":"이상치","title_en":"Outlier","meaning":"다른 데이터와 크게 동떨어진 값으로, 분석 결과를 왜곡할 수 있는 관측치.","subcategory":"기술통계·확률분포","level":1,"related":["standard-deviation","variance","normal-distribution","skewness-kurtosis"],"prerequisites":[],"aliases":["이상값","특이값"]},{"slug":"validity","title_ko":"타당도","title_en":"Validity","meaning":"측정 도구가 측정하려는 개념을 실제로 얼마나 정확히 재는지의 정도.","subcategory":"설문·척도","level":1,"related":["reliability","likert-scale","construct"],"prerequisites":[],"aliases":["타당성"]},{"slug":"reliability","title_ko":"신뢰도","title_en":"Reliability","meaning":"같은 측정을 반복했을 때 결과가 얼마나 일관되게 나오는지의 정도.","subcategory":"설문·척도","level":1,"related":["validity","likert-scale","construct","content-analysis","split-half-reliability","cronbachs-alpha","internal-consistency-reliability"],"prerequisites":[],"aliases":["신뢰성","Educational Evaluation","Reliability (Educational Evaluation)"]},{"slug":"spectroscopy","title_ko":"분광법","title_en":"Spectroscopy","meaning":"물질이 빛을 흡수·방출하는 패턴을 분석해 성분을 알아내는 기법입니다.","subcategory":"화학반응·물질구조","level":1,"related":["isotope","chirality","mass-spectrometry","chromatography"],"prerequisites":[],"aliases":["분광학"]},{"slug":"crispr","title_ko":"크리스퍼","title_en":"CRISPR","meaning":"특정 DNA 서열을 정밀하게 자르고 편집할 수 있는 유전자 가위 기술입니다.","subcategory":"세포·분자생물학","level":1,"related":["pcr","epigenetics","mutation"],"prerequisites":[],"aliases":["크리스퍼 유전자가위"]},{"slug":"fmri","title_ko":"기능적자기공명영상","title_en":"fMRI","meaning":"뇌 혈류 변화를 측정해 활성화된 부위를 영상으로 보여주는 기법입니다.","subcategory":"신경영상·측정기법","level":1,"related":["eeg","amygdala","neuroplasticity","prefrontal-cortex"],"prerequisites":[],"aliases":["기능적 자기공명영상","Functional Magnetic Resonance Imaging"]},{"slug":"eeg","title_ko":"뇌파검사","title_en":"EEG","meaning":"두피에서 뇌의 전기적 활동을 기록하는 측정 방법입니다.","subcategory":"신경영상·측정기법","level":1,"related":["fmri","synapse","cognitive-load","metacognition-child","action-potential"],"prerequisites":[],"aliases":["뇌전도"]},{"slug":"biomarker","title_ko":"생체지표","title_en":"Biomarker","meaning":"질병 상태나 신체 반응을 객관적으로 나타내는 측정 가능한 지표입니다.","subcategory":"진단·검사","level":1,"related":["clinical-trial","sensitivity-specificity"],"prerequisites":[],"pop":9,"aliases":["바이오마커"]},{"slug":"likert-scale","title_ko":"리커트척도","title_en":"Likert Scale","meaning":"동의 정도를 여러 단계로 나눠 응답하게 하는 설문 척도입니다.","subcategory":"심리측정","level":1,"related":["construct","reliability","validity","factor-analysis"],"prerequisites":[],"pop":3,"aliases":["리커트 척도"]},{"slug":"construct","title_ko":"구성개념","title_en":"Construct","meaning":"직접 관찰할 수 없어 여러 지표를 통해 간접적으로 측정하는 추상적 개념입니다.","subcategory":"심리측정","level":1,"related":["likert-scale","validity","reliability","self-efficacy"],"prerequisites":[],"aliases":["구인"]},{"slug":"factor-analysis","title_ko":"요인분석","title_en":"Factor Analysis","meaning":"여러 개의 관측 변수 사이의 상관관계를 분석해, 그 뒤에 숨어 있는 소수의 공통 요인을 찾아내는 통계기법입니다.","subcategory":"통계·분석도구","level":1,"related":["likert-scale","delphi-method","factor-loading","convergent-validity"],"prerequisites":[]},{"slug":"mass-spectrometry","title_ko":"질량분석법","title_en":"Mass Spectrometry","meaning":"분자를 이온화한 뒤 질량 대 전하비를 정밀하게 측정해 시료의 구성 성분을 알아내는 분석 기법입니다.","subcategory":"화학반응·물질구조","level":1,"related":["spectroscopy","pcr","calibration-curve","x-ray-diffraction"],"prerequisites":[],"aliases":["MS","질량분석"]},{"slug":"pcr","title_ko":"중합효소연쇄반응","title_en":"PCR","meaning":"DNA의 특정 부위를 온도를 반복적으로 바꿔가며 짧은 시간 안에 수백만 배로 복제하는 실험 기법입니다.","subcategory":"세포·분자생물학","level":3,"related":["crispr","mass-spectrometry","calibration-curve","electrophoresis"],"prerequisites":["crispr"],"aliases":["폴리머라아제 연쇄반응","Polymerase Chain Reaction"]},{"slug":"cronbachs-alpha","title_ko":"크론바흐 알파","title_en":"Cronbach's Alpha","meaning":"설문지나 척도를 이루는 여러 문항들이 같은 개념을 얼마나 일관되게 측정하는지를 0~1 사이의 숫자로 나타낸 지표입니다.","subcategory":"통계·분석도구","level":1,"related":["content-validity","reverse-coded-item","factor-loading","likert-scale","construct-validity"],"prerequisites":[],"pop":6,"aliases":["Cronbach's α","신뢰도계수 알파","신뢰도계수","크론바하알파"]},{"slug":"calibration-curve","title_ko":"검량선","title_en":"Calibration Curve","meaning":"농도를 이미 알고 있는 표준시료들을 측정해 얻은 값과 실제 농도 사이의 관계를 그래프로 그려, 미지 시료의 농도를 추정하는…","subcategory":"실험기기·측정장비","level":1,"related":["mass-spectrometry","pcr","roc-curve","ceiling-effect"],"prerequisites":[],"pop":4,"aliases":["표준곡선"]},{"slug":"criterion-validity","title_ko":"준거타당도","title_en":"Criterion Validity","meaning":"새로 만든 측정도구의 점수가 이미 타당성이 검증된 외부 기준(준거)과 얼마나 일치하는지를 확인하는 타당도입니다.","subcategory":"설문·척도","level":1,"related":["content-validity","construct-validity","convergent-validity","face-validity","visual-analogue-scale"],"prerequisites":[],"aliases":["준거관련타당도"]},{"slug":"content-validity","title_ko":"내용타당도","title_en":"Content Validity","meaning":"검사나 설문 문항이 측정하려는 내용 영역을 빠짐없이, 골고루 담고 있는지를 나타내는 타당도입니다.","subcategory":"설문·척도","level":1,"related":["criterion-validity","cronbachs-alpha","construct-validity","convergent-validity","face-validity"],"prerequisites":[]},{"slug":"roc-curve","title_ko":"ROC 곡선","title_en":"ROC Curve","meaning":"분류 기준(threshold)을 바꿔가며 모델이나 검사가 정답을 얼마나 잘 구분해내는지를 보여주는 그래프입니다.","subcategory":"통계·분석도구","level":1,"related":["calibration-curve","ground-truth"],"prerequisites":[],"aliases":["ROC","ROC곡선"]},{"slug":"ground-truth","title_ko":"그라운드트루스","title_en":"Ground Truth","meaning":"모델이나 측정 방법의 정확도를 평가할 때 기준으로 삼는, 실제로 옳다고 확인된 정답 데이터입니다.","subcategory":"통계·분석도구","level":1,"related":["roc-curve","discriminant-validity","visual-analogue-scale"],"prerequisites":[],"aliases":["실측값"]},{"slug":"construct-validity","title_ko":"구성타당도","title_en":"Construct Validity","meaning":"측정도구가 측정하려는 추상적인 개념(구성개념)을 이론적으로 타당하게 재고 있는지를 나타내는 타당도입니다.","subcategory":"설문·척도","level":1,"related":["content-validity","criterion-validity","factor-loading","reverse-coded-item","convergent-validity"],"prerequisites":[],"aliases":["구인타당도"]},{"slug":"reverse-coded-item","title_ko":"역채점 문항","title_en":"Reverse-coded Item","meaning":"설문에서 다른 문항들과 반대 방향으로 표현되어, 점수를 계산할 때 값을 뒤집어서(역으로) 채점해야 하는 문항입니다.","subcategory":"설문·척도","level":1,"related":["cronbachs-alpha","construct-validity","discriminant-validity"],"prerequisites":[],"aliases":["역문항","역채점문항"]},{"slug":"factor-loading","title_ko":"요인적재량","title_en":"Factor Loading","meaning":"요인분석에서 개별 관측 문항이 특정 공통요인과 얼마나 강하게 관련되어 있는지를 나타내는 수치입니다.","subcategory":"통계·분석도구","level":1,"related":["factor-analysis","construct-validity","cronbachs-alpha","discriminant-validity","visual-analogue-scale"],"prerequisites":[],"aliases":["요인부하량"]},{"slug":"ceiling-effect","title_ko":"천장효과","title_en":"Ceiling Effect","meaning":"측정도구의 점수 상한이 너무 낮아, 실제로는 수준 차이가 있는 사람들이 모두 만점 근처에 몰려 서로 구별되지 않는 현상입니다.","subcategory":"설문·척도","level":1,"related":["calibration-curve","split-half-reliability","pilot-study"],"prerequisites":[],"pop":8},{"slug":"convergent-validity","title_ko":"수렴타당도","title_en":"Convergent Validity","meaning":"같은 개념을 측정하려는 서로 다른 도구나 문항들의 점수가 실제로 서로 높은 상관관계를 보이는 정도를 나타내는 타당도입니다.","subcategory":"설문·척도","level":1,"related":["construct-validity","criterion-validity","content-validity","factor-analysis","discriminant-validity"],"prerequisites":[],"aliases":["집중타당도"]},{"slug":"discriminant-validity","title_ko":"판별타당도","title_en":"Discriminant Validity","meaning":"서로 다른 개념을 측정하는 척도들끼리는 실제로 상관관계가 낮게 나와야 한다는, 척도가 \"제대로 구별되는지\"를 확인하는…","subcategory":"설문·척도","level":1,"related":["convergent-validity","factor-loading","ground-truth","reverse-coded-item","split-half-reliability"],"prerequisites":[],"aliases":["변별타당도"]},{"slug":"face-validity","title_ko":"안면타당도","title_en":"Face Validity","meaning":"설문 문항이나 검사 도구를 언뜻 보았을 때 측정하려는 개념을 재는 것처럼 \"그럴듯해 보이는지\"를 뜻하는, 가장 단순하고…","subcategory":"설문·척도","level":1,"related":["content-validity","criterion-validity","pilot-study"],"prerequisites":[]},{"slug":"split-half-reliability","title_ko":"반분신뢰도","title_en":"Split-half Reliability","meaning":"하나의 검사 문항들을 절반으로 나누어 두 묶음의 점수가 서로 얼마나 일치하는지를 보고 신뢰도를 확인하는 방법입니다.","subcategory":"설문·척도","level":1,"related":["intraclass-correlation-coefficient","discriminant-validity","ceiling-effect"],"prerequisites":[]},{"slug":"visual-analogue-scale","title_ko":"시각적 아날로그 척도","title_en":"Visual Analogue Scale","meaning":"응답자가 정해진 길이의 직선 위에서 자신의 상태에 해당하는 지점을 직접 표시해, 통증이나 기분 같은 주관적인 정도를 연속적인…","subcategory":"설문·척도","level":1,"related":["criterion-validity","ground-truth","factor-loading"],"prerequisites":[],"aliases":["VAS","시각적아날로그척도"]},{"slug":"intraclass-correlation-coefficient","title_ko":"급내상관계수","title_en":"Intraclass Correlation Coefficient","meaning":"여러 명의 평가자가 매긴 점수나 같은 대상을 여러 번 측정한 값들이 서로 얼마나 일치하는지를 0~1 사이의 숫자로 나타낸…","subcategory":"통계·분석도구","level":1,"related":["cohen-kappa","split-half-reliability"],"prerequisites":[],"aliases":["ICC"]},{"slug":"pilot-study","title_ko":"파일럿 연구","title_en":"Pilot Study","meaning":"본 연구를 시작하기 전에 연구 설계나 측정도구, 진행 절차에 문제가 없는지 작은 규모로 미리 시행해보는 예비 연구입니다.","subcategory":"통계·분석도구","level":1,"related":["face-validity","ceiling-effect"],"prerequisites":[],"aliases":["예비연구","예비조사","파일럿연구"]},{"slug":"molar-concentration","title_ko":"몰농도","title_en":"Molar Concentration","meaning":"용액 1리터 안에 녹아있는 물질이 몇 몰인지를 숫자로 나타낸, 용액의 진하기를 재는 단위입니다(mol/L, 기호 M).","subcategory":"화학반응·물질구조","level":1,"related":["ph-acid-base","buffer-solution","osmotic-pressure","normality","stock-solution"],"prerequisites":[],"aliases":["몰랄농도","Molarity (M)"]},{"slug":"parallel-forms-reliability","title_ko":"동형검사 신뢰도","title_en":"Parallel-Forms Reliability","meaning":"같은 개념을 재도록 만든, 문항은 다르지만 난이도와 구조가 동등한 두 검사를 같은 사람에게 실시해 두 점수가 얼마나…","subcategory":"설문·척도","level":3,"related":["split-half-reliability","cronbachs-alpha","reliability"],"prerequisites":["split-half-reliability","reliability"],"aliases":["동형검사신뢰도"]},{"slug":"pet-imaging","title_ko":"양전자방출단층촬영","title_en":"PET","meaning":"몸에 주입한 방사성 추적자가 내는 신호를 감지해 특정 부위의 대사 활동이나 특정 분자의 분포를 영상으로 보여주는 뇌·신체…","subcategory":"신경영상·측정기법","level":2,"related":["fmri"],"prerequisites":["fmri"],"aliases":["양전자방출단층촬영술","펫 스캔","positron emission tomography"]},{"slug":"measurement-uncertainty","title_ko":"측정불확도","title_en":"Measurement Uncertainty","meaning":"어떤 측정값이 참값으로부터 얼마나 벗어나 있을 수 있는지를 숫자로 표현한, 측정 결과에 딸린 \"의심의 폭\"입니다.","subcategory":"실험기기·측정장비","level":1,"related":["calibration-curve","standard-deviation"],"prerequisites":[],"aliases":["측정 불확실도"]},{"slug":"data-logger","title_ko":"데이터 로거","title_en":"Data Logger","meaning":"사람이 옆에 없어도 센서로부터 들어오는 값을 정해진 시간 간격마다 자동으로 저장하는 장비입니다.","subcategory":"실험기기·측정장비","level":1,"related":["calibration-curve","measurement-uncertainty","instrument-calibration","standard-operating-procedure"],"prerequisites":[],"aliases":["DLI","Data Logging Instrument"]},{"slug":"microscopy","title_ko":"현미경법","title_en":"Microscopy","meaning":"눈으로 볼 수 없을 만큼 작은 시료를 렌즈나 전자빔으로 확대하여 관찰하는 기법입니다.","subcategory":"실험기기·측정장비","level":1,"related":["electrophoresis","x-ray-diffraction","flow-cytometry"],"prerequisites":[],"aliases":["현미경","현미경검사"]},{"slug":"flow-cytometry","title_ko":"유세포분석","title_en":"Flow Cytometry","meaning":"레이저 앞으로 세포를 한 줄로 흘려보내면서 수천~수만 개의 세포 하나하나의 크기와 표지 여부를 빠르게 측정하는 기법입니다.","subcategory":"실험기기·측정장비","level":1,"related":["elisa","biomarker","single-cell-cloning"],"prerequisites":[],"aliases":["유세포분석법","FCM","플로우사이토메트리","Flow Cytometry Analysis"]},{"slug":"elisa","title_ko":"효소면역측정법","title_en":"ELISA","meaning":"항체와 효소 발색 반응을 이용해 혈액이나 배양액 속 특정 물질의 농도를 숫자로 측정하는 기법입니다.","subcategory":"실험기기·측정장비","level":1,"related":["biomarker","flow-cytometry","pcr"],"prerequisites":[],"aliases":["엘라이자","효소결합면역흡착검사"]},{"slug":"qpcr","title_ko":"정량 PCR","title_en":"qPCR","meaning":"DNA가 증폭되는 과정을 실시간으로 관찰해, 시료 안에 특정 유전자가 원래 얼마나 있었는지를 정량적으로 계산하는 PCR…","subcategory":"실험기기·측정장비","level":1,"related":["pcr","calibration-curve","biomarker"],"prerequisites":[],"aliases":["qPCR","실시간 PCR","RT-qPCR","정량PCR"]},{"slug":"spectrophotometer","title_ko":"분광광도계","title_en":"Spectrophotometer","meaning":"특정 파장의 빛이 시료를 통과할 때 얼마나 흡수되는지를 측정해, 그 흡광도로부터 시료의 농도나 성분을 알아내는 장비입니다.","subcategory":"실험기기·측정장비","level":1,"related":["spectroscopy","calibration-curve","elisa"],"prerequisites":[],"aliases":["UV-Vis 분광광도계","흡광광도계","Spectrophotometry"]},{"slug":"centrifuge","title_ko":"원심분리기","title_en":"Centrifuge","meaning":"시료를 빠르게 회전시켜 발생하는 원심력으로, 밀도가 다른 성분들을 층으로 분리해내는 실험 장비입니다.","subcategory":"실험기기·측정장비","level":1,"related":["flow-cytometry","qpcr"],"prerequisites":[],"aliases":["원심분리","Centrifugation","고속원심분리기"]},{"slug":"patch-clamp","title_ko":"패치클램프","title_en":"Patch Clamp","meaning":"아주 가는 유리 전극을 세포막에 밀착시켜 이온 채널 하나하나의 전류까지 직접 측정하는 전기생리학 기법입니다.","subcategory":"신경영상·측정기법","level":1,"related":["action-potential","epsp-ipsp"],"prerequisites":[],"aliases":["패치 클램프","패치클램프법"]},{"slug":"dna-sequencing","title_ko":"DNA 염기서열분석","title_en":"DNA Sequencing","meaning":"DNA를 이루는 A, T, G, C 네 염기가 어떤 순서로 배열되어 있는지 실제로 읽어내는 측정 기법입니다.","subcategory":"실험기기·측정장비","level":1,"related":["pcr","qpcr","mutation"],"prerequisites":[],"aliases":["염기서열분석","시퀀싱","NGS","차세대염기서열분석","DNA염기서열분석"]},{"slug":"composite-reliability","title_ko":"합성신뢰도","title_en":"Composite Reliability","meaning":"확인적 요인분석 모형을 바탕으로, 여러 문항이 하나의 개념을 얼마나 일관되게 측정하는지 계산한 신뢰도 지표입니다.","subcategory":"통계·분석도구","level":1,"related":["cronbachs-alpha","factor-loading","convergent-validity","reliability"],"prerequisites":[],"aliases":["CR","구성신뢰도"]},{"slug":"norm-referenced-test","title_ko":"규준참조검사","title_en":"Norm-referenced Test","meaning":"개인의 점수를 정해진 기준이 아니라, 미리 검사한 비교 집단(규준)의 점수 분포와 비교해서 해석하는 검사입니다.","subcategory":"설문·척도","level":1,"related":["reliability"],"prerequisites":[],"aliases":["규준참조평가","규준지향검사"]},{"slug":"multitrait-multimethod-matrix","title_ko":"다중특성-다중방법 행렬","title_en":"Multitrait-Multimethod Matrix","meaning":"여러 개념을 여러 방법으로 동시에 측정한 뒤, 그 상관관계들을 한 표로 정리해 수렴·판별타당도를 함께 검증하는 방법입니다.","subcategory":"통계·분석도구","level":3,"related":["convergent-validity","discriminant-validity","construct-validity","composite-reliability"],"prerequisites":["composite-reliability"],"aliases":["MTMM","다중특성-다중방법행렬","다중특성 다중방법 행렬","다중특성다중방법 행렬"]},{"slug":"response-rate","title_ko":"응답률","title_en":"Response Rate","meaning":"설문이나 조사에 참여하도록 요청받은 사람 중 실제로 응답을 완료한 사람의 비율입니다.","subcategory":"통계·분석도구","level":2,"related":["sample-size","pilot-study"],"prerequisites":["pilot-study"],"aliases":["회수율","응답 비율"]},{"slug":"coefficient-of-variation","title_ko":"변동계수","title_en":"Coefficient of Variation","meaning":"표준편차를 평균으로 나눈 값(주로 %)으로, 단위나 크기가 다른 측정값들의 상대적인 흩어짐 정도를 비교할 수 있게 해주는…","subcategory":"통계·분석도구","level":3,"related":["standard-deviation","measurement-uncertainty"],"prerequisites":[],"aliases":["CV","relative standard deviation","RSD"]},{"slug":"confirmatory-factor-analysis","title_ko":"확인적 요인분석","title_en":"Confirmatory Factor Analysis","meaning":"연구자가 이론적으로 미리 설정한 요인 구조가 실제 수집된 데이터와 얼마나 잘 맞는지를 통계적으로 검증하는 요인분석 기법입니다.","subcategory":"통계·분석도구","level":1,"related":["factor-loading","construct-validity","item-response-theory","cronbachs-alpha"],"prerequisites":[],"aliases":["CFA","확인적요인분석"]},{"slug":"autoclave","title_ko":"오토클레이브(고압멸균기)","title_en":"Autoclave","meaning":"고온·고압의 포화수증기를 이용해 실험 기구, 배지, 폐기물 속 미생물과 세균 포자까지 완전히 사멸시키는 고압증기멸균…","subcategory":"실험기기·측정장비","level":1,"related":["centrifuge","pcr","dna-sequencing"],"prerequisites":[],"aliases":["고압증기멸균기","autoclave sterilizer","고압멸균기","오토클레이브(고압멸균기)"]},{"slug":"generalizability-theory","title_ko":"일반화가능도이론","title_en":"Generalizability Theory","meaning":"측정 점수에 영향을 미치는 여러 오차 요인(평가자, 문항, 시점 등)을 동시에 분석하여 측정의 신뢰도를 종합적으로 추정하는…","subcategory":"통계·분석도구","level":3,"related":["cronbachs-alpha","intraclass-correlation-coefficient","reliability"],"prerequisites":["cronbachs-alpha","intraclass-correlation-coefficient"],"aliases":["G이론"]},{"slug":"magnetoencephalography","title_ko":"뇌자도","title_en":"Magnetoencephalography","meaning":"뇌 신경세포의 전기 활동이 만들어내는 매우 미세한 자기장을 두피 밖에서 측정하여 뇌 기능을 시간 단위로 정밀하게 추적하는…","subcategory":"실험기기·측정장비","level":3,"related":["eeg","fmri"],"prerequisites":[],"aliases":["MEG"]},{"slug":"measurement-invariance","title_ko":"측정불변성","title_en":"Measurement Invariance","meaning":"서로 다른 집단이나 시점에서 같은 설문·검사 도구가 동일한 심리적 구성개념을 같은 방식으로 측정하고 있는지를 확인하는…","subcategory":"통계·분석도구","level":3,"related":["confirmatory-factor-analysis","construct-validity","factor-loading"],"prerequisites":["confirmatory-factor-analysis","factor-loading"]},{"slug":"southern-blot","title_ko":"서던 블롯","title_en":"Southern Blot","meaning":"DNA를 전기영동으로 크기별로 분리한 뒤 특정 염기서열에 결합하는 탐침으로 원하는 DNA 조각을 검출하는 분자생물학…","subcategory":"실험기기·측정장비","level":3,"related":["pcr","dna-sequencing"],"prerequisites":["dna-sequencing"],"aliases":["서던블롯"]},{"slug":"magnetic-resonance-imaging","title_ko":"자기공명영상","title_en":"Magnetic Resonance Imaging","meaning":"강한 자기장과 전파를 이용해 몸속 수소 원자의 신호를 측정함으로써 뼈가 아닌 근육·뇌·장기 등 연부조직의 단면 영상을 만드는…","subcategory":"실험기기·측정장비","level":2,"related":["fmri"],"prerequisites":[],"aliases":["MRI"]},{"slug":"spirometry","title_ko":"폐활량검사","title_en":"Spirometry","meaning":"숨을 최대한 들이마신 뒤 세게 내쉬는 공기의 양과 속도를 측정해 폐 기능을 평가하는 검사입니다.","subcategory":"실험기기·측정장비","level":1,"related":[],"prerequisites":[],"aliases":["스파이로메트리","폐기능검사"]},{"slug":"gas-chromatography","title_ko":"기체크로마토그래피","title_en":"Gas Chromatography","meaning":"시료를 기체 상태로 만들어 관 속을 통과시키면서, 성분마다 이동 속도가 다른 성질을 이용해 혼합물 속 화합물을 분리하고…","subcategory":"화학반응·물질구조","level":3,"related":["mass-spectrometry","spectrophotometer"],"prerequisites":["mass-spectrometry"],"aliases":["가스크로마토그래피","GC"]},{"slug":"bioelectrical-impedance-analysis","title_ko":"생체전기임피던스분석","title_en":"Bioelectrical Impedance Analysis","meaning":"몸에 아주 약한 전류를 흘려보낸 뒤 조직마다 전류가 통과하는 정도(저항)가 다른 성질을 이용해, 체지방과 근육량 등 체성분을…","subcategory":"진단·검사","level":3,"related":["spirometry"],"prerequisites":[],"aliases":["체성분분석","BIA"]},{"slug":"computerized-adaptive-testing","title_ko":"컴퓨터 적응검사","title_en":"Computerized Adaptive Testing","meaning":"응답자가 문항에 답할 때마다 컴퓨터가 그 능력 수준을 추정하여, 다음에 제시할 문항의 난이도를 실시간으로 조정하는 검사…","subcategory":"심리측정","level":3,"related":["item-response-theory","likert-scale","norm-referenced-test"],"prerequisites":["likert-scale"],"aliases":["적응형검사","CAT","컴퓨터적응검사"]},{"slug":"gravimeter","title_ko":"중력계","title_en":"Gravimeter","meaning":"지표면 위치마다 미세하게 다른 중력 가속도 값을 정밀하게 측정하는 지구물리 관측 장비입니다.","subcategory":"실험기기·측정장비","level":3,"related":["data-logger"],"prerequisites":["data-logger"]},{"slug":"interferometer","title_ko":"간섭계","title_en":"Interferometer","meaning":"하나의 빛을 두 갈래로 나누었다가 다시 합칠 때 생기는 간섭무늬를 이용해 아주 미세한 거리나 두께 변화를 측정하는 장비입니다.","subcategory":"실험기기·측정장비","level":1,"related":["spectroscopy","spectrophotometer"],"prerequisites":[]},{"slug":"thurstone-scale","title_ko":"서스톤척도","title_en":"Thurstone Scale","meaning":"여러 전문가의 평정을 거쳐 각 문항에 미리 가중치(척도값)를 부여한 뒤, 응답자가 동의하는 문항들로 태도를 측정하는 척도…","subcategory":"설문·척도","level":2,"related":["likert-scale","construct"],"prerequisites":[]},{"slug":"load-cell","title_ko":"로드셀","title_en":"Load Cell","meaning":"물체가 누르거나 당기는 힘(하중)을 받으면 미세하게 변형되는 금속판의 저항 변화를 이용해 무게나 힘의 크기를 전기 신호로…","subcategory":"실험기기·측정장비","level":1,"related":[],"prerequisites":[]},{"slug":"refractometer","title_ko":"굴절계","title_en":"Refractometer","meaning":"빛이 액체를 통과할 때 꺾이는 정도(굴절률)를 측정해서 그 액체에 무엇이 얼마나 녹아있는지 알아내는 기구입니다.","subcategory":"실험기기·측정장비","level":1,"related":["spectrophotometer"],"prerequisites":[],"aliases":["굴절률계"]},{"slug":"manometer","title_ko":"마노미터","title_en":"Manometer","meaning":"U자 모양 관 속 액체(주로 수은이나 물)의 양쪽 높이 차이를 이용해 두 지점 사이의 압력 차이를 재는 기구입니다.","subcategory":"실험기기·측정장비","level":3,"related":["load-cell"],"prerequisites":["load-cell"],"aliases":["압력계"]},{"slug":"test-battery","title_ko":"검사 배터리","title_en":"Test Battery","meaning":"하나의 능력이나 특성을 여러 각도에서 측정하기 위해 여러 개별 검사를 묶어서 함께 실시하는 검사 세트입니다.","subcategory":"설문·척도","level":3,"related":["norm-referenced-test","reliability","validity","pilot-study"],"prerequisites":["norm-referenced-test","reliability","validity"],"aliases":["검사배터리"]},{"slug":"state-trait-anxiety-inventory","title_ko":"상태-특성 불안척도","title_en":"State-Trait Anxiety Inventory","meaning":"지금 이 순간 느끼는 일시적인 불안(상태불안)과 평소 성격처럼 오래 지속되는 불안 성향(특성불안)을 각각 따로 측정하는…","subcategory":"설문·척도","level":1,"related":["likert-scale","construct-validity"],"prerequisites":[],"aliases":["STAI","상태 특성 불안척도","상태-특성불안척도","상태특성 불안척도"]},{"slug":"glasgow-coma-scale","title_ko":"글래스고 혼수 척도","title_en":"Glasgow Coma Scale","meaning":"눈뜨기, 언어 반응, 운동 반응 세 영역을 각각 점수화해 환자의 의식 수준을 3점에서 15점 사이의 숫자로 표현하는 임상…","subcategory":"설문·척도","level":1,"related":["eeg","biomarker"],"prerequisites":[],"pop":15,"aliases":["글래스고혼수척도"]},{"slug":"mini-mental-state-examination","title_ko":"간이정신상태검사","title_en":"Mini-Mental State Examination","meaning":"지남력, 기억력, 주의집중력, 언어능력 등을 짧은 질문과 과제로 확인해 인지기능 저하 여부를 30점 만점으로 선별하는…","subcategory":"설문·척도","level":2,"related":["norm-referenced-test","ceiling-effect"],"prerequisites":["norm-referenced-test","ceiling-effect"]},{"slug":"hamilton-depression-rating-scale","title_ko":"해밀턴 우울척도","title_en":"Hamilton Depression Rating Scale","meaning":"훈련된 임상가가 면담을 통해 우울 증상의 심각도를 평가하는, 정신의학 연구에서 가장 오래 쓰인 표준 척도입니다.","subcategory":"설문·척도","level":2,"related":["state-trait-anxiety-inventory","likert-scale"],"prerequisites":["state-trait-anxiety-inventory"],"pop":14,"aliases":["HDRS","해밀턴우울척도"]},{"slug":"nasa-tlx","title_ko":"NASA 과업부하지수","title_en":"NASA-TLX","meaning":"어떤 작업을 하는 동안 사람이 느낀 정신적·신체적 부담의 정도를 6가지 항목으로 측정하는 설문 도구입니다.","subcategory":"설문·척도","level":3,"related":["likert-scale"],"prerequisites":[],"aliases":["NASA과업부하지수"]},{"slug":"spearman-brown-prophecy-formula","title_ko":"스피어만-브라운 예언공식","title_en":"Spearman-Brown Prophecy Formula","meaning":"검사 문항 수를 몇 배로 늘리면 신뢰도가 어느 정도까지 좋아질지를 미리 계산해주는 공식입니다.","subcategory":"통계·분석도구","level":3,"related":["split-half-reliability","cronbachs-alpha","reliability"],"prerequisites":["cronbachs-alpha"],"aliases":["SBPF","스피어만 브라운 예언공식","스피어만-브라운예언공식","스피어만브라운 예언공식"]},{"slug":"item-discrimination-index","title_ko":"문항변별도","title_en":"Item Discrimination Index","meaning":"어떤 문항이 실력(또는 특성)이 높은 사람과 낮은 사람을 얼마나 잘 구분해주는지를 나타내는 지표입니다.","subcategory":"통계·분석도구","level":1,"related":["item-response-theory","cronbachs-alpha"],"prerequisites":[]},{"slug":"posturography","title_ko":"자세동요검사","title_en":"Posturography","meaning":"압력판 위에 가만히 서 있을 때 몸이 얼마나, 어느 방향으로 흔들리는지를 측정해 균형 조절 능력을 평가하는 검사법입니다.","subcategory":"실험기기·측정장비","level":3,"related":[],"prerequisites":[]},{"slug":"litmus-paper","title_ko":"리트머스 종이","title_en":"Litmus Paper","meaning":"용액이 산성인지 염기성인지를 색깔 변화로 간단히 확인하는 도구입니다.","subcategory":"실험기기·측정장비","level":3,"related":["spectrophotometer","calibration-curve","ph-test-paper-lab"],"prerequisites":["spectrophotometer"],"aliases":["리트머스지"]},{"slug":"exploratory-factor-analysis","title_ko":"탐색적요인분석","title_en":"Exploratory Factor Analysis","meaning":"여러 문항 사이의 상관관계 패턴을 살펴보고, 그 문항들이 몇 개의 공통 요인으로 묶이는지를 사전 가설 없이 데이터로부터…","subcategory":"통계·분석도구","level":1,"related":["factor-analysis","confirmatory-factor-analysis","cronbachs-alpha","likert-scale"],"prerequisites":[],"aliases":["EFA"]},{"slug":"percentile-score","title_ko":"백분위점수","title_en":"Percentile Score","meaning":"한 사람의 점수가 비교 집단 전체에서 낮은 쪽부터 몇 %에 해당하는 위치인지를 나타내는 값입니다.","subcategory":"통계·분석도구","level":1,"related":["z-score","norm-referenced-test"],"prerequisites":[]},{"slug":"kuder-richardson-reliability","title_ko":"쿠더-리처드슨 신뢰도","title_en":"Kuder-Richardson Reliability","meaning":"정답/오답처럼 0점 또는 1점으로만 채점되는 문항들로 이루어진 검사에서, 한 번의 검사 결과만으로 문항 간 일관성을 계산해…","subcategory":"통계·분석도구","level":3,"related":["cronbachs-alpha","split-half-reliability","composite-reliability"],"prerequisites":["cronbachs-alpha","composite-reliability"],"aliases":["KRR","쿠더 리처드슨 신뢰도","쿠더-리처드슨신뢰도","쿠더리처드슨 신뢰도"]},{"slug":"open-closed-ended-questions","title_ko":"개방형질문과 폐쇄형질문","title_en":"Open-Ended vs Closed-Ended Questions","meaning":"응답자가 자유롭게 답을 쓰게 하는 문항(개방형)과, 미리 정해둔 보기 중에서 고르게 하는 문항(폐쇄형)을 구분하는 설문 문항…","subcategory":"설문·척도","level":3,"related":["likert-scale","semi-structured-interview","social-desirability-bias"],"prerequisites":[],"aliases":["개방형질문과폐쇄형질문"]},{"slug":"randomized-response-technique","title_ko":"무작위응답기법","title_en":"Randomized Response Technique","meaning":"동전 던지기 같은 무작위 장치를 응답 과정에 섞어 넣어, 연구자조차 개별 응답자의 실제 답을 알 수 없게 만듦으로써 민감한…","subcategory":"설문·척도","level":3,"related":["social-desirability-bias"],"prerequisites":[]},{"slug":"concurrent-validity","title_ko":"공인타당도","title_en":"Concurrent Validity","meaning":"새로 만든 검사 점수를 이미 검증된 다른 검사(또는 실제 상태)와 \"같은 시점에\" 비교해서, 두 결과가 얼마나 일치하는지…","subcategory":"설문·척도","level":2,"related":["predictive-validity","construct-validity"],"prerequisites":["construct-validity"],"aliases":["동시타당도"]},{"slug":"predictive-validity","title_ko":"예측타당도","title_en":"Predictive Validity","meaning":"지금 측정한 검사 점수가 \"미래에\" 일어날 결과를 얼마나 잘 예측하는지를 확인하는 타당도입니다.","subcategory":"설문·척도","level":2,"related":["concurrent-validity","construct-validity"],"prerequisites":["construct-validity"]},{"slug":"mcdonalds-omega","title_ko":"맥도날드 오메가","title_en":"McDonald's Omega","meaning":"척도를 이루는 문항들이 하나의 개념을 얼마나 일관되게 측정하는지를, 문항마다 다른 영향력(요인부하량)까지 반영해서 계산한…","subcategory":"통계·분석도구","level":2,"related":["cronbachs-alpha","factor-analysis","split-half-reliability"],"prerequisites":["cronbachs-alpha","factor-analysis"],"aliases":["맥도날드오메가"]},{"slug":"item-total-correlation","title_ko":"문항-총점 상관","title_en":"Item-Total Correlation","meaning":"척도의 한 문항 점수가 나머지 문항들을 합한 총점과 얼마나 함께 움직이는지를 계산해, 그 문항이 척도에 잘 어울리는지…","subcategory":"통계·분석도구","level":3,"related":["cronbachs-alpha","factor-analysis","mcdonalds-omega"],"prerequisites":["cronbachs-alpha","factor-analysis","mcdonalds-omega"],"aliases":["문항 총점 상관","문항-총점상관","문항총점 상관"]},{"slug":"t-score-stanine","title_ko":"T점수와 스테나인","title_en":"T-score and Stanine","meaning":"원점수를 평균과 표준편차가 미리 정해진 값이 되도록 변환하여, 서로 다른 검사 결과도 같은 기준으로 비교할 수 있게 만든…","subcategory":"통계·분석도구","level":3,"related":["z-score","percentile","percentile-score"],"prerequisites":["percentile-score"],"aliases":["T점수와스테나인"]},{"slug":"back-translation","title_ko":"역번역법","title_en":"Back-Translation","meaning":"원어로 만든 검사 문항을 다른 언어로 번역한 뒤 그 번역본을 다시 원어로 재번역하여 두 버전을 비교함으로써, 번역이 원래…","subcategory":"설문·척도","level":2,"related":["content-validity","construct-validity"],"prerequisites":["content-validity","construct-validity"]},{"slug":"random-systematic-error","title_ko":"무선오차와 체계적오차","title_en":"Random Error and Systematic Error","meaning":"측정값이 참값에서 벗어나는 이유를 예측 불가능하게 이랬다저랬다 흔들리는 무선오차와, 항상 같은 방향으로 치우치는 체계적오차로…","subcategory":"통계·분석도구","level":3,"related":["cronbachs-alpha","construct-validity","back-translation"],"prerequisites":["cronbachs-alpha"],"aliases":["RESE","무선오차와체계적오차"]},{"slug":"formative-reflective-indicators","title_ko":"형성지표와 반영지표","title_en":"Formative and Reflective Indicators","meaning":"관측 문항이 잠재개념의 결과로 나타나는지(반영지표), 아니면 문항들이 모여 잠재개념을 만들어내는지(형성지표)를 구분하는…","subcategory":"통계·분석도구","level":3,"related":["factor-analysis","likert-scale"],"prerequisites":["factor-analysis"],"aliases":["형성지표와반영지표"]},{"slug":"cutoff-score-setting","title_ko":"절단점설정법","title_en":"Cutoff Score Setting","meaning":"검사 점수 중 어디부터를 \"합격/통과\" 또는 \"위험군\"으로 볼지 가르는 기준 점수(절단점)를, 전문가 판단이나 통계적…","subcategory":"설문·척도","level":3,"related":[],"prerequisites":[]},{"slug":"fourier-transform-infrared-spectroscopy","title_ko":"푸리에 변환 적외선분광법","title_en":"Fourier-Transform Infrared Spectroscopy","meaning":"시료에 적외선을 쬐어 어떤 파장이 흡수되는지를 분석함으로써, 그 물질 안에 어떤 화학결합이 들어있는지 알아내는 분광…","subcategory":"실험기기·측정장비","level":3,"related":["spectrophotometer","calibration-curve"],"prerequisites":["spectrophotometer","calibration-curve"],"aliases":["푸리에변환적외선분광법"]},{"slug":"anchoring-vignettes","title_ko":"앵커링 비네트","title_en":"Anchoring Vignettes","meaning":"같은 수준을 나타내는 가상의 짧은 사례들을 함께 제시하고 평가하게 함으로써, 사람마다 다른 자기보고식 응답 기준을 서로 비교…","subcategory":"설문·척도","level":3,"related":["social-desirability-bias","vignette-method"],"prerequisites":[],"aliases":["앵커링비네트"]},{"slug":"time-sampling","title_ko":"시간표집법","title_en":"Time Sampling","meaning":"관찰 대상 행동을 미리 정해둔 시간 간격마다 순간적으로 확인하여, 그 시점에 행동이 나타나는지 여부를 기록하는 관찰…","subcategory":"설문·척도","level":2,"related":["structured-observation"],"prerequisites":[]},{"slug":"dsm-5","title_ko":"DSM-5 (정신질환 진단 및 통계 편람)","title_en":"DSM-5","meaning":"미국정신의학회가 만든, 정신질환을 진단할 때 기준으로 삼는 공식 분류 체계이자 매뉴얼입니다.","subcategory":"진단·검