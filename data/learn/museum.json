[{"slug":"digital-preservation","title_ko":"디지털보존","title_en":"Digital Preservation","meaning":"디지털 자료를 기술적 노후화, 매체 손상, 포맷 진부화 등의 위협으로부터 지켜내어 장기간에 걸쳐 접근성과 진본성을 유지할 수…","subcategory":"정보검색·디지털아카이빙","level":1,"related":[],"prerequisites":[]},{"slug":"icom-museum-definition","title_ko":"ICOM 박물관 정의","title_en":"ICOM Museum Definition","meaning":"ICOM 박물관 정의는 국제박물관협의회(ICOM)가 채택한, 박물관의 공식적 개념과 역할을 규정하는 국제적 기준 정의입니다.","subcategory":"박물관학 기초이론","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["ICOM박물관정의"]},{"slug":"provenance-research","title_ko":"출처 조사","title_en":"Provenance Research","meaning":"출처 조사는 특정 유물이 제작된 이후 누구의 소유를 거쳐 현재에 이르렀는지 소유권 이전 이력을 추적하는 조사 활동입니다.","subcategory":"소장품 수집·관리","level":2,"related":[],"prerequisites":[],"aliases":["출처조사"]},{"slug":"conservator","title_ko":"보존처리사","title_en":"Conservator","meaning":"유물의 재질과 손상 상태를 분석하고 보존 및 복원 처리를 전문적으로 수행하는 전문 인력입니다.","subcategory":"보존과학","level":2,"related":[],"prerequisites":[],"aliases":["보존과학자"]},{"slug":"exhibition-design","title_ko":"전시디자인","title_en":"Exhibition Design","meaning":"전시 공간의 동선, 조명, 진열 방식 등을 계획하여 관람객이 전시 내용을 효과적으로 경험하도록 구성하는 작업입니다.","subcategory":"전시기획","level":2,"related":[],"prerequisites":[]},{"slug":"exhibition-narrative","title_ko":"전시서사","title_en":"Exhibition Narrative","meaning":"전시서사는 전시물과 공간, 텍스트를 순서 있게 배치하여 관람객이 하나의 이야기 흐름을 따라 의미를 이해하도록 구성하는 전시…","subcategory":"전시기획","level":2,"related":[],"prerequisites":[]},{"slug":"curator","title_ko":"큐레이터","title_en":"Curator","meaning":"큐레이터는 박물관·미술관에서 소장품의 조사·연구·보존을 관리하고 전시를 기획·해석하는 전문 인력을 말합니다.","subcategory":"큐레이션","level":2,"related":[],"prerequisites":[]},{"slug":"audio-description-museum","title_ko":"음성해설","title_en":"Audio Description","meaning":"전시물의 시각적 특징과 맥락을 음성 언어로 설명하여, 시각장애인을 포함한 관람객이 눈으로 보지 않고도 전시물을 이해할 수…","subcategory":"박물관 교육","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["Audio Description"]},{"slug":"born-digital-records","title_ko":"born-디지털 기록","title_en":"Born-Digital Records","meaning":"처음부터 디지털 형태로 생성되어 종이나 필름 등 아날로그 원본을 거치지 않은 기록물을 말합니다.","subcategory":"아카이브·기록학","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["Born-Digital Records","BDR","born 디지털 기록","born-디지털기록","born디지털 기록"]},{"slug":"packing-and-crating","title_ko":"포장 및 크레이팅","title_en":"Packing and Crating","meaning":"유물을 운송하거나 보관할 때 진동, 충격, 습도 변화 등으로부터 보호하기 위해 완충재와 전용 상자(크레이트)를 이용해…","subcategory":"소장품 수집·관리","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["Packing and Crating","포장및크레이팅"]},{"slug":"object-biography-museum","title_ko":"사물전기(박물관)","title_en":"Object Biography (Museum Context)","meaning":"하나의 유물이 제작부터 사용, 수집, 박물관 소장에 이르기까지 거쳐온 소유자·용도·의미의 변화를 시간 순으로 추적하는 연구…","subcategory":"박물관학 기초이론","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["사물전기(박물관) (Object Biography","Museum Context)","사물전기 (Object Biography","사물전기(ObjectBiography","사물전기(박물관)(ObjectBiography"]},{"slug":"registrar-museum-profession","title_ko":"레지스트라","title_en":"Registrar (Museum Profession)","meaning":"박물관 소장품의 기록, 이동, 대여, 보험 등 관리 업무 전반을 전문적으로 담당하는 직무입니다.","subcategory":"등록·기록관리","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["레지스트라 (Registrar","Museum Profession)","레지스트라(Registrar"]}]