[{"slug":"sensitivity-specificity","title_ko":"민감도와 특이도","title_en":"Sensitivity and Specificity","meaning":"진단 검사가 실제 병이 있는 사람을 얼마나 잘 찾아내는지(민감도)와, 병이 없는 사람을 얼마나 정확히 걸러내는지(특이도)를…","subcategory":"진단·검사","level":1,"related":["biomarker","clinical-trial","odds-ratio","elisa","positive-predictive-value","confidence-interval"],"prerequisites":[],"aliases":["민감도 특이도"]},{"slug":"white-blood-cell-count","title_ko":"백혈구수","title_en":"White Blood Cell Count (WBC)","meaning":"혈액 단위 부피당 존재하는 백혈구의 총 개수로, 감염·염증·혈액질환 여부를 평가하는 기본 지표이다.","subcategory":"임상화학·혈액학검사","level":1,"related":["wbc-differential-count"],"prerequisites":[],"aliases":["WBCC"]},{"slug":"platelet-count","title_ko":"혈소판수","title_en":"Platelet Count","meaning":"혈액 단위 부피당 혈소판의 개수를 측정한 값으로, 지혈 및 응고 기능의 기본 지표이다.","subcategory":"임상화학·혈액학검사","level":1,"related":[],"prerequisites":[]},{"slug":"mean-corpuscular-volume","title_ko":"평균적혈구용적","title_en":"Mean Corpuscular Volume (MCV)","meaning":"적혈구 한 개의 평균 부피를 나타내는 지표로, 빈혈을 소적혈구성·정적혈구성·대적혈구성으로 분류하는 데 사용된다.","subcategory":"임상화학·혈액학검사","level":1,"related":["mean-corpuscular-hemoglobin-concentration"],"prerequisites":[],"aliases":["MCV"]},{"slug":"mean-corpuscular-hemoglobin-concentration","title_ko":"평균적혈구혈색소농도","title_en":"Mean Corpuscular Hemoglobin Concentration (MCHC)","meaning":"적혈구 부피 대비 혈색소 농도를 나타내는 지표로, 적혈구의 색소 농도(저색소성·정색소성)를 평가하는 데 사용된다.","subcategory":"임상화학·혈액학검사","level":2,"related":["mean-corpuscular-volume"],"prerequisites":["mean-corpuscular-volume"],"aliases":["MCHC"]},{"slug":"reticulocyte-count","title_ko":"망상적혈구수","title_en":"Reticulocyte Count","meaning":"골수에서 갓 방출된 미성숙 적혈구인 망상적혈구의 비율 또는 절대수를 측정하여 골수의 적혈구 생성 능력을 평가하는 검사이다.","subcategory":"임상화학·혈액학검사","level":1,"related":[],"prerequisites":[],"aliases":["그물적혈구수"]},{"slug":"wbc-differential-count","title_ko":"백혈구감별계산","title_en":"WBC Differential Count","meaning":"백혈구를 호중구, 림프구, 단핵구, 호산구, 호염기구 등 종류별로 나누어 각각의 비율과 절대수를 산출하는 검사이다.","subcategory":"임상화학·혈액학검사","level":1,"related":["white-blood-cell-count","monocyte","left-shift"],"prerequisites":[],"pop":10},{"slug":"monocyte","title_ko":"단핵구","title_en":"Monocyte","meaning":"혈액 내를 순환하다 조직으로 이동하여 대식세포로 분화하는 백혈구로, 만성 감염이나 염증에서 증가할 수 있다.","subcategory":"임상화학·혈액학검사","level":1,"related":["wbc-differential-count","white-blood-cell-count"],"prerequisites":["wbc-differential-count","white-blood-cell-count"],"pop":17},{"slug":"basophil","title_ko":"호염기구","title_en":"Basophil","meaning":"백혈구 중 가장 수가 적은 과립구로, 히스타민을 방출하여 알레르기 및 염증 반응에 관여한다.","subcategory":"임상화학·혈액학검사","level":1,"related":["wbc-differential-count","white-blood-cell-count"],"prerequisites":["wbc-differential-count"]},{"slug":"left-shift","title_ko":"핵좌방이동","title_en":"Left Shift (Band Neutrophils)","meaning":"말초혈액에서 미성숙 호중구(band form)의 비율이 증가한 소견으로, 급성 세균 감염이나 골수의 과도한 반응성 생성을…","subcategory":"임상화학·혈액학검사","level":1,"related":["wbc-differential-count"],"prerequisites":[],"pop":8,"aliases":["Band Neutrophils"]},{"slug":"prothrombin-time","title_ko":"프로트롬빈시간","title_en":"Prothrombin Time (PT)","meaning":"외인성 응고경로(조직인자 경로)와 공통경로의 기능을 평가하는 응고검사로, 혈장에 조직트롬보플라스틴과 칼슘을 첨가해 응고까지…","subcategory":"임상화학·혈액학검사","level":1,"related":["international-normalized-ratio","fibrinogen-test"],"prerequisites":[],"aliases":["PT"]},{"slug":"international-normalized-ratio","title_ko":"국제표준화비율","title_en":"International Normalized Ratio (INR)","meaning":"환자의 PT를 정상대조군의 PT로 나눈 값에 시약별 국제감도지수를 적용하여 표준화한 값으로, 와파린 치료 모니터링의 표준…","subcategory":"임상화학·혈액학검사","level":2,"related":["prothrombin-time"],"prerequisites":["prothrombin-time"],"aliases":["INR"]},{"slug":"fibrinogen-test","title_ko":"피브리노겐검사","title_en":"Fibrinogen Test","meaning":"혈장 내 응고인자 I인 피브리노겐의 농도를 측정하는 검사로, 파종성혈관내응고나 간질환에서 감소할 수 있다.","subcategory":"임상화학·혈액학검사","level":1,"related":["prothrombin-time","d-dimer"],"prerequisites":[]},{"slug":"d-dimer","title_ko":"D-이합체","title_en":"D-dimer","meaning":"피브린이 분해될 때 생성되는 최종 분해산물로, 체내 혈전 형성 및 용해가 최근에 일어났음을 시사하는 지표이다.","subcategory":"임상화학·혈액학검사","level":1,"related":["fibrinogen-test","sensitivity","specificity","prothrombin-time"],"prerequisites":[],"pop":18,"aliases":["D 이합체","D이합체"]},{"slug":"platelet-function-test","title_ko":"혈소판기능검사","title_en":"Platelet Function Test","meaning":"혈소판 수가 정상이더라도 응집·부착 등 기능적 이상이 있는지를 평가하는 검사로, 응집검사와 폐쇄시간측정법 등이 있다.","subcategory":"임상화학·혈액학검사","level":3,"related":["platelet-count","von-willebrand-factor-assay"],"prerequisites":["platelet-count"]},{"slug":"von-willebrand-factor-assay","title_ko":"폰빌레브란트인자검사","title_en":"von Willebrand Factor Assay","meaning":"혈소판 부착과 제VIII인자 안정화에 관여하는 폰빌레브란트인자의 항원량과 활성도(리스토세틴 보조인자 활성 등)를 측정하는…","subcategory":"임상화학·혈액학검사","level":3,"related":["platelet-function-test"],"prerequisites":[],"aliases":["VWFA"]},{"slug":"lupus-anticoagulant-test","title_ko":"루푸스항응고인자검사","title_en":"Lupus Anticoagulant Test","meaning":"인지질 의존성 응고검사를 지연시키는 자가항체인 루푸스항응고인자의 존재를 확인하는 검사로, 항인지질항체증후군 진단에 사용된다.","subcategory":"임상화학·혈액학검사","level":3,"related":["d-dimer"],"prerequisites":["d-dimer"]},{"slug":"heparin-anticoagulation-monitoring","title_ko":"헤파린항응고모니터링","title_en":"Heparin Anticoagulation Monitoring","meaning":"헤파린 투여 중인 환자에서 aPTT나 항Xa활성도 등을 측정하여 항응고 효과가 치료 목표범위 내에 있는지 확인하는 과정이다.","subcategory":"임상화학·혈액학검사","level":3,"related":[],"prerequisites":[]},{"slug":"thromboelastography","title_ko":"혈전탄성검사","title_en":"Thromboelastography (TEG)","meaning":"전혈을 이용해 혈전 형성부터 용해까지 전 과정의 점탄성 변화를 실시간으로 측정하여 응고 전반의 기능을 종합적으로 평가하는…","subcategory":"임상화학·혈액학검사","level":3,"related":["fibrinogen-test","platelet-function-test","prothrombin-time"],"prerequisites":["fibrinogen-test","platelet-function-test","prothrombin-time"],"aliases":["TEG"]},{"slug":"aspartate-aminotransferase","title_ko":"아스파르테이트아미노전이효소","title_en":"Aspartate Aminotransferase (AST)","meaning":"간세포뿐 아니라 심장·근육·신장 등에도 존재하는 효소로, 세포 손상 시 혈중으로 유출되어 간기능검사의 지표로 활용된다.","subcategory":"임상화학·혈액학검사","level":1,"related":["alkaline-phosphatase","gamma-glutamyl-transferase","creatine-kinase"],"prerequisites":[],"pop":4,"aliases":["AST","GOT"]},{"slug":"gamma-glutamyl-transferase","title_ko":"감마글루타밀전이효소","title_en":"Gamma-Glutamyl Transferase (GGT)","meaning":"간세포막과 담도 상피세포에 풍부한 효소로, 담즙정체와 알코올성 간손상을 민감하게 반영하는 지표이다.","subcategory":"임상화학·혈액학검사","level":2,"related":["alkaline-phosphatase","aspartate-aminotransferase","total-bilirubin"],"prerequisites":["aspartate-aminotransferase"],"pop":2,"aliases":["GGT","감마GTP"]},{"slug":"total-bilirubin","title_ko":"총빌리루빈","title_en":"Total Bilirubin","meaning":"적혈구 파괴로 생성되는 대사산물인 빌리루빈의 혈중 총량(직접형+간접형)을 측정하는 검사로, 황달의 정도를 평가한다.","subcategory":"임상화학·혈액학검사","level":1,"related":["alkaline-phosphatase","hemolysis-index-test"],"prerequisites":[]},{"slug":"total-protein-test","title_ko":"총단백검사","title_en":"Total Protein Test","meaning":"혈청 내 알부민과 글로불린을 합한 총 단백질 농도를 측정하는 검사로, 영양상태·간기능·탈수 여부를 반영한다.","subcategory":"임상화학·혈액학검사","level":2,"related":["serum-protein-electrophoresis"],"prerequisites":[],"pop":12},{"slug":"creatine-kinase","title_ko":"크레아틴키나아제","title_en":"Creatine Kinase (CK)","meaning":"근육, 심장, 뇌 조직에 존재하는 효소로, 근육 손상이나 심근경색 시 혈중 농도가 상승한다.","subcategory":"임상화학·혈액학검사","level":1,"related":["aspartate-aminotransferase","lactate-dehydrogenase"],"prerequisites":[],"pop":13,"aliases":["CK"]},{"slug":"amylase-test","title_ko":"아밀라아제검사","title_en":"Amylase Test","meaning":"주로 췌장과 침샘에서 분비되는 탄수화물 분해효소로, 급성췌장염 진단에 사용되는 혈청 효소검사이다.","subcategory":"임상화학·혈액학검사","level":1,"related":["lactate-dehydrogenase","total-bilirubin","creatine-kinase"],"prerequisites":["total-bilirubin","creatine-kinase"]},{"slug":"triglyceride-test","title_ko":"중성지방검사","title_en":"Triglyceride Test","meaning":"혈액 내 중성지방(트리글리세리드) 농도를 측정하는 검사로, 식이 지방 섭취와 대사 상태를 반영하며 심혈관질환 및 급성췌장염…","subcategory":"임상화학·혈액학검사","level":2,"related":["hdl-cholesterol","ldl-cholesterol","amylase-test"],"prerequisites":["hdl-cholesterol","ldl-cholesterol"],"aliases":["TG검사","트리글리세라이드검사"]},{"slug":"hdl-cholesterol","title_ko":"HDL콜레스테롤","title_en":"High-Density Lipoprotein Cholesterol (HDL-C)","meaning":"말초조직의 콜레스테롤을 간으로 역수송하는 고밀도지단백에 포함된 콜레스테롤 농도로, 심혈관계에 보호적으로 작용하는 지표이다.","subcategory":"임상화학·혈액학검사","level":1,"related":["ldl-cholesterol","triglyceride-test"],"prerequisites":[],"aliases":["HDL-C","HDLC"]},{"slug":"ldl-cholesterol","title_ko":"LDL콜레스테롤","title_en":"Low-Density Lipoprotein Cholesterol (LDL-C)","meaning":"간에서 말초조직으로 콜레스테롤을 운반하는 저밀도지단백에 포함된 콜레스테롤 농도로, 동맥경화의 대표적 위험 인자이다.","subcategory":"임상화학·혈액학검사","level":1,"related":["hdl-cholesterol","triglyceride-test","apolipoprotein-b"],"prerequisites":[],"pop":9,"aliases":["LDL-C","LDLC"]},{"slug":"apolipoprotein-b","title_ko":"아포지단백B","title_en":"Apolipoprotein B","meaning":"LDL을 포함한 죽상경화 유발성 지단백 입자마다 하나씩 존재하는 단백질로, 이러한 입자의 총 개수를 반영하는 지표이다.","subcategory":"임상화학·혈액학검사","level":2,"related":["ldl-cholesterol","triglyceride-test"],"prerequisites":["ldl-cholesterol"],"pop":5},{"slug":"crossmatch-test","title_ko":"교차시험","title_en":"Crossmatch Test","meaning":"수혈 전 공혈자 적혈구와 수혈받을 환자의 혈청을 직접 반응시켜 응집이나 용혈이 일어나지 않는지 확인하는 최종 적합성 검사이다.","subcategory":"임상화학·혈액학검사","level":1,"related":["antibody-screening-test"],"prerequisites":[]},{"slug":"antibody-screening-test","title_ko":"항체선별검사","title_en":"Antibody Screening Test","meaning":"환자 혈청을 항원이 알려진 선별세포와 반응시켜 임상적으로 의미 있는 적혈구 동종항체의 존재 여부를 확인하는 수혈 전 필수…","subcategory":"임상화학·혈액학검사","level":1,"related":["crossmatch-test"],"prerequisites":[],"pop":7},{"slug":"colorimetry","title_ko":"비색법","title_en":"Colorimetry","meaning":"화학반응으로 생성된 유색 물질의 흡광도를 특정 파장에서 측정하여 물질의 농도를 정량하는 임상화학의 기본 분석법이다.","subcategory":"임상화학·혈액학검사","level":2,"related":["total-bilirubin","hemolysis-index-test"],"prerequisites":["total-bilirubin","hemolysis-index-test"],"pop":1},{"slug":"accuracy","title_ko":"정확도","title_en":"Accuracy","meaning":"측정값이 참값(또는 기준방법으로 얻은 값)에 얼마나 근접한지를 나타내는 지표로, 계통오차의 크기를 반영한다.","subcategory":"임상화학·혈액학검사","level":1,"related":["precision","coefficient-of-variation"],"prerequisites":[]},{"slug":"sensitivity","title_ko":"민감도","title_en":"Sensitivity","meaning":"실제 질병이 있는 사람 중 검사에서 양성으로 올바르게 판정된 비율로, 질병을 놓치지 않는 능력을 나타내는 진단검사의 성능…","subcategory":"임상화학·혈액학검사","level":1,"related":["specificity","positive-predictive-value","roc-curve"],"prerequisites":[],"aliases":["예민도"]},{"slug":"specificity","title_ko":"특이도","title_en":"Specificity","meaning":"실제 질병이 없는 사람 중 검사에서 음성으로 올바르게 판정된 비율로, 건강한 사람을 정확히 걸러내는 능력을 나타내는 지표이다.","subcategory":"임상화학·혈액학검사","level":1,"related":["sensitivity","positive-predictive-value","roc-curve","false-positive"],"prerequisites":[]},{"slug":"positive-predictive-value","title_ko":"양성예측도","title_en":"Positive Predictive Value (PPV)","meaning":"검사에서 양성으로 나온 사람 중 실제로 질병이 있는 사람의 비율로, 질병의 유병률에 따라 값이 크게 달라지는 지표이다.","subcategory":"임상화학·혈액학검사","level":2,"related":["sensitivity","specificity","roc-curve","sensitivity-specificity","confidence-interval"],"prerequisites":["sensitivity","specificity"],"pop":20,"aliases":["PPV","양성적중률","Positive Predictive Value"]},{"slug":"false-positive","title_ko":"위양성","title_en":"False Positive","meaning":"실제로는 질병이 없는데 검사 결과가 양성으로 잘못 나온 경우로, 특이도가 낮을수록 발생 빈도가 높아진다.","subcategory":"임상화학·혈액학검사","level":1,"related":["specificity","positive-predictive-value","sensitivity"],"prerequisites":["specificity","positive-predictive-value"],"pop":19,"aliases":["가양성"]},{"slug":"poikilocytosis","title_ko":"적혈구모양부등증","title_en":"Poikilocytosis","meaning":"말초혈액도말에서 적혈구의 모양이 정상적인 원반형에서 벗어나 다양하게 변형된 소견을 통칭하며, 구상적혈구·표적세포·파쇄적혈구…","subcategory":"임상화학·혈액학검사","level":1,"related":[],"prerequisites":[]},{"slug":"sickle-cell","title_ko":"낫적혈구","title_en":"Sickle Cell","meaning":"비정상 혈색소(HbS)가 저산소 상태에서 중합되어 낫 모양으로 변형된 적혈구로, 겸상적혈구빈혈의 특징적인 소견이다.","subcategory":"임상화학·혈액학검사","level":2,"related":["poikilocytosis","reticulocyte-count","hemolysis-index-test"],"prerequisites":["poikilocytosis"]},{"slug":"dohle-body","title_ko":"톨체","title_en":"Dohle Body","meaning":"호중구 세포질에 나타나는 옅은 청회색의 봉입체로, 조면소포체 잔여물로 구성되며 심한 감염이나 염증 시 독성변화의 일부로…","subcategory":"임상화학·혈액학검사","level":3,"related":["left-shift"],"prerequisites":["left-shift"]},{"slug":"teardrop-cell","title_ko":"눈물방울적혈구","title_en":"Teardrop Cell","meaning":"한쪽이 눈물방울처럼 뾰족하게 늘어난 모양의 적혈구로, 골수가 섬유조직으로 대체되는 골수섬유증에서 특징적으로 관찰된다.","subcategory":"임상화학·혈액학검사","level":3,"related":["poikilocytosis"],"prerequisites":["poikilocytosis"]},{"slug":"osmolality-test","title_ko":"삼투압검사","title_en":"Osmolality Test","meaning":"혈청 또는 소변에 녹아있는 모든 용질 입자의 총 농도를 측정하는 검사로, 체액 균형 이상이나 중독물질 평가에 사용된다.","subcategory":"임상화학·혈액학검사","level":3,"related":["urine-specific-gravity"],"prerequisites":[]},{"slug":"procalcitonin-test","title_ko":"프로칼시토닌검사","title_en":"Procalcitonin Test","meaning":"세균 감염 시 여러 조직에서 생성이 증가하는 칼시토닌 전구물질을 측정하는 검사로, 세균감염과 바이러스감염 및 패혈증 중증도…","subcategory":"임상화학·혈액학검사","level":3,"related":["white-blood-cell-count"],"prerequisites":["white-blood-cell-count"],"aliases":["PCT"]},{"slug":"transferrin-saturation","title_ko":"트랜스페린포화도","title_en":"Transferrin Saturation","meaning":"혈청철을 총철결합능으로 나누어 백분율로 나타낸 값으로, 트랜스페린 단백질이 철로 얼마나 채워져 있는지를 나타내는 지표이다.","subcategory":"임상화학·혈액학검사","level":3,"related":["hemolysis-index-test"],"prerequisites":["hemolysis-index-test"],"pop":14},{"slug":"vitamin-b12-folate-test","title_ko":"비타민B12엽산검사","title_en":"Vitamin B12 and Folate Test","meaning":"적혈구의 정상적인 DNA 합성과 성숙에 필요한 비타민B12와 엽산의 혈중 농도를 측정하는 검사로, 대적혈구성 빈혈의 원인…","subcategory":"임상화학·혈액학검사","level":3,"related":["mean-corpuscular-volume","reticulocyte-count"],"prerequisites":["mean-corpuscular-volume","reticulocyte-count"],"aliases":["VBFT"]},{"slug":"hemolysis-index-test","title_ko":"용혈검사","title_en":"Hemolysis Index Test","meaning":"혈청 또는 혈장 검체 내 유리 혈색소로 인한 붉은색 정도를 지수화하여 검체의 용혈 여부와 정도를 판정하는 검사로, 검체…","subcategory":"임상화학·혈액학검사","level":1,"related":["lactate-dehydrogenase","colorimetry","reticulocyte-count"],"prerequisites":[]},{"slug":"blood-culture","title_ko":"혈액배양검사","title_en":"Blood Culture","meaning":"환자의 혈액을 채취하여 호기성 및 혐기성 배양병에 접종한 후 균의 증식 여부를 관찰함으로써 균혈증이나 패혈증의 원인균을…","subcategory":"미생물·면역혈청검사","level":1,"related":["sputum-culture"],"prerequisites":[],"pop":16},{"slug":"sputum-culture","title_ko":"객담배양검사","title_en":"Sputum Culture","meaning":"환자가 기침으로 배출한 가래를 배지에 접종하여 호흡기 감염의 원인균을 분리·동정하는 미생물검사입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":["blood-culture","acid-fast-stain","colony-forming-unit"],"prerequisites":[]},{"slug":"stool-culture","title_ko":"대변배양검사","title_en":"Stool Culture","meaning":"설사나 장염 증상이 있는 환자의 대변을 선택배지에 접종하여 살모넬라, 시겔라 등 장병원성 세균을 분리하는 검사입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":["selective-media"],"prerequisites":[]},{"slug":"wound-culture","title_ko":"창상배양검사","title_en":"Wound Culture","meaning":"상처 부위의 삼출물이나 조직을 채취하여 배지에 접종함으로써 창상감염의 원인균을 확인하는 검사입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":["blood-agar","anaerobic-culture"],"prerequisites":["blood-agar","anaerobic-culture"],"pop":6},{"slug":"acid-fast-stain","title_ko":"항산성염색","title_en":"Acid-Fast Stain","meaning":"세포벽에 지질 성분이 많은 결핵균 등 항산균을 검출하기 위해 산으로 탈색되지 않는 특성을 이용하는 특수 염색법입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":["sputum-culture"],"prerequisites":[],"aliases":["AFB염색","항산균염색"]},{"slug":"blood-agar","title_ko":"혈액한천배지","title_en":"Blood Agar","meaning":"양의 혈액을 첨가한 배지로 세균의 용혈 양상을 관찰하고 대부분의 병원균을 배양할 수 있는 대표적인 범용 배지입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":[],"prerequisites":[]},{"slug":"selective-media","title_ko":"선택배지","title_en":"Selective Media","meaning":"특정 억제 성분을 첨가하여 원하는 균만 자라게 하고 다른 균의 발육은 억제하는 배지입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":[],"prerequisites":[]},{"slug":"anaerobic-culture","title_ko":"혐기성배양","title_en":"Anaerobic Culture","meaning":"산소가 없는 환경을 조성한 혐기성 배양기나 배양병을 이용해 산소에 노출되면 죽는 혐기성 세균을 배양하는 방법입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":["blood-culture","wound-culture","transport-medium","colony-forming-unit"],"prerequisites":[]},{"slug":"colony-forming-unit","title_ko":"집락형성단위","title_en":"Colony Forming Unit","meaning":"배지 위에서 하나의 집락을 형성할 수 있는 생존 세균 또는 세포의 수를 나타내는 정량 단위입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":["blood-culture","wound-culture"],"prerequisites":[],"aliases":["CFU"]},{"slug":"kirby-bauer-disk-diffusion","title_ko":"디스크확산법","title_en":"Kirby-Bauer Disk Diffusion Method","meaning":"항생제가 함유된 종이디스크를 배지에 올려 균 억제환의 크기를 측정함으로써 감수성 여부를 판정하는 검사법입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":["e-test"],"prerequisites":[],"aliases":["KBDDM"]},{"slug":"e-test","title_ko":"이테스트","title_en":"E-test","meaning":"농도구배가 인쇄된 시험지를 배지에 올려 억제타원과 눈금이 만나는 지점으로 최소억제농도를 직접 읽을 수 있는 검사법입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":["kirby-bauer-disk-diffusion"],"prerequisites":[],"aliases":["Etest","E테스트","이-테스트","엡실로미터 검사","Epsilometer test","농도구배 스트립법","농도구배확산법","gradient diffusion test","gradient strip test"]},{"slug":"lateral-flow-immunoassay","title_ko":"측면유동면역분석법(LFIA)","title_en":"Lateral Flow Immunoassay","meaning":"검체가 스트립을 따라 모세관 현상으로 이동하며 표지항체와 반응해 짧은 시간 안에 결과선을 보여주는 신속면역검사 방식입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":["elisa"],"prerequisites":[],"aliases":["측방유동면역분석법","LFIA","면역크로마토그래피 스트립","Immunochromatographic Strip","면역크로마토그래피스트립","측방유동면역분석법(LFIA)"]},{"slug":"widal-test","title_ko":"위달반응","title_en":"Widal Test","meaning":"장티푸스 및 파라티푸스 원인균의 O항원과 H항원에 대한 응집항체가를 측정하여 장열 감염을 진단하는 혈청응집검사입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":[],"prerequisites":[],"pop":3},{"slug":"aso-test","title_ko":"ASO검사","title_en":"Antistreptolysin O Test","meaning":"연쇄구균이 분비하는 스트렙토라이신 O에 대한 항체 수치를 측정하여 최근 연쇄구균 감염 여부를 확인하는 혈청검사입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":[],"prerequisites":[],"aliases":["항스트렙토리신O검사"]},{"slug":"anti-ccp-antibody-test","title_ko":"항CCP항체검사","title_en":"Anti-Cyclic Citrullinated Peptide Antibody Test","meaning":"고리형 시트룰린화 펩타이드에 대한 자가항체를 검출하여 류마티스관절염 진단에 높은 특이도를 갖는 표지자로 활용되는 검사입니다.","subcategory":"미생물·면역혈청검사","level":3,"related":["elisa"],"prerequisites":[],"pop":15},{"slug":"anti-smooth-muscle-antibody-test","title_ko":"항평활근항체검사","title_en":"Anti-Smooth Muscle Antibody Test","meaning":"평활근 세포의 액틴 성분에 대한 자가항체를 검출하여 자가면역간염의 진단 보조지표로 활용되는 검사입니다.","subcategory":"미생물·면역혈청검사","level":3,"related":["elisa"],"prerequisites":[],"aliases":["ASMAT"]},{"slug":"routine-urinalysis","title_ko":"요일반검사","title_en":"Routine Urinalysis","meaning":"요시험지검사와 요침사검사를 함께 시행하여 소변의 이화학적 성분과 세포 성분을 종합적으로 평가하는 기본 요검사입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":[],"prerequisites":[],"aliases":["소변검사"]},{"slug":"urine-ketone-test","title_ko":"요케톤검사","title_en":"Urine Ketone Test","meaning":"지방 대사 과정에서 생성되는 케톤체가 소변으로 배출되는지 확인하여 당뇨병케톤산증이나 기아 상태를 평가하는 검사입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":["routine-urinalysis","urine-specific-gravity"],"prerequisites":[],"aliases":["UKT"]},{"slug":"urine-leukocyte-esterase-test","title_ko":"요백혈구에스테라제검사","title_en":"Urine Leukocyte Esterase Test","meaning":"소변 내 백혈구에서 유래하는 에스테라제 효소 활성을 검출하여 요로감염이나 염증 여부를 간접적으로 평가하는 검사입니다.","subcategory":"미생물·면역혈청검사","level":3,"related":[],"prerequisites":[],"pop":11,"aliases":["ULET"]},{"slug":"kato-katz-thick-smear-technique","title_ko":"셀로판후층도말법","title_en":"Kato-Katz Thick Smear Technique","meaning":"일정량의 대변을 셀로판지로 덮어 투명하게 만든 후 현미경으로 관찰하여 장내 기생충 알의 수를 정량하는 검사법입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":[],"prerequisites":[],"aliases":["KKTST"]},{"slug":"malaria-blood-smear","title_ko":"말라리아혈액도말검사","title_en":"Malaria Blood Smear","meaning":"말초혈액을 도말하고 염색한 후 현미경으로 관찰하여 말라리아 원충의 존재와 종류, 감염 정도를 확인하는 표준 진단검사입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":[],"prerequisites":[]},{"slug":"papanicolaou-smear","title_ko":"파파니콜라우도말검사","title_en":"Papanicolaou Smear","meaning":"자궁경부에서 채취한 세포를 유리슬라이드에 도말하고 특수 염색하여 자궁경부암 및 전암병변을 선별하는 세포병리검사입니다.","subcategory":"미생물·면역혈청검사","level":2,"related":[],"prerequisites":[],"aliases":["자궁경부세포검사","팹도말검사"]},{"slug":"ascitic-fluid-cytology","title_ko":"복수세포검사","title_en":"Ascitic Fluid Cytology","meaning":"복강에 고인 복수를 채취하여 세포를 관찰함으로써 악성종양의 복막 전이나 다른 원인을 감별하는 검사입니다.","subcategory":"미생물·면역혈청검사","level":3,"related":[],"prerequisites":[]},{"slug":"anti-hbs-test","title_ko":"B형간염표면항체검사","title_en":"Anti-HBs Test","meaning":"B형간염바이러스 표면항원에 대한 항체를 검출하여 과거 감염 회복이나 백신접종에 의한 면역 상태를 확인하는 검사입니다.","subcategory":"미생물·면역혈청검사","level":3,"related":["elisa"],"prerequisites":[],"aliases":["anti-HBs"]},{"slug":"koh-preparation","title_ko":"수산화칼륨도말검사","title_en":"KOH Preparation","meaning":"수산화칼륨 용액으로 각질 등 검체의 세포 성분을 녹여 투명하게 만든 후 현미경으로 진균의 균사나 포자를 직접 관찰하는…","subcategory":"미생물·면역혈청검사","level":2,"related":["sabouraud-dextrose-agar","acid-fast-stain"],"prerequisites":["acid-fast-stain"],"aliases":["KOH검사"]},{"slug":"sabouraud-dextrose-agar","title_ko":"사부로포도당한천배지","title_en":"Sabouraud Dextrose Agar","meaning":"높은 당 농도와 낮은 산도로 세균의 발육은 억제하면서 진균이 잘 자랄 수 있도록 고안된 진균 전용 배양배지입니다.","subcategory":"미생물·면역혈청검사","level":3,"related":["koh-preparation","blood-agar","selective-media"],"prerequisites":["blood-agar","selective-media"]},{"slug":"urea-breath-test","title_ko":"요소호기검사","title_en":"Urea Breath Test","meaning":"표지된 요소를 섭취한 뒤 헬리코박터파일로리균의 요소분해효소 활성으로 생성되는 이산화탄소를 호기 중에서 측정하는 비침습적…","subcategory":"미생물·면역혈청검사","level":2,"related":["elisa"],"prerequisites":[],"aliases":["UBT"]},{"slug":"bacteremia","title_ko":"균혈증","title_en":"Bacteremia","meaning":"정상적으로 무균 상태여야 할 혈류 내에 세균이 존재하는 상태로 혈액배양검사를 통해 확인되는 임상적 소견입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":["blood-culture","procalcitonin-test"],"prerequisites":["blood-culture"]},{"slug":"transport-medium","title_ko":"검체수송배지","title_en":"Transport Medium","meaning":"검체 채취 후 검사실로 이송하는 동안 균의 생존을 유지하고 과도한 증식을 억제하기 위해 사용하는 특수 배지입니다.","subcategory":"미생물·면역혈청검사","level":1,"related":["anaerobic-culture","wound-culture","blood-culture"],"prerequisites":["anaerobic-culture","wound-culture"]}]