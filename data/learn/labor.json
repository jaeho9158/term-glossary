[{"slug":"pluralist-perspective","title_ko":"다원주의 관점","title_en":"Pluralist Perspective","meaning":"사용자와 노동자는 서로 다른 정당한 이해관계를 가진 별개의 집단이며, 이 갈등은 단체교섭과 제도적 협상을 통해 조정되어야…","subcategory":"노사관계 이론","level":2,"related":[],"prerequisites":[],"aliases":["다원주의관점"]},{"slug":"bargaining-power","title_ko":"교섭력","title_en":"Bargaining Power","meaning":"단체교섭 과정에서 상대방에게 자신이 원하는 조건을 받아들이도록 압박할 수 있는 힘 또는 능력을 말합니다.","subcategory":"단체교섭","level":2,"related":["distributive-bargaining","bargaining-impasse"],"prerequisites":[],"pop":10},{"slug":"distributive-bargaining","title_ko":"분배적 교섭","title_en":"Distributive Bargaining","meaning":"정해진 크기의 이익을 노사가 서로 더 많이 차지하려고 경쟁하는 방식의 교섭을 말합니다.","subcategory":"단체교섭","level":2,"related":["bargaining-power","bargaining-impasse"],"prerequisites":[],"aliases":["분배적교섭"]},{"slug":"good-faith-bargaining","title_ko":"성실교섭의무","title_en":"Good Faith Bargaining","meaning":"노사 양 당사자가 단체교섭에 진지하고 성실한 자세로 임해야 한다는 법적, 윤리적 의무를 말합니다.","subcategory":"단체교섭","level":2,"related":["bargaining-impasse"],"prerequisites":[],"aliases":["GFB"]},{"slug":"bargaining-impasse","title_ko":"교섭 결렬","title_en":"Bargaining Impasse","meaning":"노사가 성실히 교섭을 진행했음에도 더 이상 진전이 없어 합의에 이르지 못하는 상태를 말합니다.","subcategory":"단체교섭","level":2,"related":["good-faith-bargaining","bargaining-power","distributive-bargaining"],"prerequisites":[],"aliases":["교섭결렬"]},{"slug":"union-security-clause","title_ko":"조합보장조항","title_en":"Union Security Clause","meaning":"단체협약에서 노동조합의 조직력과 재정 기반을 유지·강화하기 위해 조합원 자격과 관련된 사항을 규정한 조항을 말합니다.","subcategory":"단체협약","level":2,"related":[],"prerequisites":[],"aliases":["USC"]},{"slug":"wildcat-strike","title_ko":"비공인파업(살쾡이파업)","title_en":"Wildcat Strike","meaning":"노동조합 지도부의 공식 승인이나 절차 없이 현장 근로자들이 자발적으로 벌이는 파업입니다.","subcategory":"쟁의행위","level":2,"related":["sympathy-strike","general-strike"],"prerequisites":[],"aliases":["비공인파업","살쾡이파업","비공식파업","Unofficial Strike"]},{"slug":"sympathy-strike","title_ko":"동정파업","title_en":"Sympathy Strike","meaning":"자신의 근로조건과 직접 관련이 없더라도 다른 사업장 노동자의 쟁의행위를 지지하기 위해 함께 벌이는 파업입니다.","subcategory":"쟁의행위","level":2,"related":["general-strike","wildcat-strike"],"prerequisites":[]},{"slug":"general-strike","title_ko":"총파업","title_en":"General Strike","meaning":"특정 사업장을 넘어 산업 전반 또는 국가 전체의 노동자들이 동시에 벌이는 대규모 파업입니다.","subcategory":"쟁의행위","level":2,"related":["sympathy-strike"],"prerequisites":[],"pop":17},{"slug":"yellow-dog-contract","title_ko":"황견계약","title_en":"Yellow-dog Contract","meaning":"근로자를 채용하면서 노동조합에 가입하지 않거나 탈퇴할 것을 조건으로 내거는 근로계약으로, 대표적인 부당노동행위 유형입니다.","subcategory":"부당노동행위·구제","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["YDC"]},{"slug":"embeddedness-thesis","title_ko":"사회적 배태성 이론","title_en":"Embeddedness Thesis","meaning":"마크 그래노베터 등이 발전시킨 개념으로, 경제 행위와 노동시장 거래가 독립적으로 이루어지는 것이 아니라 사회적 관계망과…","subcategory":"노사관계 이론","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["사회적배태성이론"]},{"slug":"side-letter-agreement","title_ko":"부속합의서","title_en":"Side Letter Agreement","meaning":"본 단체협약과 별개로 특정 사안이나 예외 사항에 대해 노사가 추가로 작성하여 협약을 보충하는 부속 문서입니다.","subcategory":"단체협약","level":2,"related":[],"prerequisites":[],"pop":3},{"slug":"cease-and-desist-order","title_ko":"중지명령","title_en":"Cease-and-Desist Order","meaning":"노동위원회 등 구제기관이 사용자의 부당노동행위가 인정될 경우 해당 행위를 즉시 중단하고 원상회복하도록 명령하는 행정적 구제…","subcategory":"부당노동행위·구제","level":2,"related":[],"prerequisites":[],"pop":7},{"slug":"insider-outsider-theory","title_ko":"내부자-외부자 이론","title_en":"Insider-Outsider Theory","meaning":"내부자-외부자 이론이란 이미 고용되어 있는 근로자(내부자)가 노동조합이나 협상력을 통해 자신의 임금과 고용 조건을 지키는…","subcategory":"노동시장","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["내부자 외부자 이론","내부자-외부자이론","내부자외부자 이론"]},{"slug":"employee-engagement","title_ko":"종업원 인게이지먼트","title_en":"Employee Engagement","meaning":"종업원이 자신의 업무 역할에 활력과 헌신, 몰두를 가지고 심리적으로 충만하게 참여하는 긍정적이고 지속적인 동기 상태를…","subcategory":"조직행동·태도","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["종업원인게이지먼트"]},{"slug":"job-hazard-analysis","title_ko":"직무위험성평가","title_en":"Job Hazard Analysis","meaning":"특정 직무나 작업 공정을 단계별로 분석해 잠재적 위험 요소를 찾아내고 예방 대책을 마련하는 산업안전 평가 절차입니다.","subcategory":"근로조건·안전보건","level":2,"related":["just-cause-doctrine"],"prerequisites":[],"pop":2,"aliases":["Job Hazard Analysis","JHA"]},{"slug":"just-cause-doctrine","title_ko":"정당한 사유 원칙","title_en":"Just Cause Doctrine","meaning":"사용자가 근로자를 징계하거나 해고할 때는 합리적이고 정당한 사유가 있어야 한다는 원칙을 말합니다.","subcategory":"노동법·권리","level":2,"related":["job-hazard-analysis"],"prerequisites":[],"pop":5,"aliases":["Just Cause Doctrine","정당한사유원칙"]}]