[{"slug":"free-radical","title_ko":"자유라디칼","title_en":"Free Radical","meaning":"짝을 이루지 못한 전자를 하나 이상 가지고 있어서 다른 물질과 매우 빠르게 반응하는 불안정한 원자나 분자입니다.","subcategory":"화학반응·물질구조","level":1,"related":["redox-reaction","isotope","enthalpy"],"prerequisites":[],"pop":3,"aliases":["자유기","라디칼"]},{"slug":"type-3-hypersensitivity","title_ko":"제3형 과민반응","title_en":"Type III Hypersensitivity","meaning":"항원-항체 면역복합체가 혈관이나 조직에 침착되어 보체를 활성화시키고 국소 염증과 조직 손상을 일으키는 과민반응.","subcategory":"질병·병리","level":3,"related":["type-4-hypersensitivity"],"prerequisites":[],"pop":6,"aliases":["면역복합체과민반응","제3형과민반응"]},{"slug":"type-4-hypersensitivity","title_ko":"제4형 과민반응","title_en":"Type IV Hypersensitivity","meaning":"항체가 아니라 감작된 T세포가 매개하여 항원 재노출 후 24~72시간에 걸쳐 지연되어 나타나는 과민반응.","subcategory":"질병·병리","level":3,"related":["cd4-helper-t-cell","type-3-hypersensitivity"],"prerequisites":[],"pop":7,"aliases":["지연형과민반응","제4형과민반응"]},{"slug":"high-throughput-screening","title_ko":"고속대량스크리닝","title_en":"high-throughput screening (HTS)","meaning":"자동화 로봇 장비를 이용해 수만에서 수백만 개의 화합물을 짧은 시간 안에 검사해 활성 화합물을 찾아내는 기법입니다.","subcategory":"제제학·의약품화학","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["HTS","High-Throughput Screening"]},{"slug":"dose-response-relationship","title_ko":"용량-반응 관계","title_en":"Dose-Response Relationship","meaning":"물질에 노출되는 용량이 변할 때 생물체에 나타나는 반응의 정도가 어떻게 달라지는지를 나타내는 관계입니다.","subcategory":"용량-반응관계","level":2,"related":[],"prerequisites":[],"aliases":["용량 반응관계","용량반응관계"]},{"slug":"absorption-toxicokinetics","title_ko":"흡수","title_en":"Absorption","meaning":"물질이 노출 부위(소화관, 폐, 피부 등)를 통과해 혈류로 이동하는 과정입니다.","subcategory":"독동태학","level":2,"related":["tissue-distribution"],"prerequisites":[]},{"slug":"tissue-distribution","title_ko":"조직분포","title_en":"Tissue Distribution","meaning":"혈류로 흡수된 물질이 몸 안의 여러 장기와 조직으로 퍼져나가는 과정입니다.","subcategory":"독동태학","level":2,"related":["absorption-toxicokinetics"],"prerequisites":[],"pop":12},{"slug":"glutathione-conjugation","title_ko":"글루타티온포합","title_en":"Glutathione Conjugation","meaning":"친전자성 화합물이나 반응성대사체에 글루타티온을 결합시켜 독성을 중화하고 배출이 쉬운 형태로 바꾸는 대표적인 제2상 해독…","subcategory":"생체전환·대사","level":2,"related":[],"prerequisites":[],"aliases":["글루타치온 포합"]},{"slug":"glucuronidation","title_ko":"글루쿠론산포합","title_en":"Glucuronidation","meaning":"UDP-글루쿠론산전이효소의 촉매로 화합물에 글루쿠론산을 결합시켜 수용성을 높이고 체외 배출을 촉진하는 대표적인 제2상 대사…","subcategory":"생체전환·대사","level":2,"related":["glutathione-conjugation"],"prerequisites":[],"pop":8,"aliases":["글루쿠로니드화"]},{"slug":"reproductive-toxicity","title_ko":"생식독성","title_en":"Reproductive Toxicity","meaning":"물질이 남녀의 생식기능, 생식능력(수정, 임신, 출산 등) 또는 자손의 발생 과정에 부정적인 영향을 미치는 독성을 통틀어…","subcategory":"생식발생독성","level":2,"related":[],"prerequisites":[],"pop":10},{"slug":"risk-characterization","title_ko":"위해도결정","title_en":"Risk Characterization","meaning":"위험성 확인, 용량-반응평가, 노출평가 결과를 종합해 특정 조건에서 사람이나 환경에 실제로 해로운 영향이 발생할 가능성과…","subcategory":"위해성평가","level":2,"related":[],"prerequisites":[]},{"slug":"biological-exposure-index","title_ko":"생물학적노출지수","title_en":"Biological Exposure Index","meaning":"혈액, 소변, 호기 등 생체 시료에서 측정한 화학물질 또는 그 대사산물 농도를 기준으로 실제 체내 노출 수준을 판정하는…","subcategory":"산업·직업독성학","level":2,"related":[],"prerequisites":[],"pop":9,"aliases":["BEI"]},{"slug":"anticholinergic-toxidrome","title_ko":"항콜린성독성증후군","title_en":"Anticholinergic Toxidrome","meaning":"아세틸콜린의 작용을 차단하는 물질에 중독되었을 때 나타나는 피부 건조, 동공 확대, 발열, 의식 변화 등의 특징적인 임상…","subcategory":"임상독성학","level":2,"related":[],"prerequisites":[],"pop":13,"aliases":["Anticholinergic Toxidrome"]},{"slug":"dna-repair-mechanism","title_ko":"DNA복구기전","title_en":"DNA Repair Mechanism","meaning":"DNA복구기전은 세포가 다양한 원인으로 손상된 DNA를 원래 상태로 되돌리기 위해 작동시키는 일련의 생화학적 과정을 말합니다.","subcategory":"유전독성","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["DNA Repair Mechanism"]},{"slug":"lethal-dose","title_ko":"치사용량","title_en":"Lethal Dose","meaning":"실험 대상 중 특정 비율이 사망에 이르는 데 필요한 물질의 투여량을 뜻하며, 경구·경피 등 노출 경로를 통해 체내로 들어간…","subcategory":"용량-반응관계","level":2,"related":[],"prerequisites":[],"aliases":["Lethal Dose"]},{"slug":"n-acetylcysteine-antidote","title_ko":"N-아세틸시스테인해독제","title_en":"N-Acetylcysteine Antidote","meaning":"아세트아미노펜(파라세타몰) 중독 시 글루타치온 전구체를 보충해 간독성을 예방·치료하는 해독제입니다.","subcategory":"임상독성학","level":2,"related":[],"prerequisites":[],"pop":14,"aliases":["N-Acetylcysteine Antidote","N 아세틸시스테인해독제","N아세틸시스테인해독제"]},{"slug":"negative-control-toxicology","title_ko":"음성대조군","title_en":"Negative Control","meaning":"시험물질을 전혀 처리하지 않거나 독성이 없다고 알려진 조건으로 두어, 시험물질 처리군과 비교할 기준선을 제공하는 대조군입니다.","subcategory":"독성시험법","level":2,"related":["positive-control-toxicology"],"prerequisites":[],"pop":2,"aliases":["Negative Control"]},{"slug":"pesticide-residue","title_ko":"농약잔류물","title_en":"Pesticide Residue","meaning":"농작물, 토양, 물 등에 농약을 사용한 후에도 분해되지 않고 남아 있는 농약 성분이나 그 대사산물을 말합니다.","subcategory":"환경독성학","level":2,"related":[],"prerequisites":[],"aliases":["Pesticide Residue"]},{"slug":"positive-control-toxicology","title_ko":"양성대조군","title_en":"Positive Control","meaning":"이미 특정한 반응을 일으킨다고 알려진 물질을 처리하여 시험 시스템이 그 반응을 제대로 검출할 수 있는지 확인하기 위해…","subcategory":"독성시험법","level":2,"related":["negative-control-toxicology"],"prerequisites":[],"pop":1,"aliases":["Positive Control"]},{"slug":"sensitive-subpopulation","title_ko":"민감집단","title_en":"Sensitive Subpopulation","meaning":"민감집단은 유아, 임산부, 노인, 기저질환자 등 일반 인구집단보다 특정 유해물질에 더 취약하게 반응하는 인구군을 뜻합니다.","subcategory":"위해성평가","level":2,"related":[],"prerequisites":[],"aliases":["Sensitive Subpopulation"]},{"slug":"sigmoidal-dose-response-curve","title_ko":"S자형용량-반응곡선","title_en":"Sigmoidal Dose-Response Curve","meaning":"용량을 로그 척도로 나타냈을 때 반응이 낮은 용량에서 서서히 증가하다가 중간 구간에서 급격히 상승한 후 다시 완만해지는 S자…","subcategory":"용량-반응관계","level":2,"related":[],"prerequisites":[],"aliases":["Sigmoidal Dose-Response Curve","SDRC","S자형용량 반응곡선","S자형용량반응곡선"]},{"slug":"vitreous-humor-analysis","title_ko":"유리체액분석","title_en":"Vitreous Humor Analysis","meaning":"안구 내부를 채우고 있는 유리체액을 채취하여 약물이나 알코올, 전해질 농도를 측정함으로써 사후 독성 분석과 사망 시각 추정에…","subcategory":"법독성학","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["Vitreous Humor Analysis","VHA"]}]