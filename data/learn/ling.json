[{"slug":"validity","title_ko":"타당도","title_en":"Validity","meaning":"측정 도구가 측정하려는 개념을 실제로 얼마나 정확히 재는지의 정도.","subcategory":"설문·척도","level":1,"related":["reliability","likert-scale","construct"],"prerequisites":[],"aliases":["타당성"]},{"slug":"reliability","title_ko":"신뢰도","title_en":"Reliability","meaning":"같은 측정을 반복했을 때 결과가 얼마나 일관되게 나오는지의 정도.","subcategory":"설문·척도","level":1,"related":["validity","likert-scale","construct","content-analysis","split-half-reliability","cronbachs-alpha","internal-consistency-reliability"],"prerequisites":[],"pop":8,"aliases":["신뢰성","Educational Evaluation","Reliability (Educational Evaluation)"]},{"slug":"chunking-memory","title_ko":"청킹","title_en":"Chunking","meaning":"낱개의 정보들을 의미 있는 더 큰 단위로 묶어서 기억하면 한 번에 다룰 수 있는 정보의 양이 늘어나는 현상이다.","subcategory":"인지심리","level":1,"related":["working-memory","spacing-effect","cognitive-load","metacognition-child","note-taking-technique"],"prerequisites":[],"aliases":["덩이짓기","Chunking in Interpreting"]},{"slug":"scaffolding","title_ko":"스캐폴딩","title_en":"Scaffolding","meaning":"학습자가 근접발달영역 내의 과제를 해결할 수 있도록 교사나 유능한 타인이 제공하는 임시적이고 점차 줄어드는 지원이다.","subcategory":"교육과정·교수학습이론","level":1,"related":["cognitive-apprenticeship"],"prerequisites":[],"pop":2,"aliases":["발판","발판화"]},{"slug":"morpheme-root","title_ko":"어근","title_en":"root","meaning":"단어의 핵심 의미를 담고 있으며 더 이상 형태론적으로 분석할 수 없는 최소 단위로, 접사가 결합되는 기저 요소이다.","subcategory":"형태론·통사론·의미화용론 심화","level":1,"related":["morphological-base"],"prerequisites":[],"pop":13},{"slug":"morphological-base","title_ko":"어기","title_en":"base","meaning":"특정 형태론적 조작(굴절 또는 파생)이 적용되는 출발점이 되는 형태로, 어근일 수도 있고 이미 파생된 어간일 수도 있는…","subcategory":"형태론·통사론·의미화용론 심화","level":3,"related":["morpheme-root"],"prerequisites":["morpheme-root"],"pop":3},{"slug":"interfix","title_ko":"개재접사","title_en":"interfix","meaning":"두 어근이나 어기 사이에 삽입되어 형태음운적 연결을 매개하지만 그 자체로는 독립적 의미 기능이 없는 접사이다.","subcategory":"형태론·통사론·의미화용론 심화","level":1,"related":[],"prerequisites":[],"aliases":["연결접사"]},{"slug":"suppletion","title_ko":"보충법","title_en":"suppletion","meaning":"동일한 굴절 계열체 안에서 형태적으로 전혀 관련이 없는 어형이 규칙적인 굴절형을 대신하여 나타나는 현상이다.","subcategory":"형태론·통사론·의미화용론 심화","level":1,"related":[],"prerequisites":[],"aliases":["보충형"]},{"slug":"portmanteau-morph","title_ko":"포트만토형태","title_en":"portmanteau morph","meaning":"둘 이상의 형태론적 자질이나 기능이 하나의 형태소 안에 동시에 융합되어 실현되는 형태를 말한다.","subcategory":"형태론·통사론·의미화용론 심화","level":3,"related":[],"prerequisites":[],"pop":15,"aliases":["혼성형태소"]},{"slug":"blending-morphology","title_ko":"혼성조어","title_en":"blending","meaning":"두 단어의 일부분을 결합하여 두 단어의 의미를 모두 반영하는 새로운 단어를 만드는 조어 방식이다.","subcategory":"형태론·통사론·의미화용론 심화","level":2,"related":[],"prerequisites":[],"aliases":["블렌딩","혼성어"]},{"slug":"noun-incorporation","title_ko":"명사포합","title_en":"noun incorporation","meaning":"목적어나 다른 논항 명사가 동사 어간에 결합되어 하나의 복합 동사 형태를 이루는 형태통사적 현상이다.","subcategory":"형태론·통사론·의미화용론 심화","level":2,"related":["valency","argument-structure"],"prerequisites":["argument-structure"]},{"slug":"argument-structure","title_ko":"논항구조","title_en":"argument structure","meaning":"동사나 술어가 요구하는 논항의 수와 그 논항들이 갖는 통사·의미적 속성을 명세한 어휘 정보를 말한다.","subcategory":"형태론·통사론·의미화용론 심화","level":1,"related":["valency"],"prerequisites":[],"pop":10},{"slug":"valency","title_ko":"결합가","title_en":"valency","meaning":"술어가 문법적으로 요구하는 필수 논항의 수를 가리키는 개념으로, 화학의 원자가 개념에서 차용되었다.","subcategory":"형태론·통사론·의미화용론 심화","level":2,"related":["argument-structure"],"prerequisites":["argument-structure"],"pop":5,"aliases":["밸런시"]},{"slug":"unaccusative-verb","title_ko":"비대격동사","title_en":"unaccusative verb","meaning":"표면상 자동사이지만 그 유일 논항이 심층적으로 목적어(내부논항)의 통사적 지위를 갖는다고 분석되는 동사 부류이다.","subcategory":"형태론·통사론·의미화용론 심화","level":1,"related":["unergative-verb"],"prerequisites":[],"pop":12},{"slug":"unergative-verb","title_ko":"비능격동사","title_en":"unergative verb","meaning":"자동사이지만 그 유일 논항이 통사적으로 외부논항(주어) 지위를 가진다고 분석되는 동사 부류로, 흔히 행위자적 의미를 갖는다.","subcategory":"형태론·통사론·의미화용론 심화","level":2,"related":["unaccusative-verb","argument-structure"],"prerequisites":["unaccusative-verb","argument-structure"],"pop":11},{"slug":"telicity","title_ko":"완결성","title_en":"telicity","meaning":"사건이 자연스러운 내적 종결점을 가지는지 여부를 나타내는 상적 자질로, 완결적 사건과 비완결적 사건을 구분한다.","subcategory":"형태론·통사론·의미화용론 심화","level":2,"related":["aspectual-classes-vendler"],"prerequisites":[],"pop":9,"aliases":["종결성","텔리시티"]},{"slug":"aspectual-classes-vendler","title_ko":"벤들러의동사부류(상적유형)","title_en":"Vendler's aspectual classes","meaning":"벤들러가 제안한 상태, 활동, 완성, 달성이라는 네 가지 사건 유형 분류로, 지속성과 완결성 등의 자질로 술어를 구분한다.","subcategory":"형태론·통사론·의미화용론 심화","level":3,"related":["telicity"],"prerequisites":["telicity"],"pop":1,"aliases":["벤들러의동사부류","상적유형"]},{"slug":"folk-etymology","title_ko":"민간어원","title_en":"Folk Etymology","meaning":"실제 어원과 무관하게 화자들이 익숙한 단어나 형태에 유추하여 재해석함으로써 단어의 형태나 의미가 변화하는 현상.","subcategory":"역사언어학·사회언어학·응용언어학","level":2,"related":["semantic-change"],"prerequisites":["semantic-change"],"aliases":["통속어원"]},{"slug":"semantic-change","title_ko":"의미변화","title_en":"Semantic Change","meaning":"시간이 지나면서 한 단어가 나타내는 의미의 범위나 내용이 확장, 축소, 이동 등의 방식으로 달라지는 현상.","subcategory":"역사언어학·사회언어학·응용언어학","level":1,"related":["folk-etymology"],"prerequisites":[]},{"slug":"wave-model","title_ko":"파동모형","title_en":"Wave Model","meaning":"언어변화가 특정 지점에서 시작되어 물결처럼 인접 지역으로 확산되며, 여러 변화가 중첩되어 방언 간 경계가 겹치고 교차할 수…","subcategory":"역사언어학·사회언어학·응용언어학","level":1,"related":[],"prerequisites":[],"aliases":["파동설","파상설"]},{"slug":"elision","title_ko":"음탈락","title_en":"Elision","meaning":"빠른 발화나 음운 환경의 영향으로 단어 안의 특정 음소가 생략되어 발음되지 않게 되는 현상.","subcategory":"역사언어학·사회언어학·응용언어학","level":2,"related":["assimilation-phonology"],"prerequisites":[],"aliases":["탈락"]},{"slug":"dissimilation","title_ko":"이화","title_en":"Dissimilation","meaning":"인접하거나 가까운 위치의 두 음소가 서로 비슷해지는 대신 오히려 더 달라지는 방향으로 변하는 음운 현상. 동화와 반대되는…","subcategory":"역사언어학·사회언어학·응용언어학","level":3,"related":["assimilation-phonology"],"prerequisites":[],"aliases":["이화작용"]},{"slug":"umlaut","title_ko":"움라우트","title_en":"Umlaut","meaning":"뒤 음절의 고모음이나 활음의 영향으로 앞 음절의 모음이 전설화되는 역행 동화의 한 유형. 게르만어파에서 특히 두드러지게…","subcategory":"역사언어학·사회언어학·응용언어학","level":3,"related":["assimilation-phonology"],"prerequisites":[],"aliases":["모음변이"]},{"slug":"chain-shift","title_ko":"연쇄추이","title_en":"Chain Shift","meaning":"한 모음이나 자음이 이동하면 그로 인해 생긴 음운 공간의 빈자리나 압박이 연쇄적으로 다른 음의 이동을 유발하는 체계적…","subcategory":"역사언어학·사회언어학·응용언어학","level":2,"related":[],"prerequisites":[],"pop":6},{"slug":"affective-filter-hypothesis","title_ko":"정의적여과가설","title_en":"Affective Filter Hypothesis","meaning":"불안, 동기, 자신감 등 학습자의 정서적 요인이 일종의 심리적 여과 장치로 작용하여 입력이 습득으로 이어지는 것을 촉진하거나…","subcategory":"역사언어학·사회언어학·응용언어학","level":3,"related":[],"prerequisites":[],"pop":7},{"slug":"audiolingual-method","title_ko":"청화식 교수법","title_en":"Audiolingual Method","meaning":"행동주의 심리학의 자극-반응-강화 원리에 기반하여, 반복적인 문형 연습과 암기를 통해 언어 습관을 형성하는 것을 목표로 한…","subcategory":"역사언어학·사회언어학·응용언어학","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["청화식교수법"]},{"slug":"n-gram","title_ko":"n-그램","title_en":"N-gram","meaning":"텍스트에서 연속으로 나타나는 n개의 단어(또는 문자) 연쇄. n의 값에 따라 유니그램, 바이그램, 트라이그램 등으로 불린다.","subcategory":"역사언어학·사회언어학·응용언어학","level":2,"related":[],"prerequisites":[],"pop":16,"aliases":["N그램"]},{"slug":"skopos-theory","title_ko":"스코포스이론","title_en":"Skopos theory","meaning":"한스 페르미어(Hans Vermeer)가 제창한 이론으로, 번역 행위의 목적(스코포스)이 번역 전략과 결과물을 결정하는…","subcategory":"번역학이론","level":1,"related":[],"prerequisites":[],"aliases":["목적이론","스코포스"]},{"slug":"preliminary-norms","title_ko":"예비규범","title_en":"preliminary norms","meaning":"투리의 규범 위계에서 어떤 텍스트를 번역 대상으로 선정할 것인지, 그리고 원문을 직접 번역할지 중간 언어를 거쳐 번역할지를…","subcategory":"번역학이론","level":1,"related":[],"prerequisites":[]},{"slug":"intra-system-shift","title_ko":"체계내전환","title_en":"intra-system shift","meaning":"캣포드의 범주전환 하위 유형으로, 원문과 목표어가 형식적으로 대응하는 문법 체계(예: 단수/복수 체계)를 공유함에도 특정…","subcategory":"번역학이론","level":3,"related":[],"prerequisites":[]},{"slug":"whispered-interpreting","title_ko":"위스퍼링통역","title_en":"whispered interpreting","meaning":"쉬쇼타주(chuchotage)라고도 불리며, 통역 장비 없이 통역사가 소수의 청자 옆에서 작은 목소리로 동시통역을 제공하는…","subcategory":"번역학이론","level":3,"related":[],"prerequisites":[],"aliases":["위스퍼링"]},{"slug":"pacte-model","title_ko":"PACTE모델","title_en":"PACTE translation competence model","meaning":"스페인 바르셀로나자치대학교의 PACTE 연구팀이 실증적 연구를 통해 제시한 번역능력 모델로, 이중언어 하위능력·언어외적…","subcategory":"번역학이론","level":3,"related":[],"prerequisites":[],"aliases":["PTCM"]},{"slug":"cohesion-in-translation","title_ko":"응집성(번역)","title_en":"cohesion in translation","meaning":"지시, 대용, 생략, 접속, 어휘적 반복 등 텍스트 표층에서 문장들을 문법적·어휘적으로 연결하는 결속 장치가 번역 과정에서…","subcategory":"번역학이론","level":2,"related":[],"prerequisites":[],"aliases":["응집성"]},{"slug":"remote-interpreting","title_ko":"원격통역","title_en":"Remote Interpreting","meaning":"통역사가 회의 현장에 물리적으로 있지 않고 화상 또는 음성 연결을 통해 원격지에서 통역을 제공하는 방식이다.","subcategory":"통역학이론·실무","level":1,"related":[],"prerequisites":[],"aliases":["비대면통역"]},{"slug":"anticipation-strategy","title_ko":"예측전략","title_en":"Anticipation Strategy","meaning":"통역사가 문맥, 화자의 어조, 언어 구조 등을 활용해 아직 발화되지 않은 내용을 미리 추정하여 통역 시차를 줄이는 전략이다.","subcategory":"통역학이론·실무","level":1,"related":[],"prerequisites":[]},{"slug":"dual-task-processing","title_ko":"이중과제처리","title_en":"Dual-Task Processing","meaning":"동시통역처럼 청취와 산출이라는 서로 다른 두 인지 과제를 동시에 수행해야 하는 처리 상황을 지칭하는 용어이다.","subcategory":"통역학이론·실무","level":2,"related":["shadowing-exercise"],"prerequisites":[]},{"slug":"shadowing-exercise","title_ko":"쉐도잉","title_en":"Shadowing Exercise","meaning":"들리는 음성을 최소한의 시차를 두고 같은 언어로 즉시 따라 말하는 훈련으로, 동시통역 입문 단계에서 청취-산출 병행 능력을…","subcategory":"통역학이론·실무","level":2,"related":["dual-task-processing"],"prerequisites":[],"aliases":["섀도잉"]},{"slug":"note-taking-technique","title_ko":"통역노트테이킹기법","title_en":"Note-Taking Technique in Interpreting","meaning":"순차통역 시 발화의 논리 구조와 핵심 내용을 신속히 기록하기 위해 사용하는 기호와 배열 방식을 아우르는 기법이다.","subcategory":"통역학이론·실무","level":1,"related":[],"prerequisites":[],"aliases":["NTTI"]},{"slug":"interpreter-competence","title_ko":"통역사역량","title_en":"Interpreter Competence","meaning":"언어능력, 배경지식, 인지처리능력, 담화분석능력 등 통역을 성공적으로 수행하기 위해 필요한 지식과 기술의 총체를 말한다.","subcategory":"통역학이론·실무","level":1,"related":[],"prerequisites":[],"aliases":["통역능력"]},{"slug":"audio-description-museum","title_ko":"음성해설","title_en":"Audio Description","meaning":"전시물의 시각적 특징과 맥락을 음성 언어로 설명하여, 시각장애인을 포함한 관람객이 눈으로 보지 않고도 전시물을 이해할 수…","subcategory":"박물관 교육","level":2,"related":[],"prerequisites":[],"aliases":["Audio Description","화면해설(시청각번역)","AD","화면해설"]},{"slug":"anaphora-liturgical","title_ko":"아나포라(성찬기도)","title_en":"Anaphora","meaning":"성찬(성체성사) 예식에서 빵과 포도주를 놓고 하나님께 감사와 기념, 성령 임재를 구하는 중심 기도문이다.","subcategory":"성례전학","level":2,"related":[],"prerequisites":[],"aliases":["Anaphora","성찬기도","아나포라","조응","대용"]},{"slug":"type-token-ratio","title_ko":"어휘 유형-토큰 비율","title_en":"Type-Token Ratio","meaning":"텍스트에 나온 서로 다른 단어 수(유형)를 전체 단어 수(토큰)로 나눈, 어휘 다양성을 나타내는 지표이다.","subcategory":"역사언어학·사회언어학·응용언어학","level":2,"related":["corpus-linguistics"],"prerequisites":[],"pop":14,"aliases":["유형-토큰 비율","타입-토큰 비율"]}]