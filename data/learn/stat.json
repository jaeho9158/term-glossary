[{"slug":"p-value","title_ko":"유의확률","title_en":"p-value","meaning":"지금 관찰된 결과가 \"우연히\" 나왔을 가능성이 얼마나 되는지를 나타내는 숫자입니다.","subcategory":"추론통계·가설검정","level":1,"related":["significance-level","confidence-interval","effect-size","correlation","sample-size","cox-proportional-hazards-model"],"prerequisites":[],"pop":15,"aliases":["p값","P값"]},{"slug":"correlation","title_ko":"상관관계","title_en":"Correlation","meaning":"두 변수가 함께 움직이는 정도를 나타내는 개념입니다. 하나가 커질 때 다른 하나도 커지거나(또는 작아지거나) 하는 경향을…","subcategory":"회귀·상관분석","level":1,"related":["regression","p-value","effect-size","skewness-kurtosis"],"prerequisites":[],"aliases":["상관계수"]},{"slug":"regression","title_ko":"회귀분석","title_en":"Regression","meaning":"하나(또는 여러) 변수가 다른 변수에 얼마나, 어떤 방향으로 영향을 주는지를 수식으로 추정하는 분석 방법입니다.","subcategory":"회귀·상관분석","level":1,"related":["correlation","effect-size","confidence-interval","endogeneity","instrumental-variable","anova"],"prerequisites":[],"aliases":["회귀","Regression Analysis"]},{"slug":"meta-analysis","title_ko":"메타분석","title_en":"Meta-analysis","meaning":"같은 주제를 다룬 여러 개별 연구의 결과를 통계적으로 종합해서 하나의 결론을 도출하는 연구 방법입니다.","subcategory":"문헌연구·메타분석","level":1,"related":["effect-size","randomized-controlled-trial","confidence-interval","statistical-power","bootstrap-resampling","evidence-based-nursing"],"prerequisites":[]},{"slug":"sample-size","title_ko":"표본크기","title_en":"Sample Size","meaning":"연구에 실제로 참여한 사람(또는 관찰 대상)의 수를 말합니다. 흔히 알파벳 n으로 표기합니다.","subcategory":"실험설계·표본추출","level":1,"related":["p-value","confidence-interval","randomized-controlled-trial","qualitative-research"],"prerequisites":[],"aliases":["표본 크기"]},{"slug":"confidence-interval","title_ko":"신뢰구간","title_en":"Confidence Interval","meaning":"연구에서 추정한 값이 \"이 범위 안에 있을 가능성이 높다\"고 말할 수 있는 구간입니다.","subcategory":"추론통계·가설검정","level":1,"related":["p-value","sample-size","significance-level","regression","meta-analysis","cox-proportional-hazards-model"],"prerequisites":[],"aliases":["CI","신뢰도구간"]},{"slug":"significance-level","title_ko":"유의수준","title_en":"Significance Level","meaning":"\"이 정도면 우연이 아니라고 인정하겠다\"는 기준선을 연구자가 미리 정해두는 값입니다. 흔히 알파(α)로 표기합니다.","subcategory":"추론통계·가설검정","level":1,"related":["p-value","confidence-interval","anova","chi-square-test","type-1-error"],"prerequisites":[],"aliases":["알파값"]},{"slug":"effect-size","title_ko":"효과크기","title_en":"Effect Size","meaning":"두 그룹 사이의 차이나 변수 간 관계가 \"통계적으로 유의한가\"를 넘어서, 실제로 그 차이가 \"얼마나 큰가\"를 나타내는…","subcategory":"추론통계·가설검정","level":1,"related":["p-value","meta-analysis","regression","correlation","statistical-power"],"prerequisites":[],"aliases":["ES"]},{"slug":"variance","title_ko":"분산","title_en":"Variance","meaning":"데이터가 평균에서 얼마나 퍼져 있는지 나타내는 수치. 표준편차는 분산의 제곱근.","subcategory":"기술통계·확률분포","level":1,"related":["standard-deviation","anova","outlier","skewness-kurtosis"],"prerequisites":[]},{"slug":"standard-deviation","title_ko":"표준편차","title_en":"Standard Deviation","meaning":"분산에 제곱근을 씌워 원래 단위로 되돌린 산포도 지표.","subcategory":"기술통계·확률분포","level":1,"related":["variance","outlier","normal-distribution","skewness-kurtosis"],"prerequisites":[],"aliases":["SD","표준편차값"]},{"slug":"null-hypothesis","title_ko":"귀무가설","title_en":"Null Hypothesis","meaning":"\"차이가 없다\"를 기본 전제로 놓고 통계적으로 기각을 시도하는 가설.","subcategory":"추론통계·가설검정","level":1,"related":["type-1-error","type-2-error","t-test"],"prerequisites":[],"pop":4,"aliases":["귀무 가설","H0"]},{"slug":"type-1-error","title_ko":"1종 오류","title_en":"Type I Error","meaning":"실제로는 차이가 없는데 있다고 잘못 판단하는 오류(false positive).","subcategory":"추론통계·가설검정","level":1,"related":["type-2-error","null-hypothesis","significance-level","multiple-comparisons-correction"],"prerequisites":[],"aliases":["제1종 오류","알파오류","1종오류"]},{"slug":"type-2-error","title_ko":"2종 오류","title_en":"Type II Error","meaning":"실제로 차이가 있는데 없다고 놓치는 오류(false negative).","subcategory":"추론통계·가설검정","level":1,"related":["type-1-error","statistical-power","null-hypothesis"],"prerequisites":[],"aliases":["제2종 오류","베타오류","2종오류"]},{"slug":"statistical-power","title_ko":"검정력","title_en":"Statistical Power","meaning":"실제로 존재하는 효과를 통계적으로 검출해낼 확률.","subcategory":"추론통계·가설검정","level":1,"related":["type-2-error","effect-size","meta-analysis"],"prerequisites":[],"aliases":["파워"]},{"slug":"anova","title_ko":"분산분석","title_en":"ANOVA","meaning":"여러 집단(주로 세 개 이상)의 평균 차이를 집단 간·집단 내 분산의 비(F)로 한 번에 검정하는 통계 기법.","subcategory":"추론통계·가설검정","level":1,"related":["t-test","variance","significance-level","chi-square-test","multicollinearity","regression"],"prerequisites":[],"aliases":["분산 분석","일원분산분석","아노바","Analysis of Variance"]},{"slug":"t-test","title_ko":"t검정","title_en":"t-test","meaning":"평균 차이(두 집단 간, 짝지은 측정 간, 또는 표본 평균과 기준값 간)가 우연으로 설명될 수 있는지 t분포를 이용해…","subcategory":"추론통계·가설검정","level":1,"related":["anova","null-hypothesis","chi-square-test","normal-distribution"],"prerequisites":[],"aliases":["티검정","t-검정"]},{"slug":"chi-square-test","title_ko":"카이제곱검정","title_en":"Chi-square Test","meaning":"범주형 변수 간의 연관성을 검정하는 방법.","subcategory":"비모수·범주형자료분석","level":1,"related":["t-test","anova","significance-level","r-squared"],"prerequisites":[],"aliases":["카이자승검정","카이제곱 검정"]},{"slug":"outlier","title_ko":"이상치","title_en":"Outlier","meaning":"다른 데이터와 크게 동떨어진 값으로, 분석 결과를 왜곡할 수 있는 관측치.","subcategory":"기술통계·확률분포","level":1,"related":["standard-deviation","variance","normal-distribution","skewness-kurtosis"],"prerequisites":[],"aliases":["이상값","특이값"]},{"slug":"normal-distribution","title_ko":"정규분포","title_en":"Normal Distribution","meaning":"평균을 중심으로 좌우 대칭인 종 모양 확률분포.","subcategory":"기술통계·확률분포","level":1,"related":["standard-deviation","outlier","t-test","skewness-kurtosis"],"prerequisites":[],"aliases":["가우스분포","정규 분포"]},{"slug":"endogeneity","title_ko":"내생성","title_en":"Endogeneity","meaning":"설명변수가 오차항과 상관관계를 가져 인과관계 추정이 왜곡되는 문제입니다.","subcategory":"미시경제","level":3,"related":["instrumental-variable","regression","panel-data","human-capital","difference-in-differences"],"prerequisites":[],"pop":2},{"slug":"instrumental-variable","title_ko":"도구변수","title_en":"Instrumental Variable","meaning":"내생성 문제를 해결하기 위해 원인에는 영향을 주되 결과에는 직접 영향이 없는 보조 변수입니다.","subcategory":"미시경제","level":3,"related":["endogeneity","regression","difference-in-differences","panel-data","multiple-comparisons-correction"],"prerequisites":[],"aliases":["IV","도구 변수"]},{"slug":"panel-data","title_ko":"패널데이터","title_en":"Panel Data","meaning":"여러 대상을 여러 시점에 걸쳐 반복 관측한 데이터입니다.","subcategory":"미시경제","level":3,"related":["endogeneity","longitudinal-study","difference-in-differences","instrumental-variable","cross-validation"],"prerequisites":[]},{"slug":"overfitting","title_ko":"과적합","title_en":"Overfitting","meaning":"모델이 학습 데이터에만 지나치게 맞춰져 새로운 데이터에서 성능이 떨어지는 현상입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["cross-validation"],"prerequisites":[],"aliases":["오버피팅"]},{"slug":"cross-validation","title_ko":"교차검증","title_en":"Cross-validation","meaning":"데이터를 여러 부분으로 나눠 번갈아 학습·검증하며 모델 성능을 평가하는 방법입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["overfitting","panel-data"],"prerequisites":[],"aliases":["교차검정"]},{"slug":"difference-in-differences","title_ko":"이중차분법","title_en":"Difference-in-Differences","meaning":"정책이나 사건의 효과를, 그 영향을 받은 집단과 받지 않은 집단의 \"변화량 차이\"를 비교해서 추정하는 분석 방법입니다.","subcategory":"미시경제","level":3,"related":["panel-data","endogeneity","instrumental-variable"],"prerequisites":[],"pop":16,"aliases":["DID","DD"]},{"slug":"factor-analysis","title_ko":"요인분석","title_en":"Factor Analysis","meaning":"여러 개의 관측 변수 사이의 상관관계를 분석해, 그 뒤에 숨어 있는 소수의 공통 요인을 찾아내는 통계기법입니다.","subcategory":"통계·분석도구","level":2,"related":["likert-scale","delphi-method","factor-loading","convergent-validity"],"prerequisites":[]},{"slug":"odds-ratio","title_ko":"교차비(오즈비)","title_en":"Odds Ratio","meaning":"어떤 요인에 노출된 집단과 노출되지 않은 집단에서 특정 사건이 일어날 \"오즈(odds, 성공 대 실패의 비)\"를 비교하여…","subcategory":"역학·공중보건","level":1,"related":["case-control-study","sensitivity-specificity","logistic-regression"],"prerequisites":[],"aliases":["OR","오즈비"]},{"slug":"sensitivity-specificity","title_ko":"민감도와 특이도","title_en":"Sensitivity and Specificity","meaning":"진단 검사가 실제 병이 있는 사람을 얼마나 잘 찾아내는지(민감도)와, 병이 없는 사람을 얼마나 정확히 걸러내는지(특이도)를…","subcategory":"진단·검사","level":1,"related":["biomarker","clinical-trial","odds-ratio","elisa","positive-predictive-value","confidence-interval"],"prerequisites":[],"aliases":["민감도 특이도"]},{"slug":"bootstrap-resampling","title_ko":"부트스트랩","title_en":"Bootstrap Resampling","meaning":"가지고 있는 표본 데이터에서 복원추출을 반복해 새로운 표본들을 만들어냄으로써, 통계량의 분포나 신뢰구간을 추정하는 방법입니다.","subcategory":"다변량·고급기법","level":2,"related":["grounded-theory","meta-analysis"],"prerequisites":[],"aliases":["부트스트래핑"]},{"slug":"multicollinearity","title_ko":"다중공선성","title_en":"Multicollinearity","meaning":"회귀분석에서 설명변수들끼리 서로 강하게 상관되어 있어, 각 변수의 개별적인 효과를 정확히 구분해내기 어려운 상태입니다.","subcategory":"회귀·상관분석","level":2,"related":["r-squared","logistic-regression","anova"],"prerequisites":[],"aliases":["공선성"]},{"slug":"r-squared","title_ko":"결정계수","title_en":"R-squared","meaning":"회귀모형이 종속변수의 전체 변동 중 얼마만큼을 설명해내는지를 0에서 1 사이의 비율로 나타낸 지표입니다.","subcategory":"회귀·상관분석","level":1,"related":["multicollinearity","logistic-regression","chi-square-test"],"prerequisites":[],"aliases":["R2","결정계수 R2"]},{"slug":"logistic-regression","title_ko":"로지스틱 회귀","title_en":"logistic regression","meaning":"결과가 \"예/아니오\"처럼 두 가지 중 하나로 나뉠 때, 어떤 요인이 그 결과가 나올 확률을 얼마나 높이거나 낮추는지 분석하는…","subcategory":"회귀·상관분석","level":2,"related":["odds-ratio","multicollinearity","r-squared"],"prerequisites":[],"aliases":["로짓회귀","로짓모형","로지스틱회귀"]},{"slug":"multiple-comparisons-correction","title_ko":"다중비교보정","title_en":"multiple comparisons correction","meaning":"같은 데이터로 통계 검정을 여러 번 반복할 때, 우연히 \"유의하다\"는 결과가 나올 확률이 커지는 문제를 막기 위해 유의수준을…","subcategory":"추론통계·가설검정","level":2,"related":["type-1-error","instrumental-variable"],"prerequisites":["type-1-error"],"pop":17,"aliases":["다중검정보정","본페로니 교정","Bonferroni correction"]},{"slug":"skewness-kurtosis","title_ko":"왜도와 첨도","title_en":"skewness & kurtosis","meaning":"왜도는 데이터 분포가 좌우 어느 쪽으로 치우쳐 있는지, 첨도는 분포의 가운데가 얼마나 뾰족하고 꼬리가 두꺼운지를 나타내는…","subcategory":"기술통계·확률분포","level":1,"related":["normal-distribution","outlier","variance","standard-deviation","correlation"],"prerequisites":[],"aliases":["왜도 첨도","왜도와첨도"]},{"slug":"statistical-mediation-moderation","title_ko":"매개효과와 조절효과","title_en":"Mediation & Moderation Effect","meaning":"매개효과는 원인이 결과에 영향을 주는 경로 중간에 끼어 그 영향을 전달하는 제3의 변수의 역할이고, 조절효과는 원인과 결과…","subcategory":"다변량·고급기법","level":2,"related":["structural-equation-modeling","regression","confounding-variable","effect-size"],"prerequisites":[],"aliases":["매개변수","조절변수","매개-조절 분석","매개효과와조절효과"]},{"slug":"bayesian-inference","title_ko":"베이지안 추론","title_en":"Bayesian Inference","meaning":"기존에 가지고 있던 믿음(사전확률)에 새로운 데이터를 반영해 더 나은 결론(사후확률)으로 갱신해 나가는 통계적 추론…","subcategory":"다변량·고급기법","level":3,"related":["confidence-interval","p-value","null-hypothesis"],"prerequisites":[],"aliases":["베이즈 통계","사후확률 추정","베이지안추론"]},{"slug":"structural-equation-modeling","title_ko":"구조방정식모형","title_en":"Structural Equation Modeling","meaning":"눈에 보이지 않는 추상적 개념들을 여러 문항으로 측정하는 과정과, 그 개념들 간의 인과관계를 검증하는 과정을 하나의 모형…","subcategory":"다변량·고급기법","level":3,"related":["factor-analysis","statistical-mediation-moderation","construct-validity","r-squared"],"prerequisites":[],"aliases":["SEM","경로분석 확장모형"]},{"slug":"item-response-theory","title_ko":"문항반응이론","title_en":"Item Response Theory","meaning":"시험이나 설문의 각 문항이 응답자의 능력 수준에 따라 정답을 맞힐 확률이 어떻게 달라지는지를 수학적으로 모형화해, 문항…","subcategory":"다변량·고급기법","level":3,"related":["cronbachs-alpha","construct-validity","likert-scale","factor-analysis"],"prerequisites":[],"aliases":["IRT","문항특성곡선"]},{"slug":"homoscedasticity-heteroscedasticity","title_ko":"등분산성과 이분산성","title_en":"homoscedasticity & heteroscedasticity","meaning":"등분산성은 예측값 전체 구간에서 오차의 흩어진 정도(분산)가 일정한 것을, 이분산성은 그 흩어진 정도가 구간마다 달라지는…","subcategory":"회귀·상관분석","level":2,"related":["regression","multicollinearity","r-squared"],"prerequisites":[],"aliases":["등분산성과이분산성"]},{"slug":"ancova","title_ko":"공분산분석","title_en":"ANCOVA","meaning":"집단 간 평균 차이를 비교할 때, 결과에 영향을 줄 수 있는 다른 변수(공변량)의 효과를 통계적으로 먼저 제거한 뒤 비교하는…","subcategory":"추론통계·가설검정","level":2,"related":["anova","regression","control-group","statistical-mediation-moderation"],"prerequisites":["anova"]},{"slug":"forest-plot","title_ko":"포레스트플롯","title_en":"Forest Plot","meaning":"메타분석에 포함된 여러 개별 연구의 효과크기와 신뢰구간을 한 줄씩 나란히 그려, 전체 결과를 한눈에 비교할 수 있게 만든…","subcategory":"역학·공중보건","level":1,"related":["meta-analysis","confidence-interval","effect-size"],"prerequisites":[]},{"slug":"likelihood-ratio","title_ko":"우도비","title_en":"Likelihood Ratio","meaning":"어떤 검사 결과가 나왔을 때, 그 결과가 병이 있는 사람에게서 나올 확률이 병이 없는 사람에게서 나올 확률보다 몇 배 더…","subcategory":"진단·검사","level":2,"related":["sensitivity-specificity","odds-ratio","roc-curve"],"prerequisites":[],"aliases":["LR"]},{"slug":"z-score","title_ko":"Z점수","title_en":"Z-score","meaning":"어떤 값이 평균으로부터 표준편차 몇 개만큼 떨어져 있는지를 나타내어, 서로 다른 척도의 값들을 같은 기준으로 비교할 수 있게…","subcategory":"기술통계·확률분포","level":1,"related":["standard-deviation","normal-distribution","outlier","confidence-interval"],"prerequisites":[],"aliases":["표준점수","표준화점수","Z-점수"]},{"slug":"missing-data","title_ko":"결측치 처리","title_en":"Missing Data Handling","meaning":"설문이나 실험 과정에서 응답하지 않았거나 측정되지 않아 비어 있는 값(결측치)을 분석 전에 어떻게 처리할지 결정하는…","subcategory":"다변량·고급기법","level":1,"related":["outlier","sample-size","bootstrap-resampling"],"prerequisites":[],"aliases":["결측치","결측값","결측 데이터","MDH","결측치처리"]},{"slug":"pearson-spearman-correlation","title_ko":"피어슨 상관계수와 스피어만 상관계수","title_en":"Pearson vs Spearman Correlation","meaning":"두 변수 사이의 관계 강도를 재는 대표적인 두 방법으로, 피어슨 상관계수는 값 그대로의 직선적(선형) 관계를, 스피어만…","subcategory":"회귀·상관분석","level":1,"related":["correlation","regression","skewness-kurtosis"],"prerequisites":["correlation","regression"],"aliases":["피어슨 상관계수","스피어만 상관계수","순위상관계수","PVSC","피어슨상관계수와스피어만상관계수"]},{"slug":"mixed-effects-model","title_ko":"혼합효과모형","title_en":"Mixed-Effects Model","meaning":"모든 개체에 공통으로 적용되는 고정효과와, 개체나 집단마다 다르게 나타나는 무선효과(임의효과)를 함께 포함하는 통계모형입니다.","subcategory":"다변량·고급기법","level":3,"related":["panel-data","structural-equation-modeling","ancova"],"prerequisites":[],"aliases":["혼합모형","다층모형","hierarchical linear model"]},{"slug":"regression-to-the-mean","title_ko":"평균으로의 회귀","title_en":"Regression to the Mean","meaning":"극단적으로 높거나 낮은 측정값은 다시 측정하면 순전히 우연에 의해 평균에 더 가까운 값으로 돌아오는 경향을 말합니다.","subcategory":"연구설계","level":1,"related":["internal-validity","quasi-experimental-design"],"prerequisites":["quasi-experimental-design"],"aliases":["평균회귀","평균으로 회귀","regression toward the mean","평균으로의회귀"]},{"slug":"composite-reliability","title_ko":"합성신뢰도","title_en":"Composite Reliability","meaning":"확인적 요인분석 모형을 바탕으로, 여러 문항이 하나의 개념을 얼마나 일관되게 측정하는지 계산한 신뢰도 지표입니다.","subcategory":"통계·분석도구","level":2,"related":["cronbachs-alpha","factor-loading","convergent-validity","reliability"],"prerequisites":[],"aliases":["CR","구성신뢰도"]},{"slug":"mann-whitney-u-test","title_ko":"맨-휘트니 U 검정","title_en":"Mann-Whitney U test","meaning":"데이터가 정규분포를 따르지 않을 때, 두 독립된 집단의 값들을 순위로 바꿔 비교함으로써 두 집단이 서로 다른지를 검정하는…","subcategory":"비모수·범주형자료분석","level":2,"related":["t-test","normal-distribution","outlier"],"prerequisites":[],"pop":3,"aliases":["만-휘트니 검정","윌콕슨 순위합 검정","MWUT","맨 휘트니 U 검정","맨-휘트니U검정","맨휘트니 U 검정"]},{"slug":"cooks-distance","title_ko":"쿡의 거리","title_en":"Cook's Distance","meaning":"회귀분석에서 특정 관측치 하나를 빼고 다시 모형을 적합했을 때 예측값이 얼마나 크게 달라지는지를 계산해, 그 관측치가 전체…","subcategory":"회귀·상관분석","level":2,"related":["outlier","regression","homoscedasticity-heteroscedasticity"],"prerequisites":[],"aliases":["Cook's D","영향점 진단","쿡의거리"]},{"slug":"kolmogorov-smirnov-test","title_ko":"콜모고로프-스미르노프 검정","title_en":"Kolmogorov-Smirnov test","meaning":"표본 데이터의 누적분포가 특정 이론분포나 다른 표본의 분포와 얼마나 차이 나는지를 비교해 두 분포가 같다고 볼 수 있는지…","subcategory":"비모수·범주형자료분석","level":2,"related":["normal-distribution","mann-whitney-u-test","t-test"],"prerequisites":["mann-whitney-u-test"],"aliases":["K-S 검정","콜모고로프-스미르노프 검정통계량","콜모고로프 스미르노프 검정","콜모고로프-스미르노프검정","콜모고로프스미르노프 검정"]},{"slug":"coefficient-of-variation","title_ko":"변동계수","title_en":"Coefficient of Variation","meaning":"표준편차를 평균으로 나눈 값(주로 %)으로, 단위나 크기가 다른 측정값들의 상대적인 흩어짐 정도를 비교할 수 있게 해주는…","subcategory":"통계·분석도구","level":1,"related":["standard-deviation","measurement-uncertainty"],"prerequisites":[],"aliases":["CV","relative standard deviation","RSD"]},{"slug":"confirmatory-factor-analysis","title_ko":"확인적 요인분석","title_en":"Confirmatory Factor Analysis","meaning":"연구자가 이론적으로 미리 설정한 요인 구조가 실제 수집된 데이터와 얼마나 잘 맞는지를 통계적으로 검증하는 요인분석 기법입니다.","subcategory":"통계·분석도구","level":3,"related":["factor-loading","construct-validity","item-response-theory","cronbachs-alpha"],"prerequisites":[],"aliases":["CFA","확인적요인분석"]},{"slug":"cox-proportional-hazards-model","title_ko":"콕스 비례위험모형","title_en":"Cox Proportional Hazards Model","meaning":"여러 변수가 사건이 일어날 위험(위험률)에 얼마나 영향을 미치는지, 그리고 그 영향이 시간에 따라 어떻게 달라지는지를 함께…","subcategory":"다변량·고급기법","level":3,"related":["confidence-interval","kaplan-meier-estimator"],"prerequisites":[],"aliases":["콕스 회귀","Cox regression","비례위험모형","hazard ratio model","Cox모형","콕스회귀"]},{"slug":"autocorrelation","title_ko":"자기상관","title_en":"autocorrelation","meaning":"시계열 데이터에서 현재 값이 과거의 자기 자신과 얼마나 비슷하게 움직이는지를 나타내는 상관관계이다.","subcategory":"다변량·고급기법","level":2,"related":["correlation","regression"],"prerequisites":[],"aliases":["시계열상관","serial correlation","자기상관계수"]},{"slug":"principal-component-analysis","title_ko":"주성분분석","title_en":"Principal component analysis","meaning":"서로 얽혀 있는 여러 변수를 정보 손실을 최소화하면서 훨씬 적은 수의 새로운 축(주성분)으로 압축하는 방법이다.","subcategory":"다변량·고급기법","level":2,"related":["factor-analysis","correlation","k-means-clustering","regression"],"prerequisites":[],"aliases":["PCA","주성분 분석","차원축소"]},{"slug":"kruskal-wallis-test","title_ko":"크루스칼-왈리스 검정","title_en":"Kruskal-Wallis test","meaning":"데이터가 정규분포를 따르지 않을 때, 세 개 이상의 그룹 사이에 순위 기준으로 차이가 있는지 검정하는 비모수 통계 방법이다.","subcategory":"비모수·범주형자료분석","level":2,"related":["mann-whitney-u-test","anova","chi-square-test","normal-distribution"],"prerequisites":[],"pop":6,"aliases":["크루스칼왈리스검정","H검정","순위분산분석","크루스칼 왈리스 검정","크루스칼-왈리스검정","크루스칼왈리스 검정"]},{"slug":"k-means-clustering","title_ko":"k-평균 군집화","title_en":"k-means clustering","meaning":"미리 정해둔 개수(k개)만큼 데이터를 서로 비슷한 것끼리 자동으로 묶어주는 대표적인 군집화 알고리즘이다.","subcategory":"다변량·고급기법","level":2,"related":["principal-component-analysis","factor-analysis"],"prerequisites":[],"aliases":["k평균 군집화","k-means","k평균 알고리즘","k 평균 군집화","k-평균군집화"]},{"slug":"kaplan-meier-estimator","title_ko":"카플란-마이어 추정법","title_en":"Kaplan-Meier Estimator","meaning":"관찰이 도중에 중단된 대상자가 있어도 시간에 따른 생존확률을 계단 모양의 그래프로 추정하는 비모수적 통계 방법입니다.","subcategory":"다변량·고급기법","level":2,"related":["cox-proportional-hazards-model","confidence-interval"],"prerequisites":[],"aliases":["카플란-마이어 생존곡선","생존곡선 추정법","KM곡선","카플란마이어"]},{"slug":"wilcoxon-signed-rank-test","title_ko":"윌콕슨 부호순위검정","title_en":"Wilcoxon Signed-Rank Test","meaning":"정규분포를 따르지 않는 대응표본(같은 대상을 두 번 측정한 값)의 차이가 통계적으로 유의한지를 검정하는 비모수 방법입니다.","subcategory":"비모수·범주형자료분석","level":2,"related":["mann-whitney-u-test","t-test","normal-distribution"],"prerequisites":[],"pop":7,"aliases":["윌콕슨 검정","WSRT","윌콕슨부호순위검정"]},{"slug":"grim-test","title_ko":"GRIM 테스트","title_en":"GRIM Test","meaning":"보고된 평균값이 표본 크기와 정수 데이터로 계산 가능한지를 역산해 통계적으로 불가능한 값을 찾아내는 데이터 위조 탐지 기법.","subcategory":"연구윤리 원칙","level":3,"related":["data-fabrication"],"prerequisites":[],"aliases":["Granularity-Related Inconsistency of Means","GRIM테스트"]},{"slug":"generalizability-theory","title_ko":"일반화가능도이론","title_en":"Generalizability Theory","meaning":"측정 점수에 영향을 미치는 여러 오차 요인(평가자, 문항, 시점 등)을 동시에 분석하여 측정의 신뢰도를 종합적으로 추정하는…","subcategory":"통계·분석도구","level":3,"related":["cronbachs-alpha","intraclass-correlation-coefficient","reliability"],"prerequisites":["cronbachs-alpha","intraclass-correlation-coefficient"],"aliases":["G이론"]},{"slug":"measurement-invariance","title_ko":"측정불변성","title_en":"Measurement Invariance","meaning":"서로 다른 집단이나 시점에서 같은 설문·검사 도구가 동일한 심리적 구성개념을 같은 방식으로 측정하고 있는지를 확인하는…","subcategory":"통계·분석도구","level":3,"related":["confirmatory-factor-analysis","construct-validity","factor-loading"],"prerequisites":["confirmatory-factor-analysis","factor-loading"]},{"slug":"ridge-regression","title_ko":"릿지 회귀","title_en":"Ridge Regression","meaning":"회귀계수의 크기에 페널티(L2 규제)를 부여해 다중공선성과 과적합의 영향을 줄이는 회귀 기법입니다.","subcategory":"회귀·상관분석","level":3,"related":["multicollinearity","overfitting","regression"],"prerequisites":[],"aliases":["릿지회귀","Ridge Regression","L2 정규화"]},{"slug":"durbin-watson-test","title_ko":"더빈-왓슨 검정","title_en":"Durbin-Watson Test","meaning":"회귀분석의 잔차(오차)들이 서로 독립적인지, 즉 자기상관이 있는지를 검정하는 통계량입니다.","subcategory":"회귀·상관분석","level":3,"related":["autocorrelation","regression","homoscedasticity-heteroscedasticity"],"prerequisites":[],"pop":10,"aliases":["더빈왓슨검정","Durbin-Watson Test","DW 통계량","더빈 왓슨 검정","더빈-왓슨검정","더빈왓슨 검정"]},{"slug":"tripod-statement","title_ko":"트리포드 성명","title_en":"TRIPOD Statement","meaning":"질병 위험도나 예후를 예측하는 통계·머신러닝 모델을 개발하거나 검증한 연구를 투명하게 보고하도록 안내하는 지침입니다.","subcategory":"출판·저작권","level":3,"related":["strobe-statement"],"prerequisites":["strobe-statement"],"aliases":["TRIPOD","Transparent Reporting of a multivariable prediction model","예측모델 보고 지침","트리포드성명"]},{"slug":"multiple-imputation","title_ko":"다중대체법","title_en":"Multiple Imputation","meaning":"결측치를 하나의 값으로 메우는 대신, 불확실성을 반영해 여러 개의 그럴듯한 값으로 채운 뒤 각각 분석하고 결과를 하나로…","subcategory":"다변량·고급기법","level":3,"related":["missing-data","bootstrap-resampling","confidence-interval"],"prerequisites":["missing-data","bootstrap-resampling"],"aliases":["MICE","다중대체","연쇄방정식 다중대체법","Multiple Imputation for Missing Data","MIMD"]},{"slug":"jackknife-resampling","title_ko":"잭나이프 재표본법","title_en":"Jackknife Resampling","meaning":"전체 표본에서 관측치를 한 번에 하나씩 제외하며 통계량을 반복 계산하고, 그 값들이 얼마나 흔들리는지를 보고 편향과…","subcategory":"다변량·고급기법","level":3,"related":["bootstrap-resampling","cooks-distance"],"prerequisites":["bootstrap-resampling"],"aliases":["잭나이프법","leave-one-out resampling","잭나이프재표본법"]},{"slug":"zero-inflated-model","title_ko":"영과잉모형","title_en":"Zero-inflated Model","meaning":"원천적으로 사건이 발생할 수 없어 생기는 '진짜 0'과 발생 가능하지만 우연히 관측되지 않은 '일반적인 0'이 섞여 있어…","subcategory":"다변량·고급기법","level":3,"related":[],"prerequisites":[],"aliases":["ZIP 모형","ZINB 모형","영과잉 포아송모형","ZIM"]},{"slug":"posterior-predictive-check","title_ko":"사후예측점검","title_en":"Posterior Predictive Check","meaning":"추정된 사후분포에서 새로운 가상 데이터를 반복 생성한 뒤, 이것이 실제 관측 데이터와 얼마나 비슷한지 비교하여 베이지안…","subcategory":"다변량·고급기법","level":3,"related":["bayesian-inference"],"prerequisites":["bayesian-inference"],"aliases":["PPC","사후 예측 검사"]},{"slug":"weibull-distribution","title_ko":"와이블분포","title_en":"Weibull Distribution","meaning":"시간이 지날수록 사건(고장, 사망 등)이 발생할 위험이 증가·감소·일정하게 유지되는 다양한 패턴을 하나의 모양 모수로 표현할…","subcategory":"기술통계·확률분포","level":3,"related":["kaplan-meier-estimator","cox-proportional-hazards-model"],"prerequisites":[],"pop":18,"aliases":["와이불분포","Weibull"]},{"slug":"kriging","title_ko":"크리깅","title_en":"Kriging","meaning":"가까운 지점끼리 값이 비슷하다는 공간자기상관 구조를 이용해, 실제로 측정하지 않은 지점의 값을 주변 관측값의 가중평균으로…","subcategory":"다변량·고급기법","level":3,"related":["confidence-interval","sample-size"],"prerequisites":[],"aliases":["크리깅 보간법","가우시안 프로세스 회귀"]},{"slug":"credible-interval","title_ko":"신용구간","title_en":"Credible Interval","meaning":"사후분포에서 모수가 특정 확률(예: 95%)로 존재한다고 직접 말할 수 있는 구간으로, 베이지안 통계에서 신뢰구간에 대응하는…","subcategory":"다변량·고급기법","level":3,"related":["confidence-interval","bayesian-inference"],"prerequisites":[],"aliases":["신뢰구간(베이지안)","베이지안 구간추정"]},{"slug":"meta-regression","title_ko":"메타회귀분석","title_en":"Meta-Regression","meaning":"메타분석에 포함된 연구들의 결과가 서로 다르게 나온 이유를, 연구별 특성(공변량)을 이용해 통계적으로 설명하려는 기법입니다.","subcategory":"다변량·고급기법","level":3,"related":["meta-analysis","forest-plot"],"prerequisites":[]},{"slug":"copula-function","title_ko":"코퓰러 함수","title_en":"Copula Function","meaning":"여러 변수가 각각 어떤 모양의 분포를 갖는지와, 그 변수들이 서로 얼마나 함께 움직이는지(의존구조)를 따로 떼어서 표현할 수…","subcategory":"다변량·고급기법","level":3,"related":["correlation"],"prerequisites":[],"aliases":["코퓰러함수","코퓰러 모형"]},{"slug":"vector-autoregression","title_ko":"벡터자기회귀모형","title_en":"Vector Autoregression","meaning":"여러 개의 시계열 변수를 동시에 놓고, 각 변수의 현재 값을 자기 자신과 다른 변수들의 과거 값으로 함께 설명하는 모형입니다.","subcategory":"다변량·고급기법","level":3,"related":[],"prerequisites":[],"aliases":["VAR모형"]},{"slug":"latent-class-analysis","title_ko":"잠재계층분석","title_en":"Latent Class Analysis","meaning":"설문 응답이나 행동 패턴을 바탕으로, 겉으로 드러나지 않는 몇 개의 하위 집단(잠재계층)으로 대상자들을 자동으로 분류하는…","subcategory":"다변량·고급기법","level":3,"related":["factor-analysis","k-means-clustering","item-response-theory"],"prerequisites":["k-means-clustering","item-response-theory"],"aliases":["LCA"]},{"slug":"robust-standard-errors","title_ko":"강건표준오차","title_en":"Robust Standard Errors","meaning":"회귀분석에서 등분산성 등 기본 가정이 어긋나 있어도, 계수 추정치의 표준오차를 왜곡 없이 안정적으로 계산해주는 방법입니다.","subcategory":"회귀·상관분석","level":2,"related":["homoscedasticity-heteroscedasticity","confidence-interval","regression"],"prerequisites":[],"aliases":["White 표준오차","Huber-White 표준오차"]},{"slug":"variance-inflation-factor","title_ko":"분산팽창계수","title_en":"Variance Inflation Factor","meaning":"회귀분석에서 특정 독립변수가 다른 독립변수들과 얼마나 겹치는(상관된) 정보를 담고 있는지를 숫자로 나타내어, 다중공선성의…","subcategory":"회귀·상관분석","level":2,"related":["multicollinearity","regression","durbin-watson-test"],"prerequisites":[],"aliases":["VIF"]},{"slug":"random-effects-model","title_ko":"임의효과모형","title_en":"Random Effects Model","meaning":"패널데이터에서 개체 간 관측되지 않는 차이를 고정된 값이 아니라, 특정 확률분포에서 무작위로 뽑힌 값으로 간주하여 함께…","subcategory":"다변량·고급기법","level":2,"related":["panel-data","mixed-effects-model"],"prerequisites":["mixed-effects-model"],"aliases":["랜덤효과모형"]},{"slug":"generalized-method-of-moments","title_ko":"일반화적률법","title_en":"Generalized Method of Moments","meaning":"데이터가 만족해야 할 몇 가지 수학적 조건(적률 조건)을 최대한 잘 맞추는 방향으로 모형의 계수를 추정하는 방법입니다.","subcategory":"다변량·고급기법","level":3,"related":["instrumental-variable","endogeneity","panel-data"],"prerequisites":[],"aliases":["GMM"]},{"slug":"probability-addition-multiplication-rule","title_ko":"확률의 덧셈정리와 곱셈정리","title_en":"Addition and Multiplication Rule of Probability","meaning":"덧셈정리는 둘 중 하나라도 일어날 확률을, 곱셈정리는 둘 다 동시에 일어날 확률을 계산하는 기본 공식입니다.","subcategory":"기술통계·확률분포","level":1,"related":[],"prerequisites":[],"aliases":["AMRP","확률의덧셈정리와곱셈정리"]},{"slug":"law-of-large-numbers","title_ko":"큰 수의 법칙","title_en":"Law of Large Numbers","meaning":"시행 횟수를 계속 늘려갈수록 관찰된 결과의 비율(표본평균)이 이론적인 확률(모평균)에 점점 가까워진다는 법칙입니다.","subcategory":"기술통계·확률분포","level":1,"related":["sample-size"],"prerequisites":[],"aliases":["큰수의법칙"]},{"slug":"normal-approximation-to-binomial","title_ko":"이항분포의 정규근사","title_en":"Normal Approximation to the Binomial Distribution","meaning":"시행 횟수가 충분히 많을 때, 계단 모양으로 울퉁불퉁한 이항분포를 매끄러운 정규분포로 대신 근사해서 계산을 간단히 하는…","subcategory":"기술통계·확률분포","level":2,"related":["z-score","confidence-interval"],"prerequisites":["z-score"],"aliases":["NABD","이항분포의정규근사"]},{"slug":"path-analysis","title_ko":"경로분석","title_en":"Path Analysis","meaning":"여러 변수 사이의 인과적 순서를 화살표로 그리고, 각 화살표(경로)가 얼마나 강한 영향을 미치는지 계수로 계산해 원인과…","subcategory":"다변량·고급기법","level":2,"related":["structural-equation-modeling","statistical-mediation-moderation","r-squared","correlation"],"prerequisites":["structural-equation-modeling","statistical-mediation-moderation"]},{"slug":"mcnemars-test","title_ko":"맥니마 검정","title_en":"McNemar's test","meaning":"같은 대상을 두 시점(전·후)이나 두 조건에서 측정한 이분형(예/아니오) 자료의 응답 변화가 우연 이상인지를 검정하는…","subcategory":"비모수·범주형자료분석","level":2,"related":["chi-square-test","wilcoxon-signed-rank-test","cohen-kappa"],"prerequisites":[],"aliases":["맥니마검정"]},{"slug":"wald-test","title_ko":"왈드 검정","title_en":"Wald test","meaning":"추정된 계수의 값을 그 표준오차로 나눈 값을 이용해, 그 계수가 0인지 아닌지를 검정하는 방법입니다.","subcategory":"추론통계·가설검정","level":3,"related":["likelihood-ratio","logistic-regression","confidence-interval"],"prerequisites":["confidence-interval"],"aliases":["왈드검정"]},{"slug":"breusch-pagan-test","title_ko":"브로이시-파간 검정","title_en":"Breusch-Pagan test","meaning":"회귀분석의 잔차가 예측값이나 독립변수 수준에 따라 들쭉날쭉하게 퍼지는 이분산성을 갖는지 통계적으로 검정하는 방법입니다.","subcategory":"회귀·상관분석","level":3,"related":["homoscedasticity-heteroscedasticity","robust-standard-errors","regression","durbin-watson-test"],"prerequisites":["homoscedasticity-heteroscedasticity","robust-standard-errors","regression"],"aliases":["브로이시 파간 검정","브로이시-파간검정","브로이시파간 검정"]},{"slug":"cohens-d","title_ko":"코헨의 d","title_en":"Cohen's d","meaning":"두 집단의 평균 차이를 표준편차 단위로 환산하여 그 차이가 실제로 얼마나 큰지를 숫자로 나타낸 대표적인 효과크기 지표입니다.","subcategory":"추론통계·가설검정","level":1,"related":["effect-size","t-test","anova","statistical-power","meta-analysis"],"prerequisites":["effect-size","t-test","anova"],"pop":20,"aliases":["코헨의d"]},{"slug":"hierarchical-clustering","title_ko":"계층적 군집분석","title_en":"Hierarchical Clustering","meaning":"개체들 간의 거리(비유사도)를 기준으로, 가장 가까운 것들부터 순서대로 묶어 나가며 나무 모양의 계층 구조로 군집을 형성하는…","subcategory":"다변량·고급기법","level":2,"related":["k-means-clustering","multidimensional-scaling","factor-analysis","principal-component-analysis"],"prerequisites":[],"aliases":["계층적군집분석"]},{"slug":"multidimensional-scaling","title_ko":"다차원척도법","title_en":"Multidimensional Scaling","meaning":"대상들 사이의 거리(비유사도) 정보만 가지고, 그 관계를 최대한 그대로 유지하면서 2차원이나 3차원 공간에 점으로 배치해…","subcategory":"다변량·고급기법","level":3,"related":["principal-component-analysis","hierarchical-clustering","factor-analysis","credible-interval","k-means-clustering"],"prerequisites":["principal-component-analysis","hierarchical-clustering","credible-interval"]},{"slug":"cochrans-q-test","title_ko":"코크란 Q 검정","title_en":"Cochran's Q Test","meaning":"같은 대상을 세 번 이상 반복해서 측정한 이분형(예/아니오) 응답이 여러 조건이나 시점 간에 차이가 있는지를 검정하는 비모수…","subcategory":"비모수·범주형자료분석","level":2,"related":["mcnemars-test"],"prerequisites":["mcnemars-test"],"aliases":["CQT","코크란Q검정"]},{"slug":"geometric-distribution","title_ko":"기하분포","title_en":"Geometric Distribution","meaning":"성공 확률이 일정한 시행을 반복할 때, \"처음 성공이 나올 때까지 걸리는 시도 횟수\"의 분포입니다.","subcategory":"기술통계·확률분포","level":1,"related":["hypergeometric-distribution"],"prerequisites":[]},{"slug":"hypergeometric-distribution","title_ko":"초기하분포","title_en":"Hypergeometric Distribution","meaning":"한 번 뽑은 것을 다시 넣지 않는 \"비복원추출\"에서, 원하는 항목이 몇 개 뽑히는지를 나타내는 확률분포입니다.","subcategory":"기술통계·확률분포","level":2,"related":["geometric-distribution"],"prerequisites":["geometric-distribution"]},{"slug":"auc-roc","title_ko":"AUC (곡선아래면적)","title_en":"AUC (Area Under the Curve)","meaning":"ROC 곡선 아래의 면적을 계산해, 분류 모델이나 검사의 판별 성능을 0.5(무작위 수준)에서 1(완벽) 사이의 숫자 하나로…","subcategory":"다변량·고급기법","level":2,"related":["roc-curve","sensitivity-specificity","f1-score"],"prerequisites":[],"aliases":["AUC(곡선아래면적)","곡선아래면적"]},{"slug":"f1-score","title_ko":"F1 점수","title_en":"F1 Score","meaning":"정밀도와 재현율을 하나로 합쳐, 두 값이 모두 낮으면 낮게 나오도록 계산한 분류 성능 평가 지표입니다.","subcategory":"다변량·고급기법","level":2,"related":["sensitivity-specificity","auc-roc","roc-curve"],"prerequisites":["auc-roc"],"pop":13,"aliases":["F1점수"]},{"slug":"f-distribution","title_ko":"F분포","title_en":"f-distribution","meaning":"두 분산의 비율이 어느 정도이면 \"우연한 차이\"이고 어느 정도이면 \"진짜 차이\"인지를 판단하기 위해 쓰는 확률분포입니다.","subcategory":"기술통계·확률분포","level":2,"related":["anova"],"prerequisites":[]},{"slug":"percentile","title_ko":"백분위수","title_en":"percentile","meaning":"데이터를 크기 순으로 줄 세웠을 때, 전체의 몇 %가 그 값보다 작거나 같은지를 나타내는 위치 지표입니다.","subcategory":"기술통계·확률분포","level":1,"related":["z-score","normal-distribution","sample-size"],"prerequisites":["z-score","normal-distribution"],"aliases":["백분위"]},{"slug":"residual-analysis","title_ko":"잔차분석","title_en":"Residual Analysis","meaning":"회귀모형이 예측하지 못하고 남긴 오차인 잔차를 들여다봐서, 그 모형이 세운 가정(선형성, 등분산성, 독립성, 정규성 등)을…","subcategory":"회귀·상관분석","level":1,"related":["durbin-watson-test","breusch-pagan-test","cooks-distance"],"prerequisites":[]},{"slug":"confidence-level","title_ko":"신뢰수준","title_en":"Confidence Level","meaning":"같은 방식으로 표본을 반복해서 뽑아 신뢰구간을 100번 만들었을 때, 그중 몇 번이나 진짜 값을 포함할지를 미리 정해둔…","subcategory":"추론통계·가설검정","level":1,"related":["confidence-interval","significance-level","p-value","sample-size"],"prerequisites":["confidence-interval","significance-level","p-value"]},{"slug":"population-parameter","title_ko":"모수","title_en":"Parameter","meaning":"모집단 전체가 실제로 가지고 있는, 우리가 알고 싶지만 직접 잴 수 없는 참값입니다.","subcategory":"기술통계·확률분포","level":1,"related":["sample-size","confidence-interval","confidence-level"],"prerequisites":[]},{"slug":"regression-assumptions","title_ko":"다중회귀분석의 가정","title_en":"Assumptions of Multiple Regression","meaning":"다중회귀분석 결과를 믿을 수 있으려면 데이터가 반드시 만족해야 하는 네 가지 전제 조건(선형성·독립성·등분산성·정규성)입니다.","subcategory":"회귀·상관분석","level":1,"related":["regression","residual-analysis"],"prerequisites":[],"aliases":["다중회귀분석의가정"]},{"slug":"standardized-residual","title_ko":"표준화잔차","title_en":"Standardized Residual","meaning":"회귀모형의 잔차(오차)를 표준편차 단위로 환산하여, 서로 다른 관측치의 오차 크기를 같은 기준으로 비교할 수 있게 만든…","subcategory":"회귀·상관분석","level":2,"related":["residual-analysis","cooks-distance","leverage"],"prerequisites":["residual-analysis","cooks-distance"]},{"slug":"leverage","title_ko":"레버리지(지렛대값)","title_en":"Leverage","meaning":"어떤 관측치의 독립변수 값이 다른 관측치들과 얼마나 동떨어져 있어서, 회귀선을 자기 쪽으로 끌어당길 힘을 얼마나 가지고…","subcategory":"회귀·상관분석","level":2,"related":["cooks-distance","standardized-residual","regression"],"prerequisites":["cooks-distance","regression"],"aliases":["레버리지","지렛대값"]},{"slug":"repeated-measures-anova","title_ko":"반복측정분산분석","title_en":"Repeated Measures ANOVA","meaning":"같은 대상을 세 번 이상 반복해서 측정한 값들 사이에 평균 차이가 있는지를, 측정치들끼리의 상관을 고려하면서 검정하는…","subcategory":"추론통계·가설검정","level":2,"related":["anova"],"prerequisites":["anova"]},{"slug":"likelihood-ratio-test","title_ko":"우도비검정","title_en":"Likelihood Ratio Test","meaning":"변수를 몇 개 더 넣은 복잡한 모형이, 그 변수들을 뺀 단순한 모형보다 데이터를 통계적으로 유의하게 더 잘 설명하는지를…","subcategory":"추론통계·가설검정","level":2,"related":["chi-square-test"],"prerequisites":[],"pop":19,"aliases":["LRT","가능도비검정"]},{"slug":"robust-regression","title_ko":"강건회귀","title_en":"Robust Regression","meaning":"몇 개의 극단적인 이상치가 있어도 그 값들에 크게 휘둘리지 않도록 설계된 회귀분석 방법입니다.","subcategory":"회귀·상관분석","level":3,"related":["regression","cooks-distance"],"prerequisites":["regression","cooks-distance"]},{"slug":"stationarity","title_ko":"정상성","title_en":"Stationarity","meaning":"시간이 흘러도 시계열 데이터의 평균, 분산, 자기상관 구조가 일정하게 유지되는 성질입니다.","subcategory":"다변량·고급기법","level":3,"related":[],"prerequisites":[]},{"slug":"cramers-v","title_ko":"크래머 V","title_en":"Cramér's V","meaning":"두 범주형 변수 사이의 연관성이 통계적으로 유의한지를 넘어, 그 연관성이 실제로 얼마나 강한지를 0에서 1 사이의 값으로…","subcategory":"비모수·범주형자료분석","level":2,"related":["chi-square-test","effect-size","pearson-spearman-correlation"],"prerequisites":["chi-square-test"],"aliases":["크래머V"]},{"slug":"dummy-variable","title_ko":"가변수(더미변수)","title_en":"Dummy Variable","meaning":"\"성별\"이나 \"지역\"처럼 숫자가 아닌 범주형 변수를 회귀분석에 넣을 수 있도록 0과 1로만 이루어진 숫자로 바꾼 변수입니다.","subcategory":"회귀·상관분석","level":1,"related":["regression","multicollinearity","logistic-regression"],"prerequisites":["regression","multicollinearity","logistic-regression"],"pop":8,"aliases":["가변수","더미변수"]},{"slug":"paired-t-test","title_ko":"대응표본 t검정","title_en":"Paired t-test","meaning":"같은 대상을 두 번 측정한 값의 차이가 통계적으로 유의한지를 검정하는 방법입니다.","subcategory":"추론통계·가설검정","level":1,"related":["t-test","wilcoxon-signed-rank-test","repeated-measures-anova","effect-size"],"prerequisites":["t-test","effect-size"],"aliases":["대응표본t검정"]},{"slug":"log-normal-distribution","title_ko":"로그정규분포","title_en":"Log-normal Distribution","meaning":"값 자체는 오른쪽으로 길게 치우쳐 있지만, 그 값에 로그를 취하면 정규분포를 이루는 확률분포입니다.","subcategory":"기술통계·확률분포","level":2,"related":["normal-distribution","skewness-kurtosis","t-test"],"prerequisites":["normal-distribution","skewness-kurtosis"],"aliases":["대수정규분포"]},{"slug":"hierarchical-regression","title_ko":"위계적 회귀분석","title_en":"Hierarchical Regression","meaning":"독립변수들을 연구자가 정한 이론적 순서에 따라 여러 단계로 나누어 투입하면서, 각 단계에서 설명력(R²)이 얼마나…","subcategory":"회귀·상관분석","level":2,"related":["regression","r-squared","statistical-mediation-moderation","multicollinearity"],"prerequisites":["regression","r-squared","multicollinearity"],"pop":1,"aliases":["위계적회귀분석"]},{"slug":"mahalanobis-distance","title_ko":"마할라노비스 거리","title_en":"Mahalanobis Distance","meaning":"여러 변수를 동시에 고려하면서, 변수들 사이의 상관관계까지 반영하여 한 관측치가 전체 데이터 집단의 중심에서 얼마나 떨어져…","subcategory":"다변량·고급기법","level":3,"related":["cooks-distance","multicollinearity","regression"],"prerequisites":[],"aliases":["마할라노비스거리"]},{"slug":"equivalence-testing","title_ko":"동등성 검정","title_en":"Equivalence Testing","meaning":"두 처치나 조건의 효과 차이가 실제로 무시할 수 있을 만큼 작다는 것을 통계적으로 확인하기 위해 사용하는 가설검정 방법입니다.","subcategory":"추론통계·가설검정","level":3,"related":["p-value","power-analysis","sample-size","effect-size"],"prerequisites":["p-value","effect-size"],"aliases":["동등성검정"]},{"slug":"g-power","title_ko":"지파워","title_en":"G*Power","meaning":"원하는 통계적 검정력을 얻기 위해 실험이나 조사에 몇 명(또는 몇 개)의 표본이 필요한지 계산해 주는 무료 통계…","subcategory":"소프트웨어·플랫폼","level":2,"related":["sample-size","statistical-power","effect-size","significance-level"],"prerequisites":[]},{"slug":"loess-regression","title_ko":"국소회귀","title_en":"LOESS Regression","meaning":"전체 데이터에 하나의 식을 억지로 맞추지 않고, 각 지점 주변 이웃 데이터만 이용해 부드러운 곡선을 그려주는 회귀 방법입니다.","subcategory":"회귀·상관분석","level":3,"related":[],"prerequisites":[]},{"slug":"youden-index","title_ko":"유든 지수","title_en":"Youden Index","meaning":"민감도와 특이도를 합쳐서, 진단검사에서 \"양성/음성을 가르는 가장 균형 잡힌 기준값\"을 찾아주는 지표입니다.","subcategory":"다변량·고급기법","level":2,"related":["sensitivity-specificity","auc-roc"],"prerequisites":["auc-roc"],"aliases":["유든지수"]},{"slug":"internal-consistency-reliability","title_ko":"내적일관성 신뢰도","title_en":"Internal Consistency Reliability","meaning":"하나의 척도를 이루는 여러 문항들이 실제로 같은 개념을 일관되게 측정하고 있는지를 나타내는 신뢰도입니다.","subcategory":"측정·타당도신뢰도","level":2,"related":["cronbachs-alpha","split-half-reliability"],"prerequisites":[],"pop":14,"aliases":["내적일관성신뢰도"]},{"slug":"interquartile-range","title_ko":"사분위범위","title_en":"Interquartile Range","meaning":"데이터를 크기 순으로 줄 세웠을 때 상위 25%(3사분위수)와 하위 25%(1사분위수) 사이의 값 범위로, 극단값에 흔들리지…","subcategory":"기술통계·확률분포","level":1,"related":["z-score","mahalanobis-distance"],"prerequisites":["z-score"],"aliases":["IQR","사분위수범위"]},{"slug":"mauchlys-test-of-sphericity","title_ko":"구형성 검정","title_en":"Mauchly's Test of Sphericity","meaning":"같은 대상을 세 번 이상 반복 측정했을 때, 그 측정 시점들 사이의 차이 점수들이 서로 비슷한 정도로 흩어져 있는지(분산이…","subcategory":"추론통계·가설검정","level":3,"related":["repeated-measures-anova","ancova","chi-square-test"],"prerequisites":["repeated-measures-anova","ancova"],"aliases":["MTS","구형성검정"]},{"slug":"randomized-block-design","title_ko":"무작위블록설계","title_en":"Randomized Block Design","meaning":"실험 대상을 미리 비슷한 특성끼리 묶어(블록으로 나누어) 놓은 다음, 각 블록 안에서만 처리를 무작위로 배정하는 실험설계…","subcategory":"실험설계·표본추출","level":2,"related":["stratified-randomization","power-analysis"],"prerequisites":[]},{"slug":"jamovi","title_ko":"jamovi","title_en":"jamovi","meaning":"SPSS처럼 메뉴 클릭만으로 통계분석을 할 수 있으면서도 완전히 무료로 배포되는 오픈소스 통계 소프트웨어입니다.","subcategory":"소프트웨어·플랫폼","level":1,"related":["spss","anova","effect-size"],"prerequisites":["spss"],"aliases":["자모비"]},{"slug":"dbscan","title_ko":"밀도기반 군집분석(DBSCAN)","title_en":"DBSCAN","meaning":"데이터가 촘촘하게 몰려 있는 부분을 하나의 군집으로 묶고, 어디에도 속하지 않는 외딴 점은 이상치로 남겨두는 군집분석…","subcategory":"다변량·고급기법","level":3,"related":["k-means-clustering","hierarchical-clustering","silhouette-score"],"prerequisites":[],"aliases":["밀도기반군집분석"]},{"slug":"silhouette-score","title_ko":"실루엣 계수","title_en":"Silhouette Score","meaning":"군집분석 결과에서 각 데이터가 자기 군집에는 잘 어울리고 다른 군집과는 잘 구별되는지를 -1에서 1 사이의 숫자로 나타낸…","subcategory":"다변량·고급기법","level":2,"related":["k-means-clustering","elbow-method","dbscan","hierarchical-clustering"],"prerequisites":["k-means-clustering","dbscan","hierarchical-clustering"],"aliases":["실루엣계수"]},{"slug":"elbow-method","title_ko":"엘보우 기법","title_en":"Elbow Method","meaning":"군집 수를 하나씩 늘려가며 군집 내 오차의 감소 폭을 그래프로 그린 뒤, 감소세가 확 꺾이는 지점(팔꿈치 모양)을 최적의…","subcategory":"다변량·고급기법","level":2,"related":["k-means-clustering","silhouette-score","hierarchical-clustering","dbscan"],"prerequisites":["k-means-clustering","hierarchical-clustering","dbscan"],"aliases":["엘보우기법"]},{"slug":"games-howell-test","title_ko":"게임스-하우웰 검정 (Games-Howell test)","title_en":"Games Howell Test","meaning":"집단 간 분산이 서로 다르고 표본크기도 다를 때, 어느 집단끼리 평균이 유의하게 다른지 짝지어 비교하는 사후검정입니다.","subcategory":"추론통계·가설검정","level":3,"related":["welch-anova","anova"],"prerequisites":["anova"],"aliases":["GHT","Games-Howell test","게임스 하우웰 검정","게임스 하우웰 검정 (Games Howell test)","게임스-하우웰 검정","게임스-하우웰검정","게임스-하우웰검정(Games-Howelltest)","게임스하우웰 검정","게임스하우웰 검정 (GamesHowell test)"]},{"slug":"welch-anova","title_ko":"웰치의 분산분석 (Welch's ANOVA)","title_en":"Welch ANOVA","meaning":"비교하려는 집단들의 분산(퍼짐 정도)이 서로 다를 때도 안전하게 평균 차이를 검정할 수 있도록 보정한…","subcategory":"추론통계·가설검정","level":2,"related":["anova","homoscedasticity-heteroscedasticity"],"prerequisites":["anova"],"aliases":["Welch's ANOVA","웰치의 분산분석","웰치의분산분석","웰치의분산분석(Welch'sANOVA)"]},{"slug":"nonparametric-test","title_ko":"비모수검정","title_en":"Nonparametric Test","meaning":"데이터가 정규분포 등 특정 분포를 따른다는 가정 없이, 주로 순위나 부호를 이용해 차이를 검정하는 방법입니다.","subcategory":"비모수·범주형자료분석","level":2,"related":["mann-whitney-u-test","wilcoxon-signed-rank-test","kruskal-wallis-test","chi-square-test"],"prerequisites":["mann-whitney-u-test","wilcoxon-signed-rank-test","kruskal-wallis-test"],"pop":9,"aliases":["비모수적검정"]},{"slug":"scheffes-test","title_ko":"셰페 검정","title_en":"Scheffé's Test","meaning":"ANOVA에서 집단 간 유의한 차이가 발견됐을 때, 구체적으로 어느 집단들 사이에 차이가 있는지 비교하는 사후검정 방법입니다.","subcategory":"추론통계·가설검정","level":2,"related":["anova","games-howell-test"],"prerequisites":["anova","games-howell-test"],"aliases":["셰페검정"]},{"slug":"jarque-bera-test","title_ko":"자크-베라 검정","title_en":"Jarque-Bera Test","meaning":"데이터의 왜도와 첨도를 이용해 그 데이터가 정규분포를 따르는지 검정하는 방법입니다.","subcategory":"비모수·범주형자료분석","level":3,"related":["skewness-kurtosis","normal-distribution","residual-analysis"],"prerequisites":[],"aliases":["JBT","자크 베라 검정","자크-베라검정","자크베라 검정"]},{"slug":"fleiss-kappa","title_ko":"플라이스 카파","title_en":"Fleiss' Kappa","meaning":"세 명 이상의 평가자가 매긴 범주형 판정이 우연히 일치했을 가능성을 빼고 실제로 얼마나 일치하는지를 나타내는 지표입니다.","subcategory":"비모수·범주형자료분석","level":2,"related":["cohen-kappa","internal-consistency-reliability","composite-reliability"],"prerequisites":[],"aliases":["플라이스카파"]},{"slug":"marginal-effects","title_ko":"한계효과","title_en":"Marginal Effects","meaning":"다른 조건은 그대로 둔 채 독립변수를 아주 조금 변화시켰을 때 결과(확률이나 값)가 실제로 얼마나 변하는지를 나타낸 값입니다.","subcategory":"회귀·상관분석","level":2,"related":["logistic-regression","odds-ratio"],"prerequisites":["logistic-regression"]},{"slug":"welchs-t-test","title_ko":"웰치 t검정","title_en":"Welch's t-test","meaning":"두 독립된 집단의 분산이 서로 다를 때도 안전하게 평균 차이를 검정할 수 있도록 보정한 t검정입니다.","subcategory":"추론통계·가설검정","level":1,"related":["t-test","welch-anova"],"prerequisites":["t-test","welch-anova"],"aliases":["웰치t검정"]},{"slug":"sobel-test","title_ko":"소벨 검정","title_en":"Sobel test","meaning":"매개변수를 거쳐 전달되는 간접효과가 통계적으로 유의한지를 검정하는 방법입니다.","subcategory":"다변량·고급기법","level":2,"related":["statistical-mediation-moderation"],"prerequisites":["statistical-mediation-moderation"],"aliases":["소벨검정"]},{"slug":"main-effect","title_ko":"주효과","title_en":"Main Effect","meaning":"다른 변수는 신경 쓰지 않고, 한 독립변수 하나가 종속변수에 미치는 평균적인 영향을 뜻합니다.","subcategory":"추론통계·가설검정","level":1,"related":["anova"],"prerequisites":["anova"]},{"slug":"cumulative-distribution-function","title_ko":"누적분포함수","title_en":"Cumulative Distribution Function","meaning":"어떤 값 이하가 나올 확률을 처음부터 차곡차곡 더해서 보여주는 함수입니다.","subcategory":"기술통계·확률분포","level":1,"related":["normal-distribution","percentile","z-score"],"prerequisites":["normal-distribution","z-score"],"aliases":["CDF","누적확률분포함수"]},{"slug":"eta-squared","title_ko":"에타제곱","title_en":"Eta Squared","meaning":"분산분석(ANOVA)에서 독립변수가 종속변수 전체 변동 중 얼마나 많은 부분을 설명하는지 나타내는 효과크기 지표입니다.","subcategory":"추론통계·가설검정","level":2,"related":["anova"],"prerequisites":["anova"],"pop":11},{"slug":"cohen-kappa","title_ko":"코헨의 카파","title_en":"Cohen's Kappa","meaning":"두 평가자의 범주형 판단이 우연히 일치할 가능성을 감안하고도 실제로 얼마나 일치하는지를 나타내는 통계치.","subcategory":"측정·타당도신뢰도","level":2,"related":["content-validity","intraclass-correlation-coefficient"],"prerequisites":[],"pop":12,"aliases":["카파계수","코헨카파"]},{"slug":"cluster-analysis","title_ko":"군집분석","title_en":"Cluster Analysis","meaning":"관측대상들을 서로 유사한 특성을 가진 몇 개의 집단(군집)으로 자동으로 묶어주는 다변량 분석 기법.","subcategory":"다변량·고급기법","level":2,"related":["k-means-clustering","hierarchical-clustering","principal-component-analysis","discriminant-analysis"],"prerequisites":["k-means-clustering","hierarchical-clustering","principal-component-analysis"],"aliases":["클러스터분석"]},{"slug":"discriminant-analysis","title_ko":"판별분석","title_en":"Discriminant Analysis","meaning":"이미 알려진 집단 소속을 가장 잘 구분해주는 변수들의 선형결합(판별함수)을 찾아 새로운 사례의 소속 집단을 예측하는 기법.","subcategory":"다변량·고급기법","level":2,"related":["principal-component-analysis","cluster-analysis","spss"],"prerequisites":["principal-component-analysis","spss"]},{"slug":"bonferroni-correction","title_ko":"본페로니 교정","title_en":"Bonferroni Correction","meaning":"여러 번의 통계 검정을 동시에 실시할 때 발생하는 1종 오류의 증가를 막기 위해 유의수준을 검정 횟수만큼 보수적으로 조정하는…","subcategory":"추론통계·가설검정","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["본페로니교정"]},{"slug":"spearman-correlation","title_ko":"스피어만 순위상관계수","title_en":"Spearman's Rank Correlation Coefficient","meaning":"두 변수 사이의 관계를 실제 값이 아닌 순위를 이용해 측정하는 비모수적 상관계수로, 비선형 단조관계도 탐지할 수 있다.","subcategory":"비모수·범주형자료분석","level":1,"related":["mann-whitney-u-test","kruskal-wallis-test"],"prerequisites":["mann-whitney-u-test","kruskal-wallis-test"],"aliases":["SRCC","스피어만순위상관계수"]},{"slug":"heteroscedasticity","title_ko":"이분산성","title_en":"Heteroscedasticity","meaning":"회귀분석의 오차항 분산이 독립변수의 값에 따라 일정하지 않고 달라지는 현상.","subcategory":"회귀·상관분석","level":2,"related":["variance-inflation-factor","robust-standard-errors"],"prerequisites":["variance-inflation-factor","robust-standard-errors"],"aliases":["이분산","이질분산성"]},{"slug":"k-fold-cross-validation","title_ko":"K-겹 교차검증","title_en":"K-Fold Cross-Validation","meaning":"자료를 K개의 부분집합으로 나누어 번갈아 훈련과 검증에 사용함으로써 예측모형의 성능을 안정적으로 평가하는 방법.","subcategory":"실험설계·표본추출","level":1,"related":["ridge-regression"],"prerequisites":[],"aliases":["K 겹 교차검증","K-겹교차검증","KFCV","K겹 교차검증"]},{"slug":"sas-software","title_ko":"SAS","title_en":"SAS (Statistical Analysis System)","meaning":"대용량 자료 처리와 고급 통계분석에 강점을 가진 상용 통계 소프트웨어로, 특히 의약품 임상시험 분야에서 표준으로 널리 쓰인다.","subcategory":"다변량·고급기법","level":1,"related":["spss"],"prerequisites":["spss"],"aliases":["Statistical Analysis System"]},{"slug":"amos-software","title_ko":"AMOS","title_en":"AMOS (Analysis of Moment Structures)","meaning":"경로도를 마우스로 그려가며 구조방정식모형을 시각적으로 구축하고 분석할 수 있는 SPSS 연동 상용 통계 소프트웨어.","subcategory":"다변량·고급기법","level":2,"related":["structural-equation-modeling","confirmatory-factor-analysis","path-analysis"],"prerequisites":["structural-equation-modeling","path-analysis"],"aliases":["Analysis of Moment Structures"]},{"slug":"minimum-description-length","title_ko":"최소기술길이 원리","title_en":"Minimum Description Length Principle","meaning":"여러 통계모형 중에서 자료 자체와 모형을 함께 가장 짧게 부호화(압축)할 수 있는 모형을 최선의 모형으로 선택하는…","subcategory":"다변량·고급기법","level":3,"related":[],"prerequisites":[],"aliases":["MDLP","최소기술길이원리"]},{"slug":"missing-data-mechanism","title_ko":"결측자료 메커니즘","title_en":"Missing Data Mechanism","meaning":"자료에서 값이 왜 누락되었는지를 그 누락 여부가 관측된 값이나 관측되지 않은 값과 통계적으로 어떤 관계를 가지는지에 따라…","subcategory":"다변량·고급기법","level":3,"related":["confounding-variable"],"prerequisites":[],"aliases":["결측자료메커니즘"]},{"slug":"error-correction-model","title_ko":"오차수정모형","title_en":"Error Correction Model","meaning":"장기균형에서 벗어난 정도가 단기 변화에 되먹임되는 구조를 담은 시계열 모형입니다.","subcategory":"회귀·상관분석","level":3,"related":["stationarity","vector-autoregression"],"prerequisites":[],"aliases":["오차수정메커니즘"]}]