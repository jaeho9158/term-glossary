[{"slug":"habitus","title_ko":"아비투스","title_en":"Habitus","meaning":"어린 시절부터 자라온 계급적·문화적 환경을 통해 몸에 배어, 무의식적으로 드러나는 취향·말투·행동 방식의 체계이다.","subcategory":"인류학·문화","level":1,"related":["social-capital","hegemony"],"prerequisites":[],"pop":17,"aliases":["아비투스 개념"]},{"slug":"hindsight-bias","title_ko":"사후확신편향","title_en":"Hindsight Bias","meaning":"어떤 일이 일어난 후에 처음부터 그럴 줄 알았다고 실제보다 더 확신하게 되는 경향이다.","subcategory":"인지심리","level":3,"related":["confirmation-bias","cognitive-bias","availability-heuristic","illusory-correlation","contingency"],"prerequisites":["confirmation-bias","cognitive-bias","availability-heuristic"]},{"slug":"iconography","title_ko":"도상학","title_en":"Iconography","meaning":"미술 작품에 등장하는 인물, 상징, 소재의 전통적 의미와 유래를 식별하고 분류하는 미술사 연구 방법으로, 파노프스키의 삼단계…","subcategory":"미술사조·도상학","level":1,"related":["panofsky-method","iconographic-analysis"],"prerequisites":[],"aliases":["이코노그래피","아이코노그래피"]},{"slug":"sahyo-haeseok","title_ko":"사료해석","title_en":"Source Interpretation","meaning":"비판을 거친 사료의 의미를 맥락 속에서 읽어내어 역사적 사실과 의미를 도출하는 작업.","subcategory":"역사학 방법론·사학사","level":3,"related":["gubi-sahyo"],"prerequisites":[]},{"slug":"gubi-sahyo","title_ko":"구비사료","title_en":"Oral Source","meaning":"문자 기록이 아닌 구전으로 전승되어 온 설화, 노래, 증언 등의 사료.","subcategory":"역사학 방법론·사학사","level":3,"related":["sahyo-haeseok"],"prerequisites":[],"aliases":["구술사료"]},{"slug":"marx-yeoksahak","title_ko":"마르크스주의 역사학","title_en":"Marxist Historiography","meaning":"생산양식과 계급투쟁을 역사 변동의 근본 동력으로 보고 이를 중심으로 역사를 분석하는 학문 전통.","subcategory":"역사학 방법론·사학사","level":3,"related":["annales-school","jinbo-sagwan"],"prerequisites":[],"aliases":["마르크스주의역사학"]},{"slug":"banhwasilhwa-yeoksa","title_ko":"반사실적 역사","title_en":"Counterfactual History","meaning":"만약 특정 사건이 다르게 일어났다면 어떻게 되었을지를 가정하여 역사적 인과관계를 검토하는 방법.","subcategory":"역사학 방법론·사학사","level":3,"related":["contingency"],"prerequisites":[],"aliases":["반사실적역사"]},{"slug":"jinbo-sagwan","title_ko":"진보사관","title_en":"Progressive View of History","meaning":"역사가 시간이 흐름에 따라 점차 더 나은 방향으로 발전해 간다고 보는 역사관.","subcategory":"역사학 방법론·사학사","level":3,"related":["marx-yeoksahak","heteronomy-theory"],"prerequisites":[],"aliases":["PVH"]},{"slug":"text-mining","title_ko":"텍스트마이닝","title_en":"Text Mining","meaning":"대량의 문헌 자료에서 컴퓨터 알고리즘을 이용해 어휘 패턴과 의미 구조를 추출하는 분석 기법.","subcategory":"역사학 방법론·사학사","level":3,"related":["sentiment-analysis"],"prerequisites":[],"pop":2},{"slug":"industrial-revolution","title_ko":"산업혁명","title_en":"Industrial Revolution","meaning":"18세기 후반 영국에서 시작되어 기계화된 생산방식과 공장제가 확산되며 경제·사회구조 전반을 변화시킨 역사적 과정.","subcategory":"세계사·한국사 핵심 개념","level":3,"related":[],"prerequisites":[],"pop":1},{"slug":"russian-revolution","title_ko":"러시아혁명","title_en":"Russian Revolution","meaning":"1917년 러시아에서 차르 전제정을 무너뜨리고 세계 최초의 사회주의 정권(소비에트 정부)이 수립된 혁명.","subcategory":"세계사·한국사 핵심 개념","level":1,"related":[],"prerequisites":[]},{"slug":"mercantilism","title_ko":"중상주의","title_en":"Mercantilism","meaning":"16~18세기 유럽 국가들이 금은 보유량 증대와 무역흑자를 통해 국부를 증진하려 한 경제정책과 이론.","subcategory":"세계사·한국사 핵심 개념","level":3,"related":[],"prerequisites":[]},{"slug":"liberalism","title_ko":"자유주의","title_en":"Liberalism","meaning":"개인의 자유와 권리, 사유재산과 법치를 중시하며 국가 권력의 제한을 지향하는 정치사상.","subcategory":"세계사·한국사 핵심 개념","level":2,"related":["communitarianism"],"prerequisites":[],"pop":5,"aliases":["리버럴리즘"]},{"slug":"united-nations","title_ko":"국제연합","title_en":"United Nations","meaning":"제2차 세계대전 이후 1945년 국제평화와 안전 유지를 목표로 창설된 국제기구.","subcategory":"세계사·한국사 핵심 개념","level":3,"related":["sustainable-development-goals","treaty-of-versailles","decolonization","non-state-actors"],"prerequisites":[],"aliases":["UN","유엔"]},{"slug":"treaty-of-versailles","title_ko":"베르사유 조약","title_en":"Treaty of Versailles","meaning":"1919년 제1차 세계대전 전후 처리를 위해 승전국과 독일 사이에 체결된 강화조약.","subcategory":"세계사·한국사 핵심 개념","level":3,"related":["united-nations"],"prerequisites":[],"aliases":["베르사유조약"]},{"slug":"detente","title_ko":"데탕트","title_en":"Détente","meaning":"1960~70년대 미국과 소련을 비롯한 냉전 진영 간 긴장이 완화된 국면.","subcategory":"세계사·한국사 핵심 개념","level":3,"related":["truman-doctrine"],"prerequisites":[],"aliases":["긴장완화"]},{"slug":"decolonization","title_ko":"탈식민화","title_en":"Decolonization","meaning":"제2차 세계대전 이후 아시아·아프리카의 식민지들이 독립국가로 전환된 역사적 과정.","subcategory":"세계사·한국사 핵심 개념","level":1,"related":["united-nations"],"prerequisites":[],"aliases":["탈식민지화"]},{"slug":"annales-school","title_ko":"아날학파","title_en":"Annales School","meaning":"20세기 프랑스에서 정치사 중심의 전통 역사학을 비판하며 사회사·경제사·심성사 등 장기지속적 구조를 중시한 역사학 조류.","subcategory":"세계사·한국사 핵심 개념","level":3,"related":["marx-yeoksahak"],"prerequisites":[],"aliases":["아날"]},{"slug":"truman-doctrine","title_ko":"트루먼독트린","title_en":"Truman Doctrine","meaning":"1947년 미국이 공산주의 확산 저지를 위해 그리스·튀르키예 등을 군사·경제적으로 지원하겠다고 선언한 외교정책.","subcategory":"세계사·한국사 핵심 개념","level":2,"related":["detente"],"prerequisites":[],"aliases":["트루먼주의"]},{"slug":"heteronomy-theory","title_ko":"타율성론","title_en":"Heteronomy Theory","meaning":"한국사가 자주적으로 전개되지 못하고 외세에 의해 타율적으로 규정되어 왔다고 주장한 식민사관의 논리.","subcategory":"세계사·한국사 핵심 개념","level":2,"related":[],"prerequisites":[],"aliases":["타율성사관"]},{"slug":"neo-confucianism","title_ko":"성리학","title_en":"Neo-Confucianism","meaning":"조선의 통치이념이 된, 우주의 원리와 인간의 도덕을 이기론으로 설명한 유교 철학사상.","subcategory":"세계사·한국사 핵심 개념","level":1,"related":[],"prerequisites":[],"pop":6,"aliases":["신유학","정주학","주자학"]},{"slug":"contingency","title_ko":"우연성","title_en":"Contingency","meaning":"어떤 명제가 실제로는 참이지만 다르게 될 수도 있었던, 즉 참일 수도 거짓일 수도 있는 양상적 지위를 가리킨다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["necessity","determinism","banhwasilhwa-yeoksa","hindsight-bias"],"prerequisites":[],"pop":10},{"slug":"determinism","title_ko":"결정론","title_en":"Determinism","meaning":"모든 사건은 이전 사건들과 자연법칙에 의해 오직 하나의 방식으로만 일어날 수 있도록 완전히 결정되어 있다는 형이상학적…","subcategory":"형이상학·인식론·논리학","level":1,"related":["free-will","contingency"],"prerequisites":[],"pop":14},{"slug":"mutual-assured-destruction","title_ko":"상호확증파괴","title_en":"Mutual Assured Destruction","meaning":"상호확증파괴(MAD)는 양측 모두 상대의 선제 핵공격에도 살아남아 치명적인 보복 핵공격을 가할 수 있는 능력을 갖춤으로써…","subcategory":"핵전략·억제","level":2,"related":["nuclear-brinkmanship"],"prerequisites":[],"aliases":["Mutually Assured Destruction"]},{"slug":"peer-review","title_ko":"동료심사","title_en":"Peer Review","meaning":"같은 분야 전문가들이 논문의 질과 타당성을 검토하는 출판 전 절차.","subcategory":"출판·저작권","level":1,"related":["literature-review","confirmation-bias","open-peer-review"],"prerequisites":[],"pop":15,"aliases":["동료평가","Peer Review in Archaeology"]},{"slug":"excavation-trench","title_ko":"발굴트렌치","title_en":"Excavation Trench","meaning":"유적의 층위와 유구를 확인하기 위하여 일정한 폭과 방향으로 길게 파 내려가는 조사 구덩이를 말한다.","subcategory":"고고학방법론·발굴기법","level":3,"related":["harris-matrix","arbitrary-level","archaeological-context","sieving"],"prerequisites":[]},{"slug":"associated-artifacts","title_ko":"공반유물","title_en":"Associated Artifacts","meaning":"동일한 유구나 동일한 층위에서 함께 출토되어 서로 시간적·기능적 연관성이 있다고 판단되는 유물들을 가리킨다.","subcategory":"고고학방법론·발굴기법","level":3,"related":["archaeological-context","harris-matrix"],"prerequisites":[],"pop":18},{"slug":"harris-matrix","title_ko":"해리스매트릭스","title_en":"Harris Matrix","meaning":"발굴로 확인된 모든 층위와 유구의 선후관계를 도표 형태로 표시하여 유적 전체의 상대적 시간 순서를 체계적으로 정리하는 층위…","subcategory":"고고학방법론·발굴기법","level":1,"related":["archaeological-context","excavation-trench","arbitrary-level","associated-artifacts"],"prerequisites":[]},{"slug":"archaeological-context","title_ko":"콘텍스트","title_en":"Archaeological Context","meaning":"유물이나 유구가 발견된 지점의 층위적·공간적 위치와 그것을 둘러싼 다른 자료와의 관계를 총칭하는 개념으로, 유물 해석의 기본…","subcategory":"고고학방법론·발굴기법","level":1,"related":["associated-artifacts","harris-matrix","arbitrary-level","excavation-trench"],"prerequisites":[],"pop":9},{"slug":"thermoluminescence-dating","title_ko":"열발광연대측정","title_en":"Thermoluminescence Dating","meaning":"토기나 소성 광물 결정 속에 방사선 피폭으로 축적된 에너지를 가열하여 방출되는 빛의 양을 측정함으로써 마지막으로 가열된…","subcategory":"고고학방법론·발굴기법","level":3,"related":[],"prerequisites":[],"aliases":["TL연대측정","열형광연대측정"]},{"slug":"arbitrary-level","title_ko":"인위층위","title_en":"Arbitrary Level","meaning":"자연적인 토층 경계가 명확하지 않을 때 일정한 두께(예: 10cm) 단위로 임의로 설정하여 발굴을 진행하는 인위적인 굴착…","subcategory":"고고학방법론·발굴기법","level":3,"related":["excavation-trench","harris-matrix","sieving"],"prerequisites":[]},{"slug":"sieving","title_ko":"체질법","title_en":"Sieving","meaning":"발굴 토양을 일정한 눈 크기의 체에 통과시켜 육안으로 놓치기 쉬운 소형 유물과 생태 유체를 선별해내는 기법으로, 습식체질과…","subcategory":"고고학방법론·발굴기법","level":3,"related":["excavation-trench","arbitrary-level"],"prerequisites":[]},{"slug":"microlith","title_ko":"세석기","title_en":"Microlith","meaning":"크기가 매우 작은 뗀석기로, 낱개 또는 여러 개를 자루에 결합하여 사용한 도구이다.","subcategory":"선사고고학·역사고고학","level":3,"related":["tanged-point","levallois-technique"],"prerequisites":["tanged-point"],"pop":12,"aliases":["잔석기"]},{"slug":"tanged-point","title_ko":"슴베찌르개","title_en":"Tanged Point","meaning":"자루에 장착하기 위한 슴베(자루부)를 가진 찌르개로, 한반도 후기구석기시대를 대표하는 사냥도구이다.","subcategory":"선사고고학·역사고고학","level":1,"related":["microlith","levallois-technique"],"prerequisites":[],"pop":13,"aliases":["유경첨두기"]},{"slug":"levallois-technique","title_ko":"르발루아기법","title_en":"Levallois Technique","meaning":"몸돌을 미리 정교하게 손질하여 원하는 형태의 격지를 예측 가능하게 떼어내는 중기구석기시대의 석기 제작 기법이다.","subcategory":"선사고고학·역사고고학","level":3,"related":["homo-erectus","tanged-point","microlith"],"prerequisites":[],"pop":19},{"slug":"homo-erectus","title_ko":"호모에렉투스","title_en":"Homo Erectus","meaning":"약 190만 년 전부터 아프리카와 아시아 등지에 널리 분포했던 화석 인류로, 전기구석기시대 석기 제작과 관련된다.","subcategory":"선사고고학·역사고고학","level":3,"related":["levallois-technique"],"prerequisites":[],"pop":16,"aliases":["곧선사람"]}]