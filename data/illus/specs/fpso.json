 "legend": [
  {
   "sym": "FPSO",
   "desc": "부유식 원유 생산·저장·하역 설비(floating production, storage and offloading)",
   "kind": "abbr"
  },
  {
   "sym": "톱사이드",
   "desc": "갑판 위 공정설비. 여기서 원유를 처리(물·가스 분리)한다",
   "kind": "term"
  },
  {
   "sym": "터렛",
   "desc": "계류줄과 라이저를 받는 회전 연결부. 편심 모멘트로 선체가 바람·조류 방향을 따라 돈다(weathervaning)",
   "kind": "term"
  },
  {
   "desc": "인셋 속 점은 터렛이고 점선 타원은 바뀐 선체 방향이다. 배치와 비례는 모식이며 수치는 없다. 셔틀탱커는 가끔 와서 원유를 실어 간다."
  }
 ],
