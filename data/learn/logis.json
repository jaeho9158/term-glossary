[{"slug":"outsourcing","title_ko":"아웃소싱","title_en":"Outsourcing","meaning":"기업이 내부에서 직접 수행하던 업무나 기능을 외부 전문업체에 위탁하여 처리함으로써 핵심역량에 자원을 집중하고 비용을…","subcategory":"경영전략·마케팅이론","level":2,"related":["core-competence","internalization-advantage","technology-transfer"],"prerequisites":["core-competence"],"aliases":["아웃소싱전략","Outsourcing Strategy"]},{"slug":"cross-docking","title_ko":"크로스도킹","title_en":"Cross-Docking","meaning":"입고된 상품을 물류센터에 장기 보관하지 않고 곧바로 분류해 대기 중인 출고 차량으로 옮겨 싣는 물류 운영 방식으로…","subcategory":"생산운영관리·경영정보시스템","level":1,"related":["supply-chain-management"],"prerequisites":[],"pop":9},{"slug":"offer-curve","title_ko":"오퍼곡선","title_en":"Offer Curve","meaning":"여러 상대가격 수준에서 한 나라가 수출하고자 하는 재화량과 수입하고자 하는 재화량의 조합을 나타내는 곡선으로, 두 나라의…","subcategory":"국제무역이론·무역정책","level":1,"related":["reciprocal-demand-theory"],"prerequisites":[],"aliases":["상호수요곡선","제공곡선"]},{"slug":"reciprocal-demand-theory","title_ko":"상호수요설","title_en":"Theory of Reciprocal Demand","meaning":"존 스튜어트 밀이 제시한 이론으로, 비교우위에 따른 특화 이후 실제 교역조건은 양국의 상대적 수요 강도, 즉 상호수요에 의해…","subcategory":"국제무역이론·무역정책","level":2,"related":["offer-curve"],"prerequisites":["offer-curve"],"aliases":["상호수요이론"]},{"slug":"stolper-samuelson-theorem","title_ko":"스톨퍼-사무엘슨 정리","title_en":"Stolper-Samuelson Theorem","meaning":"한 재화의 상대가격이 상승하면 그 재화 생산에 집약적으로 사용되는 생산요소의 실질보수는 증가하고, 다른 생산요소의 실질보수는…","subcategory":"국제무역이론·무역정책","level":1,"related":["rybczynski-theorem","factor-intensity"],"prerequisites":[],"aliases":["스톨퍼 사무엘슨 정리","스톨퍼-사무엘슨정리","스톨퍼사무엘슨 정리"]},{"slug":"rybczynski-theorem","title_ko":"립친스키 정리","title_en":"Rybczynski Theorem","meaning":"재화가격이 고정된 상태에서 한 생산요소의 부존량이 증가하면, 그 요소를 집약적으로 사용하는 재화의 생산량은 늘고 다른 재화의…","subcategory":"국제무역이론·무역정책","level":2,"related":["stolper-samuelson-theorem","factor-intensity"],"prerequisites":["stolper-samuelson-theorem","factor-intensity"],"aliases":["립친스키정리"]},{"slug":"factor-intensity","title_ko":"요소집약도","title_en":"Factor Intensity","meaning":"한 재화를 생산할 때 자본과 노동 등 생산요소들이 투입되는 상대적 비율을 나타내는 개념으로, 헥셔-오린 모형에서 재화를…","subcategory":"국제무역이론·무역정책","level":1,"related":["stolper-samuelson-theorem"],"prerequisites":[]},{"slug":"grubel-lloyd-index","title_ko":"그루벨-로이드 지수","title_en":"Grubel-Lloyd Index","meaning":"특정 산업에서 수출액과 수입액의 차이를 총무역액으로 나눈 값을 이용해 산업내무역의 비중을 0에서 1 사이의 수치로 측정하는…","subcategory":"국제무역이론·무역정책","level":2,"related":["horizontal-intra-industry-trade"],"prerequisites":["horizontal-intra-industry-trade"],"aliases":["그루벨 로이드 지수","그루벨-로이드지수","그루벨로이드 지수"]},{"slug":"horizontal-intra-industry-trade","title_ko":"수평적 산업내무역","title_en":"Horizontal Intra-industry Trade","meaning":"동일 산업 내에서 품질 수준은 비슷하지만 브랜드나 특성이 다른 차별화된 재화를 서로 수출하고 수입하는 산업내무역의 유형이다.","subcategory":"국제무역이론·무역정책","level":1,"related":["grubel-lloyd-index"],"prerequisites":[],"aliases":["수평적산업내무역"]},{"slug":"provisional-measures-in-trade-remedy","title_ko":"잠정조치","title_en":"Provisional Measures in Trade Remedy","meaning":"반덤핑·상계관세 조사가 진행되는 동안, 최종판정이 나오기 전에 국내산업의 추가적인 피해를 막기 위해 잠정적으로 부과하는 임시…","subcategory":"국제무역이론·무역정책","level":3,"related":[],"prerequisites":[],"aliases":["PMTR"]},{"slug":"j-curve-effect","title_ko":"J커브효과","title_en":"J-Curve Effect","meaning":"자국 통화가 평가절하되면 수출입 계약이 조정되는 데 시간이 걸려 단기적으로는 오히려 무역수지가 악화되었다가, 시간이 지나…","subcategory":"국제무역이론·무역정책","level":2,"related":["marshall-lerner-condition","trade-balance"],"prerequisites":["trade-balance"],"aliases":["JCE"]},{"slug":"marshall-lerner-condition","title_ko":"마샬-러너조건","title_en":"Marshall-Lerner Condition","meaning":"자국통화의 평가절하가 무역수지를 개선시키기 위해서는 수출수요의 가격탄력성과 수입수요의 가격탄력성의 합이 1보다 커야 한다는…","subcategory":"국제무역이론·무역정책","level":2,"related":["j-curve-effect","trade-balance"],"prerequisites":["trade-balance"],"aliases":["마샬 러너조건","마샬러너조건"]},{"slug":"greenfield-investment","title_ko":"그린필드 투자","title_en":"Greenfield Investment","meaning":"해외 현지에 기존 시설을 인수하지 않고 처음부터 새로운 생산설비나 자회사를 설립하는 투자 방식이다.","subcategory":"국제경영·환리스크관리","level":2,"related":["foreign-direct-investment"],"prerequisites":[],"aliases":["그린필드투자"]},{"slug":"leading-and-lagging","title_ko":"리딩과 래깅","title_en":"Leading and Lagging","meaning":"환율 변동을 예측하여 외화 결제 시점을 앞당기거나(리딩) 늦추는(래깅) 방식으로 환위험을 관리하는 기법이다.","subcategory":"국제경영·환리스크관리","level":2,"related":[],"prerequisites":[],"aliases":["리딩과래깅"]},{"slug":"natural-hedge","title_ko":"자연헤지","title_en":"Natural Hedge","meaning":"파생상품을 이용하지 않고 사업 운영 구조 자체를 조정하여 외화 수입과 지출을 서로 상쇄시킴으로써 환위험을 줄이는 방법이다.","subcategory":"국제경영·환리스크관리","level":1,"related":[],"prerequisites":[]},{"slug":"eclectic-paradigm","title_ko":"절충이론","title_en":"Eclectic Paradigm (OLI Framework)","meaning":"존 더닝이 제시한 이론으로, 기업이 해외직접투자를 선택하는 이유를 소유우위, 입지우위, 내부화우위라는 세 가지 조건의…","subcategory":"국제경영·환리스크관리","level":1,"related":["internalization-advantage","foreign-direct-investment"],"prerequisites":[],"aliases":["OLI Framework"]},{"slug":"internalization-advantage","title_ko":"내부화우위","title_en":"Internalization Advantage","meaning":"기업이 보유한 우위를 라이선싱 등으로 외부에 판매하기보다 직접 소유하고 운영함으로써 얻는 이점을 말한다.","subcategory":"국제경영·환리스크관리","level":1,"related":["eclectic-paradigm","internalization-theory"],"prerequisites":[]},{"slug":"internalization-theory","title_ko":"내부화이론","title_en":"Internalization Theory","meaning":"기업이 시장 거래의 불완전성으로 인한 비용을 피하기 위해 국경을 넘어선 활동을 외부 시장 대신 기업 내부(자회사)를 통해…","subcategory":"국제경영·환리스크관리","level":2,"related":["eclectic-paradigm","internalization-advantage"],"prerequisites":["eclectic-paradigm","internalization-advantage"]},{"slug":"incoterms","title_ko":"인코텀즈","title_en":"Incoterms","meaning":"국제상업회의소(ICC)가 제정한 국제무역 거래조건에 관한 표준 규칙으로, 매도인과 매수인 간 비용과 위험 분담 시점을…","subcategory":"국제경영·환리스크관리","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["국제상업조건","정형거래조건"]},{"slug":"international-fisher-effect","title_ko":"국제피셔효과","title_en":"International Fisher Effect (IFE)","meaning":"두 국가 간의 명목금리 차이가 미래의 현물환율 변동을 예측하는 지표가 된다는 이론으로, 금리가 높은 나라의 통화는 향후…","subcategory":"국제경영·환리스크관리","level":3,"related":[],"prerequisites":[],"aliases":["IFE"]},{"slug":"post-merger-integration","title_ko":"인수후통합","title_en":"Post-Merger Integration (PMI)","meaning":"인수