[{"slug":"hall-petch-relationship","title_ko":"홀-페치 관계식","title_en":"Hall-Petch Relationship","meaning":"다결정 금속의 항복강도가 결정립 크기의 제곱근에 반비례하여 증가한다는 것을 나타내는 경험적 관계식입니다.","subcategory":"금속재료·합금","level":2,"related":[],"prerequisites":[],"pop":20,"aliases":["HPR","홀 페치 관계식","홀-페치관계식","홀페치 관계식"]},{"slug":"twinning-induced-plasticity","title_ko":"쌍정유기소성","title_en":"Twinning-Induced Plasticity","meaning":"소성변형이 진행되는 동안 변형쌍정이 다량 형성되어 가공경화율을 높이고 강도와 연성을 동시에 향상시키는 현상, 또는 이를…","subcategory":"금속재료·합금","level":2,"related":["hall-petch-relationship"],"prerequisites":[],"aliases":["TWIP"]},{"slug":"solution-heat-treatment","title_ko":"용체화 열처리","title_en":"Solution Heat Treatment","meaning":"합금을 고온으로 가열하여 첨가 원소를 결정 구조 속에 완전히 녹여 균일한 고용체로 만든 뒤 급냉하여 그 상태를 실온까지…","subcategory":"금속재료·합금","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["용체화열처리"]},{"slug":"texture-development","title_ko":"결정학적 집합조직 발달","title_en":"Crystallographic Texture Development","meaning":"소성 가공이나 응고, 재결정 과정에서 다결정 재료 내 개별 결정립들의 결정 방위가 무작위 상태에서 특정 방향으로 우선적으로…","subcategory":"금속재료·합금","level":2,"related":[],"prerequisites":[],"aliases":["결정학적집합조직발달"]},{"slug":"eutectic-solidification","title_ko":"공정 응고","title_en":"Eutectic Solidification","meaning":"특정 조성의 액체 합금이 일정한 온도(공정점)에서 두 개 이상의 고상으로 동시에 분리되어 응고하는 현상입니다.","subcategory":"금속재료·합금","level":2,"related":[],"prerequisites":[],"pop":14,"aliases":["공정응고"]},{"slug":"single-crystal-superalloy","title_ko":"단결정 초합금","title_en":"Single Crystal Superalloy","meaning":"부품 전체가 결정립 경계 없이 단 하나의 결정으로 이루어지도록 제조한 초합금입니다.","subcategory":"금속재료·합금","level":2,"related":[],"prerequisites":[],"aliases":["단결정초합금"]},{"slug":"edge-and-screw-dislocation","title_ko":"칼날전위와 나사전위","title_en":"Edge and Screw Dislocation","meaning":"결정 내 선 결함인 전위를 버거스 벡터와 전위선의 상대적 방향에 따라 구분한 두 가지 기본 유형입니다.","subcategory":"금속재료·합금","level":2,"related":[],"prerequisites":[],"pop":12,"aliases":["칼날전위와나사전위"]},{"slug":"advanced-high-strength-steel","title_ko":"차세대 고강도강","title_en":"Advanced High-Strength Steel","meaning":"복합조직강, 변태유기소성강 등 여러 상이나 변태 메커니즘을 조합해 기존 강판보다 강도와 성형성을 동시에 높인 강판군을…","subcategory":"금속재료·합금","level":2,"related":[],"prerequisites":[],"pop":17,"aliases":["AHSS","차세대고강도강"]},{"slug":"kirkendall-effect","title_ko":"커켄달 효과","title_en":"Kirkendall Effect","meaning":"서로 다른 금속이 맞닿은 계면에서 두 원소의 확산 속도 차이로 인해 경계면이 이동하고 그 자리에 공공(빈자리)이 축적되는…","subcategory":"금속재료·합금","level":2,"related":[],"prerequisites":[],"pop":19,"aliases":["커켄달효과"]},{"slug":"r-curve-behavior","title_ko":"R-곡선 거동","title_en":"R-Curve Behavior","meaning":"균열이 진행됨에 따라 재료의 파괴 저항이 점점 증가하는 현상을 균열 길이에 대한 저항 곡선으로 나타낸 것입니다.","subcategory":"세라믹·복합재료","level":2,"related":[],"prerequisites":[],"aliases":["R 곡선 거동","R-곡선거동","R곡선 거동"]},{"slug":"rule-of-mixtures","title_ko":"혼합법칙","title_en":"Rule of Mixtures","meaning":"복합재료를 구성하는 각 성분의 물성을 부피(또는 무게) 비율로 가중평균하여 전체 재료의 물성을 예측하는 근사 이론입니다.","subcategory":"세라믹·복합재료","level":2,"related":[],"prerequisites":[]},{"slug":"vacuum-assisted-resin-infusion","title_ko":"진공수지함침성형","title_en":"Vacuum-Assisted Resin Infusion","meaning":"진공압을 이용해 섬유 강화재 안으로 수지를 빨아들여 함침시키는 개방형 복합재료 성형 공정입니다.","subcategory":"세라믹·복합재료","level":2,"related":[],"prerequisites":[],"aliases":["VARI"]},{"slug":"aerogel-insulation","title_ko":"에어로겔 단열재","title_en":"Aerogel Insulation","meaning":"에어로겔 단열재는 젤 속의 액체를 기체로 치환해 만든, 내부가 대부분 공기로 채워진 초경량 다공성 소재로, 매우 낮은…","subcategory":"세라믹·복합재료","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["에어로겔단열재"]},{"slug":"microphase-separation","title_ko":"미세상분리","title_en":"Microphase Separation","meaning":"화학적으로 서로 다른 블록들이 사슬로 연결되어 있어 완전히 분리되지는 못하고, 나노미터 규모에서 국소적으로 상이 나뉘는…","subcategory":"고분자·나노재료","level":2,"related":["lamellar-crystal-structure"],"prerequisites":[]},{"slug":"lamellar-crystal-structure","title_ko":"라멜라 결정구조","title_en":"Lamellar Crystal Structure","meaning":"고분자 사슬이 규칙적으로 접혀 쌓이면서 형성되는 얇은 판 모양의 결정 단위 구조입니다.","subcategory":"고분자·나노재료","level":2,"related":["glass-transition-temperature-polymer"],"prerequisites":[],"pop":15,"aliases":["라멜라결정구조"]},{"slug":"glass-transition-temperature-polymer","title_ko":"고분자 유리전이온도","title_en":"Glass Transition Temperature of Polymers","meaning":"비정질 고분자가 단단하고 유리질(glassy)인 상태에서 유연한 고무질(rubbery) 상태로 바뀌는 온도 구간의…","subcategory":"고분자·나노재료","level":2,"related":["viscoelasticity-of-polymers"],"prerequisites":[],"aliases":["GTTP","고분자유리전이온도"]},{"slug":"viscoelasticity-of-polymers","title_ko":"고분자 점탄성","title_en":"Viscoelasticity of Polymers","meaning":"고분자 재료가 점성(액체처럼 흐르는 성질)과 탄성(고체처럼 원래 모양으로 돌아가려는 성질)을 동시에 나타내는 성질입니다.","subcategory":"고분자·나노재료","level":2,"related":["stress-relaxation-polymer","glass-transition-temperature-polymer"],"prerequisites":[],"aliases":["고분자점탄성"]},{"slug":"stress-relaxation-polymer","title_ko":"고분자 응력이완","title_en":"Stress Relaxation in Polymers","meaning":"고분자 시료를 일정한 변형(길이)으로 유지했을 때 시간이 지남에 따라 내부 응력이 점차 감소하는 현상입니다.","subcategory":"고분자·나노재료","level":2,"related":["viscoelasticity-of-polymers"],"prerequisites":[],"aliases":["고분자응력이완"]},{"slug":"flory-huggins-theory","title_ko":"플로리-허긴스 이론","title_en":"Flory-Huggins Theory","meaning":"고분자와 용매(또는 두 고분자) 사이의 혼합 자유에너지를 격자 모델로 계산하여 고분자 용액이나 블렌드가 섞이는지 분리되는지를…","subcategory":"고분자·나노재료","level":2,"related":["polymer-blend-miscibility"],"prerequisites":[],"pop":8,"aliases":["FHT","플로리 허긴스 이론","플로리-허긴스이론","플로리허긴스 이론"]},{"slug":"cross-linking-density","title_ko":"가교밀도","title_en":"Cross-Linking Density","meaning":"고분자 사슬들이 화학적 결합(가교)으로 서로 연결된 정도, 즉 단위 부피(또는 단위 질량)당 가교점의 개수를 나타내는…","subcategory":"고분자·나노재료","level":2,"related":[],"prerequisites":[],"pop":9},{"slug":"polymer-blend-miscibility","title_ko":"고분자 블렌드 상용성","title_en":"Polymer Blend Miscibility","meaning":"서로 다른 두 종류 이상의 고분자를 섞었을 때 분자 수준에서 균일하게 섞여 하나의 상을 이루는 정도를 나타내는 개념입니다.","subcategory":"고분자·나노재료","level":2,"related":["flory-huggins-theory"],"prerequisites":[],"aliases":["고분자블렌드상용성"]},{"slug":"polymer-electrolyte-membrane","title_ko":"고분자 전해질막(양성자교환막)","title_en":"Polymer Electrolyte Membrane","meaning":"이온(주로 수소 이온)은 통과시키지만 전자와 기체는 막아 연료전지나 수전해 장치 등에서 전해질 역할을 하는 고분자 소재…","subcategory":"고분자·나노재료","level":2,"related":["self-healing-polymer"],"prerequisites":[],"aliases":["고분자전해질막","양성자교환막","Proton Exchange Membrane"]},{"slug":"self-healing-polymer","title_ko":"자가치유 고분자","title_en":"Self-Healing Polymer","meaning":"손상이나 균열이 생겼을 때 외부 개입 없이 혹은 최소한의 자극만으로 스스로 원래 구조와 기능을 회복하는 고분자 소재입니다.","subcategory":"고분자·나노재료","level":2,"related":["polymer-electrolyte-membrane"],"prerequisites":[],"pop":3,"aliases":["자가치유고분자"]},{"slug":"quantum-confinement-effect","title_ko":"양자구속 효과","title_en":"Quantum Confinement Effect","meaning":"반도체 입자의 크기가 전자와 정공이 자유롭게 움직일 수 있는 특성 거리보다 작아질 때, 전자 에너지 준위가 불연속적으로…","subcategory":"고분자·나노재료","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["QCE","양자구속효과"]},{"slug":"aerogel-nanostructure","title_ko":"에어로겔 나노구조","title_en":"Aerogel Nanostructure","meaning":"젤 내부의 액체를 기체로 치환하여 만든, 매우 낮은 밀도와 높은 기공률을 가진 나노다공성 고체의 미세 구조입니다.","subcategory":"고분자·나노재료","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["에어로겔나노구조"]},{"slug":"energy-dispersive-x-ray-spectroscopy","title_ko":"에너지분산형 X선분광법","title_en":"Energy-Dispersive X-Ray Spectroscopy","meaning":"시료에 전자빔이나 X선을 쬐어 발생하는 특성 X선의 에너지를 측정해 시료에 어떤 원소가 얼마나 들어있는지 분석하는 방법입니다.","subcategory":"재료분석·물성평가","level":2,"related":[],"prerequisites":[],"aliases":["EDXRS","에너지분산형X선분광법"]},{"slug":"nuclear-magnetic-resonance-spectroscopy-materials","title_ko":"재료 핵자기공명분광법","title_en":"Nuclear Magnetic Resonance Spectroscopy for Materials","meaning":"강한 자기장 속에서 원자핵이 특정 라디오파에 공명하는 성질을 이용해 재료의 국소적인 원자 배열과 화학적 환경을 분석하는…","subcategory":"재료분석·물성평가","level":2,"related":[],"prerequisites":[],"aliases":["NMRSM","재료핵자기공명분광법"]},{"slug":"nanoindentation-testing","title_ko":"나노압입시험","title_en":"Nanoindentation Testing","meaning":"매우 작은 압입자를 재료 표면에 나노미터 수준의 힘과 깊이로 눌러 넣어 경도와 탄성계수 같은 국소적인 기계적 물성을 측정하는…","subcategory":"재료분석·물성평가","level":2,"related":[],"prerequisites":[],"aliases":["나노인덴테이션"]},{"slug":"vickers-microhardness-test","title_ko":"비커스 미소경도시험","title_en":"Vickers Microhardness Test","meaning":"사각뿔 모양의 다이아몬드 압입자를 아주 작은 하중으로 시편 표면에 눌러 남긴 자국의 크기로부터 미시적인 경도를 측정하는 시험…","subcategory":"재료분석·물성평가","level":2,"related":["impact-toughness-test"],"prerequisites":[],"aliases":["VMT","비커스미소경도시험"]},{"slug":"impact-toughness-test","title_ko":"충격인성시험","title_en":"Impact Toughness Test","meaning":"노치가 가공된 시편에 진자형 해머를 순간적으로 충돌시켜 파괴에 흡수된 에너지를 측정함으로써 재료가 갑작스러운 충격에 얼마나…","subcategory":"재료분석·물성평가","level":2,"related":["vickers-microhardness-test"],"prerequisites":[],"pop":18},{"slug":"creep-rupture-testing","title_ko":"크리프 파단시험","title_en":"Creep Rupture Testing","meaning":"고온에서 일정한 하중을 장시간 지속적으로 가해, 재료가 서서히 늘어나다가 결국 파단에 이르는 과정을 시간에 따라 관찰하는…","subcategory":"재료분석·물성평가","level":2,"related":[],"prerequisites":[],"aliases":["크리프파단시험"]},{"slug":"grain-size-measurement-astm","title_ko":"ASTM법 결정립도 측정","title_en":"Grain Size Measurement by ASTM Method","meaning":"ASTM E112 표준에 따라 금속 조직 사진 속 결정립의 평균 크기를 지수(grain size number)로 환산해…","subcategory":"재료분석·물성평가","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["ASTM법결정립도측정","GSMAM"]},{"slug":"volmer-weber-growth","title_ko":"폴머-베버 성장 모드","title_en":"Volmer-Weber Growth Mode","meaning":"증착 원자들이 기판보다 자기들끼리 결합하는 것을 선호하여 처음부터 삼차원 섬 형태로 뭉쳐 성장하는 박막 성장 모드입니다.","subcategory":"박막 및 증착","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["VWGM","폴머 베버 성장 모드","폴머-베버성장모드","폴머베버 성장 모드"]},{"slug":"materials-genome-initiative","title_ko":"재료 게놈 이니셔티브","title_en":"Materials Genome Initiative","meaning":"계산, 실험, 데이터 인프라를 통합해 신소재의 발견부터 상용화까지 걸리는 시간을 단축하려는 미국 주도의 재료 연구 전략 및…","subcategory":"전산재료","level":2,"related":[],"prerequisites":[],"aliases":["MGI","재료게놈이니셔티브"]},{"slug":"thermoelectric-figure-of-merit","title_ko":"열전 성능지수","title_en":"Thermoelectric Figure of Merit","meaning":"열전 재료가 열을 전기로 얼마나 효율적으로 변환할 수 있는지를 나타내는 무차원 지표(ZT)입니다.","subcategory":"기능성재료","level":2,"related":[],"prerequisites":[],"aliases":["열전성능지수"]},{"slug":"lithium-dendrite-growth","title_ko":"리튬 덴드라이트 성장","title_en":"Lithium Dendrite Growth","meaning":"충전 과정에서 리튬 금속이 나뭇가지 모양으로 불균일하게 석출되어 자라나는 현상을 말합니다.","subcategory":"에너지재료","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["리튬덴드라이트성장"]},{"slug":"aerogel-microstructure","title_ko":"에어로겔 미세구조","title_en":"Aerogel Microstructure","meaning":"습윤겔 내부의 액체를 기체로 치환하여 만든, 나노 크기의 골격과 극도로 높은 기공률을 가진 다공성 고체의 미세한 내부 구조를…","subcategory":"다공성재료","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["에어로겔미세구조"]},{"slug":"glass-transition-temperature-measurement","title_ko":"유리전이온도 측정","title_en":"Glass Transition Temperature Measurement","meaning":"비정질 고분자나 유리질 재료가 단단하고 유리질인 상태에서 부드럽고 고무 같은 상태로 바뀌는 온도(유리전이온도, Tg)를…","subcategory":"고분자재료","level":2,"related":[],"prerequisites":[],"aliases":["GTTM","유리전이온도측정"]},{"slug":"inverse-hall-petch-effect","title_ko":"역홀-페치 효과","title_en":"Inverse Hall-Petch Effect","meaning":"결정립이 아주 작은 나노 스케일 영역에서는 일반적인 홀-페치 관계(결정립이 작을수록 강도가 증가)와 반대로, 결정립이 더…","subcategory":"기계적 물성","level":2,"related":[],"prerequisites":[],"pop":16,"aliases":["IHPE","역홀 페치 효과","역홀-페치효과","역홀페치 효과"]},{"slug":"fatigue-crack-propagation-model","title_ko":"피로균열 전파 모델","title_en":"Fatigue Crack Propagation Model","meaning":"반복 하중을 받는 재료 내부의 균열이 하중 반복 횟수에 따라 얼마나 빠르게 자라나는지를 정량적으로 예측하는 이론적/수학적…","subcategory":"파괴역학","level":2,"related":["ductile-brittle-transition-temperature"],"prerequisites":[],"aliases":["FCPM","피로균열전파모델"]},{"slug":"ductile-brittle-transition-temperature","title_ko":"연성-취성 천이온도","title_en":"Ductile-Brittle Transition Temperature","meaning":"체심입방 금속 등 일부 재료가 온도가 낮아짐에 따라 잘 늘어나는 연성 파괴 거동에서 쉽게 부서지는 취성 파괴 거동으로 급격히…","subcategory":"파괴역학","level":2,"related":["fatigue-crack-propagation-model"],"prerequisites":[],"aliases":["연성 취성 천이온도","연성취성 천이온도","연성-취성천이온도","Ductile-to-Brittle Transition Temperature","연성 취성천이온도","연성취성천이온도"]},{"slug":"pitting-corrosion-mechanism","title_ko":"공식부식 기구","title_en":"Pitting Corrosion Mechanism","meaning":"스테인리스강 등 보호 산화막을 가진 금속 표면의 국소적인 부위에서 산화막이 국부적으로 파괴되어, 좁고 깊은 구멍(공식)…","subcategory":"부식 및 열화","level":2,"related":[],"prerequisites":[],"aliases":["공식부식기구"]},{"slug":"constitutional-supercooling","title_ko":"조성적 과냉","title_en":"Constitutional Supercooling","meaning":"응고 계면 앞쪽 액체의 용질 농도 분포로 인해 실제 국부 온도가 그 조성에서의 평형 액상선 온도보다 낮아지는 현상으로, 응고…","subcategory":"응고","level":2,"related":[],"prerequisites":[],"aliases":["조성적과냉"]},{"slug":"kroger-vink-notation","title_ko":"크뢰거-빈크 표기법","title_en":"Kröger-Vink Notation","meaning":"결정 내 점결함의 종류, 위치, 유효전하를 표준화된 기호로 나타내어 결함 반응을 화학반응식처럼 표현하는 표기 체계입니다.","subcategory":"세라믹재료","level":2,"related":[],"prerequisites":[],"pop":13,"aliases":["KVN","크뢰거 빈크 표기법","크뢰거-빈크표기법","크뢰거빈크 표기법"]},{"slug":"radiation-damage-in-materials","title_ko":"재료의 방사선 손상","title_en":"Radiation Damage in Materials","meaning":"중성자, 이온, 감마선 등 고에너지 입자나 방사선이 재료 내부의 원자를 원래 자리에서 밀어내면서 발생하는 결함과 그로 인한…","subcategory":"핵재료","level":2,"related":["void-swelling-irradiation"],"prerequisites":[],"aliases":["재료의방사선손상"]},{"slug":"void-swelling-irradiation","title_ko":"조사 유기 공공 팽윤","title_en":"Void Swelling under Irradiation","meaning":"방사선 조사로 생긴 원자 빈자리(공공)들이 재료 내부에서 뭉쳐 미세한 빈 공간(보이드)을 형성하면서 재료의 부피가 눈에 띄게…","subcategory":"핵재료","level":2,"related":["radiation-damage-in-materials"],"prerequisites":[],"aliases":["VSUI","조사유기공공팽윤"]}]