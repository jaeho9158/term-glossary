[{"slug":"longitudinal-study","title_ko":"종단연구","title_en":"Longitudinal Study","meaning":"동일 대상을 시간에 따라 반복 관찰하며 변화를 추적하는 연구.","subcategory":"연구설계","level":1,"related":["cross-sectional-study","panel-data","cohort-effect"],"prerequisites":[],"pop":6,"aliases":["종단적 연구","종단적연구"]},{"slug":"cross-sectional-study","title_ko":"횡단연구","title_en":"Cross-sectional Study","meaning":"한 시점에서 여러 대상을 조사해 비교하는 연구.","subcategory":"연구설계","level":1,"related":["longitudinal-study","mixed-methods","delphi-method","cohort-effect","chronosystem"],"prerequisites":[],"pop":8,"aliases":["횡단적 연구","횡단적연구"]},{"slug":"self-efficacy","title_ko":"자기효능감","title_en":"Self-efficacy","meaning":"특정 과제를 성공적으로 수행할 수 있다는 스스로에 대한 믿음입니다.","subcategory":"성격·임상심리","level":1,"related":["intervention","construct","self-determination-theory","classical-conditioning","observational-learning"],"prerequisites":[],"aliases":["자아효능감"]},{"slug":"resilience","title_ko":"회복탄력성","title_en":"Resilience","meaning":"스트레스나 역경, 트라우마를 겪은 뒤에도 심리적으로 무너지지 않고 원래 상태로 회복하거나 오히려 더 성장하는 능력입니다.","subcategory":"성격·임상심리","level":1,"related":["emotion-regulation","learned-helplessness","emotional-intelligence"],"prerequisites":[],"pop":13,"aliases":["회복력","레질리언스","적응유연성","복원력"]},{"slug":"habituation","title_ko":"습관화","title_en":"Habituation","meaning":"같은 자극이 반복해서 주어질 때 그 자극에 대한 반응이 점점 줄어드는, 가장 단순한 형태의 학습 및 신경 적응 현상입니다.","subcategory":"인지신경과학","level":2,"related":["neuroplasticity","sensory-neuron","visual-cliff-experiment"],"prerequisites":[],"pop":2},{"slug":"sensorimotor-stage","title_ko":"감각운동기","title_en":"Sensorimotor Stage","meaning":"출생부터 약 2세까지로, 영아가 감각과 신체 운동을 통해 세계를 탐색하고 이해하는 피아제 인지발달의 첫 단계이며, 이 시기…","subcategory":"아동발달이론","level":1,"related":[],"prerequisites":[],"aliases":["감각운동단계"]},{"slug":"formal-operational-stage","title_ko":"형식적조작기","title_en":"Formal Operational Stage","meaning":"약 11세 이후로, 추상적·가설적 개념에 대한 논리적 추론과 가설연역적 사고가 가능해지는 피아제 인지발달의 마지막 단계이다.","subcategory":"아동발달이론","level":1,"related":[],"prerequisites":[],"aliases":["형식적조작단계"]},{"slug":"accommodation","title_ko":"조절","title_en":"Accommodation","meaning":"기존 도식으로 새로운 경험을 설명할 수 없을 때, 도식 자체를 수정하거나 새로운 도식을 만들어 환경에 맞추는 인지적 과정을…","subcategory":"아동발달이론","level":2,"related":[],"prerequisites":[]},{"slug":"imaginary-audience","title_ko":"상상적청중","title_en":"Imaginary Audience","meaning":"청소년이 실제로는 그렇지 않은데도 자신이 항상 타인의 주목과 평가의 대상이 되고 있다고 믿는 청소년자기중심성의 한 형태이다.","subcategory":"아동발달이론","level":2,"related":["formal-operational-stage"],"prerequisites":["formal-operational-stage"],"aliases":["상상적관중"]},{"slug":"three-mountains-task","title_ko":"세 산 모형 과제","title_en":"Three Mountains Task","meaning":"피아제와 인헬더가 아동의 공간적 조망 수용 능력을 측정하기 위해 고안한 과제로, 다른 위치에 있는 인형이 보게 될 산 모형의…","subcategory":"아동발달이론","level":3,"related":["egocentrism","perspective-taking"],"prerequisites":["perspective-taking"],"pop":11,"aliases":["세산모형과제"]},{"slug":"deferred-imitation","title_ko":"지연모방","title_en":"Deferred Imitation","meaning":"이전에 관찰했던 행동을 시간이 지난 후 모델이 없는 상황에서 재현하는 능력으로, 정신적 표상 능력의 획득을 보여주는…","subcategory":"아동발달이론","level":2,"related":["sensorimotor-stage"],"prerequisites":["sensorimotor-stage"],"pop":10,"aliases":["지연된모방"]},{"slug":"more-knowledgeable-other","title_ko":"유능한 타인","title_en":"More Knowledgeable Other","meaning":"아동보다 특정 영역에서 더 높은 이해나 능력을 지닌 사람으로, 부모, 교사, 유능한 또래 등 근접발달영역 내에서 학습을…","subcategory":"아동발달이론","level":3,"related":["scaffolding"],"prerequisites":[],"aliases":["MKO","유능한타인"]},{"slug":"identity-vs-role-confusion","title_ko":"정체감대역할혼미","title_en":"Identity vs. Role Confusion","meaning":"에릭슨 심리사회적발달이론의 다섯 번째 단계(청소년기)로, 자신이 누구인지에 대한 안정적인 정체감을 형성하는지 혹은 역할…","subcategory":"아동발달이론","level":2,"related":[],"prerequisites":[],"pop":19,"aliases":["IVRC"]},{"slug":"behavioral-inhibition","title_ko":"행동억제","title_en":"Behavioral Inhibition","meaning":"제롬 케이건이 제시한 기질적 특성으로, 낯설거나 새로운 사람·상황·사물에 대해 위축, 회피, 각성 반응을 일관되게 보이는…","subcategory":"아동발달이론","level":2,"related":[],"prerequisites":[],"pop":12},{"slug":"theory-of-mind-child","title_ko":"마음이론","title_en":"Theory of Mind","meaning":"타인이 자신과 다른 믿음, 욕구, 의도, 감정을 가질 수 있다는 것을 이해하는 능력으로, 대개 만 4세경 틀린믿음과제 통과를…","subcategory":"아동발달이론","level":1,"related":["perspective-taking","working-memory","emotional-intelligence"],"prerequisites":[],"pop":9,"aliases":["ToM","마음의 이론","마음읽기"]},{"slug":"perspective-taking","title_ko":"조망수용","title_en":"Perspective Taking","meaning":"타인의 입장, 시각, 생각, 감정을 이해하고 그 관점에서 상황을 바라볼 수 있는 인지적·정서적 능력을 말한다.","subcategory":"아동발달이론","level":1,"related":["theory-of-mind-child","egocentrism","three-mountains-task"],"prerequisites":[],"pop":5,"aliases":["관점수용"]},{"slug":"parten-stages-of-play","title_ko":"파튼의 놀이발달단계","title_en":"Parten's Stages of Play","meaning":"밀드레드 파튼이 유아의 사회적 참여 정도에 따라 놀이 행동을 비참여행동-방관자행동-혼자놀이-병행놀이-연합놀이-협동놀이의 여섯…","subcategory":"아동발달이론","level":1,"related":[],"prerequisites":[],"pop":3,"aliases":["파튼의놀이발달단계"]},{"slug":"preconventional-level","title_ko":"전인습적수준","title_en":"Preconventional Level","meaning":"콜버그 도덕성발달이론의 첫 번째 수준으로, 도덕적 판단이 처벌 회피나 보상 획득 등 행위의 직접적 결과에 근거하여 이루어지는…","subcategory":"아동발달이론","level":1,"related":[],"prerequisites":[],"pop":18,"aliases":["인습이전수준"]},{"slug":"bronfenbrenner-ecological-systems-theory","title_ko":"브론펜브레너 생태학적체계이론","title_en":"Bronfenbrenner's Ecological Systems Theory","meaning":"유리 브론펜브레너가 제시한 이론으로, 아동의 발달이 미시체계부터 거시체계, 시간체계에 이르는 여러 층위의 환경체계와의…","subcategory":"아동발달이론","level":1,"related":["microsystem","mesosystem","exosystem","chronosystem"],"prerequisites":[],"pop":1,"aliases":["BEST","브론펜브레너생태학적체계이론"]},{"slug":"microsystem","title_ko":"미시체계","title_en":"Microsystem","meaning":"브론펜브레너 생태학적체계이론에서 아동이 직접적으로 상호작용하는 가장 가까운 환경(가정, 어린이집, 또래집단 등)을 말한다.","subcategory":"아동발달이론","level":3,"related":["bronfenbrenner-ecological-systems-theory","mesosystem","exosystem"],"prerequisites":["bronfenbrenner-ecological-systems-theory","mesosystem","exosystem"],"pop":16},{"slug":"mesosystem","title_ko":"중간체계","title_en":"Mesosystem","meaning":"브론펜브레너 생태학적체계이론에서 아동을 둘러싼 여러 미시체계들(예: 가정과 어린이집) 간의 상호연결과 상호작용을 말한다.","subcategory":"아동발달이론","level":2,"related":["microsystem","bronfenbrenner-ecological-systems-theory","exosystem"],"prerequisites":["bronfenbrenner-ecological-systems-theory","exosystem"]},{"slug":"exosystem","title_ko":"외체계","title_en":"Exosystem","meaning":"브론펜브레너 생태학적체계이론에서 아동이 직접 참여하지는 않지만 아동에게 간접적으로 영향을 미치는 환경(예: 부모의 직장)을…","subcategory":"아동발달이론","level":1,"related":["mesosystem","bronfenbrenner-ecological-systems-theory"],"prerequisites":[],"pop":7},{"slug":"chronosystem","title_ko":"시간체계","title_en":"Chronosystem","meaning":"브론펜브레너가 생태학적체계이론에 추가한 개념으로, 시간의 흐름에 따른 개인적 사건(예: 이사, 부모 이혼)과 사회역사적…","subcategory":"아동발달이론","level":2,"related":["bronfenbrenner-ecological-systems-theory","cohort-effect"],"prerequisites":["bronfenbrenner-ecological-systems-theory"]},{"slug":"rooting-reflex","title_ko":"젖찾기반사","title_en":"Rooting Reflex","meaning":"신생아의 뺨이나 입 주변을 건드리면 자극이 있는 방향으로 고개를 돌리고 입을 벌리는 반사 행동으로, 수유를 위한 생존 기제로…","subcategory":"아동발달이론","level":2,"related":[],"prerequisites":[],"pop":20,"aliases":["근원반사","포유반사"]},{"slug":"metacognition-child","title_ko":"메타인지","title_en":"Metacognition","meaning":"자신의 인지 과정(생각하는 방식, 기억, 이해)에 대해 인식하고 이를 점검·조절하는 능력으로, '생각에 대한 생각'으로…","subcategory":"아동발달이론","level":1,"related":["cognitive-load","eeg","working-memory"],"prerequisites":[],"pop":14,"aliases":["초인지"]},{"slug":"visual-cliff-experiment","title_ko":"시각벼랑실험","title_en":"Visual Cliff Experiment","meaning":"엘리너 깁슨과 리처드 워크가 고안한 실험으로, 투명한 유리판 아래로 낭떠러지처럼 보이는 착시 장치를 이용해 영아의 깊이지각…","subcategory":"아동발달이론","level":3,"related":["habituation"],"prerequisites":[],"pop":4,"aliases":["시각절벽실험"]},{"slug":"montessori-education","title_ko":"몬테소리교육","title_en":"Montessori Education","meaning":"마리아 몬테소리가 창안한 교육방법으로, 아동이 스스로 선택한 활동을 통해 감각적·지적 발달을 이루도록 준비된 환경과 특수…","subcategory":"보육·유아교육","level":2,"related":[],"prerequisites":[],"pop":15},{"slug":"highscope-curriculum","title_ko":"하이스코프교육과정","title_en":"HighScope Curriculum","meaning":"미국 하이스코프 재단이 개발한 유아교육과정으로, '계획-실행-평가(Plan-Do-Review)' 과정을 통해 유아의 능동적…","s