[{"slug":"ausdruckstanz","title_ko":"아우스드루크스탄츠(표현무용)","title_en":"Ausdruckstanz","meaning":"20세기 초 독일어권을 중심으로 발전한 무용 흐름으로, 정형화된 발레 기법에서 벗어나 무용수 개인의 내적 감정과 신체 표현을…","subcategory":"무용사","level":2,"related":["corporeality"],"prerequisites":[],"aliases":["아우스드루크스탄츠","표현무용"]},{"slug":"corporeality","title_ko":"신체성","title_en":"Corporeality","meaning":"몸이 단순한 도구나 관념의 매개체가 아니라 그 자체로 경험과 의미를 생산하는 실존적 조건이라는 점을 강조하는 개념으로…","subcategory":"무용미학/이론","level":2,"related":["body-as-text"],"prerequisites":[],"pop":16},{"slug":"body-as-text","title_ko":"텍스트로서의 몸","title_en":"Body as Text","meaning":"무용수의 몸을 문화적·사회적 의미가 새겨지고 해석될 수 있는 하나의 텍스트로 바라보며, 몸의 움직임과 형태를 기호학적으로…","subcategory":"무용미학/이론","level":2,"related":["corporeality"],"prerequisites":[],"aliases":["텍스트로서의몸"]},{"slug":"movement-phrase","title_ko":"무브먼트 프레이즈","title_en":"Movement Phrase","meaning":"시작과 끝이 명확한 하나의 움직임 단위로, 여러 동작이 연결되어 의미와 흐름을 가지는 안무의 최소 구성 단위를 말합니다.","subcategory":"안무학","level":2,"related":["canon-choreographic-device"],"prerequisites":[],"aliases":["무브먼트프레이즈"]},{"slug":"canon-choreographic-device","title_ko":"캐논(안무기법)","title_en":"Canon","meaning":"동일한 동작을 여러 무용수가 시간차를 두고 순차적으로 수행하여 움직임이 이어지듯 퍼져나가는 효과를 만드는 안무 기법을…","subcategory":"안무학","level":2,"related":["movement-phrase"],"prerequisites":[],"pop":12,"aliases":["캐논"]},{"slug":"body-schema","title_ko":"신체도식","title_en":"Body Schema","meaning":"신체의 위치, 자세, 움직임을 조절하기 위해 뇌가 지속적으로 유지하는 무의식적이고 감각운동적인 신체 정보 체계를 말합니다.","subcategory":"무용동작치료","level":2,"related":["kinesphere"],"prerequisites":[],"pop":1},{"slug":"kinesphere","title_ko":"운동공간","title_en":"Kinesphere","meaning":"신체가 이동하지 않고 팔다리를 뻗어서 닿을 수 있는 신체 주변의 개인적 공간 범위를 말합니다.","subcategory":"라반움직임분석","level":2,"related":["body-schema"],"prerequisites":[],"aliases":["키네스피어"]},{"slug":"contraction-and-release","title_ko":"수축과 이완","title_en":"Contraction and Release","meaning":"호흡을 바탕으로 몸통(특히 복부와 척추)을 수축시켰다가 이완시키는 움직임을 반복하며 동작의 원동력을 만들어내는 현대무용의…","subcategory":"현대무용 기법","level":2,"related":[],"prerequisites":[],"pop"