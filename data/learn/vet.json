[{"slug":"brucellosis","title_ko":"브루셀라증","title_en":"Brucellosis","meaning":"브루셀라속(Brucella) 세균에 의해 발생하는 만성 인수공통감염병으로, 소·돼지·개 등에서 유산과 불임을 일으키고 사람은…","subcategory":"수의내과·수의병리","level":1,"related":[],"prerequisites":[],"aliases":["브루셀라병","파상열"]},{"slug":"pasteurellosis","title_ko":"파스튜렐라증","title_en":"Pasteurellosis","meaning":"파스튜렐라균(Pasteurella multocida 등)에 의한 세균성 감염병으로, 다양한 동물의 구강 및 상기도 상재균이…","subcategory":"수의내과·수의병리","level":2,"related":["cat-scratch-disease"],"prerequisites":[],"pop":7},{"slug":"cat-scratch-disease","title_ko":"묘소병","title_en":"Cat Scratch Disease","meaning":"바르토넬라 헨셀레(Bartonella henselae)에 의한 인수공통감염병으로, 고양이가 보균 벡터 역할을 하며 할큄이나…","subcategory":"수의내과·수의병리","level":2,"related":["pasteurellosis"],"prerequisites":[],"pop":10,"aliases":["고양이할큄병"]},{"slug":"canine-parvovirus-infection","title_ko":"개파보바이러스감염증","title_en":"Canine Parvovirus Infection","meaning":"개파보바이러스(CPV-2)에 의한 급성 바이러스성 장염으로, 어린 강아지에서 심한 출혈성 설사와 구토, 백혈구감소증을…","subcategory":"수의내과·수의병리","level":2,"related":[],"prerequisites":[],"aliases":["파보바이러스감염증","파보장염"]},{"slug":"feline-immunodeficiency-virus-infection","title_ko":"고양이면역결핍바이러스감염증","title_en":"Feline Immunodeficiency Virus Infection","meaning":"고양이면역결핍바이러스(FIV)에 의한 만성 레트로바이러스 감염으로, T림프구를 표적으로 면역기능을 서서히 저하시켜 기회감염에…","subcategory":"수의내과·수의병리","level":3,"related":["serum-biochemistry-panel"],"prerequisites":[],"pop":9,"aliases":["FIVI"]},{"slug":"bovine-viral-diarrhea","title_ko":"소바이러스성설사병","title_en":"Bovine Viral Diarrhea","meaning":"페스티바이러스속 BVD바이러스에 의한 소의 질환으로, 설사, 호흡기 증상, 생식장애를 일으키며 자궁 내 감염 시 지속감염…","subcategory":"수의내과·수의병리","level":3,"related":[],"prerequisites":[],"pop":12,"aliases":["BVD"]},{"slug":"frozen-section-examination","title_ko":"냉동절편검사","title_en":"Frozen Section Examination","meaning":"채취한 조직을 급속 냉동시켜 절편을 제작한 뒤 신속하게 염색·관찰하는 검사법으로, 수술 중 절제연 확인 등 즉각적 병리…","subcategory":"수의내과·수의병리","level":2,"related":[],"prerequisites":[],"pop":2},{"slug":"serum-biochemistry-panel","title_ko":"혈청생화학검사","title_en":"Serum Biochemistry Panel","meaning":"혈청 내 간·신장 효소, 단백질, 전해질, 대사산물 등을 정량 분석하여 장기 기능과 대사 상태를 평가하는 임상병리검사이다.","subcategory":"수의내과·수의병리","level":1,"related":["bile-acid-test"],"prerequisites":[],"pop":8},{"slug":"coagulation-panel","title_ko":"응고검사","title_en":"Coagulation Panel","meaning":"프로트롬빈시간(PT), 활성화부분트롬보플라스틴시간(aPTT) 등을 측정하여 혈액응고인자의 기능과 출혈성 질환 위험을 평가하는…","subcategory":"수의내과·수의병리","level":1,"related":[],"prerequisites":[],"pop":13},{"slug":"serum-protein-electrophoresis","title_ko":"혈청전기영동","title_en":"Serum Protein Electrophoresis","meaning":"전기장 내에서 혈청 단백질을 알부민과 여러 글로불린 분획으로 분리하여 그 비율 변화를 통해 만성 염증, 면역질환 등을…","subcategory":"수의내과·수의병리","level":3,"related":["serum-biochemistry-panel"],"prerequisites":["serum-biochemistry-panel"],"pop":14},{"slug":"bile-acid-test","title_ko":"담즙산검사","title_en":"Bile Acid Test","meaning":"공복 및 식후 혈청 담즙산 농도를 측정하여 간 기능과 문맥전신단락 등 간혈류 이상을 평가하는 기능검사이다.","subcategory":"수의내과·수의병리","level":1,"related":["serum-biochemistry-panel"],"prerequisites":[],"pop":5},{"slug":"urine-specific-gravity","title_ko":"요비중","title_en":"Urine Specific Gravity","meaning":"요 중 용질의 농도를 물과 비교하여 나타내는 지표로, 신장의 요농축 능력을 평가하는 데 사용되는 요검사 항목이다.","subcategory":"수의내과·수의병리","level":2,"related":["serum-biochemistry-panel"],"prerequisites":["serum-biochemistry-panel"],"pop":1,"aliases":["USG"]},{"slug":"fracture-reduction","title_ko":"골절정복술","title_en":"Fracture Reduction","meaning":"골절된 뼈의 정렬을 해부학적으로 정상 위치에 가깝게 맞추는 외과적 또는 비수술적 처치로, 이후 내固정이나 외固정을 통해…","subcategory":"수의내과·수의병리","level":2,"related":[],"prerequisites":[],"pop":4},{"slug":"cataract-surgery","title_ko":"백내장수술","title_en":"Cataract Surgery","meaning":"수정체가 혼탁해져 시력장애를 유발하는 백내장을 초음파유화술 등으로 제거하고 인공수정체를 삽입하여 시력을 회복시키는 안과…","subcategory":"수의내과·수의병리","level":3,"related":[],"prerequisites":[],"pop":6},{"slug":"ruminal-acidosis","title_ko":"반추위산증","title_en":"Ruminal Acidosis","meaning":"곡물 등 발효성 탄수화물의 과다 섭취로 반추위 내 젖산이 축적되어 pH가 급격히 낮아지는 대사성 질환으로, 반추위 점막…","subcategory":"수의내과·수의병리","level":1,"related":[],"prerequisites":[],"pop":11,"aliases":["산독증","루멘산독증","제1위산증"]},{"slug":"post-mortem-inspection","title_ko":"해체검사","title_en":"Post-mortem Inspection","meaning":"도축 후 도체와 내장을 해체하면서 육안 및 필요시 정밀검사로 병변과 이상 여부를 확인하는 검사.","subcategory":"수의공중보건·축산위생","level":1,"related":[],"prerequisites":[]},{"slug":"beak-trimming","title_ko":"부리다듬기","title_en":"Beak Trimming","meaning":"산란계 등에서 쪼기 행동으로 인한 상해를 예방하기 위해 부리 끝부분을 제거하는 시술.","subcategory":"수의공중보건·축산위생","level":3,"related":[],"prerequisites":[]},{"slug":"antimicrobial-resistance-animal","title_ko":"항생제내성관리(동물)","title_en":"Antimicrobial Resistance Management in Animals","meaning":"동물 사육 과정에서 항생제 오남용으로 인한 내성균 발생과 확산을 예방·관리하기 위한 정책 및 관리체계.","subcategory":"수의공중보건·축산위생","level":1,"related":[],"prerequisites":[],"aliases":["항생제내성관리"]},{"slug":"pcr-diagnosis","title_ko":"PCR검사","title_en":"Polymerase Chain Reaction (PCR) Diagnosis","meaning":"병원체의 유전물질을 증폭하여 감염 여부를 확인하는 분자생물학적 진단 검사법.","subcategory":"수의공중보건·축산위생","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["PCRD"]}]