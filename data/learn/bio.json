[{"slug":"crispr","title_ko":"크리스퍼","title_en":"CRISPR","meaning":"특정 DNA 서열을 정밀하게 자르고 편집할 수 있는 유전자 가위 기술입니다.","subcategory":"세포·분자생물학","level":2,"related":["pcr","epigenetics","mutation"],"prerequisites":[],"aliases":["크리스퍼 유전자가위"]},{"slug":"biodiversity","title_ko":"생물다양성","title_en":"Biodiversity","meaning":"유전자, 종, 생태계 수준에서 나타나는 생물의 다양함 전체를 가리키는 개념입니다.","subcategory":"생태·환경","level":1,"related":["symbiosis","natural-selection"],"prerequisites":[],"aliases":["생물다양성지수"]},{"slug":"symbiosis","title_ko":"공생","title_en":"Symbiosis","meaning":"서로 다른 두 생물종이 밀접하게 상호작용하며 살아가는 관계입니다.","subcategory":"생태·환경","level":1,"related":["biodiversity","homeostasis"],"prerequisites":[],"aliases":["공생관계"]},{"slug":"natural-selection","title_ko":"자연선택","title_en":"Natural Selection","meaning":"환경에 더 잘 적응한 개체가 살아남아 더 많은 자손을 남기면서, 집단 전체의 유전적 특성이 세대를 거치며 서서히 바뀌어 가는…","subcategory":"유전·진화","level":1,"related":["biodiversity","mutation"],"prerequisites":[],"aliases":["자연도태"]},{"slug":"pcr","title_ko":"중합효소연쇄반응","title_en":"PCR","meaning":"DNA의 특정 부위를 온도를 반복적으로 바꿔가며 짧은 시간 안에 수백만 배로 복제하는 실험 기법입니다.","subcategory":"세포·분자생물학","level":2,"related":["crispr","mass-spectrometry","calibration-curve","electrophoresis"],"prerequisites":["crispr"],"pop":12,"aliases":["폴리머라아제 연쇄반응","Polymerase Chain Reaction"]},{"slug":"mutation","title_ko":"돌연변이","title_en":"mutation","meaning":"DNA 염기서열이 원래와 다르게 변화하는 현상입니다.","subcategory":"유전·진화","level":1,"related":["natural-selection","crispr","epigenetics","apoptosis"],"prerequisites":[],"aliases":["변이"]},{"slug":"homeostasis","title_ko":"항상성","title_en":"Homeostasis","meaning":"생물이 외부 환경이 변해도 체온, 혈당, pH 같은 내부 상태를 일정한 범위로 유지하려는 성질입니다.","subcategory":"생리·발생","level":1,"related":["symbiosis","action-potential","mitochondria","apoptosis","circadian-rhythm","regulator-subsystem","neuman-systems-model"],"prerequisites":[],"aliases":["호메오스타시스","호메오스테이시스"]},{"slug":"epigenetics","title_ko":"후성유전학","title_en":"Epigenetics","meaning":"DNA 서열 자체는 바뀌지 않으면서 유전자가 켜지고 꺼지는 방식이 바뀌어 다음 세대까지 전달될 수 있는 현상을 연구하는…","subcategory":"유전·진화","level":2,"related":["mutation","crispr"],"prerequisites":["mutation"],"aliases":["에피제네틱스"]},{"slug":"mitochondria","title_ko":"미토콘드리아","title_en":"Mitochondria","meaning":"세포 안에서 영양소를 분해해 에너지(ATP)를 만들어내는 소기관으로, 세포의 \"발전소\" 역할을 합니다.","subcategory":"세포·분자생물학","level":1,"related":["apoptosis","homeostasis","photosynthesis"],"prerequisites":[]},{"slug":"apoptosis","title_ko":"세포자살(아폽토시스)","title_en":"Apoptosis","meaning":"손상되었거나 더 이상 필요 없는 세포가 스스로 죽음을 계획적으로 실행하는, 정상적이고 조절된 생물학적 과정입니다.","subcategory":"세포·분자생물학","level":1,"related":["mitochondria","mutation","homeostasis"],"prerequisites":[],"aliases":["세포예정사","세포자살","아폽토시스"]},{"slug":"photosynthesis","title_ko":"광합성","title_en":"Photosynthesis","meaning":"식물, 조류, 남세균이 빛에너지를 이용해 이산화탄소와 물로부터 유기물(포도당)과 산소를 만들어내는 과정입니다.","subcategory":"세포·분자생물학","level":1,"related":["mitochondria","coral-bleaching"],"prerequisites":[]},{"slug":"coral-bleaching","title_ko":"산호 백화현상","title_en":"Coral Bleaching","meaning":"바닷물 온도 상승 등의 스트레스로 산호가 몸속에 공생하던 조류(주산텔라)를 내쫓거나 잃으면서 하얗게 변하고, 지속되면 죽음에…","subcategory":"생태·환경","level":2,"related":["photosynthesis"],"prerequisites":[],"aliases":["산호백화","백화현상","산호백화현상"]},{"slug":"circadian-rhythm","title_ko":"일주기리듬","title_en":"Circadian Rhythm","meaning":"생물의 몸속에 내장된 약 24시간 주기의 생체시계로, 수면·체온·호르몬 분비 등을 주기적으로 조절하는 리듬입니다.","subcategory":"생리·발생","level":2,"related":["homeostasis"],"prerequisites":["homeostasis"],"aliases":["생체리듬","일주기 리듬"]},{"slug":"trophic-cascade","title_ko":"영양 캐스케이드","title_en":"Trophic Cascade","meaning":"먹이사슬의 한 단계(주로 포식자)가 변하면 그 영향이 아래 단계들로 연쇄적으로 퍼져나가는 현상입니다.","subcategory":"생태·환경","level":2,"related":[],"prerequisites":[],"aliases":["영양캐스케이드"]},{"slug":"enzyme","title_ko":"효소","title_en":"Enzyme","meaning":"생물의 몸속에서 화학반응이 훨씬 빠르게 일어나도록 도와주는 단백질로 이루어진 생체 촉매입니다.","subcategory":"세포·분자생물학","level":1,"related":["catalyst","ph-acid-base"],"prerequisites":[],"aliases":["효소단백질"]},{"slug":"abo-blood-type","title_ko":"ABO식 혈액형","title_en":"ABO Blood Type","meaning":"적혈구 표면의 항원 종류(A, B)에 따라 혈액형을 A형, B형, AB형, O형으로 나누고, 항원-항체 응집반응 때문에 아무…","subcategory":"유전·진화","level":2,"related":[],"prerequisites":[],"aliases":["ABO 혈액형","ABO식혈액형"]},{"slug":"reflex-arc","title_ko":"반사궁","title_en":"Reflex Arc","meaning":"뜨거운 물체에 손이 닿았을 때처럼, 자극이 뇌를 거치지 않고 척수를 통해 곧바로 운동신경으로 전달되어 빠르게 반응이 일어나는…","subcategory":"생리·발생","level":1,"related":["action-potential","synapse","homeostasis"],"prerequisites":["homeostasis"],"aliases":["무조건반사 경로"]},{"slug":"producer-consumer-decomposer","title_ko":"생산자·소비자·분해자","title_en":"Producer, Consumer, Decomposer","meaning":"생태계 안의 생물을 스스로 양분을 만드는 생산자, 다른 생물을 먹어 양분을 얻는 소비자, 죽은 생물이나 배설물을 분해하는…","subcategory":"생태·환경","level":1,"related":["photosynthesis"],"prerequisites":[],"pop":15,"aliases":["생산자 소비자 분해자","생태계 구성 요소","생산자소비자분해자"]},{"slug":"insect-metamorphosis","title_ko":"완전변태와 불완전변태","title_en":"Insect Metamorphosis","meaning":"곤충이 자라면서 몸의 형태가 크게 바뀌는 과정을 변태라고 하며, 번데기 단계를 거치면 완전변태, 거치지 않으면 불완전변태라고…","subcategory":"생리·발생","level":1,"related":["biodiversity"],"prerequisites":[],"aliases":["완전변태와불완전변태"]},{"slug":"transpiration","title_ko":"증산작용","title_en":"Transpiration","meaning":"식물이 잎에 있는 작은 구멍인 기공을 통해 몸속의 물을 수증기 형태로 공기 중으로 내보내는 작용입니다.","subcategory":"생리·발생","level":1,"related":["photosynthesis","diffusion"],"prerequisites":[],"aliases":["기공","Stomata"]},{"slug":"skeletal-system","title_ko":"골격계","title_en":"Skeletal System","meaning":"골격계는 몸을 지지하고 내부 장기를 보호하며 근육과 함께 움직임을 만들어내는, 뼈와 관절로 이루어진 몸의 뼈대 체계입니다.","subcategory":"생리·발생","level":1,"related":[],"prerequisites":[],"aliases":["뼈대계","골격 시스템","bone system"]},{"slug":"leaf-structure-stomata","title_ko":"잎의 구조와 기공","title_en":"Leaf Structure and Stomata","meaning":"잎은 표피, 엽육세포, 잎맥으로 이루어져 있으며, 잎 표피에 있는 작은 구멍인 기공을 통해 이산화탄소·산소·수증기 같은…","subcategory":"생리·발생","level":1,"related":["photosynthesis","transpiration"],"prerequisites":[],"aliases":["기공","잎맥","공변세포","잎의구조와기공"]},{"slug":"dna-sequencing","title_ko":"DNA 염기서열분석","title_en":"DNA Sequencing","meaning":"DNA를 이루는 A, T, G, C 네 염기가 어떤 순서로 배열되어 있는지 실제로 읽어내는 측정 기법입니다.","subcategory":"실험기기·측정장비","level":1,"related":["pcr","qpcr","mutation"],"prerequisites":[],"pop":16,"aliases":["염기서열분석","시퀀싱","NGS","차세대염기서열분석","DNA염기서열분석"]},{"slug":"autoclave","title_ko":"오토클레이브(고압멸균기)","title_en":"Autoclave","meaning":"고온·고압의 포화수증기를 이용해 실험 기구, 배지, 폐기물 속 미생물과 세균 포자까지 완전히 사멸시키는 고압증기멸균…","subcategory":"실험기기·측정장비","level":1,"related":["centrifuge","pcr","dna-sequencing"],"prerequisites":[],"aliases":["고압증기멸균기","autoclave sterilizer","고압멸균기","오토클레이브(고압멸균기)"]},{"slug":"southern-blot","title_ko":"서던 블롯","title_en":"Southern Blot","meaning":"DNA를 전기영동으로 크기별로 분리한 뒤 특정 염기서열에 결합하는 탐침으로 원하는 DNA 조각을 검출하는 분자생물학…","subcategory":"실험기기·측정장비","level":3,"related":["pcr","dna-sequencing"],"prerequisites":["dna-sequencing"],"aliases":["서던블롯"]},{"slug":"hardy-weinberg-equilibrium","title_ko":"하디-바인베르크 평형","title_en":"Hardy-Weinberg Equilibrium","meaning":"자연선택, 돌연변이, 이주, 유전적 부동 같은 요인이 없다면 한 집단의 유전자(대립유전자) 빈도는 세대가 지나도 변하지 않고…","subcategory":"유전·진화","level":2,"related":["natural-selection"],"prerequisites":[],"aliases":["하디 바인베르크 평형","하디-바인베르크평형","하디바인베르크 평형"]},{"slug":"coevolution","title_ko":"공진화","title_en":"Coevolution","meaning":"서로 밀접하게 상호작용하는 두 종이 상대방의 진화적 변화에 반응하며 함께 진화해 가는 현상입니다.","subcategory":"유전·진화","level":3,"related":["natural-selection","mutation"],"prerequisites":["natural-selection","mutation"]},{"slug":"punctuated-equilibrium","title_ko":"단속평형설","title_en":"Punctuated Equilibrium","meaning":"생물종이 오랫동안 거의 변하지 않고 안정된 상태로 머물다가, 짧은 기간에 급격한 종분화가 일어난다고 보는 진화 이론입니다.","subcategory":"유전·진화","level":3,"related":["natural-selection"],"prerequisites":["natural-selection"],"aliases":["단속평형이론"]},{"slug":"convergent-evolution","title_ko":"수렴진화","title_en":"Convergent Evolution","meaning":"서로 가까운 친척이 아닌 생물들이 비슷한 환경에 적응하는 과정에서 독립적으로 비슷한 형태나 기능을 진화시키는 현상입니다.","subcategory":"유전·진화","level":1,"related":["natural-selection","coevolution"],"prerequisites":[]},{"slug":"light-and-dark-reactions","title_ko":"광합성 명반응과 암반응","title_en":"Light and Dark Reactions","meaning":"광합성은 빛에너지로 ATP와 NADPH를 만드는 명반응과, 그 에너지로 이산화탄소를 포도당으로 바꾸는 암반응(캘빈 회로)의…","subcategory":"세포·분자생물학","level":1,"related":["photosynthesis","mitochondria","enzyme"],"prerequisites":["photosynthesis","mitochondria","enzyme"],"aliases":["광합성명반응과암반응"]},{"slug":"homologous-analogous-structures","title_ko":"상동기관과 상사기관","title_en":"Homologous and Analogous Structures","meaning":"상동기관은 생김새와 기능이 달라도 발생 기원이 같아 공통 조상을 보여주는 몸의 구조이고, 상사기관은 기원은 다르지만 비슷한…","subcategory":"유전·진화","level":1,"related":["natural-selection"],"prerequisites":["natural-selection"],"pop":14,"aliases":["상동기관과상사기관"]},{"slug":"dna-double-helix","title_ko":"DNA 이중나선구조","title_en":"DNA Double Helix","meaning":"DNA는 두 가닥의 폴리뉴클레오타이드가 나선 모양으로 꼬여 있고, 각 가닥의 염기가 상보적으로 결합해 유전정보를 안정적으로…","subcategory":"세포·분자생물학","level":1,"related":["mutation"],"prerequisites":[],"aliases":["DNA이중나선구조"]},{"slug":"fermentation","title_ko":"발효","title_en":"Fermentation","meaning":"산소가 없는 환경에서 세포가 포도당을 분해해 소량의 ATP를 얻고, 그 부산물로 젖산이나 알코올을 만들어내는 에너지 대사…","subcategory":"세포·분자생물학","level":1,"related":["mitochondria","enzyme","homeostasis"],"prerequisites":["mitochondria","enzyme"]},{"slug":"er-golgi-apparatus","title_ko":"소포체와 골지체","title_en":"ER and Golgi Apparatus","meaning":"소포체는 단백질과 지질을 합성·가공하고, 골지체는 이를 다듬고 포장해 목적지로 보내는 세포 내 물질 운반 경로를 담당하는…","subcategory":"세포·분자생물학","level":2,"related":["mitochondria"],"prerequisites":[],"pop":8,"aliases":["소포체와골지체"]},{"slug":"phenology","title_ko":"생물계절학","title_en":"Phenology","meaning":"개화, 발아, 철새 이동, 동면처럼 계절 변화에 따라 반복되는 생물의 생애 사건이 언제 일어나는지를 관찰하고 그 시기 변화의…","subcategory":"생태·환경","level":2,"related":[],"prerequisites":[]},{"slug":"symbiosis-types","title_ko":"공생의 유형","title_en":"Types of Symbiosis","meaning":"두 생물종이 함께 살아갈 때 서로에게 이득인지 손해인지에 따라 상리공생(둘 다 이득), 편리공생(한쪽만 이득, 다른 쪽은…","subcategory":"생태·환경","level":1,"related":[],"prerequisites":[],"aliases":["공생의유형"]},{"slug":"metapopulation","title_ko":"메타개체군","title_en":"Metapopulation","meaning":"서로 떨어져 있는 여러 개체군이 개체의 이동(이주)을 통해 느슨하게 연결되어, 전체가 하나의 상위 개체군처럼 기능하는…","subcategory":"생태·환경","level":3,"related":[],"prerequisites":[]},{"slug":"chromosome","title_ko":"염색체","title_en":"Chromosome","meaning":"세포 안에서 DNA가 단백질과 함께 촘촘히 감겨 뭉친, 유전정보를 담고 전달하는 구조물입니다.","subcategory":"세포·분자생물학","level":1,"related":["mutation"],"prerequisites":[]},{"slug":"crossing-over","title_ko":"교차","title_en":"crossing over","meaning":"감수분열 과정에서 상동염색체의 일부가 서로 맞닿아 유전물질을 교환하는 현상입니다.","subcategory":"유전·진화","level":1,"related":[],"prerequisites":[]},{"slug":"chlorophyll","title_ko":"엽록소","title_en":"Chlorophyll","meaning":"식물이나 조류의 엽록체 속에서 햇빛 에너지를 흡수해 광합성의 첫 단계를 일으키는 초록색 색소입니다.","subcategory":"세포·분자생물학","level":1,"related":["light-and-dark-reactions","leaf-structure-stomata"],"prerequisites":["light-and-dark-reactions"]},{"slug":"density-dependent-regulation","title_ko":"밀도의존적 개체군 조절","title_en":"Density-Dependent Population Regulation","meaning":"개체군의 밀도가 높아질수록 먹이 부족이나 경쟁, 질병 확산 등으로 개체당 출생률은 낮아지고 사망률은 높아져서, 결과적으로…","subcategory":"생태·환경","level":2,"related":["landscape-habitat-fragmentation"],"prerequisites":["landscape-habitat-fragmentation"],"aliases":["DDPR","밀도의존적개체군조절"]},{"slug":"fluid-mosaic-model","title_ko":"유동모자이크모델","title_en":"Fluid Mosaic Model","meaning":"세포막은 액체처럼 흐르는 인지질 이중층 위에 다양한 단백질이 조각조각 박혀 자유롭게 떠다니는 구조라는 세포막 모델입니다.","subcategory":"세포·분자생물학","level":1,"related":[],"prerequisites":[]},{"slug":"polygenic-inheritance","title_ko":"다인자유전","title_en":"Polygenic Inheritance","meaning":"키나 피부색처럼 한 가지 형질이 여러 개의 유전자가 함께 작용해 결정되어, 형질이 몇 가지로 딱 나뉘지 않고 연속적으로…","subcategory":"유전·진화","level":2,"related":[],"prerequisites":[],"aliases":["다유전자유전"]},{"slug":"tonicity","title_ko":"장성","title_en":"Tonicity","meaning":"세포를 둘러싼 용액이 세포 안팎의 물 이동을 통해 세포의 부피를 얼마나 부풀리거나 오그라들게 만드는지를 나타내는 상대적인…","subcategory":"세포·분자생물학","level":1,"related":["osmotic-pressure","homeostasis"],"prerequisites":[],"aliases":["긴장도"]},{"slug":"atp","title_ko":"아데노신삼인산","title_en":"ATP","meaning":"세포가 생명활동에 필요한 에너지를 저장하고 운반하는 데 쓰는 분자로, 흔히 \"세포의 에너지 화폐\"라고 불립니다.","subcategory":"세포·분자생물학","level":1,"related":["photosynthesis"],"prerequisites":["photosynthesis"],"pop":3,"aliases":["에이티피"]},{"slug":"exocytosis","title_ko":"세포외유출 (Exocytosis)","title_en":"Exocytosis","meaning":"세포 안의 막 주머니(소포)가 세포막과 합쳐지면서 그 속에 담겨 있던 물질을 세포 밖으로 내보내는 분비 과정입니다.","subcategory":"세포·분자생물학","level":1,"related":["action-potential"],"prerequisites":[],"aliases":["세포외유출","세포외유출(Exocytosis)"]},{"slug":"gpcr","title_ko":"G단백질연결수용체 (GPCR)","title_en":"GPCR","meaning":"세포막을 일곱 번 가로지르는 구조를 가진 수용체로, 호르몬이나 신경전달물질이 밖에서 달라붙으면 세포 안의 G단백질을 활성화해…","subcategory":"세포·분자생물학","level":3,"related":["exocytosis"],"prerequisites":["exocytosis"],"aliases":["G단백질연결수용체","G단백질연결수용체(GPCR)"]},{"slug":"survivorship-curve","title_ko":"개체군 생존곡선","title_en":"Survivorship Curve","meaning":"한 개체군이 태어난 순간부터 나이가 들어감에 따라 몇 마리가 살아남는지를 그래프로 나타낸 것으로, 죽음이 언제 주로…","subcategory":"생태·환경","level":2,"related":[],"prerequisites":[]},{"slug":"c3-c4-cam-photosynthesis","title_ko":"C3, C4, CAM 광합성","title_en":"C3, C4, CAM Photosynthesis","meaning":"식물이 공기 중 이산화탄소를 붙잡아 광합성 원료로 쓰는 방식을 기준으로 나눈 세 가지 전략(C3, C4, CAM)을 말합니다.","subcategory":"세포·분자생물학","level":2,"related":["photosynthesis","chlorophyll"],"prerequisites":["photosynthesis"],"aliases":["C3,C4,CAM광합성","CCCP"]},{"slug":"electron-transport-chain","title_ko":"전자전달계","title_en":"Electron Transport Chain","meaning":"미토콘드리아 내막에서 전자를 단계적으로 넘겨주며 그 에너지로 ATP를 대량으로 만들어내는 세포호흡의 마지막 단계입니다.","subcategory":"세포·분자생물학","level":2,"related":["atp"],"prerequisites":[],"aliases":["전자전달사슬"]},{"slug":"plasmid","title_ko":"플라스미드","title_en":"Plasmid","meaning":"세균 등의 세포 안에서 염색체와 별도로 존재하며 스스로 복제할 수 있는 작은 고리 모양의 DNA입니다.","subcategory":"세포·분자생물학","level":1,"related":["crispr"],"prerequisites":["crispr"]},{"slug":"endocytosis","title_ko":"세포내섭취작용","title_en":"Endocytosis","meaning":"세포막이 스스로 오목하게 들어가 주머니를 만들며 세포 바깥 물질을 통째로 감싸 안으로 끌어들이는 과정입니다.","subcategory":"세포·분자생물학","level":1,"related":["exocytosis","fluid-mosaic-model"],"prerequisites":["exocytosis"],"aliases":["세포내이입","엔도사이토시스"]},{"slug":"desertification","title_ko":"사막화","title_en":"Desertification","meaning":"건조·반건조 지역에서 기후변화와 인간 활동이 겹쳐 땅의 생산성이 떨어지고 점점 사막과 비슷한 상태로 황폐해지는 현상입니다.","subcategory":"생태·환경","level":2,"related":[],"prerequisites":[]},{"slug":"operon","title_ko":"오페론","title_en":"Operon","meaning":"여러 유전자가 하나의 스위치(프로모터·오퍼레이터)에 의해 한꺼번에 켜지고 꺼지도록 묶여 있는 원핵생물의 유전자 발현 조절…","subcategory":"세포·분자생물학","level":2,"related":[],"prerequisites":[]},{"slug":"central-dogma","title_ko":"중심원리","title_en":"central dogma","meaning":"유전 정보가 DNA에서 RNA를 거쳐 단백질로, 한 방향으로 흐른다는 분자생물학의 기본 원리입니다.","subcategory":"실험기기·측정장비","level":1,"related":["pcr"],"prerequisites":[],"pop":7,"aliases":["센트럴도그마"]},{"slug":"collagen","title_ko":"콜라겐","title_en":"collagen","meaning":"세 가닥이 꼬인 삼중나선 구조를 특징으로 하는, 인체에서 가장 많은 단백질로 피부와 결합조직에 구조적 지지와 탄력을…","subcategory":"세포·분자생물학","level":1,"related":[],"prerequisites":[]},{"slug":"transcription","title_ko":"전사","title_en":"transcription","meaning":"DNA에 저장된 유전 정보가 핵 안에서 전령 RNA(mRNA)로 복사되는 과정으로, 중심원리의 첫 단계입니다.","subcategory":"실험기기·측정장비","level":1,"related":["central-dogma","translation"],"prerequisites":["central-dogma"]},{"slug":"translation","title_ko":"번역","title_en":"translation (protein synthesis)","meaning":"전령 RNA(mRNA)의 정보를 리보솜이 읽어, 그에 대응하는 아미노산을 순서대로 이어 붙여 단백질을 만드는 과정입니다.","subcategory":"실험기기·측정장비","level":1,"related":["transcription","central-dogma"],"prerequisites":["central-dogma"],"aliases":["protein synthesis"]},{"slug":"agarose-gel-electrophoresis","title_ko":"아가로스 젤 전기영동","title_en":"Agarose Gel Electrophoresis","meaning":"DNA나 RNA 조각을 한천(아가로스) 젤 속에서 전기장을 걸어 크기별로 분리하는 실험법.","subcategory":"세포·분자생물학","level":2,"related":["capillary-electrophoresis-dna","plasmid-miniprep"],"prerequisites":["plasmid-miniprep"],"pop":6,"aliases":["AGE","아가로스젤전기영동"]},{"slug":"plasmid-miniprep","title_ko":"플라스미드 미니프렙","title_en":"Plasmid Miniprep","meaning":"소량(1~5mL)의 세균 배양액에서 플라스미드 DNA를 빠르게 정제해내는 소규모 실험법.","subcategory":"세포·분자생물학","level":2,"related":["blue-white-screening","gibson-assembly"],"prerequisites":[],"aliases":["플라스미드미니프렙"]},{"slug":"gibson-assembly","title_ko":"깁슨 어셈블리","title_en":"Gibson Assembly","meaning":"여러 DNA 조각의 말단을 겹치는 서열로 설계해 제한효소 없이 한 번의 반응으로 이어 붙이는 클로닝 기법.","subcategory":"세포·분자생물학","level":3,"related":["golden-gate-assembly","plasmid-miniprep"],"prerequisites":[],"aliases":["깁슨어셈블리"]},{"slug":"golden-gate-assembly","title_ko":"골든게이트 어셈블리","title_en":"Golden Gate Assembly","meaning":"인식 서열 바깥쪽을 자르는 타입 IIS 제한효소를 이용해 여러 DNA 조각을 정해진 순서와 방향으로 한 번에 조립하는 클로닝…","subcategory":"세포·분자생물학","level":3,"related":["gibson-assembly","plasmid-miniprep"],"prerequisites":["gibson-assembly","plasmid-miniprep"],"aliases":["골든게이트어셈블리"]},{"slug":"blue-white-screening","title_ko":"블루-화이트 스크리닝","title_en":"Blue-White Screening","meaning":"삽입된 DNA로 인해 lacZ 유전자가 파괴된 콜로니는 흰색, 파괴되지 않은 콜로니는 파란색으로 나타나는 색 변화를 이용해…","subcategory":"세포·분자생물학","level":2,"related":["plasmid-miniprep"],"prerequisites":["plasmid-miniprep"],"aliases":["블루 화이트 스크리닝","블루-화이트스크리닝","블루화이트 스크리닝"]},{"slug":"od600-measurement","title_ko":"OD600 측정","title_en":"OD600 Measurement","meaning":"600나노미터 파장의 빛을 이용해 세균 배양액의 탁도를 측정함으로써 세균 농도를 간접적으로 추정하는 방법.","subcategory":"세포·분자생물학","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["OD600측정"]},{"slug":"nanodrop-spectrophotometer","title_ko":"나노드롭 분광광도계","title_en":"NanoDrop Spectrophotometer","meaning":"희석이나 큐벳 없이 1~2마이크로리터의 극소량 시료만으로 핵산·단백질 농도와 순도를 측정하는 소형 분광광도계.","subcategory":"세포·분자생물학","level":2,"related":["plasmid-miniprep","bioanalyzer-tapestation"],"prerequisites":["plasmid-miniprep"],"aliases":["나노드롭분광광도계"]},{"slug":"lipid-nanoparticle-delivery","title_ko":"지질나노입자 전달","title_en":"Lipid Nanoparticle (LNP) Delivery","meaning":"지질로 이루어진 나노 크기의 입자 안에 mRNA나 siRNA 같은 핵산을 감싸 세포 안으로 전달하는 비바이러스성 전달 기법.","subcategory":"세포·분자생물학","level":3,"related":["nucleofection"],"prerequisites":[],"aliases":["지질나노입자전달"]},{"slug":"nucleofection","title_ko":"뉴클레오펙션","title_en":"Nucleofection","meaning":"세포 유형별로 최적화된 전기 펄스 프로그램과 전용 완충액을 이용해 핵산을 세포질뿐 아니라 핵까지 효율적으로 전달하는 전기천공…","subcategory":"세포·분자생물학","level":3,"related":["lipid-nanoparticle-delivery"],"prerequisites":["lipid-nanoparticle-delivery"]},{"slug":"scanning-electron-microscopy","title_ko":"주사전자현미경","title_en":"Scanning Electron Microscopy (SEM)","meaning":"전자빔을 시료 표면에 주사(스캔)하며 튕겨 나오는 전자 신호를 검출해 시료 표면의 3차원적 형태를 매우 세밀하게 관찰하는…","subcategory":"세포·분자생물학","level":3,"related":[],"prerequisites":[],"aliases":["주사전자현미경법"]},{"slug":"trypan-blue-exclusion","title_ko":"트립판 블루 배제법","title_en":"Trypan Blue Exclusion Assay","meaning":"살아있는 세포는 막이 손상되지 않아 염색약이 침투하지 못하고, 죽은 세포는 막이 손상되어 염색되는 성질을 이용해 세포…","subcategory":"세포·분자생물학","level":2,"related":[],"prerequisites":[],"aliases":["TBEA","트립판블루배제법"]},{"slug":"bioanalyzer-tapestation","title_ko":"바이오애널라이저/테이프스테이션","title_en":"Bioanalyzer / TapeStation","meaning":"미세유체 칩 기반의 자동 모세관 전기영동을 이용해 DNA·RNA 시료의 크기 분포와 품질(무결성)을 정밀하게 측정하는 전용…","subcategory":"세포·분자생물학","level":3,"related":["nanodrop-spectrophotometer","capillary-electrophoresis-dna"],"prerequisites":[],"aliases":["바이오애널라이저 테이프스테이션","바이오애널라이저테이프스테이션"]},{"slug":"ecotone","title_ko":"추이대(전이대)","title_en":"Ecotone","meaning":"서로 다른 두 생태계나 서식지 유형 사이에 형성되는 점이적 경계 지역으로, 양쪽 생태계의 특성이 혼재되어 나타나는 구간이다.","subcategory":"생태·환경","level":2,"related":[],"prerequisites":[],"aliases":["생태추이대","이행대","전이대","추이대(전이대)"]},{"slug":"turnover-number","title_ko":"회전율 (kcat)","title_en":"Turnover number (kcat)","meaning":"효소 한 분자가 단위 시간당 기질을 생성물로 전환시키는 최대 횟수를 나타내는 속도 상수.","subcategory":"세포·분자생물학","level":2,"related":["catalytic-efficiency"],"prerequisites":[],"aliases":["kcat","회전율(kcat)"]},{"slug":"catalytic-efficiency","title_ko":"촉매 효율 (kcat/Km)","title_en":"Catalytic efficiency (kcat/Km)","meaning":"효소가 기질을 얼마나 빠르고 효과적으로 생성물로 전환하는지를 나타내는 지표로, kcat을 Km으로 나눈 값.","subcategory":"세포·분자생물학","level":2,"related":["turnover-number"],"prerequisites":[],"aliases":["kcat/Km","촉매 효율","촉매 효율 (kcat Km)","촉매 효율 (kcatKm)","촉매효율","촉매효율(kcat/Km)"]},{"slug":"noncompetitive-inhibition","title_ko":"비경쟁적 억제","title_en":"Noncompetitive inhibition","meaning":"억제제가 활성 부위가 아닌 다른 부위에 결합하여 기질 농도와 무관하게 효소 활성을 저해하는 억제 방식.","subcategory":"세포·분자생물학","level":2,"related":["allosteric-regulation"],"prerequisites":[],"aliases":["비경쟁적억제"]},{"slug":"allosteric-regulation","title_ko":"알로스테릭 조절 (다른자리 입체 조절)","title_en":"Allosteric regulation","meaning":"조절 물질이 효소의 활성 부위가 아닌 다른 부위(알로스테릭 부위)에 결합하여 효소의 구조와 활성을 변화시키는 조절 방식.","subcategory":"세포·분자생물학","level":2,"related":["cooperativity","allosteric-site"],"prerequisites":[],"aliases":["다른자리 입체 조절","알로스테릭 조절","알로스테릭조절","알로스테릭조절(다른자리입체조절)"]},{"slug":"cooperativity","title_ko":"협동성","title_en":"Cooperativity","meaning":"여러 소단위로 이루어진 효소나 단백질에서 한 자리에 리간드가 결합하면 다른 자리의 결합 친화도가 변하는 현상.","subcategory":"세포·분자생물학","level":2,"related":["allosteric-regulation","allosteric-site"],"prerequisites":[],"aliases":["협동효과"]},{"slug":"cysteine-protease","title_ko":"시스테인 단백질분해효소","title_en":"Cysteine protease","meaning":"활성 부위의 시스테인 잔기의 티올기를 이용해 펩타이드 결합을 가수분해하는 단백질분해효소.","subcategory":"세포·분자생물학","level":2,"related":["caspase"],"prerequisites":[],"aliases":["시스테인단백질분해효소"]},{"slug":"hydrolase","title_ko":"가수분해효소","title_en":"Hydrolase","meaning":"물 분자를 이용해 화학 결합을 끊는 반응을 촉매하는 효소의 총칭.","subcategory":"세포·분자생물학","level":2,"related":["alkaline-phosphatase","acetylcholinesterase","phosphodiesterase"],"prerequisites":[]},{"slug":"hexokinase","title_ko":"헥소키나아제","title_en":"Hexokinase","meaning":"포도당의 6번 탄소에 ATP로부터 인산기를 옮겨 포도당-6-인산을 생성하는, 해당과정의 첫 단계를 촉매하는 효소.","subcategory":"세포·분자생물학","level":2,"related":["catalytic-efficiency"],"prerequisites":[],"aliases":["헥소키네이스"]},{"slug":"caspase","title_ko":"카스파아제","title_en":"Caspase","meaning":"세포자멸사(아폽토시스) 과정을 실행하는 시스테인 단백질분해효소 계열로, 아스파르트산 잔기 뒤쪽의 펩타이드 결합을 특이적으로…","subcategory":"세포·분자생물학","level":2,"related":["cysteine-protease"],"prerequisites":[],"pop":9,"aliases":["카스페이스"]},{"slug":"ribozyme","title_ko":"리보자임 (RNA 촉매)","title_en":"Ribozyme","meaning":"단백질이 아닌 RNA로 이루어져 있으면서도 화학 반응을 촉매하는 능력을 가진 RNA 분자.","subcategory":"세포·분자생물학","level":3,"related":["catalytic-efficiency"],"prerequisites":["catalytic-efficiency"],"aliases":["RNA 촉매","리보자임","리보자임(RNA촉매)"]},{"slug":"catalase","title_ko":"카탈레이스","title_en":"Catalase","meaning":"세포 내 독성 물질인 과산화수소를 물과 산소로 신속하게 분해하는 효소.","subcategory":"세포·분자생물학","level":1,"related":["superoxide-dismutase","turnover-number","horseradish-peroxidase"],"prerequisites":[],"aliases":["카탈라아제"]},{"slug":"superoxide-dismutase","title_ko":"슈퍼옥사이드 디스뮤타아제","title_en":"Superoxide dismutase (SOD)","meaning":"세포 내 활성산소인 슈퍼옥사이드 라디칼을 산소와 과산화수소로 전환시켜 산화 스트레스로부터 세포를 보호하는 효소.","subcategory":"세포·분자생물학","level":2,"related":["catalase","horseradish-peroxidase","cytochrome-p450"],"prerequisites":["catalase"],"pop":1,"aliases":["슈퍼옥사이드디스뮤타아제"]},{"slug":"cytochrome-p450","title_ko":"시토크롬 P450","title_en":"Cytochrome P450","meaning":"헴을 보조인자로 가지며 산소 분자를 이용해 다양한 유기 화합물, 특히 약물과 지용성 물질을 산화시켜 대사시키는 효소군.","subcategory":"세포·분자생물학","level":3,"related":["superoxide-dismutase"],"prerequisites":[],"aliases":["시토크롬P450"]},{"slug":"tyrosine-kinase","title_ko":"티로신 키나아제","title_en":"Tyrosine kinase","meaning":"단백질의 티로신 잔기에 특이적으로 인산기를 부착시키는 키나아제로, 세포 성장과 분화 신호전달에 핵심적으로 관여.","subcategory":"세포·분자생물학","level":2,"related":[],"prerequisites":[],"aliases":["티로신키나아제"]},{"slug":"phosphodiesterase","title_ko":"포스포디에스터라아제 (PDE)","title_en":"Phosphodiesterase (PDE)","meaning":"고리형 뉴클레오타이드인 cAMP나 cGMP의 인산이에스터 결합을 가수분해하여 비활성 형태로 분해하는 효소.","subcategory":"세포·분자생물학","level":3,"related":["hydrolase"],"prerequisites":[],"aliases":["포스포디에스터라아제","포스포디에스터라아제(PDE)"]},{"slug":"horseradish-peroxidase","title_ko":"양고추냉이 과산화효소(HRP)","title_en":"Horseradish peroxidase (HRP)","meaning":"과산화수소를 이용해 다양한 기질을 산화시키며 색이나 빛을 내는 반응을 촉매하는, 실험에서 표지 효소로 널리 쓰이는 헴 함유…","subcategory":"세포·분자생물학","level":2,"related":["elisa","catalase"],"prerequisites":[],"pop":20},{"slug":"alkaline-phosphatase","title_ko":"알칼리 인산분해효소 (ALP)","title_en":"Alkaline phosphatase (ALP)","meaning":"염기성 조건에서 최적 활성을 보이며 다양한 분자에서 인산기를 가수분해로 떼어내는 효소.","subcategory":"세포·분자생물학","level":2,"related":["horseradish-peroxidase","elisa"],"prerequisites":["horseradish-peroxidase"],"pop":19,"aliases":["알칼리 인산분해효소","알칼리인산분해효소","알칼리인산분해효소(ALP)"]},{"slug":"trypsin","title_ko":"트립신","title_en":"Trypsin","meaning":"염기성 아미노산인 라이신이나 아르기닌 뒤쪽의 펩타이드 결합을 선택적으로 절단하는 세린 단백질분해효소.","subcategory":"세포·분자생물학","level":1,"related":[],"prerequisites":[],"pop":10},{"slug":"reverse-transcriptase","title_ko":"역전사효소","title_en":"Reverse transcriptase","meaning":"RNA를 주형으로 삼아 상보적인 DNA(cDNA) 가닥을 합성하는 효소로, 레트로바이러스와 텔로머라아제 등이 사용.","subcategory":"세포·분자생물학","level":2,"related":[],"prerequisites":[]},{"slug":"lactate-dehydrogenase","title_ko":"젖산탈수소효소 (LDH)","title_en":"Lactate dehydrogenase (LDH)","meaning":"피루브산과 젖산 사이의 상호 전환을 촉매하며 NADH와 NAD+를 산화 또는 환원시키는 산화환원효소.","subcategory":"세포·분자생물학","level":2,"related":["nad"],"prerequisites":["nad"],"pop":13,"aliases":["LDH","젖산탈수소효소","젖산탈수소효소(LDH)"]},{"slug":"nad","title_ko":"NAD+/NADH (니코틴아마이드 아데닌 다이뉴클레오타이드)","title_en":"NAD+/NADH","meaning":"세포 내 산화환원 반응에서 전자와 수소를 운반하는 대표적인 조효소로, 산화형(NAD+)과 환원형(NADH) 사이를 오가며…","subcategory":"세포·분자생물학","level":1,"related":["fad","lactate-dehydrogenase","coenzyme-a"],"prerequisites":[],"pop":11,"aliases":["NAD+ NADH","NAD+ NADH (니코틴아마이드 아데닌 다이뉴클레오타이드)","NAD+/NADH(니코틴아마이드아데닌다이뉴클레오타이드)","NAD+NADH","NAD+NADH (니코틴아마이드 아데닌 다이뉴클레오타이드)","니코틴아마이드 아데닌 다이뉴클레오타이드"]},{"slug":"fad","title_ko":"FAD/FADH2 (플라빈 아데닌 다이뉴클레오타이드)","title_en":"FAD/FADH2","meaning":"산화환원 반응에서 두 개의 전자와 수소를 동시에 운반하는 조효소로, 산화형(FAD)과 환원형(FADH2) 사이를 오가며 작동.","subcategory":"세포·분자생물학","level":2,"related":["nad","coenzyme-a"],"prerequisites":["nad"],"aliases":["FAD FADH2","FAD FADH2 (플라빈 아데닌 다이뉴클레오타이드)","FAD/FADH2(플라빈아데닌다이뉴클레오타이드)","FADFADH2","FADFADH2 (플라빈 아데닌 다이뉴클레오타이드)","플라빈 아데닌 다이뉴클레오타이드"]},{"slug":"coenzyme-a","title_ko":"조효소 A (CoA)","title_en":"Coenzyme A (CoA)","meaning":"아세틸기 같은 아실기를 운반하는 데 사용되는 조효소로, 티올기를 통해 아실기와 고에너지 결합을 형성.","subcategory":"세포·분자생물학","level":1,"related":["nad","fad"],"prerequisites":[],"aliases":["조효소 A","조효소A","조효소A(CoA)"]},{"slug":"allosteric-site","title_ko":"알로스테릭 부위 (다른자리 조절 부위)","title_en":"Allosteric site","meaning":"효소의 활성 부위와는 물리적으로 떨어진 위치에 존재하며, 조절 물질이 결합해 효소의 구조와 활성을 변화시키는 부위.","subcategory":"세포·분자생물학","level":2,"related":["allosteric-regulation","cooperativity","noncompetitive-inhibition"],"prerequisites":["allosteric-regulation","cooperativity"],"aliases":["다른자리 조절 부위","알로스테릭 부위","알로스테릭부위","알로스테릭부위(다른자리조절부위)"]},{"slug":"genetic-bottleneck","title_ko":"유전적 병목현상","title_en":"Genetic bottleneck","meaning":"집단 크기가 급격히 줄어드는 사건으로 인해 유전적 다양성이 크게 감소하는 현상.","subcategory":"유전·진화","level":2,"related":[],"prerequisites":[],"aliases":["유전적병목현상"]},{"slug":"inbreeding-coefficient","title_ko":"근친계수","title_en":"Inbreeding coefficient","meaning":"한 개체가 특정 유전자좌에서 두 대립유전자를 공통 조상으로부터 동일하게 물려받아 동형접합이 될 확률을 나타내는 지표.","subcategory":"유전·진화","level":2,"related":[],"prerequisites":[],"aliases":["근교계수","근친교배계수"]},{"slug":"genome-wide-association-study","title_ko":"전장유전체 연관분석","title_en":"Genome-wide association study (GWAS)","meaning":"수많은 개체의 유전체 전체에 걸친 유전 변이와 특정 형질 또는 질병 사이의 통계적 연관성을 대규모로 탐색하는 연구 방법.","subcategory":"유전·진화","level":3,"related":[],"prerequisites":[],"aliases":["GWAS","전장유전체연관분석"]},{"slug":"mosaicism","title_ko":"모자이시즘","title_en":"Mosaicism","meaning":"한 개체 안에 유전적으로 서로 다른 두 종류 이상의 세포 계통이 함께 존재하는 상태.","subcategory":"유전·진화","level":3,"related":["de-novo-mutation"],"prerequisites":[],"pop":4,"aliases":["모자이크현상"]},{"slug":"genetic-anticipation","title_ko":"유전적 예측현상","title_en":"Genetic anticipation","meaning":"유전 질환이 세대를 거듭할수록 더 이른 나이에 발병하거나 증상이 더 심해지는 현상.","subcategory":"유전·진화","level":3,"related":["de-novo-mutation"],"prerequisites":["de-novo-mutation"],"aliases":["유전적예측현상"]},{"slug":"de-novo-mutation","title_ko":"신생 돌연변이","title_en":"De novo mutation","meaning":"부모의 체세포나 생식세포에는 없던 유전 변이가 생식세포 형성 과정이나 수정 직후에 새롭게 발생하여 자녀에게만 나타나는 변이.","subcategory":"유전·진화","level":3,"related":["mosaicism"],"prerequisites":[],"aliases":["신생돌연변이"]},{"slug":"bisulfite-sequencing","title_ko":"바이설파이트 시퀀싱","title_en":"Bisulfite sequencing","meaning":"아황산수소나트륨 처리로 메틸화되지 않은 시토신만 우라실로 변환시킨 뒤 시퀀싱하여 유전체 전체의 DNA 메틸화 위치를 염기…","subcategory":"세포·분자생물학","level":3,"related":["dna-methylation-profiling"],"prerequisites":[],"aliases":["바이설파이트시퀀싱"]},{"slug":"dna-methylation-profiling","title_ko":"DNA 메틸화 프로파일링","title_en":"DNA methylation profiling","meaning":"유전체 전반에 걸쳐 시토신 염기에 메틸기가 결합된 위치와 정도를 체계적으로 측정하여 개체나 조직의 메틸화 양상을 규명하는…","subcategory":"세포·분자생물학","level":3,"related":["bisulfite-sequencing"],"prerequisites":[],"aliases":["DNA메틸화프로파일링"]},{"slug":"mitochondrial-heteroplasmy","title_ko":"미토콘드리아 이형세포질성","title_en":"Mitochondrial heteroplasmy","meaning":"한 세포 또는 개체 안에 정상과 변이 미토콘드리아 DNA가 서로 다른 비율로 함께 존재하는 상태.","subcategory":"유전·진화","level":3,"related":["mosaicism"],"prerequisites":[],"aliases":["미토콘드리아이형세포질성"]},{"slug":"glycogenolysis","title_ko":"글리코겐 분해","title_en":"Glycogenolysis","meaning":"간이나 근육에 저장된 글리코겐을 분해하여 포도당-1-인산을 방출하는 대사 과정.","subcategory":"세포·분자생물학","level":2,"related":["glycogen-phosphorylase"],"prerequisites":[],"aliases":["글리코겐분해"]},{"slug":"amino-acid-catabolism","title_ko":"아미노산 이화작용","title_en":"Amino Acid Catabolism","meaning":"단백질 분해로 생긴 아미노산의 탄소 골격과 아미노기를 각각 에너지 생산 경로와 질소 배설 경로로 처리하는 대사 과정.","subcategory":"세포·분자생물학","level":2,"related":[],"prerequisites":[],"aliases":["아미노산이화작용"]},{"slug":"nucleotide-salvage-pathway","title_ko":"뉴클레오타이드 회수 경로","title_en":"Nucleotide Salvage Pathway","meaning":"핵산 분해로 생긴 유리 염기나 뉴클레오사이드를 재활용하여 다시 뉴클레오타이드로 전환하는 에너지 절약형 대사 경로.","subcategory":"세포·분자생물학","level":3,"related":[],"prerequisites":[],"aliases":["뉴클레오타이드회수경로"]},{"slug":"mtor-pathway","title_ko":"mTOR 경로","title_en":"mTOR Pathway","meaning":"영양분과 성장인자의 신호를 통합하여 단백질 합성, 세포 성장, 물질대사를 촉진하는 세포 내 신호전달 경로.","subcategory":"세포·분자생물학","level":3,"related":[],"prerequisites":[],"aliases":["mTOR경로"]},{"slug":"warburg-effect","title_ko":"바르부르크 효과","title_en":"Warburg Effect","meaning":"산소가 충분한 조건에서도 암세포가 산화적 인산화보다 해당과정과 젖산 발효에 크게 의존하여 에너지를 얻는 현상.","subcategor