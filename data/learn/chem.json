[{"slug":"catalyst","title_ko":"촉매","title_en":"Catalyst","meaning":"자신은 소모되지 않으면서 화학반응 속도를 빠르게 하는 물질입니다.","subcategory":"화학반응·물질구조","level":1,"related":["polymer","redox-reaction","adsorption"],"prerequisites":[]},{"slug":"isotope","title_ko":"동위원소","title_en":"Isotope","meaning":"양성자 수는 같지만 중성자 수가 달라 질량이 다른 같은 원소입니다.","subcategory":"원소·주기율","level":1,"related":["spectroscopy","chirality","free-radical","le-chatelier-principle","osmotic-pressure"],"prerequisites":[]},{"slug":"spectroscopy","title_ko":"분광법","title_en":"Spectroscopy","meaning":"물질이 빛을 흡수·방출하는 패턴을 분석해 성분을 알아내는 기법입니다.","subcategory":"화학반응·물질구조","level":1,"related":["isotope","chirality","mass-spectrometry","chromatography"],"prerequisites":[],"aliases":["분광학"]},{"slug":"polymer","title_ko":"고분자","title_en":"Polymer","meaning":"작은 단위체가 반복적으로 연결되어 만들어진 거대 분자입니다.","subcategory":"화학반응·물질구조","level":1,"related":["catalyst"],"prerequisites":[],"aliases":["중합체"]},{"slug":"chirality","title_ko":"카이랄성","title_en":"Chirality","meaning":"분자가 거울상과 겹쳐지지 않는 비대칭 구조적 성질입니다.","subcategory":"화학반응·물질구조","level":1,"related":["isotope","spectroscopy"],"prerequisites":[],"aliases":["카이랄리티"]},{"slug":"mass-spectrometry","title_ko":"질량분석법","title_en":"Mass Spectrometry","meaning":"분자를 이온화한 뒤 질량 대 전하비를 정밀하게 측정해 시료의 구성 성분을 알아내는 분석 기법입니다.","subcategory":"화학반응·물질구조","level":2,"related":["spectroscopy","pcr","calibration-curve","x-ray-diffraction"],"prerequisites":[],"pop":6,"aliases":["MS","질량분석"]},{"slug":"ph-acid-base","title_ko":"산염기","title_en":"pH/acid-base","meaning":"용액이 얼마나 산성(수소이온이 많음)이거나 염기성(수소이온이 적음)인지를 0~14 사이의 숫자(pH)로 나타낸 것입니다.","subcategory":"화학반응·물질구조","level":1,"related":["le-chatelier-principle","redox-reaction"],"prerequisites":[],"aliases":["pH","산과 염기"]},{"slug":"le-chatelier-principle","title_ko":"르샤틀리에 원리","title_en":"Le Chatelier's principle","meaning":"평형 상태에 있는 화학 반응계에 온도, 압력, 농도 같은 외부 조건 변화가 가해지면, 그 변화를 상쇄하는 방향으로 평형이…","subcategory":"화학반응·물질구조","level":1,"related":["ph-acid-base","isotope","gibbs-free-energy"],"prerequisites":[],"pop":8,"aliases":["르샤틀리에의 원리","르샤틀리에원리"]},{"slug":"redox-reaction","title_ko":"산화환원반응","title_en":"redox reaction","meaning":"한 물질이 전자를 잃는 산화와 다른 물질이 전자를 얻는 환원이 짝을 이루어 동시에 일어나는 화학반응입니다.","subcategory":"화학반응·물질구조","level":1,"related":["catalyst","ph-acid-base","corrosion","free-radical"],"prerequisites":[],"aliases":["산화-환원 반응"]},{"slug":"x-ray-diffraction","title_ko":"X선 회절","title_en":"X-ray Diffraction","meaning":"결정에 X선을 쬐어 나타나는 회절 무늬를 분석함으로써 물질 내 원자의 규칙적인 배열 구조를 알아내는 분석 기법입니다.","subcategory":"화학반응·물질구조","level":3,"related":["mass-spectrometry","chromatography"],"prerequisites":[],"aliases":["XRD","X선회절"]},{"slug":"buffer-solution","title_ko":"완충용액","title_en":"Buffer Solution","meaning":"산이나 염기가 소량 들어와도 pH가 거의 변하지 않도록 저항하는 용액입니다.","subcategory":"화학반응·물질구조","level":1,"related":["diffusion","osmotic-pressure","chromatography"],"prerequisites":[],"aliases":["완충액"]},{"slug":"osmotic-pressure","title_ko":"삼투압","title_en":"Osmotic Pressure","meaning":"농도가 다른 두 용액이 반투막을 사이에 두고 있을 때, 물이 묽은 쪽에서 진한 쪽으로 이동하는 것을 막기 위해 필요한…","subcategory":"화학반응·물질구조","level":2,"related":["diffusion","buffer-solution","isotope"],"prerequisites":[],"pop":12},{"slug":"chromatography","title_ko":"크로마토그래피","title_en":"Chromatography","meaning":"혼합물 속에 섞여 있는 여러 성분을 이동 속도의 차이를 이용해 하나씩 분리해내는 분석 기법입니다.","subcategory":"화학반응·물질구조","level":1,"related":["spectroscopy","electrophoresis","x-ray-diffraction","adsorption","buffer-solution"],"prerequisites":[]},{"slug":"electrophoresis","title_ko":"전기영동","title_en":"Electrophoresis","meaning":"전기장을 걸어 DNA나 단백질처럼 전하를 띤 분자를 크기·전하에 따라 이동시켜 분리하는 실험 기법입니다.","subcategory":"화학반응·물질구조","level":2,"related":["pcr","chromatography"],"prerequisites":["chromatography"]},{"slug":"adsorption","title_ko":"흡착","title_en":"adsorption","meaning":"기체나 액체 속 분자가 고체(또는 액체) 표면에 달라붙어 얇은 막처럼 쌓이는 현상입니다.","subcategory":"화학반응·물질구조","level":2,"related":["catalyst","surface-tension","chromatography"],"prerequisites":[]},{"slug":"free-radical","title_ko":"자유라디칼","title_en":"Free Radical","meaning":"짝을 이루지 못한 전자를 하나 이상 가지고 있어서 다른 물질과 매우 빠르게 반응하는 불안정한 원자나 분자입니다.","subcategory":"화학반응·물질구조","level":2,"related":["redox-reaction","isotope","enthalpy"],"prerequisites":[],"pop":11,"aliases":["자유기","라디칼"]},{"slug":"molar-concentration","title_ko":"몰농도","title_en":"Molar Concentration","meaning":"용액 1리터 안에 녹아있는 물질이 몇 몰인지를 숫자로 나타낸, 용액의 진하기를 재는 단위입니다(mol/L, 기호 M).","subcategory":"화학반응·물질구조","level":1,"related":["ph-acid-base","buffer-solution","osmotic-pressure","normality","stock-solution"],"prerequisites":[],"aliases":["몰랄농도","Molarity (M)"]},{"slug":"periodic-table","title_ko":"주기율표","title_en":"Periodic Table","meaning":"원소들을 원자번호 순서로 배열해, 성질이 비슷한 원소끼리 같은 세로줄(족)에 놓이도록 정리한 표입니다.","subcategory":"원소·주기율","level":1,"related":[],"prerequisites":[],"aliases":["원소주기율표"]},{"slug":"ions","title_ko":"이온","title_en":"Ions","meaning":"원자나 분자가 전자를 잃거나 얻어서 (+) 또는 (-) 전기를 띠게 된 입자를 말합니다.","subcategory":"화학반응·물질구조","level":1,"related":["ph-acid-base"],"prerequisites":["ph-acid-base"],"aliases":["이온화합물"]},{"slug":"oxidation-number","title_ko":"산화수","title_en":"Oxidation Number","meaning":"화합물 속 원자가 전자를 완전히 주고받았다고 가정했을 때 그 원자가 갖는 것으로 계산되는 가상의 전하 값입니다.","subcategory":"화학반응·물질구조","level":1,"related":["redox-reaction"],"prerequisites":["redox-reaction"],"aliases":["산화상태"]},{"slug":"stoichiometry","title_ko":"화학반응의 양적관계","title_en":"Stoichiometry","meaning":"균형 맞춘 화학 반응식의 계수비를 이용해 반응물과 생성물이 각각 몇 몰씩 반응하고 만들어지는지 계산하는 것입니다.","subcategory":"화학반응·물질구조","level":1,"related":["molar-concentration","oxidation-number"],"prerequisites":[],"aliases":["화학양론","화학반응의양적관계"]},{"slug":"solubility","title_ko":"용해도","title_en":"Solubility","meaning":"일정한 온도에서 일정량의 용매(보통 물 100g)에 최대로 녹을 수 있는 용질의 g수를 말하며, 온도에 따라 그 값이…","subcategory":"화학반응·물질구조","level":1,"related":["molar-concentration","surfactant-excipient"],"prerequisites":[],"aliases":["drug solubility"]},{"slug":"conservation-of-mass","title_ko":"질량보존의 법칙","title_en":"Conservation of Mass","meaning":"화학 반응이 일어나도 반응 전후 물질의 총 질량은 변하지 않는다는 법칙입니다.","subcategory":"화학반응·물질구조","level":1,"related":["stoichiometry"],"prerequisites":["stoichiometry"],"pop":18,"aliases":["질량보존법칙","질량보존의법칙"]},{"slug":"metal-reactivity-series","title_ko":"금속의 반응성","title_en":"Reactivity Series of Metals","meaning":"금속마다 물, 산, 산소 등과 반응하는 정도가 다르다는 것을 관찰해, 그 반응하기 쉬운 순서대로 금속을 줄 세운 것입니다.","subcategory":"화학반응·물질구조","level":1,"related":["redox-reaction","ph-acid-base"],"prerequisites":["redox-reaction"],"aliases":["금속 이온화 경향","이온화 경향","금속의반응성"]},{"slug":"chemical-equilibrium","title_ko":"화학평형","title_en":"Chemical Equilibrium","meaning":"가역반응에서 정반응 속도와 역반응 속도가 같아져, 반응물과 생성물의 농도가 겉보기에 더 이상 변하지 않는 상태입니다.","subcategory":"화학반응·물질구조","level":2,"related":["le-chatelier-principle","gibbs-free-energy","ph-acid-base"],"prerequisites":["le-chatelier-principle","ph-acid-base"]},{"slug":"types-of-chemical-reactions","title_ko":"화학 반응의 종류","title_en":"Types of Chemical Reactions","meaning":"화학 반응은 물질이 결합하거나 분해되거나 서로 자리를 바꾸는 방식에 따라 화합·분해·치환·연소 반응 등으로 나눌 수 있습니다.","subcategory":"화학반응·물질구조","level":1,"related":["redox-reaction"],"prerequisites":["redox-reaction"],"aliases":["화합 분해 치환 연소반응","chemical reaction types","반응의 유형","화학반응의종류"]},{"slug":"group-and-period","title_ko":"족과 주기","title_en":"Group and Period","meaning":"주기율표에서 세로줄을 족, 가로줄을 주기라고 하며, 같은 족의 원소는 화학적 성질이 비슷하고 같은 주기의 원소는 전자껍질…","subcategory":"원소·주기율","level":1,"related":["periodic-table"],"prerequisites":[],"aliases":["족(group)","주기(period)","원소주기율표 세로줄 가로줄","족과주기"]},{"slug":"gas-chromatography","title_ko":"기체크로마토그래피","title_en":"Gas Chromatography","meaning":"시료를 기체 상태로 만들어 관 속을 통과시키면서, 성분마다 이동 속도가 다른 성질을 이용해 혼합물 속 화합물을 분리하고…","subcategory":"화학반응·물질구조","level":2,"related":["mass-spectrometry","spectrophotometer"],"prerequisites":["mass-spectrometry"],"aliases":["가스크로마토그래피","GC"]},{"slug":"nernst-equation","title_ko":"네른스트 식","title_en":"Nernst Equation","meaning":"반응물과 생성물의 농도가 표준 상태(1M, 25°C 등)와 다를 때, 그 조건에서 전지가 실제로 낼 수 있는 전압을 계산하는…","subcategory":"화학반응·물질구조","level":1,"related":["redox-reaction","osmotic-pressure"],"prerequisites":[],"pop":15,"aliases":["네른스트식"]},{"slug":"colloid","title_ko":"콜로이드","title_en":"Colloid","meaning":"한 물질의 아주 작은 입자(1~1000나노미터 정도)가 다른 물질 속에 고르게 퍼져서 가라앉지도 완전히 녹지도 않은 채 떠…","subcategory":"화학반응·물질구조","level":2,"related":["solubility","capillary-action"],"prerequisites":[]},{"slug":"litmus-paper","title_ko":"리트머스 종이","title_en":"Litmus Paper","meaning":"용액이 산성인지 염기성인지를 색깔 변화로 간단히 확인하는 도구입니다.","subcategory":"실험기기·측정장비","level":1,"related":["spectrophotometer","calibration-curve","ph-test-paper-lab"],"prerequisites":["spectrophotometer"],"aliases":["리트머스지"]},{"slug":"henrys-law","title_ko":"헨리 법칙","title_en":"Henry's Law","meaning":"일정한 온도에서 기체가 액체에 녹는 양(용해도)은 그 기체가 액체 표면에 미치는 압력(분압)에 비례한다는 법칙입니다.","subcategory":"화학반응·물질구조","level":2,"related":["vapor-pressure"],"prerequisites":[],"aliases":["헨리법칙"]},{"slug":"boiling-point-elevation","title_ko":"끓는점 오름","title_en":"Boiling Point Elevation","meaning":"순수한 용매에 비휘발성 물질을 녹이면, 녹아 들어간 입자 수에 비례해서 끓는점이 원래보다 높아지는 현상입니다.","subcategory":"화학반응·물질구조","level":2,"related":["vapor-pressure"],"prerequisites":[],"pop":7,"aliases":["끓는점오름"]},{"slug":"vsepr-theory","title_ko":"VSEPR 이론 (원자가 전자쌍 반발 이론)","title_en":"VSEPR Theory","meaning":"중심 원자를 둘러싼 전자쌍들이 서로 최대한 멀리 떨어지려는 반발력 때문에 분자의 입체 구조가 결정된다고 설명하는 이론입니다.","subcategory":"화학반응·물질구조","level":2,"related":["hunds-rule"],"prerequisites":[],"aliases":["VSEPR 이론","VSEPR이론","VSEPR이론(원자가전자쌍반발이론)","원자가 전자쌍 반발 이론"]},{"slug":"hunds-rule","title_ko":"훈트의 규칙","title_en":"Hund's Rule","meaning":"에너지가 같은 여러 오비탈에 전자가 채워질 때, 쌍을 이루기 전에 각 오비탈에 하나씩 홀전자로 먼저 채워진다는 규칙입니다.","subcategory":"원소·주기율","level":2,"related":["vsepr-theory"],"prerequisites":[],"aliases":["훈트의규칙"]},{"slug":"fourier-transform-infrared-spectroscopy","title_ko":"푸리에 변환 적외선분광법","title_en":"Fourier-Transform Infrared Spectroscopy","meaning":"시료에 적외선을 쬐어 어떤 파장이 흡수되는지를 분석함으로써, 그 물질 안에 어떤 화학결합이 들어있는지 알아내는 분광…","subcategory":"실험기기·측정장비","level":3,"related":["spectrophotometer","calibration-curve"],"prerequisites":["spectrophotometer","calibration-curve"],"aliases":["푸리에변환적외선분광법"]},{"slug":"reaction-yield","title_ko":"반응 수율","title_en":"Reaction Yield","meaning":"이론적으로 얻을 수 있는 최대 생성물의 양 대비 실제로 얻은 생성물의 양을 백분율로 나타낸 값입니다.","subcategory":"화학반응·물질구조","level":1,"related":["stoichiometry"],"prerequisites":["stoichiometry"],"aliases":["반응수율"]},{"slug":"reaction-quotient","title_ko":"반응지수","title_en":"reaction quotient","meaning":"반응이 평형에 도달하기 전, 지금 이 순간의 농도(또는 압력)만으로 계산한 생성물과 반응물의 비율입니다.","subcategory":"화학반응·물질구조","level":2,"related":["chemical-equilibrium","solubility-product"],"prerequisites":["chemical-equilibrium","solubility-product"]},{"slug":"solubility-product","title_ko":"용해도곱","title_en":"solubility product","meaning":"잘 녹지 않는 염이 물에 최대로 녹아 평형을 이루었을 때, 그 이온들의 농도를 곱한 값(Ksp)입니다.","subcategory":"화학반응·물질구조","level":2,"related":["reaction-quotient"],"prerequisites":[],"aliases":["용해도적"]},{"slug":"coordinate-covalent-bond","title_ko":"배위결합","title_en":"Coordinate Covalent Bond","meaning":"두 원자가 결합할 때 전자쌍을 한쪽이 나눠 갖는 게 아니라 한쪽 원자가 혼자서 두 개 다 내놓고, 다른 쪽은 빈자리만…","subcategory":"화학반응·물질구조","level":2,"related":[],"prerequisites":[],"aliases":["배위공유결합"]},{"slug":"nmr-spectroscopy","title_ko":"핵자기공명분광법","title_en":"NMR Spectroscopy","meaning":"강한 자기장 속에서 원자핵이 특정 주파수의 전파에 반응하는 성질을 이용해 분자의 구조를 알아내는 분광 분석법입니다.","subcategory":"실험기기·측정장비","level":3,"related":["mass-spectrometry","spectrophotometer","thin-layer-chromatography","chromatography"],"prerequisites":["spectrophotometer"]},{"slug":"thin-layer-chromatography","title_ko":"박막크로마토그래피(박층크로마토그래피)","title_en":"Thin-Layer Chromatography","meaning":"얇은 판 위에 시료를 점찍어 용매를 따라 이동시키면서, 성분마다 다른 이동 거리로 혼합물을 간단히 분리·확인하는…","subcategory":"실험기기·측정장비","level":2,"related":["chromatography","gas-chromatography","nmr-spectroscopy"],"prerequisites":[],"pop":13,"aliases":["박층크로마토그래피"]},{"slug":"half-reaction","title_ko":"반쪽반응","title_en":"Half-Reaction","meaning":"산화환원반응을 전자를 잃는 산화 과정과 전자를 얻는 환원 과정, 두 개의 절반짜리 식으로 나눠서 쓴 것입니다.","subcategory":"화학반응·물질구조","level":1,"related":["redox-reaction","nernst-equation"],"prerequisites":["redox-reaction"],"aliases":["반반응"]},{"slug":"beer-lambert-law","title_ko":"베르-람베르트 법칙","title_en":"Beer-Lambert Law","meaning":"빛이 용액을 통과하며 흡수되는 정도(흡광도)는 그 용액의 농도와 빛이 지나가는 길이에 비례한다는 법칙입니다.","subcategory":"화학반응·물질구조","level":2,"related":["spectrophotometer"],"prerequisites":[],"pop":1,"aliases":["BLL","베르 람베르트 법칙","베르-람베르트법칙","베르람베르트 법칙"]},{"slug":"electron-affinity","title_ko":"전자친화도","title_en":"Electron Affinity","meaning":"기체 상태의 원자가 전자 하나를 받아들여 음이온이 될 때 방출하거나 흡수하는 에너지입니다.","subcategory":"원소·주기율","level":2,"related":["periodic-table"],"prerequisites":["periodic-table"],"pop":17},{"slug":"ionic-strength","title_ko":"이온강도","title_en":"Ionic Strength","meaning":"용액 속에 녹아있는 모든 이온의 농도와 전하를 함께 고려해 계산한, 용액 전체의 이온 세기를 나타내는 값입니다.","subcategory":"화학반응·물질구조","level":3,"related":["buffer-solution","molar-concentration"],"prerequisites":["buffer-solution","molar-concentration"]},{"slug":"micelle","title_ko":"미셀","title_en":"Micelle","meaning":"계면활성제 분자들이 물속에서 물을 싫어하는 꼬리를 안쪽으로, 물을 좋아하는 머리를 바깥쪽으로 향한 채 둥글게 모여 만드는…","subcategory":"화학반응·물질구조","level":3,"related":["surfactant-excipient","colloid","osmotic-pressure"],"prerequisites":["surfactant-excipient","colloid","osmotic-pressure"],"pop":20,"aliases":["마이셀"]},{"slug":"water-bath","title_ko":"항온수조","title_en":"Water Bath","meaning":"물을 원하는 온도로 정확하게 데워 일정하게 유지시켜, 시료나 시험관을 그 온도에 담가 반응시키는 실험 장비입니다.","subcategory":"실험기기·측정장비","level":1,"related":["incubator","autoclave","centrifuge","hot-plate-stirrer-lab","clock-reaction-apparatus"],"prerequisites":[],"aliases":["항온조"]},{"slug":"uv-vis-spectroscopy","title_ko":"자외선-가시광선 분광법","title_en":"UV-Vis Spectroscopy","meaning":"자외선과 가시광선을 시료에 쪼여 얼마나 흡수되는지를 측정해서 물질의 농도나 전자 구조를 알아내는 분석법입니다.","subcategory":"화학반응·물질구조","level":2,"related":["beer-lambert-law","spectroscopy"],"prerequisites":["beer-lambert-law","spectroscopy"],"pop":3,"aliases":["자외선 가시광선 분광법","자외선-가시광선분광법","자외선가시광선 분광법"]},{"slug":"common-ion-effect","title_ko":"공통이온효과","title_en":"Common Ion Effect","meaning":"이미 녹아 있는 이온과 같은 종류의 이온을 더 넣으면, 그 물질이 덜 녹거나 덜 해리되는 현상입니다.","subcategory":"화학반응·물질구조","level":2,"related":["solubility-product","le-chatelier-principle","buffer-solution"],"prerequisites":["solubility-product","le-chatelier-principle","buffer-solution"]},{"slug":"bet-isotherm","title_ko":"BET 흡착등온식","title_en":"BET Isotherm","meaning":"기체 분자가 고체 표면에 여러 겹으로 쌓이며 달라붙는 양을 압력에 따라 수식으로 나타내어, 그 고체의 비표면적을 계산해 내는…","subcategory":"화학반응·물질구조","level":3,"related":["vapor-pressure"],"prerequisites":[],"aliases":["BET흡착등온식"]},{"slug":"electrochemical-impedance-spectroscopy","title_ko":"전기화학 임피던스 분광법","title_en":"Electrochemical Impedance Spectroscopy","meaning":"전극에 여러 주파수의 교류 전압을 흘려보내며 그 반응을 측정해, 전하 이동이나 물질 확산처럼 서로 다른 속도로 일어나는…","subcategory":"화학반응·물질구조","level":3,"related":["redox-reaction"],"prerequisites":["redox-reaction"],"aliases":["전기화학임피던스분광법"]},{"slug":"photocatalysis","title_ko":"광촉매","title_en":"Photocatalysis","meaning":"빛 에너지를 흡수해 화학 반응을 촉진하는 촉매 작용으로, 열이나 다른 화학물질 대신 빛을 반응의 방아쇠로 사용합니다.","subcategory":"화학반응·물질구조","level":3,"related":["catalyst","redox-reaction"],"prerequisites":["catalyst","redox-reaction"],"aliases":["광촉매반응"]},{"slug":"base-dissociation-constant","title_ko":"염기 해리상수","title_en":"Base Dissociation Constant","meaning":"약염기가 물속에서 얼마나 많이 이온화되는지를 나타내는 평형상수로, 염기의 세기를 판단하는 데 쓰입니다.","subcategory":"화학반응·물질구조","level":2,"related":[],"prerequisites":[],"aliases":["염기해리상수"]},{"slug":"ft-ir-spectrometer","title_ko":"푸리에 변환 적외선 분광기","title_en":"Fourier-Transform Infrared (FT-IR) Spectrometer","meaning":"시료에 적외선을 쬐어 특정 화학결합이 흡수하는 파장을 측정함으로써 분자 내 작용기를 확인하는 분광 장비.","subcategory":"화학반응·물질구조","level":3,"related":[],"prerequisites":[],"aliases":["FT-IR","푸리에변환적외선분광기"]},{"slug":"soxhlet-extractor","title_ko":"속슬렛 추출기","title_en":"Soxhlet Extractor","meaning":"고체 시료 속 성분을 용매의 증발과 응축을 반복시켜 지속적으로 씻어내는 방식으로 추출하는 유리 기구.","subcategory":"화학반응·물질구조","level":3,"related":[],"prerequisites":[],"aliases":["속슬렛추출기"]},{"slug":"potentiostat","title_ko":"포텐시오스탯","title_en":"Potentiostat","meaning":"전기화학 셀의 작업전극 전위를 기준전극에 대해 정밀하게 제어하면서 흐르는 전류를 측정하는 전기화학 계측 장비.","subcategory":"화학반응·물질구조","level":3,"related":[],"prerequisites":[],"aliases":["정전위기"]},{"slug":"ball-mill","title_ko":"볼밀(분쇄기)","title_en":"Ball Mill","meaning":"단단한 구슬(볼)과 시료를 밀폐된 용기에 함께 넣고 회전 또는 진동시켜 시료를 물리적으로 곱게 분쇄하거나 기계적으로 반응을…","subcategory":"화학반응·물질구조","level":3,"related":["sonicator"],"prerequisites":[],"aliases":["볼밀","분쇄기"]},{"slug":"sonicator","title_ko":"초음파 분쇄기(소니케이터)","title_en":"Sonicator","meaning":"초음파 진동을 이용해 액체 속에 미세한 기포를 생성·붕괴시키는 캐비테이션 현상을 통해 시료를 분산, 세척, 또는 파쇄하는…","subcategory":"화학반응·물질구조","level":3,"related":["ball-mill","dialysis-membrane"],"prerequisites":["ball-mill","dialysis-membrane"],"pop":2,"aliases":["소니케이터","초음파 분쇄기","초음파분쇄기","초음파분쇄기(소니케이터)"]},{"slug":"dialysis-membrane","title_ko":"투석막(투석)","title_en":"Dialysis Membrane","meaning":"특정 크기 이하의 분자만 통과시키는 반투과성 막을 이용해 용액 속 큰 분자와 작은 분자·이온을 분리·정제하는 방법.","subcategory":"화학반응·물질구조","level":2,"related":[],"prerequisites":[],"aliases":["투석막"]},{"slug":"chemical-vapor-deposition","title_ko":"화학기상증착법","title_en":"Chemical Vapor Deposition (CVD)","meaning":"기체 상태의 전구체 물질을 반응 챔버에 흘려보내 기판 표면에서 화학반응을 일으켜 고체 박막이나 소재를 증착시키는 합성 기법.","subcategory":"화학반응·물질구조","level":3,"related":[],"prerequisites":[],"aliases":["CVD","화학기상증착 공정"]},{"slug":"bet-surface-area-analyzer","title_ko":"BET 비표면적 분석기","title_en":"BET Surface Area Analyzer","meaning":"고체 시료 표면에 기체 분자가 흡착되는 양을 측정해 브루나우어-에밋-텔러(BET) 이론으로 비표면적과 기공 구조를 계산하는…","subcategory":"화학반응·물질구조","level":3,"related":[],"prerequisites":[],"aliases":["BET비표면적분석기"]},{"slug":"zeta-potential-analyzer","title_ko":"제타전위 분석기","title_en":"Zeta Potential Analyzer","meaning":"전기장 속에서 하전된 입자가 이동하는 속도를 측정해 입자 표면의 전기적 특성(제타전위)을 계산함으로써 콜로이드 용액의 분산…","subcategory":"화학반응·물질구조","level":3,"related":[],"prerequisites":[],"aliases":["제타전위분석기"]},{"slug":"miller-indices","title_ko":"밀러 지수","title_en":"Miller Indices","meaning":"결정 내의 특정 격자면이나 방향을 (hkl) 형태의 세 정수로 표기하는 결정학적 표기법이다.","subcategory":"화학반응·물질구조","level":3,"related":["x-ray-diffraction","bragg-law"],"prerequisites":["x-ray-diffraction"],"aliases":["밀러지수"]},{"slug":"gelation","title_ko":"겔화","title_en":"Gelation","meaning":"용액 속의 고분자나 입자들이 서로 연결되어 액체를 가둔 채로 3차원 그물망 구조를 형성하며 유동성을 잃는 과정이다.","subcategory":"화학반응·물질구조","level":3,"related":["viscoelasticity"],"prerequisites":[],"aliases":["젤화"]},{"slug":"jahn-teller-effect","title_ko":"얀-텔러 효과","title_en":"Jahn-Teller Effect","meaning":"비선형 분자에서 축퇴된(에너지가 같은) 전자 상태가 대칭성이 낮아지는 구조 왜곡을 통해 더 안정한 상태로 전이하는 현상이다.","subcategory":"화학반응·물질구조","level":3,"related":["piezoelectric-effect"],"prerequisites":[],"aliases":["얀 텔러 효과","얀-텔러효과","얀텔러 효과"]},{"slug":"solid-state-synthesis","title_ko":"고체상 합성법","title_en":"Solid-State Synthesis","meaning":"고체 상태의 출발 물질(주로 분말)을 고온에서 직접 반응시켜 새로운 화합물을 얻는 무기재료 합성 방법이다.","subcategory":"화학반응·물질구조","level":3,"related":["x-ray-diffraction"],"prerequisites":[],"aliases":["고체상합성법"]},{"slug":"electrophilic-aromatic-substitution","title_ko":"친전자성 방향족 치환반응","title_en":"electrophilic aromatic substitution","meaning":"방향족 고리가 친전자체의 공격을 받아 수소 원자 하나가 치환되는 반응.","subcategory":"화학반응·물질구조","level":2,"related":[],"prerequisites":[],"aliases":["친전자성방향족치환반응"]},{"slug":"radical-chain-mechanism","title_ko":"라디칼 연쇄 메커니즘","title_en":"radical chain mechanism","meaning":"개시, 전파, 종결의 세 단계로 이루어지며 라디칼이 반복적으로 생성되고 소모되며 진행되는 반응 메커니즘.","subcategory":"화학반응·물질구조","level":2,"related":["free-radical"],"prerequisites":[],"pop":19,"aliases":["라디칼연쇄메커니즘"]},{"slug":"fischer-esterification","title_ko":"피셔 에스터화","title_en":"Fischer esterification","meaning":"산 촉매 존재 하에 카르복실산과 알코올이 반응하여 에스터와 물을 생성하는 평형 반응.","subcategory":"화학반응·물질구조","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["피셔에스터화"]},{"slug":"carbocation","title_ko":"카보양이온","title_en":"carbocation","meaning":"탄소 원자가 양전하를 띠고 빈 p 오비탈을 가지는 3배위 반응성 중간체.","subcategory":"화학반응·물질구조","level":2,"related":["carbocation-rearrangement"],"prerequisites":[],"aliases":["카르보양이온","탄소양이온"]},{"slug":"carbocation-rearrangement","title_ko":"카보양이온 재배열","title_en":"carbocation rearrangement","meaning":"덜 안정한 카보양이온이 수소화물 이동이나 알킬기 이동을 통해 더 안정한 카보양이온으로 전환되는 과정.","subcategory":"화학반응·물질구조","level":3,"related":["carbocation"],"prerequisites":[],"aliases":["카보양이온재배열"]},{"slug":"enantiomer","title_ko":"거울상 이성질체","title_en":"enantiomer","meaning":"서로 거울상 관계에 있으며 겹쳐지지 않는 한 쌍의 입체이성질체.","subcategory":"화학반응·물질구조","level":2,"related":["chirality"],"prerequisites":[],"aliases":["거울상이성질체"]},{"slug":"meso-compound","title_ko":"메소 화합물","title_en":"meso compound","meaning":"여러 개의 카이랄 중심을 가지지만 분자 내부의 대칭면 때문에 전체적으로는 광학 비활성인 화합물.","subcategory":"화학반응·물질구조","level":3,"related":["chirality","enantiomer"],"prerequisites":["chirality"],"aliases":["메소화합물"]},{"slug":"steric-hindrance","title_ko":"입체 장애","title_en":"steric hindrance","meaning":"원자단들의 부피가 서로 겹치면서 발생하는 반발력이 반응 속도나 분자 배열에 영향을 미치는 현상.","subcategory":"화학반응·물질구조","level":2,"related":[],"prerequisites":[],"aliases":["입체장애"]},{"slug":"iminium-ion","title_ko":"이미늄 이온","title_en":"iminium ion","meaning":"질소 원자가 이중결합으로 탄소와 연결되어 양전하를 띠는 양이온성 화학종.","subcategory":"화학반응·물질구조","level":3,"related":["carbocation"],"prerequisites":[],"aliases":["이미늄이온"]},{"slug":"markovnikov-rule","title_ko":"마르코브니코프 규칙","title_en":"Markovnikov's rule","meaning":"비대칭 알켄에 극성 시약(HX 등)이 첨가될 때 수소는 이미 수소가 더 많이 붙어 있는 탄소로, 나머지 그룹은 더 안정한…","subcategory":"화학반응·물질구조","level":2,"related":["carbocation","carbocation-rearrangement","radical-chain-mechanism"],"prerequisites":["carbocation","carbocation-rearrangement","radical-chain-mechanism"],"pop":9,"aliases":["마르코브니코프규칙"]},{"slug":"newman-projection","title_ko":"뉴먼 투영도","title_en":"Newman projection","meaning":"탄소-탄소 결합 축을 따라 분자를 바라보며 앞쪽과 뒤쪽 탄소에 붙은 그룹들의 회전 배열을 원과 점으로 나타내는 표기법.","subcategory":"화학반응·물질구조","level":2,"related":[],"prerequisites":[],"aliases":["뉴먼투영도"]},{"slug":"surfactant-excipient","title_ko":"계면활성제","title_en":"Surfactant","meaning":"물과 기름처럼 성질이 다른 두 물질의 경계면 장력을 낮춰 서로 잘 섞이거나 퍼지게 돕는 부형제입니다.","subcategory":"제제학·의약품화학","level":2,"related":["solubility","surface-tension","colloid","adsorption"],"prerequisites":[]},{"slug":"sulfuric-acid-lab","title_ko":"황산","title_en":"Sulfuric Acid","meaning":"두 개의 수소 이온을 내놓을 수 있는 이염기산(H2SO4)으로, 강한 산성과 탈수성·산화성을 동시에 지닌 실험실 필수…","subcategory":"산·염기","level":1,"related":["hydrochloric-acid-lab","nitric-acid-lab","phosphoric-acid-lab"],"prerequisites":[]},{"slug":"hydrochloric-acid-lab","title_ko":"염산","title_en":"Hydrochloric Acid","meaning":"염화수소 기체를 물에 녹인 수용액(HCl)으로, 수용액에서 거의 완전히 이온화되는 대표적인 강산입니다.","subcategory":"산·염기","level":1,"related":["sulfuric-acid-lab","nitric-acid-lab"],"prerequisites":[],"aliases":["염화수소산"]},{"slug":"oxalic-acid","title_ko":"옥살산","title_en":"Oxalic Acid","meaning":"두 개의 카복실기가 서로 직접 연결된 가장 단순한 이염기 유기산(C2H2O4)으로, 산화환원 적정의 1차 표준물질로 널리…","subcategory":"산화·환원","level":2,"related":["potassium-permanganate"],"prerequisites":[],"aliases":["수산"]},{"slug":"nitric-acid-lab","title_ko":"질산","title_en":"Nitric Acid","meaning":"수용액에서 완전히 이온화되는 강산이면서 동시에 강력한 산화제로도 작용하는 물질(HNO3)입니다.","subcategory":"산·염기","level":2,"related":["sulfuric-acid-lab","hydrochloric-acid-lab","copper-ii-nitrate"],"prerequisites":[]},{"slug":"citric-acid","title_ko":"구연산(시트르산)","title_en":"Citric Acid","meaning":"감귤류 과일의 신맛을 내는 세 개의 카복실기를 가진 삼염기산(C6H8O7)으로, 착화합물 형성 능력이 뛰어난 약산입니다.","subcategory":"산·염기","level":1,"related":[],"prerequisites":[],"aliases":["시트르산","구연산"]},{"slug":"phosphoric-acid-lab","title_ko":"인산","title_en":"Phosphoric Acid","meaning":"세 개의 수소 이온을 순차적으로 내놓을 수 있는 삼양성자산(H3PO4)으로, 완충용액 제조와 비료·식품 산업에 널리 쓰이는…","subcategory":"산·염기","level":2,"related":["sulfuric-acid-lab"],"prerequisites":[]},{"slug":"urea-reagent","title_ko":"요소","title_en":"Urea","meaning":"화학식 CH4N2O로 표시되는 질소 화합물로, 단백질 변성 실험과 비료 성분 연구에 널리 쓰이는 시약입니다.","subcategory":"화학반응·물질구조","level":1,"related":[],"prerequisites":[],"aliases":["우레아"]},{"slug":"hydrogen-peroxide-lab","title_ko":"과산화수소","title_en":"Hydrogen Peroxide","meaning":"화학식 H2O2로 표시되는 산화제이자 표백·