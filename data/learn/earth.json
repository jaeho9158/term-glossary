[{"slug":"stellar-parallax","title_ko":"연주시차","title_en":"Stellar Parallax","meaning":"지구가 태양 주위를 공전하면서 6개월 간격으로 같은 별을 서로 다른 위치에서 관측했을 때 별의 방향이 미세하게 달라 보이는…","subcategory":"천문·우주","level":2,"related":[],"prerequisites":[],"pop":17,"aliases":["연주시차법"]},{"slug":"dew-point-humidity","title_ko":"이슬점과 습도","title_en":"Dew Point and Humidity","meaning":"공기 중 수증기가 냉각되어 물방울로 응결되기 시작하는 온도를 이슬점이라 하고, 습도는 공기 중에 수증기가 얼마나 포함되어…","subcategory":"지구시스템·지질","level":3,"related":[],"prerequisites":[],"pop":3,"aliases":["이슬점 습도","이슬점과습도"]},{"slug":"solar-altitude-and-shadow-length","title_ko":"태양의 남중고도와 그림자 길이","title_en":"Solar Altitude and Shadow Length","meaning":"태양이 하루 중 가장 높이 떠오르는 순간의 높이를 남중고도라고 하며, 이 고도가 높을수록 그림자는 짧아지고 낮을수록 그림자는…","subcategory":"천문·우주","level":3,"related":[],"prerequisites":[],"aliases":["SASL","태양의남중고도와그림자길이"]},{"slug":"latitude-longitude","title_ko":"위도와 경도","title_en":"Latitude and Longitude","meaning":"위도는 적도를 기준으로 북쪽 또는 남쪽으로 얼마나 떨어져 있는지, 경도는 본초자오선을 기준으로 동쪽 또는 서쪽으로 얼마나…","subcategory":"지구시스템·지질","level":1,"related":["compass-directions"],"prerequisites":[],"pop":5,"aliases":["위경도","좌표","GPS 좌표","위도와경도"]},{"slug":"compass-directions","title_ko":"방위와 나침반","title_en":"Cardinal Directions and Compass","meaning":"방위는 동서남북을 기준으로 어떤 대상이 놓인 방향을 나타낸 것이고, 나침반은 지구 자기장을 이용해 북쪽을 가리켜 그 방위를…","subcategory":"지구시스템·지질","level":2,"related":["latitude-longitude"],"prerequisites":["latitude-longitude"],"pop":10,"aliases":["8방위","자북","방위각","방위와나침반"]},{"slug":"solar-lunar-eclipse","title_ko":"달의 공전과 일식·월식","title_en":"Solar and Lunar Eclipse","meaning":"일식은 달이 태양과 지구 사이에 들어와 태양을 가리는 현상이고, 월식은 지구가 태양과 달 사이에 들어와 지구의 그림자가 달을…","subcategory":"천문·우주","level":3,"related":["lunar-phase"],"prerequisites":["lunar-phase"],"pop":7,"aliases":["일식","월식","개기일식","solar eclipse","lunar eclipse","달의 공전과 일식 월식","달의 공전과 일식월식","달의공전과일식·월식"]},{"slug":"diurnal-annual-motion-of-stars","title_ko":"별의 일주운동과 연주운동","title_en":"Diurnal and Annual Motion of Stars","meaning":"별의 일주운동은 지구의 자전 때문에 하루 동안 별들이 북극성을 중심으로 하늘을 도는 것처럼 보이는 현상이고, 연주운동은…","subcategory":"천문·우주","level":3,"related":["stellar-parallax"],"prerequisites":["stellar-parallax"],"pop":2,"aliases":["일주운동","연주운동","별의 겉보기운동","DAMS","별의일주운동과연주운동"]},{"slug":"gravimeter","title_ko":"중력계","title_en":"Gravimeter","meaning":"지표면 위치마다 미세하게 다른 중력 가속도 값을 정밀하게 측정하는 지구물리 관측 장비이다.","subcategory":"실험기기·측정장비","level":3,"related":["data-logger","gravitational-acceleration"],"prerequisites":["data-logger"],"pop":19},{"slug":"aquifer-water-table","title_ko":"대수층과 지하수면","title_en":"Aquifer and Water Table","meaning":"지하수면은 땅속 흙이나 암석의 빈틈이 물로 가득 차기 시작하는 경계면이고, 대수층은 그 아래에서 물을 저장하고 통과시킬 수…","subcategory":"지구시스템·지질","level":3,"related":[],"prerequisites":[],"pop":4,"aliases":["AWT","대수층과지하수면"]},{"slug":"continental-shelf","title_ko":"대륙붕","title_en":"Continental Shelf","meaning":"대륙의 가장자리에서 바다 쪽으로 완만하게 이어지다가, 급격히 깊어지기 직전까지의 얕은 해저 지형이다.","subcategory":"지구시스템·지질","level":3,"related":[],"prerequisites":[]},{"slug":"ice-albedo-feedback","title_ko":"얼음-알베도 피드백","title_en":"Ice-Albedo Feedback","meaning":"기온 상승으로 눈과 얼음이 녹아 반사율(알베도)이 낮은 지표면이 드러나면서 더 많은 태양복사를 흡수해 추가적인 온난화를…","subcategory":"지구시스템·지질","level":2,"related":[],"prerequisites":[],"pop":15,"aliases":["얼음 알베도 피드백","얼음-알베도피드백","얼음알베도 피드백"]},{"slug":"climate-tipping-point","title_ko":"기후 티핑포인트","title_en":"Climate Tipping Point","meaning":"기후 시스템의 특정 요소가 작은 변화에도 비선형적이고 되돌리기 어려운 상태 전환을 일으키는 임계 수준을 의미한다.","subcategory":"지구시스템·지질","level":1,"related":[],"prerequisites":[],"pop":11,"aliases":["기후티핑포인트"]},{"slug":"milankovitch-cycles","title_ko":"밀란코비치 주기","title_en":"Milankovitch Cycles","meaning":"지구 공전 궤도의 이심률, 자전축 기울기, 세차운동이 수만~수십만 년 주기로 변화하면서 지구가 받는 태양복사량의…","subcategory":"지구시스템·지질","level":2,"related":["ice-albedo-feedback"],"prerequisites":[],"pop":9,"aliases":["밀란코비치이론"]},{"slug":"nitrogen-fixation","title_ko":"질소고정","title_en":"Nitrogen Fixation","meaning":"대기 중 비활성 질소 기체(N₂)를 특정 미생물이나 산업적 공정을 통해 암모니아 등 생물이 이용 가능한 형태로 전환하는…","subcategory":"지구시스템·지질","level":3,"related":[],"prerequisites":[],"pop":20},{"slug":"mantle-convection","title_ko":"맨틀대류","title_en":"Mantle Convection","meaning":"지구 내부의 열 불균형으로 인해 고체 상태이지만 매우 느리게 유동하는 맨틀 물질이 순환하는 대류 운동으로, 판구조 운동의…","subcategory":"지구시스템·지질","level":1,"related":[],"prerequisites":[],"pop":8,"aliases":["맨틀 대류설"]},{"slug":"isostasy","title_ko":"지각평형설","title_en":"Isostasy","meaning":"지각이 그 아래 놓인 밀도가 높은 맨틀 위에서 부력에 의해 떠 있는 것처럼 평형을 이루며, 지각의 두께나 밀도 변화에 따라…","subcategory":"지구시스템·지질","level":2,"related":["glacial-isostatic-adjustment","mantle-convection"],"prerequisites":["mantle-convection"],"pop":1,"aliases":["아이소스타시","지각균형"]},{"slug":"ekman-transport","title_ko":"에크만 수송","title_en":"Ekman Transport","meaning":"바람이 해수면에 가하는 마찰력과 지구 자전에 의한 코리올리 효과가 결합해, 표층 해수가 바람 방향과 일정 각도로 비스듬히…","subcategory":"지구시스템·지질","level":3,"related":[],"prerequisites":[],"pop":16,"aliases":["에크만수송"]},{"slug":"glacial-isostatic-adjustment","title_ko":"빙하기 지각평형 조정","title_en":"Glacial Isostatic Adjustment (GIA)","meaning":"과거 빙하기 동안 거대한 빙상의 무게로 눌렸던 지각이 빙하가 녹은 이후 오랜 시간에 걸쳐 서서히 융기하며 평형을 되찾아가는…","subcategory":"지구시스템·지질","level":2,"related":["isostasy","mantle-convection"],"prerequisites":["mantle-convection"],"pop":14,"aliases":["빙하기지각평형조정"]},{"slug":"rossby-wave","title_ko":"로스비파","title_en":"Rossby Wave","meaning":"지구 자전에 따른 코리올리 효과의 위도별 차이로 인해 대기와 해양에서 발생하는 대규모 파동으로, 중위도 기상 패턴과 원격상관…","subcategory":"지구시스템·지질","level":1,"related":[],"prerequisites":[],"pop":13},{"slug":"clausius-clapeyron-relation","title_ko":"클라우지우스-클라페이롱 관계식","title_en":"Clausius-Clapeyron Relation","meaning":"온도 상승에 따라 포화수증기압이 지수적으로 증가하는 관계를 나타내는 열역학 방정식으로, 대기가 온도 1°C 상승당 약 7%씩…","subcategory":"지구시스템·지질","level":3,"related":[],"prerequisites":[],"pop":6,"aliases":["클라우지우스 클라페이롱 관계식","클라우지우스-클라페이롱관계식","클라우지우스클라페이롱 관계식"]},{"slug":"red-giant","title_ko":"적색거성","title_en":"Red Giant","meaning":"중심핵의 수소가 고갈된 후 헬륨핵 주변 껍질에서 수소 껍질 연소가 일어나면서 외피가 크게 팽창하고 표면 온도가 낮아져 붉게…","subcategory":"항성·은하천문학","level":3,"related":[],"prerequisites":[]},{"slug":"accretion-disk","title_ko":"강착원반","title_en":"Accretion Disk","meaning":"블랙홀, 중성자별, 백색왜성 등 중력이 강한 천체 주위로 물질이 각운동량을 유지하며 나선형으로 떨어져 들어가면서 형성하는…","subcategory":"항성·은하천문학","level":1,"related":[],"prerequisites":[]},{"slug":"spectroscopic-parallax","title_ko":"분광시차법","title_en":"Spectroscopic Parallax","meaning":"항성의 스펙트럼형과 광도계급을 분석해 절대등급을 추정한 뒤, 관측된 겉보기등급과 비교하여 거리를 산출하는 간접적 거리 측정…","subcategory":"항성·은하천문학","level":2,"related":[],"prerequisites":[]},{"slug":"galactic-halo","title_ko":"은하헤일로","title_en":"Galactic Halo","meaning":"은하원반을 둘러싸며 구상성단, 늙은 별, 그리고 대부분 눈에 보이지 않는 암흑물질로 이루어진 거대하고 구형에 가까운 영역.","subcategory":"항성·은하천문학","level":1,"related":[],"prerequisites":[]},{"slug":"spiral-arm","title_ko":"나선팔","title_en":"Spiral Arm","meaning":"나선은하의 원반에서 별과 성간물질의 밀도가 상대적으로 높게 나타나는 나선 모양의 구조로, 젊고 밝은 별과 별 형성 영역이…","subcategory":"항성·은하천문학","level":2,"related":[],"prerequisites":[]},{"slug":"zero-age-main-sequence","title_ko":"영년주계열","title_en":"Zero-Age Main Sequence","meaning":"원시별이 중심핵에서 안정적인 수소 핵융합을 막 시작한 시점의 위치를 HR도 상에 나타낸 것으로, 주계열 진화의 출발점에…","subcategory":"항성·은하천문학","level":2,"related":[],"prerequisites":[],"aliases":["ZAMS"]},{"slug":"critical-density","title_ko":"임계밀도","title_en":"Critical Density","meaning":"우주가 평탄한 기하학적 구조를 갖기 위해 필요한 물질-에너지 밀도의 특정 값으로, 실제 밀도와 임계밀도의 비(오메가)에 따라…","subcategory":"우주론·천체물리 관측기법","level":2,"related":["flatness-problem"],"prerequisites":["flatness-problem"]},{"slug":"flatness-problem","title_ko":"평탄성문제","title_en":"Flatness Problem","meaning":"표준 빅뱅 모형에서는 초기 우주의 밀도가 임계밀도에서 극도로 정밀하게 미세조정되어야만 오늘날 관측되는 거의 평탄한 우주가…","subcategory":"우주론·천체물리 관측기법","level":1,"related":["critical-density"],"prerequisites":[]},{"slug":"monopole-problem","title_ko":"자기단극자문제","title_en":"Magnetic Monopole Problem","meaning":"대통일이론(GUT)에 따르면 초기 우주의 상전이 과정에서 매우 무거운 자기단극자가 대량으로 생성되어야 하지만, 실제로는 전혀…","subcategory":"우주론·천체물리 관측기법","level":3,"related":["flatness-problem"],"prerequisites":["flatness-problem"],"aliases":["단극자문제"]},{"slug":"stefan-boltzmann-law","title_ko":"스테판-볼츠만법칙","title_en":"Stefan-Boltzmann Law","meaning":"흑체가 단위 표면적당 방출하는 총 복사에너지가 절대온도의 네제곱에 비례한다는 법칙으로, 별의 광도와 반지름, 온도 사이의…","subcategory":"우주론·천체물리 관측기법","level":3,"related":["blackbody-radiation"],"prerequisites":[],"aliases":["스테판 볼츠만법칙","스테판볼츠만법칙"]},{"slug":"solar-nebula-hypothesis","title_ko":"태양성운가설","title_en":"Solar Nebula Hypothesis","meaning":"태양계가 회전하는 거대한 가스·먼지 구름(태양성운)이 자체 중력으로 수축하면서 중심에는 태양이, 주변 원반에는 행성들이…","subcategory":"태양계천문학·관측장비","level":3,"related":["planetary-differentiation"],"prerequisites":["planetary-differentiation"],"aliases":["SNH"]},{"slug":"planetary-differentiation","title_ko":"행성분화","title_en":"Planetary Differentiation","meaning":"형성 초기 행성 내부가 충돌열과 방사성 붕괴열로 녹으면서 밀도 차이에 따라 무거운 물질은 핵으로, 가벼운 물질은 지각으로…","subcategory":"태양계천문학·관측장비","level":1,"related":["meteorite"],"prerequisites":[]},{"slug":"roche-limit","title_ko":"로슈한계","title_en":"Roche Limit","meaning":"위성이 모행성에 너무 가까이 접근하면 모행성의 조석력이 위성 자체의 중력을 넘어서 위성이 부서지게 되는 임계 거리.","subcategory":"태양계천문학·관측장비","level":3,"related":["planetary-differentiation"],"prerequisites":[],"aliases":["로시한계"]},{"slug":"synodic-period","title_ko":"회합주기","title_en":"Synodic Period","meaning":"지구와 같은 관측자 기준 천체에서 볼 때, 다른 천체가 태양이나 지구에 대해 같은 배치(예: 합, 충)로 돌아오는 데 걸리는…","subcategory":"태양계천문학·관측장비","level":3,"related":["sidereal-month"],"prerequisites":["sidereal-month"]},{"slug":"trojan-asteroid","title_ko":"트로이소행성","title_en":"Trojan Asteroid","meaning":"특정 행성과 태양이 이루는 라그랑주점 L4 또는 L5 부근에 모여, 그 행성과 거의 같은 공전주기로 태양을 도는 소행성 무리.","subcategory":"태양계천문학·관측장비","level":1,"related":[],"prerequisites":[]},{"slug":"dwarf-planet","title_ko":"왜소행성","title_en":"Dwarf Planet","meaning":"태양을 공전하고 자체 중력으로 구형을 유지할 만큼 크지만, 궤도 주변의 다른 천체를 중력으로 쓸어내지 못한 천체로…","subcategory":"태양계천문학·관측장비","level":1,"related":["kuiper-belt"],"prerequisites":[]},{"slug":"meteoroid","title_ko":"유성체","title_en":"Meteoroid","meaning":"우주 공간을 떠도는 모래알에서 바위 크기 정도의 작은 고체 잔해로, 소행성이나 혜성에서 떨어져 나온 파편인 경우가 많다.","subcategory":"태양계천문학·관측장비","level":3,"related":["meteorite"],"prerequisites":["meteorite"]},{"slug":"meteorite","title_ko":"운석","title_en":"Meteorite","meaning":"유성체가 대기를 통과하며 완전히 타 없어지지 않고 지표면까지 도달한 고체 잔해.","subcategory":"태양계천문학·관측장비","level":2,"related":["meteoroid","planetary-differentiation"],"prerequisites":["planetary-differentiation"]},{"slug":"kuiper-belt","title_ko":"카이퍼벨트","title_en":"Kuiper Belt","meaning":"해왕성 궤도 바깥, 태양으로부터 약 30~50천문단위 거리에 얼음과 암석으로 이루어진 소천체들이 원반 모양으로 밀집한 영역.","subcategory":"태양계천문학·관측장비","level":1,"related":["oort-cloud"],"prerequisites":[],"aliases":["카이퍼대"]},{"slug":"oort-cloud","title_ko":"오르트구름","title_en":"Oort Cloud","meaning":"태양계 가장 바깥쪽, 대략 수천에서 수만 천문단위 거리에 구형으로 분포한다고 추정되는 얼음 천체들의 거대한 껍질로, 장주기…","subcategory":"태양계천문학·관측장비","level":2,"related":["kuiper-belt"],"prerequisites":["kuiper-belt"]},{"slug":"comet-coma","title_ko":"혜성코마","title_en":"Comet Coma","meaning":"혜성이 태양에 가까워지면서 핵 표면의 얼음이 승화해 방출된 가스와 먼지가 핵 주위를 감싸며 형성하는 흐릿하고 확산된 대기.","subcategory":"태양계천문학·관측장비","level":1,"related":[],"prerequisites":[]},{"slug":"lunar-phase","title_ko":"달의위상","title_en":"Lunar Phase","meaning":"지구에서 볼 때 태양빛을 받은 달의 밝은 면이 지구-달-태양의 상대적 위치에 따라 초승달, 상현달, 보름달 등으로 주기적으로…","subcategory":"태양계천문학·관측장비","level":1,"related":["sidereal-month"],"prerequisites":[],"aliases":["달의 위상 변화","Moon Phases","달의 위상","달의위상변화"]},{"slug":"sidereal-month","title_ko":"항성월","title_en":"Sidereal Month","meaning":"먼 별을 기준으로 달이 지구를 한 바퀴 완전히 공전하는 데 걸리는 시간으로, 평균 약 27.3일이다.","subcategory":"태양계천문학·관측장비","level":1,"related":["lunar-phase"],"prerequisites":[]},{"slug":"saros-cycle","title_ko":"사로스주기","title_en":"Saros Cycle","meaning":"태양, 지구, 달의 상대적 배치가 거의 동일하게 반복되어 유사한 일식·월식이 재현되는 약 18년 11일의 주기.","subcategory":"태양계천문학·관측장비","level":1,"related":[],"prerequisites":[]},{"slug":"gulf-stream","title_ko":"걸프스트림","title_en":"Gulf Stream","meaning":"멕시코만에서 시작해 미국 동해안을 따라 북상한 뒤 북대서양을 가로지르는 강한 서안경계류이다.","subcategory":"물리해양학·화학해양학","level":2,"related":[],"prerequisites":[],"aliases":["만류","멕시코만류"]},{"slug":"neap-tide","title_ko":"소조","title_en":"neap tide","meaning":"달과 태양이 지구를 기준으로 직각을 이루는 상현·하현 무렵 조차가 최소가 되는 조석이다.","subcategory":"물리해양학·화학해양학","level":2,"related":[],"prerequisites":[],"aliases":["조금"]},{"slug":"southern-oscillation-index","title_ko":"남방진동지수","title_en":"Southern Oscillation Index","meaning":"타히티와 호주 다윈 두 지점의 해수면 기압 차이를 표준화해 남방진동, 나아가 엔소의 상태를 나타내는 지수이다.","subcategory":"물리해양학·화학해양학","level":3,"related":[],"prerequisites":[],"aliases":["SOI"]},{"slug":"thermocline-tilt","title_ko":"수온약층경사","title_en":"thermocline tilt","meaning":"무역풍에 의해 적도 태평양의 수온약층 깊이가 서쪽에서 깊고 동쪽에서 얕게 기울어지는 현상이다.","subcategory":"물리해양학·화학해양학","level":2,"related":[],"prerequisites":[]},{"slug":"sensible-heat-flux-ocean","title_ko":"현열플럭스","title_en":"sensible heat flux","meaning":"해수면과 그 위 대기 사이의 온도 차이에 의해 직접적인 열전도와 대류로 전달되는 열 에너지의 양이다.","subcategory":"물리해양학·화학해양학","level":3,"related":[],"prerequisites":[]},{"slug":"marine-biodiversity","title_ko":"해양생물다양성","title_en":"Marine Biodiversity","meaning":"해양생태계 내에 존재하는 종, 유전자, 서식지 수준에서의 생물학적 다양성을 총칭하는 개념이다.","subcategory":"해양생물학·해양생태계","level":1,"related":[],"prerequisites":[]},{"slug":"marine-connectivity","title_ko":"해양연결성","title_en":"Marine Connectivity","meaning":"해류, 유생분산, 성체 이동을 통해 지리적으로 떨어진 해양 서식지나 개체군이 생태적·유전적으로 연결되는 정도를 말한다.","subcategory":"해양생물학·해양생태계","level":1,"related":[],"prerequisites":[]},{"slug":"microbial-loop","title_ko":"해양미생물루프","title_en":"Microbial Loop","meaning":"용존유기물을 박테리아가 흡수하고, 이를 다시 원생동물이 포식함으로써 미생물 경로를 통해 유기물이 상위 먹이그물로 재순환되는…","subcategory":"해양생물학·해양생태계","level":1,"related":[],"prerequisites":[],"aliases":["미생물고리"]},{"slug":"lunge-feeding","title_ko":"돌진섭식","title_en":"Lunge Feeding","meaning":"대왕고래 등 수염고래류가 먹이 밀집구역으로 빠르게 돌진하며 입을 크게 벌려 대량의 물과 먹이를 한꺼번에 삼키는 섭식 방식이다.","subcategory":"해양생물학·해양생태계","level":3,"related":[],"prerequisites":[]},{"slug":"marine-heatwave","title_ko":"해양열파","title_en":"Marine Heatwave","meaning":"특정 해역의 수온이 평년 기준값을 상회하는 상태가 며칠 이상 지속되는 극한 고수온 현상을 말한다.","subcategory":"해양생물학·해양생태계","level":1,"related":["coral-bleaching"],"prerequisites":[]},{"slug":"coriolis-force-apparatus","title_ko":"전향력 실험장치","title_en":"Coriolis Force Apparatus","meaning":"회전하는 좌표계 위에서 움직이는 물체가 겉보기로 휘어져 나가는 전향력(코리올리 효과)을 관찰하는 지구과학 실험기구이다.","subcategory":"실험기기·측정장비","level":3,"related":["rotating-cylinder-apparatus"],"prerequisites":[],"pop":18,"aliases":["전향력실험장치"]},{"slug":"rotating-cylinder-apparatus","title_ko":"회전원통 실험장치","title_en":"Rotating Cylinder Apparatus","meaning":"물을 채운 원통형 용기를 회전시켜 지구 자전이 대기와 해류의 순환에 미치는 효과를 모형으로 재현하는 실험기구이다.","subcategory":"실험기기·측정장비","level":3,"related":["coriolis-force-apparatus"],"prerequisites":[],"aliases":["회전원통실험장치"]},{"slug":"environmental-lapse-rate","title_ko":"환경감률","title_en":"Environmental Lapse Rate","meaning":"특정 시각·장소에서 실제로 관측된 대기의 고도에 따른 온도 변화율을 뜻한다.","subcategory":"대기열역학","level":2,"related":[],"prerequisites":[]},{"slug":"ageostrophic-wind","title_ko":"비지균풍","title_en":"Ageostrophic Wind","meaning":"실제 바람에서 지균풍 성분을 뺀 나머지, 즉 기압경도력과 전향력이 정확히 균형을 이루지 못해 생기는 바람 성분을 뜻한다.","subcategory":"대기역학","level":2,"related":[],"prerequisites":[]},{"slug":"cloud-condensation-nuclei","title_ko":"구름응결핵","title_en":"Cloud Condensation Nuclei","meaning":"대기 중 수증기가 응결해 구름방울을 형성할 때 씨앗 역할을 하는 미세한 에어로졸 입자이다.","subcategory":"구름 및 강수물리학","level":2,"related":[],"prerequisites":[],"aliases":["CCN","응결핵"]},{"slug":"marshall-palmer-distribution","title_ko":"마셜-파머 분포","title_en":"Marshall–Palmer Distribution","meaning":"빗방울의 크기별 개수 농도가 지름이 커질수록 지수함수적으로 감소한다고 가정하는 대표적인 강수 입자 크기분포 모델이다.","subcategory":"구름 및 강수물리학","level":2,"related":[],"prerequisites":[],"aliases":["마셜 파머 분포","마셜-파머분포","마셜파머 분포"]},{"slug":"tropical-depression","title_ko":"열대저압부","title_en":"Tropical Depression","meaning":"열대 해상에서 조직화된 대류와 함께 저기압성 순환이 뚜렷해지기 시작한, 태풍으로 발달하기 전 단계의 열대저기압을 말한다.","subcategory":"열대기상학","level":2,"related":[],"prerequisites":[]},{"slug":"madden-julian-oscillation","title_ko":"매든-줄리안 진동","title_en":"Madden–Julian Oscillation","meaning":"매든-줄리안 진동(MJO)은 열대 지역에서 대류와 강수 활동의 중심이 동쪽으로 서서히 이동하며 대략 30~60일 주기로…","subcategory":"열대기상학","level":2,"related":[],"prerequisites"