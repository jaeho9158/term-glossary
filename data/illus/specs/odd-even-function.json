  {"type": "line", "from": [-1.5, 2.25], "to": [1.5, 2.25], "dash": true, "width": 1, "stroke": "blue", "obstacle": false},
  {"type": "line", "from": [-1.5, -3.375], "to": [1.5, 3.375], "dash": true, "width": 1, "stroke": "rose", "obstacle": false},
