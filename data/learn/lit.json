[{"slug":"greek-chorus","title_ko":"코러스","title_en":"Chorus (Greek Theatre)","meaning":"고대 그리스 연극에서 노래와 춤으로 극에 참여하며 극중 사건에 대한 공동체적 논평, 배경 설명, 정서적 반응을 전달하는…","subcategory":"공연예술·연극학","level":1,"related":["stasimon","structure-of-greek-tragedy","greek-episode"],"prerequisites":[],"aliases":["Greek Theatre","합창단","Chorus (Greek Drama)"]},{"slug":"plot","title_ko":"플롯","title_en":"Plot","meaning":"사건들이 인과관계에 따라 배열된 서사 구조. E. M. 포스터는 단순한 사건 나열인 스토리와 달리 플롯은 '왜'라는 인과성을…","subcategory":"문예이론·서사학·시학","level":1,"related":["story","peripeteia"],"prerequisites":[],"pop":3},{"slug":"story","title_ko":"스토리","title_en":"Story","meaning":"서사학에서 사건들이 발생한 시간적 순서 그대로 재구성한 것으로, 담화(서술된 순서)와 구별되는 개념이다.","subcategory":"문예이론·서사학·시학","level":2,"related":["plot"],"prerequisites":["plot"]},{"slug":"metafiction","title_ko":"메타픽션","title_en":"Metafiction","meaning":"소설이 스스로 허구임을 자의식적으로 드러내며 창작 과정이나 서사 관습 자체를 성찰의 대상으로 삼는 서술 양식.","subcategory":"문예이론·서사학·시학","level":1,"related":[],"prerequisites":[],"pop":8},{"slug":"implied-reader","title_ko":"내포독자","title_en":"Implied Reader","meaning":"볼프강 이저가 제시한 개념으로, 텍스트가 상정하는, 텍스트의 신호와 빈틈에 반응하도록 구성된 이상적 독자상.","subcategory":"문예이론·서사학·시학","level":1,"related":[],"prerequisites":[],"aliases":["함축독자"]},{"slug":"epiphany-literary","title_ko":"에피파니","title_en":"Epiphany","meaning":"제임스 조이스가 문학적으로 정립한 개념으로, 인물이 평범한 순간 갑작스레 사물이나 자신의 본질에 대한 깨달음을 얻는 계시적…","subcategory":"문예이론·서사학·시학","level":2,"related":["anagnorisis"],"prerequisites":[],"aliases":["현현"]},{"slug":"epistolary-novel","title_ko":"서간체소설","title_en":"Epistolary Novel","meaning":"편지, 일기 등의 형식을 빌려 인물의 내면을 직접적으로 드러내는 서사 형식의 소설.","subcategory":"문예이론·서사학·시학","level":3,"related":[],"prerequisites":[],"pop":15,"aliases":["서간소설","편지소설"]},{"slug":"free-indirect-discourse","title_ko":"자유간접화법","title_en":"Free Indirect Discourse","meaning":"인물의 발화나 사고를 인용부호나 전달동사 없이 서술자의 문장 속에 융합하여 제시하는 화법으로, 서술자와 인물의 목소리가…","subcategory":"문예이론·서사학·시학","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["FID"]},{"slug":"autodiegetic-narration","title_ko":"자기서사","title_en":"Autodiegetic Narration","meaning":"동질서사의 하위 유형으로, 서술자가 자신이 서술하는 이야기의 주인공인 경우를 가리키는 서사학적 개념.","subcategory":"문예이론·서사학·시학","level":3,"related":[],"prerequisites":[]},{"slug":"suspense","title_ko":"서스펜스","title_en":"Suspense","meaning":"미래 사건의 결과에 대한 불확실성이 독자의 긴장과 기대를 유발하는 서사적 정서 효과.","subcategory":"문예이론·서사학·시학","level":3,"related":["plot","irony-dramatic"],"prerequisites":["plot","irony-dramatic"]},{"slug":"polyphony","title_ko":"다성성","title_en":"Polyphony","meaning":"미하일 바흐친이 도스토옙스키 소설을 분석하며 제시한 개념으로, 서술자의 단일한 목소리에 종속되지 않고 인물들이 각자 독립적인…","subcategory":"문예이론·서사학·시학","level":1,"related":["carnivalesque-bakhtin"],"prerequisites":[],"pop":10,"aliases":["폴리포니"]},{"slug":"irony-dramatic","title_ko":"극적 아이러니","title_en":"Dramatic Irony","meaning":"독자나 관객은 알고 있지만 극중 인물은 알지 못하는 정보의 격차에서 발생하는 아이러니 유형.","subcategory":"문예이론·서사학·시학","level":1,"related":["suspense","anagnorisis"],"prerequisites":[],"pop":9},{"slug":"connotation","title_ko":"함축 의미","title_en":"Connotation","meaning":"단어가 사전적 지시 의미(외연) 외에 문화적·정서적으로 부가하여 환기하는 이차적 의미.","subcategory":"문예이론·서사학·시학","level":2,"related":["imagery"],"prerequisites":["imagery"]},{"slug":"the-grotesque","title_ko":"그로테스크","title_en":"The Grotesque","meaning":"기괴하고 이질적인 것, 아름다움과 추함, 웃음과 공포가 뒤섞인 불안정한 미적 범주.","subcategory":"문예이론·서사학·시학","level":2,"related":["carnivalesque-bakhtin"],"prerequisites":[],"pop":13},{"slug":"sonnet","title_ko":"소네트","title_en":"Sonnet","meaning":"14행으로 구성되며 엄격한 각운 체계와 운율을 따르는 정형시 형식으로, 이탈리아식(페트라르카식)과 영국식(셰익스피어식)이…","subcategory":"문예이론·서사학·시학","level":1,"related":[],"prerequisites":[],"pop":16,"aliases":["14행시"]},{"slug":"assonance","title_ko":"유음","title_en":"Assonance","meaning":"인접한 단어들에서 모음의 소리가 반복되며 만들어지는 음성적 수사 효과.","subcategory":"문예이론·서사학·시학","level":2,"related":[],"prerequisites":[],"pop":17,"aliases":["모음운","유운"]},{"slug":"signifier-signified","title_ko":"기표와 기의","title_en":"Signifier and Signified","meaning":"페르디낭 드 소쉬르의 구조언어학 개념으로, 기호를 이루는 음성적·문자적 형식(기표)과 그것이 지시하는 개념(기의)의 자의적…","subcategory":"문예이론·서사학·시학","level":2,"related":["structuralism"],"prerequisites":[],"pop":6,"aliases":["기의"]},{"slug":"canon-literary","title_ko":"문학 정전","title_en":"Literary Canon","meaning":"특정 시대와 사회에서 문학적 가치를 인정받아 교육과 비평의 대상으로 지속적으로 재생산되는 작품들의 목록 및 그 형성 과정.","subcategory":"문예이론·서사학·시학","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["문학정전"]},{"slug":"pathos","title_ko":"파토스","title_en":"Pathos","meaning":"아리스토텔레스의 수사학에서 청중의 감정에 호소하여 설득력을 강화하는 수사적 방식으로, 문학 비평에서는 텍스트가 유발하는…","subcategory":"문예이론·서사학·시학","level":2,"related":["ethos","logos","catharsis-drama"],"prerequisites":[],"pop":12},{"slug":"ethos","title_ko":"에토스","title_en":"Ethos","meaning":"아리스토텔레스의 수사학에서 화자의 인격과 신뢰성에 기반하여 청중을 설득하는 방식으로, 텍스트나 서술자가 확보하는 도덕적…","subcategory":"문예이론·서사학·시학","level":2,"related":["pathos","logos"],"prerequisites":[],"pop":2},{"slug":"logos","title_ko":"로고스","title_en":"Logos","meaning":"아리스토텔레스의 수사학에서 논리와 이성적 논증에 기반하여 청중을 설득하는 방식을 가리키는 개념.","subcategory":"문예이론·서사학·시학","level":2,"related":["pathos","ethos"],"prerequisites":[]},{"slug":"focalizer","title_ko":"초점화자","title_en":"Focalizer","meaning":"서사에서 사건이 그의 지각과 인식을 통해 걸러져 제시되는 인물, 즉 초점화의 주체가 되는 인물.","subcategory":"문예이론·서사학·시학","level":3,"related":[],"prerequisites":[],"pop":1},{"slug":"verisimilitude","title_ko":"서사적개연성(핍진성)","title_en":"Verisimilitude","meaning":"허구적 서사가 현실적으로 그럴듯하고 논리적으로 납득 가능하게 느껴지도록 만드는 재현의 원리.","subcategory":"문예이론·서사학·시학","level":2,"related":["deus-ex-machina-drama","mimesis-art"],"prerequisites":[],"aliases":["개연성","핍진성","개연성(핍진성)"]},{"slug":"imagery","title_ko":"이미지","title_en":"Imagery","meaning":"텍스트가 언어를 통해 독자의 감각(시각, 청각, 촉각 등)을 환기하는 구체적 형상이나 그 집합.","subcategory":"문예이론·서사학·시학","level":1,"related":[],"prerequisites":[],"pop":20},{"slug":"figure-of-speech","title_ko":"비유","title_en":"Figure of Speech (Trope)","meaning":"언어를 문자 그대로의 의미가 아닌 방식으로 사용하여 의미를 확장하거나 강조하는 수사적 표현 전반을 가리키는 총칭적 개념.","subcategory":"문예이론·서사학·시학","level":3,"related":[],"prerequisites":[],"pop":11,"aliases":["비유법","수사법"]},{"slug":"mock-epic","title_ko":"의사서사시","title_en":"Mock-epic","meaning":"서사시의 장중한 형식과 관습을 하찮은 소재에 적용하여 그 부조화를 통해 풍자적 효과를 만들어내는 시 장르.","subcategory":"문예사조·장르·비교문학","level":2,"related":["pastiche"],"prerequisites":[],"aliases":["모의서사시","풍자서사시"]},{"slug":"melodrama","title_ko":"멜로드라마","title_en":"Melodrama","meaning":"선악의 대립이 명확하고 과장된 감정 표현과 극적인 사건 전개를 통해 관객의 정서적 반응을 극대화하는 대중 극 양식.","subcategory":"문예사조·장르·비교문학","level":1,"related":["chiaroscuro-lighting"],"prerequisites":[],"aliases":["멜로영화","Melodrama (Film)"]},{"slug":"fantasy-literature","title_ko":"판타지문학","title_en":"Fantasy literature","meaning":"현실 세계의 물리 법칙을 벗어난 마법, 초자연적 존재, 대안적 세계를 명시적으로 구축하여 서사를 전개하는 문학 장르.","subcategory":"문예사조·장르·비교문학","level":2,"related":[],"prerequisites":[]},{"slug":"literary-ambiguity","title_ko":"문학적모호성","title_en":"Literary ambiguity","meaning":"텍스트의 언어가 하나의 확정된 의미로 환원되지 않고 여러 해석 가능성을 동시에 열어두는 상태를 가리키는 비평적 개념으로…","subcategory":"문예사조·장르·비교문학","level":2,"related":[],"prerequisites":[],"aliases":["모호성"]},{"slug":"translation-equivalence","title_ko":"번역등가성","title_en":"Translation equivalence","meaning":"번역문이 원문과 의미, 형식, 효과 면에서 어느 정도 대응하는지를 다루는 번역학의 핵심 개념으로, 완전한 등가는 불가능하다는…","subcategory":"문예사조·장르·비교문학","level":2,"related":[],"prerequisites":[],"aliases":["등가성"]},{"slug":"enjambment","title_ko":"행간걸침","title_en":"Enjambment","meaning":"한 시행에서 시작된 문법적·의미적 단위가 행이 끝나는 지점에서 마무리되지 않고 다음 행으로 이어지는 시적 기법.","subcategory":"문예사조·장르·비교문학","level":3,"related":[],"prerequisites":[],"pop":5,"aliases":["시행걸침","앙장브망"]},{"slug":"aphorism-literary","title_ko":"아포리즘","title_en":"Aphorism","meaning":"삶이나 인간 본성에 대한 통찰을 극도로 압축된 짧은 문장으로 표현하는 문학 형식.","subcategory":"문예사조·장르·비교문학","level":1,"related":["negative-capability"],"prerequisites":[],"aliases":["잠언"]},{"slug":"negative-capability","title_ko":"소극적수용력","title_en":"Negative capability","meaning":"시인 존 키츠가 제안한 개념으로, 확실한 사실과 이성적 해명을 성급하게 추구하지 않고 불확실성, 신비, 의혹 속에 머무를 수…","subcategory":"문예사조·장르·비교문학","level":3,"related":["literary-ambiguity","aphorism-literary"],"prerequisites":["literary-ambiguity","aphorism-literary"],"aliases":["부정적수용력"]},{"slug":"gihaeng-gasa","title_ko":"기행가사","title_en":"Travel Gasa","meaning":"여행 체험과 견문을 4음보 연속체로 기록한 가사 문학의 하위 갈래로, 국내외 여정과 풍물, 감회를 서술한다.","subcategory":"동아시아문학·한국문학사","level":1,"related":["gihaeng-munhak"],"prerequisites":[]},{"slug":"gundam-soseol","title_ko":"군담소설","title_en":"War Chronicle Fiction","meaning":"임진왜란·병자호란 이후 유행한 국문소설 갈래로, 영웅적 인물의 전쟁 활약상을 중심으로 서사가 전개되는 군사·전쟁 소재 소설.","subcategory":"동아시아문학·한국문학사","level":2,"related":[],"prerequisites":[],"aliases":["WCF"]},{"slug":"gamun-soseol","title_ko":"가문소설","title_en":"Lineage/Family Saga Fiction","meaning":"조선 후기에 발달한 장편 국문소설 갈래로, 한 가문 또는 여러 가문에 걸친 인물들의 갈등과 결연, 세대에 걸친 서사를 방대한…","subcategory":"동아시아문학·한국문학사","level":1,"related":[],"prerequisites":[]},{"slug":"seolhwa-munhak","title_ko":"설화문학","title_en":"Folk Narrative Literature","meaning":"신화·전설·민담을 아우르는 구비 서사 갈래로, 초자연적 존재나 사건을 다루며 특정 지역이나 집단의 세계관과 가치관을 반영한다.","subcategory":"동아시아문학·한국문학사","level":1,"related":[],"prerequisites":[],"aliases":["FNL"]},{"slug":"gihaeng-munhak","title_ko":"기행문학","title_en":"Travel Literature","meaning":"여행 체험과 견문을 기록한 문학 전반을 가리키는 상위 개념으로, 국문·한문으로 쓰인 기행가사, 사행록, 유산기(遊山記) 등을…","subcategory":"동아시아문학·한국문학사","level":2,"related":["gihaeng-gasa"],"prerequisites":["gihaeng-gasa"]},{"slug":"sinpageuk","title_ko":"신파극","title_en":"Sinpageuk (Melodrama Theatre)","meaning":"1910~20년대에 유행한 대중적 연극 갈래로, 일본 신파극의 영향을 받아 눈물샘을 자극하는 통속적 멜로드라마 서사를…","subcategory":"동아시아문학·한국문학사","level":3,"related":["kabuki"],"prerequisites":[],"aliases":["Melodrama Theatre","신파","Sinpa"]},{"slug":"jeokgang-soseol","title_ko":"적강소설","title_en":"Banished-Immortal Fiction","meaning":"천상계의 신선이나 선녀가 죄를 지어 인간 세상으로 내려와 시련을 겪은 뒤 다시 천상으로 복귀하는 적강(謫降) 화소를 중심…","subcategory":"동아시아문학·한국문학사","level":3,"related":[],"prerequisites":[],"pop":18},{"slug":"haikai","title_ko":"하이카이","title_en":"Haikai (Comic Linked Verse)","meaning":"렌가에서 파생된 골계적·해학적 성격의 연작시 갈래로, 훗날 첫 구(홋쿠)가 독립하여 하이쿠로 발전하는 모태가 되었다.","subcategory":"동아시아문학·한국문학사","level":3,"related":[],"prerequisites":[],"pop":19,"aliases":["Comic Linked Verse"]},{"slug":"multimodality-literature","title_ko":"다중양식성","title_en":"Multimodality in Literature","meaning":"문자, 이미지, 소리, 타이포그래피 등 서로 다른 기호 양식이 하나의 텍스트 안에서 결합하여 의미를 구성하는 방식을 다루는…","subcategory":"현대문예비평·매체문학","level":1,"related":[],"prerequisites":[],"aliases":["멀티모달리티","복합양식성"]},{"slug":"serial-fiction","title_ko":"연재문학","title_en":"Serial Fiction","meaning":"정기적으로 분할되어 유통되는 서사 형식. 19세기 신문 연재소설에서 현대 웹소설에 이르기까지, 독자의 실시간 반응이 후속…","subcategory":"현대문예비평·매체문학","level":2,"related":["blog-literature"],"prerequisites":[],"aliases":["연재소설"]},{"slug":"blog-literature","title_ko":"블로그문학","title_en":"Blog Literature","meaning":"블로그라는 개인 미디어 플랫폼을 매체로 삼아 생산·유통되는 문학적 글쓰기. 일기체와 문학적 수사가 결합되어 사적 기록과 공적…","subcategory":"현대문예비평·매체문학","level":3,"related":[],"prerequisites":[]},{"slug":"computational-literary-analysis","title_ko":"전산문학분석","title_en":"Computational Literary Analysis","meaning":"통계학·자연어처리 기법을 활용해 문체, 저자 판별, 장르 분류 등 문학적 특징을 정량적으로 분석하는 방법론적 분야…","subcategory":"현대문예비평·매체문학","level":2,"related":[],"prerequisites":[],"aliases":["계산문학분석"]},{"slug":"environmental-humanities","title_ko":"환경인문학","title_en":"Environmental Humanities","meaning":"생태 위기를 인문학적 관점, 특히 문학·철학·역사학의 방법론으로 탐구하는 학제적 분야. 생태비평을 포괄하면서도 인간과 환경의…","subcategory":"현대문예비평·매체문학","level":1,"related":[],"prerequisites":[],"aliases":["생태인문학"]},{"slug":"post-structuralism","title_ko":"후기구조주의","title_en":"Poststructuralism","meaning":"구조주의가 전제한 안정적이고 고정된 구조 개념에 의문을 제기하며, 의미의 불안정성과 권력, 욕망의 작동을 강조하는 20세기…","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["structuralism"],"prerequisites":[]},{"slug":"deus-ex-machina-drama","title_ko":"데우스 엑스 마키나","title_en":"Deus ex Machina","meaning":"데우스 엑스 마키나는 극의 갈등을 극 내적 논리로 해결하지 못하고 신이나 초자연적 힘, 혹은 예기치 못한 외부 요인을…","subcategory":"극작론","level":2,"related":["anagnorisis","peripeteia","plot","verisimilitude"],"prerequisites":[],"pop":14}]