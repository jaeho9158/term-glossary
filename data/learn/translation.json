[{"slug":"chunking-memory","title_ko":"청킹","title_en":"Chunking","meaning":"낱개의 정보들을 의미 있는 더 큰 단위로 묶어서 기억하면 한 번에 다룰 수 있는 정보의 양이 늘어나는 현상입니다.","subcategory":"인지심리","level":1,"related":["working-memory","spacing-effect","cognitive-load","metacognition-child","note-taking-technique"],"prerequisites":[],"pop":1,"aliases":["덩이짓기","Chunking in Interpreting"]},{"slug":"skopos-theory","title_ko":"스코포스이론","title_en":"Skopos theory","meaning":"한스 페르미어(Hans Vermeer)가 제창한 이론으로, 번역 행위의 목적(스코포스)이 번역 전략과 결과물을 결정하는…","subcategory":"번역학이론","level":1,"related":[],"prerequisites":[],"pop":2,"aliases":["목적이론","스코포스"]},{"slug":"preliminary-norms","title_ko":"예비규범","title_en":"preliminary norms","meaning":"투리의 규범 위계에서 어떤 텍스트를 번역 대상으로 선정할 것인지, 그리고 원문을 직접 번역할지 중간 언어를 거쳐 번역할지를…","subcategory":"번역학이론","level":1,"related":[],"prerequisites":[]},{"slug":"intra-system-shift","title_ko":"체계내전환","title_en":"intra-system shift","meaning":"캣포드의 범주전환 하위 유형으로, 원문과 목표어가 형식적으로 대응하는 문법 체계(예: 단수/복수 체계)를 공유함에도 특정…","subcategory":"번역학이론","level":3,"related":[],"prerequisites":[]},{"slug":"whispered-interpreting","title_ko":"위스퍼링통역","title_en":"whispered interpreting","meaning":"쇼타주(chuchotage)라고도 불리며, 통역 장비 없이 통역사가 소수의 청자 옆에서 작은 목소리로 동시통역을 제공하는…","subcategory":"번역학이론","level":3,"related":[],"prerequisites":[],"pop":4,"aliases":["위스퍼링"]},{"slug":"pacte-model","title_ko":"PACTE모델","title_en":"PACTE translation competence model","meaning":"스페인 바르셀로나자치대학교의 PACTE 연구팀이 실증적 연구를 통해 제시한 번역능력 모델로, 이중언어 하위능력·언어외적…","subcategory":"번역학이론","level":3,"related":[],"prerequisites":[],"pop":7,"aliases":["PTCM"]},{"slug":"cohesion-in-translation","title_ko":"응집성(번역)","title_en":"cohesion in translation","meaning":"지시, 대용, 생략, 접속, 어휘적 반복 등 텍스트 표층에서 문장들을 문법적·어휘적으로 연결하는 결속 장치가 번역 과정에서…","subcategory":"번역학이론","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["응집성"]},{"slug":"remote-interpreting","title_ko":"원격통역","title_en":"Remote Interpreting","meaning":"통역사가 회의 현장에 물리적으로 있지 않고 화상 또는 음성 연결을 통해 원격지에서 통역을 제공하는 방식이다.","subcategory":"통역학이론·실무","level":1,"related":[],"prerequisites":[],"aliases":["비대면통역"]},{"slug":"anticipation-strategy","title_ko":"예측전략","title_en":"Anticipation Strategy","meaning":"통역사가 문맥, 화자의 어조, 언어 구조 등을 활용해 아직 발화되지 않은 내용을 미리 추정하여 통역 시차를 줄이는 전략이다.","subcategory":"통역학이론·실무","level":1,"related":[],"prerequisites":[]},{"slug":"dual-task-processing","title_ko":"이중과제처리","title_en":"Dual-Task Processing","meaning":"동시통역처럼 청취와 산출이라는 서로 다른 두 인지 과제를 동시에 수행해야 하는 처리 상황을 지칭하는 용어이다.","subcategory":"통역학이론·실무","level":2,"related":["shadowing-exercise"],"prerequisites":[]},{"slug":"shadowing-exercise","title_ko":"쉐도잉","title_en":"Shadowing Exercise","meaning":"들리는 음성을 최소한의 시차를 두고 같은 언어로 즉시 따라 말하는 훈련으로, 동시통역 입문 단계에서 청취-산출 병행 능력을…","subcategory":"통역학이론·실무","level":2,"related":["dual-task-processing"],"prerequisites":[],"pop":3,"aliases":["섀도잉"]},{"slug":"note-taking-technique","title_ko":"통역노트테이킹기법","title_en":"Note-Taking Technique in Interpreting","meaning":"순차통역 시 발화의 논리 구조와 핵심 내용을 신속히 기록하기 위해 사용하는 기호와 배열 방식을 아우르는 기법이다.","subcategory":"통역학이론·실무","level":1,"related":[],"prerequisites":[],"pop":6,"aliases":["NTTI"]},{"slug":"interpreter-competence","title_ko":"통역사역량","title_en":"Interpreter Competence","meaning":"언어능력, 배경지식, 인지처리능력, 담화분석능력 등 통역을 성공적으로 수행하기 위해 필요한 지식과 기술의 총체를 말한다.","subcategory":"통역학이론·실무","level":1,"related":[],"prerequisites":[],"aliases":["통역능력"]}]