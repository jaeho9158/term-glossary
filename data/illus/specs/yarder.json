 "legend": [
  {
   "sym": "야더(yarder)",
   "kind": "term",
   "desc": "능선 위 평지 랜딩(landing)에 놓인 집재기. 드럼(윈치)으로 줄을 당긴다."
  },
  {
   "sym": "스파(spar)",
   "kind": "term",
   "desc": "줄을 높이 매다는 기둥(나무 또는 강철 타워). 꼭대기의 도르래가 헤드 블록(head block)이다."
  },
  {
   "sym": "본선(mainline)",
   "kind": "term",
   "desc": "한 드럼에서 나와 원목을 끌어당기는 줄(파랑 실선)"
  },
  {
   "sym": "귀환선(haulback)",
   "kind": "term",
   "desc": "다른 드럼에서 나와 헤드 블록과 먼 끝의 꼬리 블록(tail block)을 돌아 원목에 이어지는 가벼운 줄(보라 점선)"
  },
  {
   "sym": "가는 회색 선",
   "kind": "term",
   "desc": "스파를 붙잡아 세우는 지지선(guy wire)"
  },
  {
   "sym": "원목",
   "kind": "term",
   "desc": "초커로 줄에 걸어 끄는 통나무"
  }
 ],
