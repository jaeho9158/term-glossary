[{"slug":"moral-hazard","title_ko":"도덕적 해이","title_en":"Moral Hazard","meaning":"위험이나 결과를 다른 사람(보험자, 계약 상대방 등)이 대신 부담하게 되면서, 그 사람이 원래보다 부주의하거나 위험한 행동을…","subcategory":"미시경제","level":1,"related":["human-capital","adverse-selection","game-theory","transaction-cost","information-asymmetry"],"prerequisites":[],"pop":10,"aliases":["도덕적 해이(보험)","도덕적해이(보험)"]},{"slug":"adverse-selection","title_ko":"역선택","title_en":"Adverse Selection","meaning":"거래 전에 한쪽만 중요한 정보를 알고 있어서, 결과적으로 상대에게 불리한 유형의 거래 상대만 시장에 남게 되는 현상입니다.","subcategory":"미시경제","level":1,"related":["moral-hazard","externality","game-theory","transaction-cost","information-asymmetry","signaling-theory"],"prerequisites":[]},{"slug":"availability-heuristic","title_ko":"가용성 휴리스틱","title_en":"Availability Heuristic","meaning":"어떤 사건의 실제 발생 빈도보다, 그 사건이 머릿속에 얼마나 쉽게 떠오르는지를 기준으로 확률을 판단하는 사고방식입니다.","subcategory":"인지심리","level":1,"related":["anchoring-effect","working-memory","bystander-effect","emotional-intelligence","representativeness-heuristic"],"prerequisites":[],"pop":2,"aliases":["이용가능성 휴리스틱"]},{"slug":"information-asymmetry","title_ko":"정보 비대칭","title_en":"Information Asymmetry","meaning":"거래에 참여하는 당사자들이 서로 다른 양의 정보를 가지고 있어서, 한쪽이 다른 쪽보다 더 많이 아는 상황을 말합니다.","subcategory":"미시경제","level":1,"related":["rent-seeking","bounded-rationality","adverse-selection","moral-hazard","signaling-theory"],"prerequisites":[],"aliases":["Asymmetric Information (Real Estate)"]},{"slug":"signaling-theory","title_ko":"신호 이론","title_en":"Signaling Theory","meaning":"정보를 가진 쪽이 자신의 숨겨진 능력이나 품질을 상대방에게 믿을 만하게 전달하기 위해, 비용이 드는 행동(신호)을 이용하는…","subcategory":"미시경제","level":1,"related":["information-asymmetry","adverse-selection","moral-hazard"],"prerequisites":[],"pop":7,"aliases":["신호이론","시그널링 이론","Signaling Theory in Education"]},{"slug":"modified-internal-rate-of-return","title_ko":"수정내부수익률","title_en":"Modified Internal Rate of Return (MIRR)","meaning":"투자안에서 발생하는 현금유입을 자본비용으로 재투자한다는 현실적 가정을 적용하여 계산한 수익률로, 기존 IRR의 비현실적…","subcategory":"기업재무·자본구조이론","level":3,"related":["net-present-value"],"prerequisites":[],"pop":15,"aliases":["MIRR"]},{"slug":"decision-tree-analysis","title_ko":"의사결정나무분석","title_en":"Decision Tree Analysis","meaning":"투자안 실행 과정에서 발생할 수 있는 여러 의사결정 시점과 불확실한 사건들을 나뭇가지 형태의 도식으로 표현하여, 각 경로의…","subcategory":"기업재무·자본구조이론","level":2,"related":[],"prerequisites":[],"pop":17,"aliases":["의사결정트리"]},{"slug":"free-cash-flow-to-firm","title_ko":"기업잉여현금흐름","title_en":"Free Cash Flow to Firm (FCFF)","meaning":"영업활동에서 창출된 현금흐름에서 세금, 재투자, 순운전자본 증가분을 차감하여 산출한, 채권자와 주주 모두에게 귀속될 수 있는…","subcategory":"기업재무·자본구조이론","level":1,"related":["free-cash-flow-to-equity"],"prerequisites":[],"pop":5,"aliases":["FCFF"]},{"slug":"free-cash-flow-to-equity","title_ko":"주주잉여현금흐름","title_en":"Free Cash Flow to Equity (FCFE)","meaning":"기업잉여현금흐름에서 채권자에게 지급되는 이자비용과 순차입 변동분을 반영하여 산출한, 오직 주주에게 귀속되는 잉여현금흐름으로…","subcategory":"기업재무·자본구조이론","level":1,"related":["free-cash-flow-to-firm"],"prerequisites":[],"pop":19,"aliases":["FCFE"]},{"slug":"adjusted-present-value","title_ko":"조정현재가치법","title_en":"Adjusted Present Value (APV)","meaning":"투자안을 전액 자기자본으로 조달했다고 가정했을 때의 기본 NPV에, 부채조달에 따른 이자비용 세금절감효과 등 재무적…","subcategory":"기업재무·자본구조이론","level":3,"related":["net-present-value","leveraged-buyout"],"prerequisites":["leveraged-buyout"],"pop":4,"aliases":["APV"]},{"slug":"certainty-equivalent-method","title_ko":"확실성등가법","title_en":"Certainty Equivalent Method","meaning":"위험이 내포된 미래 현금흐름을 투자자가 무차별하게 여기는 확실한 현금흐름으로 변환한 뒤 무위험이자율로 할인하여 현재가치를…","subcategory":"기업재무·자본구조이론","level":3,"related":["net-present-value"],"prerequisites":[],"aliases":["확실성등가"]},{"slug":"equivalent-annual-cost","title_ko":"등가연간비용","title_en":"Equivalent Annual Cost (EAC)","meaning":"내용연수가 서로 다른 상호배타적 투자안을 비교할 때, 각 투자안의 현재가치를 매년 동일한 금액의 연금 형태로 환산하여 비교…","subcategory":"기업재무·자본구조이론","level":3,"related":["net-present-value"],"prerequisites":[],"pop":3,"aliases":["EAC"]},{"slug":"fama-french-three-factor-model","title_ko":"파마-프렌치3요인모형","title_en":"Fama-French Three-Factor Model","meaning":"시장위험요인에 더해 기업규모요인(SMB)과 가치요인(HML)을 추가하여 주식의 기대수익률을 설명하는 다요인…","subcategory":"기업재무·자본구조이론","level":3,"related":[],"prerequisites":[],"aliases":["FFTFM","파마 프렌치3요인모형","파마프렌치3요인모형"]},{"slug":"bond-yield-plus-risk-premium-approach","title_ko":"채권수익률가산법","title_en":"Bond-Yield-Plus-Risk-Premium Approach","meaning":"기업이 발행한 장기채권의 만기수익률에 주식이 채권보다 위험하다는 점을 반영한 추가 위험프리미엄을 더하여 자기자본비용을…","subcategory":"기업재무·자본구조이론","level":3,"related":[],"prerequisites":[]},{"slug":"bird-in-hand-theory","title_ko":"손안의새이론","title_en":"Bird-in-Hand Theory","meaning":"투자자는 불확실한 미래의 자본이득보다 현재 확정적으로 지급받는 배당을 더 선호하기 때문에, 배당성향이 높은 기업일수록 주주의…","subcategory":"기업재무·자본구조이론","level":2,"related":[],"prerequisites":[],"pop":14,"aliases":["수중의새이론"]},{"slug":"bonding-cost","title_ko":"확증비용","title_en":"Bonding Cost","meaning":"대리인이 자신이 위임자의 이익에 반하는 행동을 하지 않을 것이라는 신뢰를 스스로 입증하기 위해 자발적으로 지출하는 비용으로…","subcategory":"기업재무·자본구조이론","level":2,"related":["residual-loss"],"prerequisites":[]},{"slug":"residual-loss","title_ko":"잔여손실","title_en":"Residual Loss","meaning":"감시비용과 확증비용을 아무리 지출하더라도 대리인의 의사결정이 위임자의 이익을 완전히 극대화하는 수준과 여전히 차이가 남으로써…","subcategory":"기업재무·자본구조이론","level":2,"related":["bonding-cost"],"prerequisites":[],"pop":18},{"slug":"tobins-q","title_ko":"토빈의q","title_en":"Tobin's Q","meaning":"기업 자산의 시장가치를 그 자산의 대체원가로 나눈 비율로, 이 비율이 1보다 크면 기업이 자산을 새로 취득하는 비용보다…","subcategory":"기업재무·자본구조이론","level":3,"related":["book-value"],"prerequisites":[],"pop":9,"aliases":["q비율","토빈Q"]},{"slug":"leveraged-buyout","title_ko":"차입매수","title_en":"Leveraged Buyout (LBO)","meaning":"인수자가 인수대상 기업의 자산이나 미래현금흐름을 담보로 대규모 부채를 조달하여 상대적으로 적은 자기자본으로 기업을 인수하는…","subcategory":"기업재무·자본구조이론","level":1,"related":[],"prerequisites":[],"pop":8,"aliases":["LBO"]},{"slug":"weak-form-market-efficiency","title_ko":"약형효율적시장","title_en":"Weak-Form Market Efficiency","meaning":"현재 자산 가격에 과거의 모든 가격 및 거래량 정보가 이미 반영되어 있어, 과거 데이터를 이용한 기술적 분석으로는 초과수익을…","subcategory":"투자론·파생상품·금융시장","level":2,"related":[],"prerequisites":[],"aliases":["WFME"]},{"slug":"tobin-separation-theorem","title_ko":"토빈분리정리","title_en":"Tobin Separation Theorem","meaning":"모든 투자자가 위험자산 포트폴리오의 구성은 동일하게(시장포트폴리오) 선택하고, 개인의 위험선호에 따라서는 무위험자산과의…","subcategory":"투자론·파생상품·금융시장","level":3,"related":[],"prerequisites":[],"aliases":["분리정리"]},{"slug":"gamma-option","title_ko":"감마","title_en":"Gamma","meaning":"기초자산 가격 변화에 대한 옵션 델타의 민감도, 즉 델타의 변화율을 나타내는 옵션 그릭스의 하나이다.","subcategory":"투자론·파생상품·금융시장","level":2,"related":[],"prerequisites":[],"pop":11},{"slug":"rho-option","title_ko":"로(옵션 그릭스)","title_en":"Rho","meaning":"무위험이자율의 변화에 대한 옵션가격의 민감도를 나타내는 옵션 그릭스의 하나로, 일반적으로 콜옵션은 양(+), 풋옵션은…","subcategory":"투자론·파생상품·금융시장","level":3,"related":[],"prerequisites":[],"aliases":["로","로(옵션그릭스)","옵션 그릭스"]},{"slug":"implied-volatility","title_ko":"내재변동성","title_en":"Implied Volatility","meaning":"현재 시장에서 관측되는 옵션 가격을 옵션가격결정모형(예: 블랙숄즈모형)에 대입해 역산했을 때 도출되는 변동성 값으로…","subcategory":"투자론·파생상품·금융시장","level":1,"related":[],"prerequisites":[],"aliases":["IV"]},{"slug":"exotic-option","title_ko":"이색옵션","title_en":"Exotic Option","meaning":"표준적인 콜옵션·풋옵션(바닐라옵션)과 달리 경로의존성, 복수 기초자산, 조건부 지급구조 등 비표준적인 특성을 가진 파생상품을…","subcategory":"투자론·파생상품·금융시장","level":1,"related":[],"prerequisites":[],"aliases":["익조틱옵션"]},{"slug":"strangle-strategy","title_ko":"스트랭글전략","title_en":"Strangle Strategy","meaning":"동일한 만기를 가지되 서로 다른 행사가격의 외가격 콜옵션과 외가격 풋옵션을 동시에 매수(또는 매도)하여 스트래들보다 낮은…","subcategory":"투자론·파생상품·금융시장","level":3,"related":["implied-volatility"],"prerequisites":[]},{"slug":"callable-bond","title_ko":"콜옵션부채권","title_en":"Callable Bond","meaning":"발행자가 만기 이전 특정 시점에 미리 정해진 가격으로 채권을 조기상환할 수 있는 권리(콜옵션)를 가진 채권으로, 금리하락 시…","subcategory":"투자론·파생상품·금융시장","level":3,"related":[],"prerequisites":[],"pop":20,"aliases":["수의상환채권"]},{"slug":"bid-ask-spread","title_ko":"매수매도호가스프레드","title_en":"Bid-Ask Spread","meaning":"시장에서 매수자가 지불하고자 하는 최고가격(매수호가)과 매도자가 받고자 하는 최저가격(매도호가) 사이의 차이로, 즉시 거래를…","subcategory":"투자론·파생상품·금융시장","level":1,"related":[],"prerequisites":[],"pop":12,"aliases":["매매호가스프레드","호가스프레드"]},{"slug":"local-bias","title_ko":"지역편향","title_en":"Local Bias","meaning":"투자자가 지리적으로 가까운 곳에 위치한 기업의 주식을 원거리 기업보다 상대적으로 더 많이 보유하는 경향으로, 자국편향의 국내…","subcategory":"행동재무학·핀테크","level":3,"related":[],"prerequisites":[]},{"slug":"law-of-small-numbers","title_ko":"소수의법칙","title_en":"Law of Small Numbers","meaning":"적은 수의 표본에서 관찰된 패턴을 마치 모집단 전체의 통계적 특성을 대표하는 것처럼 과대해석하는 인지적 편향으로, 투자자가…","subcategory":"행동재무학·핀테크","level":1,"related":[],"prerequisites":[],"pop":6,"aliases":["LSN"]},{"slug":"dumb-money-effect","title_ko":"덤머니효과","title_en":"Dumb Money Effect","meaning":"개인투자자를 포함한 정보 열위의 자금 흐름이 실적이 좋았던 자산으로 뒤늦게 몰리면서 오히려 이후 낮은 수익률을 예측하는…","subcategory":"행동재무학·핀테크","level":3,"related":[],"prerequisites":[]},{"slug":"extrapolative-expectations","title_ko":"외삽적기대","title_en":"Extrapolative Expectations","meaning":"투자자가 미래 수익률에 대한 기대를 형성할 때 최근 실현된 과거 수익률을 단순히 미래로 연장하는 방식으로 예측치를 조정한다는…","subcategory":"행동재무학·핀테크","level":2,"related":[],"prerequisites":[],"pop":16},{"slug":"quantitative-trading","title_ko":"퀀트트레이딩","title_en":"Quantitative Trading","meaning":"방대한 시장 데이터를 통계적, 수학적 모형으로 분석하여 가격 이례현상이나 패턴을 찾아내고, 이를 근거로 체계적인 매매 신호를…","subcategory":"행동재무학·핀테크","level":3,"related":[],"prerequisites":[],"aliases":["퀀트투자"]},{"slug":"open-banking","title_ko":"오픈뱅킹","title_en":"Open Banking","meaning":"고객의 동의를 전제로 표준화된 응용프로그램인터페이스를 통해 은행이 보유한 고객의 금융거래 데이터를 제3의 핀테크 사업자와…","subcategory":"행동재무학·핀테크","level":2,"related":[],"prerequisites":[],"pop":1},{"slug":"distributed-ledger-technology","title_ko":"분산원장기술","title_en":"Distributed Ledger Technology (DLT)","meaning":"거래 기록을 단일 중앙기관이 아니라 네트워크에 참여하는 다수의 노드가 각자 동일한 사본을 보유하고 합의 절차를 통해 함께…","subcategory":"행동재무학·핀테크","level":1,"related":[],"prerequisites":[],"pop":13,"aliases":["DLT"]}]