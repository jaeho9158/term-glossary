[{"slug":"neuroplasticity","title_ko":"신경가소성","title_en":"Neuroplasticity","meaning":"뇌가 경험에 따라 신경 연결을 재조직하는 능력입니다.","subcategory":"신경세포·전달물질","level":1,"related":["synapse","neurotransmitter","fmri","cognitive-load"],"prerequisites":[],"pop":20,"aliases":["뇌가소성"]},{"slug":"synapse","title_ko":"시냅스","title_en":"Synapse","meaning":"신경세포 사이에서 신호를 전달하는 접합 부위입니다.","subcategory":"신경세포·전달물질","level":1,"related":["neurotransmitter","neuroplasticity","amygdala","eeg","action-potential"],"prerequisites":[],"aliases":["신경연접"]},{"slug":"fmri","title_ko":"기능적자기공명영상","title_en":"fMRI","meaning":"뇌 혈류 변화를 측정해 활성화된 부위를 영상으로 보여주는 기법입니다.","subcategory":"신경영상·측정기법","level":1,"related":["eeg","amygdala","neuroplasticity","prefrontal-cortex"],"prerequisites":[],"aliases":["기능적 자기공명영상","Functional Magnetic Resonance Imaging"]},{"slug":"eeg","title_ko":"뇌파검사","title_en":"EEG","meaning":"두피에서 뇌의 전기적 활동을 기록하는 측정 방법입니다.","subcategory":"신경영상·측정기법","level":1,"related":["fmri","synapse","cognitive-load","metacognition-child","action-potential"],"prerequisites":[],"aliases":["뇌전도"]},{"slug":"neurotransmitter","title_ko":"신경전달물질","title_en":"Neurotransmitter","meaning":"시냅스에서 신경세포 간 신호를 전달하는 화학물질입니다.","subcategory":"신경세포·전달물질","level":1,"related":["synapse","neuroplasticity","amygdala","action-potential","blood-brain-barrier"],"prerequisites":[]},{"slug":"cognitive-load","title_ko":"인지부하","title_en":"Cognitive Load","meaning":"특정 과제를 수행할 때 작업기억에 걸리는 정신적 부담의 양입니다.","subcategory":"인지신경과학","level":3,"related":["eeg","neuroplasticity","metacognition-child","cognitive-bias","prefrontal-cortex"],"prerequisites":[]},{"slug":"amygdala","title_ko":"편도체","title_en":"Amygdala","meaning":"공포와 감정 처리에 핵심적인 역할을 하는 뇌 구조입니다.","subcategory":"뇌구조·기능","level":1,"related":["fmri","synapse","neurotransmitter","neural-circuit"],"prerequisites":[],"aliases":["아미그달라"]},{"slug":"neural-network","title_ko":"인공신경망","title_en":"Neural Network","meaning":"뇌 신경세포 연결 구조를 본떠 만든 다층 예측 모델 구조입니다.","subcategory":"인공지능·머신러닝","level":1,"related":["attention-mechanism","gradient-descent"],"prerequisites":[],"aliases":["신경망"]},{"slug":"action-potential","title_ko":"활동전위","title_en":"Action Potential","meaning":"뉴런이 충분한 자극을 받았을 때 순간적으로 발생해 축삭을 따라 전달되는 전기 신호입니다.","subcategory":"신경세포·전달물질","level":1,"related":["synapse","neurotransmitter","eeg","homeostasis","myelination"],"prerequisites":[]},{"slug":"hippocampus","title_ko":"해마","title_en":"Hippocampus","meaning":"대뇌 측두엽 안쪽에 자리해 새로운 기억을 만들고 공간을 인식하는 데 핵심적인 역할을 하는 뇌 구조입니다.","subcategory":"뇌구조·기능","level":1,"related":["prefrontal-cortex","blood-brain-barrier","long-term-potentiation"],"prerequisites":[],"aliases":["히포캄푸스"]},{"slug":"prefrontal-cortex","title_ko":"전전두피질","title_en":"Prefrontal Cortex","meaning":"이마 바로 안쪽에 위치한 대뇌피질 영역으로, 계획을 세우고 충동을 억제하며 의사결정을 내리는 고차 인지 기능을 담당합니다.","subcategory":"뇌구조·기능","level":1,"related":["fmri","cognitive-load","hippocampus","myelination","default-mode-network"],"prerequisites":[],"aliases":["PFC"]},{"slug":"blood-brain-barrier","title_ko":"혈액뇌장벽","title_en":"Blood-brain Barrier","meaning":"혈액 속 물질이 뇌로 아무렇게나 침투하지 못하게 막아주는, 뇌혈관에 존재하는 매우 촘촘한 방어막입니다.","subcategory":"뇌구조·기능","level":2,"related":["neurotransmitter","hippocampus","glial-cell"],"prerequisites":[],"aliases":["BBB"]},{"slug":"myelination","title_ko":"수초화","title_en":"myelination","meaning":"신경세포의 축삭을 지방질 막인 수초(미엘린)로 감싸 신경 신호가 훨씬 빠르고 효율적으로 전달되도록 만드는 과정입니다.","subcategory":"신경세포·전달물질","level":1,"related":["action-potential","neural-circuit","prefrontal-cortex","glial-cell","corpus-callosum"],"prerequisites":[],"pop":5,"aliases":["말이집형성"]},{"slug":"neural-circuit","title_ko":"신경회로","title_en":"neural circuit","meaning":"특정 기능을 수행하기 위해 서로 연결되어 함께 작동하는 신경세포들의 네트워크입니다.","subcategory":"뇌구조·기능","level":1,"related":["amygdala","myelination","default-mode-network","glial-cell"],"prerequisites":[]},{"slug":"default-mode-network","title_ko":"디폴트모드네트워크","title_en":"default mode network","meaning":"특정 과제를 하지 않고 가만히 쉬거나 멍하니 있을 때 오히려 더 활발해지는, 서로 연결된 뇌 영역들의 네트워크입니다.","subcategory":"뇌구조·기능","level":2,"related":["prefrontal-cortex","neural-circuit","thalamus"],"prerequisites":[],"pop":4,"aliases":["DMN"]},{"slug":"long-term-potentiation","title_ko":"장기강화","title_en":"long-term potentiation","meaning":"두 신경세포가 반복적으로 함께 활성화되면 그 사이의 연결(시냅스)이 오랫동안 더 강해지는 현상입니다.","subcategory":"신경세포·전달물질","level":2,"related":["hippocampus","synaptic-pruning","axon"],"prerequisites":[],"aliases":["LTP"]},{"slug":"glial-cell","title_ko":"신경교세포","title_en":"glial cell","meaning":"활동전위로 신호를 직접 전달하지는 않지만 신경세포(뉴런)를 지지·보호하고 영양 공급, 수초 형성, 면역 방어 등으로…","subcategory":"신경세포·전달물질","level":1,"related":["myelination","neural-circuit","blood-brain-barrier"],"prerequisites":[],"aliases":["아교세포"]},{"slug":"synaptic-pruning","title_ko":"시냅스 가지치기","title_en":"synaptic pruning","meaning":"발달 과정에서 자주 쓰이지 않는 시냅스 연결을 제거해 신경회로를 효율적으로 다듬는 과정입니다.","subcategory":"신경세포·전달물질","level":2,"related":["long-term-potentiation","axon"],"prerequisites":[],"aliases":["시냅스가지치기"]},{"slug":"corpus-callosum","title_ko":"뇌량","title_en":"corpus callosum","meaning":"좌우 대뇌반구를 서로 연결해 정보를 주고받게 해주는 두꺼운 신경섬유 다발입니다.","subcategory":"뇌구조·기능","level":1,"related":["myelination","white-matter"],"prerequisites":["white-matter"],"aliases":["뇌들보"]},{"slug":"cerebellum","title_ko":"소뇌","title_en":"Cerebellum","meaning":"몸의 균형과 자세를 유지하고, 움직임을 정교하게 조율하는 뇌 뒷부분의 구조입니다.","subcategory":"뇌구조·기능","level":1,"related":["axon"],"prerequisites":[]},{"slug":"thalamus","title_ko":"시상","title_en":"Thalamus","meaning":"후각을 제외한 거의 모든 감각 정보가 대뇌피질로 전달되기 전에 반드시 거쳐가는, 뇌 중심부의 중계 구조물입니다.","subcategory":"뇌구조·기능","level":1,"related":["default-mode-network"],"prerequisites":[]},{"slug":"white-matter","title_ko":"백질","title_en":"white matter","meaning":"뉴런의 축삭들이 지방질(미엘린)로 감싸여 하얗게 보이는, 뇌와 척수의 신호 전달 통로 조직입니다.","subcategory":"뇌구조·기능","level":1,"related":["corpus-callosum","axon"],"prerequisites":[]},{"slug":"axon","title_ko":"축삭","title_en":"axon","meaning":"신경세포(뉴런)의 몸통에서 길게 뻗어 나와 전기 신호를 다른 세포로 전달하는 가늘고 긴 돌기입니다.","subcategory":"신경세포·전달물질","level":1,"related":["white-matter","long-term-potentiation","synaptic-pruning","cerebellum"],"prerequisites":[],"aliases":["신경축삭"]},{"slug":"hypothalamus","title_ko":"시상하부","title_en":"Hypothalamus","meaning":"체온, 배고픔, 갈증 같은 몸의 항상성을 조절하고 뇌하수체를 통해 호르몬 분비를 지휘하는 뇌 구조입니다.","subcategory":"뇌구조·기능","level":1,"related":["thalamus","homeostasis","circadian-rhythm"],"prerequisites":[]},{"slug":"broca-wernicke-area","title_ko":"브로카 영역과 베르니케 영역","title_en":"Broca's and Wernicke's area","meaning":"대뇌 좌반구에서 각각 말을 만들어내는 것(브로카 영역)과 말을 이해하는 것(베르니케 영역)을 주로 담당하는, 언어 처리에…","subcategory":"뇌구조·기능","level":1,"related":["prefrontal-cortex","fmri","neural-circuit"],"prerequisites":[],"aliases":["브로카영역","베르니케영역","브로카 실어증","브로카영역과베르니케영역"]},{"slug":"pet-imaging","title_ko":"양전자방출단층촬영","title_en":"PET","meaning":"몸에 주입한 방사성 추적자가 내는 신호를 감지해 특정 부위의 대사 활동이나 특정 분자의 분포를 영상으로 보여주는 뇌·신체…","subcategory":"신경영상·측정기법","level":1,"related":["fmri"],"prerequisites":["fmri"],"aliases":["양전자방출단층촬영술","펫 스캔","positron emission tomography"]},{"slug":"saltatory-conduction","title_ko":"도약전도","title_en":"saltatory conduction","meaning":"수초로 감싸인 축삭에서 전기 신호가 수초가 없는 마디(랑비에 결절)만 골라 건너뛰듯 이동해 신경 전달 속도를 크게 높이는…","subcategory":"신경세포·전달물질","level":1,"related":["myelination","action-potential","axon","glial-cell"],"prerequisites":[],"aliases":["도약 전도","랑비에 결절"]},{"slug":"stroop-effect","title_ko":"스트룹 효과","title_en":"Stroop Effect","meaning":"단어의 의미와 그 단어가 쓰인 글자색이 서로 일치하지 않을 때, 색을 말하는 반응이 느려지고 오류가 늘어나는 현상입니다.","subcategory":"인지심리","level":3,"related":["cognitive-load","working-memory","priming-effect"],"prerequisites":["working-memory","priming-effect"],"aliases":["스트룹효과","색상단어 검사"]},{"slug":"limbic-system","title_ko":"변연계","title_en":"Limbic System","meaning":"감정, 기억, 동기부여를 처리하는 데 함께 작동하는 여러 뇌 구조물을 묶어 부르는 이름입니다.","subcategory":"뇌구조·기능","level":1,"related":["amygdala","hippocampus","hypothalamus"],"prerequisites":[],"aliases":["대뇌변연계"]},{"slug":"excitatory-inhibitory-balance","title_ko":"흥분성-억제성 신경 균형","title_en":"Excitatory-Inhibitory Balance","meaning":"신경회로 안에서 흥분성 신호와 억제성 신호가 적절한 비율로 균형을 이루어 정상적인 뇌 활동을 유지하는 상태를 말합니다 (흔히…","subcategory":"신경세포·전달물질","level":2,"related":["neural-circuit","synapse","neuroplasticity"],"prerequisites":[],"aliases":["E/I 균형","EIB","흥분성 억제성 신경 균형","흥분성-억제성신경균형","흥분성억제성 신경 균형"]},{"slug":"epsp-ipsp","title_ko":"흥분성/억제성 시냅스후전위","title_en":"EPSP/IPSP","meaning":"시냅스에서 신호를 받은 뉴런의 막전위가 발화 쪽으로 살짝 오르면 EPSP(흥분성), 반대로 발화가 억제되는 쪽으로 내려가면…","subcategory":"신경세포·전달물질","level":1,"related":["action-potential","synapse","excitatory-inhibitory-balance"],"prerequisites":[],"aliases":["흥분성 시냅스후전위","억제성 시냅스후전위","excitatory postsynaptic potential","inhibitory postsynaptic potential","흥분성 억제성 시냅스후전위","흥분성/억제성시냅스후전위","흥분성억제성 시냅스후전위"]},{"slug":"critical-period","title_ko":"임계기(결정적 시기)","title_en":"Critical Period","meaning":"뇌가 특정 경험이나 자극에 유독 민감하게 반응하여 신경회로를 활발히 재편하는, 발달 과정 중 한정된 시기를 말합니다.","subcategory":"인지신경과학","level":2,"related":["neuroplasticity","synaptic-pruning","myelination"],"prerequisites":[],"aliases":["결정적 시기","민감기","sensitive period","결정적시기","결정기"]},{"slug":"mirror-neuron","title_ko":"거울뉴런","title_en":"Mirror Neuron","meaning":"자신이 어떤 행동을 직접 할 때와 다른 사람이 같은 행동을 하는 것을 관찰할 때 똑같이 활성화되는 신경세포입니다.","subcategory":"인지신경과학","level":3,"related":["prefrontal-cortex","theory-of-mind-child","fmri","neural-circuit"],"prerequisites":[],"pop":7,"aliases":["거울뉴런시스템","mirror neuron system","MNS"]},{"slug":"central-pattern-generator","title_ko":"중추패턴발생기","title_en":"Central Pattern Generator","meaning":"뇌의 매 순간 명령 없이도 걷기, 호흡, 씹기처럼 일정한 리듬을 가진 운동을 스스로 만들어내는 척수·뇌간의 신경회로입니다.","subcategory":"뇌구조·기능","level":3,"related":["neural-circuit","action-potential","cerebellum","reflex-arc"],"prerequisites":["neural-circuit","cerebellum"],"aliases":["CPG","리듬생성회로"]},{"slug":"astrocyte","title_ko":"성상세포","title_en":"Astrocyte","meaning":"뉴런을 지지하고 영양을 공급하며 시냅스 활동과 혈류까지 조절하는 별 모양의 신경교세포입니다.","subcategory":"신경세포·전달물질","level":1,"related":["glial-cell","blood-brain-barrier","synapse"],"prerequisites":[],"aliases":["성상교세포","별아교세포"]},{"slug":"patch-clamp","title_ko":"패치클램프","title_en":"Patch Clamp","meaning":"아주 가는 유리 전극을 세포막에 밀착시켜 이온 채널 하나하나의 전류까지 직접 측정하는 전기생리학 기법입니다.","subcategory":"신경영상·측정기법","level":3,"related":["action-potential","epsp-ipsp"],"prerequisites":[],"aliases":["패치 클램프","패치클램프법"]},{"slug":"hpa-axis","title_ko":"시상하부-뇌하수체-부신 축","title_en":"HPA Axis","meaning":"스트레스를 감지해 코르티솔 같은 스트레스 호르몬 분비로 이어지는, 시상하부-뇌하수체-부신 사이의 신경내분비 신호 경로입니다.","subcategory":"뇌구조·기능","level":2,"related":["hypothalamus","amygdala","limbic-system"],"prerequisites":[],"pop":9,"aliases":["시상하부-뇌하수체-부신축","HPA축","시상하부 뇌하수체 부신 축","시상하부뇌하수체부신 축"]},{"slug":"epileptic-seizure","title_ko":"뇌전증 발작","title_en":"Epileptic Seizure","meaning":"대뇌의 많은 뉴런이 비정상적으로 과도하고 동시에 흥분하면서 발생하는 일시적인 전기적 발작 현상입니다.","subcategory":"신경질환","level":1,"related":["excitatory-inhibitory-balance","eeg","action-potential"],"prerequisites":[],"aliases":["뇌전증발작","간질 발작"]},{"slug":"rem-sleep","title_ko":"렘수면","title_en":"REM sleep","meaning":"빠른 안구 운동과 깨어있을 때에 가까운 활발한 뇌 활동이 함께 나타나는 수면 단계로, 대부분의 생생한 꿈이 이 시기에…","subcategory":"인지신경과학","level":1,"related":["circadian-rhythm","hippocampus","glymphatic-system","eeg"],"prerequisites":[],"aliases":["REM 수면","급속안구운동수면"]},{"slug":"glymphatic-system","title_ko":"글림프계","title_en":"glymphatic system","meaning":"뇌척수액이 뇌 조직 사이를 흐르며 대사 노폐물을 씻어내는 뇌 고유의 노폐물 제거 시스템으로, 주로 수면 중에 활발하게…","subcategory":"뇌구조·기능","level":3,"related":["astrocyte","rem-sleep","circadian-rhythm"],"prerequisites":[],"aliases":["글림프 시스템","뇌 노폐물 제거 시스템"]},{"slug":"substantia-nigra","title_ko":"흑질","title_en":"substantia nigra","meaning":"중뇌에 위치한 도파민 신경세포 밀집 부위로, 부드러운 움직임 조절에 핵심적이며 이 부위의 세포 손실은 파킨슨병의 주요…","subcategory":"뇌구조·기능","level":1,"related":["reward-prediction-error","cerebellum"],"prerequisites":[],"aliases":["흑질치밀부","substantia nigra pars compacta"]},{"slug":"microglia","title_ko":"미세아교세포","title_en":"microglia","meaning":"중추신경계에 상주하는 면역세포로, 평소에는 뇌 환경을 감시하다가 손상이나 감염이 생기면 활성화되어 병원체와 죽은 세포 잔해를…","subcategory":"신경세포·전달물질","level":1,"related":["astrocyte","synaptic-pruning","hippocampus"],"prerequisites":[],"aliases":["뇌 면역세포"]},{"slug":"reward-prediction-error","title_ko":"보상예측오차","title_en":"reward prediction error","meaning":"실제로 받은 보상과 미리 예측했던 보상 사이의 차이로, 중뇌 도파민 신경세포의 발화 패턴이 이 값을 부호화해 학습 신호로…","subcategory":"인지신경과학","level":3,"related":["substantia-nigra"],"prerequisites":[],"aliases":["보상 예측 오차","RPE"]},{"slug":"nmda-receptor","title_ko":"NMDA 수용체","title_en":"NMDA receptor","meaning":"신경세포가 충분히 흥분한 상태에서만 열리는 수용체로, 시냅스가 얼마나 강해질지를 결정하는 분자 스위치입니다.","subcategory":"신경세포·전달물질","level":2,"related":["long-term-potentiation","excitotoxicity","hippocampus"],"prerequisites":[],"aliases":["NMDA 글루타메이트 수용체","N-메틸-D-아스파르트산 수용체","NMDA수용체"]},{"slug":"excitotoxicity","title_ko":"흥분독성","title_en":"excitotoxicity","meaning":"글루타메이트 같은 흥분성 신경전달물질이 과도하게 분비되어 신경세포가 스스로 죽음에 이르는 현상입니다.","subcategory":"신경질환","level":2,"related":["nmda-receptor","long-term-potentiation","microglia","epileptic-seizure"],"prerequisites":[],"pop":13,"aliases":["흥분성 세포독성","글루타메이트 독성"]},{"slug":"entorhinal-cortex","title_ko":"내후각피질","title_en":"entorhinal cortex","meaning":"대뇌피질 전체의 감각 정보를 모아 해마로 전달하고, 해마의 처리 결과를 다시 피질로 돌려보내는 관문 역할을 하는 뇌…","subcategory":"뇌구조·기능","level":3,"related":["hippocampus"],"prerequisites":["hippocampus"],"aliases":["내후각뇌피질"]},{"slug":"locus-coeruleus","title_ko":"청반","title_en":"locus coeruleus","meaning":"뇌간에 위치한 작은 신경핵으로, 노르아드레날린을 뇌 전체에 뿌려 각성 수준과 주의 집중을 조절합니다.","subcategory":"뇌구조·기능","level":2,"related":["ventral-tegmental-area","substantia-nigra","hpa-axis"],"prerequisites":[],"aliases":["청색반점","로커스 세룰레우스"]},{"slug":"ventral-tegmental-area","title_ko":"복측피개영역","title_en":"ventral tegmental area","meaning":"중뇌에 위치한 신경핵으로, 도파민을 분비하여 보상감과 동기부여를 만들어내는 뇌 보상 회로의 출발점입니다.","subcategory":"뇌구조·기능","level":2,"related":["reward-prediction-error","substantia-nigra","locus-coeruleus"],"prerequisites":[],"pop":2,"aliases":["VTA","복측피개부"]},{"slug":"proprioception","title_ko":"고유수용감각","title_en":"proprioception","meaning":"눈으로 보지 않아도 근육, 힘줄, 관절의 감각 수용체를 통해 몸의 위치와 움직임을 스스로 인식하는 감각입니다.","subcategory":"인지신경과학","level":1,"related":["cerebellum","neural-circuit"],"prerequisites":[],"aliases":["자기수용감각","위치감각"]},{"slug":"autonomic-nervous-system","title_ko":"자율신경계","title_en":"autonomic nervous system","meaning":"심장박동, 소화, 호흡, 체온 조절처럼 의식적으로 신경 쓰지 않아도 몸을 자동으로 운영하는 신경계로, 교감신경과…","subcategory":"뇌구조·기능","level":1,"related":["hpa-axis","hypothalamus"],"prerequisites":[],"aliases":["ANS","자율신경"]},{"slug":"oligodendrocyte","title_ko":"희소돌기아교세포","title_en":"oligodendrocyte","meaning":"뇌와 척수(중추신경계)에서 신경세포의 축삭을 말이집(수초)으로 감싸 신호 전달 속도를 높여주는 신경교세포입니다.","subcategory":"신경세포·전달물질","level":1,"related":["myelination","astrocyte","microglia"],"prerequisites":[],"aliases":["희소돌기교세포","올리고덴드로사이트"]},{"slug":"gaba-receptor","title_ko":"GABA 수용체","title_en":"GABA Receptor","meaning":"뇌에서 가장 대표적인 억제성 신경전달물질인 GABA(감마아미노뷰티르산)와 결합해 신경세포의 흥분을 가라앉히는 수용체입니다.","subcategory":"신경세포·전달물질","level":2,"related":["nmda-receptor","epsp-ipsp","excitatory-inhibitory-balance"],"prerequisites":[],"aliases":["GABA수용체"]},{"slug":"magnetoencephalography","title_ko":"뇌자도","title_en":"Magnetoencephalography","meaning":"뇌 신경세포의 전기 활동이 만들어내는 매우 미세한 자기장을 두피 밖에서 측정하여 뇌 기능을 시간 단위로 정밀하게 추적하는…","subcategory":"실험기기·측정장비","level":3,"related":["eeg","fmri"],"prerequisites":[],"aliases":["MEG"]},{"slug":"autism-spectrum-disorder","title_ko":"자폐스펙트럼장애","title_en":"Autism Spectrum Disorder","meaning":"사회적 상호작용과 의사소통의 어려움, 반복적 행동 패턴을 특징으로 하는 신경발달장애로, 뇌 회로의 흥분-억제 균형과 시냅스…","subcategory":"신경질환","level":2,"related":["excitatory-inhibitory-balance","synaptic-pruning","mirror-neuron","critical-period"],"prerequisites":[],"aliases":["자폐증","ASD"]},{"slug":"schizophrenia","title_ko":"조현병","title_en":"Schizophrenia","meaning":"도파민 신경전달 이상과 전전두피질 기능 저하를 핵심 기전으로 하는 정신질환으로, 환각·망상 같은 양성 증상과 무의욕 같은…","subcategory":"신경질환","level":1,"related":["nmda-receptor","prefrontal-cortex","white-matter"],"prerequisites":[],"aliases":["정신분열병"]},{"slug":"engram","title_ko":"엔그램","title_en":"Engram","meaning":"엔그램은 특정 기억이 형성될 때 활성화되고 물리적·화학적으로 변화하는 신경세포 집단을 가리키며, 기억이 뇌 속에 실제로…","subcategory":"인지신경과학","level":3,"related":["hippocampus","long-term-potentiation","synaptic-pruning"],"prerequisites":[],"aliases":["기억흔적","engram cell"]},{"slug":"neuropathic-pain","title_ko":"신경병증성 통증","title_en":"Neuropathic Pain","meaning":"신경병증성 통증은 말초 또는 중추 신경계 자체의 손상이나 기능 이상으로 발생하는 만성 통증으로, 실제 조직 손상 없이도…","subcategory":"신경질환","level":2,"related":["excitotoxicity"],"prerequisites":[],"aliases":["neuropathic pain","중추 감작","신경병증성통증"]},{"slug":"bipolar-disorder","title_ko":"양극성장애","title_en":"Bipolar Disorder","meaning":"기분이 비정상적으로 들뜨는 조증(또는 경조증) 상태와 깊은 우울 상태가 번갈아 나타나는, 뇌의 기분 조절 회로 이상과 관련된…","subcategory":"신경질환","level":2,"related":["prefrontal-cortex","schizophrenia"],"prerequisites":[],"aliases":["조울증","Manic Depression"]},{"slug":"insular-cortex","title_ko":"섬엽","title_en":"Insular Cortex","meaning":"대뇌피질 안쪽 깊숙이 접혀 들어가 있는 부위로, 심박·호흡·통증 같은 몸속 신호를 감정과 자기 인식으로 통합하는 뇌…","subcategory":"뇌구조·기능","level":2,"related":["amygdala","anterior-cingulate-cortex","limbic-system","prefrontal-cortex"],"prerequisites":["amygdala","anterior-cingulate-cortex","limbic-system"],"pop":19,"aliases":["뇌섬엽","Insula"]},{"slug":"anterior-cingulate-cortex","title_ko":"전대상피질","title_en":"Anterior Cingulate Cortex","meaning":"대뇌 안쪽 표면에 위치하며 상반된 정보의 충돌을 탐지하고, 실수를 감시하며, 통증의 정서적 측면을 처리하는 뇌 영역입니다.","subcategory":"뇌구조·기능","level":2,"related":["stroop-effect","prefrontal-cortex","insular-cortex","limbic-system"],"prerequisites":[],"aliases":["ACC","전방대상피질"]},{"slug":"striatum","title_ko":"선조체","title_en":"Striatum","meaning":"기저핵의 핵심 구성 요소로, 미상핵과 조가비핵으로 이루어져 운동 조절과 보상 학습, 습관 형성을 담당하는 뇌 구조물입니다.","subcategory":"뇌구조·기능","level":1,"related":["substantia-nigra"],"prerequisites":[],"aliases":["줄무늬체"]},{"slug":"spike-timing-dependent-plasticity","title_ko":"스파이크 시점 의존 가소성","title_en":"Spike-Timing-Dependent Plasticity","meaning":"두 신경세포가 활동전위(스파이크)를 발생시키는 시간적 순서와 간격에 따라 시냅스 연결의 강도가 강화되거나 약화되는 신경가소성…","subcategory":"신경세포·전달물질","level":3,"related":["long-term-potentiation","action-potential"],"prerequisites":[],"aliases":["STDP","스파이크시점의존가소성"]},{"slug":"gut-brain-axis","title_ko":"장-뇌 축","title_en":"Gut-Brain Axis","meaning":"장내미생물, 장 신경계, 미주신경, 면역·호르몬 경로를 통해 소화관과 뇌가 양방향으로 정보를 주고받는 상호작용 체계입니다.","subcategory":"뇌구조·기능","level":2,"related":["hpa-axis","hippocampus","autonomic-nervous-system"],"prerequisites":["hpa-axis","hippocampus","autonomic-nervous-system"],"aliases":["장뇌축","Microbiota-Gut-Brain Axis","GBA","장 뇌 축","장-뇌축","장뇌 축"]},{"slug":"cortical-homunculus","title_ko":"대뇌 호문쿨루스","title_en":"Cortical Homunculus","meaning":"대뇌피질의 감각·운동 영역이 신체 각 부위를 얼마나 정교하게 처리하는지에 비례해 몸을 왜곡된 비율로 그린 뇌 속 신체…","subcategory":"뇌구조·기능","level":1,"related":["neuroplasticity","proprioception","thalamus"],"prerequisites":[],"pop":14,"aliases":["대뇌호문쿨루스"]},{"slug":"ischemic-stroke","title_ko":"허혈성 뇌졸중","title_en":"Ischemic Stroke","meaning":"뇌혈관이 혈전 등으로 막혀 해당 부위 뇌조직에 혈류 공급이 끊기면서 신경세포가 산소와 포도당 부족으로 손상되는…","subcategory":"신경질환","level":1,"related":["excitotoxicity","blood-brain-barrier","microglia"],"prerequisites":[],"aliases":["허혈성뇌졸중"]},{"slug":"neurovascular-coupling","title_ko":"신경혈관 연동","title_en":"Neurovascular Coupling","meaning":"특정 뇌 영역의 신경 활동이 증가하면 해당 부위로 가는 국소 뇌혈류도 함께 증가하는 현상으로, fMRI가 뇌활동을 간접적으로…","subcategory":"신경영상·측정기법","level":3,"related":["fmri","blood-brain-barrier","astrocyte"],"prerequisites":["fmri"],"aliases":["신경혈관연동"]},{"slug":"orexin","title_ko":"오렉신","title_en":"Orexin","meaning":"시상하부의 소수 뉴런에서 분비되는 신경펩타이드로, 각성 상태 유지와 식욕 조절에 관여하며 결핍 시 기면증을 유발합니다.","subcategory":"신경세포·전달물질","level":2,"related":["hypothalamus","rem-sleep","locus-coeruleus"],"prerequisites":[],"aliases":["하이포크레틴"]},{"slug":"raphe-nuclei","title_ko":"솔기핵","title_en":"Raphe Nuclei","meaning":"뇌간 정중선을 따라 늘어선 신경핵 무리로, 뇌 전체 세로토닌 신경세포체의 대부분이 모여 있어 기분·수면·통증 조절에 폭넓게…","subcategory":"뇌구조·기능","level":2,"related":["rem-sleep","locus-coeruleus"],"prerequisites":["locus-coeruleus"],"aliases":["봉선핵"]},{"slug":"slow-wave-sleep","title_ko":"서파수면","title_en":"Slow-Wave Sleep","meaning":"non-REM 수면 중 가장 깊은 단계로, 뇌파에서 크고 느린 델타파가 우세하게 나타나며 기억 강화와 뇌 노폐물 제거가…","subcategory":"인지신경과학","level":2,"related":["rem-sleep","glymphatic-system","hippocampus"],"prerequisites":["rem-sleep"]},{"slug":"hemispheric-lateralization","title_ko":"대뇌반구 편측화","title_en":"Hemispheric Lateralization","meaning":"좌뇌와 우뇌가 겉모습은 비슷해도 언어, 공간지각 같은 특정 기능을 서로 다르게 나누어 맡도록 특화되어 있는 현상입니다.","subcategory":"인지신경과학","level":2,"related":["corpus-callosum","broca-wernicke-area","cortical-homunculus","neuroplasticity"],"prerequisites":[],"aliases":["대뇌반구편측화"]},{"slug":"resting-membrane-potential","title_ko":"안정막전위","title_en":"Resting Membrane Potential","meaning":"뉴런이 아무런 자극도 받지 않았을 때 세포막 안쪽이 바깥쪽보다 약 -70mV 낮게 유지되는 전압 상태입니다.","subcategory":"신경세포·전달물질","level":1,"related":["action-potential","synapse","neurotransmitter"],"prerequisites":[]},{"slug":"memory-consolidation","title_ko":"기억 응고화","title_en":"Memory Consolidation","meaning":"갓 형성되어 불안정한 단기기억이 시간이 지나면서 뇌 안에서 안정적인 장기기억으로 굳어지는 과정입니다.","subcategory":"인지신경과학","level":2,"related":["long-term-potentiation","hippocampus","slow-wave-sleep","working-memory"],"prerequisites":[],"aliases":["기억응고화"]},{"slug":"bold-signal","title_ko":"혈중산소농도의존신호","title_en":"BOLD Signal","meaning":"뇌의 특정 부위가 활발히 활동할 때 그 주변 혈액 속 산소 농도가 변하는 것을 이용해 뇌 활동을 간접적으로 측정하는…","subcategory":"신경영상·측정기법","level":3,"related":["fmri","eeg","default-mode-network","prefrontal-cortex"],"prerequisites":["fmri","eeg"],"aliases":["BOLD"]},{"slug":"dendritic-arborization","title_ko":"수상돌기 가지형성","title_en":"Dendritic Arborization","meaning":"뉴런의 수상돌기가 발달 과정에서 나뭇가지처럼 여러 갈래로 뻗어나가며 복잡한 가지 구조를 형성하는 과정입니다.","subcategory":"신경세포·전달물질","level":2,"related":["neuroplasticity","synaptic-pruning"],"prerequisites":["neuroplasticity"],"aliases":["수상돌기가지형성"]},{"slug":"sensory-neuron","title_ko":"감각신경","title_en":"Sensory Neuron","meaning":"눈, 귀, 피부 같은 감각기관이 받아들인 자극을 전기 신호로 바꿔 중추신경계로 전달하는 신경세포입니다.","subcategory":"신경세포·전달물질","level":1,"related":["interneuron"],"prerequisites":[],"aliases":["감각뉴런"]},{"slug":"interneuron","title_ko":"연합뉴런","title_en":"Interneuron","meaning":"감각신경과 운동신경 사이에서 정보를 중계하고 통합하는, 중추신경계 안에 있는 신경세포입니다.","subcategory":"신경세포·전달물질","level":1,"related":["sensory-neuron","gaba-receptor","excitatory-inhibitory-balance"],"prerequisites":["gaba-receptor","excitatory-inhibitory-balance"],"aliases":["개재뉴런","사이신경세포"]},{"slug":"gap-junction","title_ko":"간극연접","title_en":"Gap Junction","meaning":"두 신경세포의 세포막에 있는 통로 단백질(코넥신)이 서로 맞닿아, 신경전달물질 없이 이온과 전기 신호가 곧바로 흐르게 하는…","subcategory":"신경세포·전달물질","level":3,"related":["synapse","action-potential","astrocyte","glial-cell"],"prerequisites":["synapse","action-potential","astrocyte"],"aliases":["전기시냅스","Electrical Synapse"]},{"slug":"deep-brain-stimulation","title_ko":"뇌심부자극술","title_en":"Deep Brain Stimulation","meaning":"뇌 깊은 곳에 가느다란 전극을 심어 전기 자극으로 이상 신경 활동을 조절하는 치료 기법입니다.","subcategory":"신경영상·측정기법","level":2,"related":["substantia-nigra"],"prerequisites":[]},{"slug":"habituation","title_ko":"습관화","title_en":"Habituation","meaning":"같은 자극이 반복해서 주어질 때 그 자극에 대한 반응이 점점 줄어드는, 가장 단순한 형태의 학습 및 신경 적응 현상입니다.","subcategory":"인지신경과학","level":2,"related":["neuroplasticity","sensory-neuron","visual-cliff-experiment"],"prerequisites":[],"pop":11},{"slug":"auditory-cortex","title_ko":"청각피질","title_en":"Auditory Cortex","meaning":"대뇌 측두엽에 위치하며, 귀에서 전달된 소리 신호를 실제 \"소리\"로 해석하는 뇌 영역입니다.","subcategory":"뇌구조·기능","level":2,"related":["broca-wernicke-area"],"prerequisites":["broca-wernicke-area"]},{"slug":"primary-motor-cortex","title_ko":"일차운동피질","title_en":"Primary Motor Cortex","meaning":"대뇌 전두엽 뒷부분에 위치하며, 몸의 자발적인 움직임을 직접 명령하는 뇌 영역입니다.","subcategory":"뇌구조·기능","level":1,"related":["cortical-homunculus","prefrontal-cortex","cerebellum"],"prerequisites":[],"aliases":["M1"]},{"slug":"chronic-traumatic-encephalopathy","title_ko":"만성외상성뇌병증","title_en":"Chronic Traumatic Encephalopathy","meaning":"머리에 약한 충격을 오랜 기간 반복적으로 받으면서 서서히 진행되는 퇴행성 뇌질환으로, 기억력 저하와 성격 변화 등을…","subcategory":"신경질환","level":3,"related":[],"prerequisites":[]},{"slug":"choroid-plexus","title_ko":"맥락총","title_en":"Choroid Plexus","meaning":"뇌실 안쪽에 자리 잡아 혈액을 걸러 뇌척수액을 만들어내는 그물 모양의 혈관 조직입니다.","subcategory":"뇌구조·기능","level":2,"related":["blood-brain-barrier"],"prerequisites":["blood-brain-barrier"],"aliases":["맥락얼기"]},{"slug":"gyrus-sulcus","title_ko":"이랑과 고랑","title_en":"Gyrus and Sulcus","meaning":"대뇌피질 표면이 주름진 모양을 이루는 볼록한 부분(이랑)과 오목하게 패인 부분(고랑)을 가리킵니다.","subcategory":"뇌구조·기능","level":1,"related":["broca-wernicke-area","prefrontal-cortex","cortical-homunculus"],"prerequisites":["broca-wernicke-area","prefrontal-cortex","cortical-homunculus"],"pop":18,"aliases":["이랑과고랑"]},{"slug":"synaptic-cleft","title_ko":"시냅스 틈","title_en":"Synaptic Cleft","meaning":"신호를 보내는 뉴런과 받는 뉴런의 끝이 서로 맞닿지 않고 아주 살짝 떨어져 있는 좁은 틈으로, 이 틈을 신경전달물질이…","subcategory":"신경세포·전달물질","level":1,"related":["synapse","neurotransmitter","action-potential"],"prerequisites":["synapse","neurotransmitter","action-potential"],"aliases":["시냅스틈"]},{"slug":"cranial-nerve","title_ko":"뇌신경","title_en":"Cranial Nerve","meaning":"척수를 거치지 않고 뇌에서 곧바로 뻗어 나와 얼굴, 눈, 코, 귀 등 주로 머리와 목 부위를 담당하는 12쌍의 말초신경입니다.","subcategory":"뇌구조·기능","level":1,"related":["autonomic-nervous-system","sensory-neuron"],"prerequisites":["autonomic-nervous-system"],"aliases":["두개신경"]},{"slug":"refractory-period","title_ko":"불응기","title_en":"Refractory Period","meaning":"활동전위가 한 번 발생한 직후, 같은 자리에서 새로운 활동전위가 다시 일어나기 어렵거나 훨씬 강한 자극이 필요한 짧은 시간…","subcategory":"신경세포·전달물질","level":1,"related":["action-potential","saltatory-conduction","sodium-potassium-pump"],"prerequisites":[]},{"slug":"sodium-potassium-pump","title_ko":"나트륨-칼륨 펌프","title_en":"Sodium-Potassium Pump","meaning":"세포 안의 나트륨 이온을 밖으로, 바깥의 칼륨 이온을 안으로 에너지를 써서 퍼 나르며 뉴런의 안정막전위를 계속 유지시켜 주는…","subcategory":"신경세포·전달물질","level":1,"related":["resting-membrane-potential","action-potential","refractory-period"],"prerequisites":["resting-membrane-potential","action-potential"],"aliases":["나트륨 칼륨 펌프","나트륨-칼륨펌프","나트륨칼륨 펌프"]},{"slug":"parietal-lobe","title_ko":"두정엽","title_en":"Parietal Lobe","meaning":"촉각·통증 같은 몸의 감각 정보를 처리하는 것을 넘어, 여러 감각을 하나로 통합하고 공간 속 위치·방향을 파악하게 해주는…","subcategory":"뇌구조·기능","level":1,"related":["cortical-homunculus","gyrus-sulcus"],"prerequisites":["cortical-homunculus"]},{"slug":"hemispatial-neglect","title_ko":"편측무시","title_en":"Hemispatial Neglect","meaning":"뇌 손상으로 인해 몸이나 시야의 반대쪽 절반에 있는 대상을 인식하거나 반응하지 못하는 증상입니다.","subcategory":"신경질환","level":2,"related":["parietal-lobe","hemispheric-lateralization","ischemic-stroke","cortical-homunculus"],"prerequisites":["ischemic-stroke"],"pop":3,"aliases":["반측공간무시","편측공간무시"]},{"slug":"synesthesia","title_ko":"공감각","title_en":"Synesthesia","meaning":"하나의 감각 자극이 자동으로, 본래 관련 없는 다른 감각이나 인지 경험을 함께 불러일으키는 신경학적 현상입니다.","subcategory":"인지신경과학","level":3,"related":["neuroplasticity","auditory-cortex"],"prerequisites":[]},{"slug":"sensory-adaptation","title_ko":"감각순응","title_en":"Sensory Adaptation","meaning":"같은 강도의 자극이 계속 주어지면 감각수용기의 반응이 시간이 지날수록 점점 줄어드는 현상입니다.","subcategory":"인지신경과학","level":3,"related":["action-potential"],"prerequisites":[],"aliases":["감각적응"]},{"slug":"alpha-synuclein","title_ko":"알파시누클레인","title_en":"Alpha-synuclein","meaning":"시냅스 말단에 풍부한 작은 단백질로, 비정상적으로 뭉쳐 응집되면 파킨슨병 등 신경퇴행성질환의 특징인 루이소체를 형성합니다.","subcategory":"신경질환","level":3,"related":[],"prerequisites":[]},{"slug":"frontal-lobe","title_ko":"전두엽","title_en":"Frontal Lobe","meaning":"대뇌 앞쪽에 위치하며 판단·계획·충동 조절 같은 고차원적 사고와 자발적인 몸의 움직임을 명령하는 뇌엽입니다.","subcategory":"뇌구조·기능","level":1,"related":["prefrontal-cortex","primary-motor-cortex","temporal-lobe"],"prerequisites":["prefrontal-cortex","primary-motor-cortex"]},{"slug":"temporal-lobe","title_ko":"측두엽","title_en":"Temporal Lobe","meaning":"대뇌 양쪽 옆면, 관자놀이 안쪽에 자리하며 소리를 듣고 뜻을 이해하며 새로운 기억을 만드는 데 관여하는 뇌엽입니다.","subcategory":"뇌구조·기능","level":1,"related":["auditory-cortex","hippocampus","broca-wernicke-area","frontal-lobe"],"prerequisites":["hippocampus","broca-wernicke-area"]},{"slug":"dorsal-ventral-stream","title_ko":"배측 경로와 복측 경로","title_en":"Dorsal/Ventral Stream","meaning":"시각피질에서 나온 정보가 두정엽 방향으로 흘러 \"어디에, 어떻게\"를 처리하는 배측 경로와, 측두엽 방향으로 흘러…","subcategory":"인지신경과학","level":3,"related":["parietal-lobe","temporal-lobe"],"prerequisites":[],"aliases":["배측경로와복측경로"]},{"slug":"interoception","title_ko":"내수용감각","title_en":"Interoception","meaning":"심장박동, 호흡, 배고픔, 갈증 같은 몸속 장기와 생리 상태의 신호를 뇌가 알아차리고 지각하는 감각입니다.","subcategory":"인지신경과학","level":3,"related":["insular-cortex","hypothalamus","proprioception"],"prerequisites":["proprioception"],"aliases":["내부감각"]},{"slug":"muscle-spindle","title_ko":"근방추","title_en":"Muscle Spindle","meaning":"근육 속에 파묻혀 근육이 얼마나, 얼마나 빠르게 늘어나는지를 감지해 척수와 뇌에 알려주는 감각수용기입니다.","subcategory":"신경세포·전달물질","level":2,"related":["golgi-tendon-organ","reflex-arc","proprioception","cerebellum"],"prerequisites":[],"aliases":["근육방추"]},{"slug":"golgi-tendon-organ","title_ko":"골지건기관","title_en":"Golgi Tendon Organ","meaning":"근육과 뼈를 잇는 힘줄 속에 있어 근육이 만들어내는 당기는 힘(장력)이 너무 세지지 않는지 감시하는 감각수용기입니다.","subcategory":"신경세포·전달물질","level":2,"related":["muscle-spindle","reflex-arc","proprioception"],"prerequisites":[],"aliases":["GTO"]},{"slug":"acetylcholinesterase","title_ko":"아세틸콜린에스터레이즈","title_en":"Acetylcholinesterase","meaning":"시냅스에서 임무를 마친 신경전달물질 아세틸콜린을 재빨리 분해해 신호를 끝내는 효소입니다.","subcategory":"신경세포·전달물질","level":2,"related":["neurotransmitter"],"prerequisites":["neurotransmitter"],"pop":17,"aliases":["AChE","아세틸콜린분해효소"]},{"slug":"rotarod","title_ko":"로타로드","title_en":"Rotarod","meaning":"회전하는 막대 위에서 실험동물이 얼마나 오래 균형을 잡고 버티는지 측정하여 운동협응 능력을 평가하는 행동실험 장비입니다.","subcategory":"실험기기·측정장비","level":3,"related":["control-group"],"prerequisites":[]},{"slug":"narcolepsy","title_ko":"기면증","title_en":"Narcolepsy","meaning":"각성을 유지시키는 오렉신 분비 신경세포가 소실되어, 시도 때도 없이 갑자기 졸음이 쏟아지고 수면-각성 경계가 무너지는…","subcategory":"신경질환","level":3,"related":["orexin","rem-sleep","hypothalamus"],"prerequisites":[],"aliases":["수면발작증"]},{"slug":"medulla-oblongata","title_ko":"연수","title_en":"Medulla Oblongata","meaning":"뇌줄기 맨 아래쪽에 자리 잡아 호흡, 심장박동, 혈압처럼 생각하지 않아도 저절로 돌아가는 생명 유지 기능을 조절하는…","subcategory":"뇌구조·기능","level":1,"related":["cerebellum"],"prerequisites":["cerebellum"],"aliases":["숨뇌"]},{"slug":"optic-chiasm","title_ko":"시신경교차","title_en":"Optic Chiasm","meaning":"좌우 눈에서 나온 시신경 다발이 뇌 아래쪽에서 X자 모양으로 만나며 일부 섬유가 반대쪽 뇌로 교차해 넘어가는 지점입니다.","subcategory":"뇌구조·기능","level":2,"related":["thalamus"],"prerequisites":["thalamus"],"aliases":["시각교차"]},{"slug":"gfap","title_ko":"교세포섬유산성단백질","title_en":"GFAP","meaning":"성상세포의 골격을 이루는 단백질로, 뇌가 손상되었을 때 성상세포가 활성화되었는지를 확인하는 대표적인 표지자입니다.","subcategory":"신경세포·전달물질","level":1,"related":["astrocyte","microglia"],"prerequisites":[]},{"slug":"dorsolateral-prefrontal-cortex","title_ko":"배외측전전두피질","title_en":"dorsolateral prefrontal cortex","meaning":"이마 옆쪽 위편에 위치한 전전두피질의 한 부위로, 작업기억을 유지하고 여러 정보를 비교·계획하는 \"머릿속 작업대\" 역할을…","subcategory":"뇌구조·기능","level":2,"related":["prefrontal-cortex","anterior-cingulate-cortex","fmri"],"prerequisites":["prefrontal-cortex","anterior-cingulate-cortex"],"pop":10,"aliases":["DLPFC"]},{"slug":"dopamine-receptor-subtype","title_ko":"도파민 수용체 아형","title_en":"dopamine receptor subtype","meaning":"같은 도파민이라는 신호를 받아도 신경세포를 더 흥분시키는지 억제시키는지가 달라지는, D1형과 D2형이라는 두 계열의 수용체…","subcategory":"신경세포·전달물질","level":2,"related":[],"prerequisites":[],"pop":15,"aliases":["도파민수용체아형"]},{"slug":"lewy-body","title_ko":"루이소체","title_en":"Lewy Body","meaning":"알파시누클레인 단백질이 신경세포 안에 비정상적으로 뭉쳐서 만들어지는 둥근 덩어리로, 파킨슨병과 루이소체 치매 환자의 뇌에서…","subcategory":"신경질환","level":3,"related":[],"prerequisites":[],"aliases":["루이체"]},{"slug":"gate-control-theory-of-pain","title_ko":"통증 관문 조절 이론","title_en":"Gate Control Theory of Pain","meaning":"척수 뒷뿔에 있는 신경 \"문\"에서 굵은 감각 신경의 신호가 가는 통증 신경의 신호를 막을 수 있다는, 통증 전달을 설명하는…","subcategory":"인지신경과학","level":2,"related":["vestibulo-ocular-reflex"],"prerequisites":[],"pop":6,"aliases":["GCTP","통증관문조절이론"]},{"slug":"vestibulo-ocular-reflex","title_ko":"전정안반사","title_en":"Vestibulo-Ocular Reflex","meaning":"머리가 움직이는 방향과 반대로 눈을 자동으로 움직여, 머리가 흔들려도 보고 있는 대상을 또렷하게 유지시키는 반사입니다.","subcategory":"뇌구조·기능","level":3,"related":["cerebellum","gate-control-theory-of-pain"],"prerequisites":["cerebellum"],"aliases":["VOR"]},{"slug":"sleep-homeostasis","title_ko":"수면 항상성","title_en":"Sleep Homeostasis","meaning":"깨어있는 시간이 길어질수록 뇌에 수면 욕구(수면압)가 쌓이고, 잠을 자면서 그 욕구가 해소되는 신체 조절 기전입니다.","subcategory":"인지신경과학","level":2,"related":["gate-control-theory-of-pain"],"prerequisites":[],"pop":16,"aliases":["수면항상성"]},{"slug":"dorsal-root-ganglion","title_ko":"배근신경절","title_en":"dorsal root ganglion","meaning":"피부와 근육 등에서 온 감각 신호를 척수로 전달하는 감각신경세포의 몸통(세포체)이 모여 있는 척수 바로 옆의 작은 혹입니다.","subcategory":"뇌구조·기능","level":2,"related":["axon"],"prerequisites":[],"aliases":["등쪽뿌리신경절","후근신경절"]},{"slug":"thermoreceptor","title_ko":"온도수용기","title_en":"thermoreceptor","meaning":"피부에서 온도 변화를 감지해 \"따뜻하다\" 또는 \"차갑다\"는 신경 신호로 바꿔주는 감각수용기입니다.","subcategory":"신경세포·전달물질","level":2,"related":["dorsal-root-ganglion"],"prerequisites":[],"aliases":["온도감각수용기"]},{"slug":"cognitive-reserve","title_ko":"인지예비능","title_en":"Cognitive Reserve","meaning":"교육, 직업적 경험, 지적 활동 등을 통해 쌓인 뇌의 효율성과 유연성 덕분에 같은 정도의 뇌 손상에도 인지기능 저하가 더디게…","subcategory":"인지신경과학","level":3,"related":["neuroplasticity","mini-mental-state-examination"],"prerequisites":[]},{"slug":"diffuse-axonal-injury","title_ko":"미만성 축삭손상","title_en":"Diffuse Axonal Injury","meaning":"교통사고 등에서 머리가 급격히 흔들리거나 회전할 때 뇌 전체에 걸쳐 신경세포의 축삭이 광범위하게 늘어나고 끊어지는 외상성…","subcategory":"신경질환","level":3,"related":["neuroplasticity","excitotoxicity","cognitive-reserve","ischemic-stroke"],"prerequisites":["excitotoxicity","ischemic-stroke"],"pop":8,"aliases":["미만성축삭손상"]},{"slug":"local-field-potential","title_ko":"국소장전위","title_en":"Local Field Potential","meaning":"뇌 조직 한 지점에 가느다란 전극을 꽂아 측정한, 주변 수많은 뉴런의 전기 활동이 합쳐진 신호입니다.","subcategory":"신경영상·측정기법","level":3,"related":[],"prerequisites":[],"aliases":["LFP"]},{"slug":"salience-network","title_ko":"현저성 네트워크","title_en":"Salience Network","meaning":"안팎에서 들어오는 여러 정보 중 지금 가장 중요한 것을 골라내 주의를 그쪽으로 돌리게 하는 뇌의 대규모 네트워크입니다.","subcategory":"뇌구조·기능","level":3,"related":[],"prerequisites":[],"aliases":["현저성네트워크"]},{"slug":"visual-agnosia","title_ko":"시각실인증 (Visual Agnosia)","title_en":"Visual Agnosia","meaning":"눈의 시력 자체는 정상이지만 뇌 손상으로 인해 본 대상이 무엇인지 인식하지 못하는 상태입니다.","subcategory":"신경질환","level":3,"related":["dorsal-ventral-stream"],"prerequisites":[],"aliases":["시각실인증","시각실인증(VisualAgnosia)"]},{"slug":"hebbian-learning","title_ko":"헤비안 학습","title_en":"Hebbian Learning","meaning":"두 신경세포가 동시에 활성화될수록 그 사이의 연결이 점점 강해진다는 학습 원리로, 반복되는 경험 패턴만으로 뇌가 스스로…","subcategory":"인지신경과학","level":3,"related":["long-term-potentiation","spike-timing-dependent-plasticity","synapse","neural-circuit"],"prerequisites":[],"aliases":["헤비안학습"]},{"slug":"episodic-memory","title_ko":"일화기억","title_en":"Episodic Memory","meaning":"언제, 어디서, 무엇을 했는지처럼 시간과 장소가 함께 담긴 개인적 경험에 대한 장기기억입니다.","subcategory":"인지신경과학","level":3,"related":["hippocampus","memory-consolidation","working-memory","prefrontal-cortex"],"prerequisites":["memory-consolidation"],"aliases":["삽화기억"]},{"slug":"spike-sorting","title_ko":"스파이크 정렬","title_en":"Spike Sorting","meaning":"여러 뉴런의 신호가 뒤섞인 전극 기록에서, 각 스파이크(활동전위)가 어떤 뉴런에서 발생했는지 구분해내는 분석 기법입니다.","subcategory":"신경영상·측정기법","level":3,"related":["patch-clamp","action-potential","local-field-potential"],"prerequisites":[],"aliases":["스파이크정렬"]},{"slug":"memory-reconsolidation","title_ko":"기억 재응고화","title_en":"Memory Reconsolidation","meaning":"이미 저장된 기억을 다시 떠올릴 때 그 기억이 일시적으로 불안정해졌다가 다시 저장되는 과정입니다.","subcategory":"인지신경과학","level":3,"related":["memory-consolidation","engram","hippocampus"],"prerequisites":["memory-consolidation","engram"],"aliases":["기억재응고화"]},{"slug":"wallerian-degeneration","title_ko":"왈러 변성","title_en":"Wallerian Degeneration","meaning":"손상된 축삭에서 세포체로부터 먼 쪽 부분이 시간이 지나며 스스로 분해되어 사라지는 신경 퇴행 과정입니다.","subcategory":"신경질환","level":3,"related":["axon"],"prerequisites":[],"pop":12,"aliases":["왈러변성"]},{"slug":"stereotaxic-surgery","title_ko":"정위수술","title_en":"Stereotaxic Surgery","meaning":"두개골의 기준점을 좌표 삼아 뇌의 특정 위치를 정확히 찾아 전극이나 바늘을 삽입하는 실험 기법입니다.","subcategory":"신경영상·측정기법","level":2,"related":["deep-brain-stimulation"],"prerequisites":[],"aliases":["뇌정위수술","정위적수술"]},{"slug":"retina","title_ko":"망막","title_en":"Retina","meaning":"안구 뒤쪽 벽을 감싸며 빛을 전기신호로 변환해 시신경을 통해 뇌로 보내는, 실제로는 뇌 조직의 일부인 다층 신경막입니다.","subcategory":"뇌구조·기능","level":1,"related":[],"prerequisites":[]},{"slug":"perfusion-fixation","title_ko":"관류·고정","title_en":"perfusion & fixation","meaning":"심장을 통해 혈액을 생리식염수로 씻어낸 뒤 고정액(주로 파라포름알데하이드)을 흘려보내 조직 구조와 단백질을 그대로 보존하는…","subcategory":"신경영상·측정기법","level":3,"related":["stereotaxic-surgery"],"prerequisites":["stereotaxic-surgery"],"aliases":["관류 고정","관류고정"]},{"slug":"neuron-doctrine","title_ko":"뉴런 독트린","title_en":"neuron doctrine","meaning":"뇌의 계산 단위는 뉴런이며, 뉴런이 정보를 통합해 스파이크를 내보내는 발화율에 정보가 실린다는 계산신경과학의 전통적…","subcategory":"신경세포·전달물질","level":2,"related":["astrocyte","reservoir-computing"],"prerequisites":["astrocyte"],"pop":1,"aliases":["뉴런독트린"]},{"slug":"freezing-behavior","title_ko":"얼어붙기(동결 반응)","title_en":"freezing behavior","meaning":"호흡을 제외한 모든 움직임이 멈추는 반응으로, 공포나 스트레스를 느낄 때 나타나는 대표적인 방어 행동 지표입니다.","subcategory":"신경영상·측정기법","level":3,"related":[],"prerequisites":[],"aliases":["동결 반응","얼어붙기","얼어붙기(동결반응)"]},{"slug":"angular-gyrus","title_ko":"모이랑(각회)","title_en":"angular gyrus","meaning":"두정엽 뒤쪽에 위치한 대뇌피질 영역으로, 문자 구조 인식과 쓰기 같은 언어의 시각적·상징적 처리에 관여합니다.","subcategory":"뇌구조·기능","level":2,"related":["broca-wernicke-area","parietal-lobe"],"prerequisites":["broca-wernicke-area","parietal-lobe"],"aliases":["각회","모이랑"]},{"slug":"cryostat-sectioning","title_ko":"저온절편법","title_en":"cryostat sectioning","meaning":"영하의 저온 챔버 안에서 동결된 조직을 마이크로톰으로 얇게 절단하는 저온절편기(크라이오스탯)를 이용해 조직 절편을 제작하는…","subcategory":"신경영상·측정기법","level":2,"related":[],"prerequisites":[],"aliases":["크라이오스탯절편"]},{"slug":"clarity-tissue-clearing","title_ko":"CLARITY 조직투명화","title_en":"CLARITY tissue clearing","meaning":"조직을 하이드로젤 그물망에 고정시킨 뒤 지질만을 선택적으로 제거하여 단백질과 핵산 구조는 그대로 보존하면서 광학적으로…","subcategory":"신경영상·측정기법","level":3,"related":[],"prerequisites":[],"aliases":["CLARITY조직투명화"]},{"slug":"connectomics","title_ko":"커넥토믹스","title_en":"connectomics","meaning":"전자현미경 등의 고해상도 영상 기법으로 얻은 대량의 데이터를 자동화된 영상 분할과 재구성 알고리즘으로 처리하여 신경계 내…","subcategory":"신경영상·측정기법","level":3,"related":[],"prerequisites":[],"aliases":["연결체학"]},{"slug":"archaerhodopsin","title_ko":"아르케로돕신","title_en":"archaerhodopsin (Arch)","meaning":"빛을 받으면 세포 안의 양성자를 세포 밖으로 퍼내어 막전위를 과분극시킴으로써 뉴런 활동을 억제하는 고균 유래 빛 구동 양성자…","subcategory":"신경영상·측정기법","level":3,"related":["channelrhodopsin"],"prerequisites":["channelrhodopsin"],"aliases":["Arch"]},{"slug":"channelrhodopsin","title_ko":"채널로돕신","title_en":"channelrhodopsin (ChR)","meaning":"청색광을 흡수하면 양이온을 투과시켜 세포를 탈분극시킴으로써 뉴런을 흥분시키는 조류 유래의 빛 구동 양이온 채널 옵신으로…","subcategory":"신경영상·측정기법","level":3,"related":["archaerhodopsin"],"prerequisites":[],"aliases":["ChR2","채널로돕신2"]},{"slug":"gcamp","title_ko":"GCaMP","title_en":"GCaMP","meaning":"녹색형광단백질과 칼모듈린, M13 펩타이드를 결합해 만든 유전부호화 칼슘 지시자로, 세포내 칼슘 농도가 증가하면 형광 강도가…","subcategory":"신경영상·측정기법","level":3,"related":[],"prerequisites":[]},{"slug":"rate-coding","title_ko":"발화율부호화","title_en":"Rate Coding","meaning":"뉴런이 일정 시간 동안 발생시키는 활동전위의 빈도(발화율)에 정보가 담겨 있다는 신경부호화 이론.","subcategory":"인지신경과학","level":2,"related":["reward-prediction-error"],"prerequisites":["reward-prediction-error"]},{"slug":"axon-guidance-molecular-mechanism","title_ko":"축삭유도 분자기전","title_en":"Molecular Mechanism of Axon Guidance","meaning":"성장하는 축삭 말단의 성장원뿔이 유인 및 반발성 유도 분자들의 농도 기울기를 감지하여 정확한 표적까지 경로를 찾아가는…","subcategory":"신경세포·전달물질","level":3,"related":[],"prerequisites":[],"aliases":["MMAG","축삭유도분자기전"]},{"slug":"systems-consolidation-theory","title_ko":"시스템수준 기억공고화 이론","title_en":"Systems Consolidation Theory","meaning":"새로운 기억이 처음에는 해마에 의존하지만, 시간이 지나면서 점진적으로 대뇌피질 등 다른 뇌 영역으로 재조직되어 해마 의존성이…","subcategory":"인지신경과학","level":3,"related":[],"prerequisites":[],"aliases":["시스템수준기억공고화이론"]},{"slug":"excitotoxicity-cascade","title_ko":"흥분독성 연쇄반응","title_en":"Excitotoxicity Cascade","meaning":"과도한 글루탐산 자극이 NMDA 수용체를 통한 대량의 칼슘 유입을 일으키고, 이것이 미토콘드리아 기능 이상과 여러 분해효소…","subcategory":"신경질환","level":3,"related":[],"prerequisites":[],"aliases":["흥분독성연쇄반응"]},{"slug":"dynamical-systems-theory-brain","title_ko":"뇌의 동역학계 이론","title_en":"Dynamical Systems Theory of Brain Function","meaning":"뇌의 신경 활동을 고정된 정보처리 회로가 아니라, 시간에 따라 상태가 연속적으로 변화하는 동역학계로 간주하고 끌개, 분기…","subcategory":"인지신경과학","level":3,"related":["central-pattern-generator"],"prerequisites":[],"aliases":["DSTBF","뇌의동역학계이론"]},{"slug":"neurofilament","title_ko":"신경미세섬유","title_en":"neurofilament","meaning":"뉴런의 축삭 내부를 채우며 굵기와 구조적 안정성을 유지해주는 세포골격 단백질입니다.","subcategory":"신경세포·전달물질","level":2,"related":[],"prerequisites":[],"aliases":["NfL","뉴로필라멘트"]},{"slug":"aquaporin","title_ko":"아쿠아포린","title_en":"Aquaporin","meaning":"물 분자만 선택적으로 빠르게 통과시키는 세포막의 통로 단백질입니다.","subcategory":"신경세포·전달물질","level":2,"related":["local-field-potential","patch-clamp"],"prerequisites":[]},{"slug":"geci","title_ko":"유전 부호화 칼슘 지시약","title_en":"GECI","meaning":"세포가 유전자를 통해 스스로 만들어내는, 칼슘 농도에 따라 밝기가 바뀌는 형광단백질 센서입니다.","subcategory":"신경영상·측정기법","level":3,"related":["patch-clamp","action-potential"],"prerequisites":["patch-clamp"],"aliases":["유전부호화칼슘지시약"]},{"slug":"angiogenesis","title_ko":"혈관신생","title_en":"angiogenesis","meaning":"이미 있는 혈관에서 새로운 가지가 뻗어나와 혈관망이 넓어지는 과정입니다.","subcategory":"세포·분자생물학","level":2,"related":[],"prerequisites":[],"aliases":["안지오제네시스"]},{"slug":"rheobase","title_ko":"기전류","title_en":"rheobase","meaning":"뉴런이 첫 스파이크를 일으키는 데 필요한 최소 전류량으로, 뉴런 자체의 내재적 흥분성을 나타내는 지표.","subcategory":"신경세포·전달물질","level":3,"related":["patch-clamp"],"prerequisites":[],"aliases":["레오베이스"]},{"slug":"outcome-expectancy","title_ko":"결과 기대","title_en":"Outcome Expectancy","meaning":"'이 행동을 하면 어떤 결과가 따라올까'를 사전에 예측하는 뇌의 내부 표상으로, 행동을 시작할지 말지를 결정하는 데 쓰입니다.","subcategory":"인지신경과학","level":2,"related":[],"prerequisites":[],"aliases":["결과기대"]},{"slug":"glutamate-transporter-glt1","title_ko":"글루타메이트 수송체 GLT-1 (EAAT2)","title_en":"Glutamate Transporter-