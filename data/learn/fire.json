[],"aliases":["DCCA"]},{"slug":"disaster-carbon-footprint","title_ko":"재난 탄소발자국","title_en":"Disaster Carbon Footprint","meaning":"재난 대응과 복구 과정에서 배출되는 온실가스의 총량을 의미하는 개념이다.","subcategory":"재난경제·방재공학","level":2,"related":["climate-change-adaptation-disaster"],"prerequisites":[],"aliases":["재난탄소발자국"]},{"slug":"epidemiological-surveillance-disaster","title_ko":"재난역학감시","title_en":"Disaster Epidemiological Surveillance","meaning":"재난 발생 이후 감염병이나 부상, 질병 등 건강 관련 지표를 체계적으로 수집하고 분석하여 조기에 이상 징후를 파악하는…","subcategory":"재난 대응","level":2,"related":[],"prerequisites":[]},{"slug":"antimicrobial-resistance-crisis","title_ko":"항생제내성위기","title_en":"Antimicrobial Resistance Crisis","meaning":"세균 등 병원체가 항생제에 대한 저항성을 널리 획득하여 기존 치료법이 듣지 않게 되는 공중보건 위기 상황을 말한다.","subcategory":"인위·사회재난","level":2,"related":["water-scarcity-crisis","disaster-refugee-camp-management"],"prerequisites":[]},{"slug":"water-scarcity-crisis","title_ko":"물부족위기","title_en":"Water Scarcity Crisis","meaning":"특정 지역에서 이용 가능한 물의 양이 수요를 충족하지 못해 생활, 농업, 산업 전반에 위기가 발생하는 상황을 말한다.","subcategory":"인위·사회재난","level":2,"related":["disaster-refugee-camp-management","antimicrobial-resistance-crisis"],"prerequisites":[]},{"slug":"disaster-refugee-camp-management","title_ko":"재난난민캠프관리","title_en":"Disaster Refugee Camp Management","meaning":"재난이나 분쟁으로 거처를 잃은 사람들이 임시로 머무는 캠프의 운영, 안전, 생활 여건을 계획하고 관리하는 활동을 말한다.","subcategory":"재난 대응","level":2,"related":["water-scarcity-crisis"],"prerequisites":[],"aliases":["DRCM"]},{"slug":"disaster-network-analysis","title_ko":"재난네트워크분석","title_en":"Disaster Network Analysis","meaning":"재난 관련 시설, 조직, 정보 흐름 등을 노드와 연결선으로 표현하여 그 구조적 특성과 취약점을 분석하는 방법론이다.","subcategory":"재난정보시스템·공간정보","level":2,"related":["agent-based-modeling-disaster"],"prerequisites":[]},{"slug":"agent-based-modeling-disaster","title_ko":"행위자기반모델링","title_en":"Disaster Agent-Based Modeling","meaning":"개별 사람이나 조직을 각자 판단하고 행동하는 독립적인 행위자로 컴퓨터상에 표현하여, 이들의 상호작용을 통해 재난 상황에서의…","subcategory":"재난정보시스템·공간정보","level":2,"related":["traffic-microsi