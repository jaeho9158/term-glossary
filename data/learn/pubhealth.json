[{"slug":"p-value","title_ko":"유의확률","title_en":"p-value","meaning":"지금 관찰된 결과가 \"우연히\" 나왔을 가능성이 얼마나 되는지를 나타내는 숫자입니다.","subcategory":"추론통계·가설검정","level":1,"related":["significance-level","confidence-interval","effect-size","correlation","sample-size","cox-proportional-hazards-model"],"prerequisites":[],"pop":6,"aliases":["p값","P값"]},{"slug":"confidence-interval","title_ko":"신뢰구간","title_en":"Confidence Interval","meaning":"연구에서 추정한 값이 \"이 범위 안에 있을 가능성이 높다\"고 말할 수 있는 구간입니다.","subcategory":"추론통계·가설검정","level":1,"related":["p-value","sample-size","significance-level","regression","meta-analysis","cox-proportional-hazards-model"],"prerequisites":[],"aliases":["CI","신뢰도구간"]},{"slug":"cohort-study","title_ko":"코호트연구","title_en":"Cohort Study","meaning":"특정 공통점을 가진 사람들의 집단(코호트)을 오랜 기간 추적 관찰하며 특정 요인과 결과 사이의 관계를 살펴보는 연구…","subcategory":"연구설계","level":1,"related":["randomized-controlled-trial","control-group","case-control-study","confounding-variable"],"prerequisites":[],"pop":4,"aliases":["코호트","전향적코호트","코호트 조사"]},{"slug":"moral-hazard","title_ko":"도덕적 해이","title_en":"Moral Hazard","meaning":"위험이나 결과를 다른 사람(보험자, 계약 상대방 등)이 대신 부담하게 되면서, 그 사람이 원래보다 부주의하거나 위험한 행동을…","subcategory":"미시경제","level":1,"related":["human-capital","adverse-selection","game-theory","transaction-cost","information-asymmetry"],"prerequisites":[],"aliases":["도덕적 해이(보험)","도덕적해이(보험)"]},{"slug":"case-control-study","title_ko":"환자-대조군 연구","title_en":"Case-Control Study","meaning":"이미 특정 질병이 발생한 환자군과 발생하지 않은 대조군을 비교하여, 과거의 노출 요인에 어떤 차이가 있었는지 거슬러 조사하는…","subcategory":"역학·공중보건","level":1,"related":["cohort-study","odds-ratio","control-group","confounding-variable"],"prerequisites":[],"aliases":["환자대조군연구","환자 대조군연구","케이스컨트롤","환자대조연구"]},{"slug":"odds-ratio","title_ko":"교차비(오즈비)","title_en":"Odds Ratio","meaning":"어떤 요인에 노출된 집단과 노출되지 않은 집단에서 특정 사건이 일어날 \"오즈(odds, 성공 대 실패의 비)\"를 비교하여…","subcategory":"역학·공중보건","level":1,"related":["case-control-study","sensitivity-specificity","logistic-regression"],"prerequisites":[],"pop":8,"aliases":["OR","오즈비"]},{"slug":"sensitivity-specificity","title_ko":"민감도와 특이도","title_en":"Sensitivity and Specificity","meaning":"진단 검사가 실제 병이 있는 사람을 얼마나 잘 찾아내는지(민감도)와, 병이 없는 사람을 얼마나 정확히 걸러내는지(특이도)를…","subcategory":"진단·검사","level":1,"related":["biomarker","clinical-trial","odds-ratio","elisa","positive-predictive-value","confidence-interval"],"prerequisites":[],"aliases":["민감도 특이도"]},{"slug":"adverse-selection","title_ko":"역선택","title_en":"Adverse Selection","meaning":"거래 전에 한쪽만 중요한 정보를 알고 있어서, 결과적으로 상대에게 불리한 유형의 거래 상대만 시장에 남게 되는 현상입니다.","subcategory":"미시경제","level":1,"related":["moral-hazard","externality","game-theory","transaction-cost","information-asymmetry","signaling-theory"],"prerequisites":[]},{"slug":"hazard-ratio","title_ko":"위험비","title_en":"Hazard Ratio","meaning":"시간이 흐르는 동안 특정 사건(사망, 재발 등)이 매 순간 발생할 위험이 두 집단 사이에서 몇 배 차이 나는지를 나타내는…","subcategory":"역학·공중보건","level":1,"related":["medication-adherence"],"prerequisites":[],"pop":17,"aliases":["HR"]},{"slug":"propensity-score-matching","title_ko":"성향점수매칭","title_en":"Propensity Score Matching","meaning":"무작위 실험이 아닌 관찰자료에서, 처치를 받을 확률(성향점수)이 비슷한 사람들끼리 짝을 지어 비교함으로써 처치의 효과를…","subcategory":"미시경제","level":2,"related":["regression-discontinuity-design","confounding-variable","bounded-rationality"],"prerequisites":["regression-discontinuity-design"],"pop":2,"aliases":["PSM"]},{"slug":"quality-adjusted-life-year","title_ko":"질보정생존년(QALY)","title_en":"Quality-Adjusted Life Year","meaning":"치료나 정책이 사람을 얼마나 더 오래, 그리고 얼마나 더 건강한 삶의 질로 살게 해주는지를 하나의 숫자로 합쳐 나타낸…","subcategory":"역학·공중보건","level":1,"related":[],"prerequisites":[],"pop":13,"aliases":["QALY","질보정생존년수"]},{"slug":"confounding-variable","title_ko":"교란변수","title_en":"Confounding Variable","meaning":"원인과 결과 둘 다에 영향을 미쳐서, 둘 사이에 진짜 관계가 없어도 있는 것처럼 보이게 만드는 숨은 제3의 변수입니다.","subcategory":"역학·공중보건","level":1,"related":["propensity-score-matching","surrogate-endpoint","cohort-study","case-control-study"],"prerequisites":[],"pop":19,"aliases":["교란요인"]},{"slug":"forest-plot","title_ko":"포레스트플롯","title_en":"Forest Plot","meaning":"메타분석에 포함된 여러 개별 연구의 효과크기와 신뢰구간을 한 줄씩 나란히 그려, 전체 결과를 한눈에 비교할 수 있게 만든…","subcategory":"역학·공중보건","level":2,"related":["meta-analysis","confidence-interval","effect-size"],"prerequisites":[]},{"slug":"ecological-fallacy","title_ko":"생태학적 오류","title_en":"Ecological Fallacy","meaning":"집단 단위로 관찰된 통계적 관계를, 그 집단에 속한 개별 구성원에게도 똑같이 적용될 것이라 잘못 추론하는 오류입니다.","subcategory":"연구설계","level":1,"related":["internal-validity","cross-sectional-study","area-deprivation-index"],"prerequisites":[],"pop":1,"aliases":["생태학적 오류의 오류"]},{"slug":"cox-proportional-hazards-model","title_ko":"콕스 비례위험모형","title_en":"Cox Proportional Hazards Model","meaning":"여러 변수가 사건이 일어날 위험(위험률)에 얼마나 영향을 미치는지, 그리고 그 영향이 시간에 따라 어떻게 달라지는지를 함께…","subcategory":"다변량·고급기법","level":1,"related":["confidence-interval","kaplan-meier-estimator"],"prerequisites":[],"aliases":["콕스 회귀","Cox regression","비례위험모형","hazard ratio model","Cox모형","콕스회귀"]},{"slug":"recall-bias","title_ko":"회상편향","title_en":"Recall Bias","meaning":"참여자가 과거 경험을 회상해 응답할 때 현재 상태에 따라 기억의 정확도나 상세함이 체계적으로 달라져 생기는 편향이다.","subcategory":"데이터수집·표본","level":1,"related":["non-response-bias","attrition-bias","internal-validity"],"prerequisites":[],"aliases":["기억편향"]},{"slug":"kaplan-meier-estimator","title_ko":"카플란-마이어 추정법","title_en":"Kaplan-Meier Estimator","meaning":"관찰이 도중에 중단된 대상자가 있어도 시간에 따른 생존확률을 계단 모양의 그래프로 추정하는 비모수적 통계 방법입니다.","subcategory":"다변량·고급기법","level":1,"related":["cox-proportional-hazards-model","confidence-interval"],"prerequisites":[],"pop":16,"aliases":["카플란-마이어 생존곡선","생존곡선 추정법","KM곡선","카플란마이어"]},{"slug":"wakefield-mmr-scandal","title_ko":"웨이크필드 MMR 백신 사건","title_en":"Wakefield MMR Vaccine Scandal","meaning":"1998년 앤드루 웨이크필드가 MMR 백신과 자폐증의 연관성을 조작된 데이터로 주장해 논문이 철회되고 의사 면허가 박탈된…","subcategory":"연구윤리 원칙","level":3,"related":["data-fabrication","retraction","conflict-of-interest"],"prerequisites":["data-fabrication"],"aliases":["웨이크필드 사건","MMR 백신 스캔들","WMVS","웨이크필드MMR백신사건"]},{"slug":"multiple-imputation","title_ko":"다중대체법","title_en":"Multiple Imputation","meaning":"결측치를 하나의 값으로 메우는 대신, 불확실성을 반영해 여러 개의 그럴듯한 값으로 채운 뒤 각각 분석하고 결과를 하나로…","subcategory":"다변량·고급기법","level":2,"related":["missing-data","bootstrap-resampling","confidence-interval"],"prerequisites":["missing-data","bootstrap-resampling"],"aliases":["MICE","다중대체","연쇄방정식 다중대체법","Multiple Imputation for Missing Data","MIMD"]},{"slug":"health-belief-model","title_ko":"건강신념모델(건강신념모형)","title_en":"Health Belief Model","meaning":"사람들이 질병 위험을 어떻게 지각하고 예방행동의 이익과 장애물을 어떻게 저울질하는지에 따라 건강행동 실천 여부가 결정된다고…","subcategory":"사회심리","level":3,"related":["self-efficacy"],"prerequisites":[],"pop":20,"aliases":["HBM","건강신념모형"]},{"slug":"policy-diffusion","title_ko":"정책확산","title_en":"Policy Diffusion","meaning":"한 지역이나 국가에서 채택된 정책이 이웃 지역이나 다른 국가로 점차 퍼져나가는 현상.","subcategory":"정치·정책","level":3,"related":["new-public-management","welfare-state"],"prerequisites":["new-public-management","welfare-state"],"aliases":["정책 확산 이론"]},{"slug":"frailty-index","title_ko":"노쇠지수","title_en":"Frailty Index","meaning":"질병, 신체 기능 저하, 인지 문제 등 수십 가지 건강 \"결손\" 항목 중 환자가 가진 항목의 비율을 계산해 노쇠 정도를…","subcategory":"진단·검사","level":2,"related":["multimorbidity","clinical-frailty-scale"],"prerequisites":[],"pop":7,"aliases":["결손누적지수","프레일티인덱스","허약지수"]},{"slug":"metabolic-syndrome","title_ko":"대사증후군","title_en":"Metabolic Syndrome","meaning":"복부비만, 높은 혈압, 높은 혈당, 이상지질혈증 중 세 가지 이상이 한 사람에게 동시에 나타나는 상태를 말합니다.","subcategory":"질병·병리","level":1,"related":["biomarker"],"prerequisites":[],"aliases":["대사성증후군","인슐린저항성증후군"]},{"slug":"levels-of-prevention","title_ko":"예방의학의 3단계","title_en":"Levels of Prevention","meaning":"질병을 막거나 그 피해를 줄이기 위한 보건의료 활동을, 개입하는 시점에 따라 일차예방·이차예방·삼차예방 세 단계로 나눈…","subcategory":"역학·공중보건","level":3,"related":[],"prerequisites":[],"aliases":["예방의학의3단계"]},{"slug":"daly","title_ko":"장애보정생존년수","title_en":"DALY","meaning":"어떤 질병이나 부상 때문에 일찍 사망해서 잃은 수명과, 아파서 온전하지 못하게 산 기간을 하나로 합쳐 \"건강하게 살지 못한…","subcategory":"역학·공중보건","level":3,"related":["quality-adjusted-life-year"],"prerequisites":["quality-adjusted-life-year"]},{"slug":"social-cognitive-theory","title_ko":"사회인지이론","title_en":"Social Cognitive Theory","meaning":"개인의 인지(생각), 행동, 주변 환경이 서로 영향을 주고받으며 성격과 행동을 형성한다고 보는 반두라(Bandura)의…","subcategory":"사회심리","level":3,"related":["self-efficacy","attribution-theory","health-belief-model"],"prerequisites":["attribution-theory"]},{"slug":"person-time","title_ko":"인년","title_en":"Person-Time","meaning":"연구에 참여한 사람 수와 각자가 추적관찰된 기간을 곱해서 더한, 발생률 계산의 분모로 쓰이는 값입니다.","subcategory":"역학·공중보건","level":3,"related":["cohort-study"],"prerequisites":[],"pop":15},{"slug":"maternal-mortality-ratio","title_ko":"모성사망비","title_en":"Maternal Mortality Ratio","meaning":"출생아 10만 명당 임신·출산과 관련된 원인으로 사망한 여성의 수를 나타내는 지표입니다.","subcategory":"역학·공중보건","level":3,"related":[],"prerequisites":[],"pop":9},{"slug":"institutional-review-board","title_ko":"기관생명윤리위원회(IRB)","title_en":"Institutional Review Board","meaning":"연구 참여자의 권리와 안전, 윤리적 타당성을 심사하고 승인하는 기관 내 독립 위원회.","subcategory":"역학·공중보건","level":2,"related":["case-report-form","data-safety-monitoring-board"],"prerequisites":[],"pop":3,"aliases":["기관생명윤리위원회"]},{"slug":"case-report-form","title_ko":"증례기록서(CRF)","title_en":"Case Report Form","meaning":"임상시험에서 각 참여자에 대해 수집한 데이터를 정해진 양식에 따라 기록하는 표준화된 문서.","subcategory":"역학·공중보건","level":2,"related":["institutional-review-board","data-safety-monitoring-board"],"prerequisites":[],"pop":11,"aliases":["증례기록서"]},{"slug":"serious-adverse-event","title_ko":"중대한 이상반응(SAE)","title_en":"Serious Adverse Event","meaning":"임상시험 중 발생한 사건 중 사망, 생명을 위협하는 상태, 입원 또는 입원 연장, 영구적 장애 등을 초래하는 이상반응.","subcategory":"역학·공중보건","level":1,"related":["data-safety-monitoring-board"],"prerequisites":[],"aliases":["중대한 이상반응","중대한이상반응","중대한이상반응(SAE)"]},{"slug":"sample-size-calculation","title_ko":"표본크기산출","title_en":"Sample Size Calculation","meaning":"연구에서 통계적으로 의미 있는 결과를 검출하는 데 필요한 최소한의 참여자 수를 연구 설계 단계에서 미리 계산하는 절차.","subcategory":"역학·공중보건","level":2,"related":["non-inferiority-trial"],"prerequisites":[],"aliases":["표본수산정","표본크기계산"]},{"slug":"beers-criteria","title_ko":"비어스 기준","title_en":"Beers Criteria","meaning":"노인 환자에게 잠재적으로 부적절하거나 위해가 이득을 초과할 수 있는 약물 목록을 정리해 처방 시 참고하도록 만든 전문가 합의…","subcategory":"발달·생애주기건강","level":1,"related":["potentially-inappropriate-medication-elderly"],"prerequisites":[],"pop":14,"aliases":["비어스리스트"]},{"slug":"health-equity-vs-equality","title_ko":"건강 형평성과 균등성의 차이","title_en":"Health Equity vs. Health Equality","meaning":"균등성은 모두에게 동일한 자원을 제공하는 것을, 형평성은 필요와 처지가 다른 집단에 맞게 자원을 차등 배분해 결과의 공정함을…","subcategory":"역학·공중보건","level":2,"related":[],"prerequisites":[],"aliases":["HEVHE","건강형평성과균등성의차이"]},{"slug":"weathering-hypothesis","title_ko":"풍화 가설","title_en":"Weathering Hypothesis","meaning":"만성적인 사회경제적 스트레스와 차별에 지속적으로 노출된 결과 신체가 조기에 생물학적으로 노화하여 건강이 악화된다는 가설.","subcategory":"역학·공중보건","level":3,"related":["allostatic-load"],"prerequisites":[]},{"slug":"food-desert-concept","title_ko":"식품사막 개념","title_en":"Food Desert Concept","meaning":"신선하고 건강한 식품을 합리적인 가격과 거리에서 구하기 어려운 지역을 지칭하는 개념으로, 식생활 불평등의 공간적 측면을…","subcategory":"역학·공중보건","level":2,"related":[],"prerequisites":[],"aliases":["식품사막개념"]},{"slug":"hormesis","title_ko":"호르메시스","title_en":"Hormesis","meaning":"저용량에서는 자극적이거나 유익한 효과를, 고용량에서는 억제적이거나 유해한 효과를 나타내는 이상형(U자 또는 역U자형)…","subcategory":"역학·공중보건","level":3,"related":["dose-response-relationship","no-observed-adverse-effect-level"],"prerequisites":["dose-response-relationship"],"pop":12},{"slug":"occupational-exposure-limit","title_ko":"작업장 노출기준(OEL)","title_en":"Occupational Exposure Limit","meaning":"노동자가 유해물질에 반복적으로 노출되어도 건강에 유해한 영향을 일으키지 않는다고 간주되는 작업환경 중 최대 허용 농도.","subcategory":"역학·공중보건","level":3,"related":[],"prerequisites":[],"aliases":["작업장노출기준","작업환경노출기준","OEL","노출기준"]},{"slug":"positive-predictive-value","title_ko":"양성예측도","title_en":"Positive Predictive Value (PPV)","meaning":"검사에서 양성으로 나온 사람 중 실제로 질병이 있는 사람의 비율로, 질병의 유병률에 따라 값이 크게 달라지는 지표이다.","subcategory":"임상화학·혈액학검사","level":2,"related":["sensitivity","specificity","roc-curve","sensitivity-specificity","confidence-interval"],"prerequisites":["sensitivity","specificity"],"pop":18,"aliases":["PPV","양성적중률","Positive Predictive Value"]},{"slug":"low-birth-weight","title_ko":"저체중출생아","title_en":"Low Birth Weight","meaning":"출생 시 체중이 국제적으로 정해진 기준(일반적으로 2.5kg 미만)보다 적게 태어난 신생아를 말합니다.","subcategory":"생애주기영양","level":2,"related":[],"prerequisites":[]},{"slug":"diagnosis-related-group-payment","title_ko":"진단명기준환자군","title_en":"Diagnosis-Related Group","meaning":"진단명기준환자군은 진단명, 시술, 나이 등 임상적 특성이 비슷한 환자들을 하나의 그룹으로 묶어 정해진 금액을 지급하는 의료비…","subcategory":"보건경제학","level":2,"related":[],"prerequisites":[]},{"slug":"primary-health-care","title_ko":"일차보건의료","title_en":"Primary Health Care","meaning":"지역사회에서 국민이 처음 접하는 필수적이고 보편적인 보건의료 서비스로, 예방·치료·건강증진을 통합적으로 제공하는 접근…","subcategory":"보건의료체계","level":2,"related":[],"prerequisites":[],"aliases":["PHC","일차의료"]},{"slug":"burden-of-mental-illness","title_ko":"정신질환부담","title_en":"Burden of Mental Illness","meaning":"정신질환이 개인과 사회에 초래하는 건강 손실, 기능 저하, 경제적 비용 등을 총체적으로 나타내는 개념입니다.","subcategory":"정신보건","level":2,"related":["substance-use-disorder-treatment"],"prerequisites":[],"aliases":["Burden of Mental Illness"]},{"slug":"community-health-worker-program","title_ko":"지역사회보건요원 프로그램","title_en":"Community Health Worker Program","meaning":"해당 지역사회 출신이거나 지역사회와 밀접한 관계를 가진 요원을 훈련시켜 보건교육, 예방, 상담, 의료연계 등을 수행하도록…","subcategory":"보건의료체계","level":2,"related":[],"prerequisites":[],"aliases":["Community Health Worker Program","CHWP","지역사회보건요원프로그램"]},{"slug":"heat-related-illness-surveillance","title_ko":"온열질환 감시체계","title_en":"Heat-Related Illness Surveillance","meaning":"폭염 등으로 인한 열사병, 열탈진 같은 온열질환 발생 현황을 지속적으로 파악하고 대응하기 위한 감시체계입니다.","subcategory":"환경보건","level":2,"related":["particulate-matter-exposure"],"prerequisites":[],"aliases":["Heat-Related Illness Surveillance","HRIS","온열질환감시체계"]},{"slug":"particulate-matter-exposure","title_ko":"미세먼지 노출","title_en":"Particulate Matter Exposure","meaning":"대기 중에 떠다니는 미세한 입자상 물질에 사람이 호흡 등을 통해 접촉되는 정도를 말합니다.","subcategory":"환경보건","level":2,"related":["heat-related-illness-surveillance"],"prerequisites":[],"aliases":["Particulate Matter Exposure","미세먼지노출"]},{"slug":"perinatal-mortality-rate","title_ko":"주산기사망률","title_en":"Perinatal Mortality Rate","meaning":"주산기사망률은 임신 후반기의 태아 사망과 출생 직후 신생아 사망을 합하여 일정 출생아 수 대비 비율로 나타낸 지표입니다.","subcategory":"모자보건","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["Perinatal Mortality Rate"]},{"slug":"precede-proceed-model","title_ko":"프리시드-프로시드 모형","title_en":"PRECEDE-PROCEED Model","meaning":"건강증진 프로그램을 기획할 때 원인 진단부터 실행, 평가까지 단계별로 밟아가도록 설계된 대표적인 보건교육 기획 모형입니다.","subcategory":"보건교육 및 건강증진","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["PRECEDE-PROCEED Model","프리시드 프로시드 모형","프리시드-프로시드모형","프리시드프로시드 모형"]},{"slug":"substance-use-disorder-treatment","title_ko":"물질사용장애 치료","title_en":"Substance Use Disorder Treatment","meaning":"알코올, 마약류 등 물질에 대한 의존과 남용 문제를 해결하기 위한 의학적·심리사회적 개입 전반을 말합니다.","subcategory":"정신보건","level":2,"related":["burden-of-mental-illness"],"prerequisites":[],"aliases":["Substance Use Disorder Treatment","SUDT","물질사용장애치료"]},{"slug":"water-quality-monitoring-health","title_ko":"수질 건강모니터링","title_en":"Water Quality Monitoring for Health","meaning":"먹는물이나 생활용수의 수질을 정기적으로 검사하여 건강에 해로운 오염물질이나 병원체를 감시하는 활동입니다.","subcategory":"환경보건","level":2,"related":[],"prerequisites":[],"aliases":["Water Quality Monitoring for Health","WQMH","수질건강모니터링"]},{"slug":"area-deprivation-index","title_ko":"지역박탈지수","title_en":"Area Deprivation Index","meaning":"소득, 교육, 주거, 고용 등 여러 사회경제적 지표를 종합하여 특정 지역의 상대적 박탈 수준을 나타내는 지수입니다.","subcategory":"사회역학","level":2,"related":[],"prerequisites":[],"aliases":["Area Deprivation Index"]},{"slug":"triage-system-mass-casualty","title_ko":"대량환자 중증도분류(재해환자중증도분류)","title_en":"Mass Casualty Triage","meaning":"재난이나 대형사고로 다수의 환자가 동시에 발생했을 때, 제한된 의료자원을 가장 효과적으로 활용하기 위해 부상의 중증도에 따라…","subcategory":"재난 및 응급보건","level":2,"related":[],"prerequisites":[],"aliases":["Mass Casualty Triage","대량환자중증도분류","재해환자중증도분류"]}]