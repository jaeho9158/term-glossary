[{"slug":"descent","title_ko":"출계","title_en":"Descent","meaning":"조상으로부터 후손에게로 사회적으로 인정된 계보를 따라 소속과 권리, 지위가 전달되는 원리를 말합니다.","subcategory":"친족 연구","level":2,"related":["clan"],"prerequisites":[]},{"slug":"clan","title_ko":"씨족","title_en":"Clan","meaning":"구체적인 계보를 일일이 추적할 수는 없지만 공통의 조상(또는 상징적 시조)으로부터 유래했다고 믿는 사람들로 이루어진 친족…","subcategory":"친족 연구","level":2,"related":["descent"],"prerequisites":[]},{"slug":"cross-cousin-marriage","title_ko":"교차사촌혼","title_en":"Cross-Cousin Marriage","meaning":"교차사촌혼은 어머니의 남자 형제의 자녀 또는 아버지의 여자 형제의 자녀, 즉 성별이 다른 형제자매의 자녀끼리 결혼하는 친족…","subcategory":"친족 연구","level":2,"related":["bridewealth"],"prerequisites":[]},{"slug":"bridewealth","title_ko":"신부대","title_en":"Bridewealth","meaning":"신부대는 결혼 시 신랑 측 친족이 신부 측 친족에게 재화나 가축, 노동력 등을 전달하는 관행으로, 두 친족 집단 사이의…","subcategory":"친족 연구","level":2,"related":["cross-cousin-marriage"],"prerequisites":[],"aliases":["신부재"]},{"slug":"deterritorialization","title_ko":"탈영토화","title_en":"Deterritorialization","meaning":"문화적 정체성이나 사회적 관계가 특정한 지리적 영토와의 고정된 결합에서 풀려나 이동성 속에서 재구성되는 현상을 가리키는…","subcategory":"이주와 디아스포라","level":2,"related":[],"prerequisites":[],"pop":5},{"slug":"structural-violence","title_ko":"구조적 폭력","title_en":"Structural Violence","meaning":"특정 개인의 직접적인 폭력이 아니라, 빈곤, 불평등, 제도적 차별처럼 사회구조 자체가 사람들에게 가하는 눈에 보이지 않는…","subcategory":"의료인류학","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["구조적폭력"]},{"slug":"commodity-fetishism","title_ko":"상품물신주의","title_en":"Commodity Fetishism","meaning":"상품이 만들어지기까지의 인간 노동과 사회적 관계가 가려지고, 상품 자체가 마치 스스로 가치를 지닌 것처럼 여겨지는 현상을…","subcategory":"물질문화","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["물신주의","상품물신성"]},{"slug":"ghettoization-anthropology","title_ko":"게토화","title_en":"Ghettoization","meaning":"특정 소수집단이나 빈곤층이 사회적, 경제적, 제도적 배제로 인해 도시의 특정 지역에 집중적으로 격리되어 살게 되는 과정을…","subcategory":"도시인류학","level":2,"related":[],"prerequisites":[],"pop":1},{"slug":"carnivalesque-bakhtin","title_ko":"카니발레스크","title_en":"Carnivalesque","meaning":"카니발레스크는 문학이론가 미하일 바