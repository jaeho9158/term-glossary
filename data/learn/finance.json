[{"slug":"moral-hazard","title_ko":"도덕적 해이","title_en":"Moral Hazard","meaning":"위험이나 결과를 다른 사람(보험자, 계약 상대방 등)이 대신 부담하게 되면서, 그 사람이 원래보다 부주의하거나 위험한 행동을…","subcategory":"미시경제","level":1,"related":["human-capital","adverse-selection","game-theory","transaction-cost","information-asymmetry"],"prerequisites":[],"aliases":["도덕적 해이(보험)","도덕적해이(보험)"]},{"slug":"adverse-selection","title_ko":"역선택","title_en":"Adverse Selection","meaning":"거래 전에 한쪽만 중요한 정보를 알고 있어서, 결과적으로 상대에게 불리한 유형의 거래 상대만 시장에 남게 되는 현상이다.","subcategory":"미시경제","level":1,"related":["moral-hazard","externality","game-theory","transaction-cost","information-asymmetry","signaling-theory"],"prerequisites":[],"pop":5},{"slug":"availability-heuristic","title_ko":"가용성 휴리스틱","title_en":"Availability Heuristic","meaning":"어떤 사건의 실제 발생 빈도보다, 그 사건이 머릿속에 얼마나 쉽게 떠오르는지를 기준으로 확률을 판단하는 사고방식이다.","subcategory":"인지심리","level":1,"related":["anchoring-effect","working-memory","bystander-effect","emotional-intelligence","representativeness-heuristic"],"prerequisites":[],"pop":18,"aliases":["이용가능성 휴리스틱"]},{"slug":"information-asymmetry","title_ko":"정보 비대칭","title_en":"Information Asymmetry","meaning":"거래에 참여하는 당사자들이 서로 다른 양의 정보를 가지고 있어서, 한쪽이 다른 쪽보다 더 많이 아는 상황을 말한다.","subcategory":"미시경제","level":1,"related":["rent-seeking","bounded-rationality","adverse-selection","moral-hazard","signaling-theory"],"prerequisites":[],"pop":2,"aliases":["Asymmetric Information (Real Estate)"]},{"slug":"signaling-theory","title_ko":"신호 이론","title_en":"Signaling Theory","meaning":"정보를 가진 쪽이 자신의 숨겨진 능력이나 품질을 상대방에게 믿을 만하게 전달하기 위해, 비용이 드는 행동(신호)을 이용하는…","subcategory":"미시경제","level":1,"related":["information-asymmetry","adverse-selection","moral-hazard"],"prerequisites":[],"pop":8,"aliases":["신호이론","시그널링 이론","Signaling Theory in Education"]},{"slug":"modified-internal-rate-of-return","title_ko":"수정내부수익률","title_en":"Modified Internal Rate of Return (MIRR)","meaning":"투자안에서 발생하는 현금유입을 자본비용으로 재투자한다는 현실적 가정을 적용하여 계산한 수익률로, 기존 IRR의 비현실적…","subcategory":"기업재무·자본구조이론","level":3,"related":["net-present-value"],"prerequisites":[],"aliases":["MIRR"]},{"slug":"decision-tree-analysis","title_ko":"의사결정나무분석","title_en":"Decision Tree Analysis","meaning":"투자안 실행 과정에서 발생할 수 있는 여러 의사결정 시점과 불확실한 사건들을 나뭇가지 형태의 도식으로 표현하여, 각 경로의…","subcategory":"기업재무·자본구조이론","level":3,"related":[],"prerequisites":[],"pop":9,"aliases":["의사결정트리"]},{"slug":"free-cash-flow-to-firm","title_ko":"기업잉여현금흐름","title_en":"Free Cash Flow to Firm (FCFF)","meaning":"세후 영업이익에 감가상각 등 비현금비용을 더하고 설비투자와 순운전자본 증가분을 차감하여 산출한, 채권자와 주주 모두에게…","subcategory":"기업재무·자본구조이론","level":1,"related":["free-cash-flow-to-equity","depreciation"],"prerequisites":[],"aliases":["FCFF"]},{"slug":"free-cash-flow-to-equity","title_ko":"주주잉여현금흐름","title_en":"Free Cash Flow to Equity (FCFE)","meaning":"기업잉여현금흐름에서 채권자에게 지급되는 이자비용과 순차입 변동분을 반영하여 산출한, 오직 주주에게 귀속되는 잉여현금흐름으로…","subcategory":"기업재무·자본구조이론","level":1,"related":["free-cash-flow-to-firm"],"prerequisites":[],"aliases":["FCFE"]},{"slug":"adjusted-present-value","title_ko":"조정현재가치법","title_en":"Adjusted Present Value (APV)","meaning":"투자안을 전액 자기자본으로 조달했다고 가정했을 때의 기본 NPV에, 부채조달에 따른 이자비용 세금절감효과 등 재무적…","subcategory":"기업재무·자본구조이론","level":3,"related":["net-present-value","leveraged-buyout","free-cash-flow-to-firm"],"prerequisites":["leveraged-buyout"],"aliases":["APV"]},{"slug":"certainty-equivalent-method","title_ko":"확실성등가법","title_en":"Certainty Equivalent Method","meaning":"위험이 내포된 미래 현금흐름을 투자자가 무차별하게 여기는 확실한 현금흐름으로 변환한 뒤 무위험이자율로 할인하여 현재가치를…","subcategory":"기업재무·자본구조이론","level":3,"related":["net-present-value"],"prerequisites":[],"aliases":["확실성등가"]},{"slug":"equivalent-annual-cost","title_ko":"등가연간비용","title_en":"Equivalent Annual Cost (EAC)","meaning":"내용연수가 서로 다른 상호배타적 투자안을 비교할 때, 각 투자안의 현재가치를 매년 동일한 금액의 연금 형태로 환산하여 비교…","subcategory":"기업재무·자본구조이론","level":3,"related":["net-present-value"],"prerequisites":[],"aliases":["EAC"]},{"slug":"fama-french-three-factor-model","title_ko":"파마-프렌치3요인모형","title_en":"Fama-French Three-Factor Model","meaning":"시장위험요인에 더해 기업규모요인(SMB)과 가치요인(HML)을 추가하여 주식의 기대수익률을 설명하는 다요인…","subcategory":"기업재무·자본구조이론","level":3,"related":[],"prerequisites":[],"aliases":["FFTFM","파마 프렌치3요인모형","파마프렌치3요인모형"]},{"slug":"bond-yield-plus-risk-premium-approach","title_ko":"채권수익률가산법","title_en":"Bond-Yield-Plus-Risk-Premium Approach","meaning":"기업이 발행한 장기채권의 만기수익률에 주식이 채권보다 위험하다는 점을 반영한 추가 위험프리미엄을 더하여 자기자본비용을…","subcategory":"기업재무·자본구조이론","level":3,"related":[],"prerequisites":[]},{"slug":"bird-in-hand-theory","title_ko":"손안의새이론","title_en":"Bird-in-Hand Theory","meaning":"투자자는 불확실한 미래의 자본이득보다 현재 확정적으로 지급받는 배당을 더 선호하기 때문에, 배당성향이 높은 기업일수록 주주의…","subcategory":"기업재무·자본구조이론","level":3,"related":[],"prerequisites":[],"aliases":["수중의새이론"]},{"slug":"bonding-cost","title_ko":"확증비용","title_en":"Bonding Cost","meaning":"대리인이 자신이 위임자의 이익에 반하는 행동을 하지 않을 것이라는 신뢰를 스스로 입증하기 위해 자발적으로 지출하는 비용으로…","subcategory":"기업재무·자본구조이론","level":1,"related":["residual-loss"],"prerequisites":[]},{"slug":"residual-loss","title_ko":"잔여손실","title_en":"Residual Loss","meaning":"감시비용과 확증비용을 아무리 지출하더라도 대리인의 의사결정이 위임자의 이익을 완전히 극대화하는 수준과 여전히 차이가 남으로써…","subcategory":"기업재무·자본구조이론","level":2,"related":["bonding-cost"],"prerequisites":["bonding-cost"]},{"slug":"tobins-q","title_ko":"토빈의q","title_en":"Tobin's Q","meaning":"기업 자산의 시장가치를 그 자산의 대체원가로 나눈 비율로, 이 비율이 1보다 크면 기업이 자산을 새로 취득하는 비용보다…","subcategory":"기업재무·자본구조이론","level":3,"related":["book-value"],"prerequisites":[],"pop":17,"aliases":["q비율","토빈Q"]},{"slug":"leveraged-buyout","title_ko":"차입매수","title_en":"Leveraged Buyout (LBO)","meaning":"인수자가 인수대상 기업의 자산이나 미래현금흐름을 담보로 대규모 부채를 조달하여 상대적으로 적은 자기자본으로 기업을 인수하는…","subcategory":"기업재무·자본구조이론","level":2,"related":[],"prerequisites":[],"aliases":["LBO"]},{"slug":"weak-form-market-efficiency","title_ko":"약형효율적시장","title_en":"Weak-Form Market Efficiency","meaning":"현재 자산 가격에 과거의 모든 가격 및 거래량 정보가 이미 반영되어 있어, 과거 데이터를 이용한 기술적 분석으로는 초과수익을…","subcategory":"투자론·파생상품·금융시장","level":3,"related":["quantitative-trading"],"prerequisites":[],"aliases":["WFME"]},{"slug":"tobin-separation-theorem","title_ko":"토빈분리정리","title_en":"Tobin Separation Theorem","meaning":"모든 투자자가 위험자산 포트폴리오의 구성은 동일하게(접점포트폴리오; CAPM 균형에서는 시장포트폴리오) 선택하고, 개인의…","subcategory":"투자론·파생상품·금융시장","level":3,"related":[],"prerequisites":[],"aliases":["분리정리"]},{"slug":"gamma-option","title_ko":"감마","title_en":"Gamma","meaning":"기초자산 가격 변화에 대한 옵션 델타의 민감도, 즉 델타의 변화율을 나타내는 옵션 그릭스의 하나이다.","subcategory":"투자론·파생상품·금융시장","level":3,"related":["rho-option","implied-volatility"],"prerequisites":[],"pop":3},{"slug":"rho-option","title_ko":"로(옵션 그릭스)","title_en":"Rho","meaning":"무위험이자율의 변화에 대한 옵션가격의 민감도를 나타내는 옵션 그릭스의 하나로, 일반적으로 콜옵션은 양(+), 풋옵션은…","subcategory":"투자론·파생상품·금융시장","level":3,"related":["gamma-option","implied-volatility"],"prerequisites":[],"aliases":["로","로(옵션그릭스)","옵션 그릭스"]},{"slug":"implied-volatility","title_ko":"내재변동성","title_en":"Implied Volatility","meaning":"현재 시장에서 관측되는 옵션 가격을 옵션가격결정모형(예: 블랙숄즈모형)에 대입해 역산했을 때 도출되는 변동성 값으로…","subcategory":"투자론·파생상품·금융시장","level":1,"related":["rho-option","gamma-option"],"prerequisites":[],"aliases":["IV"]},{"slug":"exotic-option","title_ko":"이색옵션","title_en":"Exotic Option","meaning":"표준적인 콜옵션·풋옵션(바닐라옵션)과 달리 경로의존성, 복수 기초자산, 조건부 지급구조 등 비표준적인 특성을 가진 파생상품을…","subcategory":"투자론·파생상품·금융시장","level":3,"related":["rho-option","gamma-option"],"prerequisites":[],"aliases":["익조틱옵션"]},{"slug":"strangle-strategy","title_ko":"스트랭글전략","title_en":"Strangle Strategy","meaning":"동일한 만기를 가지되 서로 다른 행사가격의 외가격 콜옵션과 외가격 풋옵션을 동시에 매수(또는 매도)하여 스트래들보다 낮은…","subcategory":"투자론·파생상품·금융시장","level":1,"related":["implied-volatility"],"prerequisites":[]},{"slug":"callable-bond","title_ko":"콜옵션부채권","title_en":"Callable Bond","meaning":"발행자가 만기 이전 특정 시점에 미리 정해진 가격으로 채권을 조기상환할 수 있는 권리(콜옵션)를 가진 채권으로, 금리하락 시…","subcategory":"투자론·파생상품·금융시장","level":2,"related":[],"prerequisites":[],"aliases":["수의상환채권"]},{"slug":"bid-ask-spread","title_ko":"매수매도호가스프레드","title_en":"Bid-Ask Spread","meaning":"시장에서 매수자가 지불하고자 하는 최고가격(매수호가)과 매도자가 받고자 하는 최저가격(매도호가) 사이의 차이로, 즉시 거래를…","subcategory":"투자론·파생상품·금융시장","level":2,"related":["transaction-cost"],"prerequisites":[],"aliases":["매매호가스프레드","호가스프레드"]},{"slug":"local-bias","title_ko":"지역편향","title_en":"Local Bias","meaning":"투자자가 지리적으로 가까운 곳에 위치한 기업의 주식을 원거리 기업보다 상대적으로 더 많이 보유하는 경향으로, 자국편향의 국내…","subcategory":"행동재무학·핀테크","level":3,"related":["tobin-separation-theorem"],"prerequisites":[]},{"slug":"law-of-small-numbers","title_ko":"소수의법칙","title_en":"Law of Small Numbers","meaning":"적은 수의 표본에서 관찰된 패턴을 마치 모집단 전체의 통계적 특성을 대표하는 것처럼 과대해석하는 인지적 편향으로, 투자자가…","subcategory":"행동재무학·핀테크","level":1,"related":["extrapolative-expectations","sample"],"prerequisites":[],"aliases":["LSN"]},{"slug":"dumb-money-effect","title_ko":"덤머니효과","title_en":"Dumb Money Effect","meaning":"개인투자자를 포함한 정보 열위의 자금 흐름이 실적이 좋았던 자산으로 뒤늦게 몰리면서 오히려 이후 낮은 수익률을 예측하는…","subcategory":"행동재무학·핀테크","level":3,"related":["extrapolative-expectations"],"prerequisites":[]},{"slug":"extrapolative-expectations","title_ko":"외삽적기대","title_en":"Extrapolative Expectations","meaning":"투자자가 미래 수익률에 대한 기대를 형성할 때 최근 실현된 과거 수익률을 단순히 미래로 연장하는 방식으로 예측치를 조정한다는…","subcategory":"행동재무학·핀테크","level":3,"related":["law-of-small-numbers","dumb-money-effect"],"prerequisites":[]},{"slug":"quantitative-trading","title_ko":"퀀트트레이딩","title_en":"Quantitative Trading","meaning":"방대한 시장 데이터를 통계적, 수학적 모형으로 분석하여 가격 이례현상이나 패턴을 찾아내고, 이를 근거로 체계적인 매매 신호를…","subcategory":"행동재무학·핀테크","level":3,"related":["weak-form-market-efficiency"],"prerequisites":[],"aliases":["퀀트투자"]},{"slug":"open-banking","title_ko":"오픈뱅킹","title_en":"Open Banking","meaning":"고객의 동의를 전제로 표준화된 응용프로그램인터페이스를 통해 은행이 보유한 고객의 금융거래 데이터를 제3의 핀테크 사업자와…","subcategory":"행동재무학·핀테크","level":1,"related":["fintech"],"prerequisites":[],"pop":14},{"slug":"distributed-ledger-technology","title_ko":"분산원장기술","title_en":"Distributed Ledger Technology (DLT)","meaning":"거래 기록을 단일 중앙기관이 아니라 네트워크에 참여하는 다수의 노드가 각자 동일한 사본을 보유하고 합의 절차를 통해 함께…","subcategory":"행동재무학·핀테크","level":3,"related":["fintech"],"prerequisites":[],"pop":7,"aliases":["DLT"]},{"slug":"fintech","title_ko":"핀테크","title_en":"FinTech","meaning":"금융 산업의 상품과 서비스에 새로운 기술을 적용한 것, 또는 그런 기술을 쓰는 기업을 가리킨다.","subcategory":"행동재무학·핀테크","level":3,"related":["regulatory-sandbox","open-banking","distributed-ledger-technology"],"prerequisites":[],"aliases":["Fintech","금융기술","financial technology"]},{"slug":"reinsurance","title_ko":"재보험","title_en":"Reinsurance","meaning":"원보험자가 인수한 위험의 전부 또는 일부를 다른 보험자에게 다시 인수시켜 자신의 위험 부담을 분산하는 보험자 간의 위험 전가…","subcategory":"보험이론·상품","level":3,"related":["retention-limit","risk-pooling"],"prerequisites":[],"pop":7,"aliases":["리인슈어런스","재보험거래"]},{"slug":"insurance-policy-terms","title_ko":"보험약관","title_en":"Insurance Policy Terms","meaning":"보험자가 다수의 보험계약에 동일하게 적용하기 위해 미리 작성한 계약조항으로, 보장범위, 면책사유, 보험금 지급절차 등 계약…","subcategory":"보험이론·상품","level":1,"related":["grace-period-insurance","deductible"],"prerequisites":[],"pop":3,"aliases":["보험약관조항","약관"]},{"slug":"principle-of-indemnity","title_ko":"이득금지의 원칙","title_en":"Principle of Indemnity","meaning":"손해보험에서 보험금 지급이 실제 발생한 손해액을 초과할 수 없다는 원칙으로, 보험을 통한 부당한 이득 취득을 방지하기 위한…","subcategory":"보험이론·상품","level":1,"related":["equivalence-principle-insurance","mutuality-principle-insurance","deductible"],"prerequisites":[],"aliases":["이득금지의원칙"]},{"slug":"proximate-cause-doctrine","title_ko":"근인주의","title_en":"Proximate Cause Doctrine","meaning":"보험사고와 손해 사이의 인과관계를 판단할 때 시간적으로 가장 가까운 원인이 아니라 손해를 초래한 지배적이고 효과적인 원인을…","subcategory":"보험이론·상품","level":2,"related":[],"prerequisites":[],"aliases":["근인원칙","상당인과관계"]},{"slug":"risk-pooling","title_ko":"위험의 분산","title_en":"Risk Pooling","meaning":"다수의 동질적 경제주체가 각자의 위험을 하나의 집단으로 결합함으로써 개별 주체가 부담해야 할 불확실성을 집단 전체로…","subcategory":"보험이론·상품","level":1,"related":["mutuality-principle-insurance"],"prerequisites":[],"aliases":["위험의분산"]},{"slug":"pure-risk-speculative-risk","title_ko":"순수위험과 투기적위험","title_en":"Pure Risk vs Speculative Risk","meaning":"손실만 발생하거나 손실이 없는 상태만 존재하는 순수위험과, 손실과 이익 발생 가능성이 함께 존재하는 투기적위험을 구분하는…","subcategory":"보험이론·상품","level":1,"related":["insurable-risk-requirements","hazard-peril-distinction"],"prerequisites":[],"aliases":["PRVSR","순수위험과투기적위험"]},{"slug":"insurable-risk-requirements","title_ko":"보험가능위험의 요건","title_en":"Requirements of Insurable Risk","meaning":"다수의 동질적 위험 존재, 우연성, 손해의 확정성과 측정가능성, 비재난성 등 위험이 보험상품으로 성립하기 위해 갖추어야 하는…","subcategory":"보험이론·상품","level":2,"related":["pure-risk-speculative-risk"],"prerequisites":["pure-risk-speculative-risk"],"aliases":["보험가능위험의요건"]},{"slug":"mutuality-principle-insurance","title_ko":"상호부조의 원칙","title_en":"Mutuality Principle","meaning":"다수의 계약자가 각출한 보험료를 공동의 재원으로 모아 그 중 실제로 손해를 입은 소수의 계약자에게 보험금을 지급하는 보험…","subcategory":"보험이론·상품","level":1,"related":["risk-pooling"],"prerequisites":[],"aliases":["상호부조의원칙"]},{"slug":"equivalence-principle-insurance","title_ko":"수지상등의 원칙","title_en":"Equivalence Principle","meaning":"보험계약 체결 시점에서 장래 보험료 수입의 현재가치와 장래 보험금 지급의 현재가치가 서로 같아지도록 보험료를 산정해야 한다는…","subcategory":"보험이론·상품","level":2,"related":["mutuality-principle-insurance","net-single-premium","base-rate-ratemaking"],"prerequisites":[],"aliases":["수지상등의원칙","수지상등원칙","Actuarial Equivalence Principle"]},{"slug":"endowment-insurance","title_ko":"양로보험","title_en":"Endowment Insurance","meaning":"보험기간 중 사망하면 사망보험금을, 만기까지 생존하면 만기보험금을 지급하는 생사혼합보험으로 보장과 저축의 기능을 함께…","subcategory":"보험이론·상품","level":3,"related":[],"prerequisites":[],"pop":17,"aliases":["생사혼합보험","양로보험상품"]},{"slug":"business-interruption-insurance","title_ko":"기업휴지보험","title_en":"Business Interruption Insurance","meaning":"화재 등 담보위험으로 인해 사업장이 손상되어 영업이 중단됨으로써 발생하는 이익 상실과 고정비 손실을 보상하는 손해보험…","subcategory":"보험이론·상품","level":3,"related":["principle-of-indemnity"],"prerequisites":[],"aliases":["BII"]},{"slug":"grace-period-insurance","title_ko":"납입유예기간","title_en":"Grace Period","meaning":"보험료 납입기일이 지났음에도 일정 기간 동안 계약의 효력을 유지시켜 그 기간 내에 보험료를 납입하면 계약이 실효되지 않도록…","subcategory":"보험이론·상품","level":3,"related":["insurance-policy-terms"],"prerequisites":["insurance-policy-terms"],"aliases":["보험료납입유예","유예기간"]},{"slug":"hazard-peril-distinction","title_ko":"위태와 손인","title_en":"Hazard vs Peril","meaning":"손해의 직접적 원인이 되는 사건인 손인과, 손인의 발생 가능성이나 손해의 정도를 증가시키는 조건인 위태를 구분하는 보험이론의…","subcategory":"보험이론·상품","level":2,"related":["moral-hazard","proximate-cause-doctrine","pure-risk-speculative-risk"],"prerequisites":["pure-risk-speculative-risk"],"aliases":["위태와손인"]},{"slug":"deductible","title_ko":"자기부담금","title_en":"Deductible","meaning":"보험사고로 인한 손해액 중 계약자가 스스로 부담하기로 약정한 일정 금액으로, 이를 초과하는 부분에 대해서만 보험자가…","subcategory":"보험이론·상품","level":3,"related":["moral-hazard","principle-of-indemnity","retention-limit"],"prerequisites":[],"pop":13,"aliases":["공제금액","디덕터블"]},{"slug":"operational-risk","title_ko":"운영리스크","title_en":"Operational Risk","meaning":"부적절하거나 잘못된 내부 절차, 인력, 시스템 또는 외부 사건으로 인해 보험회사가 입을 수 있는 손실 위험을 말한다.","subcategory":"보험계리·리스크관리","level":3,"related":["fmea","scenario-based-risk-analysis"],"prerequisites":[],"pop":15,"aliases":["오퍼레이셔널리스크","운영위험"]},{"slug":"fair-value-insurance-liability","title_ko":"보험부채시가평가","title_en":"Fair Value Measurement of Insurance Liability","meaning":"보험부채를 계약 체결 시점의 가정이 아닌 현재 시점의 시장금리와 최신 가정으로 재평가하는 회계·감독상의 측정 방식을 말한다.","subcategory":"보험계리·리스크관리","level":1,"related":[],"prerequisites":[],"aliases":["FVMIL"]},{"slug":"bornhuetter-ferguson-method","title_ko":"본휴터퍼거슨법","title_en":"Bornhuetter-Ferguson Method","meaning":"사전에 예상한 손해율과 실제 발전된 손해액 정보를 가중평균하여 미보고손해액을 추정하는 손해준비금 산출 기법을 말한다.","subcategory":"보험계리·리스크관리","level":3,"related":["incurred-but-not-reported-reserve","loss-development-factor"],"prerequisites":[],"aliases":["BF법","본휴터-퍼거슨"]},{"slug":"preferred-risk","title_ko":"우량체","title_en":"Preferred Risk","meaning":"언더라이팅 심사 결과 평균보다 낮은 위험 수준으로 평가되어 할인된 보험료율이 적용되는 피보험자 등급을 말한다.","subcategory":"보험계리·리스크관리","level":1,"related":[],"prerequisites":[],"aliases":["우량위험체","우량체할인"]},{"slug":"separate-account","title_ko":"특별계정","title_en":"Separate Account","meaning":"변액보험 등의 자산을 회사의 일반 자산과 분리하여 별도로 운용·관리하는 회계상의 계정을 말한다.","subcategory":"보험계리·리스크관리","level":2,"related":["general-account"],"prerequisites":[],"pop":18},{"slug":"general-account","title_ko":"일반계정","title_en":"General Account","meaning":"특별계정으로 분리되지 않은 보험회사의 일반적인 자산과 부채를 운용·관리하는 회계상의 계정을 말한다.","subcategory":"보험계리·리스크관리","level":2,"related":["separate-account"],"prerequisites":[]},{"slug":"premium-allocation-approach","title_ko":"보험료배분법","title_en":"Premium Allocation Approach","meaning":"IFRS17에서 보장기간이 1년 이하이거나 일반모형과 측정 결과가 중요하게 다르지 않을 것으로 예상되는 계약군에 대해…","subcategory":"보험계리·리스크관리","level":3,"related":["fair-value-insurance-liability"],"prerequisites":[],"aliases":["PAA"]},{"slug":"net-single-premium","title_ko":"순보험료(일시납)","title_en":"Net Single Premium","meaning":"사업비 등 부가보험료를 제외하고 순수하게 위험보장에 대한 대가로 계약 시점에 한 번에 납입하는 보험료이다.","subcategory":"생명보험수리","level":3,"related":["equivalence-principle-insurance"],"prerequisites":[],"aliases":["일시납"]},{"slug":"single-decrement-table","title_ko":"단일탈퇴표","title_en":"Single Decrement Table","meaning":"사망, 해약, 장해 등 여러 탈퇴 원인 중 오직 하나의 원인만 존재한다고 가정하고 작성한 생명표이다.","subcategory":"다중탈퇴이론","level":1,"related":["associated-single-decrement-table"],"prerequisites":[]},{"slug":"associated-single-decrement-table","title_ko":"연관단일탈퇴표","title_en":"Associated Single Decrement Table","meaning":"여러 탈퇴 원인이 동시에 작용하는 다중탈퇴표로부터, 각 원인별로 다른 원인이 없다고 가정했을 때의 탈퇴율을 산출하여 만든…","subcategory":"다중탈퇴이론","level":2,"related":["single-decrement-table"],"prerequisites":["single-decrement-table"],"aliases":["ASDT"]},{"slug":"retention-limit","title_ko":"보유한도(보유액)","title_en":"Retention Limit","meaning":"원수보험사가 재보험으로 전가하지 않고 자체적으로 부담하기로 정한 위험의 최대 금액이다.","subcategory":"재보험","level":3,"related":["reinsurance","deductible","risk-pooling"],"prerequisites":[],"aliases":["보유액","자기보유액"]},{"slug":"incurred-but-not-reported-reserve","title_ko":"미보고발생손해액준비금(IBNR)","title_en":"Incurred But Not Reported Reserve","meaning":"이미 발생했지만 결산 시점까지 보험회사에 아직 접수 또는 보고되지 않은 사고에 대비해 적립하는 준비금이다.","subcategory":"손해보험수리","level":3,"related":["bornhuetter-ferguson-method","loss-development-factor"],"prerequisites":[],"aliases":["IBNR준비금","미보고발생손해액","미보고발생손해준비금"]},{"slug":"base-rate-ratemaking","title_ko":"기본요율","title_en":"Base Rate","meaning":"기본요율은 기준이 되는 위험군에 대해 산출된 보험료의 출발점으로, 여기에 여러 요율상대도를 곱하여 개별 계약자의 최종…","subcategory":"요율산정","level":3,"related":["equivalence-principle-insurance"],"prerequisites":[],"aliases":["기준요율"]},{"slug":"loss-development-factor","title_ko":"손해진전계수","title_en":"Loss Development Factor","meaning":"특정 진전연도의 누적손해액을 다음 진전연도의 누적손해액으로 전환하기 위해 곱하는 비율로, 손해가 시간이 지나면서 얼마나…","subcategory":"손해보험수리","level":3,"related":["incurred-but-not-reported-reserve","bornhuetter-ferguson-method"],"prerequisites":[],"aliases":["LDF","손해진전율"]}]