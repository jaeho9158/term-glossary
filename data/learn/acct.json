[{"slug":"accrual-basis","title_ko":"발생주의","title_en":"Accrual Basis","meaning":"거래나 경제적 사건이 발생한 시점에 수익과 비용을 인식하는 회계처리 기준으로, 현금의 수수 시점과 관계없이 그 원인이 발생한…","subcategory":"재무회계·회계원칙","level":2,"related":["revenue-recognition-principle"],"prerequisites":["revenue-recognition-principle"]},{"slug":"monetary-unit-assumption","title_ko":"화폐단위가정","title_en":"Monetary Unit Assumption","meaning":"화폐로 측정 가능한 거래와 사건만을 회계기록의 대상으로 하며, 화폐가치는 일정하다고 가정하는 회계의 기본가정이다.","subcategory":"재무회계·회계원칙","level":3,"related":["historical-cost-principle"],"prerequisites":["historical-cost-principle"],"aliases":["MUA"]},{"slug":"historical-cost-principle","title_ko":"역사적원가주의","title_en":"Historical Cost Principle","meaning":"자산과 부채를 취득 또는 발생 시점의 거래가격, 즉 역사적원가로 측정하여 재무제표에 계상하는 원칙이다.","subcategory":"재무회계·회계원칙","level":1,"related":["monetary-unit-assumption"],"prerequisites":[]},{"slug":"revenue-recognition-principle","title_ko":"수익인식원칙","title_en":"Revenue Recognition Principle","meaning":"고객에게 약속한 재화나 용역의 통제를 이전하여 수행의무를 이행할 때(한 시점 또는 기간에 걸쳐), 받을 권리가 있을 것으로…","subcategory":"재무회계·회계원칙","level":1,"related":[],"prerequisites":[]},{"slug":"debit-and-credit","title_ko":"차변과대변","title_en":"Debit and Credit","meaning":"복식부기에서 거래를 기록하는 양면으로, 계정과목의 왼쪽을 차변, 오른쪽을 대변이라 하며 자산·비용의 증가는 차변에…","subcategory":"재무회계·회계원칙","level":2,"related":["journal-entry","general-ledger"],"prerequisites":[],"pop":3},{"slug":"general-ledger","title_ko":"총계정원장","title_en":"General Ledger","meaning":"모든 계정과목별로 거래 내용과 잔액 변동을 체계적으로 기록·집계하는 회계장부이다.","subcategory":"재무회계·회계원칙","level":2,"related":["journal-entry","debit-and-credit"],"prerequisites":[]},{"slug":"journal-entry","title_ko":"분개","title_en":"Journal Entry","meaning":"발생한 거래를 차변과 대변의 계정과목과 금액으로 나누어 분개장에 최초로 기록하는 절차이다.","subcategory":"재무회계·회계원칙","level":2,"related":["debit-and-credit","general-ledger"],"prerequisites":[],"pop":5},{"slug":"statement-of-changes-in-equity","title_ko":"자본변동표","title_en":"Statement of Changes in Equity","meaning":"일정 기간 동안 자본을 구성하는 항목들(납입자본, 이익잉여금, 기타자본 등)의 변동내역을 보여주는 재무제표이다.","subcategory":"재무회계·회계원칙","level":3,"related":[],"prerequisites":[]},{"slug":"consolidated-financial-statements","title_ko":"연결재무제표","title_en":"Consolidated Financial Statements","meaning":"지배기업과 그 지배력 하에 있는 종속기업들을 단일의 경제적 실체로 보아 작성하는 재무제표이다.","subcategory":"재무회계·회계원칙","level":1,"related":[],"prerequisites":[]},{"slug":"interim-financial-statements","title_ko":"중간재무제표","title_en":"Interim Financial Statements","meaning":"1년보다 짧은 회계기간(분기, 반기 등)을 대상으로 작성하는 재무제표이다.","subcategory":"재무회계·회계원칙","level":3,"related":[],"prerequisites":[],"aliases":["IFS"]},{"slug":"depreciation","title_ko":"감가상각","title_en":"Depreciation","meaning":"유형자산의 취득원가를 그 자산이 사용되는 내용연수에 걸쳐 체계적이고 합리적인 방법으로 비용으로 배분하는 절차이다.","subcategory":"재무회계·회계원칙","level":1,"related":[],"prerequisites":[]},{"slug":"residual-value","title_ko":"잔존가치","title_en":"Residual Value","meaning":"자산이 내용연수 종료 시점의 상태(내용연수 종료 시 예상되는 상태)에 도달하였을 때 자산의 처분으로 얻을 것으로 추정되는…","subcategory":"재무회계·회계원칙","level":2,"related":["depreciation"],"prerequisites":["depreciation"],"pop":16},{"slug":"depletion","title_ko":"감모상각","title_en":"Depletion","meaning":"천연자원(광산, 유전, 산림 등)의 취득원가를 채굴·채취되는 양에 비례하여 비용으로 배분하는 절차이다.","subcategory":"재무회계·회계원칙","level":3,"related":["depreciation"],"prerequisites":["depreciation"]},{"slug":"net-realizable-value","title_ko":"순실현가능가치","title_en":"Net Realizable Value","meaning":"정상적인 영업과정에서 예상되는 판매가격에서 예상되는 추가완성원가와 판매비용을 차감한 금액이다.","subcategory":"재무회계·회계원칙","level":1,"related":[],"prerequisites":[],"pop":4,"aliases":["NRV"]},{"slug":"unearned-revenue","title_ko":"선수수익","title_en":"Unearned Revenue","meaning":"재화나 용역을 제공하기 전에 그 대가를 미리 받아 아직 수익으로 인식하지 못한 금액을 부채로 계상하는 계정이다.","subcategory":"재무회계·회계원칙","level":2,"related":["prepaid-expenses"],"prerequisites":[]},{"slug":"prepaid-expenses","title_ko":"선급비용","title_en":"Prepaid Expenses","meaning":"미래 기간에 귀속될 비용을 당기에 미리 현금으로 지급하여 아직 비용화되지 않은 금액을 자산으로 계상하는 계정이다.","subcategory":"재무회계·회계원칙","level":2,"related":["unearned-revenue"],"prerequisites":[]},{"slug":"paid-in-capital","title_ko":"납입자본","title_en":"Paid-in Capital","meaning":"주주가 기업에 실제로 납입한 자본으로, 자본금과 주식발행초과금 등 자본잉여금을 포함하는 개념이다.","subcategory":"재무회계·회계원칙","level":2,"related":[],"prerequisites":[],"pop":7},{"slug":"comprehensive-income","title_ko":"총포괄이익","title_en":"Comprehensive Income","meaning":"일정 기간 동안 주주와의 자본거래를 제외한 모든 원천에서 발생한 자본의 변동으로, 당기순손익과 기타포괄손익의 합계로 표시된다.","subcategory":"재무회계·회계원칙","level":2,"related":[],"prerequisites":[],"pop":9},{"slug":"right-of-use-asset","title_ko":"사용권자산","title_en":"Right-of-Use Asset","meaning":"리스이용자가 리스기간 동안 기초자산을 사용할 권리를 나타내는 자산으로, 리스부채와 함께 최초 인식되며 감가상각을 통해…","subcategory":"재무회계·회계원칙","level":2,"related":[],"prerequisites":[],"pop":6},{"slug":"book-value","title_ko":"장부가액","title_en":"Book Value","meaning":"자산, 부채 또는 자본이 재무상태표에 인식되어 있는 금액으로, 유형자산의 경우 취득원가에서 감가상각누계액과 손상차손누계액을…","subcategory":"재무회계·회계원칙","level":2,"related":[],"prerequisites":[],"pop":17},{"slug":"amortized-cost","title_ko":"상각후원가","title_en":"Amortized Cost","meaning":"금융자산이나 금융부채를 최초 인식금액에서 원금상환액을 차감하고 유효이자율법에 따른 상각누계액을 가감하여 산정한 측정금액이다.","subcategory":"재무회계·회계원칙","level":3,"related":[],"prerequisites":[],"pop":1},{"slug":"off-balance-sheet-financing","title_ko":"부외금융","title_en":"Off-Balance-Sheet Financing","meaning":"자금조달의 실질이 있음에도 관련 자산이나 부채를 재무상태표에 인식하지 않도록 거래를 구조화하는 것을 의미한다.","subcategory":"재무회계·회계원칙","level":3,"related":[],"prerequisites":[],"aliases":["OBSF"]},{"slug":"contribution-margin","title_ko":"공헌이익","title_en":"Contribution Margin","meaning":"매출액에서 변동원가를 차감한 금액으로, 고정원가를 회수하고 이익을 창출하는 데 공헌하는 금액.","subcategory":"관리회계·세무회계","level":1,"related":["contribution-margin-ratio","variable-costing"],"prerequisites":[],"pop":10,"aliases":["한계이익"]},{"slug":"cost-volume-profit-analysis","title_ko":"원가-조업도-이익분석","title_en":"Cost-Volume-Profit (CVP) Analysis","meaning":"원가, 조업도(판매량), 이익 간의 관계를 분석하여 목표이익 달성에 필요한 판매량이나 매출액 등을 산출하는 관리회계 기법.","subcategory":"관리회계·세무회계","level":2,"related":["contribution-margin","operating-leverage"],"prerequisites":["contribution-margin"],"pop":2,"aliases":["CVPA","원가 조업도 이익분석","원가조업도이익분석"]},{"slug":"variable-costing","title_ko":"변동원가계산","title_en":"Variable Costing","meaning":"직접재료비, 직접노무비, 변동제조간접비 등 변동원가만을 제품원가에 포함시키고 고정제조간접비는 발생 기간의 비용으로 처리하는…","subcategory":"관리회계·세무회계","level":2,"related":["contribution-margin","variable-cost"],"prerequisites":["contribution-margin","variable-cost"],"aliases":["직접원가계산"]},{"slug":"cost-behavior","title_ko":"원가행태","title_en":"Cost Behavior","meaning":"조업도(생산량, 판매량 등)의 변화에 따라 총원가가 어떻게 변화하는지를 나타내는 원가의 특성으로…","subcategory":"관리회계·세무회계","level":1,"related":["variable-cost"],"prerequisites":[],"pop":8},{"slug":"variable-cost","title_ko":"변동원가","title_en":"Variable Cost","meaning":"조업도의 변화에 비례하여 총액이 증감하지만 단위당 금액은 일정하게 유지되는 원가.","subcategory":"관리회계·세무회계","level":1,"related":["contribution-margin","cost-behavior","variable-costing"],"prerequisites":[]},{"slug":"operating-leverage","title_ko":"영업레버리지","title_en":"Operating Leverage","meaning":"총원가 구조에서 고정원가가 차지하는 비중이 클수록 매출액 변화에 따른 영업이익 변화폭이 확대되는 효과.","subcategory":"관리회계·세무회계","level":2,"related":["contribution-margin"],"prerequisites":["contribution-margin"],"pop":13,"aliases":["DOL"]},{"slug":"cash-budget","title_ko":"현금예산","title_en":"Cash Budget","meaning":"일정 기간 동안의 현금유입과 현금유출을 추정하여 자금의 과부족을 사전에 파악하고 자금조달·운용 계획을 수립하는 예산.","subcategory":"관리회계·세무회계","level":3,"related":[],"prerequisites":[]},{"slug":"net-present-value","title_ko":"순현재가치","title_en":"Net Present Value (NPV)","meaning":"투자안에서 발생하는 미래 현금유입액의 현재가치에서 최초 투자에 소요된 현금유출액의 현재가치를 차감한 값으로, 자본예산 평가의…","subcategory":"관리회계·세무회계","level":1,"related":["profitability-index"],"prerequisites":[],"pop":19},{"slug":"profitability-index","title_ko":"수익성지수","title_en":"Profitability Index (PI)","meaning":"투자안의 미래현금유입액 현재가치를 최초투자액으로 나눈 비율로, 1보다 크면 투자안을 채택하는 자본예산 평가지표.","subcategory":"관리회계·세무회계","level":2,"related":["net-present-value"],"prerequisites":["net-present-value"],"pop":12,"aliases":["PI"]},{"slug":"labor-rate-variance","title_ko":"노무임률차이","title_en":"Labor Rate Variance","meaning":"실제 지급한 노무임률과 표준임률의 차이에 실제노동시간을 곱하여 산출하는, 임금 수준의 유·불리를 나타내는 차이.","subcategory":"관리회계·세무회계","level":2,"related":[],"prerequisites":[]},{"slug":"cost-center","title_ko":"원가중심점","title_en":"Cost Center","meaning":"발생한 원가에 대해서만 통제권한과 책임을 지는 책임회계 단위로, 수익창출과는 직접 관련이 없는 부문에 주로 적용된다.","subcategory":"관리회계·세무회계","level":3,"related":[],"prerequisites":[],"pop":15},{"slug":"economic-value-added","title_ko":"경제적부가가치","title_en":"Economic Value Added (EVA)","meaning":"세후영업이익에서 투하자본에 가중평균자본비용을 곱한 자본비용을 차감하여 산출하는, 잔여이익 개념을 정교화한 기업가치 기반…","subcategory":"관리회계·세무회계","level":2,"related":[],"prerequisites":[],"aliases":["EVA"]},{"slug":"theory-of-constraints","title_ko":"제약이론","title_en":"Theory of Constraints (TOC)","meaning":"생산시스템 전체의 성과를 제한하는 병목(제약)요인을 식별하고, 이를 집중적으로 관리·개선함으로써 시스템 전체의 성과를…","subcategory":"관리회계·세무회계","level":3,"related":["contribution-margin"],"prerequisites":["contribution-margin"]},{"slug":"management-by-exception","title_ko":"예외에의한관리","title_en":"Management by Exception","meaning":"표준(예산)과 실제 성과의 차이 중 중요한 차이(예외사항)에 대해서만 관리자가 조사와 시정조치를 취하는 관리원칙.","subcategory":"관리회계·세무회계","level":3,"related":[],"prerequisites":[],"pop":14},{"slug":"contribution-margin-ratio","title_ko":"공헌이익률","title_en":"Contribution Margin Ratio","meaning":"공헌이익을 매출액으로 나눈 비율로, 매출액 1원 증가 시 공헌이익(및 영업이익)이 얼마나 증가하는지를 나타내는 지표.","subcategory":"관리회계·세무회계","level":2,"related":["contribution-margin"],"prerequisites":["contribution-margin"]},{"slug":"taxable-income","title_ko":"과세소득","title_en":"Taxable Income","meaning":"세법 규정에 따라 산출된, 법인세 또는 소득세 부과의 대상이 되는 소득금액.","subcategory":"관리회계·세무회계","level":1,"related":[],"prerequisites":[],"pop":18},{"slug":"thin-capitalization-rule","title_ko":"과소자본세제","title_en":"Thin Capitalization Rule","meaning":"내국법인이 국외지배주주로부터 자기자본의 일정 배수를 초과하여 차입한 경우, 그 초과분에 대한 지급이자를 배당으로 간주하여…","subcategory":"관리회계·세무회계","level":3,"related":["controlled-foreign-corporation-rule"],"prerequisites":["controlled-foreign-corporation-rule"],"pop":11},{"slug":"controlled-foreign-corporation-rule","title_ko":"특정외국법인세제","title_en":"Controlled Foreign Corporation (CFC) Rule","meaning":"조세피난처 등 저세율국가에 소재한 특정외국법인이 배당을 하지 않고 유보한 소득을 내국인 주주가 배당받은 것으로 간주하여…","subcategory":"관리회계·세무회계","level":2,"related":["thin-capitalization-rule"],"prerequisites":[],"pop":20,"aliases":["CFCR"]},{"slug":"tax-exemption-vat","title_ko":"면세","title_en":"Tax Exemption","meaning":"부가가치세법상 특정 재화나 용역의 공급에 대해 부가가치세 납세의무 자체를 면제함으로써 매출세액이 발생하지 않지만…","subcategory":"부가가치세법","level":2,"related":["supply-of-services"],"prerequisites":[]}]