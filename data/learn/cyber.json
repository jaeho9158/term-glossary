[{"slug":"advanced-encryption-standard","title_ko":"고급 암호화 표준(AES)","title_en":"Advanced Encryption Standard","meaning":"미국 국립표준기술연구소(NIST)가 표준으로 채택한 128비트 블록 크기의 대칭키 블록 암호입니다.","subcategory":"암호 알고리즘","level":2,"related":[],"prerequisites":[],"aliases":["고급 암호화 표준","고급암호화표준","고급암호화표준(AES)"]},{"slug":"certificate-authority","title_ko":"인증기관","title_en":"Certificate Authority","meaning":"신원을 확인한 후 디지털 인증서를 발급하고 그 진위를 보증하는 신뢰할 수 있는 제3의 기관입니다.","subcategory":"PKI 및 키 관리","level":2,"related":[],"prerequisites":[],"aliases":["CA"]},{"slug":"access-control-list","title_ko":"접근제어목록","title_en":"Access Control List","meaning":"특정 자원(파일, 네트워크 등)에 대해 어떤 사용자나 시스템이 어떤 권한(읽기, 쓰기, 실행 등)을 가지는지를 명시한 규칙의…","subcategory":"인증 및 접근제어","level":2,"related":[],"prerequisites":[],"aliases":["ACL"]},{"slug":"distributed-denial-of-service-attack","title_ko":"분산서비스거부공격","title_en":"Distributed Denial-of-Service Attack","meaning":"다수의 시스템(주로 악성코드에 감염된 기기들)이 동시에 특정 대상을 공격하여 서비스를 마비시키는 서비스거부공격의 한…","subcategory":"네트워크 보안","level":2,"related":[],"prerequisites":[],"aliases":["DDSA"]},{"slug":"privilege-escalation","title_ko":"권한상승","title_en":"Privilege Escalation","meaning":"공격자나 프로그램이 원래 허용된 것보다 더 높은 접근 권한을 시스템의 취약점을 이용해 획득하는 행위를 말합니다.","subcategory":"시스템 및 운영체제 보안","level":2,"related":["rootkit"],"prerequisites":[]},{"slug":"rootkit","title_ko":"루트킷","title_en":"Rootkit","meaning":"공격자가 시스템에 침투한 뒤 자신의 존재와 활동을 숨기기 위해 사용하는, 관리자 권한 수준에서 동작하는 악성 소프트웨어 도구…","subcategory":"악성코드 분석","level":2,"related":["privilege-escalation"],"prerequisites":[]},{"slug":"zero-day-vulnerability","title_ko":"제로데이 취약점","title_en":"Zero-Day Vulnerability","meaning":"제로데이 취약점은 개발자가 아직 알지 못하거나 패치를 내놓지 못한 상태에서 존재하는 소프트웨어 보안 결함입니다.","subcategory":"취약점 분석 및 침투테스트","level":2,"related":["exploit-development"],"prerequisites":[],"pop":1,"aliases":["ZDV","제로데이취약점"]},{"slug":"exploit-development","title_ko":"익스플로잇 개발","title_en":"Exploit Development","meaning":"익스플로잇 개발은 발견된 소프트웨어 취약점을 실제로 악용할 수 있는 코드나 절차로 구체화하는 작업입니다.","subcategory":"취약점 분석 및 침투테스트","level":2,"related":["zero-day-vulnerability"],"prerequisites":[],"pop":5,"aliases":["익스플로잇개발"]},{"slug":"blind-sql-injection","title_ko":"블라인드 SQL 인젝션","title_en":"Blind SQL Injection","meaning":"데이터베이스 오류 메시지나 결과값이 화면에 직접 표시되지 않는 상황에서, 참/거짓 응답이나 응답 시간 같은 간접적인 신호를…","subcategory":"웹 애플리케이션 보안","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["Blind SQL Injection","블라인드SQL인젝션"]},{"slug":"physical-unclonable-function","title_ko":"물리적복제방지함수(PUF)","title_en":"Physical Unclonable Function","meaning":"반도체 제조 공정에서 칩마다 자연적으로 생기는 미세한 물리적 편차를 이용해, 동일한 설계도로도 완전히 똑같이 복제할 수 없는…","subcategory":"IoT 및 임베디드 보안","level":2,"related":[],"prerequisites":[],"aliases":["Physical Unclonable Function","물리적복제방지함수"]},{"slug":"data-de-identification","title_ko":"데이터 비식별화","title_en":"Data De-Identification","meaning":"개인을 식별할 수 있는 정보를 데이터에서 제거하거나 변형하여 특정 개인과의 연결 가능성을 낮추는 처리 기법입니다.","subcategory":"프라이버시 및 익명화","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["Data De-Identification","데이터비식별화"]},{"slug":"deep-packet-inspection","title_ko":"심층 패킷 검사","title_en":"Deep Packet Inspection (DPI)","meaning":"네트워크를 지나가는 패킷의 헤더뿐 아니라 실제 데이터(페이로드)까지 들여다보아 트래픽의 내용과 애플리케이션 종류를 분석하는…","subcategory":"네트워크 보안","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["심층 패킷 검사 (Deep Packet Inspection","DPI)","심층패킷검사(DeepPacketInspection"]}]