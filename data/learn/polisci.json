[{"slug":"majoritarian-democracy","title_ko":"다수제 민주주의","title_en":"Majoritarian Democracy","meaning":"권력을 다수당에 집중시켜 신속하고 명확한 의사결정을 추구하는 민주주의 운영 모델.","subcategory":"정치이론·비교정치","level":2,"related":[],"prerequisites":[],"aliases":["다수제민주주의"]},{"slug":"representation-theory-pitkin","title_ko":"대표성 이론(핏킨)","title_en":"Pitkin's Theory of Representation","meaning":"한나 핏킨이 제시한 정치적 대표 개념의 여러 차원을 구분하는 이론.","subcategory":"정치이론·비교정치","level":2,"related":["political-accountability"],"prerequisites":["political-accountability"],"aliases":["대표성 이론","대표성이론","대표성이론(핏킨)","핏킨"]},{"slug":"political-accountability","title_ko":"정치적 책임성","title_en":"Political Accountability","meaning":"정치 권력을 행사하는 행위자가 자신의 결정과 행동에 대해 설명하고 그 결과에 책임을 지도록 만드는 제도적 장치와 규범.","subcategory":"정치이론·비교정치","level":1,"related":[],"prerequisites":[],"pop":19,"aliases":["정치적책임성"]},{"slug":"compulsory-voting","title_ko":"의무투표제","title_en":"Compulsory Voting","meaning":"법으로 유권자에게 투표 참여를 의무화하고 불참 시 제재를 부과하는 제도.","subcategory":"정치이론·비교정치","level":3,"related":[],"prerequisites":[],"aliases":["강제투표"]},{"slug":"party-identification-theory","title_ko":"정당일체감","title_en":"Party Identification Theory","meaning":"유권자가 특정 정당에 대해 지속적이고 심리적인 소속감을 갖는다는 것을 설명하는 투표행태 이론.","subcategory":"정치이론·비교정치","level":1,"related":[],"prerequisites":[],"pop":6,"aliases":["정당귀속감"]},{"slug":"crony-capitalism","title_ko":"정실자본주의","title_en":"Crony Capitalism","meaning":"기업의 성공이 시장 경쟁력보다 정치권력과의 친분이나 유착 관계에 크게 의존하는 경제 운영 양식.","subcategory":"정치이론·비교정치","level":3,"related":[],"prerequisites":[],"pop":18,"aliases":["연고자본주의","크로니자본주의"]},{"slug":"divided-government","title_ko":"분점정부","title_en":"Divided Government","meaning":"행정부 수반이 소속된 정당이 의회 다수를 차지하지 못해 행정부와 입법부의 다수 세력이 서로 다른 상태.","subcategory":"정치이론·비교정치","level":1,"related":[],"prerequisites":[],"aliases":["분할정부"]},{"slug":"realism-ir","title_ko":"현실주의(국제정치이론)","title_en":"Realism (International Relations Theory)","meaning":"국제정치를 무정부 상태 속에서 국가들이 힘과 국가이익을 추구하며 벌이는 권력투쟁으로 보는 이론적 시각입니다.","subcategory":"국제관계·외교안보 개념","level":1,"related":["balance-of-power"],"prerequisites":[],"pop":9,"aliases":["현실주의"]},{"slug":"offensive-realism","title_ko":"공격적 현실주의","title_en":"Offensive Realism","meaning":"무정부 상태에서 생존을 확보하는 가장 안전한 길은 가능한 한 많은 힘, 궁극적으로는 지역 패권을 추구하는 것이라고 보는…","subcategory":"국제관계·외교안보 개념","level":3,"related":["defensive-realism","balance-of-power"],"prerequisites":["defensive-realism"],"pop":12,"aliases":["공격적현실주의"]},{"slug":"defensive-realism","title_ko":"방어적 현실주의","title_en":"Defensive Realism","meaning":"국가는 힘을 무한정 늘리기보다 안보를 확보하는 데 필요한 적정 수준의 힘만을 추구하며, 과도한 팽창은 오히려 균형연합을…","subcategory":"국제관계·외교안보 개념","level":2,"related":["offensive-realism","balance-of-threat","balance-of-power"],"prerequisites":[],"pop":5,"aliases":["방어적현실주의"]},{"slug":"neoliberal-institutionalism","title_ko":"신자유제도주의","title_en":"Neoliberal Institutionalism","meaning":"무정부 상태를 인정하면서도 국제제도와 레짐이 정보 비대칭과 배신 유인을 줄여 국가 간 협력을 촉진할 수 있다고 보는…","subcategory":"국제관계·외교안보 개념","level":2,"related":["international-regime"],"prerequisites":["international-regime"],"aliases":["신자유주의제도주의"]},{"slug":"balance-of-threat","title_ko":"위협균형론","title_en":"Balance of Threat Theory","meaning":"국가들이 단순한 힘의 크기가 아니라 지리적 근접성, 공격 능력, 인지된 의도 등을 종합한 '위협' 수준에 따라 균형(동맹)…","subcategory":"국제관계·외교안보 개념","level":2,"related":["balance-of-power"],"prerequisites":[],"pop":17,"aliases":["위협균형이론"]},{"slug":"international-regime","title_ko":"국제레짐","title_en":"International Regime","meaning":"특정 국제 이슈 영역에서 행위자들의 기대가 수렴되는 명시적·묵시적 원칙, 규범, 규칙, 의사결정 절차의 총체를 말합니다.","subcategory":"국제관계·외교안보 개념","level":1,"related":["hegemonic-stability-theory","neoliberal-institutionalism"],"prerequisites":[],"pop":13},{"slug":"hegemonic-stability-theory","title_ko":"패권안정론","title_en":"Hegemonic Stability Theory","meaning":"압도적인 힘을 가진 패권국이 존재할 때 국제 경제·안보 질서가 더 안정적으로 유지된다고 보는 이론입니다.","subcategory":"국제관계·외교안보 개념","level":1,"related":["international-regime"],"prerequisites":[],"aliases":["패권안정이론"]},{"slug":"complex-interdependence","title_ko":"복합적 상호의존","title_en":"Complex Interdependence","meaning":"국가 간 관계가 군사력만이 아니라 다양한 채널의 상호작용, 이슈 간 위계의 부재, 군사력 사용 가능성의 저하 등을 특징으로…","subcategory":"국제관계·외교안보 개념","level":2,"related":["soft-power"],"prerequisites":[],"pop":15,"aliases":["복합적상호의존"]},{"slug":"hard-power","title_ko":"하드파워","title_en":"Hard Power","meaning":"군사적 강제력이나 경제적 제재·유인처럼 상대의 행동을 직접 강요하거나 대가로 유도하는 힘을 말합니다.","subcategory":"국제관계·외교안보 개념","level":3,"related":["soft-power","economic-sanctions"],"prerequisites":["economic-sanctions"],"aliases":["경성권력"]},{"slug":"bipolarity","title_ko":"양극체제","title_en":"Bipolarity","meaning":"국제체제 내 힘이 대략 대등한 두 초강대국(진영)에 집중되어 있는 힘의 분포 상태를 말합니다.","subcategory":"국제관계·외교안보 개념","level":2,"related":[],"prerequisites":[],"aliases":["양극질서"]},{"slug":"arms-control","title_ko":"군비통제","title_en":"Arms Control","meaning":"국가 간 협상과 조약을 통해 무기의 종류, 수량, 배치, 사용을 제한하거나 규제함으로써 군사적 긴장과 전쟁 위험을 줄이려는…","subcategory":"국제관계·외교안보 개념","level":2,"related":["detente"],"prerequisites":[]},{"slug":"buck-passing","title_ko":"책임전가","title_en":"Buck-Passing","meaning":"위협에 직접 맞서 비용을 부담하는 대신, 다른 국가가 그 위협에 대응하도록 떠넘기려는 전략적 행동을 말합니다.","subcategory":"국제관계·외교안보 개념","level":2,"related":["balance-of-power"],"prerequisites":[],"pop":20,"aliases":["벅패싱","책임회피"]},{"slug":"diplomacy","title_ko":"외교","title_en":"Diplomacy","meaning":"국가가 협상, 대화, 대표 파견 등 평화적 수단을 통해 다른 국가나 국제행위자와의 관계를 관리하고 자국의 이익을 추구하는…","subcategory":"국제관계·외교안보 개념","level":1,"related":[],"prerequisites":[]},{"slug":"economic-sanctions","title_ko":"경제제재","title_en":"Economic Sanctions","meaning":"특정 국가의 정책이나 행동을 변화시키기 위해 무역, 금융, 투자 등 경제적 교류를 제한하거나 차단하는 강제적 조치를 말합니다.","subcategory":"국제관계·외교안보 개념","level":1,"related":["hard-power","compellence"],"prerequisites":[]},{"slug":"geoeconomics","title_ko":"지경학","title_en":"Geoeconomics","meaning":"경제적 수단(무역, 투자, 금융, 공급망 등)을 지정학적 목표를 달성하기 위한 전략적 도구로 활용하는 현상과 이를 분석하는…","subcategory":"국제관계·외교안보 개념","level":1,"related":["geopolitics","economic-sanctions"],"prerequisites":[],"pop":3},{"slug":"groupthink-ir","title_ko":"집단사고","title_en":"Groupthink","meaning":"응집력이 강한 소규모 정책결정 집단이 만장일치를 지나치게 중시한 나머지, 대안을 충분히 검토하지 못하고 비합리적이거나 위험한…","subcategory":"국제관계·외교안보 개념","level":3,"related":["social-loafing","bystander-effect","anchoring-effect"],"prerequisites":[],"pop":7,"aliases":["집단순응사고"]},{"slug":"non-state-actors","title_ko":"비국가행위자","title_en":"Non-State Actors","meaning":"국가가 아니면서도 국제정치와 세계 정세에 실질적인 영향을 미치는 행위자로, 국제기구, 다국적기업, NGO, 테러조직 등을…","subcategory":"국제관계·외교안보 개념","level":1,"related":[],"prerequisites":[],"pop":16},{"slug":"supranationalism","title_ko":"초국가성(초국가주의 통합이론)","title_en":"Supranationalism","meaning":"회원국들이 특정 정책 영역에 대한 주권적 권한의 일부를 국가 상위의 공동 기구에 이양해, 그 기구가 회원국에 직접 구속력…","subcategory":"국제관계·외교안보 개념","level":1,"related":[],"prerequisites":[],"aliases":["초국가성","초국가성(초국가주의통합이론)","초국가주의 통합이론"]},{"slug":"hybrid-warfare","title_ko":"하이브리드전","title_en":"Hybrid Warfare","meaning":"정규군사력, 비정규전, 사이버 공격, 정보전, 경제적 압박 등 다양한 수단을 복합적으로 동원해 명확한 선전포고 없이 상대를…","subcategory":"국제관계·외교안보 개념","level":2,"related":["gray-zone-conflict"],"prerequisites":[],"pop":4,"aliases":["복합전","하이브리드전쟁"]},{"slug":"gray-zone-conflict","title_ko":"회색지대 갈등","title_en":"Gray Zone Conflict","meaning":"전면적인 무력 충돌(전쟁)과 완전한 평화 사이의 애매한 영역에서, 정규전 수준에는 못 미치지만 지속적으로 상대를 압박하는…","subcategory":"국제관계·외교안보 개념","level":2,"related":["hybrid-warfare","casus-belli"],"prerequisites":[],"pop":1,"aliases":["GZC","회색지대갈등"]},{"slug":"grand-strategy","title_ko":"대전략","title_en":"Grand Strategy","meaning":"국가가 군사, 외교, 경제 등 가용한 모든 국력 수단을 장기적 국가목표 달성을 위해 통합적으로 조율하는 최상위 수준의 전략을…","subcategory":"국제관계·외교안보 개념","level":1,"related":[],"prerequisites":[],"pop":14},{"slug":"compellence","title_ko":"강제이행","title_en":"Compellence","meaning":"상대국이 이미 시작한 행동을 중단하거나 특정한 새로운 행동을 하도록 위협이나 힘을 통해 적극적으로 강요하는 전략을 말합니다.","subcategory":"국제관계·외교안보 개념","level":1,"related":["audience-costs"],"prerequisites":[],"pop":10},{"slug":"audience-costs","title_ko":"청중비용","title_en":"Audience Costs","meaning":"지도자가 공개적으로 천명한 위협이나 공약을 실제로 이행하지 않을 경우, 국내 유권자나 여론으로부터 정치적 대가를 치르게 되는…","subcategory":"국제관계·외교안보 개념","level":1,"related":[],"prerequisites":[],"pop":2,"aliases":["관중비용"]},{"slug":"casus-belli","title_ko":"개전사유","title_en":"Casus Belli","meaning":"한 국가가 다른 국가에 대해 전쟁을 선포하거나 무력을 사용하는 것을 정당화하기 위해 내세우는 구체적인 사건이나 명분을…","subcategory":"국제관계·외교안보 개념","level":2,"related":["gray-zone-conflict"],"prerequisites":[],"pop":11,"aliases":["전쟁명분","카수스벨리"]},{"slug":"iron-triangle","title_ko":"철의삼각","title_en":"Iron Triangle","meaning":"특정 정책 분야에서 관료조직, 의회 위원회, 이익집단이라는 세 행위자가 서로 긴밀하고 안정적인 협력 관계를 형성하여 정책을…","subcategory":"조직이론·인사행정","level":3,"related":[],"prerequisites":[],"pop":8,"aliases":["Iron Triangle Theory"]}]