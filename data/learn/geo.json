[{"slug":"losch-demand-cone","title_ko":"뢰쉬의 수요원추이론","title_en":"Lösch's Demand Cone","meaning":"아우구스트 뢰쉬(A. Lösch)가 제시한 개념으로, 판매점에서 멀어질수록 운송비로 인도 가격이 올라 수요량이 줄어드는…","subcategory":"인문지리·경제지리","level":3,"related":[],"prerequisites":[],"pop":15,"aliases":["뢰쉬의수요원추이론"]},{"slug":"localization-economies","title_ko":"국지화경제","title_en":"Localization Economies","meaning":"동일하거나 관련된 산업에 속한 기업들이 한 지역에 집중함으로써 얻는 특화된 노동력, 부품 공급, 정보 공유 등의 외부경제…","subcategory":"인문지리·경제지리","level":3,"related":["agglomeration-economies"],"prerequisites":[],"aliases":["지역화경제"]},{"slug":"fordism","title_ko":"포디즘","title_en":"Fordism","meaning":"표준화된 제품을 컨베이어벨트 조립라인에서 대량생산하고, 노동자에게는 상대적으로 높은 임금을 지급해 대량소비를 뒷받침하는…","subcategory":"인문지리·경제지리","level":2,"related":["post-fordism"],"prerequisites":[],"pop":1},{"slug":"post-fordism","title_ko":"포스트포디즘","title_en":"Post-Fordism","meaning":"포디즘적 대량생산체제 이후 등장한 생산방식으로, 유연한 생산조직, 정보기술 활용, 다품종 소량생산을 특징으로 하는 축적체제를…","subcategory":"인문지리·경제지리","level":2,"related":["fordism"],"prerequisites":[],"pop":2},{"slug":"global-production-network","title_ko":"글로벌 생산네트워크","title_en":"Global Production Network","meaning":"기업, 공급업체, 노동, 국가, 소비자 등 다양한 행위자가 국경을 넘어 상호 연결되어 형성하는 생산과 유통의 네트워크를…","subcategory":"인문지리·경제지리","level":1,"related":[],"prerequisites":[],"aliases":["GPN","글로벌생산네트워크"]},{"slug":"geopolitics","title_ko":"지정학","title_en":"Geopolitics","meaning":"지리적 요인이 국가의 정치, 외교, 군사 전략에 미치는 영향을 분석하는 학문 분야로, 위치·자원·지형 등이 국제관계에 미치는…","subcategory":"인문지리·경제지리","level":1,"related":[],"prerequisites":[],"pop":11},{"slug":"sociospatial-dialectic","title_ko":"사회공간변증법","title_en":"Socio-Spatial Dialectic","meaning":"에드워드 소자(E. Soja)가 제시한 개념으로, 공간이 사회를 단순히 반영하는 것이 아니라 사회적 관계를 형성하고 동시에…","subcategory":"인문지리·경제지리","level":3,"related":[],"prerequisites":[],"pop":7},{"slug":"edge-city","title_ko":"엣지시티","title_en":"Edge City","meaning":"조엘 가로(J. Garreau)가 제시한 개념으로, 대도시 외곽의 고속도로 교차점 등에 상업·업무 기능이 새롭게 집적하여…","subcategory":"인문지리·경제지리","level":3,"related":["urban-sprawl"],"prerequisites":[],"pop":19,"aliases":["에지시티"]},{"slug":"wms","title_ko":"웹지도서비스","title_en":"Web Map Service (WMS)","meaning":"인터넷을 통해 지도영상을 표준화된 방식으로 요청하고 제공받을 수 있게 하는 OGC 표준 웹서비스이다.","subcategory":"GIS·공간분석·지역개발","level":3,"related":[],"prerequisites":[],"pop":4},{"slug":"coordinate-system","title_ko":"좌표계","title_en":"Coordinate System","meaning":"지표상의 위치를 수치로 표현하기 위해 정의된 기준체계로, 지리좌표계와 투영좌표계로 구분된다.","subcategory":"GIS·공간분석·지역개발","level":1,"related":[],"prerequisites":[]},{"slug":"plane-rectangular-coordinate-system","title_ko":"평면직각좌표계","title_en":"Plane Rectangular Coordinate System","meaning":"지구 표면의 일부를 평면에 투영한 뒤 X, Y 직교좌표로 위치를 표현하는 좌표계이다.","subcategory":"GIS·공간분석·지역개발","level":2,"related":["coordinate-system"],"prerequisites":["coordinate-system"],"aliases":["PRCS"]},{"slug":"georeferencing","title_ko":"지오레퍼런싱","title_en":"Georeferencing","meaning":"좌표정보가 없는 영상이나 지도에 지상기준점을 이용해 실제 지리좌표를 부여하는 작업이다.","subcategory":"GIS·공간분석·지역개발","level":1,"related":["image-rectification"],"prerequisites":[],"pop":8,"aliases":["좌표등록"]},{"slug":"image-rectification","title_ko":"기하보정","title_en":"Geometric Correction","meaning":"센서의 기울어짐, 지구 곡률, 지형기복 등으로 발생한 영상의 기하학적 왜곡을 보정하는 과정이다.","subcategory":"GIS·공간분석·지역개발","level":2,"related":["georeferencing"],"prerequisites":["georeferencing"]},{"slug":"thiessen-polygon","title_ko":"티센다각형","title_en":"Thiessen Polygon","meaning":"각 표본점에 대해 다른 어떤 표본점보다 그 점에 더 가까운 영역을 다각형으로 구획하는 방법이다.","subcategory":"GIS·공간분석·지역개발","level":2,"related":["kriging"],"prerequisites":[],"aliases":["보로노이","보로노이다각형"]},{"slug":"surface-analysis","title_ko":"표면분석","title_en":"Surface Analysis","meaning":"고도, 온도, 강수량 등 연속적으로 변화하는 지표현상을 격자표면으로 표현하고 그 특성을 분석하는 기법이다.","subcategory":"GIS·공간분석·지역개발","level":1,"related":[],"prerequisites":[],"pop":13},{"slug":"euclidean-distance-gis","title_ko":"유클리드거리","title_en":"Euclidean Distance (Spatial Analysis)","meaning":"두 지점 사이의 직선거리를 좌표값을 이용해 계산한 거리로, 공간분석에서 가장 기본적인 거리척도이다.","subcategory":"GIS·공간분석·지역개발","level":2,"related":[],"prerequisites":[],"aliases":["직선거리"]},{"slug":"losch-economic-landscape","title_ko":"뢰쉬 경제경관론","title_en":"Lösch Economic Landscape","meaning":"여러 재화의 서로 다른 최적 육각형 시장권을 중첩시켜 현실적인 경제경관과 도시체계를 설명한 이론이다.","subcategory":"GIS·공간분석·지역개발","level":3,"related":[],"prerequisites":[],"pop":14,"aliases":["뢰쉬경제경관론"]},{"slug":"morans-i","title_ko":"모란지수","title_en":"Moran's I","meaning":"전체 연구지역에 걸친 공간자기상관의 정도를 하나의 통계값으로 요약하여 나타내는 전역적 지표이다.","subcategory":"GIS·공간분석·지역개발","level":3,"related":["hedonic-price-model-urban"],"prerequisites":[],"pop":16,"aliases":["모란의I","모란지수 )","모란지수(Moran'sI(SpatialAutocorrelation))","모란지수)","Moran's I (Spatial Autocorrelation)"]},{"slug":"amenity-geo","title_ko":"어메니티","title_en":"Amenity","meaning":"쾌적한 자연환경, 경관, 편의시설 등 지역의 삶의 질과 입지 매력도를 높이는 비시장적 요소를 의미한다.","subcategory":"GIS·공간분석·지역개발","level":3,"related":["urban-regeneration"],"prerequisites":[],"pop":10},{"slug":"koppen-climate-classification","title_ko":"쾨펜 기후구분","title_en":"Köppen Climate Classification","meaning":"월평균 기온과 강수량을 기준으로 지구의 기후를 여러 유형으로 분류하는 체계로, 식생 분포와의 상관성을 바탕으로 열대(A)…","subcategory":"자연지리학·기후지리","level":1,"related":[],"prerequisites":[],"pop":9,"aliases":["KCC","쾨펜기후구분"]},{"slug":"desert-climate","title_ko":"사막기후","title_en":"Desert Climate (BW)","meaning":"쾨펜 기후구분의 BW형으로, 증발량이 강수량을 크게 초과해 식생이 거의 발달하지 못하는 매우 건조한 기후다.","subcategory":"자연지리학·기후지리","level":1,"related":["koppen-climate-classification","steppe-climate","desertification"],"prerequisites":[],"pop":12,"aliases":["BW기후"]},{"slug":"steppe-climate","title_ko":"스텝기후","title_en":"Steppe Climate (BS)","meaning":"쾨펜 기후구분의 BS형으로, 사막기후보다 강수량이 다소 많아 짧은 초원(스텝) 식생이 발달하는 반건조 기후다.","subcategory":"자연지리학·기후지리","level":3,"related":["koppen-climate-classification","desert-climate","desertification"],"prerequisites":["koppen-climate-classification","desert-climate"],"pop":3,"aliases":["BS기후","반건조기후"]},{"slug":"west-coast-marine-climate","title_ko":"서안해양성기후","title_en":"West Coast Marine Climate (Cfb)","meaning":"쾨펜 기후구분의 Cfb형으로, 편서풍과 해양의 영향으로 연교차가 작고 연중 강수가 고른 중위도 대륙 서안 기후다.","subcategory":"자연지리학·기후지리","level":3,"related":["koppen-climate-classification"],"prerequisites":["koppen-climate-classification"],"pop":18,"aliases":["WCMC"]},{"slug":"tundra-climate","title_ko":"툰드라기후","title_en":"Tundra Climate (ET)","meaning":"쾨펜 기후구분의 ET형으로, 가장 따뜻한 달의 평균기온이 0~10℃ 사이에 머물러 교목이 자라지 못하고 이끼·지의류 등만…","subcategory":"자연지리학·기후지리","level":2,"related":["koppen-climate-classification"],"prerequisites":["koppen-climate-classification"],"pop":5,"aliases":["ET기후"]},{"slug":"ice-cap-climate","title_ko":"빙설기후","title_en":"Ice Cap Climate (EF)","meaning":"쾨펜 기후구분의 EF형으로, 연중 기온이 0℃를 넘지 못해 만년설과 빙상이 유지되는 극지방의 기후다.","subcategory":"자연지리학·기후지리","level":3,"related":["koppen-climate-classification","tundra-climate"],"prerequisites":["koppen-climate-classification","tundra-climate"],"pop":17,"aliases":["EF기후","빙관기후"]},{"slug":"climate-feedback","title_ko":"기후피드백","title_en":"Climate Feedback","meaning":"기후 시스템 내에서 하나의 변화가 다른 변화를 증폭(양의 피드백)하거나 억제(음의 피드백)하는 상호작용 과정으로…","subcategory":"자연지리학·기후지리","level":3,"related":["milankovitch-cycles","paleoclimatology"],"prerequisites":[],"aliases":["기후되먹임"]},{"slug":"paleoclimatology","title_ko":"고기후학","title_en":"Paleoclimatology","meaning":"빙하코어, 나이테, 퇴적물, 산호 등 다양한 자연 기록(프록시)을 분석해 과거의 기후를 복원하는 학문 분야다.","subcategory":"자연지리학·기후지리","level":3,"related":["milankovitch-cycles","climate-feedback"],"prerequisites":[],"aliases":["고기후"]},{"slug":"geomorphic-process","title_ko":"지형형성작용","title_en":"Geomorphic Process","meaning":"풍화, 침식, 운반, 퇴적 등 지표의 형태를 만들고 변화시키는 물리적·화학적·생물학적 작용을 총칭하는 개념이다.","subcategory":"자연지리학·기후지리","level":2,"related":[],"prerequisites":[],"aliases":["지형형성과정"]},{"slug":"oxbow-lake","title_ko":"우각호","title_en":"Oxbow Lake","meaning":"곡류하천의 만곡부가 홍수 등으로 절단되어 본류에서 분리되면서 형성되는 초승달 모양의 호수다.","subcategory":"자연지리학·기후지리","level":3,"related":[],"prerequisites":[],"pop":20},{"slug":"fjord","title_ko":"피오르","title_en":"Fjord","meaning":"빙하가 깎아 만든 U자곡이 빙하 소멸 후 해수면 상승으로 바닷물에 잠기면서 형성된, 좁고 깊으며 양쪽이 급경사인 만(灣)…","subcategory":"자연지리학·기후지리","level":3,"related":[],"prerequisites":[],"pop":6,"aliases":["피요르드","협만"]},{"slug":"visual-hierarchy","title_ko":"시각적 위계","title_en":"Visual Hierarchy","meaning":"크기, 색상, 배치 등을 통해 화면이나 지면 내 요소들의 중요도 순서를 시각적으로 구분하여 정보 인지 순서를 유도하는 디자인…","subcategory":"제품디자인·산업디자인","level":1,"related":["gestalt-principles","figure-ground-organization"],"prerequisites":[],"aliases":["비주얼하이어라키","시각위계"]},{"slug":"albers-equal-area-conic-projection","title_ko":"알베르스 정적원추도법","title_en":"Albers Equal-Area Conic Projection","meaning":"지구본에 원뿔을 씌워 투영하되 면적을 정확히 보존하도록 설계한 원추 도법으로, 동서로 넓은 중위도 지역의 통계 지도 제작에…","subcategory":"지도 투영","level":2,"related":[],"prerequisites":[],"aliases":["AEACP","알베르스정적원추도법"]},{"slug":"azimuthal-equidistant-projection","title_ko":"정거방위도법","title_en":"Azimuthal Equidistant Projection","meaning":"지도의 중심점에서 다른 모든 지점까지의 거리와 방위를 정확하게 표현하는 방위 도법이다.","subcategory":"지도 투영","level":2,"related":[],"prerequisites":[]},{"slug":"cartographic-aggregation","title_ko":"도형 집단화","title_en":"Cartographic Aggregation","meaning":"서로 가까이 위치한 여러 개별 도형 요소를 축척이 작아질 때 하나의 대표 형태로 묶어 표현하는 지도 일반화 기법이다.","subcategory":"지도 일반화","level":2,"related":[],"prerequisites":[],"aliases":["도형집단화"]},{"slug":"figure-ground-organization","title_ko":"도형-배경 조직화","title_en":"Figure-Ground Organization","meaning":"보는 사람이 시각적 장면을 주된 형태(도형)와 그 뒤의 배경으로 자연스럽게 구분하여 지각하는 인지 원리이다.","subcategory":"지도 인지","level":2,"related":["visual-hierarchy"],"prerequisites":[],"aliases":["FGO","도형 배경 조직화","도형-배경조직화","도형배경 조직화"]},{"slug":"stereographic-projection","title_ko":"평사도법","title_en":"Stereographic Projection","meaning":"지구본 표면의 한 점(주로 극점 반대편)을 시점으로 삼아 반대쪽 접평면에 빛을 투영하는 방식으로, 지점 주변 형태와 각도를…","subcategory":"지도 투영","level":2,"related":[],"prerequisites":[],"aliases":["평사투영법"]},{"slug":"equirectangular-projection","title_ko":"등장방형도법","title_en":"Equirectangular Projection","meaning":"위도와 경도를 각각 일정한 간격의 직선 좌표로 그대로 옮겨 정사각형 격자를 만드는 가장 단순한 지도 투영법이다.","subcategory":"지도 투영","level":2,"related":[],"prerequisites":[]},{"slug":"dilution-of-precision","title_ko":"정밀도저하율(DOP)","title_en":"Dilution of Precision","meaning":"관측에 이용된 위성들의 기하학적 배치가 측위 정확도에 미치는 영향을 나타내는 지표이다.","subcategory":"측량·원격탐사","level":2,"related":[],"prerequisites":[],"aliases":["정밀도저하율"]},{"slug":"passive-remote-sensing","title_ko":"수동형 원격탐사","title_en":"Passive Remote Sensing","meaning":"태양광 등 외부 광원에서 반사되거나 지표면 스스로 방출하는 에너지를 센서가 받아들여 관측하는 원격탐사 방식이다.","subcategory":"측량·원격탐사","level":2,"related":[],"prerequisites":[],"aliases":["수동형원격탐사"]},{"slug":"vector-to-raster-conversion","title_ko":"벡터-래스터 변환","title_en":"Vector-to-Raster Conversion","meaning":"점·선·면으로 표현된 벡터 공간자료를 격자(셀) 형태의 래스터 자료로 바꾸는 변환 과정이다.","subcategory":"공간자료 처리","level":2,"related":[],"prerequisites":[],"aliases":["VRC","벡터 래스터 변환","벡터-래스터변환","벡터래스터 변환"]},{"slug":"environmental-determinism","title_ko":"환경결정론","title_en":"Environmental Determinism","meaning":"기후·지형 등 자연환경이 한 사회의 발전 경로와 문화를 미리 결정한다고 보는 지리학의 이론이다.","subcategory":"인문지리·경제지리","level":2,"related":[],"prerequisites":[],"aliases":["환경 결정론","지리적 결정론","geographical determinism"]}]