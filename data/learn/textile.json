[{"slug":"fiber-crystallinity","title_ko":"섬유 결정화도","title_en":"Fiber Crystallinity","meaning":"섬유를 이루는 고분자 사슬 가운데 규칙적으로 배열되어 결정 구조를 이루는 부분이 전체에서 차지하는 비율을 말합니다.","subcategory":"섬유재료학","level":2,"related":[],"prerequisites":[],"aliases":["섬유결정화도"]},{"slug":"fabric-count","title_ko":"직물밀도","title_en":"Fabric Count","meaning":"일정 길이(보통 1인치 또는 1cm) 안에 들어 있는 경사와 위사의 올 수를 나타내는 값으로, 직물이 얼마나 촘촘하게…","subcategory":"직물조직/제직학","level":2,"related":["cover-factor"],"prerequisites":[],"aliases":["경위밀도","직물 밀도"]},{"slug":"cover-factor","title_ko":"커버팩터","title_en":"Cover Factor","meaning":"실의 굵기와 밀도를 함께 고려하여 직물 표면이 실로 덮여 있는 비율을 나타내는 지표입니다.","subcategory":"직물조직/제직학","level":2,"related":["fabric-count"],"prerequisites":[],"pop":12},{"slug":"ease-allowance","title_ko":"여유량","title_en":"Ease Allowance","meaning":"여유량은 인체 치수에 옷을 만들 때 활동성과 착용감을 위해 실제 신체 치수보다 더 넉넉하게 추가하는 치수를 의미합니다.","subcategory":"의복구성/패턴설계","level":2,"related":[],"prerequisites":[],"aliases":["여유분","이즈량"]},{"slug":"wearable-technology","title_ko":"웨어러블 테크놀로지","title_en":"Wearable Technology","meaning":"신체에 착용한 상태로 정보를 수집·처리하거나 기능을 수행하는 전자기기 및 의류 제품을 뜻합니다.","subcategory":"기능성/스마트 의류","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["웨어러블테크놀로지"]},{"slug":"avant-garde-fashion","title_ko":"아방가르드패션","title_en":"Avant-Garde Fashion","meaning":"아방가르드패션(Avant-Garde Fashion)은 기존의 미적 규범과 착용 방식을 의도적으로 해체하거나 전복하여…","subcategory":"패션디자인/트렌드","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["Avant-Garde Fashion","AGF"]},{"slug":"circular-knitting-machine","title_ko":"환편기","title_en":"Circular Knitting Machine","meaning":"편침이 원통형으로 배열되어 실린더가 회전하면서 원통 형태의 편성물을 연속적으로 생산하는 편직 기계입니다.","subcategory":"편성물학","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["Circular Knitting Machine","CKM"]},{"slug":"elastic-recovery-rate","title_ko":"탄성회복률","title_en":"Elastic Recovery Rate","meaning":"섬유나 직물을 늘였다가 힘을 제거했을 때 원래 길이로 되돌아가는 정도를 백분율로 나타낸 값입니다.","subcategory":"섬유·직물 물성평가","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["Elastic Recovery Rate"]},{"slug":"kubelka-munk-theory","title_ko":"쿠벨카-뭉크이론","title_en":"Kubelka-Munk Theory","meaning":"불투명하거나 반투명한 착색 재료의 흡광계수(K)와 산란계수(S)의 비율로부터 반사율을 예측하는 광학 이론입니다.","subcategory":"색채학","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["Kubelka-Munk Theory","쿠벨카 뭉크이론","쿠벨카뭉크이론"]},{"slug":"water-repellency-test","title_ko":"발수성시험","title_en":"Water Repellency Test","meaning":"직물 표면에 물을 뿌려 물방울이 스며들지 않고 얼마나 잘 튕겨나가는지를 등급으로 평가하는 시험법입니다.","subcategory":"섬유·직물 물성평가","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["Water Repellency Test","WRT"]},{"slug":"water-repellent-finish","title_ko":"발수가공","title_en":"Water Repellent Finish","meaning":"직물 표면의 표면장력을 낮춰 물방울이 섬유 조직 속으로 스며들지 않고 굴러 떨어지게 만드는 기능성 가공입니다.","subcategory":"염색가공학","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["Water Repellent Finish"]},{"slug":"wool-scale-structure","title_ko":"양모스케일구조","title_en":"Wool Scale Structure","meaning":"양모 섬유의 표면을 덮고 있는 비늘 모양의 큐티클층 배열 구조를 말합니다.","subcategory":"섬유재료학","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["Wool Scale Structure"]}]