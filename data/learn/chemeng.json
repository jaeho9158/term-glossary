[{"slug":"catalyst-poisoning","title_ko":"촉매 피독","title_en":"Catalyst Poisoning","meaning":"불순물이나 특정 화학종이 촉매 활성점에 강하게 흡착하여 촉매의 활성을 저해하는 비활성화 유형입니다.","subcategory":"반응공학·촉매공정","level":2,"related":[],"prerequisites":[],"aliases":["촉매피독"]},{"slug":"continuous-stirred-tank-reactor","title_ko":"연속교반탱크반응기","title_en":"Continuous Stirred-Tank Reactor","meaning":"원료가 연속적으로 유입되고 생성물이 연속적으로 유출되며, 내부가 교반을 통해 균일한 조성으로 유지된다고 가정하는 반응기…","subcategory":"반응공학·촉매공정","level":2,"related":[],"prerequisites":[]},{"slug":"trickle-bed-reactor","title_ko":"트리클층 반응기","title_en":"Trickle Bed Reactor","meaning":"고정된 촉매층 위쪽에서 액체를 방울져 흘러내리게 하고 동시에 기체를 함께 통과시켜, 기체·액체·고체 세 상이 동시에 접촉하며…","subcategory":"반응공학·촉매공정","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["트리클층반응기"]},{"slug":"haber-bosch-process","title_ko":"하버-보슈 공정","title_en":"Haber–Bosch Process","meaning":"고온·고압 조건에서 촉매를 이용해 공기 중의 질소와 수소를 직접 반응시켜 암모니아를 합성하는 공정입니다.","subcategory":"반응공학·촉매공정","level":2,"related":[],"prerequisites":[],"pop":12,"aliases":["하버 보슈 공정","하버-보슈공정","하버보슈 공정"]},{"slug":"electrocatalysis","title_ko":"전기촉매작용","title_en":"Electrocatalysis","meaning":"전극 표면의 촉매가 전기화학 반응의 활성화 에너지를 낮춰 반응 속도를 높이는 현상을 말합니다.","subcategory":"반응공학·촉매공정","level":2,"related":[],"prerequisites":[]},{"slug":"michaelis-menten-kinetics","title_ko":"미카엘리스-멘텐 반응속도론","title_en":"Michaelis–Menten Kinetics","meaning":"효소가 기질과 결합해 생성물을 만드는 반응에서, 기질 농도에 따라 반응 속도가 어떻게 변하는지를 설명하는 속도식입니다.","subcategory":"반응공학·촉매공정","level":2,"related":[],"prerequisites":[],"aliases":["미카엘리스 멘텐 반응속도론","미카엘리스-멘텐반응속도론","미카엘리스멘텐 반응속도론"]},{"slug":"ziegler-natta-catalyst","title_ko":"지글러-나타 촉매","title_en":"Ziegler–Natta Catalyst","meaning":"전이금속 화합물과 유기알루미늄 조촉매로 구성되어 올레핀을 입체규칙적으로 중합시키는 촉매 시스템입니다.","subcategory":"반응공학·촉매공정","level":2,"related":[],"prerequisites":[],"aliases":["지글러 나타 촉매","지글러-나타촉매","지글러나타 촉매"]},{"slug":"vapor-liquid-equilibrium","title_ko":"기액평형","title_en":"Vapor–Liquid Equilibrium","meaning":"일정한 온도와 압력에서 액체상과 기체상이 서로 물질을 주고받으며 더 이상 조성이 변하지 않는 상태에 도달했을 때, 두 상의…","subcategory":"분리공정·물질전달","level":2,"related":[],"prerequisites":[],"aliases":["VLE"]},{"slug":"mccabe-thiele-method","title_ko":"맥케이브-틸레 방법","title_en":"McCabe–Thiele Method","meaning":"이성분 증류탑의 이론단수를 x-y 평형선도 위에서 조작선과 평형곡선 사이를 계단식으로 그려 구하는 도해적 설계법입니다.","subcategory":"분리공정·물질전달","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["맥케이브 틸레 방법","맥케이브-틸레방법","맥케이브틸레 방법","조작선"]},{"slug":"azeotropic-distillation","title_ko":"공비증류","title_en":"Azeotropic Distillation","meaning":"일반 증류로는 분리할 수 없는 공비혼합물을 분리하기 위해 제3의 물질(공비제)을 첨가해 새로운 공비점을 만들어내는 증류…","subcategory":"분리공정·물질전달","level":2,"related":["pressure-swing-distillation"],"prerequisites":[],"pop":9},{"slug":"pressure-swing-distillation","title_ko":"압력변동증류","title_en":"Pressure-Swing Distillation","meaning":"공비점이 압력에 따라 조성이 달라지는 성질을 이용해 서로 다른 압력에서 운전되는 두 개의 증류탑을 조합하여 공비혼합물을…","subcategory":"분리공정·물질전달","level":2,"related":["azeotropic-distillation"],"prerequisites":[]},{"slug":"solvent-selection-extraction","title_ko":"추출용매 선정","title_en":"Solvent Selection for Extraction","meaning":"추출 공정에서 목적 성분에 대한 용해도, 선택도, 회수 용이성, 안전성 등을 종합적으로 고려해 가장 적합한 용매를 고르는…","subcategory":"분리공정·물질전달","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["추출용매선정"]},{"slug":"freundlich-isotherm","title_ko":"프로인들리히 등온식","title_en":"Freundlich Isotherm","meaning":"고체 표면에 대한 기체 또는 용질의 흡착량과 압력(또는 농도) 사이의 경험적 관계를 지수함수 형태로 나타낸 흡착 등온식입니다.","subcategory":"분리공정·물질전달","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["프로인들리히등온식"]},{"slug":"concentration-polarization","title_ko":"농도분극","title_en":"Concentration Polarization","meaning":"막분리 공정에서 막을 통과하지 못한 용질이 막 표면 근처에 쌓여 국소 농도가 벌크 농도보다 높아지는 현상입니다.","subcategory":"분리공정·물질전달","level":2,"related":[],"prerequisites":[]},{"slug":"pervaporation","title_ko":"침투증발","title_en":"Pervaporation","meaning":"액체 혼합물을 막에 접촉시켜 특정 성분을 막 반대편에서 증기 형태로 선택적으로 투과·증발시켜 분리하는 막분리 공정입니다.","subcategory":"분리공정·물질전달","level":2,"related":[],"prerequisites":[],"aliases":["퍼베이퍼레이션"]},{"slug":"mass-balance-process","title_ko":"공정 물질수지","title_en":"Process Mass Balance","meaning":"질량 보존 법칙에 따라 공정으로 들어오고 나가는 물질의 양을 정량적으로 정리한 수지 계산입니다.","subcategory":"공정설계·플랜트엔지니어링","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["PMB","공정물질수지"]},{"slug":"process-equipment-costing","title_ko":"공정장비 비용산정","title_en":"Process Equipment Costing","meaning":"반응기, 열교환기, 펌프 등 개별 공정장비의 구입 및 설치 비용을 크기·재질·설계압력 등의 사양으로부터 추정하는 작업입니다.","subcategory":"공정설계·플랜트엔지니어링","level":2,"related":["operating-expenditure-analysis"],"prerequisites":[],"aliases":["공정장비비용산정"]},{"slug":"operating-expenditure-analysis","title_ko":"운영비 분석","title_en":"Operating Expenditure Analysis","meaning":"원료비, 유틸리티비, 인건비, 유지보수비 등 공장을 실제로 가동하면서 지속적으로 발생하는 비용(OPEX)을 산정하고 분석하는…","subcategory":"공정설계·플랜트엔지니어링","level":2,"related":["process-equipment-costing"],"prerequisites":[],"aliases":["운영비분석"]},{"slug":"process-optimization-nonlinear-programming","title_ko":"공정최적화","title_en":"Process Optimization","meaning":"공정변수와 설계변수를 조정하여 비용, 수율, 에너지 소비 등의 목적함수를 제약조건 안에서 최선의 값으로 만드는 수학적 최적화…","subcategory":"공정설계·플랜트엔지니어링","level":2,"related":[],"prerequisites":[]},{"slug":"post-combustion-carbon-capture","title_ko":"연소후 탄소포집","title_en":"Post-Combustion Carbon Capture","meaning":"연료를 이미 연소시킨 후 배출되는 배가스에서 이산화탄소를 분리·포집하는 탄소포집 방식입니다.","subcategory":"환경화공·에너지공정","level":2,"related":["oxy-fuel-combustion"],"prerequisites":[],"aliases":["연소후탄소포집"]},{"slug":"oxy-fuel-combustion","title_ko":"순산소연소","title_en":"Oxy-Fuel Combustion","meaning":"공기 대신 순수한 산소를 사용해 연료를 연소시켜, 배가스가 주로 이산화탄소와 수증기로만 이루어지게 함으로써 이산화탄소 포집을…","subcategory":"환경화공·에너지공정","level":2,"related":["post-combustion-carbon-capture"],"prerequisites":[],"pop":10},{"slug":"green-chemistry-principles","title_ko":"녹색화학 원리","title_en":"Green Chemistry Principles","meaning":"화학물질과 공정을 설계할 때 유해성을 줄이고 자원과 에너지를 효율적으로 사용하도록 유도하는 12가지 지침으로 구성된 화학 및…","subcategory":"환경화공·에너지공정","level":2,"related":["biodiesel-production","hydrogen-production-electrolysis"],"prerequisites":[],"pop":1,"aliases":["녹색화학원리"]},{"slug":"biodiesel-production","title_ko":"바이오디젤 생산","title_en":"Biodiesel Production","meaning":"식물성 기름이나 동물성 지방을 알코올과 반응(트랜스에스테르화)시켜 경유를 대체할 수 있는 지방산 알킬에스테르 연료를 만드는…","subcategory":"환경화공·에너지공정","level":2,"related":["green-chemistry-principles"],"prerequisites":[],"aliases":["바이오디젤생산"]},{"slug":"hydrogen-production-electrolysis","title_ko":"전기분해 수소생산","title_en":"Hydrogen Production via Electrolysis","meaning":"전기 에너지를 이용해 물을 수소와 산소로 분해하여 수소를 생산하는 공정입니다.","subcategory":"환경화공·에너지공정","level":2,"related":["alkaline-water-electrolysis","fuel-cell-technology"],"prerequisites":[],"aliases":["HPVE","전기분해수소생산"]},{"slug":"alkaline-water-electrolysis","title_ko":"알칼리 수전해","title_en":"Alkaline Water Electrolysis","meaning":"수산화칼륨 등 알칼리 수용액을 전해질로 사용하여 물을 수소와 산소로 전기분해하는, 가장 오래되고 기술적으로 성숙한 수전해…","subcategory":"환경화공·에너지공정","level":2,"related":["hydrogen-production-electrolysis"],"prerequisites":[],"aliases":["AWE","알칼리수전해"]},{"slug":"fuel-cell-technology","title_ko":"연료전지 기술","title_en":"Fuel Cell Technology","meaning":"수소와 산소 같은 연료의 전기화학 반응을 통해 연소 없이 직접 전기와 열을 생산하는 발전 기술입니다.","subcategory":"환경화공·에너지공정","level":2,"related":["solid-oxide-fuel-cell","hydrogen-production-electrolysis"],"prerequisites":[],"pop":5,"aliases":["연료전지기술"]},{"slug":"solid-oxide-fuel-cell","title_ko":"고체산화물 연료전지","title_en":"Solid Oxide Fuel Cell","meaning":"고체 세라믹 전해질을 사용해 고온(대략 600~1000도 수준)에서 작동하며 수소뿐 아니라 다양한 연료를 활용해 전기를…","subcategory":"환경화공·에너지공정","level":2,"related":["fuel-cell-technology"],"prerequisites":[],"pop":7,"aliases":["SOFC","고체산화물연료전지"]},{"slug":"power-to-gas-conversion","title_ko":"전력가스변환(P2G)","title_en":"Power-to-Gas Conversion","meaning":"잉여 전력을 이용해 물을 전기분해하여 수소를 만들고, 이를 다시 메탄 등의 기체 연료로 전환해 저장·활용하는 에너지 변환…","subcategory":"환경화공·에너지공정","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["P2G","전력가스변환"]},{"slug":"pyrolysis-oil-upgrading","title_ko":"열분해유 업그레이딩","title_en":"Pyrolysis Oil Upgrading","meaning":"바이오매스나 폐플라스틱의 열분해로 얻은 원유 형태의 열분해유를 수소화, 탈산소 등 추가 공정으로 개