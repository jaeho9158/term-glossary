[{"slug":"environmental-lapse-rate","title_ko":"환경감률","title_en":"Environmental Lapse Rate","meaning":"특정 시각·장소에서 실제로 관측된 대기의 고도에 따른 온도 변화율을 뜻합니다.","subcategory":"대기열역학","level":2,"related":[],"prerequisites":[],"pop":2},{"slug":"ageostrophic-wind","title_ko":"비지균풍","title_en":"Ageostrophic Wind","meaning":"실제 바람에서 지균풍 성분을 뺀 나머지, 즉 기압경도력과 전향력이 정확히 균형을 이루지 못해 생기는 바람 성분을 뜻합니다.","subcategory":"대기역학","level":2,"related":[],"prerequisites":[]},{"slug":"cloud-condensation-nuclei","title_ko":"구름응결핵","title_en":"Cloud Condensation Nuclei","meaning":"대기 중 수증기가 응결해 구름방울을 형성할 때 씨앗 역할을 하는 미세한 에어로졸 입자입니다.","subcategory":"구름 및 강수물리학","level":2,"related":[],"prerequisites":[],"aliases":["CCN","응결핵"]},{"slug":"marshall-palmer-distribution","title_ko":"마셜-파머 분포","title_en":"Marshall–Palmer Distribution","meaning":"빗방울의 크기별 개수 농도가 지름이 커질수록 지수함수적으로 감소한다고 가정하는 대표적인 강수 입자 크기분포 모델입니다.","subcategory":"구름 및 강수물리학","level":2,"related":[],"prerequisites":[],"aliases":["마셜 파머 분포","마셜-파머분포","마셜파머 분포"]},{"slug":"tropical-depression","title_ko":"열대저압부","title_en":"Tropical Depression","meaning":"열대 해상에서 조직화된 대류와 함께 저기압성 순환이 뚜렷해지기 시작한, 태풍으로 발달하기 전 단계의 열대저기압을 말합니다.","subcategory":"열대기상학","level":2,"related":[],"prerequisites":[],"pop":4},{"slug":"madden-julian-oscillation","title_ko":"매든-줄리안 진동","title_en":"Madden–Julian Oscillation","meaning":"매든-줄리안 진동(MJO)은 열대 지역에서 대류와 강수 활동의 중심이 동쪽으로 서서히 이동하며 대략 30~60일 주기로…","subcategory":"열대기상학","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["매든 줄리안 진동","매든-줄리안진동","매든줄리안 진동"]},{"slug":"bulk-richardson-number","title_ko":"벌크리처드슨수","title_en":"Bulk Richardson Number","meaning":"두 고도 사이의 온위 차와 풍속 차를 이용해 대기의 안정도와 난류 발생 가능성을 판단하는 무차원 지표입니다.","subcategory":"대기경계층","level":2,"related":["monin-obukhov-similarity-function"],"prerequisites":[],"aliases":["Bulk Richardson Number"]},{"slug":"monin-obukhov-similarity-function","title_ko":"모닌-오부코프 상사함수","title_en":"Monin–Obukhov Similarity Function","meaning":"접지층에서 바람과 온도의 연직 분포가 안정도에 따라 지균풍이나 지표 플럭스와 어떤 무차원