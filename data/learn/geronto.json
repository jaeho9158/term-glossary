[{"slug":"entropy","title_ko":"엔트로피","title_en":"Entropy","meaning":"계가 가질 수 있는 미시 상태의 수가 얼마나 많은지를 나타내는 열역학적 척도로, 흔히 무질서한 정도에 비유된다.","subcategory":"열역학","level":1,"related":["enthalpy","gibbs-free-energy","heat-engine"],"prerequisites":[]},{"slug":"homeostasis","title_ko":"항상성","title_en":"Homeostasis","meaning":"생물이 외부 환경이 변해도 체온, 혈당, pH 같은 내부 상태를 일정한 범위로 유지하려는 성질이다.","subcategory":"생리·발생","level":1,"related":["symbiosis","action-potential","mitochondria","apoptosis","circadian-rhythm","regulator-subsystem","neuman-systems-model"],"prerequisites":[],"aliases":["호메오스타시스","호메오스테이시스"]},{"slug":"palliative-care","title_ko":"완화의료","title_en":"Palliative Care","meaning":"질병을 완치하는 것이 아니라 통증과 증상을 줄여 환자의 삶의 질을 높이는 데 초점을 맞춘 의료이다.","subcategory":"치료·약리","level":2,"related":["quality-adjusted-life-year"],"prerequisites":[],"pop":7,"aliases":["완화치료","고통완화의료","완화돌봄"]},{"slug":"universal-basic-income","title_ko":"기본소득","title_en":"Universal Basic Income","meaning":"소득이나 자산, 근로 여부와 상관없이 모든 국민에게 정기적으로 동일한 금액의 현금을 지급하는 정책 구상이다.","subcategory":"정치·정책","level":2,"related":["welfare-state","income-redistribution","gini-coefficient","opportunity-cost","negative-income-tax"],"prerequisites":["welfare-state","income-redistribution"],"aliases":["UBI","기본소득제","보편적기본소득","Basic Income"]},{"slug":"frailty-index","title_ko":"노쇠지수","title_en":"Frailty Index","meaning":"질병, 신체 기능 저하, 인지 문제 등 수십 가지 건강 \"결손\" 항목 중 환자가 가진 항목의 비율을 계산해 노쇠 정도를…","subcategory":"진단·검사","level":2,"related":["multimorbidity","clinical-frailty-scale"],"prerequisites":[],"pop":2,"aliases":["결손누적지수","프레일티인덱스","허약지수"]},{"slug":"cognitive-reserve","title_ko":"인지예비능","title_en":"Cognitive Reserve","meaning":"교육, 직업적 경험, 지적 활동 등을 통해 쌓인 뇌의 효율성과 유연성 덕분에 같은 정도의 뇌 손상에도 인지기능 저하가 더디게…","subcategory":"인지신경과학","level":3,"related":["neuroplasticity","mini-mental-state-examination"],"prerequisites":[],"pop":8},{"slug":"beers-criteria","title_ko":"비어스 기준","title_en":"Beers Criteria","meaning":"노인 환자에게 잠재적으로 부적절하거나 위해가 이득을 초과할 수 있는 약물 목록을 정리해 처방 시 참고하도록 만든 전문가 합의…","subcategory":"발달·생애주기건강","level":1,"related":["potentially-inappropriate-medication-elderly"],"prerequisites":[],"pop":4,"aliases":["비어스리스트"]},{"slug":"gatekeeping","title_ko":"게이트키핑(게이트키핑 이론)","title_en":"Gatekeeping","meaning":"수많은 정보 중 무엇을 뉴스로 선택하고 무엇을 배제할지 결정하는 언론의 편집 과정.","subcategory":"커뮤니케이션이론·저널리즘","level":1,"related":["case-management"],"prerequisites":[],"aliases":["게이트키핑 이론","Gatekeeping Theory","문지기 이론","게이트키핑이론"]},{"slug":"soap-charting","title_ko":"SOAP기록","title_en":"SOAP Charting","meaning":"주관적자료(S), 객관적자료(O), 사정(A), 계획(P)의 네 요소로 구성하여 문제 중심으로 기록하는 방식이다.","subcategory":"간호이론·간호과정","level":1,"related":[],"prerequisites":[],"aliases":["SOAP","SOAP노트","SOAP Recording"]},{"slug":"case-management","title_ko":"사례관리","title_en":"Case Management","meaning":"복잡한 건강문제를 가진 환자의 치료 과정을 조정하여 비용효율적이고 연속적인 돌봄을 제공하는 간호관리 접근법.","subcategory":"임상간호·간호관리","level":1,"related":["critical-pathway","vocational-rehabilitation"],"prerequisites":[],"aliases":["Case Management in Rehabilitation","케이스매니지먼트"]},{"slug":"addiction","title_ko":"중독","title_en":"Addiction","meaning":"해로운 결과를 알면서도 마약·알코올 같은 물질이나 도박·게임 같은 행동을 스스로 조절하지 못하고 반복하는 상태이다.","subcategory":"성격·임상심리","level":1,"related":[],"prerequisites":[],"aliases":["addiction","의존증"]},{"slug":"gerotranscendence","title_ko":"노년초월이론","title_en":"gerotranscendence","meaning":"노년기 후반에 물질적·합리적 세계관에서 벗어나 우주적·초월적 관점으로 전환하며 내적 성숙과 만족을 이루어 간다고 보는…","subcategory":"노화이론·노인복지","level":1,"related":["erikson-integrity-vs-despair"],"prerequisites":[],"pop":6,"aliases":["노년초월","제로트랜센던스"]},{"slug":"erikson-integrity-vs-despair","title_ko":"자아통합 대 절망","title_en":"ego integrity vs. despair","meaning":"에릭슨의 심리사회적 발달단계 중 마지막 단계로, 노년기에 자신의 삶을 돌아보며 통합감을 느끼거나 절망감을 느끼는 심리적…","subcategory":"노화이론·노인복지","level":1,"related":["gerotranscendence","reminiscence-therapy"],"prerequisites":[],"pop":13,"aliases":["EIVD","자아통합대절망"]},{"slug":"basic-pension","title_ko":"기초연금","title_en":"basic pension","meaning":"일정 연령 이상의 소득 하위 노인에게 매월 일정 금액을 지급하여 노후 소득을 보장하는 공공부조 성격의 제도를 말한다.","subcategory":"노화이론·노인복지","level":1,"related":[],"prerequisites":[],"aliases":["기초노령연금"]},{"slug":"reminiscence-therapy","title_ko":"회상요법","title_en":"reminiscence therapy","meaning":"노인이 과거의 사건, 감정, 경험을 이야기하거나 함께 나누도록 함으로써 인지 자극과 정서적 만족을 돕는 비약물적 치료…","subcategory":"노화이론·노인복지","level":1,"related":[],"prerequisites":[],"aliases":["추억요법","회상치료"]},{"slug":"respite-care","title_ko":"단기보호서비스","title_en":"respite care","meaning":"가족 돌봄자가 일시적으로 돌봄에서 벗어나 휴식을 취할 수 있도록 노인을 단기간 시설에서 보호하는 서비스를 말한다.","subcategory":"노화이론·노인복지","level":2,"related":[],"prerequisites":[],"aliases":["레스핏케어","단기보호","Short-term Care"]},{"slug":"geriatric-syndrome","title_ko":"노인증후군","title_en":"geriatric syndrome","meaning":"낙상, 섬망, 요실금, 노쇠 등 노년기에 여러 만성 위험요인이 복합적으로 작용하여 나타나는 다인성 건강문제군을 말한다.","subcategory":"노화이론·노인복지","level":1,"related":[],"prerequisites":[],"pop":10,"aliases":["노인증후군군"]},{"slug":"selective-optimization-with-compensation","title_ko":"선택적 적정화 및 보상이론","title_en":"selective optimization with compensation","meaning":"노년기에 제한된 자원 속에서 목표를 선택하고, 남은 능력을 최적화하며, 상실된 기능을 다른 수단으로 보상함으로써 성공적으로…","subcategory":"노화이론·노인복지","level":3,"related":["gerotranscendence"],"prerequisites":[],"pop":12,"aliases":["선택적적정화및보상이론"]},{"slug":"clinical-frailty-scale","title_ko":"임상노쇠척도","title_en":"Clinical Frailty Scale (CFS)","meaning":"임상의의 종합적 판단으로 노인의 건강 상태를 1(매우 건강함)부터 9(말기 질환)까지 시각적으로 등급화하는 척도.","subcategory":"노인의료·장기요양","level":3,"related":["frailty-index"],"prerequisites":["frailty-index"],"pop":3,"aliases":["임상쇠약척도"]},{"slug":"functional-decline","title_ko":"기능저하","title_en":"Functional Decline","meaning":"질병, 입원, 노화 등으로 일상생활 수행에 필요한 신체적·인지적 기능이 점진적 또는 급격하게 감소하는 상태.","subcategory":"노인의료·장기요양","level":1,"related":[],"prerequisites":[],"aliases":["기능상실","신체기능저하"]},{"slug":"potentially-inappropriate-medication-elderly","title_ko":"잠재적부적절처방약물","title_en":"Potentially Inappropriate Medication (PIM)","meaning":"노인에서 이득보다 위해 위험이 크거나 더 안전한 대체제가 있음에도 처방되는 약물.","subcategory":