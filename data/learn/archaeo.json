[{"slug":"peer-review","title_ko":"동료심사","title_en":"Peer Review","meaning":"같은 분야 전문가들이 논문의 질과 타당성을 검토하는 출판 전 절차.","subcategory":"출판·저작권","level":1,"related":["literature-review","confirmation-bias"],"prerequisites":[],"pop":1,"aliases":["동료평가","Peer Review in Archaeology"]},{"slug":"excavation-trench","title_ko":"발굴트렌치","title_en":"Excavation Trench","meaning":"유적의 층위와 유구를 확인하기 위하여 일정한 폭과 방향으로 길게 파 내려가는 조사 구덩이를 말한다.","subcategory":"고고학방법론·발굴기법","level":1,"related":[],"prerequisites":[]},{"slug":"associated-artifacts","title_ko":"공반유물","title_en":"Associated Artifacts","meaning":"동일한 유구나 동일한 층위에서 함께 출토되어 서로 시간적·기능적 연관성이 있다고 판단되는 유물들을 가리킨다.","subcategory":"고고학방법론·발굴기법","level":1,"related":[],"prerequisites":[],"pop":4},{"slug":"harris-matrix","title_ko":"해리스매트릭스","title_en":"Harris Matrix","meaning":"발굴로 확인된 모든 층위와 유구의 선후관계를 도표 형태로 표시하여 유적 전체의 상대적 시간 순서를 체계적으로 정리하는 층위…","subcategory":"고고학방법론·발굴기법","level":1,"related":["archaeological-context"],"prerequisites":[],"pop":3},{"slug":"archaeological-context","title_ko":"콘텍스트","title_en":"Archaeological Context","meaning":"유물이나 유구가 발견된 지점의 층위적·공간적 위치와 그것을 둘러싼 다른 자료와의 관계를 총칭하는 개념으로, 유물 해석의 기본…","subcategory":"고고학방법론·발굴기법","level":1,"related":[],"prerequisites":[],"pop":8},{"slug":"thermoluminescence-dating","title_ko":"열발광연대측정","title_en":"Thermoluminescence Dating","meaning":"토기나 소성 광물 결정 속에 방사선 피폭으로 축적된 에너지를 가열하여 방출되는 빛의 양을 측정함으로써 마지막으로 가열된…","subcategory":"고고학방법론·발굴기법","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["TL연대측정","열형광연대측정"]},{"slug":"arbitrary-level","title_ko":"인위층위","title_en":"Arbitrary Level","meaning":"자연적인 토층 경계가 명확하지 않을 때 일정한 두께(예: 10cm) 단위로 임의로 설정하여 발굴을 진행하는 인위적인 굴착…","subcategory":"고고학방법론·발굴기법","level":2,"related":[],"prerequisites":[]},{"slug":"sieving","title_ko":"체질법","title_en":"Sieving","meaning":"발굴 토양을 일정한 눈 크기의 체에 통과시켜 육안으로 놓치기 쉬운 소형 유물과 생태 유체를 선별해내는 기법으로, 습식체질과…","subcategory":"고고학방법론·발굴기법","level":3,"related":[],"prerequisites":[],"pop":2},{"slug":"microlith","title_ko":"세석기","title_en":"Microlith","meaning":"크기가 매우 작은 뗀석기로, 낱개 또는 여러 개를 자루에 결합하여 사용한 도구이다.","subcategory":"선사고고학·역사고고학","level":2,"related":["tanged-point"],"prerequisites":[],"aliases":["잔석기"]},{"slug":"tanged-point","title_ko":"슴베찌르개","title_en":"Tanged Point","meaning":"자루에 장착하기 위한 슴베(자루부)를 가진 찌르개로, 한반도 후기구석기시대를 대표하는 사냥도구이다.","subcategory":"선사고고학·역사고고학","level":2,"related":[],"prerequisites":[],"aliases":["유경첨두기"]},{"slug":"levallois-technique","title_ko":"르발루아기법","title_en":"Levallois Technique","meaning":"몸돌을 미리 정교하게 손질하여 원하는 형태의 격지를 예측 가능하게 떼어내는 중기구석기시대의 석기 제작 기법이다.","subcategory":"선사고고학·역사고고학","level":2,"related":[],"prerequisites":[]},{"slug":"homo-erectus","title_ko":"호모에렉투스","title_en":"Homo Erectus","meaning":"약 190만 년 전부터 아프리카와 아시아 등지에 널리 분포했던 화석 인류로, 전기구석기시대 석기 제작과 관련된다.","subcategory":"선사고고학·역사고고학","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["곧선사람"]}]