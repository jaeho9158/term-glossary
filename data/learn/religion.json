[{"slug":"emic-etic","title_ko":"에믹/에틱","title_en":"Emic/Etic","meaning":"언어학자 케네스 파이크가 제안하고 인류학에 도입된 개념으로, 그 문화 구성원의 내부자적 관점에서 의미를 이해하려는…","subcategory":"인류학·문화","level":3,"related":["cultural-relativism"],"prerequisites":["cultural-relativism"],"pop":12,"aliases":["에믹","에틱"]},{"slug":"collective-effervescence","title_ko":"집합적 흥분(집합적 열광)","title_en":"Collective Effervescence","meaning":"뒤르켐이 제시한 개념으로, 많은 사람이 한 자리에 모여 의례나 축제 등을 함께 행할 때 발생하는 강렬한 감정적 고양…","subcategory":"종교학이론·비교종교","level":2,"related":[],"prerequisites":[],"pop":14,"aliases":["집합적 열광","집합적 흥분","집합적흥분","집합적흥분(집합적열광)"]},{"slug":"disenchantment","title_ko":"탈주술화","title_en":"Disenchantment of the World","meaning":"막스 베버가 근대화 과정을 설명하며 사용한 개념으로, 합리적·과학적 세계관이 확산되면서 신비적·주술적 힘에 대한 믿음이 세계…","subcategory":"종교학이론·비교종교","level":1,"related":[],"prerequisites":[],"aliases":["세계의 탈주술화","탈마법화"]},{"slug":"axis-mundi","title_ko":"세계축","title_en":"Axis Mundi","meaning":"하늘·땅·지하세계를 연결하는 우주의 중심축으로 상징화된 산·나무·기둥 등의 신화적·의례적 표상.","subcategory":"종교학이론·비교종교","level":1,"related":[],"prerequisites":[],"aliases":["악시스문디","우주축"]},{"slug":"numinous","title_ko":"누미노제","title_en":"The Numinous","meaning":"루돌프 오토가 제시한 개념으로, 이성적·윤리적 범주로는 온전히 설명되지 않는, 두려움과 매혹이 뒤섞인 압도적인 성스러움의…","subcategory":"종교학이론·비교종교","level":1,"related":["mysterium-tremendum"],"prerequisites":[],"pop":7,"aliases":["누미노숨","성스러움"]},{"slug":"mysterium-tremendum","title_ko":"신비로운 두려움(미스테리움 트레멘둠)","title_en":"Mysterium Tremendum","meaning":"루돌프 오토가 누미노제 체험을 세분화하여 제시한 요소 중 하나로, 압도적인 위력과 신비 앞에서 느끼는 두려움·경외·전율의…","subcategory":"종교학이론·비교종교","level":2,"related":["numinous"],"prerequisites":["numinous"],"aliases":["미스테리움 트레멘둠","신비로운 두려움","신비로운두려움","신비로운두려움(미스테리움트레멘둠)"]},{"slug":"structuralism-religion","title_ko":"구조주의 종교이론","title_en":"Structuralist Theory of Religion","meaning":"클로드 레비스트로스 등이 발전시킨 관점으로, 신화와 종교적 상징을 인간 정신의 이항 대립적 사고 구조가 표현된 체계로…","subcategory":"종교학이론·비교종교","level":1,"related":[],"prerequisites":[],"aliases":["구조주의종교이론"]},{"slug":"collective-unconscious","title_ko":"집단무의식","title_en":"Collective Unconscious","meaning":"칼 융이 제시한 개념으로, 개인의 경험과 무관하게 인류 전체가 유전적으로 공유한다고 여겨지는 무의식의 심층 층위로, 원형들이…","subcategory":"종교학이론·비교종교","level":3,"related":[],"prerequisites":[]},{"slug":"scapegoat-mechanism","title_ko":"희생양 메커니즘","title_en":"Scapegoat Mechanism","meaning":"르네 지라르가 제시한 이론으로, 공동체 내부의 갈등과 폭력이 특정 개인이나 집단에게 집중되어 그를 희생시킴으로써 집단의…","subcategory":"종교학이론·비교종교","level":2,"related":["mimetic-desire"],"prerequisites":[],"pop":15,"aliases":["희생양메커니즘"]},{"slug":"mimetic-desire","title_ko":"모방적 욕망","title_en":"Mimetic Desire","meaning":"르네 지라르가 제시한 개념으로, 인간의 욕망이 대상 자체에서 비롯되는 것이 아니라 타인이 그 대상을 욕망하는 것을…","subcategory":"종교학이론·비교종교","level":2,"related":["scapegoat-mechanism"],"prerequisites":[],"pop":19,"aliases":["모방적욕망"]},{"slug":"imitative-magic","title_ko":"모방주술","title_en":"Imitative Magic","meaning":"제임스 프레이저가 제시한 주술의 두 원리 중 하나로, 어떤 대상을 모방하거나 그와 유사한 행위를 하면 실제로 그 대상에게…","subcategory":"종교학이론·비교종교","level":3,"related":[],"prerequisites":[],"pop":20,"aliases":["동종주술","유감주술"]},{"slug":"deism","title_ko":"이신론","title_en":"Deism","meaning":"신이 세계를 창조했지만 창조 이후에는 세계 운영에 직접 개입하지 않으며, 이성을 통해 신의 존재를 인식할 수 있다고 보는…","subcategory":"종교학이론·비교종교","level":1,"related":[],"prerequisites":[],"pop":13},{"slug":"unio-mystica","title_ko":"신비적 합일","title_en":"Unio Mystica","meaning":"신비주의 전통에서 최고의 종교적 체험으로 여겨지는, 개별 자아의 경계가 사라지고 신적 실재와 하나가 되는 것으로 체험되는…","subcategory":"종교학이론·비교종교","level":2,"related":["apophatic-theology"],"prerequisites":["apophatic-theology"],"aliases":["신비적합일"]},{"slug":"apophatic-theology","title_ko":"부정신학","title_en":"Apophatic Theology","meaning":"신의 본질을 긍정적인 언어로 정의하기보다, 신이 '무엇이 아닌지'를 부정하는 방식을 통해 신의 초월성과 언어로 담을 수 없는…","subcategory":"종교학이론·비교종교","level":1,"related":[],"prerequisites":[]},{"slug":"entheogen","title_ko":"엔테오젠","title_en":"Entheogen","meaning":"종교적·영적 체험을 유도할 목적으로 의례적 맥락에서 사용되는 향정신성 식물이나 물질을 가리키는 용어.","subcategory":"종교학이론·비교종교","level":3,"related":[],"prerequisites":[]},{"slug":"religious-pluralism","title_ko":"종교다원주의","title_en":"Religious Pluralism","meaning":"여러 종교가 각기 다른 방식으로 궁극적 실재나 진리에 이르는 정당한 길을 제공한다고 보는 입장으로, 특정 종교만을 유일한…","subcategory":"종교학이론·비교종교","level":1,"related":[],"prerequisites":[],"pop":3},{"slug":"doctrine-of-justification","title_ko":"칭의론","title_en":"Doctrine of Justification","meaning":"죄인이 그리스도에 대한 믿음을 통해 하나님 앞에서 의롭다고 인정받는다는 교리.","subcategory":"기독교신학·불교동양종교 개념","level":1,"related":["justification-by-faith","atonement"],"prerequisites":[],"aliases":["의인론"]},{"slug":"atonement","title_ko":"속죄론","title_en":"Doctrine of Atonement","meaning":"그리스도의 죽음이 인간의 죄를 위한 대속적 희생으로서 지니는 의미와 방식을 다루는 교리.","subcategory":"기독교신학·불교동양종교 개념","level":1,"related":["doctrine-of-justification","incarnation"],"prerequisites":[],"aliases":["대속론","속죄"]},{"slug":"patristics","title_ko":"교부철학","title_en":"Patristics","meaning":"초대교회 교부들의 신학적, 철학적 저작과 사상을 연구하는 학문 분야.","subcategory":"기독교신학·불교동양종교 개념","level":3,"related":[],"prerequisites":[],"aliases":["교부학"]},{"slug":"biblical-canon","title_ko":"정경","title_en":"Biblical Canon","meaning":"신앙 공동체가 하나님의 영감으로 기록되었다고 공인하여 성서로 확정한 문서들의 목록.","subcategory":"기독교신학·불교동양종교 개념","level":1,"related":[],"prerequisites":[]},{"slug":"calvinism","title_ko":"칼뱅주의","title_en":"Calvinism","meaning":"장 칼뱅의 신학, 특히 신의 절대 주권과 예정론을 중심으로 형성된 개혁신학 전통.","subcategory":"기독교신학·불교동양종교 개념","level":2,"related":["arminianism"],"prerequisites":[],"aliases":["개혁주의","칼빈주의"]},{"slug":"arminianism","title_ko":"알미니안주의","title_en":"Arminianism","meaning":"인간의 자유의지와 신의 은혜가 협력하여 구원에 이른다고 보며 칼뱅주의의 이중예정론에 반대한 신학 사조.","subcategory":"기독교신학·불교동양종교 개념","level":3,"related":["calvinism"],"prerequisites":["calvinism"],"aliases":["아르미니우스주의"]},{"slug":"neo-orthodoxy","title_ko":"신정통주의","title_en":"Neo-orthodoxy","meaning":"20세기에 자유주의신학을 비판하며 신의 초월성과 계시의 우위를 재강조한 신학 운동.","subcategory":"기독교신학·불교동양종교 개념","level":3,"related":[],"prerequisites":[],"aliases":["변증법적신학"]},{"slug":"kenosis","title_ko":"케노시스","title_en":"Kenosis","meaning":"그리스도가 성육신하면서 신적 영광과 특권을 스스로 비우셨다는 신학적 개념.","subcategory":"기독교신학·불교동양종교 개념","level":2,"related":["incarnation","atonement"],"prerequisites":["atonement"],"aliases":["자기비움"]},{"slug":"incarnation","title_ko":"성육신","title_en":"Incarnation","meaning":"하나님의 아들이 인간의 육신을 입고 역사 속 인물 예수 그리스도로 오셨다는 기독교의 핵심 교리.","subcategory":"기독교신학·불교동양종교 개념","level":2,"related":["kenosis","atonement"],"prerequisites":[],"aliases":["육화","화육"]},{"slug":"zen-buddhism","title_ko":"선불교","title_en":"Zen Buddhism","meaning":"경전 학습보다 좌선과 직관적 깨달음을 강조하는 동아시아 대승불교의 한 종파.","subcategory":"기독교신학·불교동양종교 개념","level":1,"related":[],"prerequisites":[],"aliases":["선종","젠"]},{"slug":"twelve-nidanas","title_ko":"십이연기","title_en":"Twelve Nidānas","meaning":"무명에서 노사에 이르는 열두 단계의 조건적 연쇄를 통해 괴로움의 발생 과정을 설명하는 연기설의 세부 체계.","subcategory":"기독교신학·불교동양종교 개념","level":3,"related":[],"prerequisites":[],"aliases":["십이인연"]},{"slug":"bodhicitta","title_ko":"보리심","title_en":"Bodhicitta","meaning":"모든 중생을 구제하기 위해 깨달음을 이루고자 하는 보살의 근본 서원과 마음.","subcategory":"기독교신학·불교동양종교 개념","level":1,"related":[],"prerequisites":[]},{"slug":"maitreya-faith","title_ko":"미륵신앙","title_en":"Maitreya Faith","meaning":"먼 미래에 이 세상에 출현해 중생을 구제할 것이라는 미륵불에 대한 대승불교의 신앙.","subcategory":"기독교신학·불교동양종교 개념","level":2,"related":[],"prerequisites":[],"pop":10},{"slug":"hypostatic-union","title_ko":"위격적 연합","title_en":"Hypostatic Union","meaning":"예수 그리스도 안에서 신성과 인성이 혼합되거나 분리되지 않고 하나의 위격(인격) 안에서 연합되어 있다는 기독론 교리입니다.","subcategory":"기독론","level":2,"related":["logos-christology"],"prerequisites":[],"aliases":["위격적연합"]},{"slug":"logos-christology","title_ko":"로고스 기독론","title_en":"Logos Christology","meaning":"예수 그리스도를 영원 전부터 존재하시는 하나님의 로고스(말씀)가 성육신하신 분으로 이해하는 기독론적 접근입니다.","subcategory":"기독론","level":2,"related":["hypostatic-union"],"prerequisites":[],"aliases":["로고스기독론"]},{"slug":"baptism-in-the-holy-spirit","title_ko":"성령세례","title_en":"Baptism in the Holy Spirit","meaning":"신자가 성령에 의해 그리스도의 몸(교회)에 연합되거나, 혹은 회심 이후 능력을 부여받는 별도의 체험으로 이해되는 성령 사역을…","subcategory":"성령론","level":2,"related":[],"prerequisites":[]},{"slug":"perseverance-of-the-saints","title_ko":"성도의 견인","title_en":"Perseverance of the Saints","meaning":"참으로 거듭난 신자는 하나님의 보존하시는 은혜로 끝까지 믿음 안에 머물러 결국 구원을 완성한다는 신학 교리입니다.","subcategory":"구원론","level":2,"related":["ordo-salutis"],"prerequisites":[],"pop":2,"aliases":["성도의견인"]},{"slug":"ordo-salutis","title_ko":"구원의 서정","title_en":"Ordo Salutis","meaning":"소명, 중생, 믿음, 칭의, 성화 등 구원의 여러 요소들이 논리적으로 어떤 순서로 일어나는지를 체계화한 신학적 틀입니다.","subcategory":"구원론","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["구원의서정"]},{"slug":"apostolic-succession","title_ko":"사도적 계승","title_en":"Apostolic Succession","meaning":"교회의 직분과 권위가 사도들로부터 안수를 통해 끊이지 않고 이어져 왔다는 교회론적 주장을 가리킵니다.","subcategory":"교회론","level":2,"related":[],"prerequisites":[],"aliases":["사도적계승"]},{"slug":"invisible-church","title_ko":"보이지 않는 교회","title_en":"Invisible Church","meaning":"참된 믿음을 가진 모든 신자로 구성되어 오직 하나님만이 아시는, 눈에 보이지 않는 교회의 영적 실체를 가리키는 교회론…","subcategory":"교회론","level":2,"related":[],"prerequisites":[],"aliases":["보이지않는교회"]},{"slug":"beatific-vision","title_ko":"지복직관","title_en":"Beatific Vision","meaning":"구원받은 이들이 내세에서 하나님의 본질을 직접적이고 완전하게 바라보며 누리는 최고의 복된 상태를 가리키는 신학 용어입니다.","subcategory":"종말론","level":2,"related":[],"prerequisites":[]},{"slug":"abomination-of-desolation","title_ko":"멸망의 가증한 것","title_en":"Abomination of Desolation","meaning":"다니엘서에 예언되고 예수께서 감람산 강화에서 재확인하신, 성전이 신성모독적으로 더럽혀지는 사건을 가리키는 종말론적 표현입니다.","subcategory":"종말론","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["Abomination of Desolation","멸망의가증한것"]},{"slug":"analogia-relationis","title_ko":"관계유비","title_en":"Analogia Relationis","meaning":"관계유비는 인간이 하나님의 형상을 지녔다는 것을 존재적 속성의 유사성이 아니라 하나님과 인간 사이, 그리고 인간과 인간…","subcategory":"인간론·죄론","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["Analogia Relationis"]},{"slug":"bondage-of-the-will","title_ko":"의지의 속박","title_en":"Bondage of the Will","meaning":"의지의 속박은 타락한 인간의 의지가 죄에 얽매여 있어서 스스로의 힘만으로는 하나님을 향해 선한 것을 선택할 수 없다는 신학적…","subcategory":"인간론·죄론","level":2,"related":[],"prerequisites":[],"aliases":["Bondage of the Will","의지의속박"]},{"slug":"deutero-pauline-epistles","title_ko":"제2바울서신","title_en":"Deutero-Pauline Epistles","meaning":"신약성경에서 바울의 이름으로 되어 있지만 문체·어휘·신학 내용의 차이로 인해 바울이 직접 쓴 것이 아니라 그의 제자나…","subcategory":"신약학","level":2,"related":[],"prerequisites":[],"aliases":["Deutero-Pauline Epistles"]},{"slug":"dynamic-inspiration","title_ko":"동력적 영감설","title_en":"Dynamic Inspiration","meaning":"성령의 영감이 성경 저자의 낱말 선택이 아니라 사상과 개념 수준에 작용했으며, 실제 문장 표현은 저자 자신의 몫이었다고 보는…","subcategory":"계시론·성경론","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["Dynamic Inspiration","동력적영감설"]},{"slug":"four-source-hypothesis","title_ko":"네 자료설","title_en":"Four-Source Hypothesis","meaning":"마태복음과 누가복음이 마가복음, Q자료, 그리고 각자의 고유 자료(M자료, L자료)까지 총 네 가지 자료를 바탕으로…","subcategory":"신약학","level":2,"related":[],"prerequisites":[],"pop":18,"aliases":["Four-Source Hypothesis","네자료설"]},{"slug":"golden-chain-of-salvation","title_ko":"구원의 황금사슬","title_en":"Golden Chain of Salvation","meaning":"로마서 8장 등을 근거로, 예정-부르심-칭의-영화(榮化)로 이어지는 구원의 각 단계가 사슬처럼 끊어지지 않고 연결되어 있음을…","subcategory":"구원론","level":2,"related":[],"prerequisites":[],"pop":16,"aliases":["Golden Chain of Salvation","구원의황금사슬"]},{"slug":"great-white-throne-judgment","title_ko":"백보좌 심판","title_en":"Great White Throne Judgment","meaning":"요한계시록 20장에 묘사된, 천년왕국 이후 죽은 자들이 부활하여 흰 보좌에 앉으신 하나님 앞에서 자신의 행위대로 최종 심판을…","subcategory":"종말론","level":2,"related":["new-heaven-and-new-earth"],"prerequisites":[],"pop":9,"aliases":["Great White Throne Judgment","GWTJ","백보좌심판"]},{"slug":"interfaith-dialogue-theology","title_ko":"종교간대화신학","title_en":"Theology of Interfaith Dialogue","meaning":"서로 다른 종교 전통 사이의 실제적 만남과 대화를 통해 상호 이해를 증진시키고, 그 대화의 신학적 근거와 방법을 성찰하는…","subcategory":"종교학이론·비교종교","level":2,"related":[],"prerequisites":[],"aliases":["Theology of Interfaith Dialogue"]},{"slug":"justification-by-faith","title_ko":"이신칭의","title_en":"Justification by Faith","meaning":"인간이 자신의 행위가 아니라 그리스도를 믿는 믿음을 통해 하나님 앞에서 의롭다고 선언된다는 개신교 구원론의 핵심 교리입니다.","subcategory":"구원론","level":2,"related":[],"prerequisites":[],"aliases":["Justification by Faith"]},{"slug":"kalam-cosmological-argument","title_ko":"칼람 우주론적 논증","title_en":"Kalam Cosmological Argument","meaning":"시작을 가진 모든 것에는 원인이 있고 우주도 시작을 가졌으므로 우주에는 원인이 있다는, 중세 이슬람 신학에서 유래한 우주론적…","subcategory":"신론·삼위일체론","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["Kalam Cosmological Argument","칼람우주론적논증"]},{"slug":"megachurch-phenomenon","title_ko":"메가처치 현상","title_en":"Megachurch Phenomenon","meaning":"한 회중의 주일 출석 인원이 대규모에 이르는 대형교회가 20세기 후반 이후 확산되면서 나타난 목회·사회학적 현상을 가리키는…","subcategory":"목회신학·선교학·윤리","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["Megachurch Phenomenon","메가처치현상"]},{"slug":"new-heaven-and-new-earth","title_ko":"새 하늘과 새 땅","title_en":"New Heaven and New Earth","meaning":"요한계시록 21~22장에 묘사된, 최후 심판 이후 죄와 죽음이 없는 완전히 새롭게 된 창조 세계로서 구속사의 최종 완성…","subcategory":"종말론","level":2,"related":["great-white-throne-judgment"],"prerequisites":[],"aliases":["New Heaven and New Earth","NHNE","새하늘과새땅"]},{"slug":"threefold-office-of-christ","title_ko":"그리스도의 삼중직","title_en":"Threefold Office of Christ","meaning":"그리스도의 삼중직은 예수 그리스도의 사역을 구약의 세 직분인 선지자·제사장·왕의 역할이 통합적으로 성취된 것으로 이해하는…","subcategory":"기독론","level":2,"related":[],"prerequisites":[],"pop":17,"aliases":["Threefold Office of Christ","그리스도의삼중직"]},{"slug":"anaphora-liturgical","title_ko":"아나포라(성찬기도)","title_en":"Anaphora","meaning":"성찬(성체성사) 예식에서 빵과 포도주를 놓고 하나님께 감사와 기념, 성령 임재를 구하는 중심 기도문입니다.","subcategory":"성례전학","level":2,"related":[],"prerequisites":[],"aliases":["Anaphora","성찬기도","아나포라"]}]