[{"slug":"longitudinal","title_ko":"종통재","title_en":"Longitudinal","meaning":"선체 외판이나 갑판을 선수미 방향으로 보강하는 부재로, 종식 구조방식의 주요 강도부재이다.","subcategory":"선박설계·구조공학","level":2,"related":["shell-plating"],"prerequisites":["shell-plating"]},{"slug":"shell-plating","title_ko":"외판","title_en":"Shell Plating","meaning":"선체의 외부를 이루는 강판으로 수밀성을 유지하며 종강도 및 국부강도에 기여하는 주요 부재이다.","subcategory":"선박설계·구조공학","level":1,"related":[],"prerequisites":[]},{"slug":"bilge-keel","title_ko":"빌지킬","title_en":"Bilge Keel","meaning":"선체 만곡부(빌지부)에 종방향으로 부착하여 횡동요시 감쇠를 증가시키는 판형 부가물이다.","subcategory":"선박설계·구조공학","level":2,"related":[],"prerequisites":[],"pop":1},{"slug":"freeboard","title_ko":"건현","title_en":"Freeboard","meaning":"만재흘수선에서 상갑판 현측 상단까지의 수직 거리로, 선박의 예비 부력을 나타내는 지표이다.","subcategory":"선박설계·구조공학","level":2,"related":["international-load-line-convention","buoyancy"],"prerequisites":[],"pop":5},{"slug":"lightship-displacement","title_ko":"경하배수량","title_en":"Lightship Displacement","meaning":"화물, 연료, 승무원, 청수 등을 싣지 않은 상태에서 선체, 기관, 의장품만으로 구성된 선박의 중량이다.","subcategory":"선박설계·구조공학","level":1,"related":["deadweight-tonnage","center-of-gravity"],"prerequisites":[],"pop":16},{"slug":"deadweight-tonnage","title_ko":"재화중량톤수","title_en":"Deadweight Tonnage","meaning":"만재배수량에서 경하배수량을 뺀 값으로, 화물, 연료, 청수, 승무원 등 선박이 실을 수 있는 총 중량을 의미한다.","subcategory":"선박설계·구조공학","level":1,"related":["lightship-displacement"],"prerequisites":[],"pop":11,"aliases":["DWT","재화중량톤"]},{"slug":"heel","title_ko":"횡경사","title_en":"Heel","meaning":"바람, 선회, 화물이동 등 외력에 의해 선박이 일시적으로 좌우로 기울어진 상태이다.","subcategory":"선박설계·구조공학","level":3,"related":["gz-curve"],"prerequisites":["gz-curve"],"pop":14,"aliases":["힐"]},{"slug":"gz-curve","title_ko":"GZ곡선","title_en":"GZ Curve","meaning":"경사각에 따른 복원암(GZ)의 변화를 나타낸 곡선으로, 선박 복원성 평가의 핵심 도구이다.","subcategory":"선박설계·구조공학","level":1,"related":[],"prerequisites":[]},{"slug":"lines-plan","title_ko":"선체선도","title_en":"Lines Plan","meaning":"선체의 3차원 외형을 정면도, 반폭도, 측면도의 세 가지 투영도로 표현한 선박 설계 기본 도면이다.","subcategory":"선박설계·구조공학","level":1,"related":["sheer-plan"],"prerequisites":[],"pop":20},{"slug":"sheer-plan","title_ko":"측면도","title_en":"Sheer Plan","meaning":"선체를 선체 중심선을 포함하는 여러 종방향 수직면으로 절단한 형상(버톡라인)과 선체 외형 윤곽을 옆에서 본 형태로 나타낸…","subcategory":"선박설계·구조공학","level":2,"related":["lines-plan"],"prerequisites":["lines-plan"],"pop":19},{"slug":"slamming","title_ko":"슬래밍","title_en":"Slamming","meaning":"선박이 파도 중 항해할 때 선수부 선저가 수면에 강하게 부딪히며 충격압력이 발생하는 현상이다.","subcategory":"선박설계·구조공학","level":1,"related":[],"prerequisites":[]},{"slug":"green-water","title_ko":"그린워터","title_en":"Green Water","meaning":"거친 해상에서 파도가 선수 갑판을 넘어 대량의 바닷물이 갑판 위로 올라오는 현상이다.","subcategory":"선박설계·구조공학","level":3,"related":["freeboard"],"prerequisites":["freeboard"],"pop":7},{"slug":"tensile-strength","title_ko":"인장강도","title_en":"Tensile Strength","meaning":"재료가 파단되기 직전까지 견딜 수 있는 최대 인장응력이다.","subcategory":"선박설계·구조공학","level":3,"related":["yield-strength"],"prerequisites":[],"pop":3,"aliases":["UTS","Ultimate Tensile Strength"]},{"slug":"dry-dock","title_ko":"건식도크","title_en":"Dry Dock","meaning":"해수를 배출하여 바닥을 드러낸 상태에서 선박을 건조하거나 수리할 수 있도록 만든 시설이다.","subcategory":"선박설계·구조공학","level":2,"related":[],"prerequisites":[],"pop":15},{"slug":"international-load-line-convention","title_ko":"국제만재흘수선협약","title_en":"International Load Line Convention","meaning":"선박의 최소 건현과 만재흘수선 표시 기준을 규정하여 과적으로 인한 침몰 위험을 방지하기 위한 국제해사기구(IMO)의 협약이다.","subcategory":"선박설계·구조공학","level":2,"related":["freeboard"],"prerequisites":[],"pop":6,"aliases":["ILLC"]},{"slug":"parametric-rolling","title_ko":"파라메트릭횡동요","title_en":"Parametric Rolling","meaning":"종파 항해 중 파랑에 의한 수선면 형상 변화로 복원성이 주기적으로 변동하면서 횡동요가 비선형적으로 급격히 증폭되는 현상이다.","subcategory":"선박설계·구조공학","level":3,"related":["gz-curve"],"prerequisites":["gz-curve"]},{"slug":"broaching","title_ko":"브로칭","title_en":"Broaching","meaning":"추파 항해 중 파랑에 의한 편요모멘트가 타의 조종력을 초과하여 선박이 급격히 침로를 이탈하며 대각도로 선회하는 위험한…","subcategory":"선박설계·구조공학","level":3,"related":["parametric-rolling"],"prerequisites":[],"pop":8},{"slug":"spar-platform","title_ko":"스파 플랫폼","title_en":"Spar Platform","meaning":"깊은 흘수를 가진 원통형 선체 하부에 고정 밸러스트를 배치해 무게중심을 낮추고 부력중심과의 간격으로 복원력을 확보한 심해용…","subcategory":"해양플랜트·해양구조물","level":1,"related":[],"prerequisites":[],"aliases":["스파플랫폼"]},{"slug":"drilling-mud","title_ko":"시추이수","title_en":"Drilling Mud","meaning":"시추 중 비트 냉각, 암편 이송, 공벽 안정화, 지층압력 제어 등 다목적 기능을 수행하도록 조성된 순환 유체로, 밀도와…","subcategory":"해양플랜트·해양구조물","level":2,"related":[],"prerequisites":[],"aliases":["드릴링머드"]},{"slug":"subsea-production-system","title_ko":"해저생산시스템","title_en":"Subsea Production System","meaning":"해저면에 설치된 웰헤드, 매니폴드, 파이프라인, 제어시스템 등을 통해 해상플랫폼 없이도 원유·가스를 생산·수송할 수 있도록…","subcategory":"해양플랜트·해양구조물","level":1,"related":["subsea-wellhead","subsea-tieback"],"prerequisites":[]},{"slug":"subsea-wellhead","title_ko":"해저웰헤드","title_en":"Subsea Wellhead","meaning":"해저면의 시추공 입구에 설치되어 케이싱을 지지하고 압력을 밀봉하며, 상부의 크리스마스트리와 연결되어 생산 유체 흐름을…","subcategory":"해양플랜트·해양구조물","level":1,"related":["subsea-production-system"],"prerequisites":[]},{"slug":"subsea-tieback","title_ko":"해저타이백","title_en":"Subsea Tieback","meaning":"신규 해저 유정을 별도의 신설 플랫폼 없이 파이프라인으로 기존의 인근 플랫폼이나 FPSO에 연결하여 생산 인프라를 공유하는…","subcategory":"해양플랜트·해양구조물","level":2,"related":["subsea-production-system"],"prerequisites":["subsea-production-system"]},{"slug":"subsea-separation","title_ko":"해저분리시스템","title_en":"Subsea Separation","meaning":"해저면에서 생산 유체 중 물, 기름, 가스를 미리 분리하여 불필요한 물의 이송 부담을 줄이고 파이프라인 내 유동을 개선하는…","subcategory":"해양플랜트·해양구조물","level":2,"related":[],"prerequisites":[]},{"slug":"pigging-operation","title_ko":"피깅작업","title_en":"Pigging Operation","meaning":"파이프라인 내부에 피그라 불리는 장치를 삽입하여 유체의 압력으로 이동시키면서 내부 세정, 검사, 배치 분리 등의 목적으로…","subcategory":"해양플랜트·해양구조물","level":3,"related":[],"prerequisites":[],"pop":13},{"slug":"cathodic-protection-marine","title_ko":"음극 방식","title_en":"Cathodic Protection","meaning":"금속 구조물이 부식되는 전기화학적 반응을 억제하기 위해 구조물 표면을 전기화학적으로 음극화시켜 부식 전류의 방향을 조절하는…","subcategory":"해양플랜트·해양구조물","level":2,"related":["corrosion"],"prerequisites":[