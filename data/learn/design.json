[{"slug":"design-thinking","title_ko":"디자인씽킹","title_en":"design thinking","meaning":"공감, 문제정의, 아이디어 발상, 프로토타이핑, 테스트의 비선형적 단계를 통해 인간 중심의 문제 해결을 추구하는 창의적 사고…","subcategory":"제품디자인·산업디자인","level":1,"related":["double-diamond-process","ideation"],"prerequisites":[],"aliases":["디자인사고"]},{"slug":"double-diamond-process","title_ko":"더블다이아몬드프로세스","title_en":"double diamond process","meaning":"발견(Discover)-정의(Define)-전개(Develop)-전달(Deliver)의 네 단계로 구성되며, 확산적 사고와…","subcategory":"제품디자인·산업디자인","level":2,"related":["design-thinking","ideation"],"prerequisites":["design-thinking","ideation"],"aliases":["더블다이아몬드"]},{"slug":"high-fidelity-prototype","title_ko":"하이피델리티프로토타입","title_en":"high-fidelity prototype","meaning":"실제 제품과 유사한 외관, 재질, 상호작용을 갖추어 최종 사용자 경험에 가깝게 구현한 정교한 프로토타입이다.","subcategory":"제품디자인·산업디자인","level":1,"related":[],"prerequisites":[],"aliases":["고충실도프로토타입","하이파이프로토타입"]},{"slug":"affordance","title_ko":"어포던스","title_en":"Affordance","meaning":"사물의 형태나 속성이 사용자에게 특정 행위를 가능하게 하거나 암시하는 지각적 특성을 말한다.","subcategory":"제품디자인·산업디자인","level":1,"related":["signifier","mental-model","gestalt-principles"],"prerequisites":[],"aliases":["행위지원성"]},{"slug":"signifier","title_ko":"시그니파이어","title_en":"signifier","meaning":"사용자에게 사물의 어포던스나 올바른 조작 방법을 명시적으로 알려주는 시각적, 청각적 단서나 표시를 말한다.","subcategory":"제품디자인·산업디자인","level":3,"related":["affordance","mental-model"],"prerequisites":["affordance"],"pop":7},{"slug":"form-factor","title_ko":"폼팩터","title_en":"form factor","meaning":"제품의 크기, 형태, 물리적 배치 등 외형적 구조를 규정하는 디자인 요소로, 휴대성과 사용 방식에 직접적 영향을 미친다.","subcategory":"제품디자인·산업디자인","level":3,"related":["ergonomics","cmf-design"],"prerequisites":["cmf-design"],"pop":16},{"slug":"cmf-design","title_ko":"CMF디자인","title_en":"CMF design (color, material, finish)","meaning":"제품의 색상, 소재, 표면 마감을 통합적으로 계획하여 심미성, 촉감, 브랜드 인상을 결정하는 디자인 영역이다.","subcategory":"제품디자인·산업디자인","level":1,"related":["color-material-finish"],"prerequisites":[],"pop":1},{"slug":"color-material-finish","title_ko":"색상소재마감","title_en":"color, material, finish","meaning":"제품의 색상, 사용 소재, 표면 처리 방식을 지칭하는 용어로 CMF디자인의 세 가지 핵심 구성 요소를 의미한다.","subcategory":"제품디자인·산업디자인","level":2,"related":["cmf-design"],"prerequisites":["cmf-design"],"aliases":["CMF"]},{"slug":"mockup","title_ko":"목업","title_en":"mockup","meaning":"제품의 형태, 크기, 비례를 실물과 유사하게 재현하되 실제 기능은 갖추지 않은 외관 검토용 모형이다.","subcategory":"제품디자인·산업디자인","level":1,"related":[],"prerequisites":[],"pop":3},{"slug":"persona","title_ko":"페르소나","title_en":"persona","meaning":"리서치 데이터를 기반으로 특정 사용자 집단의 목표, 행동, 요구를 대표하는 가상의 인물상을 구체화한 디자인 도구이다.","subcategory":"제품디자인·산업디자인","level":1,"related":[],"prerequisites":[],"pop":18,"aliases":["사용자페르소나","User Persona"]},{"slug":"ethnographic-research","title_ko":"민족지학적연구","title_en":"ethnographic research","meaning":"사용자의 문화적, 사회적 맥락을 깊이 있게 이해하기 위해 장기간의 현장 관찰과 참여를 통해 데이터를 수집하는 질적 연구…","subcategory":"제품디자인·산업디자인","level":1,"related":["participatory-design"],"prerequisites":[],"aliases":["문화기술지연구"]},{"slug":"participatory-design","title_ko":"참여디자인","title_en":"participatory design","meaning":"사용자와 이해관계자를 디자인 과정의 협업자로 직접 참여시켜 함께 문제를 정의하고 해결안을 만들어가는 디자인 접근법이다.","subcategory":"제품디자인·산업디자인","level":2,"related":["ethnographic-research"],"prerequisites":["ethnographic-research"],"aliases":["참여적디자인"]},{"slug":"ideation","title_ko":"아이디에이션","title_en":"ideation","meaning":"문제 해결을 위한 다양한 아이디어를 자유롭게 생성하고 확장하는 확산적 사고의 디자인 활동이다.","subcategory":"제품디자인·산업디자인","level":1,"related":["brainstorming","design-thinking"],"prerequisites":[],"pop":10,"aliases":["아이디어발상"]},{"slug":"brainstorming","title_ko":"브레인스토밍","title_en":"brainstorming","meaning":"판단을 유보한 채 짧은 시간 동안 많은 양의 아이디어를 자유롭게 제시하도록 유도하는 집단 아이디어 발상 기법이다.","subcategory":"제품디자인·산업디자인","level":2,"related":["ideation"],"prerequisites":["ideation"],"pop":12},{"slug":"visual-hierarchy","title_ko":"시각적 위계","title_en":"Visual Hierarchy","meaning":"크기, 색상, 배치 등을 통해 화면이나 지면 내 요소들의 중요도 순서를 시각적으로 구분하여 정보 인지 순서를 유도하는 디자인…","subcategory":"제품디자인·산업디자인","level":1,"related":["gestalt-principles","figure-ground-organization"],"prerequisites":[],"pop":15,"aliases":["비주얼하이어라키","시각위계"]},{"slug":"ab-testing","title_ko":"AB테스트","title_en":"A/B testing","meaning":"두 가지 이상의 디자인 대안을 서로 다른 사용자 집단에 노출시켜 성과 지표를 비교함으로써 더 나은 대안을 통계적으로 검증하는…","subcategory":"제품디자인·산업디자인","level":3,"related":[],"prerequisites":[],"pop":6,"aliases":["에이비테스트"]},{"slug":"pilot-testing","title_ko":"파일럿테스트","title_en":"pilot testing","meaning":"본격적인 출시나 대규모 평가 이전에 소규모로 예비 시험을 진행하여 절차와 도구의 문제점을 점검하는 사전 검증 단계이다.","subcategory":"제품디자인·산업디자인","level":3,"related":[],"prerequisites":[],"pop":4,"aliases":["예비시험"]},{"slug":"tracking","title_ko":"트래킹","title_en":"Tracking","meaning":"한 단어나 문장 전체에 걸쳐 글자 사이의 간격을 균일하게 늘리거나 줄이는 타이포그래피 조정 기법이다.","subcategory":"그래픽디자인·UX디자인","level":2,"related":[],"prerequisites":[],"aliases":["자간"]},{"slug":"baseline-grid","title_ko":"베이스라인그리드","title_en":"Baseline Grid","meaning":"텍스트의 기준선을 일정한 수직 간격으로 정렬시켜 전체 레이아웃의 수직 리듬을 통일하는 그리드 체계이다.","subcategory":"그래픽디자인·UX디자인","level":2,"related":[],"prerequisites":[],"pop":11},{"slug":"white-space","title_ko":"화이트스페이스(여백)","title_en":"White Space","meaning":"디자인 요소들 사이에 의도적으로 남겨두는 빈 공간으로, 시각적 휴식과 정보 위계 형성에 기여한다.","subcategory":"그래픽디자인·UX디자인","level":1,"related":["visual-hierarchy"],"prerequisites":[],"aliases":["여백","화이트스페이스"]},{"slug":"visual-weight","title_ko":"시각적무게","title_en":"Visual Weight","meaning":"크기, 색상, 형태, 위치 등에 따라 요소가 시각적으로 얼마나 강하게 지각되는 정도를 의미하는 디자인 개념이다.","subcategory":"그래픽디자인·UX디자인","level":2,"related":["visual-hierarchy","figure-ground"],"prerequisites":[]},{"slug":"swiss-style","title_ko":"스위스스타일","title_en":"Swiss Style","meaning":"1950년대 스위스에서 발전한 그리드 기반의 명료하고 객관적인 그래픽디자인 양식으로, 산세리프체와 비대칭 레이아웃을 특징으로…","subcategory":"그래픽디자인·UX디자인","level":2,"related":[],"prerequisites":[],"aliases":["스위스디자인"]},{"slug":"continuity-principle","title_ko":"연속성원리","title_en":"Principle of Continuity","meaning":"요소들이 부드럽게 이어지는 선이나 곡선을 따라 배열될 때 이를 하나의 연속된 흐름으로 인지하는 게슈탈트 시지각 원리이다.","subcategory":"그래픽디자인·UX디자인","level":3,"related":["gestalt-principles","visual-hierarchy"],"prerequisites":[],"aliases":["연속성의법칙"]},{"slug":"figure-ground","title_ko":"전경배경관계","title_en":"Figure-Ground Relationship","meaning":"시야 안에서 어떤 형태를 주요 대상(전경)으로, 나머지를 배경으로 구분하여 지각하는 시지각 원리이다.","subcategory":"그래픽디자인·UX디자인","level":2,"related":["gestalt-principles"],"prerequisites":[],"pop":17,"aliases":["도형과배경","전경과배경"]},{"slug":"color-wheel","title_ko":"색상환","title_en":"Color Wheel","meaning":"색상들을 원형으로 배열하여 색상 간의 관계와 조화를 시각적으로 나타낸 색채 도구이다.","subcategory":"그래픽디자인·UX디자인","level":1,"related":[],"prerequisites":[],"aliases":["색환","컬러휠"]},{"slug":"color-psychology","title_ko":"색채심리학","title_en":"Color Psychology","meaning":"색상이 인간의 감정, 인지, 행동에 미치는 심리적 영향을 연구하는 학문 분야이다.","subcategory":"그래픽디자인·UX디자인","level":2,"related":["color-wheel"],"prerequisites":["color-wheel"],"pop":14,"aliases":["색채심리"]},{"slug":"millers-law","title_ko":"밀러의법칙","title_en":"Miller's Law","meaning":"인간의 단기기억이 평균적으로 약 7±2개의 항목만을 동시에 처리할 수 있다는 인지심리학 법칙이다.","subcategory":"그래픽디자인·UX디자인","level":3,"related":["cognitive-load"],"prerequisites":[],"pop":5,"aliases":["매직넘버7"]},{"slug":"infinite-scroll","title_ko":"무한스크롤","title_en":"Infinite Scroll","meaning":"사용자가 화면 하단에 도달할 때마다 새로운 콘텐츠가 자동으로 추가 로딩되는 UI 패턴이다.","subcategory":"그래픽디자인·UX디자인","level":2,"related":["pagination"],"prerequisites":[],"pop":9},{"slug":"pagination","title_ko":"페이지네이션","title_en":"Pagination","meaning":"많은 양의 콘텐츠를 여러 페이지로 나누어 번호를 매겨 사용자가 원하는 페이지로 이동할 수 있게 하는 UI 패턴이다.","subcategory":"그래픽디자인·UX디자인","level":3,"related":["infinite-scroll"],"prerequisites":["infinite-scroll"],"pop":8},{"slug":"pictogram","title_ko":"픽토그램","title_en":"Pictogram","meaning":"언어에 상관없이 의미를 즉각적으로 전달할 수 있도록 단순화된 그림 형태로 표현한 시각 기호이다.","subcategory":"그래픽디자인·UX디자인","level":2,"related":["signage-design"],"prerequisites":[],"pop":19},{"slug":"signage-design","title_ko":"사이니지디자인","title_en":"Signage Design","meaning":"공공장소나 시설에서 방향 안내, 정보 전달을 목적으로 하는 표지판 및 안내 시스템을 설계하는 디자인 분야이다.","subcategory":"그래픽디자인·UX디자인","level":3,"related":["pictogram"],"prerequisites":["pictogram"],"pop":13,"aliases":["사인디자인"]},{"slug":"field-study","title_ko":"필드스터디","title_en":"Field Study","meaning":"실험실이 아닌 사용자의 실제 생활 및 사용 환경에서 직접 관찰과 조사를 수행하는 UX 리서치 방법이다.","subcategory":"그래픽디자인·UX디자인","level":3,"related":[],"prerequisites":[],"pop":20},{"slug":"feedback-loop","title_ko":"피드백루프","title_en":"Feedback Loop","meaning":"사용자의 행동에 대한 시스템의 반응이 다시 사용자의 다음 행동에 영향을 미치는 상호작용의 순환 구조이다.","subcategory":"그래픽디자인·UX디자인","level":3,"related":[],"prerequisites":[],"pop":2},{"slug":"design-management","title_ko":"디자인경영","title_en":"design management","meaning":"기업이나 조직이 경쟁우위를 확보하기 위해 디자인 자원을 전략적으로 계획, 조직, 실행, 통제하는 경영 활동 전반을 의미한다.","subcategory":"디자인경영·평가","level":1,"related":["design-management-strategy","design-leadership"],"prerequisites":[],"aliases":["디자인매니지먼트"]},{"slug":"design-management-strategy","title_ko":"디자인경영전략","title_en":"design management strategy","meaning":"조직의 장기적 목표 달성을 위해 디자인 역량을 기업 전략과 통합하여 수립하는 체계적 실행 방침이다.","subcategory":"디자인경영·평가","level":1,"related":["design-management","design-value-chain"],"prerequisites":[]},{"slug":"design-value-chain","title_ko":"디자인가치사슬","title_en":"design value chain","meaning":"디자인 기획부터 개발, 생산, 유통, 소비에 이르는 전 과정에서 각 단계가 부가가치를 창출하는 연쇄 구조를 의미한다.","subcategory":"디자인경영·평가","level":2,"related":["design-management-strategy"],"prerequisites":["design-management-strategy"],"aliases":["DVC"]},{"slug":"design-leadership","title_ko":"디자인리더십","title_en":"design leadership","meaning":"디자인 조직과 프로젝트를 이끌며 비전 제시, 의사결정, 팀 역량 개발을 통해 디자인 성과를 창출하는 리더십 역량이다.","subcategory":"디자인경영·평가","level":1,"related":["design-management"],"prerequisites":[]},{"slug":"national-design-policy","title_ko":"국가디자인정책","title_en":"national design policy","meaning":"국가 차원에서 디자인 산업의 경쟁력 강화와 국민 삶의 질 향상을 목표로 수립하는 종합적 정책 방향이다.","subcategory":"디자인경영·평가","level":2,"related":[],"prerequisites":[]}]