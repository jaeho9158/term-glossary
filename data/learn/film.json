[{"slug":"mimesis-art","title_ko":"미메시스(모방)","title_en":"Mimesis","meaning":"고대 그리스 철학에서 유래한 개념으로, 예술이 현실 세계를 모방하고 재현한다는 원리를 가리키며, 서양 미술 이론에서 재현적…","subcategory":"미술사조·도상학","level":3,"related":["conceptual-art","catharsis-drama","structure-of-greek-tragedy"],"prerequisites":[],"aliases":["모방","미메시스이론","Mimesis Theory","모방론","플라톤의 모방론","Plato's Theory of Mimesis","플라톤의모방론","미메시스(모방)"]},{"slug":"long-take","title_ko":"롱테이크","title_en":"Long Take","meaning":"컷 없이 하나의 쇼트로 상대적으로 긴 시간 동안 촬영을 지속하는 기법으로, 사건의 시공간적 연속성을 편집으로 분절하지 않고…","subcategory":"영화이론·영화기법","level":1,"related":["tracking-shot"],"prerequisites":[],"pop":20},{"slug":"chiaroscuro-lighting","title_ko":"키아로스쿠로조명","title_en":"Chiaroscuro Lighting","meaning":"회화에서 유래한 용어로, 명암의 강한 대비를 통해 입체감과 극적 분위기를 만들어내는 조명 기법을 가리키며 독일 표현주의…","subcategory":"영화이론·영화기법","level":1,"related":["low-key-lighting"],"prerequisites":[]},{"slug":"low-key-lighting","title_ko":"로우키조명","title_en":"Low-Key Lighting","meaning":"필라이트를 최소화하여 화면 전반의 조도를 낮추고 짙은 그림자와 강한 명암 대비를 만들어내는 조명 스타일로, 어둡고 불안한…","subcategory":"영화이론·영화기법","level":1,"related":["chiaroscuro-lighting"],"prerequisites":[],"aliases":["LKL"]},{"slug":"color-grading","title_ko":"컬러그레이딩","title_en":"Color Grading","meaning":"촬영된 영상의 색조, 채도, 명암을 후반 작업 단계에서 디지털로 조정하여 장면의 분위기와 시각적 통일성을 만들어내는 과정을…","subcategory":"영화이론·영화기법","level":2,"related":["chiaroscuro-lighting"],"prerequisites":["chiaroscuro-lighting"],"aliases":["DI","색보정"]},{"slug":"pan-shot","title_ko":"패닝","title_en":"Pan Shot","meaning":"카메라 자체는 고정된 위치에 두고 좌우 수평 방향으로 회전시켜 촬영하는 카메라 움직임 기법으로, 넓은 공간을 보여주거나…","subcategory":"영화이론·영화기법","level":3,"related":["whip-pan","tracking-shot","camera-angle"],"prerequisites":["tracking-shot","camera-angle"],"aliases":["패닝숏","팬숏"]},{"slug":"tracking-shot","title_ko":"트래킹숏","title_en":"Tracking Shot","meaning":"카메라 자체를 레일이나 바퀴 달린 장비 위에 올려 이동시키면서 촬영하는 기법으로, 인물이나 사물의 움직임을 따라가며 공간적…","subcategory":"영화이론·영화기법","level":1,"related":["long-take"],"prerequisites":[],"aliases":["트래킹쇼트"]},{"slug":"handheld-camera","title_ko":"핸드헬드카메라","title_en":"Handheld Camera","meaning":"삼각대나 안정화 장비 없이 촬영자가 카메라를 직접 손으로 들고 촬영하는 기법으로, 흔들림이 있는 거친 화면을 통해 즉흥성과…","subcategory":"영화이론·영화기법","level":1,"related":[],"prerequisites":[],"aliases":["핸드헬드"]},{"slug":"establishing-shot","title_ko":"설정숏","title_en":"Establishing Shot","meaning":"장면이 시작될 때 전체적인 공간의 위치와 배치를 관객에게 알려주기 위해 사용하는 롱숏 혹은 익스트림 롱숏으로, 이후 이어질…","subcategory":"영화이론·영화기법","level":2,"related":["master-shot"],"prerequisites":["master-shot"],"aliases":["설정쇼트","에스터블리싱숏"]},{"slug":"close-up-shot","title_ko":"클로즈업","title_en":"Close-Up Shot","meaning":"인물의 얼굴이나 특정 사물의 세부를 화면 가득 채워 촬영하는 쇼트로, 감정과 세부 정보를 강조하여 관객의 심리적 몰입을…","subcategory":"영화이론·영화기법","level":1,"related":["extreme-close-up","kuleshov-effect"],"prerequisites":[],"aliases":["CUS"]},{"slug":"extreme-close-up","title_ko":"익스트림클로즈업","title_en":"Extreme Close-Up","meaning":"눈, 입 등 신체의 극히 작은 부위나 사물의 세부만을 화면 가득 확대하여 촬영하는 쇼트로, 클로즈업보다 더 강한 시각적…","subcategory":"영화이론·영화기법","level":3,"related":["close-up-shot","cross-cutting"],"prerequisites":["close-up-shot"],"aliases":["ECU","익스트림클로즈업숏"]},{"slug":"dutch-angle","title_ko":"더치앵글","title_en":"Dutch Angle","meaning":"카메라를 수평축에서 의도적으로 기울여 촬영함으로써 화면의 수평선이 비스듬해지는 앵글로, 심리적 불안정이나 왜곡된 상태를…","subcategory":"영화이론·영화기법","level":2,"related":["camera-angle","chiaroscuro-lighting"],"prerequisites":["camera-angle","chiaroscuro-lighting"],"aliases":["경사앵글","사각앵글"]},{"slug":"rack-focus","title_ko":"랙포커스","title_en":"Rack Focus","meaning":"하나의 쇼트 안에서 초점을 한 피사체에서 다른 피사체로 점진적으로 이동시켜 관객의 시각적 주의를 전환시키는 촬영 기법이다.","subcategory":"영화이론·영화기법","level":3,"related":["depth-of-field"],"prerequisites":["depth-of-field"],"pop":7},{"slug":"whip-pan","title_ko":"휩팬","title_en":"Whip Pan","meaning":"카메라를 매우 빠른 속도로 수평 회전시켜 화면이 심하게 흐려지는 팬 기법으로, 두 장면을 역동적으로 연결하는 전환 장치로도…","subcategory":"영화이론·영화기법","level":3,"related":["pan-shot","wipe-transition","camera-angle"],"prerequisites":["wipe-transition","camera-angle"]},{"slug":"cross-cutting","title_ko":"교차편집","title_en":"Cross-Cutting","meaning":"서로 다른 장소에서 동시에 벌어지는 둘 이상의 사건을 번갈아 보여주는 편집 기법으로, 사건들 사이의 긴장감이나 인과 관계를…","subcategory":"영화이론·영화기법","level":3,"related":[],"prerequisites":[],"aliases":["평행편집"]},{"slug":"cutaway-shot","title_ko":"컷어웨이숏","title_en":"Cutaway Shot","meaning":"주된 행위에서 잠시 벗어나 관련된 다른 대상이나 배경 요소를 짧게 보여준 뒤 다시 원래 장면으로 돌아오는 편집 기법으로…","subcategory":"영화이론·영화기법","level":2,"related":["insert-shot"],"prerequisites":[],"aliases":["컷어웨이"]},{"slug":"shot-reverse-shot","title_ko":"숏리버스숏","title_en":"Shot-Reverse-Shot","meaning":"대화하는 두 인물을 번갈아 보여주는 쇼트를 교대로 배열하는 편집 방식으로, 인물 간의 시선 교환과 대화의 리듬을 관객에게…","subcategory":"영화이론·영화기법","level":1,"related":["suture-theory","rule-of-180-degrees"],"prerequisites":[],"pop":14,"aliases":["쇼트리버스쇼트"]},{"slug":"rule-of-180-degrees","title_ko":"180도규칙","title_en":"180-Degree Rule","meaning":"두 인물 또는 행위가 벌어지는 장면에서 카메라가 가상의 축선을 넘지 않고 한쪽 편에서만 촬영해야 한다는 연속편집의 핵심…","subcategory":"영화이론·영화기법","level":1,"related":["shot-reverse-shot"],"prerequisites":[],"aliases":["180도법칙"]},{"slug":"kuleshov-effect","title_ko":"쿨레쇼프효과","title_en":"Kuleshov Effect","meaning":"동일한 인물의 무표정한 쇼트라도 그 앞뒤에 배치되는 쇼트에 따라 관객이 서로 다른 감정으로 해석하게 되는 현상으로, 편집이…","subcategory":"영화이론·영화기법","level":1,"related":["close-up-shot"],"prerequisites":[],"aliases":["쿨레쇼브효과"]},{"slug":"diegetic-sound","title_ko":"다이제틱사운드","title_en":"Diegetic Sound","meaning":"영화 속 허구 세계 안에 실제로 존재하는 소리로, 등장인물의 대사, 발소리, 배경 음악처럼 극중 인물이 들을 수 있는…","subcategory":"영화이론·영화기법","level":1,"related":["diegesis"],"prerequisites":[],"aliases":["내재음","디에게시스사운드"]},{"slug":"acousmatic-sound","title_ko":"아쿠스마틱사운드","title_en":"Acousmatic Sound","meaning":"소리의 발생원이 화면에 보이지 않는 상태로 들려오는 사운드를 가리키며, 음원의 정체가 감춰짐으로써 신비감이나 긴장감을…","subcategory":"영화이론·영화기법","level":2,"related":["diegetic-sound"],"prerequisites":["diegetic-sound"],"aliases":["아쿠스마틱"]},{"slug":"cinephilia","title_ko":"씨네필리아","title_en":"Cinephilia","meaning":"영화를 단순한 오락을 넘어 열정적이고 집요한 애호와 지적 탐구의 대상으로 삼는 문화적, 비평적 태도로, 씨네마테크 관람과…","subcategory":"영화이론·영화기법","level":3,"related":["auteur-theory"],"prerequisites":[],"aliases":["시네필","시네필리아"]},{"slug":"suture-theory","title_ko":"봉합이론","title_en":"Suture Theory","meaning":"영화 텍스트가 관객이 자신의 위치를 의식하지 못한 채 서사 속 주체로 자연스럽게 편입되도록 봉합하는 과정을 설명하는…","subcategory":"영화이론·영화기법","level":2,"related":["shot-reverse-shot"],"prerequisites":["shot-reverse-shot"],"aliases":["봉합이론(영화)"]},{"slug":"diegesis","title_ko":"디제시스","title_en":"Diegesis","meaning":"영화가 서술하는 허구적 사건들이 벌어지는 이야기 세계 전체를 가리키는 서사학적 개념으로, 등장인물이 존재하고 경험하는…","subcategory":"영화이론·영화기법","level":1,"related":["diegetic-sound"],"prerequisites":[],"pop":6,"aliases":["디에게시스"]},{"slug":"method-acting","title_ko":"메소드 연기","title_en":"Method Acting","meaning":"배우가 인물의 감정과 경험을 자신의 내면 기억과 심리적 상태를 통해 실제로 체험하듯 재현하고자 하는 연기 훈련법으로…","subcategory":"영화이론·영화기법","level":3,"related":["mise-en-scene-theatre"],"prerequisites":[],"aliases":["메서드연기","메소드액팅"]},{"slug":"depth-of-field","title_ko":"피사계심도","title_en":"Depth of Field","meaning":"카메라 렌즈의 초점이 맞는 것으로 인식되는 화면 내 전후 범위의 깊이를 가리키는 촬영 기술 용어로, 조리개 값, 렌즈의 초점…","subcategory":"영화이론·영화기법","level":2,"related":["rack-focus"],"prerequisites":[],"aliases":["심도"]},{"slug":"wipe-transition","title_ko":"와이프","title_en":"Wipe (Transition)","meaning":"화면의 한쪽에서 다른 쪽으로 선이나 패턴이 이동하며 이전 쇼트를 밀어내고 다음 쇼트가 그 자리를 채우는 편집 전환 기법이다.","subcategory":"영화이론·영화기법","level":2,"related":["whip-pan"],"prerequisites":[]},{"slug":"freeze-frame","title_ko":"프리즈프레임","title_en":"Freeze Frame","meaning":"움직이는 영상의 한 순간을 정지된 이미지처럼 고정하여 지속적으로 보여주는 기법으로, 서사의 특정 순간을 강조하거나 결말의…","subcategory":"영화이론·영화기법","level":2,"related":[],"prerequisites":[],"aliases":["정지화면"]},{"slug":"chroma-key","title_ko":"크로마키","title_en":"Chroma Key","meaning":"단색의 배경(주로 초록색 또는 파란색)을 앞에 두고 인물이나 사물을 촬영한 뒤, 후반 작업에서 그 단색 배경을 제거하고 다른…","subcategory":"영화이론·영화기법","level":2,"related":[],"prerequisites":[],"aliases":["그린스크린","블루스크린"]},{"slug":"stop-motion-animation","title_ko":"스톱모션애니메이션","title_en":"Stop-Motion Animation","meaning":"인형이나 모형을 조금씩 움직여 가며 한 프레임씩 촬영한 뒤 이를 연속 재생하여 마치 스스로 움직이는 것처럼 보이게 만드는…","subcategory":"영화이론·영화기법","level":3,"related":[],"prerequisites":[],"aliases":["스톱모션"]},{"slug":"camera-angle","title_ko":"카메라앵글","title_en":"Camera Angle","meaning":"카메라가 피사체를 바라보는 수직적 위치와 방향을 가리키는 개념으로, 하이앵글, 로우앵글, 아이레벨, 더치앵글 등으로 구분되며…","subcategory":"영화이론·영화기법","level":1,"related":["dutch-angle"],"prerequisites":[]},{"slug":"blocking-film","title_ko":"블로킹","title_en":"Blocking (Film)","meaning":"배우들이 촬영 장면 안에서 움직이고 위치를 잡는 동선과 배치를 사전에 계획하는 연출 작업으로, 카메라의 위치 및 움직임과…","subcategory":"영화이론·영화기법","level":2,"related":["mise-en-scene-theatre","long-take","tracking-shot"],"prerequisites":["long-take","tracking-shot"],"pop":4},{"slug":"insert-shot","title_ko":"인서트숏","title_en":"Insert Shot","meaning":"장면의 주된 흐름 안에 특정 사물이나 세부를 강조하기 위해 삽입되는 클로즈업 쇼트로, 대개 편지, 시계, 손동작 등…","subcategory":"영화이론·영화기법","level":3,"related":["cutaway-shot","close-up-shot","master-shot"],"prerequisites":["cutaway-shot","close-up-shot"],"aliases":["인서트","인서트쇼트"]},{"slug":"master-shot","title_ko":"마스터숏","title_en":"Master Shot","meaning":"한 장면 전체를 처음부터 끝까지 끊지 않고 담아내는 기준이 되는 쇼트로, 이후 클로즈업이나 인서트숏 등 세부 쇼트들이…","subcategory":"영화이론·영화기법","level":1,"related":["establishing-shot"],"prerequisites":[],"aliases":["마스터쇼트"]},{"slug":"title-sequence","title_ko":"타이틀시퀀스","title_en":"Title Sequence","meaning":"영화의 시작 부분에서 제목과 주요 제작진 정보를 시각적으로 디자인하여 제시하는 시퀀스로, 종종 영화의 톤과 주제를 예고하는…","subcategory":"영화이론·영화기법","level":3,"related":[],"prerequisites":[],"aliases":["오프닝타이틀"]},{"slug":"alienation-effect","title_ko":"소격효과","title_en":"Verfremdungseffekt (Alienation Effect)","meaning":"베르톨트 브레히트가 서사극 이론에서 제시한 연출·연기 기법으로, 관객이 무대 위 사건에 감정적으로 동일시되지 않고 비판적…","subcategory":"공연예술·연극학","level":1,"related":["epic-theatre","gestus","defamiliarization","brechtian-directing"],"prerequisites":[],"aliases":["Alienation Effect"]},{"slug":"epic-theatre","title_ko":"서사극","title_en":"Epic Theatre","meaning":"브레히트가 정립한 연극 형식으로, 극적 사건을 감정적 몰입이 아닌 서술적·해설적 구조로 제시하여 관객의 사회적 비판 의식을…","subcategory":"공연예술·연극학","level":1,"related":["alienation-effect","gestus","montage-technique"],"prerequisites":[],"aliases":["에픽시어터","서사극(브레히트)"]},{"slug":"gestus","title_ko":"게스투스","title_en":"Gestus","meaning":"브레히트 연극론에서 인물의 사회적 태도와 계급적 관계를 압축적으로 드러내는 몸짓·어조·자세의 총체를 가리키는 개념이다.","subcategory":"공연예술·연극학","level":1,"related":["epic-theatre","alienation-effect","brechtian-directing"],"prerequisites":[]},{"slug":"historicization","title_ko":"역사화 기법","title_en":"Historicization","meaning":"브레히트 서사극에서 현재의 사건을 마치 과거의 특정 역사적 국면처럼 제시함으로써 그것이 변화 가능한 사회적 산물임을 드러내는…","subcategory":"공연예술·연극학","level":3,"related":["alienation-effect","epic-theatre","brechtian-directing"],"prerequisites":["alienation-effect","epic-theatre","brechtian-directing"]},{"slug":"montage-technique","title_ko":"몽타주기법","title_en":"Montage Technique","meaning":"서로 다른 장면이나 요소를 연속적 인과관계 없이 병치·충돌시켜 새로운 의미를 생성하는 구성 기법으로, 서사극과…","subcategory":"공연예술·연극학","level":1,"related":["epic-theatre"],"prerequisites":[]},{"slug":"brechtian-directing","title_ko":"브레히트식연출법","title_en":"Brechtian Directing","meaning":"브레히트의 서사극 이론에 기반해 조명·자막·해설·소도구 사용 등을 통해 극적 환영을 의도적으로 노출시키는 연출 방식이다.","subcategory":"공연예술·연극학","level":1,"related":["alienation-effect","epic-theatre","gestus"],"prerequisites":[]},{"slug":"stanislavski-system","title_ko":"스타니슬랍스키 시스템","title_en":"Stanislavski System","meaning":"콘스탄틴 스타니슬랍스키가 정립한 배우 훈련 및 연기 방법론으로, 인물의 내적 진실성과 심리적 사실성을 무대 위에서 구현하기…","subcategory":"공연예술·연극학","level":1,"related":["super-objective"],"prerequisites":[],"aliases":["스타니슬라브스키시스템","스타니슬랍스키연기법"]},{"slug":"magic-if","title_ko":"매직이프(마법의 만약)","title_en":"Magic If","meaning":"스타니슬랍스키 시스템의 핵심 개념으로, 배우가 '만약 내가 이 인물이라면'이라는 가정을 통해 극중 상황에 상상적으로 몰입하는…","subcategory":"공연예술·연극학","level":3,"related":["stanislavski-system","super-objective"],"prerequisites":["stanislavski-system","super-objective"],"pop":1,"aliases":["마법의 만약","마법의만약","마법의 만약(매직 이프)","매직 이프","마법의만약(매직이프)"]},{"slug":"super-objective","title_ko":"초목표","title_en":"Super-Objective","meaning":"스타니슬랍스키 시스템에서 인물이 극 전체를 통해 궁극적으로 추구하는 근본적 욕망이나 목적을 가리키는 개념이다.","subcategory":"공연예술·연극