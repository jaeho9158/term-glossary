 "legend": [
  {
   "sym": "전류",
   "desc": "건전지의 + 극에서 나와 코일을 지나 − 극으로 돌아가는 방향(화살표)",
   "kind": "term"
  },
  {
   "sym": "N, S",
   "desc": "자석의 북극과 남극. 오른손의 네 손가락을 전류 방향으로 감아쥐면 엄지가 가리키는 쪽이 N극이다.",
   "kind": "abbr"
  },
  {
   "sym": "자기력선",
   "desc": "점선 곡선과 철심 속 화살표. 철심 안에서는 S극에서 N극 쪽으로, 밖에서는 N극에서 S극 쪽으로 이어진다.",
   "kind": "term"
  },
  {
   "desc": "철심을 넣으면 코일만 있을 때보다 자기장이 수천 배까지 세진다. 전류 방향을 바꾸면 N극과 S극이 바뀐다."
  }
 ],
