[{"slug":"flow-cytometry","title_ko":"유세포분석","title_en":"Flow Cytometry","meaning":"레이저 앞으로 세포를 한 줄로 흘려보내면서 수천~수만 개의 세포 하나하나의 크기와 표지 여부를 빠르게 측정하는 기법입니다.","subcategory":"실험기기·측정장비","level":1,"related":["elisa","biomarker","single-cell-cloning"],"prerequisites":[],"pop":3,"aliases":["유세포분석법","FCM","플로우사이토메트리","Flow Cytometry Analysis"]},{"slug":"site-directed-mutagenesis","title_ko":"부위특이적 돌연변이유발","title_en":"Site-Directed Mutagenesis","meaning":"DNA 서열 중 미리 정해둔 특정 위치의 염기를 원하는 대로 바꾸어 넣는 정밀한 시험관 내 돌연변이 유발 기법입니다.","subcategory":"유전공학·genome편집","level":2,"related":["plasmid-vector"],"prerequisites":[],"aliases":["부위특이적돌연변이유발"]},{"slug":"golden-gate-cloning","title_ko":"골든게이트 클로닝","title_en":"Golden Gate Cloning","meaning":"타입 IIS 제한효소를 이용해 여러 DNA 조각을 한 번의 반응으로 정해진 순서와 방향으로 정확하게 조립하는 클로닝…","subcategory":"유전공학·genome편집","level":2,"related":["plasmid-vector"],"prerequisites":[],"pop":8,"aliases":["골든게이트클로닝"]},{"slug":"plasmid-vector","title_ko":"플라스미드 벡터","title_en":"Plasmid Vector","meaning":"세균 등의 세포 내에서 독립적으로 복제되며 외부 유전자를 운반·발현시키는 데 사용되는 원형의 이중가닥 DNA 분자입니다.","subcategory":"유전공학·genome편집","level":2,"related":["golden-gate-cloning"],"prerequisites":[],"aliases":["플라스미드벡터"]},{"slug":"adeno-associated-virus-vector","title_ko":"아데노연관바이러스 벡터","title_en":"Adeno-Associated Virus Vector","meaning":"아데노연관바이러스(AAV)의 껍데기를 이용해 원하는 유전자를 세포나 개체 안으로 안전하게 전달하는 유전자 치료용 운반체입니다.","subcategory":"유전공학·genome편집","level":2,"related":[],"prerequisites":[],"aliases":["AAVV","아데노연관바이러스벡터"]},{"slug":"crispr-interference","title_ko":"크리스퍼 간섭","title_en":"CRISPR Interference","meaning":"DNA를 절단하지 않고 비활성화된 Cas9 단백질을 이용해 목표 유전자의 전사를 물리적으로 방해함으로써 발현을 억제하는…","subcategory":"유전공학·genome편집","level":2,"related":[],"prerequisites":[],"aliases":["크리스퍼간섭"]},{"slug":"dcas9-fusion-protein","title_ko":"불활성 카스9 융합단백질","title_en":"dCas9 Fusion Protein","meaning":"DNA를 절단하는 촉매 활성이 제거된 Cas9(dCas9, dead Cas9)에 다른 기능성 단백질을 결합시켜, DNA…","subcategory":"유전공학·genome편집","level":2,"related":["gene-silencing"],"prerequisites":[],"pop":6,"aliases":["불활성카스9융합단백질"]},{"slug":"gene-silencing","title_ko":"유전자 사일런싱","title_en":"Gene Silencing","meaning":"특정 유전자의 발현을 전사 또는 전사 후 단계에서 억제해 해당 유전자의 단백질 생성을 줄이거나 막는 현상 또는 기술을…","subcategory":"유전공학·genome편집","level":2,"related":["small-interfering-rna","dcas9-fusion-protein"],"prerequisites":[],"aliases":["유전자사일런싱"]},{"slug":"small-interfering-rna","title_ko":"소간섭RNA","title_en":"Small Interfering RNA","meaning":"약 20~25개 염기쌍 길이의 짧은 이중가닥 RNA로, RNA 간섭 경로를 통해 상보적인 서열을 가진 표적 mRNA를…","subcategory":"유전공학·genome편집","level":2,"related":["gene-silencing"],"prerequisites":[],"aliases":["siRNA"]},{"slug":"phage-display","title_ko":"파지 디스플레이","title_en":"Phage Display","meaning":"박테리오파지의 표면 단백질 유전자에 외래 유전자를 융합시켜, 파지 표면에 특정 단백질이나 펩타이드를 발현시키고 그 유전정보를…","subcategory":"유전공학·genome편집","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["파지디스플레이"]},{"slug":"fermentation-kinetics","title_ko":"발효 동역학","title_en":"Fermentation Kinetics","meaning":"발효 과정에서 미생물의 증식 속도, 기질 소모 속도, 생성물 축적 속도가 시간에 따라 어떻게 변하는지를 수학적으로 기술하는…","subcategory":"발효·바이오공정","level":2,"related":[],"prerequisites":[],"aliases":["발효동역학"]},{"slug":"ph-feedback-control","title_ko":"pH 피드백 제어","title_en":"pH Feedback Control","meaning":"발효조나 생물반응기 내부의 pH를 실시간으로 측정하고, 미리 정해둔 목표값과의 차이를 계산해 산 또는 염기 용액을 자동으로…","subcategory":"발효·바이오공정","level":2,"related":["substrate-inhibition"],"prerequisites":[],"aliases":["pH피드백제어"]},{"slug":"adaptive-laboratory-evolution","title_ko":"적응 실험실 진화","title_en":"Adaptive Laboratory Evolution","meaning":"미생물을 특정 선택압(예: 특정 탄소원, 스트레스 조건) 아래 장기간 계대 배양하여 자연적인 돌연변이와 선택을 통해 원하는…","subcategory":"발효·바이오공정","level":2,"related":[],"prerequisites":[],"aliases":["적응실험실진화"]},{"slug":"substrate-inhibition","title_ko":"기질저해","title_en":"Substrate Inhibition","meaning":"미생물의 성장이나 효소 반응 속도가 기질(원료 물질) 농도가 낮을 때는 증가하다가, 특정 농도를 넘어서면 오히려 감소하는…","subcategory":"발효·바이오공정","level":2,"related":["ph-feedback-control"],"prerequisites":[]},{"slug":"tangential-flow-filtration","title_ko":"접선유동 여과","title_en":"Tangential Flow Filtration","meaning":"시료를 여과막 표면에 평행하게 흘려보내면서 압력 차로 여과하는 방식으로, 막힘을 줄이면서 대용량 시료를 처리하는 여과…","subcategory":"발효·바이오공정","level":2,"related":[],"prerequisites":[],"aliases":["접선유동여과"]},{"slug":"solid-state-fermentation","title_ko":"고체상 발효","title_en":"Solid-State Fermentation","meaning":"자유수가 거의 없는 고체 기질 위에서 미생물을 배양하여 대사산물을 생산하는 발효 방식입니다.","subcategory":"발효·바이오공정","level":2,"related":[],"prerequisites":[],"aliases":["고체상발효"]},{"slug":"mesenchymal-stem-cell","title_ko":"중간엽줄기세포","title_en":"Mesenchymal Stem Cell","meaning":"골수, 지방, 탯줄 등에서 얻을 수 있으며 뼈, 연골, 지방세포 등 중간엽 계통 세포로 분화할 수 있는 성체줄기세포입니다.","subcategory":"세포·조직공학","level":2,"related":[],"prerequisites":[],"aliases":["MSC","간엽줄기세포"]},{"slug":"single-cell-cloning","title_ko":"단일세포 클로닝","title_en":"Single-Cell Cloning","meaning":"단 하나의 세포를 분리해 배양함으로써 그 세포에서 유래한 유전적으로 동일한 세포 집단(클론)을 만드는 기법입니다.","subcategory":"세포·조직공학","level":2,"related":["flow-cytometry"],"prerequisites":[],"aliases":["단일세포클로닝"]},{"slug":"cell-line-immortalization","title_ko":"세포주 불멸화","title_en":"Cell Line Immortalization","meaning":"정상적으로는 유한한 횟수만 분열하는 세포에 특정 유전자를 도입하거나 변이를 유도하여, 세포분열 한계를 극복하고 무한히 증식할…","subcategory":"세포·조직공학","level":2,"related":["cryopreservation-protocol"],"prerequisites":[],"aliases":["세포주불멸화"]},{"slug":"cryopreservation-protocol","title_ko":"동결보존 프로토콜","title_en":"Cryopreservation Protocol","meaning":"세포나 조직을 극저온 상태로 얼려 손상을 최소화하면서 장기간 보관했다가 필요할 때 다시 살려 사용할 수 있게 하는 표준화된…","subcategory":"세포·조직공학","level":2,"related":["cell-line-immortalization"],"prerequisites":[],"pop":14,"aliases":["동결보존프로토콜"]},{"slug":"bone-regeneration-scaffold","title_ko":"골재생 스캐폴드","title_en":"Bone Regeneration Scaffold","meaning":"손상된 뼈 조직의 재생을 돕기 위해 세포와 조직이 자라날 수 있는 3차원 구조를 제공하는 생체적합성 지지체입니다.","subcategory":"세포·조직공학","level":2,"related":[],"prerequisites":[],"pop":9,"aliases":["골재생스캐폴드"]},{"slug":"viral-vector-vaccine","title_ko":"바이러스벡터 백신","title_en":"Viral Vector Vaccine","meaning":"감염력은 약화되었지만 세포에 유전정보를 전달하는 능력은 유지된 바이러스를 운반체로 이용해, 목표 항원 유전자를 체내 세포로…","subcategory":"바이오의약품·진단기술","level":2,"related":[],"prerequisites":[],"aliases":["바이러스벡터백신"]},{"slug":"targeted-nanoparticle-delivery","title_ko":"표적 나노입자 전달","title_en":"Targeted Nanoparticle Delivery","meaning":"나노미터 크기의 입자에 약물을 담고 표면에 표적 인식 물질을 부착하여, 특정 세포나 조직에 선택적으로 약물을 전달하는…","subcategory":"바이오의약품·진단기술","level":2,"related":[],"prerequisites":[],"aliases":["표적나노입자전달"]},{"slug":"loop-mediated-isothermal-amplification","title_ko":"루프매개 등온증폭법","title_en":"Loop-Mediated Isothermal Amplification","meaning":"일정한 온도만 유지한 채 여러 개의 프라이머를 이용해 DNA를 빠르게 증폭시키는 기법으로, 흔히 LAMP로 불립니다.","subcategory":"바이오의약품·진단기술","level":2,"related":[],"prerequisites":[],"aliases":["LAMP"]},{"slug":"proteomic-profiling","title_ko":"단백질체 프로파일링","title_en":"Proteomic Profiling","meaning":"특정 세포, 조직, 시료 안에 존재하는 단백질들의 종류와 발현량 패턴을 포괄적으로 분석하여 전체적인 특성을 그려내는…","subcategory":"바이오의약품·진단기술","level":2,"related":[],"prerequisites":[],"aliases":["단백질체프로파일링"]},{"slug":"crispr-cas9-genome-editing","title_ko":"CRISPR-Cas9 유전체 편집","title_en":"CRISPR-Cas9 Genome Editing","meaning":"가이드 RNA가 지정한 특정 DNA 서열을 Cas9 단백질이 절단하여 유전체를 원하는 위치에서 편집하는 기술입니다.","subcategory":"유전공학","level":2,"related":["gene-drive-mechanism","off-target-effect-crispr"],"prerequisites":[],"pop":13,"aliases":["CRISPR Cas9 유전체 편집","CRISPR-Cas9유전체편집","CRISPRCas9 유전체 편집"]},{"slug":"gene-drive-mechanism","title_ko":"유전자 드라이브 기전","title_en":"Gene Drive Mechanism","meaning":"특정 유전자가 멘델 유전 법칙보다 훨씬 높은 확률로 자손에게 전달되도록 유도하여 집단 전체에 빠르게 퍼뜨리는 유전적…","subcategory":"유전공학","level":2,"related":["crispr-cas9-genome-editing","off-target-effect-crispr"],"prerequisites":[],"pop":10,"aliases":["유전자드라이브기전"]},{"slug":"off-target-effect-crispr","title_ko":"CRISPR 표적 이탈 효과","title_en":"Off-Target Effect in CRISPR","meaning":"CRISPR-Cas9 시스템이 의도한 표적 서열이 아닌 유전체의 다른 위치를 절단하는 의도치 않은 편집 현상입니다.","subcategory":"유전공학","level":2,"related":["crispr-cas9-genome-editing","gene-drive-mechanism"],"prerequisites":[],"pop":1,"aliases":["CRISPR표적이탈효과"]},{"slug":"phage-display-technology","title_ko":"파지 디스플레이 기술","title_en":"Phage Display Technology","meaning":"박테리오파지 표면에 다양한 단백질을 발현시켜 원하는 표적에 결합하는 후보를 대규모 라이브러리에서 선별하는 기술입니다.","subcategory":"항체공학","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["파지디스플레이기술"]},{"slug":"de-novo-protein-design","title_ko":"신규 단백질 설계","title_en":"De Novo Protein Design","meaning":"자연에 존재하는 단백질을 변형하는 대신, 원하는 구조와 기능을 목표로 아미노산 서열을 처음부터 새로 설계하는 기술입니다.","subcategory":"단백질공학","level":2,"related":["proteomics-mass-spectrometry"],"prerequisites":[],"pop":4,"aliases":["DNPD","신규단백질설계"]},{"slug":"biosensor-whole-cell","title_ko":"전세포 바이오센서","title_en":"Whole-Cell Biosensor","meaning":"살아있는 세포 전체를 이용해 특정 물질이나 환경 신호를 감지하고 이를 형광, 발광 등 측정 가능한 신호로 변환하는 생물학적…","subcategory":"합성생물학","level":2,"related":[],"prerequisites":[],"aliases":["전세포바이오센서"]},{"slug":"chip-seq-analysis","title_ko":"염색질면역침전-시퀀싱 분석","title_en":"ChIP-Seq Analysis","meaning":"특정 단백질이 결합하는 DNA 부위를 항체로 포획한 뒤 시퀀싱하여 유전체 전체에서 그 결합 위치를 밝혀내는 분석 기법입니다.","subcategory":"오믹스분석","level":2,"related":[],"prerequisites":[],"aliases":["염색질면역침전 시퀀싱 분석","염색질면역침전-시퀀싱분석","염색질면역침전시퀀싱 분석"]},{"slug":"proteomics-mass-spectrometry","title_ko":"질량분석 기반 단백체학","title_en":"Proteomics via Mass Spectrometry","meaning":"질량분석기를 이용해 시료 안에 존재하는 단백질의 종류와 양, 변형 상태를 대규모로 동시에 분석하는 단백체 연구 기법입니다.","subcategory":"오믹스분석","level":2,"related":["de-novo-protein-design"],"prerequisites":[],"aliases":["PVMS","질량분석기반단백체학"]},{"slug":"antisense-oligonucleotide-therapy","title_ko":"안티센스 올리고뉴클레오티드 치료","title_en":"Antisense Oligonucleotide Therapy","meaning":"표적 mRNA와 상보적으로 결합하는 짧은 합성 핵산 가닥을 이용해 특정 유전자의 발현이나 이어맞추기(스플라이싱)를 조절하는…","subcategory":"핵산치료공학","level":2,"related":[],"prerequisites":[],"aliases":["안티센스올리고뉴클레오티드치료"]},{"slug":"perfusion-cell-culture","title_ko":"관류 세포배양","title_en":"Perfusion Cell Culture","meaning":"세포는 생물반응기 내에 유지한 채 신선한 배지를 지속적으로 공급하고 노폐물이 섞인 배지를 동시에 제거하는 연속식 세포배양…","subcategory":"바이오공정공학","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["관류세포배양"]},{"slug":"quorum-sensing-manipulation","title_ko":"쿼럼센싱 조작","title_en":"Quorum Sensing Manipulation","meaning":"세균이 개체 밀도를 감지해 집단 행동을 조율하는 신호전달 체계(쿼럼센싱)를 인위적으로 촉진하거나 억제하여 미생물 행동을…","subcategory":"미생물공학","level":2,"related":["extremophile-enzyme-bioprospecting"],"prerequisites":[],"pop":7,"aliases":["QSM","쿼럼센싱조작"]},{"slug":"extremophile-enzyme-bioprospecting","title_ko":"극한미생물 효소 자원탐사","title_en":"Extremophile Enzyme Bioprospecting","meaning":"고온, 고염, 강산성 등 극한 환경에 사는 미생물로부터 산업적으로 유용한 효소를 탐색하고 발굴하는 활동입니다.","subcategory":"미생물공학","level":2,"related":["quorum-sensing-manipulation"],"prerequisites":[],"aliases":["EEB","극한미생물효소자원탐사"]},{"slug":"plant-molecular-farming","title_ko":"식물분자농업","title_en":"Plant Molecular Farming","meaning":"식물을 유전적으로 조작하여 백신, 항체, 산업용 단백질 같은 유용 물질을 생산하는 생물공장으로 활용하는 기술입니다.","subcategory":"식물생명공학","level":2,"related":[],"prerequisites":[]},{"slug":"brain-organoid-model","title_ko":"뇌 오가노이드 모델","title_en":"Brain Organoid Model","meaning":"줄기세포를 3차원으로 배양하여 사람 뇌 조직의 구조와 세포 다양성을 부분적으로 재현한 미니어처 모델입니다.","subcategory":"신경생명공학","level":2,"related":["high-throughput-drug-screening"],"prerequisites":[],"aliases":["BOM","뇌오가노이드모델"]},{"slug":"high-throughput-drug-screening","title_ko":"고속대량 약물 스크리닝","title_en":"High-Throughput Drug Screening","meaning":"자동화 장비와 소형화된 실험 플레이트를 이용해 수많은 화합물의 생물학적 활성을 짧은 시간 안에 대량으로 검사하는 실험…","subcategory":"제약생명공학","level":2,"related":["brain-organoid-model"],"prerequisites":[],"aliases":["HTDS","고속대량약물스크리닝"]},{"slug":"multi-omics-data-integration","title_ko":"다중오믹스 데이터 통합","title_en":"Multi-Omics Data Integration","meaning":"유전체, 전사체, 단백질체, 대사체 등 서로 다른 층위의 생물학적 데이터를 결합하여 종합적으로 해석하는 분석 접근법입니다.","subcategory":"바이오인포매틱스","level":2,"related":[],"prerequisites":[],"aliases":["MODI","다중오믹스데이터통합"]},{"slug":"fluorescence-resonance-energy-transfer","title_ko":"형광공명에너지전달","title_en":"fluorescence resonance energy transfer","meaning":"두 형광분자가 매우 가까울 때만 에너지가 옮겨가는 현상으로 분자 간 거리를 재는 원리입니다.","subcategory":"실험기기·측정장비","level":2,"related":[],"prerequisites":[],"