[{"slug":"fraunhofer-diffraction","title_ko":"프라운호퍼 회절","title_en":"Fraunhofer Diffraction","meaning":"회절을 일으키는 개구로부터 충분히 먼 거리, 즉 원거리장에서 관찰되는 단순하고 안정된 형태의 회절 패턴입니다.","subcategory":"파동광학","level":2,"related":[],"prerequisites":[],"pop":9,"aliases":["프라운호퍼회절"]},{"slug":"longitudinal-mode","title_ko":"종모드","title_en":"Longitudinal Mode","meaning":"광공진기의 축 방향으로 정상파를 형성하며 존재할 수 있는, 서로 다른 진동수를 가진 개별 발진 모드입니다.","subcategory":"레이저공학","level":2,"related":[],"prerequisites":[]},{"slug":"erbium-doped-fiber-amplifier","title_ko":"어븀첨가 광섬유증폭기","title_en":"Erbium-Doped Fiber Amplifier","meaning":"어븀 이온이 첨가된 광섬유를 이득매질로 사용해, 전기 신호로 변환하지 않고 광신호를 그대로 증폭하는 광섬유 증폭기입니다.","subcategory":"광섬유공학","level":2,"related":[],"prerequisites":[],"aliases":["EDFA","어븀첨가광섬유증폭기"]},{"slug":"optical-transceiver","title_ko":"광송수신기","title_en":"Optical Transceiver","meaning":"전기 신호를 광신호로 변환해 송신하고, 수신한 광신호를 다시 전기 신호로 복원하는 광통신용 송수신 모듈을 말합니다.","subcategory":"광통신","level":2,"related":[],"prerequisites":[],"pop":7},{"slug":"fiber-attenuation","title_ko":"광섬유 감쇠","title_en":"Fiber Attenuation","meaning":"빛이 광섬유를 따라 진행하는 동안 흡수, 산란 등으로 세기가 점차 줄어드는 현상, 또는 그 정도를 나타내는 값입니다.","subcategory":"광섬유공학","level":2,"related":[],"prerequisites":[],"aliases":["광섬유감쇠"]},{"slug":"light-emitting-diode","title_ko":"발광다이오드","title_en":"Light Emitting Diode","meaning":"반도체 pn접합에 순방향 전류를 흘려 전자와 정공이 재결합할 때 발생하는 에너지를 빛으로 방출하는 반도체 소자입니다.","subcategory":"광전자공학","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["LED"]},{"slug":"fizeau-interferometer","title_ko":"피조 간섭계","title_en":"Fizeau Interferometer","meaning":"기준면과 측정할 표면 사이에서 반사된 빛끼리 간섭시켜 두 면 사이의 미세한 형상 차이를 측정하는 간섭계입니다.","subcategory":"광계측·분광학","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["피조간섭계"]},{"slug":"directional-coupler","title_ko":"방향성결합기","title_en":"Directional Coupler","meaning":"두 개의 광도파로를 아주 가깝게 나란히 배치하여 한쪽 도파로의 빛 일부를 다른 쪽 도파로로 옮겨주는 광학 소자입니다.","subcategory":"집적광학·포토닉스","level":2,"related":[],"prerequisites":[],"pop":1},{"slug":"angular-spectrum-method","title_ko":"각스펙트럼법","title_en":"Angular Spectrum Method","meaning":"한 평면의 광 파동을 여러 방향으로 진행하는 평면파들의 합으로 분해하고, 각 성분을 따로 전파시켜 다시 더함으로써 빛의…","subcategory":"파동광학","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["Angular Spectrum Method"]},{"slug":"coherent-optical-communication","title_ko":"코히런트 광통신","title_en":"Coherent Optical Communication","meaning":"광신호의 위상과 진폭 정보를 함께 이용해 수신 측에서 국부발진 레이저와 간섭시켜 신호를 검출하는 광통신 방식입니다.","subcategory":"광통신","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["Coherent Optical Communication","코히런트광통신"]},{"slug":"coherent-state-of-light","title_ko":"코히런트 상태 광","title_en":"Coherent State of Light","meaning":"코히런트 상태 광은 레이저처럼 위상과 진폭이 일정하게 유지되는 양자광학적 광 상태로, 고전적인 전자기파의 성질을 가장 잘…","subcategory":"양자광학","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["Coherent State of Light","코히런트상태광"]},{"slug":"fiber-nonlinearity-coefficient","title_ko":"광섬유 비선형 계수","title_en":"Fiber Nonlinearity Coefficient","meaning":"광섬유 안에서 빛의 세기가 커질수록 굴절률이 얼마나 민감하게 변하는지를 나타내는 값으로, 신호가 스스로 자신의 위상이나…","subcategory":"광섬유공학","level":2,"related":[],"prerequisites":[],"aliases":["Fiber Nonlinearity Coefficient","FNC","광섬유비선형계수"]},{"slug":"pulsed-laser-ablation","title_ko":"펄스레이저 어블레이션","title_en":"Pulsed Laser Ablation","meaning":"짧은 레이저 펄스를 물질 표면에 쏘아 순간적으로 강한 에너지를 전달함으로써 물질을 증발시키거나 깎아내는 가공 기술입니다.","subcategory":"레이저공학","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["Pulsed Laser Ablation","펄스레이저어블레이션"]},{"slug":"spherical-aberration-correction","title_ko":"구면수차 보정","title_en":"Spherical Aberration Correction","meaning":"구면 렌즈에서 광축 근처를 지나는 광선과 가장자리를 지나는 광선의 초점이 서로 어긋나는 구면수차를 줄이기 위한 광학 설계…","subcategory":"광학설계","level":1,"related":[],"prerequisites":[],"aliases":["구면수차보정"]},{"slug":"quantum-cascade-laser","title_ko":"양자종속레이저","title_en":"Quantum Cascade Laser","meaning":"전자가 여러 층의 양자우물을 계단식으로 통과하며 매번 광자를 방출하는 독특한 구조를 이용해 중적외선에서 테라헤르츠 대역까지…","subcategory":"광전자공학","level":1,"related":[],"prerequisites":[],"aliases":["QCL"]},