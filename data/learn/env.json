[{"slug":"cod","title_ko":"화학적산소요구량","title_en":"Chemical Oxygen Demand","meaning":"수중 유기물을 강산화제로 화학적으로 산화시킬 때 소모되는 산소량으로 환산한 값으로, 생분해성·난분해성 유기물을 모두 포함하는…","subcategory":"환경공학·오염관리","level":1,"related":["biochemical-oxygen-demand","toc"],"prerequisites":[],"aliases":["COD"]},{"slug":"toc","title_ko":"총유기탄소","title_en":"Total Organic Carbon","meaning":"수중에 존재하는 유기물에 포함된 탄소의 총량을 직접 측정한 값으로, 유기오염 정도를 신속하고 정밀하게 나타내는 지표이다.","subcategory":"환경공학·오염관리","level":1,"related":["biochemical-oxygen-demand","cod"],"prerequisites":[],"pop":14},{"slug":"suspended-solids","title_ko":"부유물질","title_en":"Suspended Solids","meaning":"물속에 부유하는 고형물질의 총량으로, 여과지에 남는 입자상 물질의 건조 중량으로 정량하며 탁도 및 수질 악화의 주요 원인이다.","subcategory":"환경공학·오염관리","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["SS"]},{"slug":"rotating-biological-contactor","title_ko":"회전원판법","title_en":"Rotating Biological Contactor","meaning":"원판형 접촉재를 회전시키며 하수와 공기에 번갈아 접촉시켜 표면에 부착된 미생물막이 유기물을 분해하도록 하는 생물막 처리…","subcategory":"환경공학·오염관리","level":3,"related":["trickling-filter","nitrification"],"prerequisites":[]},{"slug":"aeration-tank","title_ko":"폭기조","title_en":"Aeration Tank","meaning":"활성슬러지 공정에서 공기(산소)를 공급하여 호기성 미생물이 유기물을 분해하도록 하는 반응조로, 용존산소 및 MLSS 농도…","subcategory":"환경공학·오염관리","level":2,"related":["nitrification","sequencing-batch-reactor"],"prerequisites":[]},{"slug":"chlorination","title_ko":"염소소독","title_en":"Chlorination","meaning":"염소 또는 차아염소산나트륨을 주입하여 수중 병원성 미생물을 산화·살균하는 가장 널리 쓰이는 소독 방법이다.","subcategory":"환경공학·오염관리","level":1,"related":[],"prerequisites":[]},{"slug":"a2o-process","title_ko":"A2O공정","title_en":"Anaerobic-Anoxic-Oxic Process","meaning":"혐기조-무산소조-호기조를 순차 배치하여 유기물, 질소, 인을 동시에 제거하는 대표적인 영양염류 제거 하수처리 공정이다.","subcategory":"환경공학·오염관리","level":1,"related":["nitrification","denitrification"],"prerequisites":[],"pop":15,"aliases":["AAOP"]},{"slug":"sequencing-batch-reactor","title_ko":"연속회분식반응조","title_en":"Sequencing Batch Reactor","meaning":"유입-반응-침전-배출-휴지 단계를 하나의 반응조에서 시간차로 순환 운전하여 유기물, 질소, 인을 제거하는 회분식 하수처리…","subcategory":"환경공학·오염관리","level":3,"related":["nitrification","denitrification"],"prerequisites":[],"pop":12,"aliases":["SBR"]},{"slug":"aerobic-digestion","title_ko":"호기성소화","title_en":"Aerobic Digestion","meaning":"산소를 공급한 조건에서 미생물의 내생호흡을 유도해 슬러지 중 유기물을 산화·안정화시키는 슬러지 감량화 공정이다.","subcategory":"환경공학·오염관리","level":3,"related":["aeration-tank"],"prerequisites":[]},{"slug":"sludge-conditioning","title_ko":"슬러지개량","title_en":"Sludge Conditioning","meaning":"슬러지의 탈수성을 개선하기 위해 응집제나 열처리 등으로 슬러지 입자 구조를 변화시키는 탈수 전처리 공정이다.","subcategory":"환경공학·오염관리","level":2,"related":[],"prerequisites":[]},{"slug":"water-quality-standard","title_ko":"수질환경기준","title_en":"Water Quality Standard","meaning":"하천, 호소 등 공공수역의 이용목적에 따라 유지되어야 할 수질 항목별 기준값을 법으로 정한 환경정책 기준이다.","subcategory":"환경공학·오염관리","level":1,"related":["biochemical-oxygen-demand"],"prerequisites":[],"aliases":["WQS"]},{"slug":"total-nitrogen","title_ko":"총질소","title_en":"Total Nitrogen","meaning":"유기성질소, 암모니아성질소, 아질산성질소, 질산성질소를 모두 합산한 값으로, 부영양화 관리를 위한 핵심 수질 지표이다.","subcategory":"환경공학·오염관리","level":3,"related":["a2o-process","water-quality-standard"],"prerequisites":["a2o-process","water-quality-standard"],"aliases":["T-N"]},{"slug":"constructed-wetland","title_ko":"인공습지","title_en":"Constructed Wetland","meaning":"습지 식물, 토양, 미생물의 자연정화 기능을 인위적으로 조성하여 오염된 물을 저비용으로 정화하는 자연친화형 처리시설이다.","subcategory":"환경공학·오염관리","level":2,"related":[],"prerequisites":[]},{"slug":"wet-scrubber","title_ko":"세정집진기","title_en":"Wet Scrubber","meaning":"액체(물 등)를 오염가스와 접촉시켜 먼지 입자나 가스상 오염물질을 흡수·포집하는 대기오염방지시설이다.","subcategory":"환경공학·오염관리","level":2,"related":["flue-gas-desulfurization","sulfur-oxides"],"prerequisites":["flue-gas-desulfurization"],"pop":6},{"slug":"flue-gas-desulfurization","title_ko":"탈황설비","title_en":"Flue Gas Desulfurization","meaning":"석회석 등 흡수제를 이용해 배출가스 중 황산화물을 화학적으로 흡수·제거하는 대기오염방지 설비로, 습식과 건식 방식이 있다.","subcategory":"환경공학·오염관리","level":1,"related":["sulfur-oxides","wet-scrubber"],"prerequisites":[],"pop":4,"aliases":["FGD","배연탈황"]},{"slug":"denox-facility","title_ko":"탈질설비","title_en":"DeNOx Facility","meaning":"배출가스 중 질소산화물을 SCR, SNCR 등의 방법으로 저감하는 대기오염방지설비를 통칭하는 용어이다.","subcategory":"환경공학·오염관리","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["탈질"]},{"slug":"sulfur-oxides","title_ko":"황산화물","title_en":"Sulfur Oxides","meaning":"화석연료 연소 시 황 성분이 산화되어 발생하는 이산화황 등을 통칭하는 대기오염물질로, 산성비의 주요 원인이다.","subcategory":"환경공학·오염관리","level":2,"related":["flue-gas-desulfurization","wet-scrubber"],"prerequisites":["flue-gas-desulfurization"],"pop":8,"aliases":["SOx"]},{"slug":"ultrafiltration","title_ko":"한외여과","title_en":"Ultrafiltration","meaning":"정밀여과보다 작은 공극을 가진 막으로 콜로이드, 바이러스, 고분자 물질을 제거하는 막여과 기술로, MBR 등에 활용된다.","subcategory":"환경공학·오염관리","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["UF"]},{"slug":"total-coliform","title_ko":"총대장균군","title_en":"Total Coliform","meaning":"분변 오염 여부를 판단하기 위한 지표미생물로, 물속 총대장균군의 검출 여부와 개체수로 병원성미생물 오염 가능성을 간접…","subcategory":"환경공학·오염관리","level":3,"related":["chlorination"],"prerequisites":["chlorination"],"pop":13,"aliases":["총대장균"]},{"slug":"rain-garden","title_ko":"빗물정원","title_en":"Rain Garden","meaning":"빗물을 일시적으로 저류시키고 식생과 토양을 통해 침투·정화시키는 소규모 식재형 시설로, 저영향개발의 대표적 기법이다.","subcategory":"환경공학·오염관리","level":3,"related":[],"prerequisites":[],"aliases":["레인가든"]},{"slug":"permeable-reactive-barrier","title_ko":"투수성반응벽체","title_en":"Permeable Reactive Barrier","meaning":"오염된 지하수의 흐름 경로에 반응성 물질을 채운 벽체를 설치하여 지하수가 통과하면서 오염물질이 분해·흡착되도록 하는 수동형…","subcategory":"환경공학·오염관리","level":2,"related":[],"prerequisites":[],"pop":7},{"slug":"fly-ash","title_ko":"비산재","title_en":"Fly Ash","meaning":"소각·연소 과정에서 배가스와 함께 배출되어 집진시설에서 포집되는 미세한 재로, 중금속과 다이옥신 농도가 높아 지정폐기물로…","subcategory":"환경공학·오염관리","level":2,"related":[],"prerequisites":[],"pop":5},{"slug":"scoping","title_ko":"스코핑(평가항목·범위 결정)","title_en":"Scoping","meaning":"환경영향평가를 실시하기 전에 평가 항목, 범위, 방법 등을 미리 결정하는 절차.","subcategory":"환경정책·환경영향평가","level":2,"related":[],"prerequisites":[],"pop":9,"aliases":["스코핑","스코핑(평가항목 범위 결정)","스코핑(평가항목·범위결정)","스코핑(평가항목범위 결정)","평가항목·범위 결정"]},{"slug":"environmental-subsidy","title_ko":"환경보조금","title_en":"Environmental Subsidy","meaning":"친환경 설비 도입이나 오염저감 활동을 촉진하기 위해 정부가 재정적으로 지원하는 정책수단.","subcategory":"환경정책·환경영향평가","level":2,"related":["feed-in-tariff"],"prerequisites":[]},{"slug":"feed-in-tariff","title_ko":"발전차액지원제도(FIT)","title_en":"Feed-in Tariff (FIT)","meaning":"신재생에너지로 생산한 전력의 시장가격이 기준가격보다 낮을 경우 그 차액을 정부가 지원하는 가격보장형 정책수단.","subcategory":"환경정책·환경영향평가","level":2,"related":["environmental-subsidy"],"prerequisites":[],"pop":10,"aliases":["발전차액지원제도"]},{"slug":"environmental-litigation","title_ko":"환경소송","title_en":"Environmental Litigation","meaning":"환경오염이나 환경정책 결정으로 인한 피해를 이유로 법원에 제기하는 민사·행정·형사 소송의 총칭.","subcategory":"환경정책·환경영향평가","level":1,"related":[],"prerequisites":[]},{"slug":"biophilia","title_ko":"바이오필리아","title_en":"Biophilia","meaning":"인간이 본능적으로 자연 및 다른 생명체와 정서적으로 연결되고자 하는 성향을 의미하며, 생물학자 에드워드 윌슨이 제안한 가설로…","subcategory":"기후변화적응·환경교육","level":3,"related":[],"prerequisites":[],"pop":2}]