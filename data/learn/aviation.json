[{"slug":"drag","title_ko":"항공기 항력","title_en":"drag","meaning":"비행 방향과 반대 방향으로 작용하여 항공기의 전진을 방해하는 공기역학적 저항력으로, 유도항력·형상항력·마찰항력·조파항력 등…","subcategory":"항공역학·항공기설계","level":1,"related":["induced-drag","profile-drag","skin-friction-drag"],"prerequisites":[]},{"slug":"induced-drag","title_ko":"유도항력","title_en":"induced drag","meaning":"양력을 발생시키는 과정에서 날개끝에서 형성되는 와류로 인해 필연적으로 발생하는 항력 성분으로, 양력계수의 제곱에 비례하고…","subcategory":"항공역학·항공기설계","level":1,"related":["drag"],"prerequisites":[],"pop":8},{"slug":"profile-drag","title_ko":"형상항력","title_en":"profile drag","meaning":"날개나 동체의 기하학적 형태로 인해 발생하는 항력으로, 표면 마찰에 의한 항력과 압력 분포 불균형으로 인한 압력항력의 합으로…","subcategory":"항공역학·항공기설계","level":3,"related":["drag","skin-friction-drag"],"prerequisites":["drag","skin-friction-drag"]},{"slug":"skin-friction-drag","title_ko":"마찰항력","title_en":"skin friction drag","meaning":"항공기 표면과 그 위를 흐르는 공기 사이의 점성 마찰로 인해 발생하는 항력으로, 표면의 경계층 상태와 표면 조도에 크게…","subcategory":"항공역학·항공기설계","level":2,"related":["drag","laminar-flow"],"prerequisites":["drag"]},{"slug":"chord-line","title_ko":"익현선","title_en":"chord line","meaning":"익형의 앞전(리딩 에지)과 뒷전(트레일링 에지)을 잇는 직선으로, 받음각과 캠버 등 익형의 기하학적 특성을 정의하는…","subcategory":"항공역학·항공기설계","level":3,"related":[],"prerequisites":[]},{"slug":"bernoulli-theorem","title_ko":"베르누이 정리(베르누이 원리)","title_en":"Bernoulli's theorem","meaning":"비압축성·비점성 유동에서 유선을 따라 유체의 속도가 증가하면 정압이 감소하고, 속도가 감소하면 정압이 증가하여 전체…","subcategory":"항공역학·항공기설계","level":3,"related":[],"prerequisites":[],"pop":12,"aliases":["베르누이정리","베르누이 원리","Bernoulli's Principle","베르누이 방정식","베르누이원리"]},{"slug":"laminar-flow","title_ko":"층류","title_en":"laminar flow","meaning":"유체 입자들이 서로 섞이지 않고 매끄러운 층을 이루며 질서정연하게 흐르는 유동 상태로, 마찰항력이 상대적으로 작지만 유동…","subcategory":"항공역학·항공기설계","level":2,"related":["skin-friction-drag"],"prerequisites":[]},{"slug":"critical-mach-number","title_ko":"임계마하수","title_en":"critical Mach number","meaning":"자유흐름 마하수를 서서히 높일 때, 날개 표면의 한 지점에서 국소 흐름 속도가 처음으로 마하 1에 도달하는 자유흐름 마하수를…","subcategory":"항공역학·항공기설계","level":1,"related":["mach-number"],"prerequisites":[],"aliases":["CMN"]},{"slug":"aileron","title_ko":"에일러론","title_en":"aileron","meaning":"양쪽 날개 뒷전 바깥쪽에 위치하여 서로 반대 방향으로 움직이며 좌우 날개의 양력 차이를 만들어 항공기를 롤(옆으로 기울임)…","subcategory":"항공역학·항공기설계","level":1,"related":[],"prerequisites":[],"aliases":["보조날개"]},{"slug":"elevator","title_ko":"엘리베이터","title_en":"elevator","meaning":"수평꼬리날개(수평안정판) 뒷전에 위치하여 위아래로 움직이며 기체의 피치(기수를 들거나 내리는) 방향 운동을 조종하는 1차…","subcategory":"항공역학·항공기설계","level":1,"related":[],"prerequisites":[],"pop":16,"aliases":["승강키","승강타"]},{"slug":"dutch-roll","title_ko":"더치롤","title_en":"Dutch roll","meaning":"롤(옆으로 기욺)과 요(좌우로 도는 것)가 서로 결합되어 나타나는 진동 모드로, 후퇴익 항공기에서 방향안정성이 가로안정성보다…","subcategory":"항공역학·항공기설계","level":1,"related":[],"prerequisites":[],"pop":10},{"slug":"flutter","title_ko":"플러터","title_en":"flutter","meaning":"공기역학적 힘, 탄성 복원력, 관성력이 서로 상호작용하며 특정 속도(플러터 속도) 이상에서 진폭이 시간에 따라 발산하는 자려…","subcategory":"항공역학·항공기설계","level":1,"related":[],"prerequisites":[],"pop":6},{"slug":"semi-monocoque-structure","title_ko":"세미모노코크구조","title_en":"semi-monocoque structure","meaning":"외피와 함께 스파, 리브, 스트링거 같은 내부 골격이 하중을 나누어 분담하는 구조 형식으로, 현대 여객기 동체와 날개에 가장…","subcategory":"항공역학·항공기설계","level":1,"related":[],"prerequisites":[],"pop":2},{"slug":"aircraft-range","title_ko":"항속거리","title_en":"aircraft range","meaning":"이륙 시 탑재한 연료를 모두 사용하여 비행할 수 있는 최대 수평 비행 거리로, 연료 탑재량, 양항비, 엔진 연료소비율…","subcategory":"항공역학·항공기설계","level":1,"related":["breguet-range-equation"],"prerequisites":[],"pop":7},{"slug":"breguet-range-equation","title_ko":"브레게항속거리방정식","title_en":"Breguet range equation","meaning":"순항 비행 시 항속거리를 속도, 양항비, 연료소비율, 초기 질량과 최종 질량의 비율의 함수로 나타낸 이론적 관계식으로…","subcategory":"항공역학·항공기설계","level":2,"related":["aircraft-range","tsiolkovsky-rocket-equation"],"prerequisites":["aircraft-range"],"pop":5,"aliases":["BRE"]},{"slug":"compressor-stall","title_ko":"압축기실속","title_en":"compressor stall","meaning":"압축기 블레이드가 받는 국소적인 받음각이 지나치게 커져 블레이드 표면의 유동이 박리되면서, 정상적인 압축 과정이 국소적으로…","subcategory":"항공역학·항공기설계","level":3,"related":["stall"],"prerequisites":[],"pop":15},{"slug":"honeycomb-structure","title_ko":"하니컴구조","title_en":"honeycomb structure","meaning":"얇은 재료를 육각형 벌집 모양의 셀로 성형한 구조로, 매우 가벼우면서도 압축과 전단 하중에 대해 높은 강성을 제공하여…","subcategory":"항공역학·항공기설계","level":3,"related":["buckling"],"prerequisites":[]},{"slug":"rotor-blade","title_ko":"로터블레이드","title_en":"rotor blade","meaning":"헬리콥터의 회전축을 중심으로 회전하며 익형 단면을 통해 양력(또는 추력)을 발생시키는 날개 부재로, 회전 중 자세를 바꾸는…","subcategory":"항공역학·항공기설계","level":1,"related":["translational-lift","flutter"],"prerequisites":[],"pop":11,"aliases":["회전날개"]},{"slug":"translational-lift","title_ko":"전이양력","title_en":"translational lift","meaning":"헬리콥터가 제자리비행 상태에서 전진 비행으로 전환할 때, 로터가 자신이 만든 유도 흐름을 벗어나 새로운 신선한 공기와…","subcategory":"항공역학·항공기설계","level":3,"related":["rotor-blade"],"prerequisites":[],"pop":20},{"slug":"instrument-approach-procedure","title_ko":"계기접근절차","title_en":"Instrument Approach Procedure","meaning":"계기비행 상태의 항공기가 활주로 또는 착륙 가능 지점까지 안전하게 접근하도록 설계된 일련의 비행절차.","subcategory":"항공운항·항공관제","level":1,"related":[],"prerequisites":[]},{"slug":"controlled-airspace","title_ko":"관제공역","title_en":"Controlled Airspace","meaning":"항공교통관제업무가 제공되는 것으로 지정된 일정 범위의 공역.","subcategory":"항공운항·항공관제","level":2,"related":[],"prerequisites":[]},{"slug":"aircraft-separation-standard","title_ko":"항공기분리기준","title_en":"Aircraft Separation Standard","meaning":"항공기 간 충돌을 방지하기 위해 관제기관이 유지해야 할 최소 수직·수평·시간 간격 기준.","subcategory":"항공운항·항공관제","level":1,"related":[],"prerequisites":[]},{"slug":"runway-incursion","title_ko":"활주로침범","title_en":"Runway Incursion","meaning":"항공기, 차량, 사람이 허가 없이 이착륙용으로 지정된 활주로 보호구역에 진입하는 사건.","subcategory":"항공운항·항공관제","level":1,"related":[],"prerequisites":[]},{"slug":"multi-crew-pilot-license","title_ko":"복수승무원조종사면장","title_en":"Multi-crew Pilot License (MPL)","meaning":"복수 조종사 운항을 전제로 처음부터 팀 기반 절차와 CRM을 통합하여 훈련하는 조종사 면장 제도.","subcategory":"항공운항·항공관제","level":3,"related":[],"prerequisites":[],"pop":13,"aliases":["MCPL"]},{"slug":"just-culture","title_ko":"공정문화