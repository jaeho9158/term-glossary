{
 "id": "fn-plot",
 "template": "functionPlot",
 "title": "좌표 평면과 함수(템플릿 예)",
 "params": {
  "x": [
   -4,
   4
  ],
  "y": [
   -1.5,
   2.5
  ],
  "fns": [
   {
    "expr": "sin(x)",
    "label": "y = sin x"
   },
   {
    "expr": "x^2/4",
    "label": "y = x^{2}/4",
    "color": "rose",
    "domain": [
     -3,
     3
    ]
   }
  ],
  "shade": [
   {
    "expr": "sin(x)",
    "from": 0,
    "to": 3.14159
   }
  ],
  "points": [
   {
    "at": [
     0,
     0
    ],
    "label": "O"
   }
  ]
 },
 "legend": [
  {
   "sym": "x",
   "desc": "가로축 변수"
  },
  {
   "sym": "sin",
   "desc": "사인 함수"
  },
  {
   "desc": "음영은 0 ≤ x ≤ π에서 sin x 아래 넓이(= 2)"
  }
 ]
}
