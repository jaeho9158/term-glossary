 "legend": [
  {
   "sym": "산 접힘",
   "desc": "종이를 바깥으로 튀어나오게 접는 선(mountain fold). 그림에서는 실선",
   "kind": "term"
  },
  {
   "sym": "골 접힘",
   "desc": "종이를 안쪽으로 들어가게 접는 선(valley fold). 그림에서는 점선",
   "kind": "term"
  },
  {
   "sym": "지그재그 경로",
   "desc": "위아래로 이어지며 좌우로 꺾이는 세로 접는 선. 한 경로는 산 접힘만 또는 골 접힘만으로 되어 있고, 옆 경로와 산·골이 번갈아 나온다(그림 아래의 산·골 글자)",
   "kind": "term"
  },
  {
   "sym": "곧은 선",
   "desc": "가로로 곧게 이어진 접는 선. 이웃한 평행사변형은 이 선을 기준으로 거울상이고, 지그재그 경로 쪽 이웃은 평행이동 관계이다",
   "kind": "term"
  },
  {
   "desc": "가로 접는 선의 산·골은 각 꼭짓점에서 접는 선 네 개 중 세 개가 같은 종류가 되도록 배치했다. 평행사변형의 각도와 칸 수는 모식이며, 접은 모양은 그리지 않았다."
  }
 ],
