[{"slug":"cultural-industry","title_ko":"문화산업","title_en":"Culture Industry","meaning":"대중문화가 표준화·규격화된 상품으로 생산되어 비판적 사유 대신 순응적 오락을 제공한다고 비판하는 프랑크푸르트학파의 개념.","subcategory":"미학이론·예술비평","level":1,"related":["negative-dialectics","aura-benjamin"],"prerequisites":[]},{"slug":"gatekeeping","title_ko":"게이트키핑(게이트키핑 이론)","title_en":"Gatekeeping","meaning":"수많은 정보 중 무엇을 뉴스로 선택하고 무엇을 배제할지 결정하는 언론의 편집 과정.","subcategory":"커뮤니케이션이론·저널리즘","level":1,"related":["case-management"],"prerequisites":[],"pop":3,"aliases":["게이트키핑 이론","Gatekeeping Theory","문지기 이론","게이트키핑이론"]},{"slug":"hypodermic-needle-theory","title_ko":"탄환이론","title_en":"Hypodermic Needle Theory","meaning":"매스미디어의 메시지가 수용자에게 강력하고 즉각적이며 획일적인 영향을 미친다고 보는 초기 미디어 효과 이론.","subcategory":"커뮤니케이션이론·저널리즘","level":1,"related":[],"prerequisites":[],"pop":9,"aliases":["HNT"]},{"slug":"slow-journalism","title_ko":"슬로우저널리즘","title_en":"Slow Journalism","meaning":"속보 경쟁에서 벗어나 충분한 시간을 들여 깊이 있게 취재하고 성찰적으로 보도하는 저널리즘 흐름.","subcategory":"커뮤니케이션이론·저널리즘","level":3,"related":[],"prerequisites":[],"pop":18},{"slug":"filter-bubble","title_ko":"필터버블","title_en":"Filter Bubble","meaning":"알고리즘 개인화로 인해 이용자가 자신의 기존 신념과 일치하는 정보에만 지속적으로 노출되는 현상.","subcategory":"커뮤니케이션이론·저널리즘","level":1,"related":["echo-chamber"],"prerequisites":[],"pop":5},{"slug":"echo-chamber","title_ko":"반향실효과","title_en":"Echo Chamber Effect","meaning":"비슷한 의견을 가진 사람들끼리만 소통하면서 특정 신념이 반복 확인되고 증폭되는 현상.","subcategory":"커뮤니케이션이론·저널리즘","level":2,"related":["filter-bubble"],"prerequisites":["filter-bubble"],"pop":4,"aliases":["메아리방효과","에코체임버"]},{"slug":"disinformation","title_ko":"허위정보","title_en":"Disinformation","meaning":"타인을 속이려는 의도를 갖고 고의로 제작·유포되는 거짓 정보.","subcategory":"커뮤니케이션이론·저널리즘","level":1,"related":["misinformation"],"prerequisites":[],"pop":13,"aliases":["디스인포메이션","역정보"]},{"slug":"misinformation","title_ko":"오정보","title_en":"Misinformation","meaning":"속이려는 의도 없이 사실과 다르게 전달되거나 오해로 인해 퍼지는 잘못된 정보.","subcategory":"커뮤니케이션이론·저널리즘","level":1,"related":["disinformation"],"prerequisites":[],"pop":19,"aliases":["미스인포메이션","잘못된정보"]},{"slug":"deliberative-democracy","title_ko":"숙의민주주의","title_en":"Deliberative Democracy","meaning":"시민들이 충분한 정보와 논거를 바탕으로 공개적 토론을 거쳐 정책 결정에 이르는 민주주의 모델.","subcategory":"커뮤니케이션이론·저널리즘","level":2,"related":[],"prerequisites":[],"pop":17,"aliases":["심의민주주의"]},{"slug":"critical-discourse-analysis","title_ko":"비판적담론분석","title_en":"Critical Discourse Analysis","meaning":"언어와 담론이 사회적 불평등과 지배 이데올로기를 어떻게 생산·재생산하는지 비판적으로 규명하는 분석 방법.","subcategory":"커뮤니케이션이론·저널리즘","level":3,"related":["discourse-analysis"],"prerequisites":[],"pop":10},{"slug":"advocacy-journalism","title_ko":"주창저널리즘","title_en":"Advocacy Journalism","meaning":"특정 사회적 대의나 입장을 명시적으로 지지하며 보도하는 저널리즘 유형.","subcategory":"커뮤니케이션이론·저널리즘","level":1,"related":[],"prerequisites":[],"pop":20},{"slug":"propaganda-model","title_ko":"프로파간다모델","title_en":"Propaganda Model","meaning":"소유구조, 광고 의존, 정보원 접근, 여론 공세, 반공 이데올로기 등 다섯 가지 필터가 뉴스를 지배 엘리트에게 유리하게…","subcategory":"커뮤니케이션이론·저널리즘","level":2,"related":[],"prerequisites":[],"aliases":["선전모델"]},{"slug":"meme-theory","title_ko":"밈이론","title_en":"Meme Theory","meaning":"리처드 도킨스가 제안한 '밈(meme)' 개념을 미디어 커뮤니케이션에 적용하여, 문화적 단위가 모방과 변형을 통해 사람들…","subcategory":"뉴미디어·미디어효과이론","level":2,"related":[],"prerequisites":[],"pop":15},{"slug":"spiral-of-silence-theory","title_ko":"침묵의나선이론","title_en":"Spiral of Silence Theory","meaning":"자신의 의견이 사회적 다수 의견과 다르다고 인식할 때, 고립에 대한 두려움으로 인해 의견 표명을 자제하게 되고 그 결과 소수…","subcategory":"뉴미디어·미디어효과이론","level":3,"related":["false-consensus-effect"],"prerequisites":[],"aliases":["침묵의나선","침묵의 나선 이론","Spiral of Silence","침묵의 나선 이론 (Spiral of Silence Theory)","침묵의나선이론(SpiralofSilenceTheory)"]},{"slug":"online-disinhibition-effect","title_ko":"온라인탈억제효과","title_en":"Online Disinhibition Effect","meaning":"온라인 환경의 익명성과 비대면성으로 인해 사람들이 오프라인에서보다 더 솔직하거나, 반대로 더 공격적이고 무례한 행동을 보이는…","subcategory":"뉴미디어·미디어효과이론","level":1,"related":["online-anonymity"],"prerequisites":[],"pop":1},{"slug":"post-truth","title_ko":"포스트트루스","title_en":"Post-Truth","meaning":"객관적 사실보다 개인의 감정이나 신념에 호소하는 것이 여론 형성에 더 큰 영향을 미치는 사회문화적 상황을 지칭하는 개념이다.","subcategory":"뉴미디어·미디어효과이론","level":2,"related":["confirmation-bias"],"prerequisites":[],"pop":7,"aliases":["탈진실"]},{"slug":"on-demand-media","title_ko":"온디맨드미디어","title_en":"On-Demand Media","meaning":"정해진 편성표에 따라 콘텐츠를 제공하는 전통적 방송과 달리, 이용자가 원하는 시간과 장소에서 콘텐츠를 선택하여 소비할 수…","subcategory":"뉴미디어·미디어효과이론","level":1,"related":["cord-cutting"],"prerequisites":[],"aliases":["VOD","주문형미디어"]},{"slug":"cord-cutting","title_ko":"코드커팅","title_en":"Cord-Cutting","meaning":"기존의 유료 케이블·위성 방송 가입을 해지하고 인터넷 기반 스트리밍 서비스로 미디어 소비를 전환하는 이용자 행태 변화를…","subcategory":"뉴미디어·미디어효과이론","level":2,"related":["on-demand-media"],"prerequisites":["on-demand-media"]},{"slug":"online-anonymity","title_ko":"온라인익명성","title_en":"Online Anonymity","meaning":"온라인 공간에서 이용자의 실제 신원이 드러나지 않거나 식별되지 않는 상태를 의미하며, 표현의 자유 확대와 부정적 행동…","subcategory":"뉴미디어·미디어효과이론","level":1,"related":["online-disinhibition-effect"],"prerequisites":[]},{"slug":"privacy-calculus-theory","title_ko":"프라이버시계산이론","title_en":"Privacy Calculus Theory","meaning":"이용자가 개인정보 공개로 인해 얻을 수 있는 편익과 발생 가능한 위험을 비교하여 정보 공개 여부를 합리적으로 결정한다는…","subcategory":"뉴미디어·미디어효과이론","level":2,"related":[],"prerequisites":[],"pop":16},{"slug":"ritual-model-of-communication","title_ko":"의례적커뮤니케이션모델","title_en":"Ritual Model of Communication","meaning":"커뮤니케이션을 단순한 정보 전달이 아니라, 공유된 신념과 문화를 시간에 걸쳐 재현하고 유지하며 공동체를 결속시키는 의례적…","subcategory":"뉴미디어·미디어효과이론","level":2,"related":[],"prerequisites":[],"pop":12},{"slug":"audience-commodity-theory","title_ko":"수용자상품론","title_en":"Audience Commodity Theory","meaning":"상업 미디어 산업에서 수용자의 관심과 시청 시간 자체가 광고주에게 판매되는 상품으로 기능한다고 보는 정치경제학적 미디어…","subcategory":"뉴미디어·미디어효과이론","level":3,"related":[],"prerequisites":[],"pop":8},{"slug":"emotional-appeal","title_ko":"감성적소구","title_en":"Emotional Appeal","meaning":"논리적 정보보다 즐거움, 향수, 유대감 등 감정적 반응을 유발하여 소비자의 태도와 구매 행동에 영향을 미치려는 광고 소구…","subcategory":"광고학·PR실무 심화","level":1,"related":[],"prerequisites":[],"pop":14},{"slug":"gross-rating-points","title_ko":"총시청률(GRP)","title_en":"Gross Rating Points","meaning":"도달률과 빈도를 곱하여 산출한 값으로, 특정 매체 스케줄이 만들어낸 총 노출량을 나타내는 지표이다.","subcategory":"광고학·PR실무 심화","level":1,"related":[],"prerequisites":[],"aliases":["GRP","총시청률"]},{"slug":"effective-frequency","title_ko":"유효빈도","title_en":"Effective Frequency","meaning":"광고가 소비자의 태도나 행동에 실질적인 영향을 미치기 위해 필요한 최소한의 노출 횟수 범위를 의미한다.","subcategory":"광고학·PR실무 심화","level":2,"related":[],"prerequisites":[]},{"slug":"sponsorship-marketing","title_ko":"스폰서십마케팅","title_en":"Sponsorship Marketing","meaning":"스포츠, 문화, 사회 행사 등을 재정적·물적으로 지원하는 대가로 브랜드 노출과 이미지 연상 효과를 얻는 마케팅 커뮤니케이션…","subcategory":"광고학·PR실무 심화","level":2,"related":["cause-related-marketing"],"prerequisites":[]},{"slug":"cause-related-marketing","title_ko":"코즈마케팅","title_en":"Cause-Related Marketing","meaning":"기업이 특정 사회적 대의(cause)와 자사 제품 판매를 연계하여 소비자의 구매가 곧 기부나 사회공헌으로 이어지도록 설계한…","subcategory":"광고학·PR실무 심화","level":2,"related":[],"prerequisites":[],"aliases":["공익연계마케팅"]},{"slug":"big-idea","title_ko":"빅아이디어","title_en":"Big Idea","meaning":"광고 캠페인 전체를 관통하는 독창적이고 강력한 핵심 콘셉트로, 소비자의 주의를 끌고 브랜드 메시지를 효과적으로 전달하는…","subcategory":"광고학·PR실무 심화","level":1,"related":[],"prerequisites":[],"pop":11},{"slug":"unique-selling-proposition","title_ko":"고유판매제안(USP)","title_en":"Unique Selling Proposition","meaning":"경쟁 제품이 제공하지 못하는 자사 제품만의 독특한 편익이나 특징을 명확히 제시하여 소비자를 설득하는 광고 개념이다.","subcategory":"광고학·PR실무 심화","level":1,"related":[],"prerequisites":[],"pop":6,"aliases":["고유판매제안"]},{"slug":"race-model-pr","title_ko":"RACE모델","title_en":"RACE Model","meaning":"PR 캠페인을 조사(Research)-기획(Action/Planning)-실행(Communication)-평가(Evaluat…","subcategory":"광고학·PR실무 심화","level":3,"related":[],"prerequisites":[]},{"slug":"fcb-grid-model","title_ko":"FCB그리드모델","title_en":"FCB Grid Model","meaning":"관여도(고/저)와 사고-감정 축을 조합하여 제품군에 따라 적합한 광고 전략 유형을 네 가지로 분류하는 광고 전략 모델이다.","subcategory":"광고학·PR실무 심화","level":3,"related":["emotional-appeal"],"prerequisites":["emotional-appeal"]},{"slug":"brand-architecture","title_ko":"브랜드아키텍처","title_en":"Brand Architecture","meaning":"기업이 보유한 여러 브랜드와 하위 제품 라인 간의 관계와 구조를 체계적으로 설계하여 관리하는 전략적 틀을 의미한다.","subcategory":"광고학·PR실무 심화","level":3,"related":[],"prerequisites":[],"pop":2}]