[{"slug":"play-theory-huizinga","title_ko":"놀이이론(호이징가)","title_en":"Play Theory (Huizinga)","meaning":"요한 호이징가가 제시한 놀이 이론으로, 놀이를 문화 이전에 존재하는 자유롭고 자발적인 활동이며 일상과 분리된 시공간에서…","subcategory":"게임학이론·게임디자인","level":3,"related":[],"prerequisites":[],"pop":7,"aliases":["Huizinga","놀이이론","호이징가"]},{"slug":"level-design","title_ko":"레벨 디자인","title_en":"Level Design","meaning":"게임의 공간, 도전 배치, 진행 흐름을 설계하여 플레이어 경험을 구조화하는 작업이다. 공간 구성뿐 아니라 난이도 곡선, 서사…","subcategory":"게임학이론·게임디자인","level":1,"related":[],"prerequisites":[],"aliases":["레벨디자인"]},{"slug":"mda-framework","title_ko":"MDA 프레임워크","title_en":"MDA Framework","meaning":"게임을 메커닉스(Mechanics), 다이나믹스(Dynamics), 미학(Aesthetics)의 세 층위로 분석하는 게임…","subcategory":"게임학이론·게임디자인","level":3,"related":[],"prerequisites":[],"pop":1,"aliases":["MDA프레임워크"]},{"slug":"progression-system","title_ko":"진행 시스템(프로그레션)","title_en":"Progression System","meaning":"플레이어의 능력, 자원, 콘텐츠 접근권이 시간에 따라 점진적으로 확장되도록 설계된 시스템이다. 성취감과 장기적 동기 부여를…","subcategory":"게임학이론·게임디자인","level":1,"related":[],"prerequisites":[],"aliases":["진행 시스템","진행시스템","진행시스템(프로그레션)","프로그레션"]},{"slug":"skinner-box","title_ko":"스키너 상자","title_en":"Skinner Box","meaning":"동물이 특정 행동을 하면 보상이나 처벌이 주어지도록 설계된 실험 장치로, 조작적 조건형성 연구에 사용되었다. 게임 연구에서는…","subcategory":"게임학이론·게임디자인","level":3,"related":["positive-feedback-loop-game"],"prerequisites":["positive-feedback-loop-game"],"pop":11,"aliases":["스키너상자"]},{"slug":"linear-vs-nonlinear-design","title_ko":"선형·비선형 디자인","title_en":"Linear vs. Nonlinear Design","meaning":"게임 진행 경로를 단일한 순서로 고정할지(선형), 플레이어가 순서를 선택할 수 있게 할지(비선형)를 결정하는 구조적 설계…","subcategory":"게임학이론·게임디자인","level":3,"related":[],"prerequisites":[],"pop":10,"aliases":["LVND","선형 비선형 디자인","선형·비선형디자인","선형비선형 디자인"]},{"slug":"positive-feedback-loop-game","title_ko":"정적 피드백 루프(게임)","title_en":"Positive Feedback Loop in Games","meaning":"한 플레이어의 우위가 더 큰 우위를 낳는 자기강화적 순환 구조를 말한다. 승자가 계속 유리해지는 '눈덩이 효과'를 유발하여…","subcategory":"게임학이론·게임디자인","level":1,"related":["negative-feedback-loop-game"],"prerequisites":[],"pop":5,"aliases":["PFLG","정적 피드백 루프","정적피드백루프","정적피드백루프(게임)"]},{"slug":"negative-feedback-loop-game","title_ko":"부적 피드백 루프(게임)","title_en":"Negative Feedback Loop in Games","meaning":"열세에 있는 플레이어에게 상대적으로 더 큰 이득을 제공하여 격차를 줄이는 자기교정적 순환 구조를 말한다. 마리오카트의 아이템…","subcategory":"게임학이론·게임디자인","level":1,"related":["positive-feedback-loop-game"],"prerequisites":[],"pop":9,"aliases":["NFLG","부적 피드백 루프","부적피드백루프","부적피드백루프(게임)"]},{"slug":"cross-media-storytelling","title_ko":"크로스미디어스토리텔링","title_en":"Cross-media Storytelling","meaning":"동일하거나 유사한 서사 콘텐츠를 여러 매체에 걸쳐 반복적으로 제공하되, 매체 간 이야기의 확장보다는 동일 서사의 전달 경로…","subcategory":"문화콘텐츠산업·스토리텔링","level":3,"related":[],"prerequisites":[],"aliases":["교차매체스토리텔링","크로스미디어"]},{"slug":"reboot","title_ko":"리부트","title_en":"Reboot","meaning":"기존 프랜차이즈의 설정과 서사 연속성을 초기화하고 새로운 해석으로 처음부터 다시 시작하는 재제작 방식.","subcategory":"문화콘텐츠산업·스토리텔링","level":1,"related":["prequel"],"prerequisites":[],"aliases":["리부트작품","리부팅"]},{"slug":"prequel","title_ko":"프리퀄","title_en":"Prequel","meaning":"원작 서사보다 시간상 앞선 시점의 사건을 다루어 기존 세계관의 배경과 인물의 과거를 보완하는 콘텐츠 유형.","subcategory":"문화콘텐츠산업·스토리텔링","level":2,"related":["reboot"],"prerequisites":["reboot"],"aliases":["프리퀄작품"]},{"slug":"adaptation","title_ko":"각색","title_en":"Adaptation","meaning":"소설, 웹툰 등 원작 매체의 서사를 영화·드라마·게임 등 다른 매체의 표현 문법에 맞게 변환하여 재창작하는 작업.","subcategory":"문화콘텐츠산업·스토리텔링","level":1,"related":[],"prerequisites":[],"aliases":["어댑테이션","원작각색"]},{"slug":"hallyu","title_ko":"한류","title_en":"Hallyu (Korean Wave)","meaning":"1990년대 후반 이후 드라마, K-팝, 영화 등 한국 대중문화 콘텐츠가 아시아를 시작으로 전 세계로 확산된 문화적·산업적…","subcategory":"문화콘텐츠산업·스토리텔링","level":1,"related":["cultural-hybridity","soft-power"],"prerequisites":[],"aliases":["코리안웨이브","한류열풍"]},{"slug":"cultural-hybridity","title_ko":"문화적혼종성","title_en":"Cultural Hybridity","meaning":"서로 다른 문화적 요소가 혼합되어 기존의 어느 한쪽으로도 환원되지 않는 새로운 문화 형태를 형성하는 현상.","subcategory":"문화콘텐츠산업·스토리텔링","level":2,"related":["hallyu","soft-power"],"prerequisites":["hallyu"],"pop":4,"aliases":["문화혼종"]},{"slug":"hero-narrative-structure","title_ko":"영웅서사구조","title_en":"Hero Narrative Structure","meaning":"주인공이 일상을 떠나 시련을 겪고 성장하여 귀환하는 보편적 서사 패턴으로, 신화와 대중서사 창작에 폭넓게 응용되는 구조.","subcategory":"문화콘텐츠산업·스토리텔링","level":2,"related":["character-arc"],"prerequisites":[],"pop":13,"aliases":["영웅서사","영웅의여정"]},{"slug":"character-arc","title_ko":"캐릭터아크","title_en":"Character Arc","meaning":"서사가 진행되는 동안 인물의 가치관, 신념, 행동 양식이 변화해가는 궤적을 지칭하는 극작 이론 개념.","subcategory":"문화콘텐츠산업·스토리텔링","level":2,"related":["hero-narrative-structure"],"prerequisites":[],"pop":14,"aliases":["인물성장선","캐릭터변화곡선"]},{"slug":"multi-perspective-narrative","title_ko":"다중시점서사","title_en":"Multi-perspective Narrative","meaning":"동일한 사건이나 세계를 서로 다른 인물의 시점에서 반복적으로 조명하여 다층적 진실과 해석을 제공하는 서사 기법.","subcategory":"문화콘텐츠산업·스토리텔링","level":3,"related":[],"prerequisites":[],"aliases":["MPN"]},{"slug":"merchandising","title_ko":"머천다이징","title_en":"Merchandising","meaning":"콘텐츠의 캐릭터나 브랜드를 활용한 상품(피규어, 의류, 문구류 등)을 기획·제조·판매하는 사업 활동.","subcategory":"문화콘텐츠산업·스토리텔링","level":1,"related":[],"prerequisites":[],"pop":8,"aliases":["MD","굿즈사업"]},{"slug":"pitch-deck","title_ko":"피치덱","title_en":"Pitch Deck","meaning":"콘텐츠 기획의 핵심 아이디어, 캐릭터, 시장성을 투자자나 제작사에 설득력 있게 전달하기 위해 제작하는 발표용 요약 자료.","subcategory":"문화콘텐츠산업·스토리텔링","level":1,"related":["treatment"],"prerequisites":[],"pop":6,"aliases":["사업제안서","피칭덱"]},{"slug":"treatment","title_ko":"트리트먼트","title_en":"Treatment","meaning":"시나리오 집필에 앞서 줄거리, 주요 인물, 장면 흐름을 산문 형식으로 정리한 중간 단계의 개발 문서.","subcategory":"문화콘텐츠산업·스토리텔링","level":1,"related":["pitch-deck"],"prerequisites":[],"pop":2,"aliases":["시놉시스확장본","트리트먼트고"]},{"slug":"fandom-marketing","title_ko":"팬베이스마케팅","title_en":"Fanbase Marketing","meaning":"충성도 높은 팬 집단을 핵심 타깃으로 삼아 이들의 자발적 홍보와 구전 효과를 활용하는 마케팅 전략.","subcategory":"문화콘텐츠산업·스토리텔링","level":1,"related":[],"prerequisites":[],"pop":3,"aliases":["팬덤마케팅","팬마케팅"]},{"slug":"cinematic-universe","title_ko":"시네마틱유니버스","title_en":"Cinematic Universe","meaning":"영화 매체를 중심으로 여러 독립 작품이 동일한 세계관과 연속성을 공유하며 연결되는 프랜차이즈 구조.","subcategory":"문화콘텐츠