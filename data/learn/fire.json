[{"slug":"ignition-point","title_ko":"발화점","title_en":"Ignition Point","meaning":"외부에서 점화원을 가하지 않아도 가연물이 스스로 불이 붙어 연소를 지속할 수 있는 최저 온도를 말합니다.","subcategory":"연소공학","level":2,"related":["spontaneous-combustion","minimum-ignition-energy"],"prerequisites":[],"aliases":["발화온도","착화점"]},{"slug":"spontaneous-combustion","title_ko":"자연발화","title_en":"Spontaneous Combustion","meaning":"외부의 불꽃이나 스파크 같은 점화원 없이 물질 내부에서 스스로 열이 축적되어 발화에 이르는 현상을 말합니다.","subcategory":"연소공학","level":2,"related":["ignition-point","smoldering-combustion"],"prerequisites":[],"aliases":["자기발열발화","자연발화현상"]},{"slug":"incomplete-combustion","title_ko":"불완전연소","title_en":"Incomplete Combustion","meaning":"산소가 부족하거나 연소 조건이 불충분하여 가연물이 완전히 산화되지 못하고 일산화탄소, 그을음 등이 함께 생성되는 연소를…","subcategory":"연소공학","level":2,"related":["smoldering-combustion"],"prerequisites":[],"pop":17},{"slug":"minimum-ignition-energy","title_ko":"최소착화에너지","title_en":"Minimum Ignition Energy","meaning":"가연성 혼합기를 점화시키는 데 필요한 최소한의 에너지를 말합니다.","subcategory":"연소공학","level":2,"related":["ignition-point","explosion-limit-lel-uel"],"prerequisites":[],"aliases":["MIE","최소점화에너지"]},{"slug":"flashover","title_ko":"플래시오버","title_en":"Flashover","meaning":"실내 화재가 성장하는 과정에서 공간 내 모든 가연물이 거의 동시에 발화하며 화재가 실 전체로 급격히 확산되는 현상을 말합니다.","subcategory":"화재역학","level":2,"related":[],"prerequisites":[],"aliases":["플래쉬오버","플래시오버 현상","Flashover Phenomenon","플래시오버현상"]},{"slug":"smoldering-combustion","title_ko":"훈소","title_en":"Smoldering Combustion","meaning":"불꽃 없이 물질 표면이나 내부에서 서서히 산화 반응이 일어나며 연기와 열을 내는 저온·저속의 연소 형태를 말합니다.","subcategory":"연소공학","level":2,"related":["spontaneous-combustion","incomplete-combustion"],"prerequisites":[],"pop":2,"aliases":["무염연소","훈소연소"]},{"slug":"fuel-controlled-fire","title_ko":"연료지배형화재","title_en":"Fuel-Controlled Fire","meaning":"공기(산소)는 충분히 공급되고 연소 속도가 가연물의 양과 노출 표면적에 의해 결정되는 화재 상태를 말합니다.","subcategory":"화재역학","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["연료지배화재"]},{"slug":"smoke-control-system","title_ko":"제연설비","title_en":"Smoke Control System","meaning":"화재 시 발생하는 연기를 제어, 배출, 차단하여 피난 통로와 실내 공간의 안전을 확보하는 소방설비입니다.","subcategory":"소방시설·설비","level":2,"related":[],"prerequisites":[],"aliases":["배연설비","제연시스템"]},{"slug":"available-safe-egress-time","title_ko":"허용피난시간","title_en":"Available Safe Egress Time","meaning":"화재 발생 시점부터 실내 환경이 인명에 위험한 상태(연기, 열, 유독가스 등)에 이르기까지 재실자가 안전하게 대피할 수 있는…","subcategory":"피난·인명안전","level":2,"related":[],"prerequisites":[],"aliases":["ASET"]},{"slug":"flame-retardant-treatment","title_ko":"방염처리","title_en":"Flame Retardant Treatment","meaning":"커튼, 카펫, 벽지 등 가연성 물품이나 재료에 불이 쉽게 붙지 않고, 붙더라도 잘 번지지 않도록 처리하는 것을 말합니다.","subcategory":"방화·내화공학","level":2,"related":[],"prerequisites":[],"pop":16,"aliases":["난연처리","방염"]},{"slug":"oxidizing-substance","title_ko":"산화성물질","title_en":"Oxidizing Substance","meaning":"자신은 잘 타지 않지만 다른 가연물의 연소를 강하게 촉진하거나 폭발을 일으킬 수 있는 산소 공급원 역할을 하는 물질을…","subcategory":"위험물안전관리","level":2,"related":[],"prerequisites":[],"pop":18},{"slug":"inhibition-extinguishment","title_ko":"억제소화(부촉매소화)","title_en":"Inhibition Extinguishment","meaning":"연소의 연쇄 화학반응에 개입해 반응 경로를 방해함으로써 불꽃 연소를 억제하는 소화 방법입니다.","subcategory":"소화이론·소화약제","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["부촉매소화","억제소화","부촉매(화학적 억제) 소화작용","Chemical Inhibition","부촉매 소화작용","부촉매(화학적억제)소화작용","부촉매소화작용","화학적 억제"]},{"slug":"aqueous-film-forming-foam","title_ko":"수성막포 소화약제","title_en":"Aqueous Film-Forming Foam","meaning":"유류 표면에 얇은 수막을 형성해 증기 발생을 억제하고 재발화를 막는 포 소화약제입니다.","subcategory":"소화이론·소화약제","level":2,"related":[],"prerequisites":[],"pop":20,"aliases":["Aqueous Film-Forming Foam","AFFF","수성막포소화약제"]},{"slug":"ceiling-jet-flow","title_ko":"천장기류","title_en":"Ceiling Jet Flow","meaning":"화재플룸이 천장에 부딪힌 뒤 천장면을 따라 옆으로 빠르게 퍼져 나가는 뜨거운 연기와 가스의 흐름을 말합니다.","subcategory":"화재역학","level":2,"related":["fire-plume-entrainment","flashover"],"prerequisites":[],"aliases":["Ceiling Jet Flow","CJF"]},{"slug":"explosion-limit-lel-uel","title_ko":"폭발한계(연소범위)","title_en":"Explosive Limit (LEL/UEL)","meaning":"가연성 가스나 증기가 공기와 섞여 점화원이 있을 때 연소가 시작될 수 있는 농도의 하한(LEL)과 상한(UEL)을 의미하며…","subcategory":"폭발공학","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["폭발한계(연소범위) (Explosive Limit","LEL/UEL)","폭발한계 (Explosive Limit","폭발한계(ExplosiveLimit","폭발한계(연소범위)(ExplosiveLimit","연소범위","Flammability Range","연소한계","폭발범위","폭발하한계","Lower Explosive Limit","LEL","폭발하한","폭발상한계","Upper Explosive Limit","UEL"]},{"slug":"fire-plume-entrainment","title_ko":"화재플룸 공기연행","title_en":"Fire Plume Entrainment","meaning":"화재로 인해 위로 솟아오르는 뜨거운 연기 기둥(화재플룸)이 상승하면서 주변의 차가운 공기를 끌어들여 함께 섞이는 현상을…","subcategory":"화재역학","level":2,"related":["ceiling-jet-flow","flashover","turbulent-flame-propagation"],"prerequisites":[],"pop":6,"aliases":["Fire Plume Entrainment","화재플룸공기연행"]},{"slug":"fire-pump-jockey-pump","title_ko":"충압펌프","title_en":"Jockey Pump","meaning":"소방배관 내 미세한 압력 손실을 보충하여 주펌프가 불필요하게 자주 기동되지 않도록 하는 소용량 보조펌프입니다.","subcategory":"소방시설·설비","level":2,"related":["fire-pump-performance-curve","pressure-relief-valve-sprinkler"],"prerequisites":[],"pop":1,"aliases":["Jockey Pump"]},{"slug":"fire-pump-performance-curve","title_ko":"소방펌프 성능곡선","title_en":"Fire Pump Performance Curve","meaning":"소방펌프의 토출유량 변화에 따른 토출압력(양정)의 관계를 나타낸 그래프로, 펌프 성능을 평가하는 기준 자료입니다.","subcategory":"소방시설·설비","level":2,"related":["fire-pump-jockey-pump","wet-pipe-sprinkler-system"],"prerequisites":[],"pop":19,"aliases":["Fire Pump Performance Curve","FPPC","소방펌프성능곡선"]},{"slug":"fire-resistant-cable","title_ko":"내화배선","title_en":"Fire-Resistant Cable","meaning":"화재 시 일정 시간 동안 고온에 노출되어도 전기 회로의 기능을 유지할 수 있도록 내열·내화 성능을 갖춘 배선입니다.","subcategory":"소방전기·경보설비","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["Fire-Resistant Cable"]},{"slug":"foam-expansion-ratio","title_ko":"포팽창비","title_en":"Foam Expansion Ratio","meaning":"소화용 포 원액과 물이 혼합된 포수용액이 공기와 섞여 거품(포)으로 부풀었을 때, 최종 거품 부피가 원래 수용액 부피의 몇…","subcategory":"소화이론·소화약제","level":2,"related":[],"prerequisites":[],"pop":13,"aliases":["Foam Expansion Ratio","FER"]},{"slug":"fully-developed-fire-stage","title_ko":"최성기 화재단계","title_en":"Fully Developed Fire Stage","meaning":"최성기 화재단계는 구획 내 가연물이 최대 연소율로 타오르며 열방출률과 온도가 정점에 도달하는 화재 진행 단계를 말합니다.","subcategory":"화재역학","level":2,"related":[],"prerequisites":[],"pop":12,"aliases":["Fully Developed Fire Stage","FDFS","최성기화재단계"]},{"slug":"ionization-smoke-detector","title_ko":"이온화식 연기감지기","title_en":"Ionization Smoke Detector","meaning":"미량의 방사성 물질로 공기를 이온화시켜 흐르는 전류가 연기 입자 유입으로 변화하는 것을 감지하는 연기감지기입니다.","subcategory":"소방전기·경보설비","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["Ionization Smoke Detector","이온화식연기감지기"]},{"slug":"laminar-burning-velocity","title_ko":"층류연소속도","title_en":"Laminar Burning Velocity","meaning":"소용돌이가 없는 안정된(층류) 흐름 조건에서, 예혼합 화염면이 아직 타지 않은 혼합 기체를 향해 수직으로 파고드는 속도를…","subcategory":"연소공학","level":2,"related":[],"prerequisites":[],"aliases":["Laminar Burning Velocity","LBV"]},{"slug":"nfpa-921-methodology","title_ko":"NFPA 921 화재조사방법론","title_en":"NFPA 921 Methodology","meaning":"미국 방화협회(NFPA)가 발간한 화재·폭발 조사 지침서(NFPA 921)에서 제시하는, 과학적 방법론에 기반해 가설을…","subcategory":"화재조사","level":2,"related":[],"prerequisites":[],"aliases":["NFPA 921 Methodology","NFPA921화재조사방법론"]},{"slug":"pressure-relief-valve-sprinkler","title_ko":"압력조정밸브","title_en":"Pressure Relief Valve","meaning":"소방배관 내 압력이 설정값을 초과하지 않도록 자동으로 조절하여 배관과 설비를 보호하는 밸브입니다.","subcategory":"소방시설·설비","level":2,"related":["wet-pipe-sprinkler-system","fire-pump-performance-curve","fire-pump-jockey-pump"],"prerequisites":[],"aliases":["Pressure Relief Valve"]},{"slug":"radiative-heat-flux","title_ko":"복사열유속","title_en":"Radiative Heat Flux","meaning":"화염이나 고온 물체가 전자기파 형태로 단위 면적당 방출하는 열에너지의 양으로, 접촉 없이도 주변으로 열을 전달하는 복사열의…","subcategory":"열전달·화재확산","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["Radiative Heat Flux"]},{"slug":"turbulent-flame-propagation","title_ko":"난류화염전파","title_en":"Turbulent Flame Propagation","meaning":"유체의 난류 유동 속에서 화염면이 층류 상태보다 빠르고 불규칙한 속도로 미연소 혼합기 쪽으로 전파되는 현상을 말합니다.","subcategory":"연소공학","level":2,"related":["fire-plume-entrainment","flashover"],"prerequisites":[],"pop":15,"aliases":["Turbulent Flame Propagation"]},{"slug":"wet-pipe-sprinkler-system","title_ko":"습식 스프링클러설비","title_en":"Wet Pipe Sprinkler System","meaning":"배관 내부에 항상 물이 채워져 있어 화재 시 헤드가 개방되면 즉시 방수되는 스프링클러설비 방식입니다.","subcategory":"소방시설·설비","level":2,"related":["fire-pump-performance-curve","pressure-relief-valve-sprinkler"],"prerequisites":[],"pop":9,"aliases":["Wet Pipe Sprinkler System","WPSS","습식스프링클러설비"]},{"slug":"self-closing-fire-door","title_ko":"자동폐쇄식 방화문","title_en":"Self-Closing Fire Door","meaning":"평상시 개방되어 있다가 화재 감지 시 자동으로 닫히거나, 도어체크 등에 의해 사용 후 자동으로 닫히는 방화문입니다.","subcategory":"방화·내화공학","level":1,"related":[],"prerequisites":[],"pop":11,"aliases":["SCFD","자동폐쇄식방화문"]},{"slug":"means-of-egress-width","title_ko":"피난로 유효폭","title_en":"Means of Egress Width","meaning":"재실자가 화재 시 안전하게 대피할 수 있도록 복도, 계단, 출입구 등 피난경로에서 실제로 사람이 통과할 수 있는 순 폭을…","subcategory":"피난·인명안전","level":1,"related":[],"prerequisites":[],"aliases":["피난로유효폭"]},{"slug":"confined-space-flammable-atmosphere","title_ko":"밀폐공간 폭발성분위기","title_en":"Confined Space Flammable Atmosphere","meaning":"탱크, 맨홀, 저장조 등 환기가 제한된 밀폐공간 내부에 가연성 가스나 증기가 폭발범위 농도로 축적된 상태를 의미합니다.","subcategory":"위험물안전관리","level":1,"related":["explosion-limit-lel-uel"],"prerequisites":[],"aliases":["CSFA","밀폐공간폭발성분위기"]},{"slug":"view-factor-radiation-fire","title_ko":"복사 형태계수","title_en":"Radiation View Factor","meaning":"복사열을 방출하는 면(화염 또는 고온 표면)에서 나온 에너지 중 특정 수열면에 직접 도달하는 비율을 나타내는 0과 1 사이의…","subcategory":"열전달·화재확산","level":1,"related":["radiative-heat-flux","flame-height-correlation"],"prerequisites":[]},{"slug":"flame-height-correlation","title_ko":"화염높이 상관식","title_en":"Flame Height Correlation","meaning":"화원의 열방출률과 직경으로부터 평균 화염높이를 추정하는 실험 기반 경험식으로, Heskestad 상관식이 대표적이며 화재플룸…","subcategory":"화재역학","level":1,"related":["view-factor-radiation-fire"],"prerequisites":[],"pop":14}]