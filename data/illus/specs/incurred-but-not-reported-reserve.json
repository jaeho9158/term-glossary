  {
   "sym": "진전 k",
   "desc": "사고가 난 해부터 k번째 해까지 쌓인 누적 보고 손해액(단위 임의)",
   "kind": "term"
  },
  {
   "sym": "?",
   "desc": "아직 관측되지 않아 추정해야 하는 칸",
   "kind": "term"
  },
  {
   "sym": "f_{k}",
   "desc": "진전 k에서 k+1로 넘어갈 때 곱하는 진전계수(가중평균)",
   "kind": "var"
  },
  {
   "sym": "궁극손해액",
   "desc": "모든 사고가 종결되었을 때의 총 손해액 추정. 색칠한 칸(현재 보고액)에 남은 진전계수를 곱한다. 꼬리 계수는 1로 가정",
   "kind": "term"
  },
  {
   "sym": "IBNR",
   "desc": "미보고발생손해액(Incurred But Not Reported). 여기서는 넓은 뜻으로 궁극손해액에서 현재 보고액을 뺀 값",
   "kind": "abbr"
  },
  {
   "desc": "가상의 4개 사고연도 자료이다. 사고연도 4의 IBNR이 113.4로 가장 크다."
  }
 ],
