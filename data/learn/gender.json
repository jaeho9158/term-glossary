[{"slug":"masculinity-studies","title_ko":"남성성 연구","title_en":"Masculinity Studies","meaning":"남성성을 고정된 본질이 아니라 사회적·역사적으로 구성되고 다양하게 존재하는 젠더 실천으로 분석하는 학제적 연구 분야로, 젠더…","subcategory":"페미니즘이론","level":1,"related":[],"prerequisites":[],"aliases":["남성성연구"]},{"slug":"difference-feminism","title_ko":"차이 페미니즘","title_en":"Difference Feminism","meaning":"여성과 남성의 차이를 인정하고 그 차이에 근거한 여성 고유의 경험과 가치를 법·정책·사회 제도에 반영해야 한다고 주장하는…","subcategory":"페미니즘이론","level":1,"related":[],"prerequisites":[],"aliases":["차이페미니즘"]},{"slug":"third-wave-feminism","title_ko":"제3물결 페미니즘","title_en":"Third-Wave Feminism","meaning":"1990년대에 등장한 페미니즘 흐름으로, 제2물결의 단일한 여성 범주 전제를 비판하며 다양성, 개인적 정체성, 대중문화를…","subcategory":"페미니즘이론","level":2,"related":["intersectionality"],"prerequisites":[],"pop":6,"aliases":["제3물결페미니즘"]},{"slug":"transnational-feminism","title_ko":"초국적 페미니즘","title_en":"Transnational Feminism","meaning":"국민국가의 경계를 넘어 전 지구적 자본주의, 이주, 노동 분업이 여성의 삶에 미치는 영향을 분석하며, 국가 단위를 넘어선…","subcategory":"페미니즘이론","level":1,"related":[],"prerequisites":[],"aliases":["초국적페미니즘"]},{"slug":"compulsory-heterosexuality","title_ko":"강제적 이성애","title_en":"Compulsory Heterosexuality","meaning":"이성애가 자연스럽고 선택적인 성적지향이 아니라, 가부장적 제도와 이데올로기를 통해 여성에게 강제되고 정상화된 정치적 제도라는…","subcategory":"페미니즘이론","level":1,"related":[],"prerequisites":[],"pop":3,"aliases":["강제적이성애"]},{"slug":"doing-gender","title_ko":"젠더 행하기","title_en":"Doing Gender","meaning":"젠더를 개인이 소유한 고정된 속성이 아니라 일상적 상호작용 속에서 지속적으로 수행되고 타인에 의해 확인되는 사회적 성취로…","subcategory":"페미니즘이론","level":2,"related":["social-constructionism"],"prerequisites":[],"pop":9,"aliases":["젠더행하기"]},{"slug":"abjection","title_ko":"아브젝시옹","title_en":"Abjection","meaning":"주체와 대상, 자아와 타자의 경계를 위협하며 혐오와 매혹을 동시에 불러일으키는 것(신체 분비물, 시체 등)에 대한…","subcategory":"페미니즘이론","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["비체","애브젝션","아브젝시옹(크리스테바)","크리스테바"]},{"slug":"slut-shaming","title_ko":"슬럿 셰이밍","title_en":"Slut Shaming","meaning":"여성의 성적 행동이나 옷차림이 특정 규범을 벗어난다고 판단될 때 이를 도덕적으로 비난하고 낙인찍는 사회적 관행으로, 성별…","subcategory":"페미니즘이론","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["슬럿셰이밍"]},{"slug":"postfeminist-sensibility","title_ko":"포스트페미니즘 감수성","title_en":"Postfeminist Sensibility","meaning":"성 평등이 이미 달성되었다는 전제 위에서 여성의 자기감시, 외모 관리, 개인적 선택을 여성 임파워먼트로 재구성하는 대중문화적…","subcategory":"페미니즘이론","level":1,"related":[],"prerequisites":[],"pop":12,"aliases":["포스트페미니즘감수성"]},{"slug":"reproductive-justice","title_ko":"재생산정의","title_en":"Reproductive Justice","meaning":"임신·출산의 여부와 방식을 선택할 권리뿐 아니라 안전하게 아이를 낳고 기를 수 있는 사회경제적 조건까지 포함하는 인권으로…","subcategory":"페미니즘이론","level":2,"related":["reproductive-rights"],"prerequisites":[],"aliases":["재생산적정의"]},{"slug":"reproductive-rights","title_ko":"재생산권","title_en":"Reproductive Rights","meaning":"피임, 임신중지, 출산 등 자신의 재생산에 관한 결정을 국가나 타인의 개입 없이 스스로 내릴 수 있는 권리를 지칭하는…","subcategory":"페미니즘이론","level":3,"related":["reproductive-justice"],"prerequisites":["reproductive-justice"],"pop":8,"aliases":["재생산권리","출산권"]},{"slug":"intensive-mothering","title_ko":"집중적 모성","title_en":"Intensive Mothering","meaning":"어머니가 자녀 양육에 막대한 시간, 정서적 에너지, 경제적 자원을 전문가 수준으로 투입해야 한다는 사회적 규범으로, 계급화된…","subcategory":"페미니즘이론","level":3,"related":[],"prerequisites":[],"pop":11,"aliases":["집중적모성"]},{"slug":"gender-regime","title_ko":"젠더레짐","title_en":"Gender Regime","meaning":"특정 조직, 기관, 국가 단위에서 나타나는 성별 권력관계와 노동 분업의 구체적 배열 방식을 지칭하는 개념으로, 젠더질서보다…","subcategory":"페미니즘이론","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["성별레짐","젠더체제이론","젠더레짐이론","Gender Regime Theory"]},{"slug":"glass-escalator","title_ko":"유리 에스컬레이터","title_en":"Glass Escalator","meaning":"간호, 초등교육, 사회복지 등 여성이 다수인 직종에 진입한 남성이 오히려 승진과 관리직 진출에서 암묵적 우대를 받는 현상.","subcategory":"젠더와 사회제도","level":3,"related":["glass-ceiling-index","old-boys-network"],"prerequisites":["glass-ceiling-index"],"pop":7,"aliases":["유리에스컬레이터"]},{"slug":"glass-ceiling-index","title_ko":"유리천장지수","title_en":"Glass Ceiling Index","meaning":"고등교육, 노동참여율, 임금, 관리직 비율, 의회 여성 비율 등을 종합해 각국의 여성 직장 내 유리천장 정도를 비교하는…","subcategory":"젠더와