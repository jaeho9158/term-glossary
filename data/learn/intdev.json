[{"slug":"resilience","title_ko":"회복탄력성","title_en":"Resilience","meaning":"스트레스나 역경, 트라우마를 겪은 뒤에도 심리적으로 무너지지 않고 원래 상태로 회복하거나 오히려 더 성장하는 능력입니다.","subcategory":"성격·임상심리","level":1,"related":["emotion-regulation","learned-helplessness","emotional-intelligence"],"prerequisites":[],"pop":2,"aliases":["회복력","레질리언스","적응유연성","복원력"]},{"slug":"dependency-theory","title_ko":"종속이론","title_en":"Dependency Theory","meaning":"저개발국의 빈곤이 선진국 중심의 불평등한 국제 경제 구조에 종속되어 있기 때문이라고 설명하는 발전이론.","subcategory":"거시경제","level":1,"related":[],"prerequisites":[],"pop":10,"aliases":["종속 이론"]},{"slug":"institutional-isomorphism","title_ko":"제도적 동형화","title_en":"Institutional Isomorphism","meaning":"서로 다른 목표와 상황을 가진 조직들이 시간이 지나면서 구조와 관행이 점점 비슷한 모습으로 수렴해가는 현상입니다.","subcategory":"경영·조직","level":1,"related":["habitus","rent-seeking"],"prerequisites":[],"pop":5,"aliases":["제도적 동형성"]},{"slug":"grant-element","title_ko":"증여율","title_en":"Grant Element","meaning":"원조 자금이 시장 조건의 대출에 비해 수원국에 얼마나 유리한 조건(낮은 이자율, 긴 상환기간 등)으로 제공되는지를 나타내는…","subcategory":"원조 이론 및 형태","level":2,"related":["budget-support"],"prerequisites":[],"aliases":["GE","증여요소"]},{"slug":"budget-support","title_ko":"예산지원","title_en":"Budget Support","meaning":"공여자가 특정 사업에 자금을 지정하지 않고 수원국 정부의 국가 예산에 직접 자금을 투입하여 정부 스스로 재원을 배분하도록…","subcategory":"원조 이론 및 형태","level":2,"related":[],"prerequisites":[]},{"slug":"country-programmable-aid","title_ko":"국가계획가능원조","title_en":"Country Programmable Aid","meaning":"전체 공적개발원조 중 인도적 긴급구호, 부채 탕감, 행정 비용 등을 제외하고 수원국 정부가 실제로 계획하고 활용할 수 있는…","subcategory":"원조 이론 및 형태","level":2,"related":[],"prerequisites":[],"aliases":["CPA"]},{"slug":"post-washington-consensus","title_ko":"포스트 워싱턴 컨센서스","title_en":"Post-Washington Consensus","meaning":"시장 자유화와 긴축을 강조했던 워싱턴 컨센서스의 한계를 반성하며, 제도와 거버넌스 등 비시장적 요인을 함께 고려해야 한다고…","subcategory":"무역과 개발이론","level":2,"related":[],"prerequisites":[],"aliases":["포스트워싱턴컨센서스"]},{"slug":"social-protection","title_ko":"사회보호","title_en":"Social Protection","meaning":"빈곤, 실업, 질병, 노령 등 다양한 위험으로부터 취약계층을 보호하기 위해 국가가 제공하는 정책과 제도의 총체입니다.","subcategory":"빈곤과 불평등","level":2,"related":[],"prerequisites":[],"aliases":["사회안전제도","사회적보호"]},{"slug":"aid-effectiveness-paradox","title_ko":"원조효과성역설","title_en":"Aid Effectiveness Paradox","meaning":"원조 규모가 커질수록 오히려 원조가 경제성장이나 빈곤 감소에 미치는 실증적 효과가 뚜렷하게 확인되지 않거나 약화되는 현상을…","subcategory":"원조 이론 및 형태","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["Aid Effectiveness Paradox"]},{"slug":"do-no-harm-principle","title_ko":"불가피해원칙","title_en":"Do No Harm Principle","meaning":"인도적 지원이나 개발 활동이 의도치 않게 갈등을 악화시키거나 수혜자에게 해를 끼치지 않도록 활동의 부작용을 사전에 점검하고…","subcategory":"인도주의지원","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["Do No Harm Principle","DNHP"]},{"slug":"counterfactual-analysis","title_ko":"반사실적분석","title_en":"Counterfactual Analysis","meaning":"만약 사업 개입이 없었다면 어떤 결과가 나타났을지를 추정하여, 실제 관찰된 결과와 비교함으로써 개입의 순수한 효과를…","subcategory":"프로젝트관리 및 평가","level":2,"related":[],"prerequisites":[],"pop":1}]