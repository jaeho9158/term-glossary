[{"slug":"indifference-curve","title_ko":"무차별곡선","title_en":"Indifference Curve","meaning":"소비자에게 똑같은 만족감(효용)을 주는 서로 다른 상품 조합들을 연결한 곡선입니다.","subcategory":"미시경제","level":1,"related":["opportunity-cost","utility-maximization"],"prerequisites":[],"pop":2,"aliases":["무차별 곡선"]},{"slug":"choice-overload","title_ko":"선택 과부하","title_en":"Choice Overload","meaning":"선택할 수 있는 대안이 너무 많아지면 오히려 결정을 내리기 어려워지고 선택 자체에 대한 만족도까지 떨어지는 현상입니다.","subcategory":"인지심리","level":3,"related":["anchoring-effect","cognitive-load"],"prerequisites":["anchoring-effect"]},{"slug":"life-cycle-hypothesis","title_ko":"생애주기가설","title_en":"Life-Cycle Hypothesis","meaning":"사람들은 평생 벌어들일 소득을 예상해서, 소득이 적은 시기(청년기·노년기)와 많은 시기(중장년기)에 걸쳐 소비 수준을 고르게…","subcategory":"거시경제","level":3,"related":["universal-basic-income","inflation"],"prerequisites":["inflation"],"pop":9,"aliases":["라이프사이클가설"]},{"slug":"conjoint-analysis","title_ko":"컨조인트 분석","title_en":"Conjoint Analysis","meaning":"여러 속성이 결합된 제품이나 대안을 응답자에게 평가 또는 순위매김하도록 한 뒤, 그 결과를 분해하여 각 속성과 속성 수준이…","subcategory":"경영·조직","level":3,"related":["hedonic-pricing-model","contingent-valuation-method","likert-scale"],"prerequisites":[],"pop":1},{"slug":"stimulus-organism-response-model","title_ko":"자극-유기체-반응모형","title_en":"Stimulus-Organism-Response Model","meaning":"외부 자극이 소비자 내면의 심리적 상태(유기체)를 거쳐 특정 행동 반응으로 이어지는 과정을 설명하는 소비자행동 모형입니다.","subcategory":"소비자행동 및 의사결정","level":2,"related":[],"prerequisites":[],"aliases":["SORM","자극 유기체 반응모형","자극유기체반응모형"]},{"slug":"lifestyle","title_ko":"라이프스타일","title_en":"Lifestyle","meaning":"개인이 시간과 자원을 어떻게 활용하는지를 보여주는 활동, 관심사, 의견의 총체적 생활양식입니다.","subcategory":"소비문화와 소비유형","level":2,"related":[],"prerequisites":[],"pop":14},{"slug":"utility-maximization","title_ko":"효용극대화","title_en":"Utility Maximization","meaning":"소비자가 한정된 소득 안에서 자신이 얻는 만족(효용)을 가장 크게 만드는 방식으로 소비를 선택한다는 경제학의 기본 가정을…","subcategory":"소비자경제이론","level":2,"related":["law-of-diminishing-marginal-utility"],"prerequisites":[]},{"slug":"consumer-susceptibility-to-normative-influence","title_ko":"규범적 영향 민감성","title_en":"Consumer Susceptibility to Normative Influence","meaning":"다른 사람의 기대나 사회적 규범을 따르기 위해 소비 결정을 조정하려는 소비자의 성향을 말합니다.","subcategory":"소비자심리와 태도","level":2,"related":[],"prerequisites":[],"aliases":["Consumer Susceptibility to Normative Influence","CSNI","규범적영향민감성"]},{"slug":"green-consumer-psychology","title_ko":"녹색소비자심리","title_en":"Green Consumer Psychology","meaning":"환경 보호나 지속가능성에 대한 가치관이 소비자의 구매 태도와 행동에 어떻게 영향을 미치는지를 다루는 심리적 연구 영역입니다.","subcategory":"지속가능소비와 윤리적소비","level":2,"related":[],"prerequisites":[],"aliases":["Green Consumer Psychology"]},{"slug":"platform-consumer-protection","title_ko":"플랫폼 소비자보호","title_en":"Platform Consumer Protection","meaning":"온라인 플랫폼을 매개로 한 거래에서 소비자가 입을 수 있는 피해를 예방하고 구제하기 위해 플랫폼 사업자와 정책 당국이…","subcategory":"소비자정책과 법제","level":2,"related":[],"prerequisites":[],"aliases":["Platform Consumer Protection","플랫폼소비자보호"]},{"slug":"post-purchase-dissonance","title_ko":"구매 후 부조화","title_en":"Post-Purchase Dissonance","meaning":"소비자가 구매 결정을 내린 후, 그 선택이 옳았는지에 대한 심리적 불안과 갈등을 느끼는 인지적 불편함 상태를 말합니다.","subcategory":"고객만족·충성과 불평행동","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["Post-Purchase Dissonance","구매후부조화","인지부조화(소비자)","Cognitive Dissonance"]},{"slug":"relative-deprivation-household","title_ko":"상대적 박탈감","title_en":"Relative Deprivation","meaning":"자신의 소득이나 소비 수준을 다른 사람이나 집단과 비교했을 때 느끼는 상대적인 부족감이나 불만족감을 뜻합니다.","subcategory":"소비자심리와 태도","level":2,"related":["anomie"],"prerequisites":[],"pop":3,"aliases":["상대적박탈감","상대적 박탈"]},{"slug":"household-time-management","title_ko":"가계 시간관리","title_en":"Household Time Management","meaning":"가계 구성원이 가사노동, 유급노동, 여가 등 한정된 시간자원을 배분하고 조정하는 관리 활동을 말합니다.","subcategory":"가계자원관리","level":1,"related":[],"prerequisites":[],"aliases":["가계시간관리"]},{"slug":"customer-delight","title_ko":"고객 감동","title_en":"Customer Delight","meaning":"단순한 기대 충족을 넘어 고객이 예상하지 못한 긍정적 경험을 통해 강한 정서적 만족을 느끼는 상태를 말합니다.","subcategory":"고객만족·충성과 불평행동","level":1,"related":[],"prerequisites":[],"aliases":["고객감동"]},{"slug":"veblen-effect","title_ko":"베블런 효과","title_en":"Veblen Effect","meaning":"가격이 오를수록 오히려 수요가 증가하는 현상으로, 높은 가격 자체가 사회적 지위를 과시하는 수단이 될 때 나타납니다.","subcategory":"소비문화와 소비유형","level":1,"related":[],"prerequisites":[],"pop":8,"aliases":["베블런효과"]},{"slug":"anchoring-effect-consumer","title_ko":"닻내림 효과(소비자)","title_en":"Anchoring Effect","meaning":"소비자가 처음 접한 숫자나 정보를 기준점(닻)으로 삼아 이후의 가격 판단이나 의사결정을 그에 맞춰 조정하는 심리적 편향을…","subcategory":"소비자심리와 태도","level":1,"related":[],"prerequisites":[],"pop":5,"aliases":["닻내림 효과","닻내림효과","닻내림효과(소비자)"]},{"slug":"consumer-basic-act","title_ko":"소비자기본법","title_en":"Framework Act on Consumers","meaning":"소비자의 기본적 권리와 국가·사업자의 책무를 규정하여 소비자 정책의 기본 방향을 제시하는 우리나라의 대표적 소비자 관련…","subcategory":"소비자정책과 법제","level":1,"related":[],"prerequisites":[],"aliases":["FAC"]},{"slug":"fair-trade-consumption","title_ko":"공정무역 소비","title_en":"Fair Trade Consumption","meaning":"생산자에게 정당한 가격과 노동조건을 보장하는 방식으로 생산된 제품을 의도적으로 선택해 구매하는 윤리적 소비행동을 말합니다.","subcategory":"지속가능소비와 윤리적소비","level":1,"related":[],"prerequisites":[],"aliases":["공정무역소비"]},{"slug":"extended-self","title_ko":"확장된 자아","title_en":"Extended Self","meaning":"소비자가 자신이 소유한 물건과 브랜드를 자기 자신의 일부로 받아들여 정체성의 경계를 넓힌다고 보는 소비문화 연구의 핵심…","subcategory":"소비문화와 소비유형","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["확장자아","확대된 자아","Extended Self Theory"]},{"slug":"attitude-behavior-gap","title_ko":"태도-행동 격차","title_en":"Attitude-Behavior Gap","meaning":"친환경적이거나 윤리적인 소비에 우호적인 태도를 밝힌 소비자가 실제 구매에서는 그 태도대로 행동하지 않는 불일치 현상을…","subcategory":"지속가능소비와 윤리적소비","level":2,"related":["fair-trade-consumption"],"prerequisites":[],"pop":6,"aliases":["의도-행동 격차","그린 갭","Green Gap"]}]