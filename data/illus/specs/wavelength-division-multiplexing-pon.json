 "legend": [
  {
   "sym": "PON",
   "kind": "abbr",
   "desc": "수동 광통신망(passive optical network). TDM은 시분할 다중화(time-division multiplexing), WDM은 파장 분할 다중화(wavelength-division multiplexing)이다"
  },
  {
   "sym": "OLT",
   "kind": "abbr",
   "desc": "광회선단말(optical line terminal). 통신사 쪽 장비"
  },
  {
   "sym": "ONU",
   "kind": "abbr",
   "desc": "광망단말(optical network unit). 가입자 쪽 장비"
  },
  {
   "sym": "λ",
   "kind": "var",
   "desc": "파장. λ_{1}, λ_{2}, …, λ_{32}는 가입자별 전용 파장"
  },
  {
   "sym": "스플리터",
   "kind": "term",
   "desc": "빛을 여러 가닥으로 나누는 수동 소자"
  },
  {
   "sym": "파장 분리 소자",
   "kind": "term",
   "desc": "여러 파장이 섞인 빛을 파장별로 갈라 가입자마다 나눠 주는 소자"
  }
 ],
