[{"slug":"intermediate-cutting","title_ko":"중간벌채","title_en":"Intermediate Cutting","meaning":"주벌 이전 임분의 생장과 구조를 조정하기 위해 실시하는 간벌 등의 중간 시업.","subcategory":"산림생태·조림학","level":3,"related":[],"prerequisites":[]},{"slug":"net-primary-productivity","title_ko":"순1차생산량","title_en":"Net Primary Productivity","meaning":"광합성으로 생산된 총 유기물에서 식물 자체의 호흡 소모량을 제외한 순 생산량.","subcategory":"산림생태·조림학","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["NPP","순일차생산량"]},{"slug":"seed-bank","title_ko":"종자은행","title_en":"Seed Bank","meaning":"토양 내에 축적되어 발아 가능한 상태로 존재하는 종자의 집합.","subcategory":"산림생태·조림학","level":1,"related":[],"prerequisites":[],"pop":14,"aliases":["매토종자","토양종자은행"]},{"slug":"exotic-species-invasion","title_ko":"외래종침입","title_en":"Exotic Species Invasion","meaning":"원래 자생하지 않던 외래종이 새로운 지역에 도입되어 정착, 확산되는 현상.","subcategory":"산림생태·조림학","level":3,"related":[],"prerequisites":[],"pop":12,"aliases":["외래종유입"]},{"slug":"timber-volume","title_ko":"재적","title_en":"Timber Volume","meaning":"입목이나 벌채된 원목이 차지하는 목재의 부피를 나타내는 값으로, 산림경영과 목재수확 계획의 기초 자료가 된다.","subcategory":"임산공학·산림경영","level":1,"related":["form-factor"],"prerequisites":[],"aliases":["목재재적","입목재적"]},{"slug":"smalian-formula","title_ko":"스말리안식","title_en":"Smalian's Formula","meaning":"원목의 양쪽 끝 단면적 평균에 길이를 곱하여 재적을 구하는 계산식으로, 벌채된 통나무의 재적 산출에 널리 쓰인다.","subcategory":"임산공학·산림경영","level":2,"related":["timber-volume","huber-formula"],"prerequisites":["timber-volume"],"pop":11,"aliases":["스말리안공식"]},{"slug":"huber-formula","title_ko":"후브러식","title_en":"Huber's Formula","meaning":"원목 중앙부의 단면적에 길이를 곱하여 재적을 구하는 계산식으로, 원목재적 산정의 대표적 방법 중 하나이다.","subcategory":"임산공학·산림경영","level":3,"related":["timber-volume","smalian-formula"],"prerequisites":["timber-volume","smalian-formula"],"aliases":["후버공식","후버식"]},{"slug":"volume-maximizing-rotation","title_ko":"재적수확벌기령","title_en":"Volume-maximizing Rotation","meaning":"임분의 평균생장량이 최대가 되는 시점을 벌기령으로 정하는 방식으로, 목재 물량 생산을 극대화하는 데 목적을 둔다.","subcategory":"임산공학·산림경영","level":3,"related":[],"prerequisites":[],"aliases":["VMR"]},{"slug":"checking-wood","title_ko":"할렬","title_en":"Checking (Splitting)","meaning":"건조나 건조응력으로 인해 목재의 섬유방향을 따라 표면 또는 내부에 갈라짐이 생기는 건조결함이다.","subcategory":"임산공학·산림경영","level":1,"related":[],"prerequisites":[],"pop":3,"aliases":["Splitting"]},{"slug":"dehumidification-drying","title_ko":"제습식건조","title_en":"Dehumidification Drying","meaning":"제습기를 이용해 건조실 내 공기 중 수분을 응축·제거하면서 상대적으로 낮은 온도에서 목재를 건조하는 인공건조 방식이다.","subcategory":"임산공학·산림경영","level":3,"related":[],"prerequisites":[],"aliases":["제습건조"]},{"slug":"glued-laminated-timber","title_ko":"집성재","title_en":"Glued Laminated Timber (Glulam)","meaning":"건조된 제재목의 결함을 제거하고 섬유방향을 나란히 하여 접착제로 여러 겹 접합한 목질재료로, 큰 단면과 긴 부재를 만들 수…","subcategory":"임산공학·산림경영","level":1,"related":["finger-joint"],"prerequisites":[],"aliases":["Glulam"]},{"slug":"oriented-strand-board","title_ko":"배향성스트랜드보드","title_en":"Oriented Strand Board (OSB)","meaning":"목재를 얇고 긴 스트랜드 형태로 절삭한 뒤 층마다 방향을 맞춰 배열하고 접착제로 압착 성형한 구조용 목질판재이다.","subcategory":"임산공학·산림경영","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["OSB"]},{"slug":"finger-joint","title_ko":"핑거조인트","title_en":"Finger Joint","meaning":"짧은 목재 조각의 끝부분을 손가락 모양으로 가공하여 서로 맞물리게 접착함으로써 긴 부재를 만드는 접합 방식이다.","subcategory":"임산공학·산림경영","level":2,"related":["glued-laminated-timber"],"prerequisites":["glued-laminated-timber"],"pop":4,"aliases":["치형접합","핑거접합"]},{"slug":"normal-forest","title_ko":"법정림","title_en":"Normal Forest (Regulated Forest)","meaning":"임령별 임분 면적이 균등하게 배치되어 매년 지속적이고 균등한 재적 수확이 가능하도록 이론적으로 구성된 산림 상태이다.","subcategory":"임산공학·산림경영","level":3,"related":[],"prerequisites":[],"pop":10,"aliases":["Regulated Forest"]},{"slug":"forest-road","title_ko":"임도","title_en":"Forest Road","meaning":"산림의 조성, 관리, 목재수확 등 산림작업을 위해 산림 내부에 개설한 도로로, 자재와 장비, 인력 이동에 사용된다.","subcategory":"임산공학·산림경영","level":2,"related":[],"prerequisites":[],"pop":13,"aliases":["산림도로","임도망"]},{"slug":"diameter-tape","title_ko":"흉고직경측정기","title_en":"Diameter Tape (Caliper)","meaning":"나무 줄기의 둘레를 재어 직경으로 환산하여 표시하거나, 양쪽 다리를 벌려 직경을 직접 측정하는 흉고직경 측정 기구이다.","subcategory":"임산공학·산림경영","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["Caliper"]},{"slug":"bending-strength-wood","title_ko":"휨강도","title_en":"Bending Strength (MOR)","meaning":"목재 시편에 굽힘 하중을 가했을 때 파괴에 이르는 최대 응력으로, 최대휨강도(MOR)로 표현되며 구조용재 등급구분의 핵심…","subcategory":"임산공학·산림경영","level":1,"related":["modulus-of-elasticity-wood"],"prerequisites":[],"pop":5,"aliases":["MOR","곡강도"]},{"slug":"modulus-of-elasticity-wood","title_ko":"목재탄성계수","title_en":"Modulus of Elasticity (MOE)","meaning":"목재에 하중이 가해졌을 때 변형에 대한 저항성을 나타내는 물성값으로, 구조부재의 처짐량 예측과 강도등급 구분에 사용된다.","subcategory":"임산공학·산림경영","level":2,"related":["bending-strength-wood"],"prerequisites":["bending-strength-wood"],"pop":8},{"slug":"shear-strength-wood","title_ko":"목재전단강도","title_en":"Shear Strength of Wood","meaning":"목재 내부에서 서로 다른 층이 미끄러지듯 어긋나는 전단 응력에 저항하는 능력으로, 접합부나 보 부재의 설계에서 중요한…","subcategory":"임산공학·산림경영","level":3,"related":["bending-strength-wood","glued-laminated-timber"],"prerequisites":["bending-strength-wood"],"pop":7,"aliases":["전단강도"]},{"slug":"hardwood","title_ko":"활엽수재","title_en":"Hardwood","meaning":"참나무, 자작나무 등 활엽수에서 얻어지는 목재로, 도관을 가지며 대체로 침엽수재보다 조직이 치밀하고 밀도가 높은 편이다.","subcategory":"임산공학·산림경영","level":1,"related":[],"prerequisites":[],"pop":15,"aliases":["경재","활엽수목재"]},{"slug":"wood-pellet","title_ko":"목재펠릿","title_en":"Wood Pellet","meaning":"목재 부산물을 분쇄하고 건조한 뒤 고압으로 압축 성형하여 만든 원통형 고체연료로, 발열량이 높고 부피가 작아 저장과 운송에…","subcategory":"임산공학·산림경영","level":2,"related":[],"prerequisites":[],"pop":9,"aliases":["우드펠릿","펠릿연료"]},{"slug":"baekdudaegan-protection","title_ko":"백두대간보호","title_en":"Baekdudaegan Protection","meaning":"한반도 산줄기의 근간을 이루는 백두대간의 생태계와 산림자원을 보전하기 위해 「백두대간 보호에 관한 법률」에 근거하여…","subcategory":"산림휴양·산림정책","level":3,"related":[],"prerequisites":[],"aliases":["백두대간보호지역"]}]