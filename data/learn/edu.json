[{"slug":"reliability","title_ko":"신뢰도","title_en":"Reliability","meaning":"같은 측정을 반복했을 때 결과가 얼마나 일관되게 나오는지의 정도.","subcategory":"설문·척도","level":1,"related":["validity","likert-scale","construct","content-analysis","split-half-reliability","cronbachs-alpha","internal-consistency-reliability"],"prerequisites":[],"pop":18,"aliases":["신뢰성","Educational Evaluation","Reliability (Educational Evaluation)"]},{"slug":"signaling-theory","title_ko":"신호 이론","title_en":"Signaling Theory","meaning":"정보를 가진 쪽이 자신의 숨겨진 능력이나 품질을 상대방에게 믿을 만하게 전달하기 위해, 비용이 드는 행동(신호)을 이용하는…","subcategory":"미시경제","level":1,"related":["information-asymmetry","adverse-selection","moral-hazard"],"prerequisites":[],"pop":9,"aliases":["신호이론","시그널링 이론","Signaling Theory in Education"]},{"slug":"taba-curriculum-model","title_ko":"타바의 교육과정개발모형","title_en":"Taba's Curriculum Development Model","meaning":"교사가 학습자의 요구 진단부터 시작해 목표, 내용, 학습경험, 평가를 귀납적으로 개발해 가는 교사 주도의 교육과정…","subcategory":"교육과정·교수학습이론","level":2,"related":["walker-naturalistic-model"],"prerequisites":[],"pop":17,"aliases":["타바의교육과정개발모형"]},{"slug":"walker-naturalistic-model","title_ko":"워커의 자연주의적 교육과정모형","title_en":"Walker's Naturalistic Curriculum Model","meaning":"강령(platform), 숙의(deliberation), 설계(design)의 단계를 거치며 개발 참여자들의 협의와 타협을…","subcategory":"교육과정·교수학습이론","level":2,"related":["taba-curriculum-model"],"prerequisites":[],"pop":10,"aliases":["WNCM","워커의자연주의적교육과정모형"]},{"slug":"core-curriculum","title_ko":"중핵교육과정","title_en":"Core Curriculum","meaning":"특정 교과의 경계를 넘어 사회적 문제나 학생의 요구 등 핵심 주제를 중심에 두고 여러 교과 내용을 통합적으로 조직한…","subcategory":"교육과정·교수학습이론","level":1,"related":["experience-centered-curriculum"],"prerequisites":[]},{"slug":"experience-centered-curriculum","title_ko":"경험중심교육과정","title_en":"Experience-Centered Curriculum","meaning":"교과 지식보다 학습자의 흥미와 필요에서 출발한 생활 경험을 중심으로 내용을 조직하는 진보주의적 교육과정이다.","subcategory":"교육과정·교수학습이론","level":1,"related":["core-curriculum"],"prerequisites":[]},{"slug":"achievement-standards","title_ko":"성취기준","title_en":"Achievement Standards","meaning":"교과 학습을 통해 학생이 특정 단계에서 도달해야 할 지식, 기능, 태도를 구체적으로 진술한 국가 수준의 기준이다.","subcategory":"교육과정·교수학습이론","level":1,"related":[],"prerequisites":[]},{"slug":"curriculum-mapping","title_ko":"교육과정 매핑","title_en":"Curriculum Mapping","meaning":"학년과 교과에 걸쳐 가르쳐지는 내용, 기능, 평가 시기를 시각적으로 정리하여 중복과 공백을 점검하는 교육과정 문서화 기법이다.","subcategory":"교육과정·교수학습이론","level":2,"related":["scope-and-sequence","horizontal-articulation"],"prerequisites":["scope-and-sequence"],"pop":20,"aliases":["교육과정매핑"]},{"slug":"horizontal-articulation","title_ko":"수평적 연계","title_en":"Horizontal Articulation","meaning":"동일 학년 내에서 서로 다른 교과 간에 내용과 개념이 상호 관련되고 통합적으로 조직되는 것이다.","subcategory":"교육과정·교수학습이론","level":2,"related":["core-curriculum"],"prerequisites":["core-curriculum"],"aliases":["수평적연계"]},{"slug":"scope-and-sequence","title_ko":"스코프와 시퀀스","title_en":"Scope and Sequence","meaning":"교육내용의 범위(scope)와 학습 순서(sequence)를 결정하는 교육과정 조직의 두 가지 핵심 차원이다.","subcategory":"교육과정·교수학습이론","level":1,"related":["curriculum-mapping"],"prerequisites":[],"aliases":["스코프와시퀀스"]},{"slug":"enduring-understanding","title_ko":"영속적 이해","title_en":"Enduring Understanding","meaning":"세부 사실을 넘어 학습자가 시간이 지나도 기억하고 다른 상황에 전이할 수 있는 큰 개념과 원리에 대한 이해이다.","subcategory":"교육과정·교수학습이론","level":2,"related":[],"prerequisites":[],"aliases":["영속적이해"]},{"slug":"stake-responsive-evaluation","title_ko":"스테이크의 반응적 평가모형","title_en":"Stake's Responsive Evaluation Model","meaning":"사전에 정해진 목표 달성 여부보다 프로그램 관련자들의 관심사와 쟁점에 반응하며 다양한 관점의 정보를 수집하는 질적…","subcategory":"교육과정·교수학습이론","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["SREM","스테이크의반응적평가모형"]},{"slug":"concerns-based-adoption-model","title_ko":"관심중심수용모형","title_en":"Concerns-Based Adoption Model (CBAM)","meaning":"새로운 교육과정이나 혁신을 받아들이는 교사의 관심 단계와 실행 수준을 진단하여 맞춤형 지원을 제공하기 위한 모형이다.","subcategory":"교육과정·교수학습이론","level":1,"related":[],"prerequisites":[],"pop":19},{"slug":"scaffolding","title_ko":"스캐폴딩","title_en":"Scaffolding","meaning":"학습자가 근접발달영역 내의 과제를 해결할 수 있도록 교사나 유능한 타인이 제공하는 임시적이고 점차 줄어드는 지원이다.","subcategory":"교육과정·교수학습이론","level":1,"related":["cognitive-apprenticeship"],"prerequisites":[],"pop":5,"aliases":["발판","발판화"]},{"slug":"situated-learning","title_ko":"상황학습이론","title_en":"Situated Learning","meaning":"지식과 학습은 그것이 사용되는 실제 맥락과 활동, 문화로부터 분리될 수 없다고 보는 학습이론이다.","subcategory":"교육과정·교수학습이론","level":1,"related":["cognitive-apprenticeship"],"prerequisites":[]},{"slug":"cognitive-apprenticeship","title_ko":"인지적도제이론","title_en":"Cognitive Apprenticeship","meaning":"전통적 도제제도의 모델링, 코칭, 스캐폴딩 방식을 인지적·메타인지적 기능의 교육에 적용한 교수모형이다.","subcategory":"교육과정·교수학습이론","level":2,"related":["scaffolding","situated-learning"],"prerequisites":["scaffolding","situated-learning"],"pop":11},{"slug":"action-learning","title_ko":"액션러닝","title_en":"Action Learning","meaning":"실제 조직이나 현장의 문제를 소집단이 함께 해결해 나가며 그 과정에서 성찰을 통해 학습이 일어나는 실천중심 학습방법이다.","subcategory":"교육과정·교수학습이론","level":3,"related":["action-research"],"prerequisites":[]},{"slug":"blended-learning","title_ko":"블렌디드러닝","title_en":"Blended Learning","meaning":"온라인 학습과 오프라인 대면 학습의 장점을 결합하여 학습효과를 극대화하려는 교수학습 형태이다.","subcategory":"교육과정·교수학습이론","level":1,"related":["addie-model"],"prerequisites":[],"pop":8,"aliases":["혼합학습"]},{"slug":"socratic-method","title_ko":"소크라테스식 문답법","title_en":"Socratic Method","meaning":"교사가 답을 직접 제시하지 않고 연속적인 질문을 통해 학습자 스스로 모순을 발견하고 진리에 도달하도록 이끄는 교수법이다.","subcategory":"교육과정·교수학습이론","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["소크라테스식문답법"]},{"slug":"bloom-taxonomy","title_ko":"블룸의 교육목표분류학","title_en":"Bloom's Taxonomy","meaning":"교육목표를 인지적, 정의적, 심동적 영역으로 나누고 인지적 영역을 지식부터 평가까지 위계적 단계로 분류한 체계이다.","subcategory":"교육과정·교수학습이론","level":1,"related":["revised-bloom-taxonomy","affective-domain-taxonomy"],"prerequisites":[],"pop":4,"aliases":["블룸의교육목표분류학"]},{"slug":"revised-bloom-taxonomy","title_ko":"신교육목표분류학","title_en":"Revised Bloom's Taxonomy","meaning":"블룸의 인지적 영역 분류를 지식 차원과 인지과정 차원의 이차원 구조로 재구성하고 종합을 창안으로 대체한 개정 분류체계이다.","subcategory":"교육과정·교수학습이론","level":3,"related":["bloom-taxonomy"],"prerequisites":["bloom-taxonomy"],"pop":14,"aliases":["개정블룸분류학","블룸분류학"]},{"slug":"affective-domain-taxonomy","title_ko":"정의적영역 교육목표분류","title_en":"Affective Domain Taxonomy","meaning":"감수, 반응, 가치화, 조직화, 인격화의 단계로 태도와 가치, 감정의 내면화 정도를 위계적으로 분류한 체계이다.","subcategory":"교육과정·교수학습이론","level":2,"related":["bloom-taxonomy"],"prerequisites":["bloom-taxonomy"],"aliases":["정의적영역교육목표분류"]},{"slug":"addie-model","title_ko":"ADDIE모형","title_en":"ADDIE Model","meaning":"분석, 설계, 개발, 실행, 평가의 다섯 단계로 구성된 가장 일반적이고 대표적인 교수체제설계 모형이다.","subcategory":"교육과정·교수학습이론","level":2,"related":["assure-model"],"prerequisites":[],"aliases":["애디모형"]},{"slug":"assure-model","title_ko":"ASSURE모형","title_en":"ASSURE Model","meaning":"학습자 분석, 목표진술, 방법·매체·자료 선정, 자료와 매체 활용, 학습자 참여 요구, 평가와 수정의 단계로 구성된 수업매체…","subcategory":"교육과정·교수학습이론","level":2,"related":["addie-model"],"prerequisites":[],"aliases":["어슈어모형"]},{"slug":"component-display-theory","title_ko":"메릴의 내용요소제시이론","title_en":"Merrill's Component Display Theory","meaning":"학습내용을 사실, 개념, 절차, 원리의 내용 유형과 기억, 활용, 발견의 수행 수준으로 이차원 분류하여 수업 처방을 제시하는…","subcategory":"교육과정·교수학습이론","level":3,"related":[],"prerequisites":[],"aliases":["MCDT","메릴의내용요소제시이론"]},{"slug":"culturally-responsive-teaching","title_ko":"문화감응교수법","title_en":"Culturally Responsive Teaching","meaning":"학습자의 문화적 배경, 경험, 관점을 수업내용과 방법에 적극적으로 반영하여 학습효과와 형평성을 높이려는 교수접근이다.","subcategory":"교육과정·교수학습이론","level":3,"related":[],"prerequisites":[]},{"slug":"rubric-assessment","title_ko":"루브릭평가","title_en":"Rubric Assessment","meaning":"수행의 질적 수준을 여러 준거와 단계로 명시한 채점기준표를 활용하여 일관되고 투명하게 평가하는 방식이다.","subcategory":"교육과정·교수학습이론","level":2,"related":[],"prerequisites":[],"pop":2},{"slug":"practical-skill-assessment","title_ko":"실기평가","title_en":"Practical Skill Assessment","meaning":"체육, 음악, 미술, 실습 교과 등에서 학습자가 실제로 수행하는 기능이나 동작의 숙련도를 직접 평가하는 방식이다.","subcategory":"교육평가·교육정책","level":3,"related":["rubric"],"prerequisites":["rubric"]},{"slug":"constructed-response-assessment","title_ko":"서술형평가","title_en":"Constructed-Response Assessment","meaning":"학습자가 자신의 언어로 답을 직접 구성하여 서술하도록 요구하는 평가 방식으로, 사고 과정과 표현력을 함께 평가한다.","subcategory":"교육평가·교육정책","level":3,"related":["essay-assessment","reliability"],"prerequisites":["reliability"]},{"slug":"essay-assessment","title_ko":"논술형평가","title_en":"Essay Assessment","meaning":"주어진 주제나 논제에 대해 학습자가 논리적으로 구성된 글을 작성하도록 하여 사고력과 표현력을 종합적으로 평가하는 방식이다.","subcategory":"교육평가·교육정책","level":3,"related":["constructed-response-assessment","reliability","content-validity"],"prerequisites":["reliability"]},{"slug":"rubric","title_ko":"루브릭","title_en":"Rubric","meaning":"평가 대상 과제의 여러 평가 요소별로 성취 수준의 특징을 구체적으로 기술한 채점 안내표로, 채점의 일관성과 학습자에 대한…","subcategory":"교육평가·교육정책","level":1,"related":[],"prerequisites":[],"pop":1},{"slug":"national-assessment-educational-achievement","title_ko":"국가수준학업성취도평가","title_en":"National Assessment of Educational Achievement","meaning":"국가가 초·중·고등학교 학생을 대상으로 교과별 학업성취 수준을 주기적으로 점검하기 위해 실시하는 표준화된 대규모 평가이다.","subcategory":"교육평가·교육정책","level":1,"related":["basic-academic-skills-guarantee-policy"],"prerequisites":[],"aliases":["NAEA"]},{"slug":"basic-academic-skills-guarantee-policy","title_ko":"기초학력보장정책","title_en":"Basic Academic Skills Guarantee Policy","meaning":"모든 학생이 학년별로 요구되는 최소한의 기초학력에 도달할 수 있도록 진단, 지도, 지원을 체계적으로 제공하는 국가 및 교육청…","subcategory":"교육평가·교육정책","level":1,"related":[],"prerequisites":[],"aliases":["BASGP"]},{"slug":"childcare-classroom","title_ko":"돌봄교실","title_en":"Childcare Classroom","meaning":"맞벌이 가정 등의 자녀를 위해 정규 수업 이후 학교 내에서 안전한 보호와 다양한 활동을 제공하는 학교 돌봄 서비스이다.","subcategory":"교육평가·교육정책","level":2,"related":[],"prerequisites":[]},{"slug":"physical-disability","title_ko":"지체장애","title_en":"Physical Disability","meaning":"신체의 골격, 근육, 신경계통의 손상으로 인해 이동, 자세유지, 신체 조작 등에 어려움을 겪는 장애를 말한다.","subcategory":"특수교육·평생교육","level":3,"related":[],"prerequisites":[]},{"slug":"communication-disorder","title_ko":"의사소통장애","title_en":"Communication Disorder","meaning":"언어의 이해나 표현, 말소리 산출, 유창성, 음성 등에서 어려움을 겪어 효과적인 의사소통에 지장이 있는 상태를 