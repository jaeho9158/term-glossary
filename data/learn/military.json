[{"slug":"geneva-conventions","title_ko":"제네바협약","title_en":"Geneva Conventions","meaning":"전쟁 희생자 보호를 목적으로 하는 4개의 국제협약으로, 부상병, 포로, 민간인 보호에 관한 국제인도법의 핵심 규범을 이룹니다.","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"aliases":["제네바조약"]},{"slug":"asymmetric-strategy","title_ko":"비대칭전략","title_en":"Asymmetric Strategy","meaning":"상대적으로 약한 쪽이 강한 상대의 정면 전력에 맞서지 않고, 상대의 약점이나 다른 수단을 활용해 전력 격차를 상쇄하려는…","subcategory":"전략론","level":2,"related":[],"prerequisites":[]},{"slug":"campaign-plan","title_ko":"작전계획","title_en":"Campaign Plan","meaning":"전략적 목표를 달성하기 위해 일련의 관련된 작전과 전투를 시간·공간적으로 어떻게 연결하고 수행할지 구체화한 계획 문서입니다.","subcategory":"작전술","level":2,"related":[],"prerequisites":[]},{"slug":"operational-reach","title_ko":"작전한계","title_en":"Operational Reach","meaning":"작전한계는 병참, 전투력, 지휘통제 등의 제약으로 인해 아군 부대가 작전목표를 유지하며 효과적으로 전투력을 투사할 수 있는…","subcategory":"작전술","level":2,"related":["force-structure"],"prerequisites":[]},{"slug":"defense-policy","title_ko":"국방정책","title_en":"Defense Policy","meaning":"국방정책은 국가가 안보 목표를 달성하기 위해 군사력의 건설, 운용, 배분 방향을 결정하는 정부 차원의 종합적 방침을…","subcategory":"국방정책","level":2,"related":["force-structure"],"prerequisites":[]},{"slug":"force-structure","title_ko":"군사력구조","title_en":"Force Structure","meaning":"군사력구조는 육·해·공군 등 각 군의 병력, 부대편성, 무기체계가 어떤 규모와 비율로 조합되어 있는지를 나타내는 군의 전체적…","subcategory":"국방정책","level":2,"related":["defense-policy"],"prerequisites":[]},{"slug":"mutual-assured-destruction","title_ko":"상호확증파괴","title_en":"Mutual Assured Destruction","meaning":"상호확증파괴(MAD)는 양측 모두 상대의 선제 핵공격에도 살아남아 치명적인 보복 핵공격을 가할 수 있는 능력을 갖춤으로써…","subcategory":"핵전략·억제","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["Mutually Assured Destruction"]},{"slug":"unconventional-warfare","title_ko":"비정규전","title_en":"Unconventional Warfare","meaning":"정규군끼리의 정면 대결이 아니라, 현지 저항 세력이나 게릴라 조직을 지원·훈련·조직화하여 적국 내부에서 전복이나 저항을…","subcategory":"비정규전·대테러","level":2,"related":[],"prerequisites":[],"pop":6},{"slug":"jus-ad-bellum-doctrine","title_ko":"개전법","title_en":