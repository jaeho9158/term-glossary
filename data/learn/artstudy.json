[{"slug":"high-renaissance","title_ko":"전성기 르네상스","title_en":"High Renaissance","meaning":"1490년대부터 1520년대까지 레오나르도 다빈치, 미켈란젤로, 라파엘로 등이 활동하며 균형·조화·이상화된 형태미를 정점에…","subcategory":"미술사조·도상학","level":1,"related":["sfumato","disegno","mannerism"],"prerequisites":[],"aliases":["전성기르네상스"]},{"slug":"mannerism","title_ko":"매너리즘","title_en":"Mannerism","meaning":"전성기 르네상스 이후 16세기에 등장한 양식으로, 인위적으로 길쭉하게 왜곡된 인체 비례, 불안정한 구도, 과장된 감정 표현을…","subcategory":"미술사조·도상학","level":2,"related":["high-renaissance","disegno"],"prerequisites":["high-renaissance","disegno"],"pop":1},{"slug":"impressionism","title_ko":"인상주의","title_en":"Impressionism","meaning":"1870년대 프랑스에서 등장한 미술 사조로, 빛과 색채의 순간적 인상을 포착하기 위해 야외에서 빠른 붓질로 그리는 것을…","subcategory":"미술사조·도상학","level":1,"related":["plein-air"],"prerequisites":[],"aliases":["인상파"]},{"slug":"dada","title_ko":"다다이즘","title_en":"Dada","meaning":"1916년 취리히에서 시작되어 제1차 세계대전의 참상에 대한 반발로 등장한 반예술 운동으로, 우연성, 부조리, 기존 미술…","subcategory":"미술사조·도상학","level":1,"related":["readymade","found-object"],"prerequisites":[]},{"slug":"abstract-expressionism","title_ko":"추상표현주의","title_en":"Abstract Expressionism","meaning":"1940~50년대 뉴욕을 중심으로 발달한 사조로, 재현적 형상을 완전히 배제하고 대형 캔버스에 즉흥적 몸짓이나 넓은 색면을…","subcategory":"미술사조·도상학","level":1,"related":["color-field-painting","informel"],"prerequisites":[]},{"slug":"color-field-painting","title_ko":"색면회화","title_en":"Color Field Painting","meaning":"마크 로스코, 바넷 뉴먼 등이 발전시킨 추상표현주의의 한 갈래로, 형태나 붓질보다 넓고 균일한 색면 자체를 통해 명상적이고…","subcategory":"미술사조·도상학","level":2,"related":["abstract-expressionism"],"prerequisites":["abstract-expressionism"],"aliases":["색면추상"]},{"slug":"pop-art","title_ko":"팝아트","title_en":"Pop Art","meaning":"1950~60년대 영국과 미국에서 등장한 사조로, 대중문화·광고·소비재 이미지를 순수미술의 소재로 끌어들여 고급 예술과…","subcategory":"미술사조·도상학","level":2,"related":["found-object"],"prerequisites":["found-object"],"pop":11},{"slug":"conceptual-art","title_ko":"개념미술","title_en":"Conceptual Art","meaning":"1960년대 후반 등장한 사조로, 작품의 물리적 형태나 미적 완성도보다 그 배후에 있는 아이디어와 개념 자체를 예술의 본질로…","subcategory":"미술사조·도상학","level":1,"related":["readymade"],"prerequisites":[],"aliases":["컨셉추얼아트","개념미술론","Conceptual Art Theory"]},{"slug":"arte-povera","title_ko":"아르테 포베라","title_en":"Arte Povera","meaning":"1960년대 후반 이탈리아에서 등장한 사조로, 흙·나뭇가지·헝겊 등 '가난한(povera)' 일상 재료를 사용해 산업…","subcategory":"미술사조·도상학","level":1,"related":["installation-art","conceptual-art","assemblage-art"],"prerequisites":[],"aliases":["아르테포베라"]},{"slug":"iconography","title_ko":"도상학","title_en":"Iconography","meaning":"미술 작품에 등장하는 인물, 상징, 소재의 전통적 의미와 유래를 식별하고 분류하는 미술사 연구 방법으로, 파노프스키의…","subcategory":"미술사조·도상학","level":1,"related":["panofsky-method","iconographic-analysis"],"prerequisites":[],"pop":13,"aliases":["이코노그래피","아이코노그래피"]},{"slug":"panofsky-method","title_ko":"파노프스키의 삼단계 해석법","title_en":"Panofsky's Three Levels of Interpretation","meaning":"에르빈 파노프스키가 제시한 미술 해석 방법론으로, 전도상학적 서술, 도상학적 분석, 도상해석학적 해석이라는 세 단계를 거쳐…","subcategory":"미술사조·도상학","level":1,"related":["pre-iconographic-description","iconographic-analysis","iconography"],"prerequisites":[],"pop":10,"aliases":["PTLI","파노프스키의삼단계해석법"]},{"slug":"pre-iconographic-description","title_ko":"전도상학적 서술","title_en":"Pre-iconographic Description","meaning":"파노프스키 삼단계 해석법의 첫 단계로, 특정한 문화적 지식 없이도 식별 가능한 형태·색채·표정 등 작품의 일차적·자연적…","subcategory":"미술사조·도상학","level":3,"related":["panofsky-method","iconographic-analysis","iconography"],"prerequisites":["panofsky-method","iconographic-analysis"],"aliases":["전도상학적서술"]},{"slug":"iconographic-analysis","title_ko":"도상학적 분석","title_en":"Iconographic Analysis","meaning":"파노프스키 삼단계 해석법의 두 번째 단계로, 문헌과 전통 지식을 바탕으로 작품 속 인물과 사물이 지시하는 관습적 주제와…","subcategory":"미술사조·도상학","level":1,"related":["pre-iconographic-description","iconography","panofsky-method"],"prerequisites":[],"pop":14,"aliases":["도상학적분석"]},{"slug":"sfumato","title_ko":"스푸마토","title_en":"Sfumato","meaning":"레오나르도 다빈치가 발전시킨 회화 기법으로, 형태의 윤곽선을 명확히 구분 짓지 않고 색과 색조를 안개처럼 부드럽게 融合시켜…","subcategory":"미술사조·도상학","level":2,"related":["high-renaissance"],"prerequisites":["high-renaissance"]},{"slug":"disegno","title_ko":"디세뇨","title_en":"Disegno","meaning":"이탈리아 미술 이론에서 '소묘'와 '구상적 설계'를 동시에 뜻하는 개념으로, 지적 구상 능력과 형태에 대한 정확한 소묘력을…","subcategory":"미술사조·도상학","level":1,"related":["high-renaissance","mannerism"],"prerequisites":[],"pop":18},{"slug":"still-life","title_ko":"정물화","title_en":"Still Life","meaning":"과일, 꽃, 식기, 해골 등 움직이지 않는 사물들을 배열하여 묘사하는 회화 장르로, 사물의 질감과 빛의 표현력을 시험하는…","subcategory":"미술사조·도상학","level":1,"related":["vanitas"],"prerequisites":[]},{"slug":"vanitas","title_ko":"바니타스","title_en":"Vanitas","meaning":"해골, 시든 꽃, 꺼진 촛불, 모래시계 등을 통해 인생의 덧없음과 죽음의 불가피성을 상기시키는 17세기 네덜란드·플랑드르…","subcategory":"미술사조·도상학","level":2,"related":["still-life","iconography"],"prerequisites":["still-life","iconography"],"pop":6},{"slug":"quadratura","title_ko":"콰드라투라","title_en":"Quadratura","meaning":"바로크 시대에 발달한 천장화 기법으로, 실제 건축 구조가 하늘까지 무한히 열려 있는 것처럼 보이도록 원근법적 환영을 이용해…","subcategory":"미술사조·도상학","level":2,"related":[],"prerequisites":[],"pop":7},{"slug":"putto","title_ko":"푸토","title_en":"Putto","meaning":"르네상스와 바로크 미술에 자주 등장하는 벌거벗은 아기 천사 혹은 어린아이 모습의 도상적 형상으로, 사랑·순수·신성한 은총을…","subcategory":"미술사조·도상학","level":3,"related":["iconography","high-renaissance"],"prerequisites":["iconography","high-renaissance"]},{"slug":"salon-system","title_ko":"살롱전","title_en":"Salon System","meaning":"프랑스 왕립 아카데미가 주관한 공식 정기 전시회로, 심사위원단의 승인을 받은 작품만 전시될 수 있었으며 19세기 화가의…","subcategory":"미술사조·도상학","level":3,"related":["impressionism"],"prerequisites":["impressionism"],"aliases":["살롱"]},{"slug":"plein-air","title_ko":"외광파","title_en":"Plein Air Painting","meaning":"실내 화실이 아닌 야외 현장에서 직접 자연광을 관찰하며 그림을 완성하는 회화 방식으로, 휴대용 물감 튜브의 발명과 함께…","subcategory":"미술사조·도상학","level":3,"related":["impressionism"],"prerequisites":["impressionism"],"aliases":["플레네르"]},{"slug":"cloisonnism","title_ko":"클루아조니슴","title_en":"Cloisonnism","meaning":"에밀 베르나르와 폴 고갱이 발전시킨 기법으로, 에나멜 공예의 칠보 기법처럼 굵고 어두운 윤곽선으로 형태를 구획하고 그 안을…","subcategory":"미술사조·도상학","level":3,"related":["primitivism-art"],"prerequisites":["primitivism-art"]},{"slug":"primitivism-art","title_ko":"원시주의","title_en":"Primitivism (Art)","meaning":"고갱, 피카소 등 근대 유럽 화가들이 아프리카·오세아니아·비서구 문화의 조형 형식과 '비서구적' 삶의 방식에서 영감을 얻어…","subcategory":"미술사조·도상학","level":1,"related":["orientalism-art"],"prerequisites":[]},{"slug":"orientalism-art","title_ko":"오리엔탈리즘 미술","title_en":"Orientalism in Art","meaning":"19세기 유럽 화가들이 중동·북아프리카·아시아를 이국적이고 관능적이며 신비로운 타자로 상상하여 재현한 미술 경향으로…","subcategory":"미술사조·도상학","level":3,"related":["primitivism-art"],"prerequisites":["primitivism-art"],"aliases":["오리엔탈리즘미술"]},{"slug":"found-object","title_ko":"오브제 트루베","title_en":"Found Object (Objet Trouvé)","meaning":"예술가가 직접 제작하지 않고 일상에서 발견한 기성 사물을 그대로 혹은 변형하여 작품에 사용하는 개념으로, 뒤샹의…","subcategory":"미술사조·도상학","level":1,"related":["readymade","dada","assemblage-art","collage"],"prerequisites":[],"aliases":["Objet Trouvé","오브제트루베"]},{"slug":"readymade","title_ko":"레디메이드","title_en":"Readymade","meaning":"마르셀 뒤샹이 1913년경 창안한 개념으로, 변기나 자전거 바퀴 같은 대량 생산된 기성품을 예술가의 선택과 서명만으로 예술…","subcategory":"미술사조·도상학","level":1,"related":["found-object","dada","conceptual-art"],"prerequisites":[]},{"slug":"collage","title_ko":"콜라주","title_en":"Collage","meaning":"신문지, 벽지, 천 조각 등 이질적인 재료를 캔버스나 종이 위에 붙여 구성하는 기법으로, 입체주의의 파피에 콜레에서 시작되어…","subcategory":"미술사조·도상학","level":2,"related":["dada","found-object","assemblage-art"],"prerequisites":["dada","found-object"]},{"slug":"assemblage-art","title_ko":"아상블라주","title_en":"Assemblage","meaning":"폐품, 일상 사물, 발견된 오브제 등 3차원적 재료들을 조합하여 하나의 조각적 구성물로 만드는 미술 기법으로, 콜라주의…","subcategory":"미술사조·도상학","level":2,"related":["collage","found-object","arte-povera","installation-art"],"prerequisites":["found-object","arte-povera","installation-art"]},{"slug":"installation-art","title_ko":"설치미술","title_en":"Installation Art","meaning":"특정 공간 전체를 예술적 매체로 삼아 관람자가 물리적으로 걸어 들어가 경험하도록 구성하는 3차원적 미술 형식으로…","subcategory":"미술사조·도상학","level":1,"related":["arte-povera"],"prerequisites":[],"aliases":["인스톨레이션","설치미술론","Installation Art Theory"]},{"slug":"postminimalism","title_ko":"포스트미니멀리즘","title_en":"Postminimalism","meaning":"1960년대 후반 미니멀리즘의 엄격한 기하학적 형식에 반발하여, 유기적 재료, 중력, 우연성, 신체성을 도입한 조각 및 설치…","subcategory":"미술사조·도상학","level":3,"related":["arte-povera","conceptual-art","installation-art"],"prerequisites":["arte-povera"],"pop":8},{"slug":"orphism","title_ko":"오르피즘","title_en":"Orphism","meaning":"1912년경 로베르 들로네와 소니아 들로네 등이 발전시킨 사조로, 입체주의의 형태 분석에 순색의 대비와 리듬감 있는 원형…","subcategory":"미술사조·도상학","level":3,"related":[],"prerequisites":[],"pop":16},{"slug":"regionalism-art","title_ko":"지역주의 미술","title_en":"American Regionalism","meaning":"1930년대 대공황기 미국에서 등장한 사조로, 유럽의 모더니즘 대신 미국 중서부의 농촌 풍경과 서민 생활을 사실적이고…","subcategory":"미술사조·도상학","level":3,"related":[],"prerequisites":[],"aliases":["지역주의미술"]},{"slug":"icon-painting","title_ko":"이콘화","title_en":"Icon Painting","meaning":"동방 정교회 전통에서 그리스도, 성모, 성인을 나무판에 템페라와 금박으로 그린 성화로, 엄격한 도상학적 규범을 따르며 신앙적…","subcategory":"미술사조·도상학","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["이콘"]},{"slug":"attribution","title_ko":"진위감정","title_en":"Attribution","meaning":"양식적 특징, 재료 분석, 문헌 기록 등을 종합하여 특정 작품을 특정 작가나 공방, 시대에 귀속시키는 미술사적 판별…","subcategory":"미술사조·도상학","level":3,"related":[],"prerequisites":[]},{"slug":"mimesis-art","title_ko":"미메시스(모방)","title_en":"Mimesis","meaning":"고대 그리스 철학에서 유래한 개념으로, 예술이 현실 세계를 모방하고 재현한다는 원리를 가리키며, 서양 미술 이론에서 재현적…","subcategory":"미술사조·도상학","level":3,"related":["conceptual-art","catharsis-drama","structure-of-greek-tragedy"],"prerequisites":[],"aliases":["모방","미메시스이론","Mimesis Theory","모방론","플라톤의 모방론","Plato's Theory of Mimesis","플라톤의모방론","미메시스(모방)"]},{"slug":"gesamtkunstwerk","title_ko":"게잠트쿤스트베르크","title_en":"Gesamtkunstwerk","meaning":"독일어로 '총체예술작품'을 뜻하는 개념으로, 회화·조각·건축·음악 등 여러 예술 장르를 하나의 통일된 작품으로 종합하려는…","subcategory":"미술사조·도상학","level":3,"related":["art-nouveau","installation-art"],"prerequisites":["installation-art"],"pop":9,"aliases":["총체예술"]},{"slug":"informel","title_ko":"앵포르멜","title_en":"Art Informel","meaning":"1940~50년대 프랑스를 중심으로 전개된 사조로, 기하학적 형식과 계획된 구성을