[{"slug":"facade","title_ko":"파사드","title_en":"facade","meaning":"건축물의 외관을 이루는 정면 또는 외피로, 재료·비례·개구부 구성을 통해 건물의 성격과 도시 경관에 영향을 준다.","subcategory":"건축설계이론·건축구조","level":1,"related":[],"prerequisites":[],"pop":14,"aliases":["입면","퍼사드"]},{"slug":"circulation-planning","title_ko":"동선계획","title_en":"circulation planning","meaning":"건축물 내외부에서 사람과 차량, 물류 등이 이동하는 경로를 효율적이고 안전하게 조직하는 계획을 말한다.","subcategory":"건축설계이론·건축구조","level":1,"related":[],"prerequisites":[]},{"slug":"le-corbusier-modulor","title_ko":"르코르뷔지에모듈러","title_en":"Le Corbusier's Modulor","meaning":"건축가 르코르뷔지에가 인체 치수와 황금비를 결합하여 고안한 건축용 비례 척도 체계이다.","subcategory":"건축설계이론·건축구조","level":3,"related":["ergonomics","modular-coordination"],"prerequisites":["modular-coordination"],"pop":16},{"slug":"mass-study","title_ko":"매스스터디","title_en":"mass study","meaning":"건축물의 전체 입체 볼륨(매스)의 형태와 배치를 스터디 모델이나 다이어그램으로 검토하는 설계 초기 작업이다.","subcategory":"건축설계이론·건축구조","level":1,"related":[],"prerequisites":[],"pop":2},{"slug":"sustainable-architecture","title_ko":"지속가능건축","title_en":"sustainable architecture","meaning":"에너지·자원 소비와 환경 부하를 최소화하면서 사회적, 경제적 지속가능성을 함께 고려하는 건축 설계 접근이다.","subcategory":"건축설계이론·건축구조","level":1,"related":[],"prerequisites":[]},{"slug":"adaptive-reuse","title_ko":"적응적재사용","title_en":"adaptive reuse","meaning":"기존 건축물의 구조와 골격을 유지하면서 새로운 용도에 맞게 개조하여 재사용하는 설계 접근이다.","subcategory":"건축설계이론·건축구조","level":1,"related":["renovation"],"prerequisites":[],"aliases":["어댑티브리유즈"]},{"slug":"renovation","title_ko":"리노베이션","title_en":"renovation","meaning":"기존 건축물의 노후 부위를 보수·개선하여 성능과 미관을 향상시키는 공사를 말한다.","subcategory":"건축설계이론·건축구조","level":1,"related":["adaptive-reuse"],"prerequisites":[]},{"slug":"enclosed-space","title_ko":"위요공간","title_en":"enclosed space","meaning":"건물이나 벽체 등으로 둘러싸여 외부와 구분되면서도 완전히 밀폐되지 않은 반개방적 성격의 공간을 말한다.","subcategory":"건축설계이론·건축구조","level":3,"related":[],"prerequisites":[],"pop":4},{"slug":"symmetry-asymmetry","title_ko":"대칭과비대칭","title_en":"symmetry and asymmetry","meaning":"건축 형태나 평면 구성이 축을 기준으로 균형을 이루는 대칭 방식과, 의도적으로 불균형을 활용하는 비대칭 방식을 아우르는 조형…","subcategory":"건축설계이론·건축구조","level":1,"related":[],"prerequisites":[]},{"slug":"modular-coordination","title_ko":"모듈조정","title_en":"modular coordination","meaning":"건축 부재와 공간 치수를 공통 기준 모듈의 배수로 통일하여 설계와 시공의 효율성을 높이는 치수 조정 체계이다.","subcategory":"건축설계이론·건축구조","level":1,"related":[],"prerequisites":[]},{"slug":"zoning","title_ko":"조닝","title_en":"zoning","meaning":"건축 계획에서 기능과 성격이 유사한 공간들을 구역별로 묶어 배치하는 작업, 또는 도시계획에서 토지 용도를 구역별로 규제하는…","subcategory":"건축설계이론·건축구조","level":1,"related":["circulation-planning"],"prerequisites":[],"aliases":["지역지구제"]},{"slug":"bubble-diagram","title_ko":"버블다이어그램","title_en":"bubble diagram","meaning":"공간을 원(버블)으로 표현하고 크기와 연결선을 통해 상대적 규모와 관계를 간략히 나타내는 초기 계획 다이어그램이다.","subcategory":"건축설계이론·건축구조","level":3,"related":["zoning"],"prerequisites":[],"pop":9},{"slug":"brutalism","title_ko":"브루탈리즘","title_en":"brutalism","meaning":"노출 콘크리트 등 재료의 물성을 그대로 드러내고 구조와 설비를 솔직하게 표현하는 20세기 중반의 건축 양식이다.","subcategory":"건축설계이론·건축구조","level":3,"related":[],"prerequisites":[],"pop":13,"aliases":["브루털리즘"]},{"slug":"postmodern-architecture","title_ko":"포스트모더니즘건축","title_en":"postmodern architecture","meaning":"모더니즘의 획일성과 기능주의에 반발하여 역사적 인용, 장식, 상징성, 다원적 표현을 다시 도입한 건축 사조이다.","subcategory":"건축설계이론·건축구조","level":2,"related":["art-deco"],"prerequisites":[]},{"slug":"art-nouveau","title_ko":"아르누보","title_en":"art nouveau","meaning":"식물이나 유기적 곡선 형태를 건축과 장식에 적극 도입한 19세기 말에서 20세기 초의 예술·건축 사조이다.","subcategory":"건축설계이론·건축구조","level":3,"related":["art-deco","facade"],"prerequisites":["facade"],"pop":18},{"slug":"art-deco","title_ko":"아르데코","title_en":"art deco","meaning":"기하학적 패턴, 대칭적 구성, 화려한 장식을 특징으로 하는 1920~30년대의 건축·장식 예술 양식이다.","subcategory":"건축설계이론·건축구조","level":3,"related":["art-nouveau","postmodern-architecture","symmetry-asymmetry"],"prerequisites":["postmodern-architecture","symmetry-asymmetry"]},{"slug":"high-tech-architecture","title_ko":"하이테크건축","title_en":"high-tech architecture","meaning":"구조, 설비, 첨단 기술 요소를 감추지 않고 오히려 건물 외부로 노출하여 미적 표현 수단으로 삼는 건축 사조이다.","subcategory":"건축설계이론·건축구조","level":2,"related":["truss"],"prerequisites":["truss"]},{"slug":"metabolism-movement","title_ko":"메타볼리즘","title_en":"metabolism movement","meaning":"일본에서 시작된 건축 운동으로, 도시와 건축을 유기체처럼 성장·변화·교체가 가능한 시스템으로 보고 캡슐이나 유닛 단위로 증축…","subcategory":"건축설계이론·건축구조","level":3,"related":[],"prerequisites":[]},{"slug":"steel-reinforced-concrete-structure","title_ko":"철골철근콘크리트구조","title_en":"steel reinforced concrete structure","meaning":"철골 뼈대를 철근콘크리트로 감싸 두 구조 형식의 장점을 결합한 합성 구조 형식이다.","subcategory":"건축설계이론·건축구조","level":3,"related":[],"prerequisites":[],"aliases":["SRCS"]},{"slug":"shear-wall","title_ko":"전단벽","title_en":"shear wall","meaning":"면내 방향의 횡력(지진력, 풍하중)에 저항하도록 계획된 철근콘크리트 벽체로, 건물의 횡강성을 확보하는 주요 부재이다.","subcategory":"건축설계이론·건축구조","level":1,"related":["core-wall"],"prerequisites":[],"pop":17},{"slug":"core-wall","title_ko":"코어월","title_en":"core wall","meaning":"엘리베이터, 계단 등 수직 동선 공간을 둘러싸며 건물의 횡력 저항 및 수직하중 지지 역할을 겸하는 벽체 구조이다.","subcategory":"건축설계이론·건축구조","level":1,"related":["shear-wall"],"prerequisites":[]},{"slug":"live-load","title_ko":"활하중","title_en":"live load","meaning":"사람, 가구, 물품 등 건축물 사용 중 시간에 따라 변동될 수 있는 하중을 말한다.","subcategory":"건축설계이론·건축구조","level":3,"related":["wind-load","seismic-load"],"prerequisites":["wind-load","seismic-load"],"pop":11},{"slug":"wind-load","title_ko":"풍하중","title_en":"wind load","meaning":"바람이 건축물에 작용시키는 압력에 의한 하중으로, 건물의 높이와 형태, 지역별 기본 풍속에 따라 산정된다.","subcategory":"건축설계이론·건축구조","level":2,"related":["seismic-load"],"prerequisites":["seismic-load"],"pop":15},{"slug":"seismic-load","title_ko":"지진하중","title_en":"seismic load","meaning":"지진 발생 시 지반 진동에 의해 건축물에 작용하는 관성력으로, 건물의 질량과 동적 특성에 따라 크기가 달라지는 하중이다.","subcategory":"건축설계이론·건축구조","level":1,"related":["seismic-design"],"prerequisites":[]},{"slug":"tensile-force","title_ko":"인장력","title_en":"tensile force","meaning":"부재를 양쪽에서 잡아당겨 늘어나게 하는 방향으로 작용하는 힘을 말한다.","subcategory":"건축설계이론·건축구조","level":1,"related":["shear-force"],"prerequisites":[],"pop":1},{"slug":"shear-force","title_ko":"전단력","title_en":"shear force","meaning":"부재의 단면을 따라 서로 다른 방향으로 미끄러지듯 작용하는 힘으로, 보나 슬래브의 파괴 검토에 중요한 요소이다.","subcategory":"건축설계이론·건축구조","level":2,"related":[],"prerequisites":[],"pop":3},{"slug":"deck-plate","title_ko":"데크플레이트","title_en":"deck plate","meaning":"골 형태로 성형된 강판을 슬래브 거푸집 겸 인장 보강재로 사용하는 합성 바닥 구조 부재이다.","subcategory":"건축설계이론·건축구조","level":3,"related":[],"prerequisites":[],"pop":6},{"slug":"bracing","title_ko":"브레이싱","title_en":"bracing","meaning":"구조체에 대각선 부재를 추가하여 횡하중에 대한 저항성과 강성을 높이는 보강 방식이다.","subcategory":"건축설계이론·건축구조","level":3,"related":["shear-wall"],"prerequisites":["shear-wall"]},{"slug":"pin-joint","title_ko":"핀접합","title_en":"pin joint","meaning":"접합된 부재 간 자유로운 회전이 가능하여 휨모멘트를 전달하지 않고 축력만 전달하는 접합 방식이다.","subcategory":"건축설계이론·건축구조","level":2,"related":["truss","tensile-force"],"prerequisites":["truss","tensile-force"],"pop":5},{"slug":"statically-indeterminate-structure","title_ko":"부정정구조물","title_en":"statically indeterminate structure","meaning":"평형 방정식만으로는 모든 반력과 부재력을 구할 수 없어 부재의 강성과 변형 조건을 함께 고려해야 해석이 가능한 구조물이다.","subcategory":"건축설계이론·건축구조","level":3,"related":[],"prerequisites":[]},{"slug":"thermal-bridge","title_ko":"열교현상","title_en":"thermal bridge","meaning":"단열이 연속되지 않고 국부적으로 취약한 부위를 통해 열이 집중적으로 이동하는 현상으로, 에너지 손실과 결로의 원인이 된다.","subcategory":"건축설계이론·건축구조","level":2,"related":["condensation-building","sustainable-architecture"],"prerequisites":["sustainable-architecture"],"pop":8,"aliases":["히트브리지"]},{"slug":"condensation-building","title_ko":"결로","title_en":"condensation","meaning":"실내외 온도차로 인해 표면온도가 이슬점 이하로 낮아진 부위에 공기 중 수증기가 물방울로 맺히는 현상이다.","subcategory":"건축설계이론·건축구조","level":3,"related":["thermal-bridge"],"prerequisites":["thermal-bridge"],"aliases":["응결"]},{"slug":"five-points-of-architecture","title_ko":"근대건축5원칙","title_en":"five points of architecture","meaning":"건축가 르코르뷔지에가 제시한 근대건축의 다섯 가지 원칙으로, 필로티, 옥상정원, 자유평면, 자유입면, 수평창으로 구성된다.","subcategory":"건축설계이론·건축구조","level":1,"related":[],"prerequisites":[]