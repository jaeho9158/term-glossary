[{"slug":"habitus","title_ko":"아비투스","title_en":"Habitus","meaning":"어린 시절부터 자라온 계급적·문화적 환경을 통해 몸에 배어, 무의식적으로 드러나는 취향·말투·행동 방식의 체계입니다.","subcategory":"인류학·문화","level":2,"related":["social-capital","hegemony"],"prerequisites":[],"pop":1,"aliases":["아비투스 개념"]},{"slug":"hindsight-bias","title_ko":"사후확신편향","title_en":"Hindsight Bias","meaning":"어떤 일이 일어난 후에 처음부터 그럴 줄 알았다고 실제보다 더 확신하게 되는 경향입니다.","subcategory":"인지심리","level":1,"related":["confirmation-bias","cognitive-bias","availability-heuristic","illusory-correlation","contingency"],"prerequisites":[]},{"slug":"iconography","title_ko":"도상학","title_en":"Iconography","meaning":"미술 작품에 등장하는 인물, 상징, 소재의 전통적 의미와 유래를 식별하고 분류하는 미술사 연구 방법으로, 파노프스키의…","subcategory":"미술사조·도상학","level":1,"related":["panofsky-method","iconographic-analysis"],"prerequisites":[],"pop":5,"aliases":["이코노그래피","아이코노그래피"]},{"slug":"sahyo-haeseok","title_ko":"사료해석","title_en":"Source Interpretation","meaning":"비판을 거친 사료의 의미를 맥락 속에서 읽어내어 역사적 사실과 의미를 도출하는 작업.","subcategory":"역사학 방법론·사학사","level":1,"related":[],"prerequisites":[]},{"slug":"gubi-sahyo","title_ko":"구비사료","title_en":"Oral Source","meaning":"문자 기록이 아닌 구전으로 전승되어 온 설화, 노래, 증언 등의 사료.","subcategory":"역사학 방법론·사학사","level":2,"related":[],"prerequisites":[],"aliases":["구술사료"]},{"slug":"marx-yeoksahak","title_ko":"마르크스주의 역사학","title_en":"Marxist Historiography","meaning":"생산양식과 계급투쟁을 역사 변동의 근본 동력으로 보고 이를 중심으로 역사를 분석하는 학문 전통.","subcategory":"역사학 방법론·사학사","level":2,"related":[],"prerequisites":[],"aliases":["마르크스주의역사학"]},{"slug":"banhwasilhwa-yeoksa","title_ko":"반사실적 역사","title_en":"Counterfactual History","meaning":"만약 특정 사건이 다르게 일어났다면 어떻게 되었을지를 가정하여 역사적 인과관계를 검토하는 방법.","subcategory":"역사학 방법론·사학사","level":1,"related":["contingency"],"prerequisites":[],"pop":7,"aliases":["반사실적역사"]},{"slug":"jinbo-sagwan","title_ko":"진보사관","title_en":"Progressive View of History","meaning":"역사가 시간이 흐름에 따라 점차 더 나은 방향으로 발전해 간다고 보는 역사관.","subcategory":"역사학 방법론·사학사","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":