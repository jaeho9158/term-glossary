[{"slug":"fmri","title_ko":"기능적자기공명영상","title_en":"fMRI","meaning":"뇌 혈류 변화를 측정해 활성화된 부위를 영상으로 보여주는 기법입니다.","subcategory":"신경영상·측정기법","level":1,"related":["eeg","amygdala","neuroplasticity","prefrontal-cortex"],"prerequisites":[],"pop":6,"aliases":["기능적 자기공명영상","Functional Magnetic Resonance Imaging"]},{"slug":"deep-brain-stimulation","title_ko":"뇌심부자극술","title_en":"Deep Brain Stimulation","meaning":"뇌 깊은 곳에 가느다란 전극을 심어 전기 자극으로 이상 신경 활동을 조절하는 치료 기법입니다.","subcategory":"신경영상·측정기법","level":2,"related":["substantia-nigra"],"prerequisites":[],"pop":11},{"slug":"viscoelasticity","title_ko":"점탄성","title_en":"Viscoelasticity","meaning":"물질이 순수한 탄성체(에너지를 저장하고 완전히 회복)와 순수한 점성 유체(에너지를 소산)의 성질을 동시에 나타내는 역학적…","subcategory":"역학·에너지","level":3,"related":["gelation"],"prerequisites":[],"pop":2,"aliases":["점탄성거동"]},{"slug":"imrt","title_ko":"세기조절방사선치료","title_en":"Intensity-Modulated Radiation Therapy (IMRT)","meaning":"다엽콜리메이터로 빔 단면 내 선량 세기를 여러 구간으로 조절하여 종양 모양에 맞춘 선량분포를 구현하는 방사선치료 기법.","subcategory":"방사선치료·핵의학","level":1,"related":[],"prerequisites":[],"pop":8,"aliases":["IMRT","Intensity-Modulated Radiotherapy"]},{"slug":"evoked-potential","title_ko":"유발전위","title_en":"Evoked Potential","meaning":"시각·청각·체성감각 등 특정 자극에 반응하여 신경계에서 발생하는 전위 변화를 기록한 신호입니다.","subcategory":"생체신호처리","level":2,"related":[],"prerequisites":[],"aliases":["EP","유발전위검사"]},{"slug":"t2-relaxation-time","title_ko":"T2 이완시간","title_en":"T2 Relaxation Time","meaning":"MRI에서 자화된 수소 원자핵의 횡자화 성분이 주변 스핀 간 상호작용으로 인해 시간에 따라 점차 소실되는 정도를 나타내는…","subcategory":"의료영상","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["T2이완시간"]},{"slug":"b-mode-ultrasound-imaging","title_ko":"B모드 초음파영상","title_en":"B-Mode Ultrasound Imaging","meaning":"초음파 반사 신호의 세기를 밝기(brightness) 값으로 변환하여 인체 단면을 2차원 회색조 영상으로 표시하는 초음파…","subcategory":"의료영상","level":2,"related":["t2-relaxation-time"],"prerequisites":[],"pop":14,"aliases":["BMUI","B모드초음파영상"]},{"slug":"hydrogel-biomaterial","title_ko":"하이드로겔","title_en":"Hydrogel","meaning":"물을 많이 머금을 수 있는 그물 구조의 고분자 소재로, 부드럽고 유연한 성질 덕분에 다양한 생체재료 및 의료용 소재로…","subcategory":"생체재료","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["수화젤"]},{"slug":"osmotic-drug-delivery-pump","title_ko":"삼투압 약물전달펌프","title_en":"Osmotic Drug Delivery Pump","meaning":"삼투압 차이를 이용해 외부 동력 없이 약물을 일정한 속도로 밀어내 방출하는 약물전달 장치입니다.","subcategory":"약물전달","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["ODDP","삼투압약물전달펌프"]},{"slug":"contrast-enhanced-imaging","title_ko":"조영증강영상","title_en":"Contrast-Enhanced Imaging","meaning":"조영제를 체내에 투여하여 혈관이나 특정 조직과 주변 조직 간의 신호 차이를 키워 영상의 구조적 구분을 뚜렷하게 만드는…","subcategory":"의료영상","level":2,"related":["fmri"],"prerequisites":[],"pop":5,"aliases":["Contrast-Enhanced Imaging"]},{"slug":"dicom-image-standard","title_ko":"DICOM 영상표준","title_en":"DICOM Image Standard","meaning":"의료영상과 관련 환자 정보를 저장, 전송, 표시하기 위한 국제 표준 형식과 통신 프로토콜입니다.","subcategory":"임상공학 및 의료정보","level":3,"related":[],"prerequisites":[],"pop":9,"aliases":["DICOM영상표준"]},{"slug":"fiducial-registration-error","title_ko":"기준표지 정합오차","title_en":"Fiducial Registration Error","meaning":"수술 항법에서 영상 좌표와 환자 좌표를 맞춘 뒤, 정합에 사용한 기준표지들이 서로 얼마나 어긋나 있는지를 나타내는 잔차입니다.","subcategory":"의료로봇공학","level":2,"related":[],"prerequisites":[],"pop":7,"aliases":["FRE","기준점 정합오차"]}]