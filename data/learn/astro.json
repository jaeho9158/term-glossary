[{"slug":"red-giant","title_ko":"적색거성","title_en":"Red Giant","meaning":"중심핵의 수소가 고갈된 후 헬륨핵 주변 껍질에서 수소 껍질 연소가 일어나면서 외피가 크게 팽창하고 표면 온도가 낮아져 붉게…","subcategory":"항성·은하천문학","level":3,"related":[],"prerequisites":[],"pop":1},{"slug":"accretion-disk","title_ko":"강착원반","title_en":"Accretion Disk","meaning":"블랙홀, 중성자별, 백색왜성 등 중력이 강한 천체 주위로 물질이 각운동량을 유지하며 나선형으로 떨어져 들어가면서 형성하는…","subcategory":"항성·은하천문학","level":1,"related":[],"prerequisites":[],"pop":2},{"slug":"spectroscopic-parallax","title_ko":"분광시차법","title_en":"Spectroscopic Parallax","meaning":"항성의 스펙트럼형과 광도계급을 분석해 절대등급을 추정한 뒤, 관측된 겉보기등급과 비교하여 거리를 산출하는 간접적 거리 측정…","subcategory":"항성·은하천문학","level":2,"related":[],"prerequisites":[],"pop":5},{"slug":"galactic-halo","title_ko":"은하헤일로","title_en":"Galactic Halo","meaning":"은하원반을 둘러싸며 구상성단, 늙은 별, 그리고 대부분 눈에 보이지 않는 암흑물질로 이루어진 거대하고 구형에 가까운 영역.","subcategory":"항성·은하천문학","level":1,"related":[],"prerequisites":[],"pop":13},{"slug":"spiral-arm","title_ko":"나선팔","title_en":"Spiral Arm","meaning":"나선은하의 원반에서 별과 성간물질의 밀도가 상대적으로 높게 나타나는 나선 모양의 구조로, 젊고 밝은 별과 별 형성 영역이…","subcategory":"항성·은하천문학","level":2,"related":[],"prerequisites":[],"pop":8},{"slug":"zero-age-main-sequence","title_ko":"영년주계열","title_en":"Zero-Age Main Sequence","meaning":"원시별이 중심핵에서 안정적인 수소 핵융합을 막 시작한 시점의 위치를 HR도 상에 나타낸 것으로, 주계열 진화의 출발점에…","subcategory":"항성·은하천문학","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["ZAMS"]},{"slug":"critical-density","title_ko":"임계밀도","title_en":"Critical Density","meaning":"우주가 평탄한 기하학적 구조를 갖기 위해 필요한 물질-에너지 밀도의 특정 값으로, 실제 밀도와 임계밀도의 비(오메가)에 따라…","subcategory":"우주론·천체물리 관측기법","level":2,"related":["flatness-problem"],"prerequisites":["flatness-problem"],"pop":6},{"slug":"flatness-problem","title_ko":"평탄성문제","title_en":"Flatness Problem","meaning":"표준 빅뱅 모형에서는 초기 우주의 밀도가 임계밀도에서 극도로 정밀하게 미세조정되어야만 오늘날 관측되는 거의 평탄한 우주가…","subcategory":"우주론·천체물리 관측기법","level":1,"related":["critical-density"],"prerequisites":[]},{"slug":"monopole-problem","title_ko":"자기단극자문제","title_en":"Magnetic Monopole Problem","meaning":"대통일이론(GUT)에 따르면 초기 우주의 상전이 과정에서 매우 무거운 자기단극자가 대량으로 생성되어야 하지만, 실제로는 전혀…","subcategory":"우주론·천체물리 관측기법","level":3,"related":["flatness-problem"],"prerequisites":["flatness-problem"],"aliases":["단극자문제"]},{"slug":"stefan-boltzmann-law","title_ko":"스테판-볼츠만법칙","title_en":"Stefan-Boltzmann Law","meaning":"흑체가 단위 표면적당 방출하는 총 복사에너지가 절대온도의 네제곱에 비례한다는 법칙으로, 별의 광도와 반지름, 온도 사이의…","subcategory":"우주론·천체물리 관측기법","level":3,"related":["blackbody-radiation"],"prerequisites":[],"pop":11,"aliases":["스테판 볼츠만법칙","스테판볼츠만법칙"]},{"slug":"solar-nebula-hypothesis","title_ko":"태양성운가설","title_en":"Solar Nebula Hypothesis","meaning":"태양계가 회전하는 거대한 가스·먼지 구름(태양성운)이 자체 중력으로 수축하면서 중심에는 태양이, 주변 원반에는 행성들이…","subcategory":"태양계천문학·관측장비","level":3,"related":["planetary-differentiation"],"prerequisites":["planetary-differentiation"],"aliases":["SNH"]},{"slug":"planetary-differentiation","title_ko":"행성분화","title_en":"Planetary Differentiation","meaning":"형성 초기 행성 내부가 충돌열과 방사성 붕괴열로 녹으면서 밀도 차이에 따라 무거운 물질은 핵으로, 가벼운 물질은 지각으로…","subcategory":"태양계천문학·관측장비","level":1,"related":["meteorite"],"prerequisites":[]},{"slug":"roche-limit","title_ko":"로슈한계","title_en":"Roche Limit","meaning":"위성이 모행성에 너무 가까이 접근하면 모행성의 조석력이 위성 자체의 중력을 넘어서 위성이 부서지게 되는 임계 거리.","subcategory":"태양계천문학·관측장비","level":3,"related":["planetary-differentiation"],"prerequisites":[],"pop":9,"aliases":["로시한계"]},{"slug":"synodic-period","title_ko":"회합주기","title_en":"Synodic Period","meaning":"지구와 같은 관측자 기준 천체에서 볼 때, 다른 천체가 태양이나 지구에 대해 같은 배치(예: 합, 충)로 돌아오는 데 걸리는…","subcategory":"태양계천문학·관측장비","level":3,"related":["sidereal-month"],"prerequisites":["sidereal-month"]},{"slug":"trojan-asteroid","title_ko":"트로이소행성","title_en":"Trojan Asteroid","meaning":"특정 행성과 태양이 이루는 라그랑주점 L4 또는 L5 부근에 모여, 그 행성과 거의 같은 공전주기로 태양을 도는 소행성 무리.","subcategory":"태양계천문학·관측장비","level":1,"related":[],"prerequisites":[]},{"slug":"dwarf-planet","title_ko":"왜소행성","title_en":"Dwarf Planet","meaning":"태양을 공전하고 자체 중력으로 구형을 유지할 만큼 크지만, 궤도 주변의 다른 천체를 중력으로 쓸어내지 못한 천체로…","subcategory":"태양계천문학·관측장비","level":1,"related":["kuiper-belt"],"prerequisites":[],"pop":4},{"slug":"meteoroid","title_ko":"유성체","title_en":"Meteoroid","meaning":"우주 공간을 떠도는 모래알에서 바위 크기 정도의 작은 고체 잔해로, 소행성이나 혜성에서 떨어져 나온 파편인 경우가 많다.","subcategory":"태양계천문학·관측장비","level":3,"related":["meteorite"],"prerequisites":["meteorite"]},{"slug":"meteorite","title_ko":"운석","title_en":"Meteorite","meaning":"유성체가 대기를 통과하며 완전히 타 없어지지 않고 지표면까지 도달한 고체 잔해.","subcategory":"태양계천문학·관측장비","level":2,"related":["meteoroid","planetary-differentiation"],"prerequisites":["planetary-differentiation"]},{"slug":"kuiper-belt","title_ko":"카이퍼벨트","title_en":"Kuiper Belt","meaning":"해왕성 궤도 바깥, 태양으로부터 약 30~50천문단위 거리에 얼음과 암석으로 이루어진 소천체들이 원반 모양으로 밀집한 영역.","subcategory":"태양계천문학·관측장비","level":1,"related":["oort-cloud"],"prerequisites":[],"pop":7,"aliases":["카이퍼대"]},{"slug":"oort-cloud","title_ko":"오르트구름","title_en":"Oort Cloud","meaning":"태양계 가장 바깥쪽, 대략 수천에서 수만 천문단위 거리에 구형으로 분포한다고 추정되는 얼음 천체들의 거대한 껍질로, 장주기…","subcategory":"태양계천문학·관측장비","level":2,"related":["kuiper-belt"],"prerequisites":["kuiper-belt"],"pop":12},{"slug":"comet-coma","title_ko":"혜성코마","title_en":"Comet Coma","meaning":"혜성이 태양에 가까워지면서 핵 표면의 얼음이 승화해 방출된 가스와 먼지가 핵 주위를 감싸며 형성하는 흐릿하고 확산된 대기.","subcategory":"태양계천문학·관측장비","level":1,"related":[],"prerequisites":[]},{"slug":"lunar-phase","title_ko":"달의위상","title_en":"Lunar Phase","meaning":"지구에서 볼 때 태양빛을 받은 달의 밝은 면이 지구-달-태양의 상대적 위치에 따라 초승달, 상현달, 보름달 등으로 주기적으로…","subcategory":"태양계천문학·관측장비","level":1,"related":["sidereal-month"],"prerequisites":[],"aliases":["달의 위상 변화","Moon Phases","달의 위상","달의위상변화"]},{"slug":"sidereal-month","title_ko":"항성월","title_en":"Sidereal Month","meaning":"먼 별을 기준으로 달이 지구를 한 바퀴 완전히 공전하는 데 걸리는 시간으로, 평균 약 27.3일이다.","subcategory":"태양계천문학·관측장비","level":1,"related":["lunar-phase"],"prerequisites":[],"pop":14},{"slug":"saros-cycle","title_ko":"사로스주기","title_en":"Saros Cycle","meaning":"태양, 지구, 달의 상대적 배치가 거의 동일하게 반복되어 유사한 일식·월식이 재현되는 약 18년 11일의 주기.","subcategory":"태양계천문학·관측장비","level":1,"related":[],"prerequisites":[],"pop":10}]