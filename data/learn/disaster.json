[{"slug":"fmea","title_ko":"고장모드영향분석","title_en":"FMEA","meaning":"제품이나 공정에서 일어날 수 있는 모든 고장 방식을 미리 나열하고, 그 심각도·발생빈도·검출난이도를 점수화해 가장 시급히…","subcategory":"산업·시스템","level":1,"related":["root-cause-analysis"],"prerequisites":[],"pop":1,"aliases":["고장모드 및 영향분석","DFMEA","Disaster Failure Mode and Effects Analysis"]},{"slug":"root-cause-analysis","title_ko":"근본원인분석","title_en":"Root Cause Analysis","meaning":"문제나 사고가 일어났을 때 겉으로 드러난 증상이 아니라, 그 문제를 실제로 일으킨 근본 원인을 끝까지 추적해 찾아내는 분석…","subcategory":"산업·시스템","level":1,"related":["fmea"],"prerequisites":[],"pop":2,"aliases":["원인분석","5Why 분석","DRCA","Disaster Root Cause Analysis"]},{"slug":"mitigation","title_ko":"완화","title_en":"Mitigation","meaning":"재난 발생 가능성을 낮추거나 발생했을 때의 피해 규모를 줄이기 위해 사전에 취하는 장기적 조치를 말합니다.","subcategory":"재난 예방·완화","level":2,"related":[],"prerequisites":[],"pop":9},{"slug":"special-disaster-zone","title_ko":"특별재난지역","title_en":"Special Disaster Zone","meaning":"특별재난지역은 피해가 극심하여 지방자치단체의 자체 능력만으로 수습이 어렵다고 판단될 때 국가가 행정적·재정적 지원을 집중하기…","subcategory":"재난 거버넌스·법제·국제협력","level":2,"related":[],"prerequisites":[],"aliases":["SDZ"]},{"slug":"digital-twin-disaster-management","title_ko":"디지털트윈 기반 재난관리","title_en":"Digital Twin for Disaster Management","meaning":"실제 도시나 시설물을 컴퓨터 안에 가상으로 똑같이 구현한 디지털트윈을 활용해 재난 상황을 시뮬레이션하고 대응 전략을 미리…","subcategory":"재난정보시스템·공간정보","level":2,"related":[],"prerequisites":[],"aliases":["DTDM","디지털트윈기반재난관리"]},{"slug":"scenario-based-risk-analysis","title_ko":"시나리오기반 위험분석","title_en":"Scenario Based Risk Analysis","meaning":"발생 가능한 여러 재난 상황을 구체적인 시나리오로 설정하고, 각 시나리오별 진행 과정과 결과를 분석하여 위험을 평가하는…","subcategory":"위험성 평가·분석","level":2,"related":[],"prerequisites":[],"aliases":["SBRA","시나리오기반위험분석"]},{"slug":"cyberterrorism","title_ko":"사이버테러","title_en":"Cyberterrorism","meaning":"정치적·사회적 목적을 달성하기 위해 컴퓨터 시스템과 네트워크를 공격하여 공포심을 유발하거나 국가 기반시설의 기능을 마비시키는…","subcategory":"인위·사회재난","level":2,"related":[],"prerequisites":[]},{"slug":"lightning-strike-disaster","title_ko":"낙뢰피해","title_en":"Lightning Strike Disaster","meaning":"뇌운에서 발생한 전기 방전이 지표면이나 구조물, 사람에게 떨어지면서 인명·재산 피해를 일으키는 기상재해를 말합니다.","subcategory":"자연재해","level":2,"related":[],"prerequisites":[]},{"slug":"international-disaster-response-law","title_ko":"국제재난대응법","title_en":"International Disaster Response Law","meaning":"대규모 재난 발생 시 국경을 넘는 인도적 지원과 구호 활동의 절차, 권리, 책임을 규율하는 국제법 및 관련 규범 체계를…","subcategory":"재난 거버넌스·법제·국제협력","level":2,"related":["subsidiarity-principle-disaster"],"prerequisites":[],"aliases":["IDRL"]},{"slug":"subsidiarity-principle-disaster","title_ko":"재난 보충성의 원칙","title_en":"Disaster Subsidiarity Principle","meaning":"재난 대응은 가장 가까운 하위 단위(기초지자체·지역사회)가 우선적으로 담당하고, 그 역량을 넘어서는 경우에만 상위…","subcategory":"재난 거버넌스·법제·국제협력","level":2,"related":["international-disaster-response-law"],"prerequisites":[]},{"slug":"cross-border-disaster-cooperation","title_ko":"국경간 재난협력","title_en":"Cross-Border Disaster Cooperation","meaning":"인접 국가들이 재난 예방, 정보 공유, 구호 자원 이동 등에서 국경을 넘어 협력하는 활동 전반을 말합니다.","subcategory":"재난 거버넌스·법제·국제협력","level":2,"related":["ifrc-disaster-response"],"prerequisites":[],"aliases":["국경간재난협력"]},{"slug":"ifrc-disaster-response","title_ko":"국제적십자연맹 재난대응","title_en":"IFRC Disaster Response","meaning":"국제적십자사연맹(IFRC)이 각국 적십자·적신월사 네트워크를 통해 재난 발생 지역에 인도적 구호를 제공하는 활동 체계를…","subcategory":"재난 거버넌스·법제·국제협력","level":2,"related":["cross-border-disaster-cooperation"],"prerequisites":[],"pop":3,"aliases":["국제적십자연맹재난대응"]},{"slug":"disaster-recovery-framework","title_ko":"재난복구프레임워크","title_en":"Disaster Recovery Framework","meaning":"재난 이후 복구 활동의 목표, 원칙, 역할과 절차를 체계적으로 정리한 정책적, 계획적 틀입니다.","subcategory":"재난 복구","level":2,"related":[],"prerequisites":[]},{"slug":"disaster-subculture","title_ko":"재난하위문화","title_en":"Disaster Subculture","meaning":"반복적인 재난 경험을 통해 특정 지역사회에서 자연스럽게 형성된, 재난에 대비하고 대응하는 고유한 지식과 관습, 행동 양식을…","subcategory":"재난심리·사회적 영향","level":2,"related":[],"prerequisites":[]},{"slug":"transformative-capacity-disaster","title_ko":"변혁적역량","title_en":"Disaster Transformative Capacity","meaning":"기존의 구조나 체계로는 반복되는 재난