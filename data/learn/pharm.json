[{"slug":"drug-interaction","title_ko":"약물상호작용","title_en":"Drug Interaction","meaning":"두 가지 이상의 약물을 함께 사용했을 때 각 약물의 효과나 부작용이 예상과 다르게 커지거나 작아지는 현상입니다.","subcategory":"치료·약리","level":1,"related":["clinical-trial","biomarker","neurotransmitter"],"prerequisites":[],"pop":19,"aliases":["약물 상호작용","DDI","Drug-Drug Interaction"]},{"slug":"solubility","title_ko":"용해도","title_en":"Solubility","meaning":"일정한 온도에서 일정량의 용매(보통 물 100g)에 최대로 녹을 수 있는 용질의 g수를 말하며, 온도에 따라 그 값이…","subcategory":"화학반응·물질구조","level":1,"related":["molar-concentration","surfactant-excipient"],"prerequisites":[],"aliases":["drug solubility"]},{"slug":"tablet","title_ko":"정제","title_en":"tablet","meaning":"약물과 부형제를 압축하여 일정한 모양과 크기로 만든 고형 경구제제입니다.","subcategory":"제제학·의약품화학","level":1,"related":["film-coated-tablet"],"prerequisites":[],"pop":10},{"slug":"oral-dosage-form","title_ko":"경구용제제","title_en":"oral dosage form","meaning":"입으로 복용하여 소화관을 통해 흡수되도록 만든 의약품 제형을 통틀어 이르는 말입니다.","subcategory":"제제학·의약품화학","level":2,"related":["tablet","first-pass-effect"],"prerequisites":["tablet","first-pass-effect"],"pop":8,"aliases":["ODF"]},{"slug":"film-coated-tablet","title_ko":"필름코팅정","title_en":"film-coated tablet","meaning":"얇은 고분자 필름막을 입혀 맛을 가리고 외관과 안정성을 개선한 정제입니다.","subcategory":"제제학·의약품화학","level":1,"related":["tablet"],"prerequisites":[]},{"slug":"effervescent-tablet","title_ko":"발포정","title_en":"effervescent tablet","meaning":"물에 넣으면 탄산가스를 발생시키며 빠르게 붕해·용해되는 정제입니다.","subcategory":"제제학·의약품화학","level":3,"related":["tablet","disintegration-test","chewable-tablet"],"prerequisites":["tablet","disintegration-test","chewable-tablet"],"pop":15},{"slug":"chewable-tablet","title_ko":"저작정","title_en":"chewable tablet","meaning":"씹어서 삼키도록 만들어 붕해제가 적거나 없어도 되는 정제입니다.","subcategory":"제제학·의약품화학","level":2,"related":["tablet","effervescent-tablet"],"prerequisites":["tablet"],"pop":20},{"slug":"suspension-formulation","title_ko":"현탁제","title_en":"suspension formulation","meaning":"물에 녹지 않는 약물 입자를 액체 속에 고르게 분산시켜 만든 제제입니다.","subcategory":"제제학·의약품화학","level":2,"related":["surfactant-excipient","solubility"],"prerequisites":["surfactant-excipient"]},{"slug":"targeted-drug-delivery-system","title_ko":"표적지향형약물전달시스템","title_en":"targeted drug delivery system","meaning":"약물을 원하는 조직이나 세포에 선택적으로 전달하여 정상 조직 노출을 줄이도록 설계한 전달 시스템입니다.","subcategory":"제제학·의약품화학","level":3,"related":["prodrug"],"prerequisites":[],"aliases":["TDDS"]},{"slug":"lubricant-excipient","title_ko":"활택제","title_en":"lubricant","meaning":"타정 과정에서 분말과 금형 표면 사이의 마찰을 줄여 정제가 매끄럽게 배출되도록 돕는 부형제입니다.","subcategory":"제제학·의약품화학","level":3,"related":[],"prerequisites":[],"pop":6,"aliases":["윤활제"]},{"slug":"surfactant-excipient","title_ko":"계면활성제","title_en":"Surfactant","meaning":"물과 기름처럼 성질이 다른 두 물질의 경계면 장력을 낮춰 서로 잘 섞이거나 퍼지게 돕는 부형제입니다.","subcategory":"제제학·의약품화학","level":1,"related":["solubility","surface-tension","colloid","adsorption"],"prerequisites":[],"pop":17},{"slug":"buffering-agent","title_ko":"완충제","title_en":"buffering agent","meaning":"제제의 pH를 일정하게 유지시켜 약물의 안정성과 체내 적합성을 확보하는 부형제입니다.","subcategory":"제제학·의약품화학","level":2,"related":[],"prerequisites":[],"pop":2},{"slug":"chelating-agent","title_ko":"킬레이트제","title_en":"chelating agent","meaning":"미량의 금속 이온을 붙잡아 불활성화함으로써 산화 반응 등을 억제하는 부형제입니다.","subcategory":"제제학·의약품화학","level":3,"related":[],"prerequisites":[],"pop":14},{"slug":"wet-granulation","title_ko":"습식과립법","title_en":"wet granulation","meaning":"결합액을 분말에 가해 습윤 덩어리를 만든 뒤 건조·정립하여 과립을 제조하는 방법입니다.","subcategory":"제제학·의약품화학","level":1,"related":["tablet"],"prerequisites":[],"pop":12},{"slug":"disintegration-test","title_ko":"붕해시험","title_en":"disintegration test","meaning":"정제나 캡슐이 정해진 조건의 액체 속에서 완전히 부서져 작은 입자로 흩어지는 데 걸리는 시간을 측정하는 시험입니다.","subcategory":"제제학·의약품화학","level":1,"related":["tablet"],"prerequisites":[],"pop":4},{"slug":"friability-test","title_ko":"마손도시험","title_en":"friability test","meaning":"정제를 일정하게 굴리고 부딪히게 하여 표면 마모나 파손으로 인한 무게 감소율을 측정하는 시험입니다.","subcategory":"제제학·의약품화학","level":3,"related":["tablet","film-coated-tablet"],"prerequisites":["tablet"],"pop":7},{"slug":"shelf-life","title_ko":"유효기간","title_en":"shelf life","meaning":"정해진 보관 조건에서 제제가 규정된 품질 기준을 만족하며 사용할 수 있는 기간입니다.","subcategory":"제제학·의약품화학","level":1,"related":[],"prerequisites":[],"pop":5,"aliases":["사용기한"]},{"slug":"first-pass-effect","title_ko":"초회통과효과","title_en":"first-pass effect","meaning":"경구 투여된 약물이 소화관에서 흡수된 뒤 전신 순환에 도달하기 전 간에서 대사되어 활성 약물의 양이 줄어드는 현상입니다.","subcategory":"제제학·의약품화학","level":1,"related":["cytochrome-p450"],"prerequisites":[],"pop":1,"aliases":["간초회통과"]},{"slug":"amorphous-form","title_ko":"무정형","title_en":"amorphous form","meaning":"분자가 규칙적인 결정 격자를 이루지 않고 무질서하게 배열된 고체 상태입니다.","subcategory":"제제학·의약품화학","level":1,"related":["solubility"],"prerequisites":[],"aliases":["비결정형"]},{"slug":"tapped-density","title_ko":"탭밀도","title_en":"tapped density","meaning":"분말이 담긴 용기를 일정 횟수 두드려 입자 사이의 빈 공간을 최소화한 뒤 측정한 밀도입니다.","subcategory":"제제학·의약품화학","level":3,"related":[],"prerequisites":[]},{"slug":"eutectic-mixture","title_ko":"공융혼합물","title_en":"eutectic mixture","meaning":"두 가지 이상의 물질이 특정 비율로 섞였을 때 각 성분의 녹는점보다 더 낮은 온도에서 함께 녹는 혼합물입니다.","subcategory":"제제학·의약품화학","level":3,"related":["solubility"],"prerequisites":[],"pop":3},{"slug":"crystal-habit","title_ko":"결정습성","title_en":"crystal habit","meaning":"결정 내부의 분자 배열(결정형)은 같더라도 결정이 성장하며 겉으로 드러나는 외형적 모양입니다.","subcategory":"제제학·의약품화학","level":3,"related":[],"prerequisites":[],"pop":16},{"slug":"lipinski-rule-of-five","title_ko":"리핀스키의5원칙","title_en":"Lipinski's rule of five","meaning":"경구 흡수가 잘 되는 화합물이 대체로 만족하는 네 가지 물리화학적 기준을 정리한 경험 법칙입니다.","subcategory":"제제학·의약품화학","level":3,"related":[],"prerequisites":[],"pop":9,"aliases":["리핀스키규칙"]},{"slug":"high-throughput-screening","title_ko":"고속대량스크리닝","title_en":"high-throughput screening (HTS)","meaning":"자동화 로봇 장비를 이용해 수만에서 수백만 개의 화합물을 짧은 시간 안에 검사해 활성 화합물을 찾아내는 기법입니다.","subcategory":"제제학·의약품화학","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["HTS","High-Throughput Screening"]},{"slug":"medication-history-taking","title_ko":"약력조사","title_en":"Medication History Taking","meaning":"환자가 현재 복용 중이거나 과거에 복용했던 처방약, 일반의약품, 건강기능식품 등을 체계적으로 파악하는 과정이다.","subcategory":"임상약학·약사법규","level":2,"related":[],"prerequisites":[]},{"slug":"potentially-inappropriate-medication","title_ko":"잠재적부적절약물","title_en":"Potentially Inappropriate Medication","meaning":"특정 환자군, 특히 노인에서 위험이 이익을 초과할 가능성이 높아 처방을 피하거나 신중히 고려해야 하는 약물이다.","subcategory":"임상약학·약사법규","level":2,"related":[],"prerequisites":[],"aliases":["노인주의의약품"]},{"slug":"trough-concentration","title_ko":"최저혈중농도","title_en":"Trough Concentration","meaning":"다음 투여 직전, 즉 한 투여 간격 내에서 약물의 혈장 농도가 가장 낮아지는 시점의 농도이다.","subcategory":"임상약학·약사법규","level":2,"related":[],"prerequisites":[],"aliases":["Cmin"]},{"slug":"generic-drug","title_ko":"제네릭의약품","title_en":"Generic Drug","meaning":"특허가 만료된 오리지널의약품과 동일한 유효성분·함량·투여경로를 가지며 생물학적동등성을 입증한 후발 의약품이다.","subcategory":"임상약학·약사법규","level":2,"related":[],"prerequisites":[],"aliases":["복제약","후발의약품"]},{"slug":"prescription-audit","title_ko":"처방감사","title_en":"Prescription Audit","meaning":"약사가 처방전의 적정성, 용법·용량, 상호작용, 중복 여부 등을 조제 전에 점검하는 임상적 검토 절차이다.","subcategory":"임상약학·약사법규","level":1,"related":[],"prerequisites":[]},{"slug":"outpatient-prescription","title_ko":"원외처방","title_en":"Outpatient Prescription","meaning":"의료기관이 환자를 진료한 후 처방전을 발행하여 병원 밖의 약국에서 조제하도록 하는 처방 방식이다.","subcategory":"임상약학·약사법규","level":1,"related":[],"prerequisites":[],"pop":13},{"slug":"pharmacy-inventory-management","title_ko":"약품재고관리","title_en":"Pharmacy Inventory Management","meaning":"약국이나 병원 약제부에서 의약품의 입고, 보관, 사용, 폐기 현황을 체계적으로 관리하여 재고 부족이나 과잉을 방지하는…","subcategory":"임상약학·약사법규","level":1,"related":[],"prerequisites":[]},{"slug":"drug-price-ceiling-system","title_ko":"약가상한제","title_en":"Drug Price Ceiling System","meaning":"건강보험이 인정하는 의약품 가격의 상한선을 설정하여 그 이상으로 청구할 수 없도록 제한하는 제도이다.","subcategory":"임상약학·약사법규","level":2,"related":["generic-drug"],"prerequisites":[],"pop":18},{"slug":"light-protected-medication","title_ko":"차광보관의약품","title_en":"Light-Protected Medication","meaning":"빛에 노출되면 성분이 분해되거나 변질되어 효능이 저하될 수 있어 차광 용기나 포장으로 보관해야 하는 의약품이다.","subcategory":"임상약학·약사법규","level":3,"related":[],"prerequisites":[]}]