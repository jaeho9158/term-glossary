[{"slug":"mixed-cropping","title_ko":"혼작","title_en":"Mixed Cropping","meaning":"같은 포장에 이랑 구분 없이 두 가지 이상의 작물 종자를 섞어 뿌리거나 섞어 심어 함께 재배하는 방식이다.","subcategory":"작물학·토양비료학","level":3,"related":["nitrogen-fixation"],"prerequisites":[]},{"slug":"seedling-raising","title_ko":"육묘","title_en":"Seedling Raising","meaning":"본포에 이식하기 전까지 묘를 일정 기간 육묘상이나 육묘상자에서 기르는 재배 과정으로, 활착률 향상과 생육기간 단축을 목적으로…","subcategory":"작물학·토양비료학","level":1,"related":[],"prerequisites":[]},{"slug":"disbudding","title_ko":"적아","title_en":"Disbudding","meaning":"불필요한 곁눈(측아)이나 꽃눈을 초기에 제거하여 남은 눈이나 가지에 양분이 집중되도록 하는 재배관리 작업이다.","subcategory":"작물학·토양비료학","level":2,"related":["apical-dominance"],"prerequisites":["apical-dominance"],"pop":18},{"slug":"interrow-cultivation","title_ko":"중경","title_en":"Interrow Cultivation","meaning":"작물이 자라는 중에 이랑 사이나 포기 사이의 토양 표면을 얕게 갈아 부수는 작업으로, 잡초 방제와 토양 통기성 개선을…","subcategory":"작물학·토양비료학","level":2,"related":["soil-porosity"],"prerequisites":["soil-porosity"]},{"slug":"drying","title_ko":"건조","title_en":"Drying","meaning":"수확한 작물의 수분 함량을 저장에 적합한 수준까지 낮추는 조제 과정으로, 곰팡이 발생과 품질 저하를 방지하기 위해 이루어진다.","subcategory":"작물학·토양비료학","level":1,"related":[],"prerequisites":[]},{"slug":"pre-germination","title_ko":"최아","title_en":"Pre-germination (Chitting)","meaning":"파종 전에 종자를 미리 물에 침지·보온하여 인위적으로 싹을 틔우는 처리로, 발아를 균일하게 하고 발아 소요일수를 단축하기…","subcategory":"작물학·토양비료학","level":2,"related":[],"prerequisites":[],"aliases":["Chitting"]},{"slug":"apical-dominance","title_ko":"정단우세","title_en":"Apical Dominance","meaning":"줄기 끝의 정아(정단분열조직)에서 생성되는 옥신 등이 곁눈(측아)의 생장을 억제하여 줄기가 곁가지보다 우선적으로 신장하는…","subcategory":"작물학·토양비료학","level":1,"related":[],"prerequisites":[],"pop":5},{"slug":"soil-porosity","title_ko":"토양공극률","title_en":"Soil Porosity","meaning":"토양 전체 부피 중 고체 입자를 제외한 공극(빈 공간)이 차지하는 비율로, 이 공극에 물과 공기가 채워져 뿌리의 수분·산소…","subcategory":"작물학·토양비료학","level":1,"related":[],"prerequisites":[],"pop":3},{"slug":"nitrification","title_ko":"질산화작용","title_en":"Nitrification","meaning":"토양 중 암모늄태 질소가 아질산균과 질산균 등 호기성 세균에 의해 아질산을 거쳐 질산태 질소로 산화되는 미생물학적 작용이다.","subcategory":"작물학·토양비료학","level":2,"related":["denitrification","mineralization"],"prerequisites":[],"pop":6},{"slug":"denitrification","title_ko":"탈질작용","title_en":"Denitrification","meaning":"혐기성 조건에서 토양미생물이 질산태 질소를 질소가스(N2)나 아산화질소 등으로 환원시켜 대기 중으로 방출하는 작용으로, 담수…","subcategory":"작물학·토양비료학","level":2,"related":["nitrification"],"prerequisites":[]},{"slug":"mineralization","title_ko":"무기화작용","title_en":"Mineralization","meaning":"토양미생물이 유기물 중의 유기태 질소, 인 등을 분해하여 암모늄이나 인산이온과 같은 무기 형태로 전환시켜 식물이 흡수할 수…","subcategory":"작물학·토양비료학","level":2,"related":[],"prerequisites":[],"pop":2},{"slug":"quick-release-fertilizer","title_ko":"속효성비료","title_en":"Quick-Release Fertilizer","meaning":"시용 후 물에 쉽게 녹아 단시간 내에 작물이 흡수할 수 있는 형태로 양분을 공급하는 비료로, 요소·유안 등 대부분의 일반…","subcategory":"작물학·토양비료학","level":3,"related":[],"prerequisites":[],"pop":14},{"slug":"soil-dressing","title_ko":"객토","title_en":"Soil Dressing","meaning":"지력이 낮거나 물리성이 불량한 토양에 다른 곳에서 채취한 양질의 흙을 넣어 토양의 성질을 개선하는 토양개량 방법이다.","subcategory":"작물학·토양비료학","level":3,"related":[],"prerequisites":[],"pop":1},{"slug":"drought-injury","title_ko":"한해","title_en":"Drought Injury","meaning":"토양수분 부족으로 작물이 정상적인 생리작용을 하지 못하고 생육이 저해되거나 고사하는 피해로, 관개시설이 부족한 밭작물에서…","subcategory":"작물학·토양비료학","level":1,"related":[],"prerequisites":[],"pop":20},{"slug":"soil-treading","title_ko":"답압","title_en":"Soil Treading (Rolling)","meaning":"보리 등 맥류의 생육 초기에 사람이나 롤러로 지표면을 눌러 밟아주는 재배관리 작업으로, 서릿발 피해 방지와 분얼 촉진 효과가…","subcategory":"작물학·토양비료학","level":3,"related":[],"prerequisites":[],"pop":8},{"slug":"lodging-resistance","title_ko":"내도복성","title_en":"Lodging Resistance","meaning":"작물이 강풍이나 강우 등의 외력에도 줄기가 쓰러지지 않고 버틸 수 있는 능력으로, 줄기의 굵기·강도와 초장 등에 의해…","subcategory":"작물학·토양비료학","level":2,"related":[],"prerequisites":[],"pop":10},{"slug":"root-hair","title_ko":"근모","title_en":"Root Hair","meaning":"뿌리 표피세포가 실 모양으로 길게 자란 구조로, 뿌리의 표면적을 크게 늘려 수분과 양분의 흡수 효율을 높이는 역할을 한다.","subcategory":"작물학·토양비료학","level":3,"related":[],"prerequisites":[]