[{"slug":"broken-windows-theory","title_ko":"깨진 유리창 이론","title_en":"Broken Windows Theory","meaning":"사소한 무질서나 훼손을 방치하면 더 큰 범죄로 이어질 수 있다고 설명하는 범죄학 이론입니다.","subcategory":"사회학·사회구조","level":1,"related":["anomie","relative-deprivation-household","urbanization"],"prerequisites":[],"pop":4,"aliases":["깨진유리창이론","Broken Window Theory","깨진유리창이론 (Broken Windows Theory","Policing)","깨진유리창이론(BrokenWindowsTheory","Broken Windows Theory (Policing)"]},{"slug":"differential-association-theory","title_ko":"차별접촉이론","title_en":"Differential Association Theory","meaning":"범죄와 일탈 행동은 타고나는 것이 아니라 그것을 긍정적으로 여기는 사람들과의 친밀한 상호작용을 통해 학습된다는 이론입니다.","subcategory":"사회학·사회구조","level":1,"related":["labeling-theory","anomie","socialization","conflict-theory"],"prerequisites":[],"pop":7},{"slug":"addiction","title_ko":"중독","title_en":"Addiction","meaning":"해로운 결과를 알면서도 마약·알코올 같은 물질이나 도박·게임 같은 행동을 스스로 조절하지 못하고 반복하는 상태입니다.","subcategory":"성격·임상심리","level":1,"related":[],"prerequisites":[],"aliases":["addiction","의존증"]},{"slug":"left-realism","title_ko":"좌파 현실주의","title_en":"Left Realism","meaning":"범죄의 구조적 원인을 인정하면서도 서민층 피해자가 실제로 겪는 범죄 피해의 현실을 진지하게 다뤄야 한다고 주장하는 비판범죄학…","subcategory":"비판범죄학","level":2,"related":["routine-activity-theory"],"prerequisites":[],"aliases":["좌파현실주의"]},{"slug":"routine-activity-theory","title_ko":"일상활동이론","title_en":"Routine Activity Theory","meaning":"범행 동기를 가진 가해자, 적절한 대상, 보호력의 부재라는 세 가지 요소가 시간과 공간에서 동시에 만날 때 범죄가 발생한다고…","subcategory":"환경범죄학","level":2,"related":["left-realism"],"prerequisites":[],"pop":1},{"slug":"crime-pattern-theory","title_ko":"범죄패턴이론","title_en":"Crime Pattern Theory","meaning":"사람들의 일상적 이동 경로(집, 직장, 여가 공간과 그 사이 경로)가 범죄가 발생하는 지점을 결정한다고 설명하는 환경범죄학의…","subcategory":"환경범죄학","level":2,"related":["situational-crime-prevention","defensible-space"],"prerequisites":[],"pop":8},{"slug":"situational-crime-prevention","title_ko":"상황적 범죄예방","title_en":"Situational Crime Prevention","meaning":"범죄자의 심리를 바꾸기보다 범죄 발생 상황과 환경을 조정하여 범죄의 실행 기회와 이익을 줄이는 예방 전략입니다.","subcat