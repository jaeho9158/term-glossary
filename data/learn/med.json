[{"slug":"neurotransmitter","title_ko":"신경전달물질","title_en":"Neurotransmitter","meaning":"시냅스에서 신경세포 간 신호를 전달하는 화학물질입니다.","subcategory":"신경세포·전달물질","level":1,"related":["synapse","neuroplasticity","amygdala","action-potential","blood-brain-barrier"],"prerequisites":[]},{"slug":"biomarker","title_ko":"생체지표","title_en":"Biomarker","meaning":"질병 상태나 신체 반응을 객관적으로 나타내는 측정 가능한 지표입니다.","subcategory":"진단·검사","level":1,"related":["clinical-trial","sensitivity-specificity"],"prerequisites":[],"pop":3,"aliases":["바이오마커"]},{"slug":"clinical-trial","title_ko":"임상시험","title_en":"Clinical Trial","meaning":"새로운 치료법이나 약물의 효과와 안전성을 사람 대상으로 검증하는 연구입니다.","subcategory":"치료·약리","level":1,"related":["double-blind","biomarker","sensitivity-specificity"],"prerequisites":[]},{"slug":"double-blind","title_ko":"이중맹검","title_en":"Double-blind","meaning":"연구자와 참가자 모두 누가 실제 치료를 받는지 모르게 하는 임상시험 설계입니다.","subcategory":"치료·약리","level":1,"related":["clinical-trial"],"prerequisites":[],"aliases":["이중눈가림"]},{"slug":"sensitivity-specificity","title_ko":"민감도와 특이도","title_en":"Sensitivity and Specificity","meaning":"진단 검사가 실제 병이 있는 사람을 얼마나 잘 찾아내는지(민감도)와, 병이 없는 사람을 얼마나 정확히 걸러내는지(특이도)를…","subcategory":"진단·검사","level":1,"related":["biomarker","clinical-trial","odds-ratio","elisa","positive-predictive-value","confidence-interval"],"prerequisites":[],"aliases":["민감도 특이도"]},{"slug":"adverse-event","title_ko":"이상반응","title_en":"adverse event","meaning":"임상시험이나 치료 중 환자에게 나타나는, 치료와의 인과관계가 확정되지 않은 모든 바람직하지 않은 의학적 사건입니다.","subcategory":"치료·약리","level":1,"related":[],"prerequisites":[],"aliases":["AE"]},{"slug":"medication-adherence","title_ko":"복약순응도","title_en":"Medication Adherence","meaning":"환자가 처방받은 대로 약을, 정해진 용량과 시간에 맞춰 얼마나 잘 지켜서 복용하는지를 나타내는 정도입니다.","subcategory":"치료·약리","level":1,"related":["hazard-ratio"],"prerequisites":[],"aliases":["약물순응도","복약순응"]},{"slug":"surrogate-endpoint","title_ko":"대리결과지표","title_en":"Surrogate Endpoint","meaning":"측정하기 어렵거나 오래 걸리는 진짜 결과 대신, 그것과 관련이 있어서 더 빠르고 쉽게 측정할 수 있는 대체 지표입니다.","subcategory":"치료·약리","level":2,"related":["confounding-variable"],"prerequisites":[],"aliases":["대리평가변수"]},{"slug":"non-inferiority-trial","title_ko":"비열등성시험","title_en":"Non-inferiority Trial","meaning":"새 치료법이 기존 치료법보다 \"더 낫다\"가 아니라 \"크게 뒤떨어지지 않는다\"는 것만 증명하면 되는 임상시험 설계입니다.","subcategory":"치료·약리","level":2,"related":[],"prerequisites":[],"aliases":["비열등성 임상시험"]},{"slug":"drug-interaction","title_ko":"약물상호작용","title_en":"Drug Interaction","meaning":"두 가지 이상의 약물을 함께 사용했을 때 각 약물의 효과나 부작용이 예상과 다르게 커지거나 작아지는 현상입니다.","subcategory":"치료·약리","level":1,"related":["clinical-trial","biomarker","neurotransmitter"],"prerequisites":[],"aliases":["약물 상호작용","DDI","Drug-Drug Interaction"]},{"slug":"palliative-care","title_ko":"완화의료","title_en":"Palliative Care","meaning":"질병을 완치하는 것이 아니라 통증과 증상을 줄여 환자의 삶의 질을 높이는 데 초점을 맞춘 의료입니다.","subcategory":"치료·약리","level":1,"related":["quality-adjusted-life-year"],"prerequisites":[],"aliases":["완화치료","고통완화의료","완화돌봄"]},{"slug":"likelihood-ratio","title_ko":"우도비","title_en":"Likelihood Ratio","meaning":"어떤 검사 결과가 나왔을 때, 그 결과가 병이 있는 사람에게서 나올 확률이 병이 없는 사람에게서 나올 확률보다 몇 배 더…","subcategory":"진단·검사","level":2,"related":["sensitivity-specificity","odds-ratio","roc-curve"],"prerequisites":[],"aliases":["LR"]},{"slug":"consort-statement","title_ko":"콘소트 성명","title_en":"CONSORT Statement","meaning":"무작위대조시험 논문이 연구 과정을 빠짐없이 투명하게 보고하도록 만든 표준 체크리스트입니다.","subcategory":"출판·저작권","level":2,"related":["randomized-controlled-trial"],"prerequisites":[],"aliases":["CONSORT","Consolidated Standards of Reporting Trials","콘소트 지침","콘소트성명"]},{"slug":"data-safety-monitoring-board","title_ko":"자료안전성 모니터링 위원회","title_en":"Data Safety Monitoring Board","meaning":"임상시험이 진행되는 동안 참가자의 안전과 중간 결과를 연구팀과 독립적으로 검토해, 시험을 계속할지 중단할지를 권고하는 전문가…","subcategory":"임상·인간대상연구윤리","level":3,"related":["consort-statement"],"prerequisites":[],"aliases":["DSMB","데이터모니터링위원회","Data Monitoring Committee","자료안전성모니터링위원회"]},{"slug":"hpa-axis","title_ko":"시상하부-뇌하수체-부신 축","title_en":"HPA Axis","meaning":"스트레스를 감지해 코르티솔 같은 스트레스 호르몬 분비로 이어지는, 시상하부-뇌하수체-부신 사이의 신경내분비 신호 경로입니다.","subcategory":"뇌구조·기능","level":2,"related":["hypothalamus","amygdala","limbic-system"],"prerequisites":[],"pop":14,"aliases":["시상하부-뇌하수체-부신축","HPA축","시상하부 뇌하수체 부신 축","시상하부뇌하수체부신 축"]},{"slug":"epileptic-seizure","title_ko":"뇌전증 발작","title_en":"Epileptic Seizure","meaning":"대뇌의 많은 뉴런이 비정상적으로 과도하고 동시에 흥분하면서 발생하는 일시적인 전기적 발작 현상입니다.","subcategory":"신경질환","level":1,"related":["excitatory-inhibitory-balance","eeg","action-potential"],"prerequisites":[],"aliases":["뇌전증발작","간질 발작"]},{"slug":"differential-diagnosis","title_ko":"감별진단","title_en":"Differential Diagnosis","meaning":"환자의 증상을 설명할 수 있는 여러 질환 후보를 나열한 뒤, 병력과 검사 결과로 하나씩 배제해 가며 최종 진단을 좁혀가는…","subcategory":"진단·검사","level":1,"related":["likelihood-ratio","sensitivity-specificity"],"prerequisites":[],"aliases":["DDx"]},{"slug":"iatrogenic","title_ko":"의인성","title_en":"Iatrogenic","meaning":"질병 자체가 아니라 의료진의 진단, 치료, 처치 과정에서 새로 발생한 문제를 가리키는 말입니다.","subcategory":"질병·병리","level":1,"related":["drug-interaction"],"prerequisites":[],"aliases":["의인성 질환","iatrogenesis","의원성"]},{"slug":"loading-dose","title_ko":"부하용량","title_en":"Loading Dose","meaning":"몸속 약물 농도를 목표치까지 빨리 끌어올리기 위해 치료 초반에 한 번(또는 며칠간) 평소보다 많이 투여하는 용량입니다.","subcategory":"치료·약리","level":1,"related":[],"prerequisites":[],"aliases":["초기부하용량","loading dose"]},{"slug":"kaplan-meier-estimator","title_ko":"카플란-마이어 추정법","title_en":"Kaplan-Meier Estimator","meaning":"관찰이 도중에 중단된 대상자가 있어도 시간에 따른 생존확률을 계단 모양의 그래프로 추정하는 비모수적 통계 방법입니다.","subcategory":"다변량·고급기법","level":2,"related":["cox-proportional-hazards-model","confidence-interval"],"prerequisites":[],"aliases":["카플란-마이어 생존곡선","생존곡선 추정법","KM곡선","카플란마이어"]},{"slug":"macchiarini-scandal","title_ko":"마키아리니 사건","title_en":"Macchiarini Scandal","meaning":"스웨덴 카롤린스카 연구소의 외과의사 파올로 마키아리니가 인공 기관 이식 수술의 성공률을 부풀리고 다수의 환자를 사망에 이르게…","subcategory":"임상·인간대상연구윤리","level":2,"related":[],"prerequisites":[],"aliases":["마키아리니사건"]},{"slug":"drug-delivery-system","title_ko":"약물전달시스템","title_en":"Drug Delivery System","meaning":"약물이 필요한 시점에, 필요한 부위에, 필요한 양만큼 전달되도록 설계하는 공학적 기술입니다.","subcategory":"화학·에너지공학","level":2,"related":[],"prerequisites":[],"aliases":["DDS"]},{"slug":"magnetic-resonance-imaging","title_ko":"자기공명영상","title_en":"Magnetic Resonance Imaging","meaning":"강한 자기장과 전파를 이용해 몸속 수소 원자핵의 신호를 측정함으로써 뼈가 아닌 근육·뇌·장기 등 연부조직의 단면 영상을…","subcategory":"실험기기·측정장비","level":1,"related":["fmri"],"prerequisites":[],"aliases":["MRI"]},{"slug":"spirometry","title_ko":"폐활량검사","title_en":"Spirometry","meaning":"숨을 최대한 들이마신 뒤 세게 내쉬는 공기의 양과 속도를 측정해 폐 기능을 평가하는 검사입니다.","subcategory":"실험기기·측정장비","level":2,"related":[],"prerequisites":[],"aliases":["스파이로메트리","폐기능검사"]},{"slug":"neuropathic-pain","title_ko":"신경병증성 통증","title_en":"Neuropathic Pain","meaning":"신경병증성 통증은 말초 또는 중추 신경계 자체의 손상이나 기능 이상으로 발생하는 만성 통증으로, 실제 조직 손상 없이도…","subcategory":"신경질환","level":2,"related":["excitotoxicity"],"prerequisites":[],"aliases":["neuropathic pain","중추 감작","신경병증성통증"]},{"slug":"bipolar-disorder","title_ko":"양극성장애","title_en":"Bipolar Disorder","meaning":"기분이 비정상적으로 들뜨는 조증(또는 경조증) 상태와 깊은 우울 상태가 번갈아 나타나는, 뇌의 기분 조절 회로 이상과 관련된…","subcategory":"신경질환","level":1,"related":["prefrontal-cortex","schizophrenia"],"prerequisites":[],"aliases":["조울증","Manic Depression"]},{"slug":"gut-brain-axis","title_ko":"장-뇌 축","title_en":"Gut-Brain Axis","meaning":"장내미생물, 장 신경계, 미주신경, 면역·호르몬 경로를 통해 소화관과 뇌가 양방향으로 정보를 주고받는 상호작용 체계입니다.","subcategory":"뇌구조·기능","level":2,"related":["hpa-axis","hippocampus","autonomic-nervous-system"],"prerequisites":["hpa-axis","hippocampus","autonomic-nervous-system"],"aliases":["장뇌축","Microbiota-Gut-Brain Axis","GBA","장 뇌 축","장-뇌축","장뇌 축"]},{"slug":"bioelectrical-impedance-analysis","title_ko":"생체전기임피던스분석","title_en":"Bioelectrical Impedance Analysis","meaning":"몸에 아주 약한 전류를 흘려보낸 뒤 조직마다 전류가 통과하는 정도(저항)가 다른 성질을 이용해, 체지방과 근육량 등 체성분을…","subcategory":"진단·검사","level":3,"related":["spirometry"],"prerequisites":[],"aliases":["체성분분석","BIA"]},{"slug":"anorexia-nervosa","title_ko":"신경성 식욕부진증","title_en":"Anorexia Nervosa","meaning":"체중이 늘어나는 것에 대한 극심한 두려움 때문에 스스로 음식을 극단적으로 제한하여 저체중 상태를 유지하는 섭식장애입니다.","subcategory":"성격·임상심리","level":1,"related":["self-esteem","cognitive-behavioral-therapy","differential-diagnosis"],"prerequisites":["self-esteem","cognitive-behavioral-therapy"],"aliases":["거식증","신경성식욕부진증"]},{"slug":"ischemic-stroke","title_ko":"허혈성 뇌졸중","title_en":"Ischemic Stroke","meaning":"뇌혈관이 혈전 등으로 막혀 해당 부위 뇌조직에 혈류 공급이 끊기면서 신경세포가 산소와 포도당 부족으로 손상되는…","subcategory":"신경질환","level":1,"related":["excitotoxicity","blood-brain-barrier","microglia"],"prerequisites":[],"aliases":["허혈성뇌졸중"]},{"slug":"social-anxiety-disorder","title_ko":"사회불안장애","title_en":"Social Anxiety Disorder","meaning":"타인에게 부정적으로 평가받는 것에 대한 극심하고 지속적인 두려움 때문에 사회적 상황을 회피하게 되는 불안장애입니다.","subcategory":"성격·임상심리","level":1,"related":["panic-disorder","cognitive-behavioral-therapy"],"prerequisites":["panic-disorder"],"aliases":["사회공포증"]},{"slug":"multimorbidity","title_ko":"다중이환","title_en":"Multimorbidity","meaning":"한 사람에게 두 가지 이상의 만성질환이 함께 존재하되, 그중 어느 하나를 \"주된 질환\"으로 특별히 지목하지 않고 전체를…","subcategory":"질병·병리","level":1,"related":[],"prerequisites":[]},{"slug":"frailty-index","title_ko":"노쇠지수","title_en":"Frailty Index","meaning":"질병, 신체 기능 저하, 인지 문제 등 수십 가지 건강 \"결손\" 항목 중 환자가 가진 항목의 비율을 계산해 노쇠 정도를…","subcategory":"진단·검사","level":2,"related":["multimorbidity","clinical-frailty-scale"],"prerequisites":[],"pop":15,"aliases":["결손누적지수","프레일티인덱스","허약지수"]},{"slug":"triage","title_ko":"중증도 분류","title_en":"Triage","meaning":"한정된 의료 자원 속에서 어떤 환자를 먼저 치료할지 위급한 정도에 따라 순서를 정하는 절차입니다.","subcategory":"진단·검사","level":1,"related":[],"prerequisites":[],"aliases":["중증도분류"]},{"slug":"metabolic-syndrome","title_ko":"대사증후군","title_en":"Metabolic Syndrome","meaning":"복부비만, 높은 혈압, 높은 혈당, 이상지질혈증 중 세 가지 이상이 한 사람에게 동시에 나타나는 상태를 말합니다.","subcategory":"질병·병리","level":1,"related":["biomarker"],"prerequisites":[],"aliases":["대사성증후군","인슐린저항성증후군"]},{"slug":"off-label-use","title_ko":"허가 외 사용","title_en":"Off-label Use","meaning":"식약처 등 규제기관이 승인한 질환·용법·용량·연령이 아닌 다른 목적으로 의약품을 처방하는 것을 말합니다.","subcategory":"치료·약리","level":1,"related":[],"prerequisites":[],"aliases":["OLU","허가외사용"]},{"slug":"biopsy","title_ko":"생검","title_en":"Biopsy","meaning":"몸의 일부 조직이나 세포를 직접 떼어내어 현미경 등으로 검사하는 진단 방법입니다.","subcategory":"진단·검사","level":1,"related":["magnetic-resonance-imaging","differential-diagnosis"],"prerequisites":["differential-diagnosis"],"aliases":["조직검사"]},{"slug":"glasgow-coma-scale","title_ko":"글래스고 혼수 척도","title_en":"Glasgow Coma Scale","meaning":"눈뜨기, 언어 반응, 운동 반응 세 영역을 각각 점수화해 환자의 의식 수준을 3점에서 15점 사이의 숫자로 표현하는 임상…","subcategory":"설문·척도","level":2,"related":["eeg","biomarker"],"prerequisites":[],"pop":9,"aliases":["글래스고혼수척도"]},{"slug":"hypertension","title_ko":"고혈압","title_en":"Hypertension","meaning":"혈관 벽에 가해지는 혈액의 압력이 지속적으로 정상 범위보다 높은 상태를 말합니다.","subcategory":"질병·병리","level":1,"related":["metabolic-syndrome","ischemic-stroke"],"prerequisites":[]},{"slug":"mini-mental-state-examination","title_ko":"간이정신상태검사","title_en":"Mini-Mental State Examination","meaning":"지남력, 기억력, 주의집중력, 언어능력 등을 짧은 질문과 과제로 확인해 인지기능 저하 여부를 30점 만점으로 선별하는…","subcategory":"설문·척도","level":2,"related":["norm-referenced-test","ceiling-effect"],"prerequisites":["norm-referenced-test","ceiling-effect"]},{"slug":"chronic-traumatic-encephalopathy","title_ko":"만성외상성뇌병증","title_en":"Chronic Traumatic Encephalopathy","meaning":"머리에 약한 충격을 오랜 기간 반복적으로 받으면서 서서히 진행되는 퇴행성 뇌질환으로, 기억력 저하와 성격 변화 등을…","subcategory":"신경질환","level":3,"related":[],"prerequisites":[]},{"slug":"gas-exchange","title_ko":"가스교환","title_en":"Gas Exchange","meaning":"허파꽈리(폐포)와 그 주변 모세혈관 사이에서 산소는 혈액으로, 이산화탄소는 폐로 서로 반대 방향으로 이동해 맞바뀌는…","subcategory":"해부·생리","level":1,"related":["ph-acid-base","homeostasis"],"prerequisites":[]},{"slug":"body-mass-index","title_ko":"체질량지수","title_en":"Body Mass Index","meaning":"몸무게(kg)를 키(m)의 제곱으로 나눈 값으로, 신체 크기 대비 비만도를 간단히 가늠하는 데 널리 쓰이는 지표입니다.","subcategory":"진단·검사","level":1,"related":["metabolic-syndrome","biomarker"],"prerequisites":["biomarker"],"aliases":["BMI"]},{"slug":"antigen-antibody","title_ko":"항원과 항체","title_en":"Antigen-Antibody","meaning":"항원은 우리 몸이 \"이물질\"로 인식하는 물질이고, 항체는 그 항원을 표적으로 삼아 면역계가 만들어내는 방어 단백질입니다.","subcategory":"해부·생리","level":1,"related":["active-passive-immunity","elisa"],"prerequisites":[],"pop":7,"aliases":["항원과항체"]},{"slug":"active-passive-immunity","title_ko":"능동면역과 수동면역","title_en":"Active vs Passive Immunity","meaning":"능동면역은 내 몸이 직접 항체를 만들어 얻는 면역이고, 수동면역은 남이 만든 항체를 그대로 받아서 얻는 면역입니다.","subcategory":"해부·생리","level":1,"related":["antigen-antibody"],"prerequisites":[],"aliases":["AVPI","능동면역과수동면역"]},{"slug":"leukocyte-phagocytosis","title_ko":"백혈구의 식균작용","title_en":"Phagocytosis","meaning":"백혈구(특히 대식세포와 호중구)가 몸에 침입한 세균 등의 병원체를 세포 안으로 둘러싸 삼킨 뒤 분해해서 없애는 작용입니다.","subcategory":"해부·생리","level":1,"related":["homeostasis","oxygen-dissociation-curve"],"prerequisites":[],"aliases":["백혈구의식균작용"]},{"slug":"oxygen-dissociation-curve","title_ko":"산소해리곡선","title_en":"Oxygen-Hemoglobin Dissociation Curve","meaning":"혈액 속 산소의 농도(분압)가 변할 때 헤모글로빈이 산소와 결합하는 비율이 어떻게 달라지는지를 S자 모양의 곡선으로 나타낸…","subcategory":"해부·생리","level":2,"related":["leukocyte-phagocytosis","homeostasis"],"prerequisites":["leukocyte-phagocytosis"],"aliases":["OHDC"]},{"slug":"cardiac-conduction-system","title_ko":"심장의 전기전도계통","title_en":"Cardiac Conduction System","meaning":"동방결절에서 시작된 전기 신호가 방실결절을 거쳐 심장 근육 전체로 순서대로 퍼지면서 심장이 규칙적으로 뛰게 만드는 심장 속…","subcategory":"해부·생리","level":2,"related":["autonomic-nervous-system","homeostasis","biomarker"],"prerequisites":[],"aliases":["심장의전기전도계통"]},{"slug":"muscle-fiber-types","title_ko":"근섬유의 유형","title_en":"Muscle Fiber Types","meaning":"근육을 이루는 섬유를 수축 속도와 지구력에 따라 나눈 분류로, 쉽게 지치지 않는 지근섬유(1형)와 빠르고 강하지만 쉽게…","subcategory":"해부·생리","level":1,"related":["skeletal-system","cardiac-conduction-system","homeostasis"],"prerequisites":[],"aliases":["근섬유의유형"]},{"slug":"vaccine-types","title_ko":"백신의 종류","title_en":"Types of Vaccines","meaning":"병원체를 약화시켜 만든 생백신, 죽이거나 비활성화한 사백신, 유전정보만 전달하는 mRNA백신처럼 제조 방식에 따라 나뉘는…","subcategory":"치료·약리","level":1,"related":[],"prerequisites":[],"aliases":["백신의종류"]},{"slug":"nsaid-mechanism","title_ko":"소염진통제(NSAID)의 작용기전","title_en":"Mechanism of NSAIDs","meaning":"NSAID가 사이클로옥시게나제(COX) 효소를 억제해, 염증과 통증을 유발하는 프로스타글란딘의 생성을 줄여주는 작용…","subcategory":"치료·약리","level":1,"related":["adverse-event"],"prerequisites":["adverse-event"],"pop":5,"aliases":["NSAID","소염진통제(NSAID)의작용기전","소염진통제의 작용기전","소염진통제의작용기전"]},{"slug":"antihistamine-mechanism","title_ko":"항히스타민제의 작용원리","title_en":"Mechanism of Antihistamines","meaning":"알레르기 반응을 일으키는 히스타민이 수용체에 결합하지 못하도록 자리를 대신 차지해, 콧물·가려움 같은 증상을 줄여주는 작용…","subcategory":"치료·약리","level":1,"related":[],"prerequisites":[],"aliases":["항히스타민제의작용원리"]},{"slug":"stratified-randomization","title_ko":"층화무작위배정","title_en":"Stratified Randomization","meaning":"결과에 큰 영향을 줄 만한 특성(성별, 나이대 등)별로 참가자를 먼저 나눈 뒤, 그 안에서 각각 무작위로 배정하는 방법입니다.","subcategory":"연구설계","level":3,"related":["confounding-variable"],"prerequisites":[]},{"slug":"pressure-injury","title_ko":"욕창","title_en":"Pressure Injury","meaning":"같은 자세로 오래 누워 있거나 앉아 있을 때 피부와 그 아래 조직이 지속적인 압력을 받아 혈액 공급이 막히면서 손상되는…","subcategory":"질병·병리","level":1,"related":[],"prerequisites":[]},{"slug":"dsm-5","title_ko":"DSM-5 (정신질환 진단 및 통계 편람)","title_en":"DSM-5","meaning":"미국정신의학회가 만든, 정신질환을 진단할 때 기준으로 삼는 공식 분류 체계이자 매뉴얼입니다.","subcategory":"진단·검사","level":1,"related":["schizophrenia","bipolar-disorder"],"prerequisites":[],"aliases":["DSM 5","DSM 5 (정신질환 진단 및 통계 편람)","DSM-5(정신질환진단및통계편람)","DSM5","DSM5 (정신질환 진단 및 통계 편람)","정신질환 진단 및 통계 편람"]},{"slug":"basal-metabolic-rate","title_ko":"기초대사량","title_en":"Basal Metabolic Rate","meaning":"아무 활동도 하지 않고 완전히 안정된 상태에서 생명을 유지하는 데만 필요한 최소한의 에너지 소비량입니다.","subcategory":"해부·생리","level":1,"related":["metabolic-syndrome"],"prerequisites":[],"aliases":["BMR","기초대사율"]},{"slug":"ultracentrifugation","title_ko":"초원심분리법","title_en":"Ultracentrifugation","meaning":"분당 수만~수십만 회전이라는 극히 빠른 속도로 시료를 회전시켜 단백질, 바이러스, 세포 소기관처럼 아주 작고 가벼운 입자까지…","subcategory":"실험기기·측정장비","level":3,"related":["centrifuge","electrophoresis"],"prerequisites":["centrifuge"]},{"slug":"phq-9","title_ko":"환자건강설문지-9","title_en":"PHQ-9","meaning":"최근 2주간의 우울 증상을 9개 문항으로 간단히 점수화해 스스로 응답하는 우울증 선별검사입니다.","subcategory":"진단·검사","level":2,"related":["likert-scale","reliability","construct-validity","sensitivity-specificity"],"prerequisites":["sensitivity-specificity"],"aliases":["환자건강질문지"]},{"slug":"diffuse-axonal-injury","title_ko":"미만성 축삭손상","title_en":"Diffuse Axonal Injury","meaning":"교통사고 등에서 머리가 급격히 흔들리거나 회전할 때 뇌 전체에 걸쳐 신경세포의 축삭이 광범위하게 늘어나고 끊어지는 외상성…","subcategory":"신경질환","level":3,"related":["neuroplasticity","excitotoxicity","cognitive-reserve","ischemic-stroke"],"prerequisites":["excitotoxicity","ischemic-stroke"],"pop":13,"aliases":["미만성축삭손상"]},{"slug":"copd-staging","title_ko":"만성폐쇄성폐질환 GOLD 병기분류 (COPD Staging)","title_en":"COPD Staging","meaning":"폐활량검사로 측정한 1초간 강제호기량(FEV1)이 예측치 대비 얼마나 줄었는지에 따라 만성폐쇄성폐질환(COPD)의 중증도를…","subcategory":"진단·검사","level":2,"related":["spirometry","obstructive-sleep-apnea","hypertension"],"prerequisites":[],"aliases":["만성폐쇄성폐질환 GOLD 병기분류","만성폐쇄성폐질환GOLD병기분류","만성폐쇄성폐질환GOLD병기분류(COPDStaging)"]},{"slug":"obstructive-sleep-apnea","title_ko":"폐쇄성 수면무호흡증 (Obstructive Sleep Apnea)","title_en":"Obstructive Sleep Apnea","meaning":"잠자는 동안 목 안쪽 기도가 반복적으로 좁아지거나 막혀 호흡이 멈추거나 얕아지는 수면장애로, 시간당 발생…","subcategory":"질병·병리","level":1,"related":["body-mass-index","hypertension"],"prerequisites":["hypertension"],"aliases":["폐쇄성 수면무호흡증","폐쇄성수면무호흡증","폐쇄성수면무호흡증(ObstructiveSleepApnea)"]},{"slug":"pittsburgh-sleep-quality-index","title_ko":"피츠버그 수면의 질 지수 (Pittsburgh Sleep Quality Index)","title_en":"Pittsburgh Sleep Quality Index","meaning":"지난 한 달간의 수면의 질과 수면 습관을 7개 영역에 걸쳐 스스로 응답하게 하여 하나의 점수로 종합하는 대표적인 자기보고식…","subcategory":"설문·척도","level":2,"related":["likert-scale","social-desirability-bias"],"prerequisites":[],"pop":1,"aliases":["PSQI","피츠버그 수면의 질 지수","피츠버그수면의질지수","피츠버그수면의질지수(PittsburghSleepQualityIndex)"]},{"slug":"montreal-cognitive-assessment","title_ko":"몬트리올 인지평가","title_en":"Montreal Cognitive Assessment","meaning":"기억력, 주의력, 언어능력 등 여러 인지 영역을 10분 안에 검사해 경도인지장애를 조기에 선별하는 30점 만점의 종이…","subcategory":"설문·척도","level":2,"related":["mini-mental-state-examination","glasgow-coma-scale"],"prerequisites":["mini-mental-state-examination","glasgow-coma-scale"],"aliases":["MoCA","모카검사"]},{"slug":"atrial-fibrillation","title_ko":"심방세동","title_en":"Atrial Fibrillation","meaning":"심장 윗부분(심방)이 규칙적으로 뛰지 못하고 아주 빠르고 불규칙하게 떨리는 부정맥입니다.","subcategory":"질병·병리","level":1,"related":["ischemic-stroke","cardiac-conduction-system"],"prerequisites":[],"aliases":["AF","심방잔떨림"]},{"slug":"electrolyte-imbalance","title_ko":"전해질 불균형","title_en":"Electrolyte Imbalance","meaning":"나트륨·칼륨·칼슘 등 체액 속 전해질 농도가 정상 범위를 벗어나 심장·신경·근육 기능에 이상을 일으킬 수 있는 상태입니다.","subcategory":"질병·병리","level":1,"related":[],"prerequisites":[],"aliases":["전해질불균형"]},{"slug":"wallerian-degeneration","title_ko":"왈러 변성","title_en":"Wallerian Degeneration","meaning":"손상된 축삭에서 세포체로부터 먼 쪽 부분이 시간이 지나며 스스로 분해되어 사라지는 신경 퇴행 과정입니다.","subcategory":"신경질환","level":3,"related":["axon"],"prerequisites":[],"pop":17,"aliases":["왈러변성"]},{"slug":"asthma","title_ko":"천식","title_en":"Asthma","meaning":"기도가 만성적으로 예민해지고 좁아져 숨참, 기침, 쌕쌕거림이 반복되는 만성 호흡기질환입니다.","subcategory":"질병·병리","level":1,"related":["spirometry","copd-staging"],"prerequisites":[],"aliases":["기관지천식"]},{"slug":"cytokine","title_ko":"사이토카인","title_en":"cytokine","meaning":"세포가 분비해 다른 세포에 신호를 전달하는 작은 단백질로, 면역 반응과 염증 조절에 핵심적인 역할을 합니다.","subcategory":"실험기기·측정장비","level":1,"related":["microglia"],"prerequisites":[]},{"slug":"collagen","title_ko":"콜라겐","title_en":"collagen","meaning":"세 가닥이 꼬인 삼중나선 구조를 특징으로 하는, 인체에서 가장 많은 단백질로 피부와 결합조직에 구조적 지지와 탄력을…","subcategory":"세포·분자생물학","level":1,"related":[],"prerequisites":[]},{"slug":"sf-36-health-survey","title_ko":"SF-36 건강설문조사","title_en":"SF-36 Health Survey","meaning":"신체적, 정신적 건강 상태를 8개 영역에 걸쳐 측정하는 36개 문항으로 구성된 대표적인 건강 관련 삶의 질 표준화 설문지.","subcategory":"진단·검사","level":2,"related":["quality-adjusted-life-year"],"prerequisites":[],"aliases":["SF 36 건강설문조사","SF-36건강설문조사","SF36 건강설문조사"]},{"slug":"contrast-enhanced-ct","title_ko":"조영증강 CT","title_en":"Contrast-Enhanced CT","meaning":"요오드 조영제를 정맥에 주입한 뒤 촬영하여 혈관과 장기의 경계를 더 선명하게 보이도록 하는 CT 검사.","subcategory":"진단·검사","level":1,"related":["dual-energy-ct","coronary-angiography","cardiac-catheterization"],"prerequisites":[],"aliases":["조영증강CT"]},{"slug":"high-resolution-ct","title_ko":"고해상도 CT","title_en":"High-Resolution CT (HRCT)","meaning":"얇은 절편 두께와 고해상도 재구성 기법을 사용해 폐 실질 등 미세 구조를 세밀하게 보여주는 CT 촬영법.","subcategory":"진단·검사","level":2,"related":["contrast-enhanced-ct"],"prerequisites":["contrast-enhanced-ct"],"pop":11,"aliases":["HRC","HRCT","고해상도CT"]},{"slug":"dual-energy-ct","title_ko":"이중에너지 CT","title_en":"Dual-Energy CT (DECT)","meaning":"서로 다른 두 에너지 수준의 X선을 이용해 촬영함으로써 물질의 조성을 구분하고 특정 물질(요산 결정, 조영제 등)을…","subcategory":"진단·검사","level":3,"related":["contrast-enhanced-ct"],"prerequisites":["contrast-enhanced-ct"],"aliases":["이중에너지CT"]},{"slug":"fluoroscopy","title_ko":"투시조영검사","title_en":"Fluoroscopy","meaning":"X선을 연속적으로 조사하여 실시간 동영상 형태로 체내 구조나 조영제의 움직임을 관찰하는 영상 기법.","subcategory":"진단·검사","level":2,"related":["cardiac-catheterization","coronary-angiography"],"prerequisites":["cardiac-catheterization","coronary-angiography"],"aliases":["투시검사","형광투시법"]},{"slug":"mammography","title_ko":"유방촬영술","title_en":"Mammography","meaning":"유방을 압박한 상태에서 저선량 X선으로 촬영하여 유방암 및 관련 병변을 선별·진단하는 영상 검사.","subcategory":"진단·검사","level":1,"related":["core-needle-biopsy"],"prerequisites":["core-needle-biopsy"],"aliases":["맘모그래피","유방X선촬영"]},{"slug":"dexa-scan","title_ko":"골밀도 검사 (DEXA)","title_en":"Dual-Energy X-ray Absorptiometry (DEXA/DXA)","meaning":"두 가지 에너지의 X선이 뼈와 연조직에서 흡수되는 정도 차이를 측정하여 골밀도를 정량적으로 평가하는 검사.","subcategory":"진단·검사","level":2,"related":[],"prerequisites":[],"aliases":["DEXA","DEXA/DXA","골밀도 검사","골밀도검사(DEXA)"]},{"slug":"doppler-ultrasound","title_ko":"도플러 초음파","title_en":"Doppler Ultrasound","meaning":"초음파가 움직이는 혈구에 반사될 때 발생하는 주파수 변화(도플러 효과)를 이용해 혈류의 방향과 속도를 측정하는 초음파 기법.","subcategory":"진단·검사","level":2,"related":["carotid-doppler-ultrasound"],"prerequisites":[],"aliases":["도플러초음파"]},{"slug":"carotid-doppler-ultrasound","title_ko":"경동맥 초음파","title_en":"Carotid Doppler Ultrasound","meaning":"목의 경동맥에 도플러 초음파를 적용하여 혈관벽의 죽상경화반과 혈류 속도를 평가하는 검사.","subcategory":"진단·검사","level":3,"related":["doppler-ultrasound","contrast-enhanced-ct"],"prerequisites":["doppler-ultrasound","contrast-enhanced-ct"],"pop":8,"aliases":["경동맥초음파"]},{"slug":"elastography","title_ko":"탄성초음파","title_en":"Elastography","meaning":"조직의 딱딱한 정도(경도)를 초음파나 자기공명 신호로 측정하여 섬유화나 종양 등을 평가하는 영상 기법.","subcategory":"진단·검사","level":3,"related":["doppler-ultrasound","core-needle-biopsy"],"prerequisites":["doppler-ultrasound","core-needle-biopsy"],"aliases":["엘라스토그래피"]},{"slug":"endoscopic-ultrasound","title_ko":"내시경 초음파","title_en":"Endoscopic Ultrasound (EUS)","meaning":"초음파 탐촉자가 부착된 내시경을 소화관 내로 삽입하여 인접 장기와 소화관 벽 층을 근접 관찰하는 검사.","subcategory":"진단·검사","level":2,"related":["gastroscopy","core-needle-biopsy"],"prerequisites":["gastroscopy","core-needle-biopsy"],"aliases":["EUS","내시경초음파"]},{"slug":"gastroscopy","title_ko":"위내시경 (상부위장관내시경)","title_en":"Gastroscopy (Esophagogastroduodenoscopy, EGD)","meaning":"입을 통해 얇고 유연한 내시경을 삽입하여 식도, 위, 십이지장 점막을 직접 관찰하는 검사.","subcategory":"진단·검사","level":1,"related":["endoscopic-ultrasound","core-needle-biopsy"],"prerequisites":[],"aliases":["상부위장관내시경","위내시경","위내시경(상부위장관내시경)"]},{"slug":"cardiac-catheterization","title_ko":"심장 카테터삽입술","title_en":"Cardiac Catheterization","meaning":"가느다란 관(카테터)을 혈관을 통해 심장까지 삽입하여 심장 내 압력을 측정하거나 조영제를 주입해 혈관 상태를 평가하는 침습적…","subcategory":"진단·검사","level":2,"related":["coronary-angiography","fluoroscopy","electrophysiology-study"],"prerequisites":[],"aliases":["심장카테터삽입술"]},{"slug":"coronary-angiography","title_ko":"관상동맥조영술","title_en":"Coronary Angiography","meaning":"카테터를 통해 관상동맥에 조영제를 직접 주입하고 X선 영상으로 혈관의 협착이나 폐색 부위를 확인하는 검사.","subcategory":"진단·검사","level":2,"related":["cardiac-catheterization","contrast-enhanced-ct"],"prerequisites":[],"aliases":["CAG","관상동맥촬영술"]},{"slug":"implantable-loop-recorder","title_ko":"이식형 루프 기록기","title_en":"Implantable Loop Recorder (ILR)","meaning":"피부밑에 삽입하여 수년간 심전도를 연속적으로 감시하고 이상 리듬 발생 시 자동으로 기록하는 소형 장치.","subcategory":"진단·검사","level":3,"related":["electrophysiology-study"],"prerequisites":["electrophysiology-study"],"aliases":["ILR","이식형루프기록기"]},{"slug":"electrophysiology-study","title_ko":"전기생리학검사","title_en":"Electrophysiology Study (EPS)","meaning":"카테터를 심장 내부에 삽입해 전기 신호를 직접 측정하고 자극하여 부정맥의 원인 부위를 찾아내는 침습적 검사.","subcategory":"진단·검사","level":2,"related":["cardiac-catheterization","implantable-loop-recorder"],"prerequisites":[],"aliases":["전기생리검사"]},{"slug":"ambulatory-blood-pressure-monitoring","title_ko":"활동혈압측정","title_en":"Ambulatory Blood Pressure Monitoring (ABPM)","meaning":"24시간 동안 휴대용 장치를 몸에 부착해 일정 간격으로 자동으로 혈압을 반복 측정하는 검사.","subcategory":"진단·검사","level":3,"related":[],"prerequisites":[],"aliases":["24시간혈압측정","ABPM"]},{"slug":"arterial-blood-gas-analyzer","title_ko":"동맥혈가스분석기","title_en":"Arterial Blood Gas (ABG) Analyzer","meaning":"동맥혈 표본을 분석하여 혈액 내 산소·이산화탄소 분압, pH, 중탄산염 농도 등을 측정하는 검사 장비.","subcategory":"진단·검사","level":2,"related":[],"prerequisites":[],"aliases":["동맥혈가스검사"]},{"slug":"rt-pcr-diagnostic-test","title_ko":"RT-PCR 진단검사","title_en":"RT-PCR Diagnostic Test","meaning":"RNA를 DNA로 역전사한 뒤 중합효소연쇄반응으로 특정 유전 서열을 기하급수적으로 증폭시켜 병원체나 유전 물질의 존재 여부를…","subcategory":"진단·검사","level":2,"related":["elisa"],"prerequisites":[],"aliases":["RPDT","RT PCR 진단검사","RT-PCR진단검사","RTPCR 진단검사"]},{"slug":"core-needle-biopsy","title_ko":"중심부바늘생검","title_en":"Core Needle Biopsy","meaning":"굵은 바늘을 병변에 삽입하여 원통형의 조직 시료를 채취함으로써 세포 구조뿐 아니라 조직 구조까지 평가할 수 있게 하는 생검…","subcategory":"진단·검사","level":2,"related":[],"prerequisites":[],"aliases":["총생검","코어바늘생검"]},{"slug":"tympanometry","title_ko":"고막운동성계측법","title_en":"Tympanometry","meaning":"외이도의 압력을 변화시키며 고막의 움직임을 측정하여 중이의 상태와 압력을 객관적으로 평가하는 검사.","subcategory":"진단·검사","level":3,"related":[],"prerequisites":[],"aliases":["고실도검사","임피던스청력검사"]},{"slug":"slit-lamp-examination","title_ko":"세극등현미경검사","title_en":"Slit Lamp Examination","meaning":"좁고 강한 띠 모양의 빛을 이용해 안구 전면부 구조를 고배율로 확대해 관찰하는 안과 진찰 기법.","subcategory":"진단·검사","level":2,"related":[],"prerequisites":[],"aliases":["세극등검사"]},{"slug":"myocardial-ischemia-mechanism","title_ko":"심근허혈 기전","title_en":"Myocardial Ischemia Mechanism","meaning":"관상동맥의 혈류 공급이 심근의 산소 요구량에 미치지 못해 심장 근육 세포가 산소 부족 상태에 빠지는 현상.","subcategory":"질병·병리","level":2,"related":["cardiac-preload-afterload","ischemia-reperfusion-injury"],"prerequisites":[],"aliases":["심근허혈기전"]},{"slug":"heart-failure-preserved-ejection-fraction","title_ko":"박출률보존 심부전","title_en":"Heart Failure with Preserved Ejection Fraction (HFpEF)","meaning":"좌심실의 수축 기능은 정상 범위로 유지되지만 이완 기능 장애로 인해 심부전 증상이 나타나는 질환.","subcategory":"질병·병리","level":2,"related":["cardiac-preload-afterload"],"prerequisites":[],"aliases":["박출률보존심부전"]},{"slug":"cardiac-preload-afterload","title_ko":"전부하와 후부하","title_en":"Cardiac Preload and Afterload","meaning":"심실이 수축 직전 채워진 혈액량으로 인해 받는 벽장력인 전부하와, 심실이 혈액을 밀어낼 때 맞서야 하는 저항인 후부하를 함께…","subcategory":"해부·생리","level":1,"related":["heart-failure-preserved-ejection-fraction"],"prerequisites":[],"pop":18,"aliases":["전부하와후부하"]},{"slug":"tumor-microenvironment","title_ko":"종양미세환경","title_en":"Tumor Microenvironment","meaning":"종양 세포를 둘러싸고 있는 혈관, 면역세포, 섬유아세포, 세포외기질 등으로 이루어져 종양의 성장과 진행에 영향을 주는 주변…","subcategory":"질병·병리","level":2,"related":[],"prerequisites":[],"aliases":["TME"]},{"slug":"epithelial-mesenchymal-transition","title_ko":"상피간엽이행","title_en":"Epithelial-Mesenchymal Transition (EMT)","meaning":"상피세포가 세포 간 결합력을 잃고 이동성과 침습성이 높은 간엽세포 성격으로 변화하는 과정.","subcategory":"질병·병리","level":3,"related":[],"prerequisites":[],"aliases":["EMT","상피중간엽전환"]},{"slug":"renin-angiotensin-aldosterone-system","title_ko":"레닌-안지오텐신-알도스테론계","title_en":"Renin-Angiotensin-Aldosterone System (RAAS)","meaning":"콩팥에서 분비되는 레닌을 시작으로 안지오텐신과 알도스테론이 순차적으로 작용해 혈압과 체액량을 조절하는 호르몬 체계.","subcategory":"해부·생리","level":2,"related":[],"prerequisites":[],"pop":12,"aliases":["RAAS","레닌 안지오텐신 알도스테론계","레닌안지오텐신알도스테론계"]},{"slug":"hemolysis-mechanism","title_ko":"용혈 기전","title_en":"Hemolysis Mechanism","meaning":"적혈구가 정상 수명을 다하기 전에 혈관 안이나 비장 등에서 조기에 파괴되는 현상과 그 원인.","subcategory":"질병·병리","level":2,"related":[],"prerequisites":[],"aliases":["용혈기전"]},{"slug":"ventilation-perfusion-mismatch","title_ko":"환기관류 불균형","title_en":"Ventilation-Perfusion (V/Q) Mismatch","meaning":"폐포로 들어오는 공기의 환기량과 폐 모세혈관을 흐르는 혈류량이 서로 균형을 이루지 못해 가스 교환 효율이 떨어지는 상태.","subcategory":"질병·병리","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["V/Q","환기관류불균형"]},{"slug":"sepsis-pathophysiology","title_ko":"패혈증 병태생리","title_en":"Sepsis Pathophysiology","meaning":"감염에 대한 신체의 반응이 조절되지 못하고 과도해지면서 자기 조직과 장기까지 손상시키는 전신 염증 및 순환 이상 상태.","subcategory":"질병·병리","level":1,"related":[],"prerequisites":[],"aliases":["패혈증병태생리"]},{"slug":"ischemia-reperfusion-injury","title_ko":"허혈재관류손상","title_en":"Ischemia-Reperfusion Injury","meaning":"혈류가 끊겼던 조직에 혈류가 다시 통하면서 오히려 활성산소 생성 등으로 추가적인 세포 손상이 일어나는 역설적인 현상.","subcategory":"질병·병리","level":2,"related":[],"prerequisites":[],"aliases":["재관류손상"]},{"slug":"tumor-lysis-syndrome","title_ko":"종양용해증후군","title_en":"Tumor Lysis Syndrome","meaning":"항암 치료로 다량의 암세포가 한꺼번에 파괴되면서 세포 내용물이 급격히 혈액으로 방출되어 심각한 전해질 이상과 신장 손상을…","subcategory":"질병·병리","level":3,"related":[],"prerequisites":[]},{"slug":"transplant-rejection-mechanism","title_ko":"이식거부반응 기전","title_en":"Transplant Rejection Mechanism","meaning":"이식받은 사람의 면역계가 이식된 장기나 조직을 외부 물질로 인식하여 공격하는 면역 반응의 원리.","subcategory":"질병·병리","level":3,"related":[],"prerequisites":[],"aliases":["이식거부반응기전"]},{"slug":"stem-cell-niche","title_ko":"줄기세포 미세환경","title_en":"Stem Cell Niche","meaning":"줄기세포가 자리 잡고 있는 주변의 세포와 신호 분자로 이루어진 특수한 미세환경으로, 줄기세포의 자가재생과 분화를 조절하는…","subcategory":"해부·생리","level":3,"related":[],"prerequisites":[],"aliases":["줄기세포미세환경"]},{"slug":"minimum-effective-concentration","title_ko":"최소유효농도","title_en":"Minimum Effective Concentration (MEC)","meaning":"약물이 원하는 치료 효과를 나타내기 위해 필요한 최소한의 혈중농도.","subcategory":"치료·약리","level":3,"related":["trough-concentration","loading-dose"],"prerequisites":["trough-concentration"],"aliases":["MEC"]},{"slug":"high-alert-medication","title_ko":"고위험의약품","title_en":"High-Alert Medication","meaning":"사용상 오류가 발생할 경우 환자에게 특히 심각하거나 치명적인 위해를 초래할 수 있어 각별한 관리가 필요한 의약품.","subcategory":"치료·약리","level":2,"related":[],"prerequisites":[],"aliases":["고위험약물"]},{"slug":"desensitization-protocol","title_ko":"약물 탈감작요법","title_en":"Drug Desensitization Protocol","meaning":"특정 약물에 알레르기가 있는 환자에게 그 약물이 유일한 치료 대안일 때, 매우 적은 용량부터 시작해 점진적으로 늘려가며…","subcategory":"치료·약리","level":3,"related":[],"prerequisites":[],"pop":20,"aliases":["약물탈감작요법"]},{"slug":"qt-prolongation-risk","title_ko":"QT연장 위험 약물","title_en":"QT-Prolonging Drugs","meaning":"심장의 전기적 재분극 과정을 지연시켜 QT간격을 늘리고 심각한 부정맥을 유발할 위험이 있는 약물.","subcategory":"치료·약리","level":3,"related":["serious-adverse-event","high-alert-medication"],"prerequisites":["high-alert-medication"],"aliases":["QPD","QT연장위험약물"]},{"slug":"drug-fever","title_ko":"약열","title_en":"Drug Fever","meaning":"다른 감염이나 원인 없이 약물 자체가 원인이 되어 발생하는 발열 반응.","subcategory":"치료·약리","level":2,"related":["serious-adverse-event"],"prerequisites":[],"aliases":["약물열"]},{"slug":"genome-wide-association-study","title_ko":"전장유전체 연관분석","title_en":"Genome-wide association study (GWAS)","meaning":"수많은 개체의 유전체 전체에 걸친 유전 변이와 특정 형질 또는 질병 사이의 통계적 연관성을 대규모로 탐색하는 연구 방법.","subcategory":"유전·진화","level":3,"related":[],"prerequisites":[],"aliases":["GWAS","전장유전체연관분석"]},{"slug":"mosaicism","title_ko":"모자이시즘","title_en":"Mosaicism","meaning":"한 개체 안에 유전적으로 서로 다른 두 종류 이상의 세포 계통이 함께 존재하는 상태.","subcategory":"유전·진화","level":2,"related":["de-novo-mutation"],"prerequisites":[],"pop":4,"aliases":["모자이크현상"]},{"slug":"genetic-anticipation","title_ko":"유전적 예측현상","title_en":"Genetic anticipation","meaning":"유전 질환이 세대를 거듭할수록 더 이른 나이에 발병하거나 증상이 더 심해지는 현상.","subcategory":"유전·진화","level":3,"related":["de-novo-mutation"],"prerequisites":["de-novo-mutation"],"aliases":["유전적예측현상"]},{"slug":"de-novo-mutation","title_ko":"신생 돌연변이","title_en":"De novo mutation","meaning":"부모의 체세포나 생식세포에는 없던 유전 변이가 생식세포 형성 과정이나 수정 직후에 새롭게 발생하여 자녀에게만 나타나는 변이.","subcategory":"유전·진화","level":2,"related":["mosaicism"],"prerequisites":[],"aliases":["신생돌연변이"]},{"slug":"dna-methylation-profiling","title_ko":"DNA 메틸화 프로파일링","title_en":"DNA methylation profiling","meaning":"유전체 전반에 걸쳐 시토신 염기에 메틸기가 결합된 위치와 정도를 체계적으로 측정하여 개체나 조직의 메틸화 양상을 규명하는…","subcategory":"세포·분자생물학","level":3,"related":["bisulfite-sequencing"],"prerequisites":[],"aliases":["DNA메틸화프로파일링"]},{"slug":"mitochondrial-heteroplasmy","title_ko":"미토콘드리아 이형세포질성","title_en":"Mitochondrial heteroplasmy","meaning":"한 세포 또는 개체 안에 정상과 변이 미토콘드리아 DNA가 서로 다른 비율로 함께 존재하는 상태.","subcategory":"유전·진화","level":3,"related":["mosaicism"],"prerequisites":[],"aliases":["미토콘드리아이형세포질성"]},{"slug":"cd4-helper-t-cell","title_ko":"CD4 양성 도움T세포","title_en":"CD4+ Helper T Cell","meaning":"세포 표면에 CD4 단백질을 발현하며 다른 면역세포의 활성화를 조율하는 지휘관 역할의 T림프구.","subcategory":"해부·생리","level":1,"related":["cd8-cytotoxic-t-cell","costimulatory-signal"],"prerequisites":[],"aliases":["CD4양성도움T세포","CHTC"]},{"slug":"cd8-cytotoxic-t-cell","title_ko":"CD8 양성 세포독성T세포","title_en":"CD8+ Cytotoxic T Cell","meaning":"감염되거나 변형된 세포를 직접 인식하여 파괴하는 킬러 세포로, 표면에 CD8 단백질을 발현하는 T림프구.","subcategory":"해부·생리","level":1,"related":["cd4-helper-t-cell","car-t-cell-therapy"],"prerequisites":[],"aliases":["CCTC","CD8양성세포독성T세포"]},{"slug":"plasma-cell","title_ko":"형질세포","title_en":"Plasma Cell","meaning":"활성화된 B세포가 최종적으로 분화한 형태로, 대량의 항체를 지속적으로 분비하는 특화된 세포.","subcategory":"해부·생리","level":1,"related":["germinal-center-reaction"],"prerequisites":[]},{"slug":"mast-cell","title_ko":"비만세포","title_en":"Mast Cell","meaning":"조직 내에 상주하며 히스타민을 비롯한 염증 매개물질을 저장했다가 자극 시 방출하여 급성 알레르기 반응을 일으키는 면역세포.","subcategory":"해부·생리","level":1,"related":[],"prerequisites":[],"aliases":["마스트세포"]},{"slug":"costimulatory-signal","title_ko":"공동자극신호","title_en":"Costimulatory Signal","meaning":"T세포가 완전히 활성화되기 위해 항원 인식 신호와 함께 필요한, 항원제시세포의 별도 표면 분자를 통한 보조 신호.","subcategory":"해부·생리","level":2,"related":["ctla-4"],"prerequisites":[],"aliases":["보조자극신호"]},{"slug":"ctla-4","title_ko":"CTLA-4","title_en":"CTLA-4 (Cytotoxic T-Lymphocyte-Associated Protein 4)","meaning":"활성화된 T세포 표면에 발현되어 CD28보다 강한 친화력으로 공동자극 리간드에 결합함으로써 T세포 활성화를 억제하는 면역관문…","subcategory":"해부·생리","level":3,"related":["costimulatory-signal","immune-checkpoint-inhibitor-mechanism","cd4-helper-t-cell"],"prerequisites":["costimulatory-signal","cd4-helper-t-cell"],"aliases":["CTLA 4","CTLA4"]},{"slug":"type-3-hypersensitivity","title_ko":"제3형 과민반응","title_en":"Type III Hypersensitivity","meaning":"항원-항체 면역복합체가 혈관이나 조직에 침착되어 보체를 활성화시키고 국소 염증과 조직 손상을 일으키는 과민반응.","subcategory":"질병·병리","level":3,"related":["type-4-hypersensitivity"],"prerequisites":[],"aliases":["면역복합체과민반응","제3형과민반응"]},{"slug":"type-4-hypersensitivity","title_ko":"제4형 과민반응","title_en":"Type IV Hypersensitivity","meaning":"항체가 아니라 감작된 T세포가 매개하여 항원 재노출 후 24~72시간에 걸쳐 지연되어 나타나는 과민반응.","subcategory":"질병·병리","level":3,"related":["cd4-helper-t-cell","type-3-hypersensitivity"],"prerequisites":[],"aliases":["지연형과민반응","제4형과민반응"]},{"slug":"car-t-cell-therapy","title_ko":"CAR-T세포 치료","title_en":"CAR-T Cell Therapy","meaning":"환자의 T세포를 채취해 종양 항원을 인식하는 인공 수용체 유전자를 삽입한 뒤 다시 체내에 주입하여 암세포를 표적 공격하게…","subcategory":"치료·약리","level":3,"related":["cd8-cytotoxic-t-cell"],"prerequisites":[],"aliases":["CAR T세포 치료","CAR-T세포치료","CART세포 치료","CTCT"]},{"slug":"immune-checkpoint-inhibitor-mechanism","title_ko":"면역관문억제제 작용기전","title_en":"Immune Checkpoint Inhibitor Mechanism","meaning":"T세포 활성화를 억제하는 면역관문 분자의 신호를 항체로 차단하여 잠재된 항종양 면역 반응을 다시 활성화시키는 치료 원리.","subcategory":"치료·약리","level":2,"related":["ctla-4","cd8-cytotoxic-t-cell"],"prerequisites":[],"aliases":["ICIM","면역관문억제제작용기전"]},{"slug":"germinal-center-reaction","title_ko":"배중심 반응","title_en":"Germinal Center Reaction","meaning":"림프절과 비장의 여포 내부에서 활성화된 B세포가 증식하며 체세포과돌연변이와 선택을 거쳐 고친화도 항체 생산 세포로 분화하는…","subcategory":"해부·생리","level":2,"related":["follicular-helper-t-cell","plasma-cell"],"prerequisites":[],"aliases":["배중심반응"]},{"slug":"follicular-helper-t-cell","title_ko":"여포도움T세포","title_en":"Follicular Helper T Cell (Tfh)","meaning":"림프절 여포로 이동하여 배중심 반응 중인 B세포에게 직접 신호를 전달함으로써 항체 생산과 친화도 성숙을 돕는 도움T세포의…","subcategory":"해부·생리","level":3,"related":["germinal-center-reaction","cd4-helper-t-cell","plasma-cell"],"prerequisites":["germinal-center-reaction","cd4-helper-t-cell"],"aliases":["FHTC","Tfh"]},{"slug":"plasmacytoid-dendritic-cell","title_ko":"형질세포양수지상세포","title_en":"Plasmacytoid Dendritic Cell (pDC)","meaning":"바이러스 감염에 반응해 대량의 제1형 인터페론을 분비하는 데 특화된 수지상세포의 한 아형.","subcategory":"해부·생리","level":3,"related":["toll-like-receptor"],"prerequisites":[],"aliases":["pDC"]},{"slug":"toll-like-receptor","title_ko":"톨유사수용체","title_en":"Toll-Like Receptor (TLR)","meaning":"세포막이나 세포 내부 소포에 위치하며 세균, 바이러스, 곰팡이의 특징적인 분자 구조를 인식해 선천 면역 신호를 전달하는…","subcategory":"해부·생리","level":2,"related":["plasmacytoid-dendritic-cell"],"prerequisites":[],"aliases":["TLR"]},{"slug":"nucleotide-salvage-pathway","title_ko":"뉴클레오타이드 회수 경로","title_en":"Nucleotide Salvage Pathway","meaning":"핵산 분해로 생긴 유리 염기나 뉴클레오사이드를 재활용하여 다시 뉴클레오타이드로 전환하는 에너지 절약형 대사 경로.","subcategory":"세포·분자생물학","level":3,"related":[],"prerequisites":[],"aliases":["뉴클레오타이드회수경로"]},{"slug":"mtor-pathway","title_ko":"mTOR 경로","title_en":"mTOR Pathway","meaning":"영양분과 성장인자의 신호를 통합하여 단백질 합성, 세포 성장, 물질대사를 촉진하는 세포 내 신호전달 경로.","subcategory":"세포·분자생물학","level":3,"related":[],"prerequisites":[],"aliases":["mTOR경로"]},{"slug":"warburg-effect","title_ko":"바르부르크 효과","title_en":"Warburg Effect","meaning":"산소가 충분한 조건에서도 암세포가 산화적 인산화보다 해당과정과 젖산 발효에 크게 의존하여 에너지를 얻는 현상.","subcategory":"세포·분자생물학","level":3,"related":[],"prerequisites":[],"aliases":["바르부르크효과"]},{"slug":"mitochondrial-biogenesis","title_ko":"미토콘드리아 생합성","title_en":"Mitochondrial Biogenesis","meaning":"기존 미토콘드리아가 분열하고 새로운 미토콘드리아 성분이 합성되어 세포 내 미토콘드리아의 수와 질량이 증가하는 과정.","subcategory":"세포·분자생물학","level":3,"related":["electron-transport-chain"],"prerequisites":["electron-transport-chain"],"aliases":["미토콘드리아생합성"]},{"slug":"glucose-6-phosphatase","title_ko":"포도당-6-인산분해효소","title_en":"Glucose-6-Phosphatase","meaning":"포도당-6-인산을 가수분해하여 유리 포도당과 무기인산을 생성함으로써 간과 신장에서 포도당을 혈액으로 방출하는 마지막 단계를…","subcategory":"세포·분자생물학","level":3,"related":["glycogenolysis"],"prerequisites":["glycogenolysis"],"aliases":["포도당 6 인산분해효소","포도당6인산분해효소"]},{"slug":"drug-half-life","title_ko":"약물 반감기","title_en":"Drug Half-Life","meaning":"체내 약물 농도가 초기값의 절반으로 줄어드는 데 걸리는 시간.","subcategory":"치료·약리","level":1,"related":["loading-dose"],"prerequisites":[],"aliases":["DHL","약물반감기"]},{"slug":"auc-pharmacokinetics","title_ko":"약물동태학적 곡선하면적(AUC)","title_en":"Area Under the Curve (AUC)","meaning":"시간에 따른 혈중 약물 농도 변화를 그래프로 그렸을 때 곡선과 시간축 사이의 면적으로, 체내에 노출된 약물의 총량을 나타내는…","subcategory":"치료·약리","level":3,"related":["drug-half-life"],"prerequisites":["drug-half-life"],"pop":16,"aliases":["약물동태학적 곡선하면적","약물동태학적곡선하면적","약물동태학적곡선하면적(AUC)"]},{"slug":"plasma-protein-binding","title_ko":"혈장단백질 결합","title_en":"Plasma Protein Binding","meaning":"약물이 혈액 속의 알부민 등 단백질과 결합해 이동하며, 결합되지 않은 유리 상태의 약물만이 조직으로 이동해 약효를 낼 수…","subcategory":"치료·약리","level":3,"related":[],"prerequisites":[],"aliases":["PPB","혈장단백질결합"]},{"slug":"ec50","title_ko":"최대반응 50% 도달농도(EC50)","title_en":"EC50 (Half-Maximal Effective Concentration)","meaning":"약물이 최대 반응의 절반에 해당하는 효과를 나타내는 데 필요한 농도.","subcategory":"치료·약리","level":2,"related":["ic50"],"prerequisites":[],"aliases":["EC50","최대반응 50% 도달농도","최대반응50%도달농도","최대반응50%도달농도(EC50)"]},{"slug":"ic50","title_ko":"최대억제 50% 도달농도(IC50)","title_en":"IC50 (Half-Maximal Inhibitory Concentration)","meaning":"어떤 생물학적 또는 화학적 과정을 절반만큼 억제하는 데 필요한 약물이나 물질의 농도.","subcategory":"치료·약리","level":2,"related":["ec50"],"prerequisites":["ec50"],"aliases":["IC50","최대억제 50% 도달농도","최대억제50%도달농도","최대억제50%도달농도(IC50)"]},{"slug":"receptor-antagonist","title_ko":"수용체 길항제","title_en":"Receptor Antagonist","meaning":"수용체에 결합하지만 이를 활성화시키지는 않고, 오히려 원래의 작용제가 결합해 효과를 내는 것을 방해하는 물질.","subcategory":"치료·약리","level":1,"related":["beta-blocker-mechanism"],"prerequisites":[],"aliases":["수용체길항제"]},{"slug":"no-observed-adverse-effect-level","title_ko":"최대무독성용량(NOAEL)","title_en":"No Observed Adverse Effect Level (NOAEL)","meaning":"동물실험에서 통계적으로나 생물학적으로 유의미한 부작용이 관찰되지 않는 가장 높은 투여 용량.","subcategory":"치료·약리","level":3,"related":[],"prerequisites":[],"aliases":["NOAEL","최대무독성용량"]},{"slug":"prodrug","title_ko":"전구약물","title_en":"Prodrug","meaning":"투여된 상태에서는 약리학적으로 비활성이거나 활성이 낮지만, 체내에서 대사 과정을 거쳐 활성 형태로 전환되어 약효를 나타내는…","subcategory":"치료·약리","level":2,"related":["cyp2d6-polymorphism"],"prerequisites":[],"pop":6,"aliases":["프로드러그"]},{"slug":"cyp2d6-polymorphism","title_ko":"CYP2D6 유전적 다형성","title_en":"CYP2D6 Genetic Polymorphism","meaning":"다수의 약물 대사에 관여하는 CYP2D6 효소를 코딩하는 유전자가 개인이나 인종에 따라 다양한 변이 형태를 가져, 이 효소의…","subcategory":"치료·약리","level":3,"related":["cytochrome-p450"],"prerequisites":[],"pop":2,"aliases":["CYP2D6유전적다형성"]},{"slug":"beta-blocker-mechanism","title_ko":"베타차단제 작용기전","title_en":"Beta-Blocker Mechanism","meaning":"베타 아드레날린 수용체를 차단해 교감신경 자극에 의한 심박수 증가와 심근 수축력 증가를 억제하는 약물 계열의 작용 원리.","subcategory":"치료·약리","level":2,"related":["receptor-antagonist","calcium-channel-blocker-mechanism","ace-inhibitor-mechanism"],"prerequisites":["receptor-antagonist","ace-inhibitor-mechanism"],"aliases":["베타차단제작용기전"]},{"slug":"ace-inhibitor-mechanism","title_ko":"ACE 억제제 작용기전","title_en":"ACE Inhibitor Mechanism","meaning":"안지오텐신전환효소를 억제해 혈관을 수축시키는 안지오텐신Ⅱ의 생성을 줄임으로써 혈관을 이완시키고 혈압을 낮추는 약물 계열의…","subcategory":"치료·약리","level":1,"related":["beta-blocker-mechanism"],"prerequisites":[],"aliases":["ACE억제제작용기전"]},{"slug":"ssri-mechanism","title_ko":"SSRI(선택적세로토닌재흡수억제제) 작용기전","title_en":"SSRI Mechanism","meaning":"신경세포 시냅스에서 세로토닌이 방출된 후 다시 흡수되는 재흡수 통로를 선택적으로 억제해 시냅스 내 세로토닌 농도를 높이는…","subcategory":"치료·약리","level":2,"related":[],"prerequisites":[],"aliases":["SSRI 작용기전","SSRI(선택적세로토닌재흡수억제제)작용기전","