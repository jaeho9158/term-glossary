 "legend": [
  {
   "sym": "RPO",
   "desc": "복구 시점 목표(Recovery Point Objective). 견딜 수 있는 데이터 손실의 양",
   "kind": "abbr"
  },
  {
   "sym": "RTO",
   "desc": "복구 시간 목표(Recovery Time Objective). 기능을 되살리기까지 허용되는 시간",
   "kind": "abbr"
  },
  {
   "sym": "MTPoD",
   "desc": "최대 허용 중단 기간(Maximum Tolerable Period of Disruption)",
   "kind": "abbr"
  },
  {
   "sym": "RCO",
   "desc": "복구 일관성 목표(Recovery Consistency Objective). 복구 뒤 연동된 시스템 사이의 데이터 일관성을 퍼센트로 나타낸다",
   "kind": "abbr"
  },
  {
   "desc": "그림에는 구체 시간값을 넣지 않았다. RTO가 끝나는 점이 한계선 안쪽에 있어야 한다."
  }
 ],
