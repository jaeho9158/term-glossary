design-of-experiments","dmaic-methodology"],"prerequisites":[],"pop":4,"aliases":["GRRS","Gage R&R","게이지 반복성 재현성 분석","게이지 반복성 재현성 분석(Gage R&R)","게이지 반복성·재현성 분석","게이지 반복성재현성 분석","게이지 반복성재현성 분석(Gage R&R)","게이지반복성·재현성분석","게이지반복성·재현성분석(GageR&R)"]},{"slug":"power-spectral-density-analysis","title_ko":"파워스펙트럼밀도 분석","title_en":"Power Spectral Density (PSD) Analysis","meaning":"불규칙하게 변하는 신호의 에너지(파워)가 주파수별로 어떻게 분포되어 있는지를 나타내는 함수를 계산하여 분석하는 신호처리 기법.","subcategory":"전기전자","level":1,"related":[],"prerequisites":[],"aliases":["PSDA","파워스펙트럼밀도분석"]},{"slug":"buckling-load-theory","title_ko":"좌굴하중 이론","title_en":"Buckling Load Theory","meaning":"가늘고 긴 기둥이나 판이 압축력을 받을 때 갑자기 옆으로 휘어지며 안정성을 잃는 좌굴 현상을 설명하는 이론.","subcategory":"기계·재료","level":3,"related":["euler-buckling-formula","moment-of-inertia-section"],"prerequisites":[],"aliases":["좌굴하중이론"]},{"slug":"euler-buckling-formula","title_ko":"오일러 좌굴공식","title_en":"Euler Buckling Formula","meaning":"이상적인 기둥의 임계 좌굴하중을 부재의 길이, 단면의 굽힘강성, 경계조건으로부터 계산하는 고전적 공식.","subcategory":"기계·재료","level":3,"related":["buckling-load-theory","moment-of-inertia-section"],"prerequisites":[],"aliases":["EBF","오일러좌굴공식"]},{"slug":"brittle-ductile-fracture","title_ko":"취성파괴와 연성파괴","title_en":"Brittle and Ductile Fracture","meaning":"재료가 파괴에 이르는 두 가지 대표적인 양상으로, 소성 변형 없이 급격히 파괴되는 취성파괴와 상당한 소성 변형을 동반하는…","subcategory":"기계·재료","level":3,"related":["tensile-strength","yield-strength"],"prerequisites":["tensile-strength"],"aliases":["BDF","취성파괴와연성파괴"]},{"slug":"viscosity-newtonian-fluid","title_ko":"뉴턴유체의 점성","title_en":"Viscosity of Newtonian Fluid","meaning":"전단응력이 전단변형률에 정비례하는 유체인 뉴턴유체의 점성 거동을 나타내는 유체역학 개념.","subcategory":"기계·재료","level":3,"related":[],"prerequisites":[],"aliases":["VNF","뉴턴유체의점성"]},{"slug":"second-law-thermodynamics","title_ko":"열역학 제2법칙","title_en":"Second Law of Thermodynamics","meaning":"고립계에서 엔트로피는 감소하지 않으며, 열은 자발적으로 고온에서 저온으로만 흐른다는 에너지 변환의 방향성을 규정하는 법칙.","subcategory":"화학·에너지공학","level":1,"related":[],"prerequisites":[]},{"slug":"fourier-law-of-conduction","title_ko":"푸리에 열전도 법칙","title_en":"Fourier's Law of Conduction","meaning":"물질 내 열유속이 온도구배에 비례한다는 것을 수학적으로 나타낸 열전도의 기본 법칙.","subcategory":"기계·재료","level":3,"related":["thermal-conductivity"],"prerequisites":["thermal-conductivity"],"pop":20,"aliases":["푸리에법칙"]},{"slug":"martensitic-transformation","title_ko":"마르텐사이트 변태","title_en":"Martensitic Transformation","meaning":"확산 없이 원자들이 협동적으로 순간적인 전단 이동을 일으켜 결정 구조가 급격하게 변화하는 무확산 상변태 현상.","subcategory":"기계·재료","level":3,"related":["brittle-ductile-fracture","grain-boundary"],"prerequisites":["grain-boundary"],"aliases":["마르텐사이트변태"]},{"slug":"transfer-function-poles-zeros","title_ko":"전달함수의 극점과 영점","title_en":"Poles and Zeros of Transfer Function","meaning":"시스템의 입출력 관계를 나타내는 전달함수에서 시스템의 동적 특성을 결정짓는 분모의 근(극점)과 분자의 근(영점).","subcategory":"소프트웨어·제어","level":1,"related":["root-locus-method"],"prerequisites":[],"aliases":["PZTF","전달함수의극점과영점"]},{"slug":"pid-control-theory","title_ko":"PID 제어 이론","title_en":"PID Control Theory","meaning":"오차의 비례(P), 적분(I), 미분(D) 값을 조합해 제어 입력을 결정하는, 산업 현장에서 가장 널리 사용되는 피드백 제어…","subcategory":"소프트웨어·제어","level":2,"related":["transfer-function-poles-zeros"],"prerequisites":["transfer-function-poles-zeros"],"aliases":["PID제어이론"]},{"slug":"structural-redundancy","title_ko":"구조 여유도","title_en":"Structural Redundancy","meaning":"구조물의 일부 부재가 손상되거나 파괴되더라도 하중이 다른 경로로 재분배되어 전체 붕괴를 방지할 수 있는 구조적 여유 능력.","subcategory":"토목·건축","level":1,"related":[],"prerequisites":[],"aliases":["구조여유도"]},{"slug":"moment-of-inertia-section","title_ko":"단면 2차모멘트","title_en":"Moment of Inertia of a Section","meaning":"부재의 단면 형상이 굽힘이나 좌굴에 대해 얼마나 잘 저항하는지를 나타내는 단면의 기하학적 특성값.","subcategory":"토목·건축","level":2,"related":["buckling-load-theory","euler-buckling-formula"],"prerequisites":[],"aliases":["단면2차모멘트"]},{"slug":"tensile-strength","title_ko":"인장강도","title_en":"Tensile Strength","meaning":"재료가 파단되기 직전까지 견딜 수 있는 최대 인장응력이다.","subcategory":"선박설계·구조공학","level":3,"related":["yield-strength"],"prerequisites":[],"pop":19,"aliases":["UTS","Ultimate Tensile Strength"]},{"slug":"cathodic-protection-marine","title_ko":"음극 방식","title_en":"Cathodic Protection","meaning":"금속 구조물이 부식되는 전기화학적 반응을 억제하기 위해 구조물 표면을 전기화학적으로 음극화시켜 부식 전류의 방향을 조절하는…","subcategory":"해양플랜트·해양구조물","level":2,"related":["corrosion"],"prerequisites":[],"aliases":["전기방식"]}]