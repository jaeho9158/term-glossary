[{"slug":"signifier-signified","title_ko":"기표와 기의","title_en":"Signifier and Signified","meaning":"페르디낭 드 소쉬르의 구조언어학 개념으로, 기호를 이루는 음성적·문자적 형식(기표)과 그것이 지시하는 개념(기의)의 자의적…","subcategory":"문예이론·서사학·시학","level":2,"related":["structuralism"],"prerequisites":[],"pop":14,"aliases":["기의"]},{"slug":"realism","title_ko":"실재론","title_en":"Realism","meaning":"보편자나 특정 대상이 인간의 정신이나 언어와 독립적으로 실제로 존재한다고 보는 형이상학적 입장이다.","subcategory":"형이상학·인식론·논리학","level":1,"related":[],"prerequisites":[]},{"slug":"materialism","title_ko":"유물론","title_en":"Materialism","meaning":"존재하는 모든 것은 궁극적으로 물질이거나 물질에 의존하는 것이라고 보는 형이상학적 입장이다.","subcategory":"형이상학·인식론·논리학","level":2,"related":["physicalism","idealism"],"prerequisites":["physicalism"]},{"slug":"idealism","title_ko":"관념론","title_en":"Idealism","meaning":"궁극적 실재는 물질이 아니라 정신 또는 관념이며, 물리적 세계도 정신적인 것에 의존하거나 그것으로 구성된다고 보는 형이상학적…","subcategory":"형이상학·인식론·논리학","level":2,"related":["materialism","physicalism"],"prerequisites":["physicalism"]},{"slug":"physicalism","title_ko":"물리주의","title_en":"Physicalism","meaning":"존재하는 모든 것은 궁극적으로 물리학이 기술하는 물리적 실재이거나 그것에 전적으로 의존한다는 형이상학적 입장이다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["materialism","functionalism"],"prerequisites":[]},{"slug":"functionalism","title_ko":"기능주의","title_en":"Functionalism","meaning":"정신 상태를 그것을 이루는 물리적 재료가 아니라 입력과 출력, 다른 정신 상태와의 인과적 관계인 기능적 역할로 정의하는…","subcategory":"형이상학·인식론·논리학","level":1,"related":["physicalism"],"prerequisites":[]},{"slug":"emergentism","title_ko":"창발론","title_en":"Emergentism","meaning":"복잡한 체계가 구성 요소들의 단순한 합으로는 예측할 수 없는 새로운 속성을 산출한다고 보는 형이상학적 입장이다.","subcategory":"형이상학·인식론·논리학","level":3,"related":["physicalism"],"prerequisites":["physicalism"],"aliases":["발현론"]},{"slug":"panpsychism","title_ko":"범심론","title_en":"Panpsychism","meaning":"의식 또는 정신적 속성이 우주의 근본적이고 편재하는 특징이며, 물질의 가장 기본적인 구성 요소에도 어떤 형태로든 존재한다고…","subcategory":"형이상학·인식론·논리학","level":3,"related":["idealism","emergentism"],"prerequisites":["idealism"],"aliases":["범심리주의"]},{"slug":"intentionality","title_ko":"지향성","title_en":"Intentionality","meaning":"믿음이나 욕구와 같은 정신 상태가 특정한 대상이나 사태를 향하거나 그것에 관한 것일 수 있는 성질을 가리키는 철학 용어이다.","subcategory":"형이상학·인식론·논리학","level":3,"related":["functionalism"],"prerequisites":["functionalism"]},{"slug":"causation","title_ko":"인과","title_en":"Causation","meaning":"한 사건이나 상태가 다른 사건이나 상태를 발생시키거나 그것에 책임이 있다고 할 때 성립하는 관계로, 형이상학에서 그 본성을…","subcategory":"형이상학·인식론·논리학","level":1,"related":["determinism"],"prerequisites":[],"aliases":["인과성"]},{"slug":"necessity","title_ko":"필연성","title_en":"Necessity","meaning":"어떤 명제가 다르게 될 가능성이 전혀 없이, 모든 가능한 상황에서 참이어야만 하는 양상적 지위를 가리킨다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["contingency"],"prerequisites":[]},{"slug":"contingency","title_ko":"우연성","title_en":"Contingency","meaning":"어떤 명제가 실제로는 참이지만 다르게 될 수도 있었던, 즉 참일 수도 거짓일 수도 있는 양상적 지위를 가리킨다.","subcategory":"형이상학·인식론·논리학","level":3,"related":["necessity","determinism","banhwasilhwa-yeoksa","hindsight-bias"],"prerequisites":["necessity"]},{"slug":"identity","title_ko":"동일성","title_en":"Identity","meaning":"한 대상이 자기 자신과 맺는 관계, 또는 서로 다르게 지칭된 두 표현이 실제로는 하나의 동일한 대상을 가리키는 관계를 말한다.","subcategory":"형이상학·인식론·논리학","level":1,"related":[],"prerequisites":[]},{"slug":"free-will","title_ko":"자유의지","title_en":"Free Will","meaning":"행위자가 대안적인 여러 선택지 중 하나를 스스로 결정하여 행위할 수 있는 능력으로, 도덕적 책임의 근거로 여겨지는 철학적…","subcategory":"형이상학·인식론·논리학","level":1,"related":["determinism"],"prerequisites":[]},{"slug":"determinism","title_ko":"결정론","title_en":"Determinism","meaning":"모든 사건은 이전 사건들과 자연법칙에 의해 오직 하나의 방식으로만 일어날 수 있도록 완전히 결정되어 있다는 형이상학적…","subcategory":"형이상학·인식론·논리학","level":1,"related":["free-will","contingency"],"prerequisites":[]},{"slug":"substance","title_ko":"실체","title_en":"Substance","meaning":"다른 것에 의존하지 않고 그 자체로 독립적으로 존재하며, 여러 속성의 담지자가 되는 근본적 존재자를 가리키는 형이상학적…","subcategory":"형이상학·인식론·논리학","level":1,"related":[],"prerequisites":[]},{"slug":"natural-kind","title_ko":"자연종","title_en":"Natural Kind","meaning":"인간의 분류 관습과 무관하게 자연 자체의 구조를 반영하여 사물들을 실재하는 방식으로 묶어주는 범주를 가리키는…","subcategory":"형이상학·인식론·논리학","level":3,"related":[],"prerequisites":[],"pop":16,"aliases":["NK"]},{"slug":"epistemology","title_ko":"인식론","title_en":"Epistemology","meaning":"지식의 본성, 원천, 정당화, 한계를 탐구하는 철학의 한 분야이다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["skepticism"],"prerequisites":[],"aliases":["지식론"]},{"slug":"agrippas-trilemma","title_ko":"아그리파의 트릴레마","title_en":"Agrippa's Trilemma","meaning":"어떤 믿음을 정당화하려는 시도는 결국 무한퇴행, 순환논증, 독단적으로 정당화를 멈추는 것 중 하나로 귀결될 수밖에 없다는…","subcategory":"형이상학·인식론·논리학","level":3,"related":["skepticism"],"prerequisites":["skepticism"],"aliases":["아그리파의트릴레마"]},{"slug":"a-priori-knowledge","title_ko":"선험적 지식","title_en":"A Priori Knowledge","meaning":"감각 경험에 의존하지 않고 순수한 이성적 사고만으로 정당화될 수 있는 지식을 말한다.","subcategory":"형이상학·인식론·논리학","level":1,"related":[],"prerequisites":[],"pop":12,"aliases":["선험적지식"]},{"slug":"skepticism","title_ko":"회의주의","title_en":"Skepticism","meaning":"우리가 흔히 안다고 여기는 것들에 대해 진정한 지식이나 정당화된 믿음을 가질 수 있는지 근본적으로 의문을 제기하는 철학적…","subcategory":"형이상학·인식론·논리학","level":1,"related":["certainty"],"prerequisites":[],"aliases":["회의론"]},{"slug":"certainty","title_ko":"확실성","title_en":"Certainty","meaning":"어떤 믿음이 전혀 의심의 여지가 없을 정도로 확고하게 정당화되어 있는 인식적 상태를 가리킨다.","subcategory":"형이상학·인식론·논리학","level":2,"related":["skepticism"],"prerequisites":["skepticism"]},{"slug":"innate-ideas","title_ko":"본유관념","title_en":"Innate Ideas","meaning":"경험을 통해 습득되는 것이 아니라 태어날 때부터 정신에 이미 내재해 있다고 여겨지는 관념이나 지식을 가리키는 합리주의…","subcategory":"형이상학·인식론·논리학","level":2,"related":["tabula-rasa","rationalism","empiricism","a-priori-knowledge"],"prerequisites":["rationalism","empiricism","a-priori-knowledge"],"aliases":["생득관념"]},{"slug":"tabula-rasa","title_ko":"백지설","title_en":"Tabula Rasa","meaning":"인간의 정신은 태어날 때 아무것도 쓰여 있지 않은 백지 상태이며, 모든 지식과 관념은 경험을 통해서만 채워진다고 보는…","subcategory":"형이상학·인식론·논리학","level":2,"related":["innate-ideas","empiricism","rationalism"],"prerequisites":["empiricism","rationalism"],"pop":20,"aliases":["타불라라사"]},{"slug":"empiricism","title_ko":"경험주의","title_en":"Empiricism","meaning":"지식과 관념의 근본적 원천은 감각 경험이며, 순수한 이성만으로는 세계에 대한 실질적 지식을 얻을 수 없다고 보는 인식론적…","subcategory":"형이상학·인식론·논리학","level":1,"related":["rationalism","tabula-rasa"],"prerequisites":[],"aliases":["경험론"]},{"slug":"rationalism","title_ko":"합리주의","title_en":"Rationalism","meaning":"적어도 일부 지식은 감각 경험에 의존하지 않고 순수한 이성만으로 획득되고 정당화될 수 있다고 보는 인식론적 입장이다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["empiricism","innate-ideas","a-priori-knowledge"],"prerequisites":["empiricism","a-priori-knowledge"],"aliases":["이성주의","합리론"]},{"slug":"soundness","title_ko":"건전성","title_en":"Soundness","meaning":"논증이 형식적으로 타당하면서 동시에 모든 전제가 실제로 참인 경우를 가리키는 논리학의 개념이다.","subcategory":"형이상학·인식론·논리학","level":2,"related":["validity","premise"],"prerequisites":[]},{"slug":"abduction","title_ko":"귀추법","title_en":"Abduction","meaning":"관찰된 사실을 가장 잘 설명해주는 가설을 찾아내어 그것을 잠정적으로 받아들이는 추론 형태로, 최선의 설명으로의 추론이라고도…","subcategory":"형이상학·인식론·논리학","level":3,"related":[],"prerequisites":[],"pop":11,"aliases":["귀추추론","최선의 설명으로의 추론","Inference to the Best Explanation","최선의설명으로의추론"]},{"slug":"premise","title_ko":"논증의 전제","title_en":"Premise","meaning":"논증에서 결론을 이끌어내기 위한 근거로 제시되는 명제이다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["validity","soundness"],"prerequisites":["soundness"]},{"slug":"hasty-generalization","title_ko":"성급한 일반화의 오류","title_en":"Hasty Generalization","meaning":"충분하지 않거나 대표성이 없는 소수의 사례만을 근거로 성급하게 일반적인 결론을 이끌어내는 귀납적 오류이다.","subcategory":"형이상학·인식론·논리학","level":1,"related":[],"prerequisites":[],"pop":18,"aliases":["성급한일반화의오류"]},{"slug":"straw-man-fallacy","title_ko":"허수아비 공격의 오류","title_en":"Straw Man Fallacy","meaning":"상대방의 실제 주장을 왜곡하거나 더 약한 형태로 바꾸어 놓고, 그 왜곡된 주장을 공격함으로써 마치 원래 주장을 논박한 것처럼…","subcategory":"형이상학·인식론·논리학","level":1,"related":["ad-hominem"],"prerequisites":[],"pop":1,"aliases":["허수아비공격의오류"]},{"slug":"ad-hominem","title_ko":"인신공격의 오류","title_en":"Ad Hominem","meaning":"상대방이 제시한 주장의 내용을 논박하는 대신, 주장을 한 사람의 인격이나 배경, 동기 등을 공격하여 그 주장을 부당하게…","subcategory":"형이상학·인식론·논리학","level":1,"related":["straw-man-fallacy","tu-quoque"],"prerequisites":["straw-man-fallacy"],"aliases":["인신공격의오류"]},{"slug":"slippery-slope-fallacy","title_ko":"미끄러운 비탈길의 오류","title_en":"Slippery Slope Fallacy","meaning":"어떤 첫 단계의 조치를 취하면 충분한 근거 없이 연쇄적으로 부정적인 결과들이 필연적으로 뒤따를 것이라고 주장함으로써 그 첫…","subcategory":"형이상학·인식론·논리학","level":1,"related":["hasty-generalization"],"prerequisites":["hasty-generalization"],"pop":15,"aliases":["미끄러운비탈길의오류","미끄러운 비탈길 논증(생명윤리)"]},{"slug":"modus-ponens","title_ko":"전건 긍정식","title_en":"Modus Ponens","meaning":"'P이면 Q이다'와 'P이다'라는 두 전제로부터 'Q이다'를 타당하게 이끌어내는 가장 기본적인 연역 추론 형식이다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["validity"],"prerequisites":[],"pop":8,"aliases":["전건긍정식"]},{"slug":"syllogism","title_ko":"삼단논법","title_en":"Syllogism","meaning":"두 개의 전제와 하나의 결론으로 이루어지며, 전제에 공통으로 등장하는 매개념을 통해 결론을 도출하는 아리스토텔레스 논리학의…","subcategory":"형이상학·인식론·논리학","level":1,"related":[],"prerequisites":[]},{"slug":"reductio-ad-absurdum","title_ko":"귀류논증","title_en":"Reductio ad Absurdum","meaning":"어떤 명제가 참이라고 가정했을 때 논리적으로 모순이나 명백히 거짓인 결론이 도출됨을 보임으로써, 그 명제가 거짓임을…","subcategory":"형이상학·인식론·논리학","level":2,"related":[],"prerequisites":[],"aliases":["RAA"]},{"slug":"begging-the-question","title_ko":"선결문제 요구의 오류","title_en":"Begging the Question (Petitio Principii)","meaning":"논증하려는 결론을 증명되지 않은 채로 전제 속에 이미 가정해버려서, 실질적으로 아무것도 증명하지 못하는 논리적 오류이다.","subcategory":"형이상학·인식론·논리학","level":2,"related":["non-sequitur"],"prerequisites":[],"aliases":["Petitio Principii","선결문제요구의오류","순환논증의 오류","Circular Reasoning","순환논증의오류"]},{"slug":"non-sequitur","title_ko":"논점 일탈의 오류","title_en":"Non Sequitur","meaning":"제시된 전제로부터 결론이 논리적으로 따라 나오지 않는, 전제와 결론 사이의 관련성이 결여된 추론 오류이다.","subcategory":"형이상학·인식론·논리학","level":2,"related":["straw-man-fallacy"],"prerequisites":["straw-man-fallacy"],"pop":2,"aliases":["논점일탈의오류"]},{"slug":"appeal-to-authority","title_ko":"권위에 호소하는 오류","title_en":"Appeal to Authority (Argumentum ad Verecundiam)","meaning":"주장의 실제 근거를 제시하는 대신, 해당 분야의 전문성이 없거나 관련 없는 권위자의 견해를 근거로 삼아 결론을 정당화하려는…","subcategory":"형이상학·인식론·논리학","level":1,"related":[],"prerequisites":[],"pop":13,"aliases":["Argumentum ad Verecundiam","권위에호소하는오류"]},{"slug":"tu-quoque","title_ko":"피장파장의 오류","title_en":"Tu Quoque","meaning":"상대방의 주장 내용을 논박하는 대신, 상대방이 자신의 주장과 모순되는 행동을 했다는 점을 지적하며 그 위선을 근거로 주장을…","subcategory":"형이상학·인식론·논리학","level":2,"related":["ad-hominem","straw-man-fallacy"],"prerequisites":["ad-hominem","straw-man-fallacy"],"aliases":["피장파장의오류"]},{"slug":"utilitarianism","title_ko":"공리주의","title_en":"utilitarianism","meaning":"행위나 정책의 옳고 그름을 그것이 산출하는 전체 효용(행복·쾌락)의 총량으로 판단하는 결과주의 윤리 이론.","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["act-utilitarianism","deontology"],"prerequisites":[]},{"slug":"act-utilitarianism","title_ko":"행위 공리주의","title_en":"act utilitarianism","meaning":"개별 행위 각각이 산출할 효용을 그때그때 계산하여 옳고 그름을 판단하는 공리주의의 한 형태.","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["utilitarianism"],"prerequisites":[],"aliases":["행위공리주의"]},{"slug":"deontology","title_ko":"의무론","title_en":"deontology","meaning":"행위의 옳고 그름을 결과가 아니라 그 행위 자체가 도덕 규칙이나 의무에 부합하는지로 판단하는 윤리 이론.","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["categorical-imperative","utilitarianism"],"prerequisites":[]},{"slug":"categorical-imperative","title_ko":"정언명령","title_en":"categorical imperative","meaning":"칸트 윤리학에서 어떤 조건이나 목적과도 무관하게 이성적 존재라면 무조건 따라야 하는 도덕 명령.","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["deontology"],"prerequisites":[],"aliases":["정언명법"]},{"slug":"golden-mean","title_ko":"중용","title_en":"golden mean","meaning":"아리스토텔레스 덕윤리학에서 덕이 지나침과 모자람이라는 두 악덕 사이의 적절한 균형점에 있다고 보는 원리.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["virtue-ethics","phronesis"],"prerequisites":[]},{"slug":"negative-utilitarianism","title_ko":"부정적 공리주의","title_en":"negative utilitarianism","meaning":"행복의 증진보다 고통의 최소화를 도덕적 우선순위로 삼는 공리주의의 변형된 형태.","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["utilitarianism","preference-utilitarianism"],"prerequisites":["utilitarianism","preference-utilitarianism"],"aliases":["부정적공리주의"]},{"slug":"preference-utilitarianism","title_ko":"선호 공리주의","title_en":"preference utilitarianism","meaning":"쾌락이 아니라 개인이 지닌 선호의 충족 정도를 효용의 기준으로 삼는 공리주의의 한 형태.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["utilitarianism","negative-utilitarianism"],"prerequisites":[],"aliases":["선호공리주의"]},{"slug":"phronesis","title_ko":"프로네시스(실천적 지혜)","title_en":"phronesis","meaning":"구체적 상황에서 무엇이 옳은 행위인지를 분별하고 실천할 수 있게 하는 아리스토텔레스적 실천적 지혜.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["virtue-ethics","golden-mean"],"prerequisites":[],"pop":6,"aliases":["실천적 지혜","프로네시스","프로네시스(실천적지혜)"]},{"slug":"ethical-egoism","title_ko":"윤리적 이기주의","title_en":"ethical egoism","meaning":"각 개인은 자신의 이익을 극대화하는 방향으로 행동하는 것이 도덕적으로 옳다고 주장하는 규범 윤리 이론.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["altruism","utilitarianism"],"prerequisites":["altruism","utilitarianism"],"aliases":["윤리적이기주의"]},{"slug":"altruism","title_ko":"이타주의","title_en":"altruism","meaning":"자신의 이익보다 타인의 복지를 위해 행동하려는 동기나 그러한 행동을 옳다고 보는 윤리적 태도.","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["ethical-egoism"],"prerequisites":[]},{"slug":"metaethics","title_ko":"메타윤리학","title_en":"metaethics","meaning":"무엇이 옳고 그른가를 직접 다루기보다, 도덕적 언어와 판단, 개념 자체의 의미와 성격을 탐구하는 윤리학의 분야.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["naturalistic-fallacy"],"prerequisites":["naturalistic-fallacy"],"aliases":["상위윤리학"]},{"slug":"naturalistic-fallacy","title_ko":"자연주의적 오류","title_en":"naturalistic fallacy","meaning":"'좋음'과 같은 도덕적 속성을 쾌락이나 진화적 적응처럼 자연적 속성과 동일시하려는 시도에서 발생한다고 G. E. 무어가…","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["is-ought-problem","open-question-argument","metaethics"],"prerequisites":[],"pop":5,"aliases":["자연주의적오류"]},{"slug":"is-ought-problem","title_ko":"존재-당위 문제","title_en":"is-ought problem","meaning":"사실을 서술하는 명제로부터 논리적으로 당위(마땅히 해야 할 바)를 이끌어낼 수 없다는 흄이 제기한 철학적 문제.","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["naturalistic-fallacy","open-question-argument"],"prerequisites":[],"aliases":["존재 당위 문제","존재-당위문제","존재당위 문제"]},{"slug":"open-question-argument","title_ko":"열린 질문 논증","title_en":"open question argument","meaning":"어떤 자연적 속성으로 '좋음'을 정의하더라도 '그것이 정말 좋은가'라는 질문이 여전히 의미 있게 열려 있다는 점을 들어…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["naturalistic-fallacy","is-ought-problem"],"prerequisites":["naturalistic-fallacy","is-ought-problem"],"aliases":["OQA","열린질문논증"]},{"slug":"reflective-equilibrium","title_ko":"반성적 평형","title_en":"reflective equilibrium","meaning":"구체적 도덕 직관과 일반적 도덕 원칙을 서로 조정해가며 정합적인 균형 상태에 도달하려는 도덕적 정당화 방법론.","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["original-position"],"prerequisites":["original-position"],"pop":10,"aliases":["반성적평형"]},{"slug":"supervenience","title_ko":"수반","title_en":"supervenience","meaning":"상위 속성(예: 도덕적 속성)의 차이가 있으려면 반드시 하위 속성(예: 자연적 속성)의 차이가 있어야 하지만, 그 역은…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["naturalistic-fallacy"],"prerequisites":["naturalistic-fallacy"]},{"slug":"state-of-nature","title_ko":"자연상태","title_en":"state of nature","meaning":"국가나 정치적 권위가 성립하기 이전, 사람들이 어떤 조건에서 살아갔을지를 가정하는 사회계약론의 이론적 출발점.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["leviathan","general-will"],"prerequisites":["general-will"]},{"slug":"general-will","title_ko":"일반의지","title_en":"general will","meaning":"루소의 정치철학에서, 개별 이익의 단순한 합이 아니라 공동체 전체의 공동선을 지향하는 통합된 정치적 의지.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["republicanism"],"prerequisites":["republicanism"],"aliases":["총의"]},{"slug":"leviathan","title_ko":"리바이어던","title_en":"Leviathan","meaning":"토머스 홉스가 1651년 저서에서 제시한, 개인들이 자연상태의 혼란을 벗어나기 위해 절대적 권력을 위임한 강력한 주권 국가에…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["state-of-nature"],"prerequisites":[]},{"slug":"veil-of-ignorance","title_ko":"무지의 베일","title_en":"veil of ignorance","meaning":"롤스의 정의론에서, 자신의 사회적 지위·재능·가치관 등을 알지 못하는 가상적 조건 아래 정의의 원칙을 선택하게 하는 사고실험…","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["original-position"],"prerequisites":["original-position"],"pop":7,"aliases":["무지의베일"]},{"slug":"original-position","title_ko":"원초적 입장","title_en":"original position","meaning":"롤스가 정의의 원칙을 도출하기 위해 설정한, 무지의 베일에 가려진 합리적 당사자들이 사회 기본 구조의 원칙에 합의하는 가상적…","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["veil-of-ignorance"],"prerequisites":[],"pop":3,"aliases":["원초적입장"]},{"slug":"communitarianism","title_ko":"공동체주의","title_en":"communitarianism","meaning":"개인의 정체성과 가치가 공동체의 전통, 관계, 사회적 맥락 속에서 형성된다고 보고, 자유주의의 추상적 개인주의를 비판하는…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["liberalism","republicanism"],"prerequisites":[],"aliases":["커뮤니테리어니즘"]},{"slug":"republicanism","title_ko":"공화주의","title_en":"republicanism","meaning":"자유를 단순히 타인의 간섭이 없는 상태가 아니라 타인의 자의적 지배로부터 벗어난 '비지배' 상태로 이해하며, 시민의 정치…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["communitarianism"],"prerequisites":[]},{"slug":"paternalism","title_ko":"온정주의","title_en":"paternalism","meaning":"한 개인의 자율적 선택을 그 자신의 복지나 이익을 위해서라는 명목으로 제한하거나 간섭하는 행위 또는 정책.","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["harm-principle","liberalism"],"prerequisites":[],"pop":9,"aliases":["가부장주의","후견주의"]},{"slug":"harm-principle","title_ko":"해악의 원칙","title_en":"harm principle","meaning":"타인에게 해를 끼치는 것을 막기 위한 경우에만 개인의 자유에 대한 사회적·법적 제한이 정당화될 수 있다는 존 스튜어트 밀의…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["paternalism","liberalism"],"prerequisites":[],"pop":4,"aliases":["해악의원칙"]},{"slug":"public-reason","title_ko":"공적 이성","title_en":"public reason","meaning":"다양한 가치관을 가진 시민들이 공적 정치 영역에서 서로 받아들일 수 있는 이유만을 근거로 정치적 결정을 정당화해야 한다는…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["deliberative-democracy"],"prerequisites":[],"aliases":["공적이성"]},{"slug":"multiculturalism","title_ko":"다문화주의","title_en":"multiculturalism","meaning":"단일한 문화적 동화를 요구하기보다, 사회 안의 다양한 문화적·민족적 집단의 정체성과 관행을 정치적으로 인정하고 존중해야…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["liberalism","communitarianism"],"prerequisites":["communitarianism"]},{"slug":"anarchism","title_ko":"아나키즘","title_en":"anarchism","meaning":"국가와 같은 위계적 강제 권력이 본질적으로 부정의하거나 불필요하며, 자발적 협력에 기초한 사회 조직이 가능하다고 보는…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":[],"prerequisites":[],"aliases":["무정부주의"]},{"slug":"existentialism","title_ko":"실존주의","title_en":"existentialism","meaning":"인간 존재는 미리 정해진 본질이나 목적 없이 스스로의 선택과 행동을 통해 자신을 규정해나가는 자유롭고 책임 있는 존재라고…","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["existence-precedes-essence","authenticity","angst"],"prerequisites":[]},{"slug":"existence-precedes-essence","title_ko":"실존은 본질에 앞선다","title_en":"existence precedes essence","meaning":"인간은 미리 정해진 본질이나 목적 없이 우선 존재한 다음, 스스로의 선택을 통해 자신의 본질을 만들어간다는 사르트르…","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["existentialism","facticity"],"prerequisites":["existentialism","facticity"],"aliases":["실존은본질에앞선다"]},{"slug":"authenticity","title_ko":"진정성","title_en":"authenticity","meaning":"사회적 관습이나 타인의 기대에 순응하지 않고, 자신의 근본적 자유를 자각하며 스스로 선택한 삶을 살아가는 실존주의적 이상.","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["existentialism","dasein","thrownness"],"prerequisites":[],"aliases":["본래성"]},{"slug":"thrownness","title_ko":"피투성","title_en":"thrownness","meaning":"인간이 자신의 의지와 무관하게 특정한 시대, 신체, 문화, 상황 속에 이미 '던져진' 채로 존재를 시작한다는 하이데거의…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["dasein","facticity","authenticity"],"prerequisites":[],"aliases":["던져짐"]},{"slug":"dasein","title_ko":"현존재","title_en":"Dasein","meaning":"하이데거가 인간 존재를 가리키기 위해 사용한 용어로, 자신의 존재 자체를 문제 삼고 이해하며 살아가는 독특한 존재 방식을…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["thrownness","authenticity","facticity"],"prerequisites":[],"pop":19,"aliases":["다자인"]},{"slug":"angst","title_ko":"불안","title_en":"angst","meaning":"특정한 대상 없이 존재 자체의 근본적 자유와 무근거성, 유한성을 직면할 때 느끼는 실존적 정서 상태.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["existentialism","dasein","thrownness","authenticity"],"prerequisites":["existentialism","dasein","thrownness"]},{"slug":"absurdism","title_ko":"부조리주의","title_en":"absurdism","meaning":"삶에서 의미를 찾으려는 인간의 근본적 욕구와, 그런 의미를 제공하지 않는 무관심한 세계 사이의 근본적 불일치를 '부조리'로…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["existentialism","angst"],"prerequisites":["existentialism","angst"],"aliases":["부조리철학"]},{"slug":"the-other","title_ko":"타자","title_en":"the Other","meaning":"자아와는 근본적으로 다른, 자아의 시선과 통제를 벗어나는 독립적 주체성을 지닌 존재로서의 타인을 가리키는 현상학·실존주의…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["the-gaze","phenomenology"],"prerequisites":[]},{"slug":"the-gaze","title_ko":"시선","title_en":"the gaze","meaning":"타인의 시선에 노출됨으로써 자신이 주체가 아니라 대상화된 존재로 경험되는 현상을 가리키는 사르트르의 개념.","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["the-other","existentialism"],"prerequisites":["the-other","existentialism"],"aliases":["응시"]},{"slug":"epoche","title_ko":"판단중지","title_en":"epoché","meaning":"현상학적 탐구를 위해 대상의 실재 여부에 대한 자연적이고 일상적인 믿음을 일시적으로 괄호치고 판단을 유보하는 후설의 방법론적…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["phenomenology","intentionality"],"prerequisites":[],"aliases":["에포케"]},{"slug":"lifeworld","title_ko":"생활세계","title_en":"lifeworld","meaning":"과학적 이론화 이전에 인간이 일상적으로 경험하고 살아가는, 선(先)이론적이고 직접적인 의미의 세계를 가리키는 후설의 개념.","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["phenomenology","intersubjectivity"],"prerequisites":[]},{"slug":"intersubjectivity","title_ko":"상호주관성","title_en":"intersubjectivity","meaning":"객관적 의미와 경험의 세계가 고립된 개인의 의식이 아니라 여러 주체들 사이의 공유된 관계와 소통을 통해 구성된다는 현상학적…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["phenomenology","lifeworld","the-other"],"prerequisites":["the-other"],"aliases":["간주관성"]},{"slug":"embodiment","title_ko":"신체화","title_en":"embodiment","meaning":"인간의 의식과 경험, 인지 활동이 추상적 정신에 국한되지 않고 몸을 통해, 몸과 함께 이루어진다고 보는 철학적 개념.","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["phenomenology"],"prerequisites":[],"aliases":["체화"]},{"slug":"facticity","title_ko":"사실성","title_en":"facticity","meaning":"인간이 스스로 선택하지 않았지만 이미 주어져 있는 신체, 과거, 사회적 상황 등 구체적이고 우연적인 존재 조건을 가리키는…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["thrownness","existence-precedes-essence"],"prerequisites":[]},{"slug":"structuralism","title_ko":"구조주의","title_en":"structuralism","meaning":"개별 요소의 의미가 그 자체로서가 아니라 요소들 간의 관계로 이루어진 전체 체계(구조) 속에서 결정된다고 보는 20세기…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["post-structuralism","signifier-signified"],"prerequisites":[]},{"slug":"post-structuralism","title_ko":"후기구조주의","title_en":"Poststructuralism","meaning":"구조주의가 전제한 안정적이고 고정된 구조 개념에 의문을 제기하며, 의미의 불안정성과 권력, 욕망의 작동을 강조하는 20세기…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["structuralism"],"prerequisites":[]},{"slug":"discourse","title_ko":"담론","title_en":"discourse","meaning":"단순한 언어적 표현을 넘어, 무엇이 참되고 정상적이며 말할 수 있는 것인지를 규정하는 규칙과 권력관계를 내포한 체계적 진술의…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":[],"prerequisites":[]},{"slug":"postmodernism","title_ko":"포스트모더니즘","title_en":"postmodernism","meaning":"보편적 이성, 진보, 거대서사에 대한 근대적 신뢰에 회의를 표하며, 다원성과 상대성, 파편화된 지식을 강조하는 20세기…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["post-structuralism","hyperreality"],"prerequisites":["post-structuralism"]},{"slug":"eternal-recurrence","title_ko":"니체의 영원회귀","title_en":"eternal recurrence","meaning":"우주와 삶의 모든 사건이 무한한 시간 속에서 정확히 동일한 형태로 영원히 반복된다는 니체의 사고실험이자 윤리적 시험대.","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["ubermensch"],"prerequisites":[],"aliases":["영겁회귀"]},{"slug":"ubermensch","title_ko":"위버멘쉬","title_en":"Übermensch","meaning":"신의 죽음 이후 허무주의를 넘어, 스스로 새로운 가치를 창조하고 삶을 긍정하며 자기 자신을 끊임없이 극복해나가는 니체가…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["eternal-recurrence"],"prerequisites":[],"aliases":["초인"]},{"slug":"critical-theory","title_ko":"비판이론","title_en":"critical theory","meaning":"사회 현상을 단순히 설명하는 데 그치지 않고, 그 이면의 지배와 억압 구조를 드러내어 인간 해방을 지향하는 실천적 목적을…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":[],"prerequisites":[]},{"slug":"reification","title_ko":"물화","title_en":"reification","meaning":"인간의 관계나 사회적 과정, 살아 있는 활동이 마치 고정되고 자연스러운 사물처럼 취급되어, 그 배후의 인간적·역사적 성격이…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["alienation","false-consciousness","hegemony"],"prerequisites":[],"pop":17,"aliases":["사물화"]},{"slug":"alienation","title_ko":"소외","title_en":"alienation","meaning":"인간이 자신의 노동이나 활동의 산물, 다른 인간, 혹은 자기 자신으로부터 근본적으로 분리되고 낯설어지는 경험을 가리키는…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["reification","false-consciousness","existentialism"],"prerequisites":["reification","false-consciousness","existentialism"]},{"slug":"false-consciousness","title_ko":"허위의식","title_en":"false consciousness","meaning":"피지배 계급이 자신들의 실제 이해관계와 사회적 처지를 제대로 인식하지 못하고, 오히려 지배 계급의 이데올로기를 자신의…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["hegemony","reification"],"prerequisites":[]},{"slug":"recognition","title_ko":"인정","title_en":"recognition","meaning":"개인의 자아정체성과 존엄이 타인으로부터 자신의 가치와 존재를 인정받는 상호주관적 관계를 통해 형성되고 확인된다는 헤겔에서…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["multiculturalism","hegemony"],"prerequisites":[],"aliases":["인정투쟁"]},{"slug":"pragmatism","title_ko":"실용주의","title_en":"pragmatism","meaning":"어떤 개념이나 믿음의 의미와 진리성을 그것이 실제 행동과 경험에서 낳는 실천적 결과를 통해 평가해야 한다는 미국에서 발전한…","subcategory":"윤리학·정치철학·현대철학사조","level":1,"related":["instrumentalism"],"prerequisites":[],"aliases":["프래그머티즘"]},{"slug":"instrumentalism","title_ko":"도구주의","title_en":"instrumentalism","meaning":"이론이나 개념을 세계에 대한 문자 그대로의 참된 서술이 아니라, 문제를 해결하고 경험을 예측하며 통제하기 위한 유용한 도구로…","subcategory":"윤리학·정치철학·현대철학사조","level":2,"related":["pragmatism"],"prerequisites":[]},{"slug":"cogito-ergo-sum","title_ko":"코기토","title_en":"Cogito ergo sum","meaning":"모든 것을 의심해도 의심하고 생각하는 나의 존재만은 의심할 수 없다는 데카르트의 제1원리입니다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["certainty","rationalism"],"prerequisites":[],"aliases":["나는 생각한다, 그러므로 나는 존재한다","코기토 에르고 숨","cogito"]},{"slug":"thought-experiment","title_ko":"사고실험","title_en":"Thought Experiment","meaning":"실제로 실행하지 않고 가상의 상황을 상상해 이론이나 개념의 함축을 검토하는 방법입니다.","subcategory":"형이상학·인식론·논리학","level":1,"related":["reductio-ad-absurdum"],"prerequisites":[],"aliases":["사고 실험","Gedankenexperiment"]},{"slug":"legal-positivism","title_ko":"법실증주의","title_en":"Legal Positivism","meaning":"법의 존재와 내용은 도덕적 옳고 그름이 아니라 사회적 사실, 즉 누가 어떤 절차로 제정하고 승인했는지에 따라 정해진다는…","subcategory":"윤리학·정치철학·현대철학사조","level":3,"related":["is-ought-problem"],"prerequisites":[],"aliases":["법 실증주의","법실증론"]}]