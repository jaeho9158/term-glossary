[{"slug":"tresca-criterion","title_ko":"트레스카 기준","title_en":"Tresca Criterion","meaning":"재료 내부의 최대 전단응력이 특정 한계값에 도달하면 소성변형이 시작된다고 보는 항복조건입니다.","subcategory":"역학·재료역학","level":2,"related":[],"prerequisites":[],"aliases":["트레스카기준"]},{"slug":"critical-speed","title_ko":"위험속도","title_en":"Critical Speed","meaning":"회전축의 회전속도가 축의 굽힘 고유진동수와 일치하여 공진이 발생하는 속도입니다.","subcategory":"역학·재료역학","level":2,"related":[],"prerequisites":[]},{"slug":"euler-buckling","title_ko":"오일러 좌굴","title_en":"Euler Buckling","meaning":"가늘고 긴 탄성 기둥의 압축 좌굴하중을 기둥의 길이, 단면 강성, 지지 조건으로부터 계산하는 고전적인 이론입니다.","subcategory":"역학·재료역학","level":2,"related":[],"prerequisites":[],"aliases":["오일러좌굴"]},{"slug":"hertzian-contact-stress","title_ko":"헤르츠 접촉응력","title_en":"Hertzian Contact Stress","meaning":"곡면을 가진 두 탄성체가 맞닿을 때 접촉면 내부에 발생하는 압력 분포를 탄성 이론으로 계산한 응력입니다.","subcategory":"역학·재료역학","level":2,"related":["elastohydrodynamic-lubrication"],"prerequisites":[],"pop":9,"aliases":["헤르츠접촉응력"]},{"slug":"elastohydrodynamic-lubrication","title_ko":"탄성유체윤활","title_en":"Elastohydrodynamic Lubrication","meaning":"높은 접촉 압력 아래에서 윤활막의 유체역학적 거동과 접촉 표면의 탄성 변형이 함께 작용하는 윤활 상태입니다.","subcategory":"역학·재료역학","level":2,"related":["hertzian-contact-stress"],"prerequisites":[],"aliases":["EHL"]},{"slug":"fiber-matrix-interface","title_ko":"섬유-기지 계면","title_en":"Fiber-Matrix Interface","meaning":"복합재료를 구성하는 강화 섬유와 이를 둘러싼 기지(수지) 사이의 경계면으로, 힘이 전달되는 접합 부위입니다.","subcategory":"역학·재료역학","level":2,"related":["cohesive-zone-model"],"prerequisites":[],"aliases":["FMI","섬유 기지 계면","섬유-기지계면","섬유기지 계면"]},{"slug":"cohesive-zone-model","title_ko":"응집영역모델","title_en":"Cohesive Zone Model","meaning":"균열이 진전하기 전 균열 끝 부위에서 응력과 변위 사이의 관계를 이용해 재료의 점진적 손상과 파괴를 표현하는 수치 모델입니다.","subcategory":"역학·재료역학","level":2,"related":["fiber-matrix-interface"],"prerequisites":[],"aliases":["CZM"]},{"slug":"d-alembert-principle","title_ko":"달랑베르 원리","title_en":"D'Alembert's Principle","meaning":"관성력을 가상의 힘으로 포함시켜 동역학 문제를 정역학적 평형 문제처럼 다룰 수 있게 해주는 역학 원리입니다.","subcategory":"역학·재료역학","level":2,"related":[],"prerequisites":[],"aliases":["달랑베르원리"]},{"slug":"turbulent-boundary-layer","title_ko":"난류경계층","title_en":"Turbulent Boundary Layer","meaning":"물체 표면 근처에서 유체 흐름이 불규칙하고 소용돌이 치는 난류 상태로 발달한 경계층을 말합니다.","subcategory":"열유체·에너지시스템","level":2,"related":[],"prerequisites":[]},{"slug":"large-eddy-simulation","title_ko":"대와동시뮬레이션","title_en":"Large Eddy Simulation","meaning":"크기가 큰 소용돌이(에디)는 직접 계산하고, 격자보다 작은 미세한 소용돌이는 모델로 처리하는 난류 해석 기법입니다.","subcategory":"열유체·에너지시스템","level":2,"related":[],"prerequisites":[],"aliases":["LES"]},{"slug":"ntu-method","title_ko":"NTU법","title_en":"NTU Method","meaning":"열교환기의 전달단위수(NTU)와 열용량비, 유효도를 이용하여 출구 온도를 미리 몰라도 열교환기의 성능을 계산할 수 있는…","subcategory":"열유체·에너지시스템","level":2,"related":[],"prerequisites":[],"aliases":["전달단위수법"]},{"slug":"pump-performance-curve","title_ko":"펌프 성능곡선","title_en":"Pump Performance Curve","meaning":"펌프의 유량 변화에 따라 양정, 효율, 축동력 등이 어떻게 변하는지를 나타낸 그래프로, 펌프를 선정하고 운전점을 결정하는 데…","subcategory":"열유체·에너지시스템","level":2,"related":["net-positive-suction-head"],"prerequisites":[],"pop":3,"aliases":["펌프성능곡선"]},{"slug":"net-positive-suction-head","title_ko":"유효흡입양정","title_en":"Net Positive Suction Head","meaning":"펌프 흡입구에서 액체가 증발(캐비테이션)하지 않고 안전하게 흡입될 수 있는지를 나타내는, 압력을 수두 단위로 표현한…","subcategory":"열유체·에너지시스템","level":2,"related":["pump-performance-curve"],"prerequisites":[],"pop":7,"aliases":["NPSH"]},{"slug":"turbine-blade-cooling","title_ko":"터빈 블레이드 냉각","title_en":"Turbine Blade Cooling","meaning":"고온 연소가스에 노출되는 터빈 블레이드가 금속의 허용 온도를 넘지 않도록 냉각 공기 등을 이용해 열을 식히는 기술을 말합니다.","subcategory":"열유체·에너지시스템","level":2,"related":[],"prerequisites":[],"aliases":["터빈블레이드냉각"]},{"slug":"knocking-phenomenon","title_ko":"엔진 노킹","title_en":"Engine Knocking","meaning":"내연기관 실린더 안에서 정상적인 화염 전파가 끝나기 전에 남은 미연소 혼합기가 스스로 발화하여 급격한 압력 진동과 금속성…","subcategory":"열유체·에너지시스템","level":2,"related":[],"prerequisites":[],"aliases":["엔진노킹"]},{"slug":"journal-bearing-design","title_ko":"저널베어링 설계","title_en":"Journal Bearing Design","meaning":"회전축과 베어링 사이의 얇은 윤활유 막을 통해 미끄럼 접촉으로 하중을 지지하도록 축과 부시의 형상, 간극, 윤활 조건을…","subcategory":"기계설계·CAD/CAM","level":2,"related":[],"prerequisites":[],"aliases":["저널베어링설계"]},{"slug":"spring-design-calculation","title_ko":"스프링 설계계산","title_en":"Spring Design Calculation","meaning":"스프링 설계계산은 요구되는 하중-변위 특성과 수명을 만족하도록 스프링의 소재, 소선 지름, 코일 지름, 권수, 자유 길이 등…","subcategory":"기계설계·CAD/CAM","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["스프링설계계산"]},{"slug":"end-effector-design","title_ko":"엔드이펙터 설계","title_en":"End Effector Design","meaning":"엔드이펙터 설계는 로봇팔 등의 끝단에 부착되어 물체를 잡거나 작업을 수행하는 그리퍼, 툴 등의 형상과 구동 방식을 목적…","subcategory":"기계설계·CAD/CAM","level":2,"related":["mechatronic-system-integration"],"prerequisites":[],"pop":6,"aliases":["엔드이펙터설계"]},{"slug":"mechatronic-system-integration","title_ko":"메카트로닉스 시스템 통합","title_en":"Mechatronic System Integration","meaning":"메카트로닉스 시스템 통합은 기계, 전자, 제어, 소프트웨어 요소를 하나의 시스템으로 결합하여 설계 단계부터 유기적으로…","subcategory":"기계설계·CAD/CAM","level":2,"related":["end-effector-design"],"prerequisites":[],"aliases":["메카트로닉스시스템통합"]},{"slug":"reverse-engineering-scanning","title_ko":"3D 스캐닝 역설계","title_en":"Reverse Engineering via 3D Scanning","meaning":"실물 부품이나 시제품을 3D 스캐너로 측정하여 얻은 형상 데이터로부터 CAD 모델을 역으로 복원하는 과정입니다.","subcategory":"기계설계·CAD/CAM","level":2,"related":[],"prerequisites":[],"aliases":["3D스캐닝역설계"]},{"slug":"electrochemical-machining","title_ko":"전해가공","title_en":"Electrochemical Machining","meaning":"전해액 속에서 공작물을 양극, 공구를 음극으로 하여 전기화학적 용해 반응으로 금속 표면을 제거하는 비접촉식 특수 가공…","subcategory":"제조공정·생산자동화","level":2,"related":[],"prerequisites":[]},{"slug":"cryogenic-machining","title_ko":"극저온 가공","title_en":"Cryogenic Machining","meaning":"액체질소 등 극저온 냉매를 절삭 부위에 공급하여 절삭 온도를 크게 낮추면서 가공하는 냉각 기법입니다.","subcategory":"제조공정·생산자동화","level":2,"related":[],"prerequisites":[],"aliases":["극저온가공"]},{"slug":"forging-process","title_ko":"단조공정","title_en":"Forging Process","meaning":"금속 소재에 압축력을 가해 소성변형시킴으로써 원하는 형상과 기계적 성질을 부여하는 금속 성형 가공법입니다.","subcategory":"제조공정·생산자동화","level":2,"related":[],"prerequisites":[]},{"slug":"deep-drawing-process","title_ko":"딥드로잉 공정","title_en":"Deep Drawing Process","meaning":"평평한 금속 판재를 펀치로 다이 안으로 밀어 넣어 이음매 없는 컵 형상 등 깊이가 있는 용기 형태로 성형하는 판재가공…","subcategory":"제조공정·생산자동화","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["딥드로잉공정"]},{"slug":"kanban-system","title_ko":"칸반 시스템","title_en":"Kanban System","meaning":"카드나 신호판을 이용해 후속 공정의 실제 소비량에 맞춰 앞 공정의 생산과 자재 이동을 지시하는 시각적 생산 관리 기법입니다.","subcategory":"제조공정·생산자동화","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["칸반시스템"]},{"slug":"compressor-surge-stall","title_ko":"압축기 서지·스톨","title_en":"Compressor Surge and Stall","meaning":"압축기의 유량이 일정 한계 이하로 줄어들 때 발생하는 국소적인 유동 박리(스톨)와 시스템 전체가 진동하며 유량이 역류하는…","subcategory":"열유체기계","level":2,"related":[],"prerequisites":[],"pop":2,"aliases":["압축기 서지 스톨","압축기 서지스톨","압축기서지·스톨"]},{"slug":"heat-exchanger-effectiveness-ntu","title_ko":"열교환기 유효도-NTU법","title_en":"Heat Exchanger Effectiveness-NTU Method","meaning":"열교환기 출구 온도를 모르는 상태에서도 유효도(effectiveness)와 전열단위수(NTU)라는 무차원 변수를 이용해…","subcategory":"열전달","level":2,"related":[],"prerequisites":[],"aliases":["HEENM","열교환기 유효도 NTU법","열교환기 유효도NTU법","열교환기유효도-NTU법"]},{"slug":"four-bar-linkage-synthesis","title_ko":"4절 링크 합성","title_en":"Four-Bar Linkage Synthesis","meaning":"고정 링크를 포함한 4개의 링크와 4개의 회전 관절로 이루어진 4절 링크 기구에서, 원하는 운동 경로나 동작을 만들어내도록…","subcategory":"기구학","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["4절링크합성","FBLS"]},{"slug":"condition-based-maintenance","title_ko":"상태기반유지보수","title_en":"Condition-Based Maintenance","meaning":"설비의 실제 상태를 센서로 감시한 결과에 따라 필요한 시점에만 유지보수를 수행하는 전략입니다.","subcategory":"스마트제조","level":2,"related":[],"prerequisites":[],"aliases":["CBM"]},{"slug":"strain-gauge-rosette-analysis","title_ko":"스트레인게이지 로제트 해석","title_en":"Strain Gauge Rosette Analysis","meaning":"서로 다른 각도로 배치된 여러 개의 스트레인게이지를 이용해 한 지점의 변형률을 측정하고 주응력과 방향을 계산하는 실험 해석…","subcategory":"실험역학","level":2,"related":["photoelastic-stress-analysis"],"prerequisites":[],"aliases":["SGRA","스트레인게이지로제트해석"]},{"slug":"photoelastic-stress-analysis","title_ko":"광탄성 응력해석","title_en":"Photoelastic Stress Analysis","meaning":"응력을 받으면 빛의 복굴절 성질이 변하는 투명 재료의 특성을 이용해 편광을 통과시켜 응력 분포를 시각적인 무늬로 관찰하는…","subcategory":"실험역학","level":2,"related":["strain-gauge-rosette-analysis"],"prerequisites":[],"aliases":["광탄성응력해석"]},{"slug":"micro-electro-mechanical-systems-resonator","title_ko":"MEMS 공진기","title_en":"MEMS Resonator","meaning":"반도체 미세가공 공정으로 제작된 마이크로미터 크기의 기계 구조물이 특정 주파수에서 진동하도록 만든 초소형 공진 소자입니다.","subcategory":"미세기계공학","level":2,"related":[],"prerequisites":[],"aliases":["MEMS공진기"]},{"slug":"deep-drawing-process-analysis","title_ko":"딥드로잉 공정해석","title_en":"Deep Drawing Process Analysis","meaning":"평평한 금속판을 펀치로 눌러 컵이나 용기 형태로 성형하는 딥드로잉 공정에서 발생하는 재료 변형과 결함을 분석하는 연구…","subcategory":"소성가공","level":2,"related":[],"prerequisites":[],"aliases":["DDPA","딥드로잉공정해석"]},{"slug":"tool-wear-mechanism-machining","title_ko":"절삭공구 마모 메커니즘","title_en":"Tool Wear Mechanism in Machining","meaning":"절삭가공 중 공구와 공작물, 절삭칩이 접촉하면서 공구 표면이 점진적으로 손상·소모되는 다양한 물리적·화학적 현상을 통틀어…","subcategory":"가공공정","level":2,"related":[],"prerequisites":[],"aliases":["TWMM","절삭공구마모메커니즘"]},{"slug":"vehicle-suspension-dynamics","title_ko":"차량 현가장치 동역학","title_en":"Vehicle Suspension Dynamics","meaning":"차량이 노면의 요철을 지날 때 스프링, 댐퍼 등으로 구성된 현가장치가 어떻게 진동하고 차체와 바퀴의 움직임을 제어하는지를…","subcategory":"차량공학","level":2,"related":["aerodynamic-drag-reduction-vehicle"],"prerequisites":[],"aliases":["VSD","차량현가장치동역학"]},{"slug":"aerodynamic-drag-reduction-vehicle","title_ko":"차량 공력저항 저감","title_en":"Vehicle Aerodynamic Drag Reduction","meaning":"차량이 주행할 때 공기와 부딪히며 발생하는 공기저항을 차체 형상이나 부속 장치를 개선해 줄이는 기술입니다.","subcategory":"차량공학","level":2,"related":["vehicle-suspension-dynamics"],"prerequisites":[],"aliases":["VADR","차량공력저항저감"]},{"slug":"origami-inspired-structure","title_ko":"오리가미 영감 구조","title_en":"Origami-Inspired Structure","meaning":"종이접기(오리가미)의 접힘 패턴 원리를 응용해, 평평하게 접었다가 원하는 형태로 펼쳐지거나 변형되는 기계 구조를 설계하는…","subcategory":"기구학","level":2,"related":["exoskeleton-assistive-device"],"prerequisites":[],"aliases":["오리가미영감구조"]},{"slug":"exoskeleton-assistive-device","title_ko":"외골격 보조장치","title_en":"Exoskeleton Assistive Device","meaning":"사람의 몸에 착용해 관절의 움직임을 보조하거나 힘을 더해줌으로써 근력을 보강하거나 재활을 돕는 웨어러블 로봇 장치입니다.","subcategory":"로봇공학","level":2,"related":["origami-inspired-structure","servo-hydraulic-actuation-system"],"prerequisites":[],"aliases":["외골격보조장치"]},{"slug":"servo-hydraulic-actuation-system","title_ko":"서보유압 구동시스템","title_en":"Servo-Hydraulic Actuation System","meaning":"서보밸브로 유압유의 흐름을 정밀하게 제어하여 큰 힘을 빠르고 정확하게 원하는 위치·속도로 구동하는 시스템입니다.","subcategory":"유압공압시스템","level":2,"related":["exoskeleton-assistive-device"],"prerequisites":[],"aliases":["SHAS","서보유압구동시스템"]}]