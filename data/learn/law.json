[{"slug":"pcr","title_ko":"중합효소연쇄반응","title_en":"PCR","meaning":"DNA의 특정 부위를 온도를 반복적으로 바꿔가며 짧은 시간 안에 수백만 배로 복제하는 실험 기법이다.","subcategory":"세포·분자생물학","level":3,"related":["crispr","mass-spectrometry","calibration-curve","electrophoresis"],"prerequisites":["crispr"],"aliases":["폴리머라아제 연쇄반응","Polymerase Chain Reaction"]},{"slug":"measurement-uncertainty","title_ko":"측정불확도","title_en":"Measurement Uncertainty","meaning":"측정한 양의 값이라고 합리적으로 볼 수 있는 값들이 얼마나 퍼져 있는지를 숫자로 표현한, 측정 결과에 딸린 \"의심의 폭\"이다.","subcategory":"실험기기·측정장비","level":1,"related":["calibration-curve","standard-deviation"],"prerequisites":[],"aliases":["측정 불확실도"]},{"slug":"property-rights","title_ko":"재산권","title_en":"Property Rights","meaning":"어떤 자원이나 자산을 소유한 사람이 그것을 마음대로 쓰고, 그로부터 이익을 얻고, 남에게 팔거나 넘길 수 있도록 법으로…","subcategory":"미시경제","level":2,"related":["tragedy-of-the-commons","market-economy","transaction-cost","rent-seeking"],"prerequisites":["tragedy-of-the-commons"],"aliases":["Property Right"]},{"slug":"technology-transfer","title_ko":"기술이전","title_en":"Technology Transfer","meaning":"대학이나 공공연구기관에서 개발된 연구 성과와 지식재산을 기업이나 산업체로 이전하여 실제 제품이나 서비스로 상용화하는 활동.","subcategory":"경영·조직","level":1,"related":["triple-helix-model","valley-of-death-innovation","technology-readiness-level","appropriate-technology"],"prerequisites":[]},{"slug":"social-fundamental-rights","title_ko":"사회적 기본권","title_en":"Social Fundamental Rights","meaning":"국민이 인간다운 생활을 영위하기 위해 국가에 적극적인 급부나 배려를 요구할 수 있는 기본권으로, 교육권·근로권·사회보장수급권…","subcategory":"헌법·행정법·형법 개념","level":3,"related":[],"prerequisites":[],"aliases":["사회적기본권"]},{"slug":"dissolution-of-political-parties","title_ko":"정당해산심판","title_en":"Adjudication on Dissolution of Political Parties","meaning":"정당의 목적이나 활동이 민주적 기본질서에 위배될 때 정부의 제소에 따라 헌법재판소가 그 정당의 해산 여부를 결정하는 심판이다.","subcategory":"헌법·행정법·형법 개념","level":3,"related":[],"prerequisites":[],"aliases":["ADPP"]},{"slug":"prohibition-of-comprehensive-delegation","title_ko":"포괄위임금지원칙","title_en":"Prohibition of Comprehensive Delegation","meaning":"법률이 대통령령 등 하위법령에 입법사항을 위임할 때에는 위임의 목적·내용·범위를 구체적으로 정해야 하며, 포괄적·백지적으로…","subcategory":"헌법·행정법·형법 개념","level":1,"related":[],"prerequisites":[],"pop":5,"aliases":["포괄위임금지"]},{"slug":"double-jeopardy-prohibition","title_ko":"이중처벌금지원칙","title_en":"Prohibition of Double Jeopardy","meaning":"동일한 범죄행위에 대하여 국가가 형사절차상 거듭 처벌할 수 없다는 헌법상 원칙이다.","subcategory":"헌법·행정법·형법 개념","level":1,"related":[],"prerequisites":[],"pop":4,"aliases":["PDJ"]},{"slug":"reflective-interest","title_ko":"반사적 이익","title_en":"Reflective Interest","meaning":"법이 공익을 보호하기 위해 행정청에게 일정한 의무를 부과한 결과 개인이 사실상 누리게 되는 이익으로, 법률상 보호되는 이익이…","subcategory":"헌법·행정법·형법 개념","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["반사적이익"]},{"slug":"juridical-act","title_ko":"법률행위","title_en":"Juridical Act","meaning":"당사자가 원하는 법률효과를 발생시키려는 의사표시를 요소로 하여 이루어지는 사법상의 행위로, 계약·단독행위·합동행위를 포괄하는…","subcategory":"민법·상법·국제법 개념","level":1,"related":["declaration-of-intention","private-autonomy"],"prerequisites":[],"pop":2},{"slug":"declaration-of-intention","title_ko":"의사표시","title_en":"Declaration of Intention","meaning":"일정한 법률효과의 발생을 원하는 내심의 의사를 외부에 표시하는 행위로, 법률행위를 구성하는 가장 핵심적인 요소이다.","subcategory":"민법·상법·국제법 개념","level":1,"related":["juridical-act","private-autonomy"],"prerequisites":[],"pop":15},{"slug":"private-autonomy","title_ko":"사적자치의 원칙","title_en":"Principle of Private Autonomy","meaning":"개인이 자신의 법률관계를 자기의 자유로운 의사에 따라 스스로 형성할 수 있다는 근대 사법의 기본원리로, 계약자유·소유권 자유…","subcategory":"민법·상법·국제법 개념","level":1,"related":["juridical-act"],"prerequisites":[],"pop":3,"aliases":["사적자치의원칙"]},{"slug":"pledge","title_ko":"질권","title_en":"Pledge","meaning":"채권자가 채권의 담보로 채무자 또는 제3자로부터 인도받은 동산이나 재산권을 유치하고, 채무 불이행 시 그 목적물로부터…","subcategory":"민법·상법·국제법 개념","level":1,"related":[],"prerequisites":[],"pop":7},{"slug":"creditors-revocation-right","title_ko":"채권자취소권","title_en":"Creditor's Right of Revocation (Actio Pauliana)","meaning":"채무자가 채권자를 해함을 알면서 재산을 감소시키는 법률행위(사해행위)를 한 경우, 채권자가 그 행위를 취소하고 재산을…","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"aliases":["Actio Pauliana"]},{"slug":"management-of-affairs-without-mandate","title_ko":"사무관리","title_en":"Management of Affairs without Mandate (Negotiorum Gestio)","meaning":"법률상 또는 계약상 의무 없이 타인을 위하여 그의 사무를 관리함으로써 발생하는 법정채권관계이다.","subcategory":"민법·상법·국제법 개념","level":3,"related":["juridical-act"],"prerequisites":[],"aliases":["MAWM","Negotiorum Gestio"]},{"slug":"juridical-personality","title_ko":"법인격","title_en":"Juridical Personality","meaning":"자연인이 아닌 단체나 재산의 집합에 대하여 법률이 권리와 의무의 주체가 될 수 있는 지위를 부여하는 것을 말한다.","subcategory":"민법·상법·국제법 개념","level":1,"related":["juridical-act"],"prerequisites":[]},{"slug":"sovereign-immunity","title_ko":"주권면제","title_en":"Sovereign Immunity","meaning":"국가의 주권적 지위에서 비롯되어 외국 법원의 재판권과 강제집행으로부터 국가 및 그 재산이 면제되는 원칙으로, 재판권 면제와…","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"pop":6,"aliases":["국가면제","State Immunity"]},{"slug":"geneva-conventions","title_ko":"제네바협약","title_en":"Geneva Conventions","meaning":"전쟁 희생자 보호를 목적으로 하는 4개의 국제협약으로, 부상병, 포로, 민간인 보호에 관한 국제인도법의 핵심 규범을 이룬다.","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"aliases":["제네바조약"]},{"slug":"countermeasures","title_ko":"대응조치","title_en":"Countermeasures","meaning":"국제위법행위의 피해국이 가해국으로 하여금 위법행위를 중단하고 배상하도록 압박하기 위하여, 본래 위법하지만 대응조치로서…","subcategory":"민법·상법·국제법 개념","level":3,"related":[],"prerequisites":[],"pop":8},{"slug":"rigor-mortis-meat","title_ko":"사후강직","title_en":"Rigor Mortis","meaning":"도축 후 ATP 고갈로 근육의 액틴과 미오신이 비가역적으로 결합해 근육이 뻣뻣해지는 사후 생화학적 변화.","subcategory":"축산물이용·낙농학","level":2,"related":["pale-soft-exudative-meat","dark-firm-dry-meat"],"prerequisites":[],"aliases":["시강"]},{"slug":"locard-exchange-principle","title_ko":"로카르 교환법칙","title_en":"Locard's Exchange Principle","meaning":"로카르 교환법칙은 두 물체나 사람이 접촉하면 반드시 물질의 상호 이동이 일어난다는 법과학의 기본 원리이다.","subcategory":"기초이론","level":2,"related":[],"prerequisites":[],"aliases":["로카르교환법칙"]},{"slug":"bloodstain-pattern-analysis","title_ko":"혈흔형태분석","title_en":"Bloodstain Pattern Analysis","meaning":"혈흔형태분석이란 현장에 남은 혈흔의 모양, 크기, 분포를 물리학적으로 분석하여 사건 발생 과정을 재구성하는 법과학 기법이다.","subcategory":"혈흔분석","level":2,"related":[],"prerequisites":[]},{"slug":"psychological-autopsy","title_ko":"심리부검","title_en":"Psychological Autopsy","meaning":"사망 경위가 불분명한 사건에서 고인의 생전 심리 상태와 생활을 주변인 면담과 기록 검토를 통해 재구성하여 사망 방식을…","subcategory":"법정신의학","level":2,"related":[],"prerequisites":[]},{"slug":"office-action","title_ko":"의견제출통지서","title_en":"Office Action","meaning":"심사관이 출원 발명에 거절이유를 발견했을 때 이를 출원인에게 알리고 의견 제출 기회를 주는 공식 통지서이다.","subcategory":"특허출원·심사","level":2,"related":[],"prerequisites":[],"aliases":["거절이유통지"]},{"slug":"continuation-application","title_ko":"계속출원","title_en":"Continuation Application","meaning":"원출원과 동일한 명세서 내용을 기초로 하되 청구범위만 새롭게 구성하여, 원출원의 출원일 이익을 유지한 채 계속 심사를…","subcategory":"특허출원·심사","level":2,"related":[],"prerequisites":[],"aliases":["파일래퍼 계속출원","File Wrapper Continuation"]},{"slug":"doctrine-of-equivalents","title_ko":"균등론","title_en":"Doctrine of Equivalents","meaning":"침해 대상 제품이 특허 청구항의 문언 그대로는 아니지만 실질적으로 동일한 기술적 수단·기능·결과를 가진 경우, 이를 특허권…","subcategory":"특허분쟁·소송","level":2,"related":[],"prerequisites":[],"aliases":["균등침해","균등침해론"]},{"slug":"certification-mark","title_ko":"증명표장","title_en":"Certification Mark","meaning":"상품이나 서비스의 품질, 원산지, 생산방법 등 특정 기준의 충족 여부를 증명하기 위해 사용하는 표장이다.","subcategory":"상표법","level":2,"related":[],"prerequisites":[]},{"slug":"non-exclusive-license","title_ko":"통상실시권","title_en":"Non-Exclusive License","meaning":"특허권자가 여러 실시권자에게 동시에 부여할 수 있는, 독점적이지 않은 실시 허락이다.","subcategory":"라이선싱·기술이전","level":2,"related":[],"prerequisites":[],"aliases":["NEL"]},{"slug":"grant-back-clause","title_ko":"그랜트백 조항","title_en":"Grant-Back Clause","meaning":"실시권자가 라이선스받은 기술을 개량했을 때 그 개량 기술에 대한 권리나 실시권을 원권리자에게도 부여하도록 정한 계약 조항이다.","subcategory":"라이선싱·기술이전","level":2,"related":["technology-transfer"],"prerequisites":[],"aliases":["그랜트백조항"]},{"slug":"capillary-electrophoresis-dna","title_ko":"모세관 전기영동","title_en":"Capillary Electrophoresis","meaning":"가느다란 모세관 안에서 전기장을 이용해 DNA 조각을 크기별로 분리하고 검출하는, 법유전학 STR 분석의 핵심 장비 기술이다.","subcategory":"법유전학","level":2,"related":["agarose-gel-electrophoresis","bioanalyzer-tapestation"],"prerequisites":[],"aliases":["CE","모세관전기영동법"]},{"slug":"biogeographic-ancestry-inference","title_ko":"생물지리학적 조상추정","title_en":"Biogeographic Ancestry Inference","meaning":"DNA에 나타나는 유전적 특징을 이용해 개인의 조상이 지리적으로 어느 인구집단과 가까운지를 통계적으로 추정하는 법유전학…","subcategory":"법유전학","level":2,"related":[],"prerequisites":[],"aliases":["생물지리학적조상추정"]},{"slug":"expirated-blood-pattern","title_ko":"호기성 혈흔 패턴","title_en":"Expirated Blood Pattern","meaning":"코나 입, 기도 등에 출혈이 있는 사람이 숨을 내쉬거나 기침, 재채기를 할 때 공기와 함께 뿜어져 나온 혈액이 만드는 미세한…","subcategory":"혈흔분석","level":2,"related":[],"prerequisites":[],"aliases":["호기성혈흔패턴"]},{"slug":"petechial-hemorrhage","title_ko":"점상출혈","title_en":"Petechial Hemorrhage","meaning":"모세혈관이 파열되어 피부나 점막에 생기는 아주 작은 붉은 반점 형태의 출혈을 말한다.","subcategory":"법의병리학","level":2,"related":[],"prerequisites":[],"aliases":["일혈점","점출혈","타르디외 반점"]},{"slug":"chain-of-custody-forensic-evidence","title_ko":"법과학 증거보관연속성","title_en":"Chain of Custody in Forensic Evidence","meaning":"증거물이 수집된 순간부터 법정에 제출되기까지 누가, 언제, 어떻게 다루었는지를 문서로 빠짐없이 기록하고 관리하는 절차이다.","subcategory":"증거관리","level":2,"related":[],"prerequisites":[],"aliases":["CCFE","법과학증거보관연속성"]},{"slug":"ip-commercialization-policy","title_ko":"지식재산 사업화정책","title_en":"IP Commercialization Policy","meaning":"특허, 상표 등으로 보호되는 발명과 기술이 실제 제품이나 사업으로 이어지도록 기술이전, 창업지원, 투자연계 등을 촉진하는…","subcategory":"지식재산 정책·제도","level":2,"related":[],"prerequisites":[],"aliases":["IP Commercialization Policy","지식재산사업화정책"]},{"slug":"ip-education-policy","title_ko":"지식재산 교육정책","title_en":"IP Education Policy","meaning":"초중등학교부터 대학, 산업 현장에 이르기까지 지식재산에 대한 이해와 활용 역량을 높이기 위해 정부와 교육기관이 추진하는…","subcategory":"지식재산 정책·제도","level":2,"related":[],"prerequisites":[],"aliases":["IP Education Policy","지식재산교육정책"]},{"slug":"patent-exhaustion-doctrine","title_ko":"특허권소진이론","title_en":"Patent Exhaustion Doctrine","meaning":"특허권자 또는 그 허락을 받은 자가 특허 제품을 적법하게 판매한 이후에는 그 특정 제품에 대한 특허권 행사가 소진되어…","subcategory":"특허법 기초","level":2,"related":[],"prerequisites":[],"aliases":["Patent Exhaustion Doctrine"]},{"slug":"public-transmission-right","title_ko":"공중송신권","title_en":"Right of Public Transmission","meaning":"저작물을 공중이 수신하거나 접근하게 할 목적으로 무선 또는 유선통신의 방법으로 송신하거나 이용에 제공할 권리를 말하며…","subcategory":"저작권법","level":2,"related":[],"prerequisites":[],"aliases":["Right of Public Transmission"]},{"slug":"trade-dress-protection","title_ko":"트레이드드레스 보호","title_en":"Trade Dress Protection","meaning":"상품이나 매장의 전체적인 외관, 디자인, 색채, 배치 등 종합적 이미지가 특정 출처를 나타내는 식별표지로서 보호받는 개념이다.","subcategory":"상표법","level":2,"related":[],"prerequisites":[],"aliases":["Trade Dress Protection","트레이드드레스보호"]},{"slug":"royalty-free-license","title_ko":"로열티프리 라이선스","title_en":"Royalty-Free License","meaning":"실시허락을 하면서 별도의 실시료(로열티)를 받지 않거나, 최초 일시금 외에 추가적인 경상 로열티를 부과하지 않는 형태의…","subcategory":"라이선싱·기술이전","level":1,"related":[],"prerequisites":[],"aliases":["RFL","로열티프리라이선스"]},{"slug":"synthetic-biology-patentability","title_ko":"합성생물학 발명의 특허성","title_en":"Patentability of Synthetic Biology Inventions","meaning":"기존 생명체를 개량하는 것을 넘어 유전자 회로 설계 등을 통해 새로운 생물학적 시스템을 인위적으로 합성·구축하는 합성생물학…","subcategory":"신지식재산(AI·데이터·바이오)","level":1,"related":["synthetic-biology"],"prerequisites":[],"aliases":["PSBI","합성생물학발명의특허성"]},{"slug":"ip-dispute-mediation-system","title_ko":"지식재산 분쟁조정제도","title_en":"IP Dispute Mediation System","meaning":"특허·상표·저작권 등 지식재산권을 둘러싼 분쟁을 정식 소송에 앞서 조정위원회 등을 통해 신속하고 저렴하게 해결할 수 있도록…","subcategory":"지식재산 정책·제도","level":1,"related":[],"prerequisites":[],"aliases":["IDMS","지식재산분쟁조정제도"]},{"slug":"first-to-file-principle","title_ko":"선출원주의","title_en":"First-to-File Principle","meaning":"동일한 발명에 대해 여러 사람이 각각 특허출원을 한 경우, 실제 발명을 먼저 완성한 사람이 아니라 특허청에 먼저 출원한…","subcategory":"특허법 기초","level":1,"related":[],"prerequisites":[]},{"slug":"cease-and-desist-letter-patent","title_ko":"특허침해 경고장","title_en":"Cease-and-Desist Letter in Patent Disputes","meaning":"특허권자가 자신의 특허가 침해되고 있다고 판단할 때, 소송을 제기하기에 앞서 상대방에게 침해 사실을 통지하고 실시 중단이나…","subcategory":"특허분쟁·소송","level":1,"related":[],"prerequisites":[],"aliases":["CDLPD","특허침해경고장"]},{"slug":"sep-declaration-system","title_ko":"표준특허 선언제도","title_en":"SEP Declaration System","meaning":"표준화기구가 특정 표준을 제정하는 과정에서, 그 표준을 실시하는 데 필요할 것으로 예상되는 특허를 보유한 자가 해당 특허를…","subcategory":"표준특허·FRAND","level":1,"related":[],"prerequisites":[],"aliases":["표준특허선언제도"]},{"slug":"design-functionality-doctrine","title_ko":"기능적 형상의 디자인 보호 제외","title_en":"Functionality Doctrine in Design Law","meaning":"물품의 기능을 확보하기 위해 불가피하게 정해지는 형상은 디자인권으로 보호하지 않는다는 원칙으로, 기술적 아이디어의 독점은…","subcategory":"디자인보호법","level":1,"related":[],"prerequisites":[]},{"slug":"trademark-coexistence-agreement","title_ko":"상표 공존계약","title_en":"Trademark Coexistence Agreement","meaning":"유사한 상표를 사용하는 둘 이상의 당사자가 각자의 사용 범위·지역·상품을 정하여 서로의 상표 사용을 용인하고 분쟁을…","subcategory":"상표법","level":1,"related":[],"prerequisites":[]},{"slug":"customs-border-measures-ip","title_ko":"지식재산권 국경조치(통관보류)","title_en":"Customs Border Measures for IP Rights","meaning":"세관이 수출입 물품 가운데 지식재산권을 침해하는 물품의 통관을 보류하거나 유치하여 국경 단계에서 침해를 차단하는 제도로…","subcategory":"지식재산 정책·제도","level":1,"related":[],"prerequisites":[]},{"slug":"patent-misuse","title_ko":"특허권 남용 항변","title_en":"Patent Misuse Defense","meaning":"특허권자가 특허의 정당한 범위를 벗어나 끼워팔기·만료 후 로열티 징수 등 반경쟁적 방식으로 권리를 행사한 경우, 침해자가 그…","subcategory":"특허분쟁·소송","level":1,"related":["patent-exhaustion-doctrine"],"prerequisites":[]},{"slug":"personal-information-protection-act","title_ko":"개인정보 보호법","title_en":"Personal Information Protection Act (PIPA)","meaning":"개인정보의 처리와 보호에 관한 사항을 정하여 개인의 자유와 권리를 보호하고 개인의 존엄과 가치를 구현하려는 대한민국 법률이다.","subcategory":"헌법·행정법·형법 개념","level":2,"related":[],"prerequisites":[],"aliases":["개인정보보호법","PIPA","Personal Information Protection Act"]}]