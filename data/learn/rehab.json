[{"slug":"case-management","title_ko":"사례관리","title_en":"Case Management","meaning":"복잡한 건강문제를 가진 환자의 치료 과정을 조정하여 비용효율적이고 연속적인 돌봄을 제공하는 간호관리 접근법.","subcategory":"임상간호·간호관리","level":1,"related":["critical-pathway","vocational-rehabilitation"],"prerequisites":[],"aliases":["Case Management in Rehabilitation","케이스매니지먼트"]},{"slug":"neurodevelopmental-treatment","title_ko":"신경발달치료","title_en":"Neurodevelopmental Treatment (NDT)","meaning":"비정상적인 근긴장과 움직임 패턴을 정상적인 움직임으로 유도해 기능 회복을 돕는 신경계 재활 접근법입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["rood-approach"],"prerequisites":[]},{"slug":"modified-ashworth-scale","title_ko":"수정애쉬워스척도","title_en":"Modified Ashworth Scale","meaning":"근육을 수동적으로 움직일 때 느껴지는 저항의 정도를 0부터 4까지 등급으로 나눠 경직을 평가하는 임상 척도입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["muscle-tone","clonus"],"prerequisites":[],"pop":3},{"slug":"berg-balance-scale","title_ko":"버그균형척도","title_en":"Berg Balance Scale","meaning":"앉기, 서기, 방향 전환 등 14개 항목을 통해 균형 능력과 낙상 위험도를 평가하는 표준화된 검사 도구입니다.","subcategory":"물리치료학·재활의학","level":1,"related":[],"prerequisites":[],"pop":7,"aliases":["BBS"]},{"slug":"transcutaneous-electrical-nerve-stimulation","title_ko":"경피신경전기자극","title_en":"Transcutaneous Electrical Nerve Stimulation (TENS)","meaning":"피부 표면에 부착한 전극을 통해 낮은 강도의 전류를 흘려 통증 신호를 조절하는 전기치료 기법입니다.","subcategory":"물리치료학·재활의학","level":2,"related":["neuromuscular-electrical-stimulation"],"prerequisites":["neuromuscular-electrical-stimulation"],"aliases":["TENS"]},{"slug":"neuromuscular-electrical-stimulation","title_ko":"신경근전기자극","title_en":"Neuromuscular Electrical Stimulation (NMES)","meaning":"전기 자극으로 운동신경을 활성화해 근육을 수축시켜 근력을 강화하거나 근위축을 예방하는 치료 기법입니다.","subcategory":"물리치료학·재활의학","level":1,"related":[],"prerequisites":[],"pop":19,"aliases":["NMES"]},{"slug":"rood-approach","title_ko":"루드접근법","title_en":"Rood Approach","meaning":"피부와 고유수용감각에 대한 특정 감각 자극을 이용해 근긴장과 운동 반응을 조절하는 신경생리학적 치료 접근법입니다.","subcategory":"물리치료학·재활의학","level":3,"related":["neurodevelopmental-treatment","muscle-tone","proprioception"],"prerequisites":["neurodevelopmental-treatment","muscle-tone"],"pop":12},{"slug":"muscle-tone","title_ko":"근긴장도","title_en":"Muscle Tone","meaning":"근육이 안정된 상태에서도 유지하고 있는 저항력, 즉 근육의 긴장 정도를 말합니다.","subcategory":"물리치료학·재활의학","level":1,"related":["modified-ashworth-scale"],"prerequisites":[]},{"slug":"hemiplegia","title_ko":"편마비","title_en":"Hemiplegia","meaning":"뇌의 한쪽 손상으로 인해 반대쪽 몸의 팔과 다리에 마비가 생기는 상태입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["hemispatial-neglect"],"prerequisites":[]},{"slug":"paraplegia","title_ko":"대마비","title_en":"Paraplegia","meaning":"척수 손상으로 인해 양쪽 다리에 마비가 생기고 팔은 정상적으로 기능하는 상태입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["wheelchair","weight-bearing"],"prerequisites":["wheelchair","weight-bearing"]},{"slug":"deep-tendon-reflex","title_ko":"심부건반사","title_en":"Deep Tendon Reflex (DTR)","meaning":"힘줄을 타진했을 때 나타나는 불수의적인 근육 수축 반응으로, 신경계의 상태를 확인하는 기본적인 검사입니다.","subcategory":"물리치료학·재활의학","level":2,"related":["clonus","muscle-tone"],"prerequisites":["clonus"],"pop":20,"aliases":["DTR"]},{"slug":"clonus","title_ko":"간대성경련","title_en":"Clonus","meaning":"근육을 갑자기 늘렸을 때 리듬감 있게 반복적으로 수축과 이완이 일어나는 비정상적인 반사 현상입니다.","subcategory":"물리치료학·재활의학","level":2,"related":["deep-tendon-reflex","modified-ashworth-scale"],"prerequisites":["modified-ashworth-scale"]},{"slug":"step-length","title_ko":"보장","title_en":"Step Length","meaning":"한쪽 발이 지면에 닿은 지점부터 반대쪽 발이 지면에 닿는 지점까지의 거리입니다.","subcategory":"물리치료학·재활의학","level":2,"related":["gait-analysis","hemiplegia"],"prerequisites":["hemiplegia"]},{"slug":"assistive-device","title_ko":"보조기구","title_en":"Assistive Device","meaning":"이동이나 일상생활 동작을 수행하는 데 도움을 주는 지팡이, 보행기, 휠체어 등의 기구를 통칭합니다.","subcategory":"물리치료학·재활의학","level":1,"related":["wheelchair"],"prerequisites":[]},{"slug":"knee-ankle-foot-orthosis","title_ko":"장하지보조기","title_en":"Knee-Ankle-Foot Orthosis (KAFO)","meaning":"무릎부터 발까지 넓은 범위를 지지해 무릎과 발목의 안정성을 함께 제공하는 보조기입니다.","subcategory":"물리치료학·재활의학","level":3,"related":["weight-bearing"],"prerequisites":["weight-bearing"],"aliases":["KAFO"]},{"slug":"prosthesis","title_ko":"의지","title_en":"Prosthesis","meaning":"절단으로 상실된 신체 부위를 대체하기 위해 제작되는 인공 보철물입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["phantom-limb-pain","weight-bearing"],"prerequisites":["weight-bearing"]},{"slug":"wheelchair","title_ko":"휠체어","title_en":"Wheelchair","meaning":"스스로 걷기 어려운 사람이 앉은 상태로 이동할 수 있도록 만들어진 바퀴 달린 이동 보조기구입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["paraplegia","pressure-injury","assistive-device"],"prerequisites":[]},{"slug":"occupational-therapy","title_ko":"작업치료","title_en":"Occupational Therapy","meaning":"의미 있는 일상 활동과 작업 수행 능력을 회복시켜 독립적인 생활을 돕는 재활 치료 전문 분야입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["hemispatial-neglect"],"prerequisites":[]},{"slug":"chest-physical-therapy","title_ko":"흉부물리치료","title_en":"Chest Physical Therapy","meaning":"기도 내 분비물 배출을 돕고 호흡 기능을 개선하기 위해 시행하는 물리치료 기법들을 통칭합니다.","subcategory":"물리치료학·재활의학","level":2,"related":[],"prerequisites":[]},{"slug":"vo2max","title_ko":"최대산소섭취량","title_en":"VO2max","meaning":"운동 강도를 최대로 높였을 때 몸이 단위 시간당 사용할 수 있는 최대 산소량으로, 심폐지구력의 대표적인 지표입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["lactate-threshold"],"prerequisites":[],"aliases":["MOU","Maximal Oxygen Uptake (VO2max)"]},{"slug":"maitland-mobilization","title_ko":"메이틀랜드가동술","title_en":"Maitland Mobilization","meaning":"관절가동범위 내에서 움직임의 진폭과 강도를 등급으로 나누어 적용하는 대표적인 관절가동술 기법입니다.","subcategory":"물리치료학·재활의학","level":3,"related":["range-of-motion"],"prerequisites":[],"pop":11},{"slug":"contracture","title_ko":"구축","title_en":"Contracture","meaning":"근육, 힘줄, 관절낭 등 연부조직이 짧아지고 뻣뻣해져 관절의 정상적인 움직임이 영구적으로 제한된 상태입니다.","subcategory":"물리치료학·재활의학","level":1,"related":["range-of-motion"],"prerequisites":[]},{"slug":"isotonic-exercise","title_ko":"등장성운동","title_en":"Isotonic Exercise","meaning":"일정한 무게의 저항에 대해 관절을 움직이며 근육의 길이가 변화하는 근력 운동입니다.","subcategory":"물리치료학·재활의학","level":2,"related":[],"prerequisites":[]},{"slug":"phantom-limb-pain","title_ko":"환지통","title_en":"Phantom Limb Pain","meaning":"절단으로 사라진 신체 부위에서 여전히 통증이나 감각을 느끼는 현상입니다.","subcategory":"물리치료학·재활의학","level":2,"related":["prosthesis"],"prerequisites":[],"aliases":["환상지통","환상통","환상통관리","Phantom Limb Pain Management","PLPM"]},{"slug":"rancho-los-amigos-scale","title_ko":"란초로스아미고스척도","title_en":"Rancho Los Amigos Scale","meaning":"외상성뇌손상 환자의 인지 및 행동 회복 단계를 여덟 단계로 나누어 평가하는 척도입니다.","subcategory":"물리치료학·재활의학","level":3,"related":["glasgow-coma-scale"],"prerequisites":[],"pop":6,"aliases":["RLAS"]},{"slug":"dysarthria","title_ko":"구음장애","title_en":"Dysarthria","meaning":"언어 자체를 만드는 능력에는 문제가 없지만, 말하는 데 필요한 근육의 마비나 조절 장애로 인해 발음이 부정확해지는 상태입니다.","subcategory":"물리치료학·재활의학","level":2,"related":[],"prerequisites":[],"aliases":["마비말장애"]},{"slug":"functional-reach-test","title_ko":"기능적팔뻗기검사","title_en":"Functional Reach Test","meaning":"발의 위치를 고정한 채 넘어지지 않고 팔을 앞으로 최대한 뻗을 수 있는 거리를 측정해 균형 능력을 평가하는 검사입니다.","subcategory":"물리치료학·재활의학","level":3,"related":["berg-balance-scale"],"prerequisites":["berg-balance-scale"],"pop":5},{"slug":"passive-range-of-motion","title_ko":"수동관절가동범위","title_en":"Passive Range of Motion (PROM)","meaning":"환자 스스로의 힘이 아닌 외부의 힘(치료사나 기구)에 의해 관절이 움직일 수 있는 범위를 말합니다.","subcategory":"물리치료학·재활의학","level":1,"related":["active-range-of-motion","range-of-motion","contracture"],"prerequisites":["contracture"],"aliases":["PROM"]},{"slug":"active-range-of-motion","title_ko":"능동관절가동범위","title_en":"Active Range of Motion (AROM)","meaning":"환자가 자신의 근력만으로 스스로 관절을 움직일 수 있는 범위를 말합니다.","subcategory":"물리치료학·재활의학","level":1,"related":["passive-range-of-motion","range-of-motion","active-assistive-range-of-motion"],"prerequisites":[],"pop":10,"aliases":["AROM"]},{"slug":"active-assistive-range-of-motion","title_ko":"능동보조관절가동범위","title_en":"Active-Assistive Range of Motion (AAROM)","meaning":"환자가 스스로 관절을 움직이되, 근력이 부족한 부분은 외부의 도움을 받아 관절가동범위를 완성하는 운동입니다.","subcategory":"물리치료학·재활의학","level":2,"related":["active-range-of-motion","passive-range-of-motion"],"prerequisites":["active-range-of-motion","passive-range-of-motion"],"pop":2,"aliases":["AARM","AAROM"]},{"slug":"righting-reaction","title_ko":"정위반응","title_en":"Righting Reaction","meaning":"머리와 몸의 정상적인 정렬을 유지하거나 회복하기 위해 나타나는 자동적인 자세 반응입니다.","subcategory":"물리치료학·재활의학","level":2,"related":["equilibrium-reaction"],"prerequisites":[],"pop":13},{"slug":"equilibrium-reaction","title_ko":"평형반응","title_en":"Equilibrium Reaction","meaning":"지지면이나 몸의 중심이 이동할 때 균형을 유지하기 위해 몸통과 팔다리에서 나타나는 자동적인 자세 조정 반응입니다.","subcategory":"물리치료학·재활의학","level":3,"related":["righting-reaction"],"prerequisites":["righting-reaction"]},{"slug":"weight-bearing","title_ko":"체중부하","title_en":"Weight Bearing","meaning":"팔다리가 몸의 체중을 지탱하며 받아들이는 상태 또는 그 정도를 말합니다.","subcategory":"물리치료학·재활의학","level":1,"related":["partial-weight-bearing"],"prerequisites":[],"pop":8},{"slug":"partial-weight-bearing","title_ko":"부분체중부하","title_en":"Partial Weight Bearing","meaning":"다친 다리에 전체 체중이 아닌 의사가 지정한 일부 비율의 체중만 싣도록 제한하는 체중부하 단계입니다.","subcategory":"물리치료학·재활의학","level":2,"related":["weight-bearing"],"prerequisites":["weight-bearing"],"aliases":["PWB"]},{"slug":"straight-leg-raise-test","title_ko":"하지직거상검사","title_en":"Straight Leg Raise Test","meaning":"누운 상태에서 무릎을 편 채로 다리를 들어 올려 좌골신경 자극이나 허벅지 뒤쪽 근육의 유연성을 평가하는 검사입니다.","subcategory":"물리치료학·재활의학","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["SLRT"]},{"slug":"vestibular-stimulation","title_ko":"전정자극","title_en":"Vestibular Stimulation","meaning":"내이의 전정기관을 자극하여 신체의 균형, 자세 조절, 공간 지각 능력을 향상시키기 위해 그네, 회전판 등을 활용하는 감각…","subcategory":"작업치료학·재활공학","level":2,"related":[],"prerequisites":[]},{"slug":"assistive-technology-device","title_ko":"보조공학기기","title_en":"Assistive Technology Device","meaning":"장애나 기능제한이 있는 사람의 활동 수행능력을 유지, 향상, 대체하기 위해 사용되는 장비, 제품, 시스템을 총칭하는 개념이다.","subcategory":"작업치료학·재활공학","level":1,"related":["upper-limb-orthosis"],"prerequisites":[]},{"slug":"upper-limb-orthosis","title_ko":"상지보조기","title_en":"Upper Limb Orthosis","meaning":"약화되거나 손상된 상지의 관절과 근육을 지지, 정렬, 보호하거나 기능을 보완하기 위해 착용하는 외부 보조기구이다.","subcategory":"작업치료학·재활공학","level":1,"related":["splint-fabrication","assistive-technology-device"],"prerequisites":[],"aliases":["ULO"]},{"slug":"splint-fabrication","title_ko":"스플린트제작","title_en":"Splint Fabrication","meaning":"저온성형 플라스틱 등의 재료를 이용해 환자 개인의 신체 형태에 맞춘 맞춤형 보조기를 직접 제작하는 작업치료 기술이다.","subcategory":"작업치료학·재활공학","level":2,"related":["upper-limb-orthosis"],"prerequisites":[]},{"slug":"tendon-gliding-exercise","title_ko":"건활주운동","title_en":"Tendon Gliding Exercise","meaning":"손가락 힘줄이 주변 조직에 유착되는 것을 방지하고 활주 기능을 유지하기 위해 특정 손 자세를 순차적으로 취하는 운동 기법이다.","subcategory":"작업치료학·재활공학","level":2,"related":["sensory-reeducation","range-of-motion-exercise"],"prerequisites":[],"pop":18},{"slug":"sensory-reeducation","title_ko":"감각재교육","title_en":"Sensory Reeducation","meaning":"말초신경 손상 후 저하되거나 왜곡된 촉각, 식별감각을 회복시키기 위해 단계적 자극과 훈련을 제공하는 재활 기법이다.","subcategory":"작업치료학·재활공학","level":2,"related":["tendon-gliding-exercise"],"prerequisites":[]},{"slug":"vocational-rehabilitation","title_ko":"직업재활","title_en":"Vocational Rehabilitation","meaning":"장애로 인해 취업이 어려운 사람이 직업을 갖고 유지할 수 있도록 평가, 훈련, 직무배치, 사후관리를 포괄적으로 제공하는 재활…","subcategory":"작업치료학·재활공학","level":1,"related":[],"prerequisites":[]},{"slug":"chaining-technique","title_ko":"연쇄법","title_en":"Chaining Technique","meaning":"복잡한 행동을 여러 하위 단계로 나눈 후 순차적 또는 역순으로 각 단계를 연결하여 학습시키는 행동 훈련 기법이다.","subcategory":"작업치료학·재활공학","level":2,"related":[],"prerequisites":[]},{"slug":"neurorehabilitation","title_ko":"신경재활","title_en":"Neurorehabilitation","meaning":"뇌졸중, 외상성 뇌손상, 척수손상 등 중추신경계 손상 후 신경가소성을 활용하여 운동, 감각, 인지 기능의 회복을 도모하는…","subcategory":"작업치료학·재활공학","level":1,"related":["neuroplasticity"],"prerequisites":[]},{"slug":"outcome-measurement","title_ko":"성과측정","title_en":"Outcome Measurement","meaning":"중재 전후 대상자의 기능, 수행, 삶의 질 변화를 표준화된 도구로 정량적, 정성적으로 확인하여 치료 효과를 검증하는 과정이다.","subcategory":"작업치료학·재활공학","level":1,"related":["evidence-based-nursing"],"prerequisites":[]},{"slug":"social-participation","title_ko":"사회참여","title_en":"Social Participation","meaning":"가족, 친구, 지역사회와의 관계 속에서 사회적 역할을 수행하고 상호작용하는 것으로, 재활의 궁극적 목표 중 하나로 간주되는…","subcategory":"작업치료학·재활공학","level":1,"related":[],"prerequisites":[]},{"slug":"ergonomic-assessment","title_ko":"인간공학적평가","title_en":"Ergonomic Assessment","meaning":"작업 환경과 도구, 동작 방식이 신체에 미치는 부담을 분석하여 근골격계질환 위험을 줄이고 작업효율을 높이기 위한 평가…","subcategory":"작업치료학·재활공학","level":3,"related":[],"prerequisites":[]},{"slug":"model-of-human-occupation","title_ko":"인간작업모델","title_en":"Model of Human Occupation (MOHO)","meaning":"의지, 습관화, 수행능력의 세 요소와 환경의 상호작용을 통해 인간의 작업 참여를 설명하는 작업치료의 대표적인 이론적…","subcategory":"작업치료학·재활공학","level":3,"related":["volition","habituation"],"prerequisites":[],"aliases":["MOHO"]},{"slug":"person-environment-occupation-model","title_ko":"인간환경작업모델","title_en":"Person-Environment-Occupation (PEO) Model","meaning":"개인, 환경, 작업 세 요소의 상호작용과 적합도가 작업수행의 질을 결정한다고 설명하는 작업치료의 개념적 실천모델이다.","subcategory":"작업치료학·재활공학","level":3,"related":["model-of-human-occupation"],"prerequisites":["model-of-human-occupation"],"pop":16,"aliases":["PEOM"]},{"slug":"volition","title_ko":"의욕","title_en":"Volition","meaning":"개인의 가치, 흥미, 자기효능감에 기반하여 작업을 선택하고 참여하고자 하는 내적 동기를 의미하는 인간작업모델의 핵심…","subcategory":"작업치료학·재활공학","level":3,"related":["habituation","model-of-human-occupation"],"prerequisites":["model-of-human-occupation"]},{"slug":"resting-hand-splint","title_ko":"안정위 손 스플린트","title_en":"Resting Hand Splint","meaning":"손목과 손가락을 기능적인 안정위 자세로 고정하여 변형을 예방하고 연부조직의 길이를 유지하기 위해 착용하는 정적 보조기이다.","subcategory":"작업치료학·재활공학","level":3,"related":["splint-fabrication","upper-limb-orthosis"],"prerequisites":["splint-fabrication","upper-limb-orthosis"],"aliases":["안정위손스플린트"]},{"slug":"standing-frame","title_ko":"기립보조기","title_en":"Standing Frame","meaning":"스스로 서기 어려운 사람이 안전하게 기립 자세를 유지할 수 있도록 신체를 지지해주는 재활장비로, 골밀도 유지와 순환 촉진에…","subcategory":"작업치료학·재활공학","level":3,"related":[],"prerequisites":[]},{"slug":"wheelchair-skills-training","title_ko":"휠체어조작훈련","title_en":"Wheelchair Skills Training","meaning":"휠체어를 이용한 실내외 이동, 방향전환, 경사로 오르내리기 등의 실질적 조작기술을 습득시켜 이동 독립성을 높이는 재활훈련이다.","subcategory":"작업치료학·재활공학","level":2,"related":[],"prerequisites":[],"pop":17},{"slug":"scoliosis","title_ko":"척추측만증","title_en":"Scoliosis","meaning":"척추가 옆으로 휘고 회전되어 정면에서 보았을 때 S자 또는 C자 모양의 변형을 보이는 척추 질환입니다.","subcategory":"소아·스포츠·호흡재활","level":1,"related":["muscular-dystrophy"],"prerequisites":[],"aliases":["측만증"]},{"slug":"pes-planus","title_ko":"편평족","title_en":"Pes Planus (Flatfoot)","meaning":"발의 안쪽 세로 아치가 낮아지거나 소실되어 발바닥 전체가 평평하게 바닥에 닿는 발 변형 상태입니다.","subcategory":"소아·스포츠·호흡재활","level":2,"related":[],"prerequisites":[],"aliases":["Flatfoot"]},{"slug":"muscular-dystrophy","title_ko":"근이영양증","title_en":"Muscular Dystrophy","meaning":"유전적 결함으로 근육 단백질이 결핍되어 골격근이 점진적으로 약화되고 소실되는 유전성 근육질환군입니다.","subcategory":"소아·스포츠·호흡재활","level":2,"related":["scoliosis"],"prerequisites":["scoliosis"]},{"slug":"primitive-reflex","title_ko":"원시반사","title_en":"Primitive Reflex","meaning":"신생아 시기에 나타나 성장하면서 자연스럽게 통합되어 사라지는 무의식적이고 정형화된 운동 반응입니다.","subcategory":"소아·스포츠·호흡재활","level":1,"related":["asymmetric-tonic-neck-reflex"],"prerequisites":[]},{"slug":"asymmetric-tonic-neck-reflex","title_ko":"비대칭긴장성경반사","title_en":"Asymmetric Tonic Neck Reflex (ATNR)","meaning":"영아의 고개를 한쪽으로 돌리면 얼굴이 향한 쪽 팔다리는 펴지고 반대쪽은 굽혀지는 자세를 보이는 원시반사입니다.","subcategory":"소아·스포츠·호흡재활","level":3,"related":["primitive-reflex"],"prerequisites":["primitive-reflex"],"pop":15,"aliases":["ATNR"]},{"slug":"peabody-developmental-motor-scales","title_ko":"피바디발달운동척도","title_en":"Peabody Developmental Motor Scales (PDMS)","meaning":"출생부터 만 5세까지 영유아의 대근육 및 소근육 운동 발달을 반사, 자세, 이동, 물체조작, 잡기, 시각운동통합 영역으로…","subcategory":"소아·스포츠·호흡재활","level":3,"related":["primitive-reflex"],"prerequisites":[],"pop":14,"aliases":["PDMS"]},{"slug":"hip-spica-cast","title_ko":"고관절인공석고붕대","title_en":"Hip Spica Cast","meaning":"골반과 양쪽 다리 일부를 함께 감싸 고관절을 특정 자세로 고정시키는 석고붕대로, 고관절 탈구나 골절 치료 후 정렬을 유지하는…","subcategory":"소아·스포츠·호흡재활","level":3,"related":[],"prerequisites":[]},{"slug":"brachial-plexus-birth-palsy","title_ko":"분만마비","title_en":"Brachial Plexus Birth Palsy","meaning":"분만 과정에서 어깨와 목 사이를 지나는 상완신경총이 과도하게 늘어나거나 손상되어 신생아의 팔에 마비가 발생하는 상태입니다.","subcategory":"소아·스포츠·호흡재활","level":3,"related":["primitive-reflex"],"prerequisites":[],"aliases":["BPBP"]},{"slug":"muscle-strain","title_ko":"근육좌상","title_en":"Muscle Strain","meaning":"근육이나 근육과 힘줄이 만나는 부위가 과도하게 늘어나거나 부분적으로 찢어져 손상되는 스포츠 손상의 한 형태입니다.","subcategory":"소아·스포츠·호흡재활","level":2,"related":["dynamic-stretching"],"prerequisites":[]},{"slug":"medial-epicondylitis","title_ko":"내측상과염","title_en":"Medial Epicondylitis (Golfer's Elbow)","meaning":"손목을 굽히는 근육의 힘줄이 팔꿈치 안쪽 뼈 돌출부에 붙는 지점에서 과사용으로 인해 미세 손상과 통증이 발생하는 질환입니다.","subcategory":"소아·스포츠·호흡재활","level":3,"related":["dynamic-stretching"],"prerequisites":[],"aliases":["Golfer's Elbow"]},{"slug":"functional-movement-screen","title_ko":"기능적움직임스크린","title_en":"Functional Movement Screen (FMS)","meaning":"스쿼트, 런지, 어깨 가동성 등 일곱 가지 기본 동작 패턴을 관찰해 신체의 움직임 제한과 비대칭을 선별하는 표준화된…","subcategory":"소아·스포츠·호흡재활","level":2,"related":["dynamic-stretching"],"prerequisites":[],"pop":9},{"slug":"chest-percussion-and-vibration","title_ko":"흉부타진및진동법","title_en":"Chest Percussion and Vibration","meaning":"손이나 기구로 흉벽을 리듬감 있게 두드리거나 진동을 가해 기관지 벽에 붙은 분비물을 느슨하게 만들어 배출을 돕는 전통적인…","subcategory":"소아·스포츠·호흡재활","level":2,"related":[],"prerequisites":[],"pop":4},{"slug":"ventilator-weaning","title_ko":"인공호흡기이탈","title_en":"Ventilator Weaning","meaning":"기계호흡에 의존하던 환자가 스스로 호흡할 수 있는 능력을 회복해 인공호흡기 지지를 점진적으로 줄이고 최종적으로 제거하는…","subcategory":"소아·스포츠·호흡재활","level":3,"related":[],"prerequisites":[]},{"slug":"peak-expiratory-flow-rate","title_ko":"최대호기유량","title_en":"Peak Expiratory Flow Rate (PEFR)","meaning":"최대한 힘껏 숨을 들이마신 뒤 가능한 한 빠르게 내쉴 때 측정되는 최고 호기 속도로, 기도 폐쇄의 정도를 간편하게 반영하는…","subcategory":"소아·스포츠·호흡재활","level":3,"related":["spirometry"],"prerequisites":[],"aliases":["PEFR"]}]