[{"slug":"integral","title_ko":"적분","title_en":"Integral","meaning":"아주 잘게 나눈 조각들을 처음부터 끝까지 모두 더해서 전체 누적량이나 넓이를 구하는 방법입니다.","subcategory":"해석학·미적분","level":1,"related":["normal-distribution"],"prerequisites":[],"pop":20,"aliases":["적분법"]},{"slug":"direct-inverse-proportion","title_ko":"정비례와 반비례","title_en":"Direct and Inverse Proportion","meaning":"한 값이 커질 때 다른 값도 일정한 비율로 커지면 정비례, 한 값이 커질 때 다른 값이 일정한 비율로 작아지면 반비례라고…","subcategory":"대수·정수론","level":1,"related":[],"prerequisites":[],"pop":17,"aliases":["비례와 반비례","정비례와반비례"]},{"slug":"dot-product","title_ko":"벡터의 내적","title_en":"Dot Product of Vectors","meaning":"벡터의 내적은 두 벡터의 크기와 그 사이 각도의 코사인 값을 곱해서, 방향은 없고 크기만 있는 하나의 실수(스칼라)를 구하는…","subcategory":"기하·위상","level":1,"related":[],"prerequisites":[],"aliases":["내적","벡터의내적"]},{"slug":"equation-of-circle","title_ko":"원의 방정식","title_en":"Equation of a Circle","meaning":"좌표평면 위에서 중심 (a, b)로부터 거리가 반지름 r로 일정한 점들의 집합을 (x-a)² + (y-b)² = r² 형태의…","subcategory":"기하·위상","level":1,"related":[],"prerequisites":[],"aliases":["원의방정식"]},{"slug":"factors-and-multiples","title_ko":"약수와 배수","title_en":"Factors and Multiples","meaning":"약수는 어떤 수를 나머지 없이 나눌 수 있는 수이고, 배수는 어떤 수에 자연수를 곱해서 나오는 수입니다.","subcategory":"대수·정수론","level":3,"related":[],"prerequisites":[],"aliases":["약수 배수","최대공약수 최소공배수","약수와배수"]},{"slug":"frequency-distribution-table","title_ko":"도수분포표와 히스토그램","title_en":"Frequency Distribution Table","meaning":"자료를 몇 개의 구간(계급)으로 나누고 각 구간에 속한 자료의 개수(도수)를 정리한 표이며, 이를 막대 형태의 그래프로…","subcategory":"확률·조합론","level":1,"related":["variance"],"prerequisites":[],"aliases":["도수분포표","히스토그램","도수분포표와히스토그램"]},{"slug":"polynomial-operations","title_ko":"다항식의 연산","title_en":"Operations on Polynomials","meaning":"여러 개의 항으로 이루어진 다항식을 덧셈, 뺄셈, 곱셈, 나눗셈의 규칙에 따라 정리하고 계산하는 방법을 말합니다.","subcategory":"대수·정수론","level":1,"related":[],"prerequisites":[],"aliases":["다항식 연산","다항식의연산"]},{"slug":"discriminant","title_ko":"이차방정식의 판별식","title_en":"Discriminant of a Quadratic Equation","meaning":"이차방정식 ax²+bx+c=0에서 b²-4ac 값의 부호로 실근의 개수(서로 다른 두 실근, 중근, 실근 없음)를 판별하는…","subcategory":"대수·정수론","level":1,"related":[],"prerequisites":[],"aliases":["판별식","이차방정식 판별식","DQE","이차방정식의판별식"]},{"slug":"quadrilateral-properties","title_ko":"사각형의 성질","title_en":"Quadrilateral Properties","meaning":"평행사변형·마름모·직사각형·정사각형·사다리꼴처럼 변과 각의 특징에 따라 사각형을 종류별로 구분하고, 각 종류가 가진 고유한…","subcategory":"기하·위상","level":1,"related":[],"prerequisites":[],"aliases":["사각형의성질"]},{"slug":"unit-conversion","title_ko":"단위 환산","title_en":"Unit Conversion","meaning":"길이(mm, cm, m, km), 들이(mL, L), 무게(g, kg, t)처럼 같은 양을 나타내는 서로 다른 단위 사이의…","subcategory":"응용수학·수치해석","level":2,"related":["direct-inverse-proportion"],"prerequisites":[],"aliases":["단위환산"]},{"slug":"triangle-circumcenter-incenter","title_ko":"삼각형의 외심과 내심","title_en":"triangle circumcenter incenter","meaning":"외심은 삼각형의 세 꼭짓점에서 같은 거리에 있는 점(외접원의 중심)이고, 내심은 삼각형의 세 변에서 같은 거리에 있는…","subcategory":"기하·위상","level":1,"related":["quadrilateral-properties","equation-of-circle"],"prerequisites":[],"pop":14,"aliases":["외접원과 내접원","외심 내심","삼각형의외심과내심"]},{"slug":"rounding-estimation","title_ko":"어림하기 (반올림·올림·버림)","title_en":"Estimation (Rounding)","meaning":"정확한 값 대신 대략적인 값을 구하기 위해 반올림, 올림, 버림 중 하나의 방법으로 수를 처리하는 것입니다.","subcategory":"응용수학·수치해석","level":3,"related":[],"prerequisites":[],"aliases":["반올림","올림과 버림","estimation","Rounding","반올림·올림·버림","어림하기","어림하기 (반올림 올림 버림)","어림하기 (반올림올림버림)","어림하기(반올림·올림·버림)"]},{"slug":"taylor-series","title_ko":"테일러 급수","title_en":"Taylor series","meaning":"복잡한 함수를 특정 지점 근처에서 다항식(거듭제곱의 합)의 무한한 합으로 근사하는 방법입니다.","subcategory":"해석학·미적분","level":1,"related":[],"prerequisites":[],"pop":10,"aliases":["테일러 전개","Taylor expansion","Taylor series","테일러급수"]},{"slug":"differential-equation","title_ko":"미분방정식","title_en":"differential equation","meaning":"어떤 값 자체가 아니라 그 값이 얼마나 빠르게 변하는지에 대한 규칙을 식으로 나타낸 방정식입니다.","subcategory":"해석학·미적분","level":1,"related":["integral"],"prerequisites":[],"pop":19,"aliases":["ODE","상미분방정식","differential equations"]},{"slug":"fourier-transform","title_ko":"푸리에 변환","title_en":"Fourier transform","meaning":"복잡하게 뒤섞인 신호를 여러 개의 단순한 사인파(주기적으로 반복되는 파동)의 합으로 분해해 주는 수학적 방법입니다.","subcategory":"응용수학·수치해석","level":1,"related":["taylor-series","differential-equation"],"prerequisites":[],"aliases":["FT","푸리에변환","Fourier analysis"]},{"slug":"chain-rule","title_ko":"연쇄법칙","title_en":"Chain Rule","meaning":"함수 여러 개가 겹쳐 있을 때, 전체를 한 번에 미분하지 않고 각 단계를 따로 미분한 뒤 곱해서 합치는 규칙입니다.","subcategory":"해석학·미적분","level":1,"related":["backpropagation","gradient-descent"],"prerequisites":[],"pop":15,"aliases":["chain rule","합성함수 미분법"]},{"slug":"hessian-matrix","title_ko":"헤시안 행렬","title_en":"Hessian Matrix","meaning":"함수가 여러 방향으로 얼마나 휘어져 있는지(곡률)를 변수 쌍마다 정리한 2차 미분값들의 표입니다.","subcategory":"해석학·미적분","level":1,"related":["gradient-descent"],"prerequisites":[],"pop":18,"aliases":["Hessian","헤시안","헤시안행렬"]},{"slug":"newton-raphson-method","title_ko":"뉴턴-랩슨법","title_en":"Newton-Raphson Method","meaning":"방정식을 손으로 풀기 어려울 때, 현재 지점의 기울기(접선)를 이용해 답을 조금씩 더 정확하게 좁혀가는 반복 계산법입니다.","subcategory":"응용수학·수치해석","level":1,"related":["gradient-descent"],"prerequisites":[],"pop":1,"aliases":["뉴턴법","Newton's method","뉴턴 랩슨법","뉴턴랩슨법"]},{"slug":"basis-and-dimension","title_ko":"기저와 차원","title_en":"Basis and Dimension","meaning":"벡터공간의 모든 벡터를 유일한 조합으로 표현할 수 있는 최소한의 벡터 집합을 기저라 하고, 그 기저를 이루는 벡터의 개수를…","subcategory":"기하·위상","level":1,"related":[],"prerequisites":[],"aliases":["기저 벡터","벡터공간의 차원","기저와차원"]},{"slug":"lagrange-interpolation","title_ko":"라그랑주 보간법","title_en":"Lagrange Interpolation","meaning":"몇 개의 점 데이터만 알고 있을 때, 그 점들을 모두 정확히 지나가는 다항식 함수를 만들어 값이 없는 구간을 추정하는…","subcategory":"응용수학·수치해석","level":3,"related":["newton-raphson-method","polynomial-operations","taylor-series"],"prerequisites":["newton-raphson-method"],"aliases":["라그랑주 다항식","라그랑주보간법"]},{"slug":"geodesic","title_ko":"측지선","title_en":"Geodesic","meaning":"휘어진 공간(다양체) 위에서 두 점을 잇는 가장 짧은 경로를 뜻합니다.","subcategory":"기하·위상","level":2,"related":[],"prerequisites":[],"pop":9},{"slug":"runge-kutta-method","title_ko":"룽게-쿠타법","title_en":"Runge-Kutta Method","meaning":"손으로 풀기 어려운 미분방정식의 해를, 여러 지점의 기울기를 조합해 한 걸음씩 근사적으로 계산해 나가는 수치해석 방법입니다.","subcategory":"응용수학·수치해석","level":3,"related":["differential-equation","newton-raphson-method"],"prerequisites":["newton-raphson-method"],"aliases":["RKM","룽게 쿠타법","룽게쿠타법"]},{"slug":"vector-field","title_ko":"벡터장","title_en":"Vector Field","meaning":"공간의 모든 점마다 크기와 방향을 가진 화살표(벡터)를 하나씩 대응시켜 놓은 것을 말합니다.","subcategory":"기하·위상","level":3,"related":["divergence-and-curl"],"prerequisites":[]},{"slug":"divergence-and-curl","title_ko":"발산과 회전","title_en":"Divergence and Curl","meaning":"발산은 벡터장이 한 점에서 얼마나 퍼져 나가거나 모이는지를, 회전은 그 점 주변에서 얼마나 소용돌이치는지를 수치로 나타낸…","subcategory":"해석학·미적분","level":1,"related":["vector-field","differential-equation"],"prerequisites":[],"aliases":["발산과회전"]},{"slug":"absolute-value","title_ko":"절댓값","title_en":"Absolute Value","meaning":"어떤 수의 부호(양수인지 음수인지)를 무시하고, 0으로부터 얼마나 떨어져 있는지 그 크기만 나타낸 값입니다.","subcategory":"대수·정수론","level":2,"related":[],"prerequisites":[],"pop":12},{"slug":"stokes-theorem","title_ko":"스토크스 정리","title_en":"Stokes' Theorem","meaning":"곡면 위에서 벡터장의 회전을 모두 더한 값은, 그 곡면의 가장자리(경계선)를 따라 벡터장을 한 바퀴 돈 값과 같다는…","subcategory":"해석학·미적분","level":2,"related":["divergence-and-curl","vector-field"],"prerequisites":["divergence-and-curl"],"aliases":["스토크스정리"]},{"slug":"fourier-series","title_ko":"푸리에 급수","title_en":"Fourier Series","meaning":"일정한 패턴이 반복되는 주기함수를 크기와 진동수가 다른 사인·코사인 파동들의 합으로 분해해 나타내는 방법입니다.","subcategory":"해석학·미적분","level":2,"related":["fourier-transform","convolution"],"prerequisites":[],"aliases":["푸리에급수"]},{"slug":"convolution","title_ko":"합성곱","title_en":"Convolution","meaning":"한 함수를 뒤집어 미끄러뜨리면서 다른 함수와 겹치는 부분을 계속 곱하고 더해, 두 함수가 서로에게 미치는 영향을 하나의 새…","subcategory":"응용수학·수치해석","level":2,"related":["fourier-transform","fourier-series","convolutional-neural-network"],"prerequisites":["fourier-transform"],"pop":11,"aliases":["컨볼루션"]},{"slug":"chinese-remainder-theorem","title_ko":"중국인의 나머지 정리","title_en":"Chinese Remainder Theorem","meaning":"서로 다른 수로 나눈 나머지 조건 여러 개를 동시에 만족하는 수가 정해진 범위 안에서 딱 하나로 결정된다는 정리입니다.","subcategory":"대수·정수론","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["중국인의나머지정리"]},{"slug":"cross-product","title_ko":"벡터의 외적","title_en":"Cross Product","meaning":"두 벡터로부터 그 둘 모두에 수직인 새로운 벡터를 만들어내는 3차원 공간의 벡터 연산입니다.","subcategory":"기하·위상","level":1,"related":["dot-product"],"prerequisites":[],"pop":4,"aliases":["벡터의외적"]},{"slug":"gram-schmidt-process","title_ko":"그람-슈미트 직교화","title_en":"Gram-Schmidt Process","meaning":"서로 독립인 벡터들의 집합을 순서대로 하나씩 손봐서, 모두 서로 수직인(직교하는) 벡터들의 집합으로 바꾸는 절차입니다.","subcategory":"기하·위상","level":3,"related":["basis-and-dimension","dot-product"],"prerequisites":["basis-and-dimension","dot-product"],"aliases":["그람 슈미트 직교화","그람-슈미트직교화","그람슈미트 직교화"]},{"slug":"isomorphism","title_ko":"동형사상","title_en":"Isomorphism","meaning":"두 대수적 구조 사이에 연산까지 완벽히 보존하며 일대일로 대응시킬 수 있는 특별한 함수(사상)를 말합니다.","subcategory":"대수·정수론","level":2,"related":[],"prerequisites":[]},{"slug":"distance-between-two-points","title_ko":"두 점 사이의 거리","title_en":"Distance Between Two Points","meaning":"좌표평면 위의 두 점 A(x₁, y₁)와 B(x₂, y₂) 사이의 직선 거리를 √((x₂-x₁)² + (y₂-y₁)²)로…","subcategory":"기하·위상","level":1,"related":["section-formula","equation-of-circle"],"prerequisites":[],"aliases":["DBTP","두점사이의거리"]},{"slug":"section-formula","title_ko":"내분점과 외분점","title_en":"Section Formula","meaning":"한 선분을 일정한 비율(m:n)로 나누는 점의 좌표를 구하는 공식으로, 그 점이 선분 안에 있으면 내분점, 선분 밖 연장선…","subcategory":"기하·위상","level":2,"related":["distance-between-two-points","direct-inverse-proportion"],"prerequisites":["distance-between-two-points"],"aliases":["내분점과외분점"]},{"slug":"log-properties","title_ko":"로그의 성질","title_en":"Logarithm Properties","meaning":"로그의 곱셈은 덧셈으로, 나눗셈은 뺄셈으로, 거듭제곱은 곱셈으로 바꿔서 계산할 수 있게 해주는 규칙들입니다.","subcategory":"대수·정수론","level":2,"related":[],"prerequisites":[],"aliases":["로그의성질"]},{"slug":"quadratic-formula","title_ko":"근의 공식","title_en":"Quadratic Formula","meaning":"ax² + bx + c = 0 형태의 이차방정식을 인수분해 없이도 항상 풀 수 있게 해주는 공식 x = (-b ±…","subcategory":"대수·정수론","level":2,"related":["discriminant"],"prerequisites":["discriminant"],"aliases":["근의공식"]},{"slug":"gradient","title_ko":"그래디언트 (기울기벡터)","title_en":"Gradient","meaning":"다변수함수가 가장 빠르게 증가하는 방향과 그 증가율의 크기를 나타내는 벡터입니다.","subcategory":"해석학·미적분","level":2,"related":["chain-rule","vector-field","hessian-matrix"],"prerequisites":["chain-rule","hessian-matrix"],"pop":2,"aliases":["그래디언트(기울기벡터)","기울기벡터","기울기(그래디언트)","기울기"]},{"slug":"vector-projection","title_ko":"벡터의 정사영","title_en":"Vector Projection","meaning":"벡터의 정사영은 한 벡터가 다른 벡터 방향으로 드리우는 그림자처럼, 그 방향의 성분만 뽑아낸 새로운 벡터입니다.","subcategory":"기하·위상","level":3,"related":["dot-product"],"prerequisites":["dot-product"],"aliases":["벡터의정사영"]},{"slug":"discrete-continuous-random-variable","title_ko":"이산확률변수와 연속확률변수의 구분","title_en":"Discrete vs Continuous Random Variable","meaning":"확률변수가 취할 수 있는 값이 하나씩 셀 수 있게 떨어져 있으면 이산확률변수, 구간 안의 모든 실수값을 취할 수 있으면…","subcategory":"확률·조합론","level":3,"related":["normal-distribution"],"prerequisites":[],"pop":16,"aliases":["DVCRV","이산확률변수와연속확률변수의구분"]},{"slug":"complex-conjugate","title_ko":"켤레복소수","title_en":"Complex Conjugate","meaning":"복소수 a+bi에서 허수부의 부호만 반대로 바꾼 a-bi를 그 복소수의 켤레복소수라고 합니다.","subcategory":"대수·정수론","level":3,"related":[],"prerequisites":[],"aliases":["공액복소수"]},{"slug":"equation-of-ellipse","title_ko":"타원의 방정식","title_en":"Equation of an Ellipse","meaning":"두 정점(초점)까지의 거리의 합이 항상 일정한 점들의 집합을 x²/a² + y²/b² = 1 형태의 식으로 나타낸 것입니다.","subcategory":"기하·위상","level":1,"related":["equation-of-circle","distance-between-two-points"],"prerequisites":[],"aliases":["타원의방정식"]},{"slug":"euler-hamiltonian-path","title_ko":"오일러 경로와 해밀턴 경로","title_en":"Euler Path and Hamiltonian Path","meaning":"오일러 경로는 그래프의 모든 간선을 정확히 한 번씩 지나는 경로이고, 해밀턴 경로는 모든 정점을 정확히 한 번씩 방문하는…","subcategory":"확률·조합론","level":2,"related":[],"prerequisites":[],"pop":3,"aliases":["EPHP","오일러경로와해밀턴경로"]},{"slug":"euler-polyhedron-formula","title_ko":"오일러의 다면체 공식","title_en":"Euler's Polyhedron Formula","meaning":"구멍이 없는 볼록다면체에서 정점의 수(V), 모서리의 수(E), 면의 수(F) 사이에는 항상 V - E + F = 2가…","subcategory":"기하·위상","level":3,"related":["euler-hamiltonian-path"],"prerequisites":[],"aliases":["오일러의다면체공식"]},{"slug":"kolmogorov-axioms","title_ko":"확률의 공리","title_en":"Kolmogorov Axioms","meaning":"확률이라는 개념을 수학적으로 엄밀하게 정의하기 위해 콜모고로프가 제시한 세 가지 기본 규칙(비음수성, 전체확률 1…","subcategory":"확률·조합론","level":3,"related":[],"prerequisites":[],"aliases":["확률의공리"]},{"slug":"lipschitz-continuity","title_ko":"립시츠 연속","title_en":"Lipschitz Continuity","meaning":"입력값이 조금 바뀔 때 함수값이 그보다 정해진 비율 이상으로는 절대 급하게 변하지 않는다는, 변화의 속도에 상한선이 있는…","subcategory":"해석학·미적분","level":3,"related":["gradient"],"prerequisites":["gradient"],"aliases":["립시츠연속"]},{"slug":"scalar-triple-product","title_ko":"벡터의 삼중곱 (Scalar Triple Product)","title_en":"Scalar Triple Product","meaning":"세 벡터 a, b, c에 대해 a·(b×c)로 계산되는 하나의 숫자(스칼라)로, 세 벡터가 만드는 평행육면체의 부피를…","subcategory":"기하·위상","level":3,"related":["cross-product","dot-product"],"prerequisites":["cross-product","dot-product"],"pop":5,"aliases":["벡터의 삼중곱","벡터의삼중곱","벡터의삼중곱(ScalarTripleProduct)"]},{"slug":"proof-by-contradiction","title_ko":"귀류법","title_en":"Proof by Contradiction","meaning":"어떤 주장이 거짓이라고 가정했을 때 모순이 발생함을 보여서, 결국 그 주장이 참일 수밖에 없음을 증명하는 방법입니다.","subcategory":"논리·집합론","level":3,"related":[],"prerequisites":[],"pop":13,"aliases":["모순법","배리법"]},{"slug":"dihedral-angle","title_ko":"이면각","title_en":"Dihedral Angle","meaning":"한 직선을 공유하는 두 평면이 그 직선을 기준으로 얼마나 벌어져 있는지를 나타내는 각입니다.","subcategory":"기하·위상","level":3,"related":["cross-product"],"prerequisites":["cross-product"],"pop":7},{"slug":"unit-vector","title_ko":"단위벡터","title_en":"Unit Vector","meaning":"크기(길이)가 정확히 1인 벡터로, 방향 정보만을 나타내고 싶을 때 사용합니다.","subcategory":"기하·위상","level":3,"related":["dot-product","cross-product"],"prerequisites":["dot-product","cross-product"]},{"slug":"rank-nullity-theorem","title_ko":"차원 정리","title_en":"Rank-Nullity Theorem","meaning":"행렬의 정의역 전체 차원은 랭크(살아남는 차원)와 영공간의 차원(사라지는 차원)의 합과 같다는 정리입니다.","subcategory":"대수·정수론","level":3,"related":[],"prerequisites":[],"aliases":["RNT","차원정리"]},{"slug":"ordinary-differential-equation","title_ko":"상미분방정식","title_en":"Ordinary Differential Equation (ODE)","meaning":"하나의 독립변수에 대한 함수와 그 도함수들 사이의 관계를 나타내는 방정식이다.","subcategory":"해석학·미적분","level":3,"related":["taylor-series"],"prerequisites":["taylor-series"]},{"slug":"convex-optimization","title_ko":"볼록 최적화","title_en":"Convex Optimization","meaning":"목적함수와 제약조건이 모두 볼록성을 만족하는 최적화 문제로, 지역 최적해가 곧 전역 최적해가 됨이 보장된다.","subcategory":"응용수학·수치해석","level":1,"related":["gradient-descent"],"prerequisites":[],"aliases":["볼록최적화"]},{"slug":"interpolation-methods","title_ko":"보간법","title_en":"Interpolation Methods","meaning":"알고 있는 몇 개의 데이터 점들 사이의 값을 추정하여 매끄러운 함수로 연결하는 방법이다.","subcategory":"응용수학·수치해석","level":3,"related":["taylor-series"],"prerequisites":[],"pop":6,"aliases":["내삽법","보간"]},{"slug":"manifold-hypothesis","title_ko":"매니폴드 가설","title_en":"Manifold Hypothesis","meaning":"매니폴드 가설은 이미지·음성·문장 임베딩처럼 차원이 매우 높은 실제 데이터가 가능한 모든 값의 공간 전체에 퍼져 있지 않고…","subcategory":"인공지능·머신러닝","level":3,"related":["t-sne","principal-component-analysis","curse-of-dimensionality"],"prerequisites":[],"aliases":["다양체 가설","manifold assumption","매니폴드 가정"]},{"slug":"scalar","title_ko":"스칼라","title_en":"Scalar","meaning":"스칼라는 크기(수치)만 있고 방향이 없는 양이며, 선형대수에서는 벡터에 곱해 길이를 바꾸는 데 쓰는 보통의 수(실수나 복소수…","subcategory":"기하·위상","level":1,"related":["vector","dot-product","vector-field","loss-function"],"prerequisites":[],"aliases":["스칼라량","scalar quantity","scalar value"]},{"slug":"vector","title_ko":"벡터","title_en":"Vector","meaning":"벡터는 크기와 방향을 함께 갖는 양(변위·속도·힘 등)이며, 선형대수에서는 서로 더하고 스칼라배를 할 수 있는 벡터공간의…","subcategory":"기하·위상","level":1,"related":["scalar","dot-product","cross-product","vector-field"],"prerequisites":["scalar"],"aliases":["벡터량","vector quantity","기하벡터"]}]