[{"slug":"regression","title_ko":"회귀분석","title_en":"Regression","meaning":"하나(또는 여러) 변수가 다른 변수에 얼마나, 어떤 방향으로 영향을 주는지를 수식으로 추정하는 분석 방법입니다.","subcategory":"회귀·상관분석","level":1,"related":["correlation","effect-size","confidence-interval","endogeneity","instrumental-variable","anova"],"prerequisites":[],"pop":2,"aliases":["회귀","Regression Analysis"]},{"slug":"anova","title_ko":"분산분석","title_en":"ANOVA","meaning":"여러 집단(주로 세 개 이상)의 평균 차이를 집단 간·집단 내 분산의 비(F)로 한 번에 검정하는 통계 기법.","subcategory":"추론통계·가설검정","level":1,"related":["t-test","variance","significance-level","chi-square-test","multicollinearity","regression"],"prerequisites":[],"pop":3,"aliases":["분산 분석","일원분산분석","아노바","Analysis of Variance"]},{"slug":"periodic-review-system","title_ko":"정기발주시스템","title_en":"Periodic Review System","meaning":"정해진 주기마다 재고 수준을 점검하여 목표 재고량까지 부족분을 주문하는 재고관리 방식이다.","subcategory":"물류관리·공급망","level":3,"related":[],"prerequisites":[],"aliases":["Periodic Review Inventory System","PRIS"]},{"slug":"time-and-motion-study","title_ko":"시간동작연구","title_en":"Time and Motion Study","meaning":"작업 동작을 세부적으로 분석하여 불필요한 동작을 줄이고 표준 작업시간을 산정하는 산업공학의 전통적인 작업연구 기법입니다.","subcategory":"인간공학","level":2,"related":[],"prerequisites":[],"pop":6,"aliases":["동작시간연구"]},{"slug":"discrete-event-simulation","title_ko":"이산사건시뮬레이션","title_en":"Discrete-Event Simulation","meaning":"시스템 상태가 연속적으로가 아니라 특정 시점의 사건(event) 발생에 의해서만 변화한다고 가정하고 그 시스템의 동작을…","subcategory":"시뮬레이션","level":2,"related":["poisson-process"],"prerequisites":[],"pop":7},{"slug":"job-shop-scheduling","title_ko":"작업장스케줄링","title_en":"Job Shop Scheduling","meaning":"여러 작업(job)이 각각 서로 다른 순서로 여러 기계를 거쳐야 하는 생산 환경에서, 각 작업을 각 기계에 언제 배정할지…","subcategory":"스케줄링","level":2,"related":[],"prerequisites":[],"pop":9,"aliases":["JSS"]},{"slug":"poisson-process","title_ko":"포아송과정","title_en":"Poisson Process","meaning":"서로 독립적으로 무작위 시점에 발생하는 사건들이 일정한 평균 발생률을 가질 때 그 발생 횟수를 모형화하는 확률과정입니다.","subcategory":"확률모형·대기이론","level":2,"related":["discrete-event-simulation"],"prerequisites":[],"aliases":["푸아송과정","포아송도착과정","Poisson Arrival Process"]},{"slug":"analytic-hierarchy-process","title_ko":"계층분석법","title_en":"Analytic Hierarchy Process","meaning":"복잡한 의사결정 문제를 목표-기준-대안의 계층 구조로 나누고, 쌍대비교를 통해 각 요소의 상대적 중요도를 산출하는…","subcategory":"의사결정분석","level":2,"related":[],"prerequisites":[],"pop":10,"aliases":["AHP"]},{"slug":"traveling-salesman-problem","title_ko":"외판원문제","title_en":"Traveling Salesman Problem","meaning":"여러 도시를 한 번씩만 방문하고 출발지로 돌아오는 경로 중에서 총 이동거리 또는 비용이 최소가 되는 순서를 찾는 조합최적화…","subcategory":"운영연구·수리계획법","level":2,"related":[],"prerequisites":[],"pop":5,"aliases":["TSP","순회외판원문제"]},{"slug":"bootstrap-resampling-method","title_ko":"붓스트랩재표본법","title_en":"Bootstrap Resampling Method","meaning":"관측된 표본 데이터에서 복원추출로 반복적으로 재표본을 뽑아 통계량의 분포를 추정함으로써, 이론적 분포 가정 없이 신뢰구간이나…","subcategory":"통계분석·실험계획법","level":2,"related":[],"prerequisites":[],"pop":8,"aliases":["Bootstrap Resampling Method"]},{"slug":"hub-and-spoke-network","title_ko":"허브앤스포크네트워크","title_en":"Hub-and-Spoke Network","meaning":"중심이 되는 거점(허브)을 통해 화물이나 승객을 모으고 분산시키는 방식으로 운영되는 물류·운송 네트워크 구조입니다.","subcategory":"물류·수송","level":2,"related":[],"prerequisites":[],"pop":1,"aliases":["Hub-and-Spoke Network","HSN"]},{"slug":"niosh-lifting-equation","title_ko":"NIOSH들기작업지수","title_en":"NIOSH Lifting Equation","meaning":"미국 국립산업안전보건연구원(NIOSH)이 개발한, 들기 작업의 여러 조건을 반영해 권장 최대 중량과 작업 위험도를 산출하는…","subcategory":"인간공학","level":2,"related":[],"prerequisites":[],"pop":4,"aliases":["NIOSH Lifting Equation","NLE"]},{"slug":"parallel-system-reliability","title_ko":"병렬시스템신뢰도","title_en":"Parallel System Reliability","meaning":"여러 구성요소가 동시에 배치되어, 그중 하나 이상이 정상 작동하면 시스템 전체가 기능을 유지하는 구조에서 시스템이 정상…","subcategory":"신뢰성공학·보전","level":2,"related":[],"prerequisites":[],"aliases":["Parallel System Reliability"]},{"slug":"a3-problem-solving","title_ko":"A3 문제해결","title_en":"A3 Problem Solving","meaning":"문제의 배경, 현상, 목표, 원인 분석, 대책, 실행계획, 후속조치를 A3 용지 한 장에 구조화하여 정리하고 공유하는…","subcategory":"린생산·지속적개선","level":1,"related":[],"prerequisites":[]},{"slug":"lot-streaming","title_ko":"로트 스트리밍","title_en":"Lot Streaming","meaning":"하나의 생산 로트를 여러 개의 서브로트(이송 배치)로 분할하여, 앞 공정에서 일부가 완료되는 즉시 다음 공정으로 넘겨 공정…","subcategory":"스케줄링","level":1,"related":[],"prerequisites":[]}]