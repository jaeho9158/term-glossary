[{"slug":"meta-analysis","title_ko":"메타분석","title_en":"Meta-analysis","meaning":"같은 주제를 다룬 여러 개별 연구의 결과를 통계적으로 종합해서 하나의 결론을 도출하는 연구 방법입니다.","subcategory":"문헌연구·메타분석","level":1,"related":["effect-size","randomized-controlled-trial","confidence-interval","statistical-power","bootstrap-resampling","evidence-based-nursing"],"prerequisites":[]},{"slug":"homeostasis","title_ko":"항상성","title_en":"Homeostasis","meaning":"생물이 외부 환경이 변해도 체온, 혈당, pH 같은 내부 상태를 일정한 범위로 유지하려는 성질입니다.","subcategory":"생리·발생","level":1,"related":["symbiosis","action-potential","mitochondria","apoptosis","circadian-rhythm","regulator-subsystem","neuman-systems-model"],"prerequisites":[],"aliases":["호메오스타시스","호메오스테이시스"]},{"slug":"nursing-process","title_ko":"간호과정","title_en":"Nursing Process","meaning":"대상자의 건강문제를 확인하고 해결하기 위해 사정, 진단, 계획, 수행, 평가의 다섯 단계를 순환적·체계적으로 적용하는…","subcategory":"간호이론·간호과정","level":1,"related":[],"prerequisites":[],"aliases":["간호과정단계","Steps of the Nursing Process"]},{"slug":"subjective-data","title_ko":"주관적자료","title_en":"Subjective Data","meaning":"대상자가 직접 말이나 표현으로 전달하는 증상, 느낌, 신념 등 관찰자가 측정할 수 없는 자료이다.","subcategory":"간호이론·간호과정","level":1,"related":[],"prerequisites":[]},{"slug":"data-clustering","title_ko":"자료군집화","title_en":"Data Clustering","meaning":"수집된 개별 자료들을 의미 있는 패턴이나 관련 항목끼리 묶어 문제를 파악하기 쉽게 정리하는 과정이다.","subcategory":"간호이론·간호과정","level":2,"related":["pes-format"],"prerequisites":[]},{"slug":"syndrome-nursing-diagnosis","title_ko":"증후군간호진단","title_en":"Syndrome Nursing Diagnosis","meaning":"특정 사건이나 상황으로 인해 함께 발생하는 일련의 실제적 또는 위험 간호진단들의 묶음을 진술하는 간호진단 유형이다.","subcategory":"간호이론·간호과정","level":3,"related":[],"prerequisites":[]},{"slug":"pes-format","title_ko":"PES형식","title_en":"PES Format","meaning":"간호진단을 문제(Problem), 원인(Etiology), 증상 및 징후(Signs/Symptoms)의 세 요소로 구조화하여…","subcategory":"간호이론·간호과정","level":1,"related":["related-factors"],"prerequisites":[],"pop":19},{"slug":"related-factors","title_ko":"관련요인","title_en":"Related Factors","meaning":"실제적간호진단에서 문제를 유발하거나 관련이 있는 것으로 보이는 원인적·기여적 요인이다.","subcategory":"간호이론·간호과정","level":2,"related":["pes-format"],"prerequisites":["pes-format"]},{"slug":"risk-factors-nursing","title_ko":"위험요인","title_en":"Risk Factors","meaning":"위험간호진단에서 대상자가 특정 건강 문제에 더 취약하게 만드는 환경적·생리적·심리사회적 요인이다.","subcategory":"간호이론·간호과정","level":2,"related":[],"prerequisites":[]},{"slug":"nanda-taxonomy","title_ko":"NANDA간호진단분류체계","title_en":"NANDA-I Taxonomy","meaning":"북미간호진단협회(NANDA-I)가 개발한 표준화된 간호진단 용어와 정의, 영역·과별 분류체계이다.","subcategory":"간호이론·간호과정","level":2,"related":["pes-format"],"prerequisites":["pes-format"],"pop":4,"aliases":["북미간호진단협회분류체계","북미간호진단협회","North American Nursing Diagnosis Association (NANDA)","NANDA","간호진단분류체계","Nursing Diagnosis Taxonomy"]},{"slug":"soap-charting","title_ko":"SOAP기록","title_en":"SOAP Charting","meaning":"주관적자료(S), 객관적자료(O), 사정(A), 계획(P)의 네 요소로 구성하여 문제 중심으로 기록하는 방식이다.","subcategory":"간호이론·간호과정","level":1,"related":[],"prerequisites":[],"pop":13,"aliases":["SOAP","SOAP노트","SOAP Recording"]},{"slug":"regulator-subsystem","title_ko":"조절기전","title_en":"Regulator Subsystem","meaning":"로이적응모형에서 신경, 화학, 내분비 경로를 통해 자동적·무의식적으로 자극에 반응하는 대처 하위체계이다.","subcategory":"간호이론·간호과정","level":3,"related":[],"prerequisites":[]},{"slug":"neuman-systems-model","title_ko":"뉴만건강관리체계이론","title_en":"Neuman Systems Model","meaning":"베티 뉴만이 제시한 이론으로, 인간을 스트레스원으로부터 자신을 보호하는 저항선과 방어선을 가진 개방체계로 보고 예방적…","subcategory":"간호이론·간호과정","level":2,"related":[],"prerequisites":[],"aliases":["뉴만이론","뉴만체계모형"]},{"slug":"king-goal-attainment-theory","title_ko":"킹목표달성이론","title_en":"King's Goal Attainment Theory","meaning":"이모진 킹이 제시한 이론으로, 간호사와 대상자가 상호작용을 통해 목표를 함께 설정하고 합의하며 달성해가는 과정을 설명한다.","subcategory":"간호이론·간호과정","level":3,"related":[],"prerequisites":[],"aliases":["KGAT"]},{"slug":"unitary-human-being","title_ko":"통합인간","title_en":"Unitary Human Being","meaning":"로저스인간고유성이론에서 인간을 부분의 합보다 크며 환경과 분리될 수 없는 통합적 전체로 보는 개념이다.","subcategory":"간호이론·간호과정","level":3,"related":[],"prerequisites":[],"aliases":["UHB"]},{"slug":"swanson-caring-theory","title_ko":"스완슨돌봄이론","title_en":"Swanson's Theory of Caring","meaning":"크리스틴 스완슨이 제시한 중범위이론으로, 돌봄을 앎, 함께함, 힘 북돋우기, 믿음 유지하기, 가능하게 하기의 다섯 과정으로…","subcategory":"간호이론·간호과정","level":3,"related":[],"prerequisites":[],"pop":20,"aliases":["스완슨이론"]},{"slug":"evidence-based-nursing","title_ko":"근거기반간호","title_en":"Evidence-Based Nursing","meaning":"최선의 연구 근거, 임상 전문성, 대상자의 선호를 통합하여 간호 실무를 계획하고 수행하는 접근이다.","subcategory":"간호이론·간호과정","level":2,"related":[],"prerequisites":[],"pop":14,"aliases":["EBN","근거기반간호실무","Evidence-Based Nursing Practice","EBNP","근거기반실무","Evidence-Based Practice","EBP","근거중심간호","근거중심실무"]},{"slug":"diagnostic-priority","title_ko":"간호진단우선순위","title_en":"Diagnostic Priority","meaning":"여러 간호진단 중 생명 위협 정도와 대상자의 요구에 따라 먼저 다루어야 할 순서를 판단하는 것이다.","subcategory":"간호이론·간호과정","level":3,"related":[],"prerequisites":[]},{"slug":"support-system-nursing","title_ko":"지지체계","title_en":"Support System","meaning":"대상자가 스트레스와 건강 문제에 대처하는 데 도움을 주는 가족, 친구, 지역사회 등의 자원 연결망이다.","subcategory":"간호이론·간호과정","level":2,"related":[],"prerequisites":[]},{"slug":"korean-triage-acuity-scale","title_ko":"한국형 응급환자 중증도분류","title_en":"Korean Triage and Acuity Scale (KTAS)","meaning":"캐나다 CTAS를 기반으로 국내 실정에 맞게 개발한 5단계 응급환자 중증도분류 체계.","subcategory":"임상간호·간호관리","level":2,"related":["triage","start-triage"],"prerequisites":[],"aliases":["KTAS","한국형응급환자중증도분류"]},{"slug":"start-triage","title_ko":"START 중증도분류법","title_en":"Simple Triage and Rapid Treatment (START)","meaning":"호흡, 순환, 의식 상태를 신속히 평가하여 재난 현장에서 환자를 4개 범주로 분류하는 방법.","subcategory":"임상간호·간호관리","level":2,"related":["triage-system-mass-casualty","triage","korean-triage-acuity-scale"],"prerequisites":[],"pop":11,"aliases":["START","STRT","START분류","스타트분류","START triage method"]},{"slug":"fall-risk-assessment","title_ko":"낙상위험사정","title_en":"Fall Risk Assessment","meaning":"환자의 신체적, 인지적, 환경적 요인을 평가하여 낙상 발생 가능성을 예측하는 간호 활동.","subcategory":"임상간호·간호관리","level":1,"related":["morse-fall-scale","hendrich-fall-risk-model"],"prerequisites":[]},{"slug":"morse-fall-scale","title_ko":"모스낙상척도","title_en":"Morse Fall Scale","meaning":"낙상 병력, 보조기구 사용, 정맥주사 여부 등 6개 항목으로 낙상위험도를 점수화하는 평가 도구.","subcategory":"임상간호·간호관리","level":1,"related":["fall-risk-assessment","hendrich-fall-risk-model"],"prerequisites":[],"pop":15,"aliases":["MFS"]},{"slug":"hendrich-fall-risk-model","title_ko":"헨드릭낙상위험모델","title_en":"Hendrich II Fall Risk Model","meaning":"의식상태, 우울감, 배설양상, 어지러움 등을 평가하여 낙상위험을 예측하는 도구.","subcategory":"임상간호·간호관리","level":3,"related":["fall-risk-assessment","morse-fall-scale"],"prerequisites":[],"aliases":["HIFRM"]},{"slug":"pressure-injury-staging","title_ko":"욕창단계분류","title_en":"Pressure Injury Staging","meaning":"조직 손상의 깊이와 양상에 따라 욕창을 단계별로 구분하는 분류체계.","subcategory":"임상간호·간호관리","level":1,"related":["braden-scale-ltc","stage-i-pressure-injury","pressure-injury-prevention"],"prerequisites":[],"aliases":["욕창분류"]},{"slug":"pressure-injury-prevention","title_ko":"욕창예방간호","title_en":"Pressure Injury Prevention","meaning":"체위변경, 피부사정, 영양관리 등을 통해 욕창 발생을 예방하는 간호중재.","subcategory":"임상간호·간호관리","level":1,"related":["braden-scale-ltc","pressure-injury-staging"],"prerequisites":[]},{"slug":"stage-i-pressure-injury","title_ko":"1단계욕창","title_en":"Stage I Pressure Injury","meaning":"피부는 손상되지 않았으나 국소적으로 비창백성 발적이 나타나는 초기 단계의 욕창.","subcategory":"임상간호·간호관리","level":1,"related":["pressure-injury-staging","braden-scale-ltc"],"prerequisites":[]},{"slug":"deep-tissue-pressure-injury","title_ko":"심부조직손상욕창","title_en":"Deep Tissue Pressure Injury","meaning":"피부는 손상되지 않았으나 압력이나 전단력으로 심부 연조직이 손상되어 자주색 또는 밤색으로 변색되는 욕창.","subcategory":"임상간호·간호관리","level":3,"related":["pressure-injury-staging"],"prerequisites":["pressure-injury-staging"],"aliases":["DTPI"]},{"slug":"pain-assessment-tool","title_ko":"통증사정도구","title_en":"Pain Assessment Tool","meaning":"환자의 통증 강도와 양상을 체계적으로 측정하기 위해 사용하는 표준화된 평가 도구.","subcategory":"임상간호·간호관리","level":1,"related":["numeric-rating-scale","visual-analog-scale","wong-baker-faces-scale","flacc-scale"],"prerequisites":[]},{"slug":"numeric-rating-scale","title_ko":"숫자평정척도","title_en":"Numeric Rating Scale (NRS)","meaning":"통증 강도를 0에서 10까지의 숫자로 표현하도록 하는 자가보고식 통증사정도구.","subcategory":"임상간호·간호관리","level":1,"related":["pain-assessment-tool","visual-analog-scale","critical-care-pain-observation-tool"],"prerequisites":[],"pop":8,"aliases":["NRS"]},{"slug":"visual-analog-scale","title_ko":"시각적유사척도","title_en":"Visual Analog Scale (VAS)","meaning":"10cm 직선 위에 통증 없음부터 최대 통증까지 표시하도록 하여 통증 강도를 측정하는 도구.","subcategory":"임상간호·간호관리","level":1,"related":["pain-assessment-tool","numeric-rating-scale","wong-baker-faces-scale"],"prerequisites":[],"aliases":["VAS"]},{"slug":"wong-baker-faces-scale","title_ko":"웡베이커얼굴통증척도","title_en":"Wong-Baker FACES Pain Rating Scale","meaning":"표정 그림을 이용해 통증 정도를 표현하도록 하는 통증사정도구로 주로 아동에게 사용된다.","subcategory":"임상간호·간호관리","level":1,"related":["pain-assessment-tool","flacc-scale","visual-analog-scale"],"prerequisites":[],"pop":10,"aliases":["얼굴통증척도","웡베이커척도"]},{"slug":"flacc-scale","title_ko":"FLACC척도","title_en":"FLACC Scale","meaning":"얼굴표정, 다리, 활동, 울음, 위안 가능성 등 행동관찰을 통해 통증을 평가하는 도구로 주로 영유아나 의사소통이 어려운…","subcategory":"임상간호·간호관리","level":1,"related":["pain-assessment-tool","critical-care-pain-observation-tool","wong-baker-faces-scale"],"prerequisites":[],"pop":18,"aliases":["FLACC"]},{"slug":"critical-care-pain-observation-tool","title_ko":"중환자통증관찰도구","title_en":"Critical-Care Pain Observation Tool (CPOT)","meaning":"의사소통이 어려운 중환자를 대상으로 얼굴표정, 몸의 움직임, 근긴장도, 인공호흡기 순응도를 관찰하여 통증을 평가하는 도구.","subcategory":"임상간호·간호관리","level":3,"related":["pain-assessment-tool","flacc-scale","numeric-rating-scale"],"prerequisites":["pain-assessment-tool","flacc-scale","numeric-rating-scale"],"pop":2,"aliases":["CCPOT","CPOT"]},{"slug":"early-warning-score","title_ko":"조기경보점수","title_en":"Early Warning Score (EWS)","meaning":"활력징후와 의식수준 등을 점수화하여 환자 상태 악화를 조기에 발견하기 위한 도구.","subcategory":"임상간호·간호관리","level":1,"related":["modified-early-warning-score","rapid-response-team"],"prerequisites":[],"a