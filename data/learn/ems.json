[{"slug":"start-triage","title_ko":"START 중증도분류법","title_en":"Simple Triage and Rapid Treatment (START)","meaning":"호흡, 순환, 의식 상태를 신속히 평가하여 재난 현장에서 환자를 4개 범주로 분류하는 방법.","subcategory":"임상간호·간호관리","level":2,"related":["triage-system-mass-casualty","triage","korean-triage-acuity-scale"],"prerequisites":[],"pop":6,"aliases":["START","STRT","START분류","스타트분류","START triage method"]},{"slug":"head-tilt-chin-lift","title_ko":"두부후굴이신거상법","title_en":"Head Tilt-Chin Lift","meaning":"외상이 없는 환자에서 이마를 뒤로 젖히고 턱을 들어 올려 혀에 의한 기도폐쇄를 해소하는 도수 기도개방 기법.","subcategory":"응급처치·심폐소생술","level":2,"related":["oropharyngeal-airway"],"prerequisites":["oropharyngeal-airway"],"pop":7,"aliases":["HTCL"]},{"slug":"supraglottic-airway","title_ko":"성문상기도유지기","title_en":"Supraglottic Airway Device","meaning":"성문 위쪽 인두강에 위치시켜 기관삽관 없이 환기 경로를 확보하는 기도유지기의 총칭으로 후두마스크, 후두튜브 등이 포함된다.","subcategory":"응급처치·심폐소생술","level":3,"related":["bag-valve-mask"],"prerequisites":["bag-valve-mask"],"pop":5},{"slug":"bag-valve-mask","title_ko":"백밸브마스크","title_en":"Bag-Valve-Mask","meaning":"자가팽창백과 일방향 밸브, 안면마스크로 구성되어 수동으로 양압환기를 제공하는 응급 환기 보조기구.","subcategory":"응급처치·심폐소생술","level":1,"related":["oropharyngeal-airway"],"prerequisites":[],"pop":13,"aliases":["BVM"]},{"slug":"asystole","title_ko":"무수축","title_en":"Asystole","meaning":"심장의 전기적 활동과 기계적 수축이 모두 소실되어 심전도상 평탄선으로 나타나는 심정지 리듬으로 제세동 비적응 리듬에 해당한다.","subcategory":"응급처치·심폐소생술","level":1,"related":[],"prerequisites":[]},{"slug":"synchronized-cardioversion","title_ko":"동시성심율동전환","title_en":"Synchronized Cardioversion","meaning":"심전도의 R파에 동기화하여 전기충격을 전달함으로써 취약기 충격을 피하고 불안정한 빈맥성 부정맥을 정상 리듬으로 전환시키는…","subcategory":"응급처치·심폐소생술","level":3,"related":["cardiac-rhythm-analysis"],"prerequisites":[],"pop":10,"aliases":["동기화심율동전환","카디오버전"]},{"slug":"cardiac-arrest","title_ko":"심정지","title_en":"Cardiac Arrest","meaning":"심장의 기계적 수축이 갑자기 멈추어 전신으로의 혈액순환이 중단된 상태로, 즉각적인 심폐소생술과 소생 처치가 없으면 수분 내…","subcategory":"응급처치·심폐소생술","level":1,"related":["shockable-rhythm"],"prerequisites":[]},{"slug":"chest-compression-fraction","title_ko":"가슴압박분율","title_en":"Chest Compression Fraction","meaning":"전체 심폐소생술 시행 시간 중 실제로 가슴압박이 이루어진 시간이 차지하는 비율을 나타내는 소생술 질지표.","subcategory":"응급처치·심폐소생술","level":2,"related":[],"prerequisites":[],"pop":15,"aliases":["CCF"]},{"slug":"tourniquet","title_ko":"지혈대","title_en":"Tourniquet","meaning":"사지의 생명을 위협하는 대량출혈 시 상처 근위부를 강하게 압박하여 동맥혈류를 완전히 차단하는 지혈 기구.","subcategory":"응급처치·심폐소생술","level":1,"related":[],"prerequisites":[],"pop":4,"aliases":["토니켓"]},{"slug":"pressure-bandage","title_ko":"압박붕대","title_en":"Pressure Bandage","meaning":"거즈 위에 탄력붕대를 감아 상처 부위에 지속적인 압력을 유지시켜 출혈을 조절하는 지혈 보조 방법.","subcategory":"응급처치·심폐소생술","level":2,"related":["tourniquet","splint"],"prerequisites":["tourniquet"]},{"slug":"splint","title_ko":"부목","title_en":"Splint","meaning":"골절이나 탈구가 의심되는 사지를 고정하여 추가 손상과 통증을 예방하는 응급처치용 고정 기구.","subcategory":"응급처치·심폐소생술","level":1,"related":["traction-splint","spinal-immobilization"],"prerequisites":[],"aliases":["스플린트"]},{"slug":"traction-splint","title_ko":"견인부목","title_en":"Traction Splint","meaning":"대퇴골 골절 등에서 지속적인 견인력을 가해 골절편의 정렬을 유지하고 근육 경련 및 추가 손상을 줄이는 특수 부목.","subcategory":"응급처치·심폐소생술","level":2,"related":["splint","spinal-immobilization"],"prerequisites":["splint","spinal-immobilization"]},{"slug":"spinal-immobilization","title_ko":"척추고정","title_en":"Spinal Immobilization","meaning":"척추손상이 의심되는 외상환자에서 척수손상 악화를 방지하기 위해 경추보호대, 척추고정판 등을 이용해 척추 전체를 움직이지…","subcategory":"응급처치·심폐소생술","level":1,"related":["long-spine-board"],"prerequisites":[]},{"slug":"long-spine-board","title_ko":"긴척추고정판","title_en":"Long Spine Board","meaning":"환자의 전신을 눕혀 척추 전체를 일직선으로 고정하고 이동 및 운반을 용이하게 하는 단단한 판형 구조물.","subcategory":"응급처치·심폐소생술","level":1,"related":["spinal-immobilization","short-spine-board"],"prerequisites":[],"pop":19,"aliases":["롱보드","척추고정판"]},{"slug":"short-spine-board","title_ko":"짧은척추고정판","title_en":"Short Spine Board","meaning":"차량 등 협소한 공간에 앉아있는 환자를 구조할 때 상체와 목을 우선 고정한 뒤 이동시키기 위해 사용하는 반신용 척추고정판.","subcategory":"응급처치·심폐소생술","level":2,"related":["long-spine-board","spinal-immobilization"],"prerequisites":["long-spine-board","spinal-immobilization"],"aliases":["숏보드"]},{"slug":"drowning","title_ko":"익수","title_en":"Drowning","meaning":"액체에 의한 기도 폐쇄로 호흡장애가 발생하는 과정으로, 저산소증으로 인한 심정지와 뇌손상을 유발할 수 있는 응급상황.","subcategory":"응급처치·심폐소생술","level":3,"related":[],"prerequisites":[],"pop":17,"aliases":["물에빠짐","익사"]},{"slug":"total-body-surface-area","title_ko":"체표면적화상범위","title_en":"Total Body Surface Area","meaning":"화상이 차지하는 신체 표면적의 비율을 나타내는 지표로 수액소생술 계획 및 중증도 판정에 사용된다.","subcategory":"응급처치·심폐소생술","level":2,"related":["rule-of-nines"],"prerequisites":[],"aliases":["TBSA"]},{"slug":"rule-of-nines","title_ko":"9의법칙","title_en":"Rule of Nines","meaning":"신체 각 부위를 9% 단위 또는 그 배수로 나누어 화상의 체표면적 비율을 신속히 추정하는 평가 방법.","subcategory":"응급처치·심폐소생술","level":2,"related":["total-body-surface-area"],"prerequisites":[],"pop":2,"aliases":["구의법칙"]},{"slug":"cincinnati-stroke-scale","title_ko":"신시내티병원전뇌졸중척도","title_en":"Cincinnati Prehospital Stroke Scale","meaning":"안면마비, 편측상지위약, 발음이상 세 가지 항목을 평가해 뇌졸중 가능성을 신속히 선별하는 병원전 평가 도구.","subcategory":"응급처치·심폐소생술","level":3,"related":["vital-signs"],"prerequisites":["vital-signs"],"aliases":["CPSS"]},{"slug":"flail-chest","title_ko":"연가양흉부","title_en":"Flail Chest","meaning":"인접한 세 개 이상의 늑골이 두 곳 이상 골절되어 흉벽의 일부가 독립적으로 역행성 움직임을 보이는 중증 흉부외상.","subcategory":"응급처치·심폐소생술","level":3,"related":[],"prerequisites":[],"aliases":["동요가슴"]},{"slug":"increased-intracranial-pressure","title_ko":"두개내압상승","title_en":"Increased Intracranial Pressure","meaning":"출혈, 부종 등으로 두개강 내 압력이 비정상적으로 상승하여 뇌관류가 저하되고 뇌탈출 위험이 증가하는 상태.","subcategory":"응급처치·심폐소생술","level":3,"related":["glasgow-coma-scale","vital-signs"],"prerequisites":["vital-signs"],"pop":20,"aliases":["ICP상승","뇌압상승"]},{"slug":"abcde-approach","title_ko":"응급처치우선순위평가","title_en":"ABCDE Approach","meaning":"기도, 호흡, 순환, 의식상태, 노출 순서로 환자를 체계적으로 평가하여 생명을 위협하는 문제를 우선적으로 발견하고 처치하는…","subcategory":"응급처치·심폐소생술","level":1,"related":[],"prerequisites":[],"pop":1,"aliases":["ABCDE접근법"]},{"slug":"vital-signs","title_ko":"활력징후","title_en":"Vital Signs","meaning":"혈압, 맥박, 호흡수, 체온, 산소포화도 등 생명 유지와 직결된 기본적인 생리학적 지표.","subcategory":"응급처치·심폐소생술","level":1,"related":[],"prerequisites":[],"pop":18,"aliases":["바이탈사인"]},{"slug":"cardiac-rhythm-analysis","title_ko":"심장리듬분석","title_en":"Cardiac Rhythm Analysis","meaning":"심전도 파형을 관찰하여 심장 리듬이 정상인지, 제세동이 필요한 부정맥인지를 판별하는 과정.","subcategory":"응급처치·심폐소생술","level":2,"related":["shockable-rhythm"],"prerequisites":["shockable-rhythm"]},{"slug":"lactated-ringers","title_ko":"젖산링거액","title_en":"Lactated Ringer's Solution","meaning":"나트륨, 칼륨, 칼슘, 젖산염을 포함하여 혈장 전해질 조성과 유사하게 만들어진 등장성 수액으로 수액소생술에 사용된다.","subcategory":"응급처치·심폐소생술","level":2,"related":[],"prerequisites":[],"pop":14,"aliases":["락테이트링거","하트만액"]},{"slug":"shockable-rhythm","title_ko":"제세동적응리듬","title_en":"Shockable Rhythm","meaning":"심실세동, 무맥성심실빈맥과 같이 제세동을 통해 정상 리듬으로의 전환을 기대할 수 있는 심정지 리듬군.","subcategory":"응급처치·심폐소생술","level":1,"related":["cardiac-rhythm-analysis"],"prerequisites":[],"aliases":["쇼크가능리듬"]},{"slug":"oropharyngeal-airway","title_ko":"구인두기도기","title_en":"Oropharyngeal Airway","meaning":"의식이 없는 환자의 입을 통해 삽입하여 혀뿌리가 인두 후벽을 막지 않도록 유지하는 경성 기도유지 보조기구.","subcategory":"응급처치·심폐소생술","level":1,"related":["nasopharyngeal-airway","bag-valve-mask"],"prerequisites":[],"pop":3,"aliases":["OPA"]},{"slug":"nasopharyngeal-airway","title_ko":"비인두기도기","title_en":"Nasopharyngeal Airway","meaning":"콧구멍을 통해 삽입하여 인두까지 도달시키는 연성 기도유지 보조기구로 구역반사가 있는 환자에게도 비교적 안전하게 사용 가능하다.","subcategory":"응급처치·심폐소생술","level":3,"related":["oropharyngeal-airway","bag-valve-mask"],"prerequisites":["oropharyngeal-airway","bag-valve-mask"],"pop":8,"aliases":["NPA"]},{"slug":"magill-forceps","title_ko":"매길겸자","title_en":"Magill Forceps","meaning":"구부러진 형태의 겸자로 후두경 시야 하에서 기관튜브 방향을 조정하거나 상기도의 이물질을 직접 제거하는 데 사용되는 기구.","subcategory":"응급처치·심폐소생술","level":3,"related":[],"prerequisites":[],"aliases":["마길겸자","매길포셉"]},{"slug":"hypovolemia","title_ko":"저혈량증","title_en":"Hypovolemia","meaning":"출혈이나 체액 손실로 순환혈액량이 감소한 상태로 심정지의 가역적 원인 중 하나에 해당한다.","subcategory":"응급처치·심폐소생술","level":3,"related":[],"prerequisites":[],"pop":12},{"slug":"prehospital-triage","title_ko":"병원전단계 중증도분류","title_en":"prehospital triage","meaning":"환자가 병원에 도착하기 전 현장이나 이송 중에 시행하여 이송할 병원과 처치 우선순위를 결정하는 중증도분류입니다.","subcategory":"재난의료·구급행정","level":1,"related":[],"prerequisites":[],"aliases":["병원전단계중증도분류"]},{"slug":"dmat-activation-protocol","title_ko":"DMAT 출동체계","title_en":"DMAT activation protocol","meaning":"재난 발생 신고나 통보 이후 재난의료지원팀이 소집·출동·현장 도착에 이르는 절차와 기준을 정한 표준화된 체계입니다.","subcategory":"재난의료·구급행정","level":2,"related":[],"prerequisites":[],"aliases":["DMAT출동체계"]},{"slug":"disaster-medical-response-system","title_ko":"재난의료대응체계","title_en":"disaster medical response system","meaning":"재난 발생 시 인명 피해를 최소화하기 위해 의료 자원과 인력을 조직적으로 동원·운용하는 전체 절차와 조직의 총칭입니다.","subcategory":"재난의료·구급행정","level":3,"related":[],"prerequisites":[],"aliases":["DMRS","국가재난의료체계","national disaster medical system","NDMS"]},{"slug":"incident-command-post","title_ko":"재난현장 지휘소","title_en":"incident command post","meaning":"현장지휘관과 주요 대응 기관의 책임자들이 모여 상황을 파악하고 의사결정을 내리는 물리적 또는 지정된 장소입니다.","subcategory":"재난의료·구급행정","level":1,"related":[],"prerequisites":[],"aliases":["재난현장지휘소"]},{"slug":"common-operating-picture","title_ko":"공통작전상황도","title_en":"common operating picture","meaning":"재난 대응에 참여하는 모든 기관이 동일한 실시간 상황 정보를 공유할 수 있도록 통합해 표시한 상황판이나 정보체계입니다.","subcategory":"재난의료·구급행정","level":1,"related":[],"prerequisites":[]},{"slug":"disaster-preparedness-phase","title_ko":"재난대비단계","title_en":"disaster preparedness phase","meaning":"재난 발생에 대비해 계획 수립, 훈련, 자원 비축 등을 통해 실제 대응 역량을 미리 갖추는 재난관리단계입니다.","subcategory":"재난의료·구급행정","level":1,"related":["tabletop-exercise"],"prerequisites":[]},{"slug":"standard-treatment-protocol-ems","title_ko":"응급처치 표준지침","title_en":"EMS standard treatment protocol","meaning":"특정 증상이나 상황에 대해 응급구조사가 따라야 할 처치 순서와 방법을 미리 정해 놓은 표준화된 지침입니다.","subcategory":"재난의료·구급행정","level":1,"related":[],"prerequisites":[],"aliases":