{
  "name": "term-glossary",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:sitemap": "node scripts/generate-sitemap.js",
    "import:related": "node scripts/import-related.js",
    "suggest:related": "node scripts/suggest-related.js",
    "check:related": "node scripts/check-related-consistency.js",
    "build:related": "npm run import:related && npm run suggest:related && npm run check:related && npm run build:related-html && npm run check:related && npm run build:terms-index",
    "test": "node --test tests/*.test.js",
    "build:related-html": "node scripts/generate-related-html.js",
    "build:analytics": "node scripts/insert-analytics.js",
    "build:feed": "node scripts/generate-feed.js",
    "build:i18n": "node scripts/generate-en-pages.js",
    "build:pages": "node scripts/build-pages.js",
    "build:terms-index": "node scripts/generate-terms-index.js && npm run build:home-data && npm run build:terms-lite && npm run build:viewer-index",
    "build:home-data": "node scripts/generate-home-data.js",
    "build:terms-lite": "node scripts/generate-terms-lite.js",
    "build:viewer-index": "node scripts/generate-viewer-index.js",
    "build:category-badges": "node scripts/insert-category-badges.js",
    "build:category-pages": "node scripts/generate-category-pages.js && node scripts/build-category-links.js",
    "build:bookmark-button": "node scripts/insert-bookmark-button.js",
    "build:roadmap-metadata": "node scripts/generate-roadmap-metadata.js",
    "preview:diagrams": "node scripts/diagrams/preview.js",
    "build:diagrams": "node scripts/diagrams/insert.js"
  },
  "devDependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
