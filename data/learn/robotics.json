[{"slug":"robot-manipulator","title_ko":"로봇 매니퓰레이터","title_en":"Robot Manipulator","meaning":"여러 개의 링크가 관절로 연결되어 정해진 작업(이동, 조작 등)을 수행하는 로봇팔 형태의 기계 시스템이다. 산업 현장의…","subcategory":"로봇기구학·제어","level":1,"related":[],"prerequisites":[],"pop":1,"aliases":["매니퓰레이터","로봇팔","Robot Arm","로봇암"]},{"slug":"pid-control","title_ko":"PID제어","title_en":"PID Control","meaning":"오차의 비례(P), 적분(I), 미분(D) 항을 조합하여 제어 입력을 계산하는 가장 널리 쓰이는 피드백 제어 기법이다…","subcategory":"로봇기구학·제어","level":1,"related":[],"prerequisites":[],"pop":2,"aliases":["비례적분미분제어"]},{"slug":"parallel-manipulator","title_ko":"병렬로봇기구","title_en":"Parallel Manipulator","meaning":"여러 개의 독립된 운동 사슬(kinematic chain)이 하나의 이동 플랫폼을 동시에 지지하는 로봇 구조이다. 직렬…","subcategory":"로봇기구학·제어","level":1,"related":[],"prerequisites":[],"aliases":["병렬매니퓰레이터","패러렐로봇"]},{"slug":"denavit-hartenberg-parameters","title_ko":"데나빗-하텐베르그 파라미터","title_en":"Denavit-Hartenberg (DH) Parameters","meaning":"직렬 로봇의 인접한 두 링크 사이의 관계를 링크 길이, 링크 비틀림, 링크 오프셋, 관절각의 네 가지 파라미터로 표준화하여…","subcategory":"로봇기구학·제어","level":1,"related":[],"prerequisites":[],"aliases":["DHP","데나빗 하텐베르그 파라미터","데나빗-하텐베르그파라미터","데나빗하텐베르그 파라미터"]},{"slug":"redundant-manipulator","title_ko":"중복자유도매니퓰레이터","title_en":"Redundant Manipulator","meaning":"작업을 수행하는 데 필요한 최소 자유도보다 많은 자유도를 가진 로봇 매니퓰레이터이다. 동일한 엔드이펙터 자세에 대해 여러…","subcategory":"로봇기구학·제어","level":1,"related":[],"prerequisites":[],"aliases":["리던던트매니퓰레이터","여유자유도매니퓰레이터"]},{"slug":"prismatic-joint","title_ko":"직선관절","title_en":"Prismatic Joint","meaning":"두 링크가 일직선 방향으로 미끄러지듯 상대운동하는 관절이다. 1자유도를 가지며 관절 변수는 변위(길이)로 표현된다…","subcategory":"로봇기구학·제어","level":1,"related":[],"prerequisites":[],"pop":13,"aliases":["선형관절","직동관절","프리즈매틱관절"]},{"slug":"encoder-robot","title_ko":"엔코더","title_en":"Encoder","meaning":"관절의 회전각이나 변위를 측정하는 센서로, 절대엔코더와 상대(증분)엔코더로 구분된다. 로봇 관절 위치 제어의 가장 기본적인…","subcategory":"로봇기구학·제어","level":2,"related":["pid-control"],"prerequisites":["pid-control"],"pop":3},{"slug":"force-torque-sensor","title_ko":"힘토크센서","title_en":"Force/Torque Sensor","meaning":"엔드이펙터에 가해지는 3축 힘과 3축 토크(총 6개 성분)를 동시에 측정하는 센서이다. 조립, 연마, 협동 작업 등 접촉이…","subcategory":"로봇기구학·제어","level":1,"related":[],"prerequisites":[],"pop":9},{"slug":"odometry","title_ko":"오도메트리","title_en":"Odometry","meaning":"바퀴의 회전량(엔코더)이나 관성 센서 정보를 이용해 로봇의 이동 거리와 방향 변화를 누적 계산하여 현재 위치를 추정하는…","subcategory":"로봇기구학·제어","level":2,"related":["slam"],"prerequisites":[],"pop":6,"aliases":["주행거리측정법"]},{"slug":"hand-eye-calibration","title_ko":"핸드아이캘리브레이션","title_en":"Hand-Eye Calibration","meaning":"로봇의 엔드이펙터(손)와 카메라(눈) 사이의 상대적인 위치와 자세 관계를 정확히 구하는 캘리브레이션 과정이다. 카메라가 로봇…","subcategory":"로봇기구학·제어","level":1,"related":[],"prerequisites":[],"pop":16,"aliases":["HEC"]},{"slug":"graph-slam","title_ko":"그래프기반슬램","title_en":"Graph-based SLAM (Graph SLAM)","meaning":"로봇 자세와 랜드마크를 노드로, 센서 관측과 오도메트리 제약을 에지로 표현한 그래프를 구성하고 전체 오차를 최소화해 최적…","subcategory":"자율로봇·로봇지능","level":1,"related":["slam","loop-closure-detection"],"prerequisites":[],"aliases":["Graph SLAM"]},{"slug":"loop-closure-detection","title_ko":"루프클로저검출","title_en":"Loop Closure Detection","meaning":"로봇이 이전에 방문했던 장소로 다시 돌아왔음을 인식하여 누적된 위치 추정 오차를 보정할 기회를 제공하는 SLAM의 핵심 단계.","subcategory":"자율로봇·로봇지능","level":1,"related":["slam","graph-slam"],"prerequisites":[],"aliases":["루프클로징","루프폐쇄검출"]},{"slug":"occupancy-grid-map","title_ko":"점유격자지도","title_en":"Occupancy Grid Map","meaning":"환경을 일정 크기의 격자 셀로 나누고 각 셀이 장애물로 점유되어 있을 확률을 저장하여 표현하는 확률적 지도 표현 방식.","subcategory":"자율로봇·로봇지능","level":1,"related":["slam"],"prerequisites":[],"aliases":["OGM"]},{"slug":"iterative-closest-point","title_ko":"반복최근접점알고리즘","title_en":"Iterative Closest Point (ICP)","meaning":"두 점군 사이의 최근접점 대응을 반복적으로 갱신하며 정합 오차를 최소화하는 강체 변환을 추정하는 정합 알고리즘.","subcategory":"자율로봇·로봇지능","level":1,"related":[],"prerequisites":[],"pop":4,"aliases":["ICP","ICP알고리즘"]},{"slug":"extended-kalman-filter","title_ko":"확장칼만필터","title_en":"Extended Kalman Filter (EKF)","meaning":"비선형 시스템 모델을 매 시점 야코비안으로 선형화하여 칼만 필터의 예측·갱신 구조를 적용하는 상태 추정 기법.","subcategory":"자율로봇·로봇지능","level":2,"related":["imu"],"prerequisites":[],"aliases":["EKF","Extended Kalman Filter for Spacecraft","EKFS"]},{"slug":"inertial-navigation-system","title_ko":"관성항법시스템","title_en":"Inertial Navigation System (INS)","meaning":"가속도계와 자이로스코프로 측정한 가속도와 각속도를 적분하여 외부 기준 없이 위치·속도·자세를 추정하는 항법 시스템.","subcategory":"자율로봇·로봇지능","level":3,"related":["imu","odometry"],"prerequisites":[],"pop":10,"aliases":["INS","관성항법장치"]},{"slug":"a-star-algorithm","title_ko":"에이스타알고리즘","title_en":"A* Algorithm","meaning":"실제 이동 비용과 목표까지의 추정 비용(휴리스틱)을 합한 값을 기준으로 최단 경로를 탐색하는 그래프 탐색 알고리즘.","subcategory":"자율로봇·로봇지능","level":2,"related":["d-star-algorithm","occupancy-grid-map"],"prerequisites":["occupancy-grid-map"],"pop":5,"aliases":["A*","A스타알고리즘"]},{"slug":"d-star-algorithm","title_ko":"디스타알고리즘","title_en":"D* Algorithm","meaning":"환경 정보가 변화할 때 이전 탐색 결과를 최대한 재사용하여 경로를 빠르게 재계산하는 동적 최단 경로 탐색 알고리즘.","subcategory":"자율로봇·로봇지능","level":3,"related":["a-star-algorithm","dynamic-window-approach"],"prerequisites":["a-star-algorithm","dynamic-window-approach"],"aliases":["D*","D스타알고리즘"]},{"slug":"dynamic-window-approach","title_ko":"동적윈도우접근법","title_en":"Dynamic Window Approach (DWA)","meaning":"로봇의 속도·가속도 제약을 고려한 실현 가능한 속도 후보군 중 목표 지향성과 안전성을 평가해 최적 속도 명령을 매 주기…","subcategory":"자율로봇·로봇지능","level":2,"related":[],"prerequisites":[],"pop":12,"aliases":["DWA"]},{"slug":"global-path-planning","title_ko":"전역경로계획","title_en":"Global Path Planning","meaning":"전체 환경 지도를 알고 있다는 가정 하에 시작점부터 목표점까지의 전체 경로를 미리 계획하는 상위 수준의 경로 계획.","subcategory":"자율로봇·로봇지능","level":3,"related":["a-star-algorithm","occupancy-grid-map"],"prerequisites":["a-star-algorithm","occupancy-grid-map"]},{"slug":"instance-segmentation","title_ko":"인스턴스분할","title_en":"Instance Segmentation","meaning":"같은 클래스에 속하더라도 개별 객체를 서로 구분하여 픽셀 단위로 분할하는 컴퓨터 비전 기법.","subcategory":"자율로봇·로봇지능","level":3,"related":[],"prerequisites":[],"aliases":["개체분할","인스턴스세그멘테이션"]},{"slug":"camera-calibration","title_ko":"카메라캘리브레이션","title_en":"Camera Calibration","meaning":"카메라의 초점 거리, 주점, 렌즈 왜곡 등 내부 파라미터와 카메라의 위치·자세인 외부 파라미터를 추정하는 과정.","subcategory":"자율로봇·로봇지능","level":2,"related":[],"prerequisites":[],"pop":14,"aliases":["카메라교정","카메라보정"]},{"slug":"gazebo-simulator","title_ko":"가제보시뮬레이터","title_en":"Gazebo Simulator","meaning":"물리 엔진 기반의 3차원 동역학 시뮬레이션과 다양한 센서 모델을 제공하는 대표적인 오픈소스 로봇 시뮬레이션 소프트웨어.","subcategory":"자율로봇·로봇지능","level":3,"related":[],"prerequisites":[],"pop":8,"aliases":["Gazebo","가제보"]},{"slug":"fleet-management-system","title_ko":"플릿관리시스템","title_en":"Fleet Management System","meaning":"다수의 이동 로봇을 중앙에서 모니터링하고 작업을 배분하며 교통 흐름을 조율하는 관제 소프트웨어 시스템.","subcategory":"자율로봇·로봇지능","level":1,"related":[],"prerequisites":[],"pop":7,"aliases":["군집관리시스템"]},{"slug":"cross-belt-sorter","title_ko":"크로스벨트소터","title_en":"Cross-Belt Sorter","meaning":"다수의 소형 컨베이어 캐리어가 순환 트랙을 따라 이동하며 목적지에 도달하면 벨트를 가로 방향으로 구동해 상품을 배출하는 고속…","subcategory":"로봇공학 산업응용","level":3,"related":[],"prerequisites":[],"pop":15},{"slug":"da-vinci-surgical-system","title_ko":"다빈치수술시스템","title_en":"da Vinci Surgical System","meaning":"인튜이티브서지컬사가 개발한 대표적인 상용 최소침습수술로봇 플랫폼으로, 의사가 콘솔에서 3차원 영상을 보며 원격으로 로봇 팔을…","subcategory":"로봇공학 산업응용","level":2,"related":[],"prerequisites":[],"pop":11,"aliases":["DVSS"]},{"slug":"planetary-rover","title_ko":"행성탐사로버","title_en":"Planetary Rover","meaning":"달, 화성 등 다른 천체의 표면을 이동하며 지형 촬영, 시료 채취, 과학 실험 등을 수행하는 이동형 우주로봇으로, 지구와의…","subcategory":"로봇공학 산업응용","level":2,"related":[],"prerequisites":[],"pop":17,"aliases":["탐사로버","화성로버"]}]